[56.395021, "o", "\u001b[?2004h> "]
[56.3954, "o", "        print(f\"{result.partner_id} {result.period}: {result.accepted}/{result.merchants} merchant rows accepted; receipt_id={result.receipt_id}\")\r\n\u001b[?2004l\r"]
[56.395441, "o", "\u001b[?2004h> "]
