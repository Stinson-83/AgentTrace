[96.233853, "o", "\u001b[?2004h> "]
[96.234524, "o", "        Settlement(\"s2\", account.merchant_id, \"2025-10-31\", \"GBP\", 2000, 50, 200, 11, \"paid\"),\r\n\u001b[?2004l\r"]
[96.234628, "o", "\u001b[?2004h"]
[96.234698, "o", "> "]
[96.23528, "o", "        Settlement(\"s3\", account.merchant_id, \"2025-10-15\", \"GBP\", 9000, 90, 900, 90, \"pending\"),\r\n\u001b[?2004l\r"]
[96.235355, "o", "\u001b[?2004h> "]
[96.23606, "o", "        Settlement(\"s4\", account.merchant_id, \"2025-10-15\", \"GBP\", 9000, 90, 900, 90, \"reversed\"),\r\n\u001b[?2004l\r"]
[96.23615, "o", "\u001b[?2004h> "]
[96.236827, "o", "        Settlement(\"s5\", unpaid_account.merchant_id, \"2025-10-15\", \"GBP\", 9000, 90, 900, 90, \"pending\"),\r\n\u001b[?2004l\r"]
[96.236909, "o", "\u001b[?2004h> "]
[96.237043, "o", "    ]\r\n\u001b[?2004l\r"]
[96.237169, "o", "\u001b[?2004h> "]
[96.237263, "o", "    source = Mock()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.237918, "o", "    source.settlements_between.return_value = records\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.238864, "o", "    source.merchant.side_effect = lambda merchant_id: account if merchant_id == account.merchant_id else unpaid_account\r\n\u001b[?2004l\r"]
[96.238963, "o", "\u001b[?2004h> "]
[96.239074, "o", "    client = Mock()\r\n\u001b[?2004l\r"]
[96.239227, "o", "\u001b[?2004h> "]
[96.239724, "o", "    client.push.return_value = GatewayResponse(202, {\"receipt_id\": \"rc_paid\"})\r\n\u001b[?2004l\r"]
[96.239871, "o", "\u001b[?2004h> "]
[96.240349, "o", "    result = push_partner_feed(source, settings, partner, \"2025-10\", client)\r\n\u001b[?2004l\r"]
[96.24052, "o", "\u001b[?2004h> "]
