[7.064907, "o", "drwxr-xr-x 1 root root 4096 Nov 16 18:51 .\r\ndrwxr-xr-x 1 root root 4096 Nov 16 18:52 ..\r\ndrwxrwxr-x 3 root root 4096 Nov 16 18:51 .pytest_cache\r\n-rw-rw-r-- 1 root root 2272 Nov 16 17:47 README.md\r\ndrwxrwxr-x 2 root root 4096 Nov 16 17:47 config\r\ndrwxrwxr-x 1 root root 4096 Nov 16 18:51 data\r\ndrwxrwxr-x 3 root root 4096 Nov 16 18:51 docs\r\ndrwxrwxr-x 3 root root 4096 Nov 16 17:47 ledgerline\r\ndrwxrwxr-x 2 root root 4096 Nov 16 18:51 services\r\ndrwxrwxr-x 3 root root 4096 Nov 16 18:51 tests\r\n"]
