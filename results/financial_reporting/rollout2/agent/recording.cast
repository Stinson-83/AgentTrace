[96.242855, "o", "        \"period\": \"2025-10\", \"currency\": account.currency, \"settlement_count\": 2,\r\n\u001b[?2004l\r"]
[96.24293, "o", "\u001b[?2004h> "]
[96.243424, "o", "        \"transaction_count\": 18, \"gross_cents\": 3000, \"fees_cents\": 80,\r\n\u001b[?2004l\r"]
[96.243515, "o", "\u001b[?2004h> "]
