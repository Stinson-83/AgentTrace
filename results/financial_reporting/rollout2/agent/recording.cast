[96.257564, "o", "def test_gateway_error_propagates(store, settings, partner):\r\n\u001b[?2004l\r"]
[96.257679, "o", "\u001b[?2004h> "]
[96.257852, "o", "    error = GatewayError(\"rejected\")\r\n\u001b[?2004l\r"]
[96.257966, "o", "\u001b[?2004h> "]
[96.258078, "o", "    client = Mock()\r\n\u001b[?2004l\r\u001b[?2004h"]
[96.25823, "o", "> "]
[96.258447, "o", "    client.push.side_effect = error\r\n\u001b[?2004l\r"]
[96.258568, "o", "\u001b[?2004h> "]
[96.258855, "o", "    with pytest.raises(GatewayError) as caught:\r\n\u001b[?2004l\r"]
[96.258939, "o", "\u001b[?2004h> "]
[96.259356, "o", "        push_partner_feed(store, settings, partner, \"2025-10\", client)\r\n\u001b[?2004l\r\u001b[?2004h"]
[96.259431, "o", "> "]
[96.259555, "o", "    assert caught.value is error\r\n\u001b[?2004l\r"]
[96.259636, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[96.25969, "o", "\u001b[?2004h"]
[96.259741, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.26018, "o", "def test_non_success_response_is_gateway_error(store, settings, partner):\r\n\u001b[?2004l\r"]
[96.260191, "o", "\u001b[?2004h> "]
[96.260311, "o", "    client = Mock()\r\n"]
[96.260346, "o", "\u001b[?2004l\r"]
[96.260395, "o", "\u001b[?2004h> "]
[96.260804, "o", "    client.push.return_value = GatewayResponse(422, {\"error\": \"rejected\"})\r\n"]
[96.260838, "o", "\u001b[?2004l\r"]
[96.26085, "o", "\u001b[?2004h> "]
[96.26106, "o", "    with pytest.raises(GatewayError, match=\"422\"):\r\n"]
[96.261066, "o", "\u001b[?2004l\r"]
[96.261107, "o", "\u001b[?2004h> "]
[96.261337, "o", "        push_partner_feed(store, settings, partner, \"2025-10\", client)\r\n"]
[96.261359, "o", "\u001b[?2004l\r"]
[96.261365, "o", "\u001b[?2004h> "]
[96.261415, "o", "\r\n\u001b[?2004l\r"]
[96.26145, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.261532, "o", "@pytest.fixture\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.261577, "o", "def gateway():\r\n\u001b[?2004l\r"]
[96.26162, "o", "\u001b[?2004h> "]
[96.261755, "o", "    class Handler(BaseHTTPRequestHandler):\r\n\u001b[?2004l\r"]
[96.261794, "o", "\u001b[?2004h> "]
[96.261856, "o", "        status = 202\r\n\u001b[?2004l\r"]
[96.261895, "o", "\u001b[?2004h> "]
[96.261962, "o", "        received = []\r\n\u001b[?2004l\r"]
[96.262, "o", "\u001b[?2004h> \r\n\u001b[?2004l\re"]
[96.262039, "o", "\u001b[?2004h> "]
[96.262157, "o", "        def log_message(self, *args):\r\n\u001b[?2004l\r"]
[96.262197, "o", "\u001b[?2004h> "]
[96.262248, "o", "            pass\r\n\u001b[?2004l\r"]
[96.262296, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[96.26235, "o", "> "]
[96.262408, "o", "        def do_POST(self):\r\n\u001b[?2004l\r"]
[96.262452, "o", "\u001b[?2004h> "]
[96.262744, "o", "            document = json.loads(self.rfile.read(int(self.headers[\"Content-Length\"])))\r\n\u001b[?2004l\r"]
[96.262787, "o", "\u001b[?2004h> "]
[96.262997, "o", "            self.received.append((self.path, dict(self.headers), document))\r\n\u001b[?2004l\r"]
[96.263036, "o", "\u001b[?2004h> "]
[96.263295, "o", "            body = json.dumps({\"receipt_id\": \"rc_http\", \"accepted\": len(document[\"merchants\"])}).encode()\r\n\u001b[?2004l\r"]
[96.263332, "o", "\u001b[?2004h> "]
[96.263432, "o", "            self.send_response(self.status)\r\n\u001b[?2004l\r"]
[96.263471, "o", "\u001b[?2004h> "]
[96.263663, "o", "            self.send_header(\"Content-Type\", \"application/json\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.263822, "o", "            self.send_header(\"Content-Length\", str(len(body)))\r\n\u001b[?2004l\r"]
[96.263863, "o", "\u001b[?2004h> "]
[96.263927, "o", "            self.end_headers()\r\n\u001b[?2004l\r"]
[96.263966, "o", "\u001b[?2004h> "]
[96.264047, "o", "            self.wfile.write(body)\r\n\u001b[?2004l\r"]
[96.264084, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[96.264122, "o", "\u001b[?2004h> "]
[96.264253, "o", "    server = ThreadingHTTPServer((\"127.0.0.1\", 0), Handler)\r\n\u001b[?2004l\r"]
[96.264292, "o", "\u001b[?2004h> "]
[96.264464, "o", "    thread = threading.Thread(target=server.serve_forever, daemon=True)\r\n\u001b[?2004l\r"]
[96.264503, "o", "\u001b[?2004h> "]
[96.264541, "o", "    thread.start()\r\n\u001b[?2004l\r"]
[96.264579, "o", "\u001b[?2004h> "]
[96.264623, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[96.26464, "o", "> "]
[96.264804, "o", "        yield f\"http://127.0.0.1:{server.server_port}\", Handler\r\n\u001b[?2004l\r"]
[96.264851, "o", "\u001b[?2004h> "]
[96.264892, "o", "    finally:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.264963, "o", "        server.shutdown()\r\n\u001b[?2004l\r"]
[96.265002, "o", "\u001b[?2004h> "]
[96.265071, "o", "        server.server_close()\r\n\u001b[?2004l\r"]
[96.26511, "o", "\u001b[?2004h> "]
[96.265157, "o", "        thread.join()\r\n\u001b[?2004l\r"]
[96.265197, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[96.265237, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.265417, "o", "def test_default_gateway_client(store, settings, partner, gateway):\r\n\u001b[?2004l\r"]
[96.265458, "o", "\u001b[?2004h> "]
[96.265515, "o", "    url, handler = gateway\r\n\u001b[?2004l\r"]
[96.265554, "o", "\u001b[?2004h> "]
[96.265752, "o", "    settings = replace(settings, partner_gateway_url=url, gateway_timeout_sec=2)\r\n\u001b[?2004l\r"]
[96.265795, "o", "\u001b[?2004h> "]
[96.265953, "o", "    result = push_partner_feed(store, settings, partner, \"2025-10\")\r\n\u001b[?2004l\r"]
[96.265993, "o", "\u001b[?2004h> "]
[96.266086, "o", "    assert result.receipt_id == \"rc_http\"\r\n\u001b[?2004l\r"]
[96.266124, "o", "\u001b[?2004h> "]
[96.266253, "o", "    assert result.accepted == result.merchants > 0\r\n\u001b[?2004l\r"]
[96.266303, "o", "\u001b[?2004h> "]
[96.266398, "o", "    path, headers, document = handler.received[0]\r\n\u001b[?2004l\r"]
[96.266436, "o", "\u001b[?2004h> "]
[96.266518, "o", "    assert path == partner.endpoint\r\n\u001b[?2004l\r"]
[96.266556, "o", "\u001b[?2004h> "]
[96.266704, "o", "    assert headers[\"Content-Type\"] == \"application/json\"\r\n\u001b[?2004l\r"]
[96.266745, "o", "\u001b[?2004h> "]
[96.266879, "o", "    assert headers[\"X-Partner-Id\"] == partner.partner_id\r\n\u001b[?2004l\r"]
[96.266942, "o", "\u001b[?2004h> "]
[96.267082, "o", "    assert headers[\"X-Reporting-Entity\"] == settings.reporting_entity\r\n\u001b[?2004l\r"]
[96.267121, "o", "\u001b[?2004h> "]
[96.267261, "o", "    assert document[\"entity\"] == settings.reporting_entity\r\n\u001b[?2004l\r"]
[96.267298, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[96.267337, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[96.267374, "o", "> "]
[96.267621, "o", "@pytest.mark.parametrize(\"error\", [TimeoutError(\"timed out\"), urllib.error.URLError(\"connection refused\")])\r\n\u001b[?2004l\r"]
[96.267661, "o", "\u001b[?2004h> "]
[96.268029, "o", "def test_gateway_connection_failures_are_gateway_errors(partner, monkeypatch, error):\r\n\u001b[?2004l\r"]
[96.26808, "o", "\u001b[?2004h> "]
[96.26824, "o", "    monkeypatch.setattr(\"urllib.request.urlopen\", Mock(side_effect=error))\r\n\u001b[?2004l\r"]
[96.268278, "o", "\u001b[?2004h> "]
[96.268418, "o", "    with pytest.raises(GatewayError, match=\"unreachable\"):\r\n\u001b[?2004l\r"]
[96.268455, "o", "\u001b[?2004h> "]
[96.268623, "o", "        PartnerGatewayClient(\"http://127.0.0.1:1\").push(partner, {})\r\n\u001b[?2004l\r"]
[96.268661, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[96.268698, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[96.268735, "o", "> "]
[96.268914, "o", "def run_cli(settings, gateway_url, partner=\"tally_insights\", period=\"2025-10\"):\r\n\u001b[?2004l\r"]
[96.268951, "o", "\u001b[?2004h> "]
[96.269117, "o", "    env = dict(os.environ, LEDGERLINE_DB_PATH=str(settings.db_path),\r\n\u001b[?2004l\r"]
[96.269155, "o", "\u001b[?2004h> "]
[96.269435, "o", "               LEDGERLINE_PARTNERS_FILE=str(settings.partners_file), LEDGERLINE_ENTITY=settings.reporting_entity,\r\n\u001b[?2004l\r"]
[96.269474, "o", "\u001b[?2004h> "]
[96.26967, "o", "               PARTNER_GATEWAY_URL=gateway_url, PARTNER_GATEWAY_TIMEOUT=\"1\")\r\n\u001b[?2004l\r"]
[96.26971, "o", "\u001b[?2004h> "]
[96.269764, "o", "    return subprocess.run(\r\n\u001b[?2004l\r"]
[96.269802, "o", "\u001b[?2004h> "]
[96.270063, "o", "        [sys.executable, \"-m\", \"ledgerline.cli\", \"partner-feed\", \"--partner\", partner, \"--period\", period],\r\n\u001b[?2004l\r"]
[96.270101, "o", "\u001b[?2004h> "]
[96.270242, "o", "        env=env, capture_output=True, text=True, timeout=10,\r\n\u001b[?2004l\r"]
[96.27028, "o", "\u001b[?2004h>     )\r\n"]
[96.270317, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[96.270354, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[96.27039, "o", "\u001b[?2004h> "]
[96.270503, "o", "def test_cli_success(store, settings, gateway):\r\n\u001b[?2004l\r"]
[96.270554, "o", "\u001b[?2004h> "]
[96.270593, "o", "    url, handler = gateway\r\n\u001b[?2004l\r"]
[96.270636, "o", "\u001b[?2004h> "]
[96.270731, "o", "    result = run_cli(settings, url)\r\n\u001b[?2004l\r"]
[96.270779, "o", "\u001b[?2004h> "]
[96.270872, "o", "    assert result.returncode == 0, result.stderr\r\n\u001b[?2004l\r"]
[96.27091, "o", "\u001b[?2004h> "]
[96.27109, "o", "    assert \"tally_insights\" in result.stdout and \"2025-10\" in result.stdout\r\n\u001b[?2004l\r"]
[96.271128, "o", "\u001b[?2004h> "]
[96.271361, "o", "    assert \"merchant rows accepted\" in result.stdout and \"receipt_id=rc_http\" in result.stdout\r\n\u001b[?2004l\r"]
[96.271403, "o", "\u001b[?2004h> "]
[96.271484, "o", "    assert len(handler.received) == 1\r\n\u001b[?2004l\r"]
[96.271522, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[96.27156, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[96.271597, "o", "> "]
[96.271709, "o", "def test_cli_empty_period(store, settings, gateway):\r\n\u001b[?2004l\r"]
[96.271778, "o", "\u001b[?2004h> "]
[96.27183, "o", "    url, handler = gateway\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.271974, "o", "    result = run_cli(settings, url, period=\"2024-01\")\r\n\u001b[?2004l\r"]
[96.272015, "o", "\u001b[?2004h> "]
[96.272177, "o", "    assert result.returncode == 0 and \"nothing sent\" in result.stdout\r\n\u001b[?2004l\r"]
[96.272216, "o", "\u001b[?2004h> "]
[96.272292, "o", "    assert handler.received == []\r\n\u001b[?2004l\r"]
[96.272331, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[96.272369, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.27251, "o", "@pytest.mark.parametrize(\"partner,period,message\", [\r\n\u001b[?2004l\r"]
[96.272548, "o", "\u001b[?2004h> "]
[96.272671, "o", "    (\"unknown\", \"2025-10\", \"unknown partner\"),\r\n\u001b[?2004l\r"]
[96.272715, "o", "\u001b[?2004h> "]
[96.272815, "o", "    (\"tally_insights\", \"2025-13\", \"period\"),\r\n\u001b[?2004l\r"]
[96.27286, "o", "\u001b[?2004h> "]
[96.272948, "o", "    (\"tally_insights\", \"0000-01\", \"period\"),\r\n\u001b[?2004l\r"]
[96.272984, "o", "\u001b[?2004h> ])\r\n\u001b[?2004l\r"]
[96.273027, "o", "\u001b[?2004h> "]
[96.273214, "o", "def test_cli_bad_arguments(store, settings, gateway, partner, period, message):\r\n\u001b[?2004l\r"]
[96.273251, "o", "\u001b[?2004h> "]
[96.273313, "o", "    url, handler = gateway\r\n\u001b[?2004l\r"]
[96.273348, "o", "\u001b[?2004h> "]
[96.273475, "o", "    result = run_cli(settings, url, partner, period)\r\n\u001b[?2004l\r"]
[96.273537, "o", "\u001b[?2004h"]
[96.273582, "o", "> "]
[96.273671, "o", "    assert result.returncode != 0 and message in result.stderr\r\n\u001b[?2004l\r"]
[96.273711, "o", "\u001b[?2004h> "]
[96.273812, "o", "    assert \"Traceback\" not in result.stderr\r\n\u001b[?2004l\r"]
[96.273853, "o", "\u001b[?2004h> "]
[96.273926, "o", "    assert handler.received == []\r\n\u001b[?2004l\r"]
[96.273965, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[96.274003, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[96.27404, "o", "> "]
[96.274173, "o", "def test_cli_gateway_rejection(store, settings, gateway):\r\n\u001b[?2004l\r\u001b[?2004h"]
[96.274215, "o", "> "]
[96.274254, "o", "    url, handler = gateway\r\n\u001b[?2004l\r"]
[96.274291, "o", "\u001b[?2004h> "]
[96.274346, "o", "    handler.status = 422\r\n\u001b[?2004l\r"]
[96.274383, "o", "\u001b[?2004h> "]
[96.274463, "o", "    result = run_cli(settings, url)\r\n\u001b[?2004l\r"]
[96.2745, "o", "\u001b[?2004h> "]
[96.274649, "o", "    assert result.returncode != 0 and \"422\" in result.stderr\r\n\u001b[?2004l\r"]
[96.274687, "o", "\u001b[?2004h> "]
[96.274788, "o", "    assert \"Traceback\" not in result.stderr\r\n\u001b[?2004l\r"]
[96.274825, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[96.274861, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[96.274898, "o", "> "]
[96.275023, "o", "def test_cli_gateway_unavailable(store, settings, gateway):\r\n\u001b[?2004l\r"]
[96.27506, "o", "\u001b[?2004h> "]
[96.275105, "o", "    url, _ = gateway\r\n\u001b[?2004l\r"]
[96.275149, "o", "\u001b[?2004h> "]
[96.275311, "o", "    # Close the isolated server, leaving a known unused local port.\r\n\u001b[?2004l\r"]
[96.275348, "o", "\u001b[?2004h> "]
[96.275521, "o", "    # The fixture will safely call shutdown/close again during cleanup.\r\n\u001b[?2004l\r"]
[96.275559, "o", "\u001b[?2004h> "]
[96.275688, "o", "    result = run_cli(settings, \"http://127.0.0.1:1\")\r\n\u001b[?2004l\r"]
[96.275726, "o", "\u001b[?2004h> "]
[96.275893, "o", "    assert result.returncode != 0 and \"unreachable\" in result.stderr\r\n\u001b[?2004l\r"]
[96.27593, "o", "\u001b[?2004h> "]
[96.276033, "o", "    assert \"Traceback\" not in result.stderr\r\n\u001b[?2004l\r"]
[96.276071, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[96.277849, "o", "\u001b[?2004hroot@817cdac2e01a:/app# "]
