[56.393266, "o", "command = '''def cmd_partner_feed(args, settings) -> int:\r\n\u001b[?2004l\r"]
[56.393311, "o", "\u001b[?2004h>     try:\r\n"]
[56.393352, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[56.393554, "o", "        partner = PartnerRegistry(settings.partners_file).get(args.partner)\r\n\u001b[?2004l\r"]
[56.393604, "o", "\u001b[?2004h> "]
[56.393721, "o", "        with closing(_store(settings)) as store:\r\n\u001b[?2004l\r"]
[56.393765, "o", "\u001b[?2004h> "]
[56.39396, "o", "            result = push_partner_feed(store, settings, partner, args.period)\r\n\u001b[?2004l\r"]
[56.394008, "o", "\u001b[?2004h> "]
[56.394295, "o", "    except (KeyError, PeriodError, GatewayError) as e:\r\n\u001b[?2004l\r"]
[56.394408, "o", "\u001b[?2004h>         print(str(e), file=sys.stderr)\r\n\u001b[?2004l\r"]
[56.394467, "o", "\u001b[?2004h> "]
