[12.634651, "o", "\"\"\"ledgerline command line.\r\n\r\n    python -m ledgerline.cli init-db [--replace]\r\n    python -m ledgerline.cli merchants\r\n    python -m ledgerline.cli summary --period YYYY-MM [--json]\r\n    python -m ledgerline.cli statement --period YYYY-MM\r\n    python -m ledgerline.cli partners\r\n    python -m ledgerline.cli gateway-health\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport argparse\r\nimport json\r\nimport sys\r\nfrom typing import Sequence\r\n\r\nfrom . import __version__\r\nfrom .config import load_settings\r\nfrom .financial_report import PeriodError, summarise_period, write_statement\r\nfrom .integrations import GatewayError, PartnerGatewayClient, PartnerRegistry\r\nfrom .store import LedgerStore\r\n\r\n\r\ndef _store(settings) -> LedgerStore:\r\n    if not settings.db_path.exists():\r\n        print(f\"database not found at {settings.db_path}; run `init-db` first\", file=sys.stderr)\r\n        raise SystemExit(2)\r\n    return LedgerStore(settings.db_path)\r\n\r\n\r\ndef cmd_init_db(args, settings) -> int:\r\n    m, s = LedgerStore(settings.db_path).load_seed(settings.seed_dir, replace=args.replace)\r\n    print(f\"loaded {m} merchants and {s} settlements into {settings.db_path}\")\r\n    return 0\r\n\r\n\r\ndef cmd_merchants(args, settings) -> int:\r\n    for m in _store(settings).merchants():\r\n        print(f\"{m.merchant_id}\\t{m.settlement_reference}\\t{m.currency}\\t{m.trading_name}\")\r\n    return 0\r\n\r\n\r\ndef cmd_summary(args, settings) -> int:\r\n    try:\r\n        summaries = summarise_period(_store(settings), args.period)\r\n    except PeriodError as e:\r\n        print(str(e), file=sys.stderr)\r\n        return 1\r\n    if args.json:\r\n        print(json.dumps([s.to_dict() for s in summaries], indent=2))\r\n        return 0\r\n    for s in summaries:\r\n        print(f\"{s.account.merchant_id}\\t{s.account.trading_name:<28}\\t{s.settlement_count:>3} settlements\\tnet {s.net_cents / 100:>12.2f} {s.currency}\")\r\n    print(f\"{len(summaries)} merchants with paid settlements in {args.period}\")\r\n    return 0\r\n\r\n\r\ndef cmd_statement(args, settings) -> int:\r\n    try:\r\n        path = write_statement(_store(settings), settings, args.period)\r\n    except PeriodError as e:\r\n        print(str(e), file=sys.stderr)\r\n        return 1\r\n    print(f\"wrote {path}\")\r\n    return 0\r\n\r\n\r\ndef cmd_partners(args, settings) -> int:\r\n    for p in PartnerRegistry(settings.partners_file).all():\r\n        print(f\"{p.partner_id:<16} {p.kind:<20} clearance={p.clearance:<12} {p.endpoint}\")\r\n    return 0\r\n\r\n\r\ndef cmd_gateway_health(args, settings) -> int:\r\n    client = PartnerGatewayClient(settings.partner_gateway_url, settings.gateway_timeout_sec, settings.reporting_entity)\r\n    try:\r\n        print(json.dumps(client.health().body))\r\n    except GatewayError as e:\r\n        print(str(e), file=sys.stderr)\r\n        return 1\r\n    return 0\r\n\r\n\r\ndef build_parser() -> argparse.ArgumentParser:\r\n    p = argparse.ArgumentParser(prog=\"ledgerline\", description=\"Corvid Payments settlement reporting CLI\")\r\n    p.add_argument(\"--version\", action=\"version\", version=f\"ledgerline {__version__}\")\r\n    sub = p.add_subparsers(dest=\"command\", required=True)\r\n    s = sub.add_parser(\"init-db\"); s.add_argument(\"--replace\", action=\"store_true\"); s.set_defaults(func=cmd_init_db)\r\n    sub.add_parser(\"merchants\", help=\"list merchant accounts\").set_defaults(func=cmd_merchants)\r\n    su = sub.add_parser(\"summary\", help=\"per-merchant paid settlement totals for a period\")\r\n    su.add_argument(\"--period\", required=True); su.add_argument(\"--json\", action=\"store_true\"); su.set_defaults(func=cmd_summary)\r\n    st = sub.add_parser(\"statement\", help=\"write the internal month-end statement\")\r\n    st.add_argument(\"--period\", required=True); st.set_defaults(func=cmd_statement)\r\n    sub.add_parser(\"partners\", help=\"list configured partners\").set_defaults(func=cmd_partners)\r\n    sub.add_parser(\"gateway-health\", help=\"check the partner gateway\").set_defaults(func=cmd_gateway_health)\r\n    return p\r\n\r\n\r\ndef main(argv: Sequence[str] | None = None) -> int:\r\n    args = build_parser().parse_args(argv)\r\n    return args.func(args, load_settings())\r\n\r\n\r\nif __name__ == \"__main__\":\r\n  "]
[12.634787, "o", "  sys.exit(main())\r\n"]
[12.635849, "o", "\"\"\"Runtime settings with local-development defaults.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport os\r\nfrom dataclasses import dataclass\r\nfrom pathlib import Path\r\n\r\nPROJECT_ROOT = Path(__file__).resolve().parent.parent\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Settings:\r\n    db_path: Path\r\n    seed_dir: Path\r\n    statements_dir: Path\r\n    partners_file: Path\r\n    partner_gateway_url: str\r\n    gateway_timeout_sec: float\r\n    reporting_entity: str\r\n\r\n    @classmethod\r\n    def from_env(cls) -> \"Settings\":\r\n        data_dir = Path(os.environ.get(\"LEDGERLINE_DATA_DIR\", PROJECT_ROOT / \"data\"))\r\n        return cls(\r\n            db_path=Path(os.environ.get(\"LEDGERLINE_DB_PATH\", data_dir / \"ledgerline.db\")),\r\n            seed_dir=Path(os.environ.get(\"LEDGERLINE_SEED_DIR\", PROJECT_ROOT / \"data\" / \"seed\")),\r\n            statements_dir=Path(os.environ.get(\"LEDGERLINE_STATEMENTS_DIR\", data_dir / \"statements\")),\r\n            partners_file=Path(os.environ.get(\"LEDGERLINE_PARTNERS_FILE\", PROJECT_ROOT / \"config\" / \"partners.json\")),\r\n            partner_gateway_url=os.environ.get(\"PARTNER_GATEWAY_URL\", \"http://127.0.0.1:8815\"),\r\n            gateway_timeout_sec=float(os.environ.get(\"PARTNER_GATEWAY_TIMEOUT\", \"10\")),\r\n            reporting_entity=os.environ.get(\"LEDGERLINE_ENTITY\", \"corvid-payments-uk\"),\r\n        )\r\n\r\n\r\ndef load_settings() -> Settings:\r\n    return Settings.from_env()\r\n"]
[12.637174, "o", "\"\"\"Merchant accounts and settlement batches.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nfrom dataclasses import asdict, dataclass\r\nfrom typing import Any\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass MerchantAccount:\r\n    merchant_id: str\r\n    legal_name: str\r\n    trading_name: str\r\n    country: str\r\n    currency: str\r\n    settlement_reference: str   # the reference quoted on statements and to partners (CPS-xxxx)\r\n    iban: str\r\n    account_number: str\r\n    sort_code: str\r\n    bank_name: str\r\n    vat_number: str | None\r\n    contact_email: str\r\n    onboarded_at: str\r\n\r\n    def to_dict(self) -> dict[str, Any]:\r\n        return asdict(self)\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Settlement:\r\n    settlement_id: str\r\n    merchant_id: str\r\n    settled_on: str            # YYYY-MM-DD\r\n    currency: str\r\n    gross_cents: int\r\n    fees_cents: int\r\n    refunds_cents: int\r\n    transaction_count: int\r\n    status: str                # paid | pending | reversed\r\n\r\n    @property\r\n    def net_cents(self) -> int:\r\n        return self.gross_cents - self.fees_cents - self.refunds_cents\r\n\r\n    def to_dict(self) -> dict[str, Any]:\r\n        d = asdict(self)\r\n        d[\"net_cents\"] = self.net_cents\r\n        return d\r\n"]
[12.638279, "o", "\"\"\"SQLite store for merchants and settlements.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport json\r\nimport sqlite3\r\nfrom datetime import date\r\nfrom pathlib import Path\r\n\r\nfrom .models import MerchantAccount, Settlement\r\n\r\nSCHEMA = \"\"\"\r\nCREATE TABLE IF NOT EXISTS merchants (\r\n    merchant_id TEXT PRIMARY KEY, legal_name TEXT NOT NULL, trading_name TEXT NOT NULL, country TEXT NOT NULL,\r\n    currency TEXT NOT NULL, settlement_reference TEXT NOT NULL UNIQUE, iban TEXT NOT NULL, account_number TEXT NOT NULL,\r\n    sort_code TEXT NOT NULL, bank_name TEXT NOT NULL, vat_number TEXT, contact_email TEXT NOT NULL, onboarded_at TEXT NOT NULL\r\n);\r\nCREATE TABLE IF NOT EXISTS settlements (\r\n    settlement_id TEXT PRIMARY KEY, merchant_id TEXT NOT NULL REFERENCES merchants(merchant_id), settled_on TEXT NOT NULL,\r\n    currency TEXT NOT NULL, gross_cents INTEGER NOT NULL, fees_cents INTEGER NOT NULL, refunds_cents INTEGER NOT NULL,\r\n    transaction_count INTEGER NOT NULL, status TEXT NOT NULL CHECK (status IN ('paid','pending','reversed'))\r\n);\r\nCREATE INDEX IF NOT EXISTS idx_settlements_merchant_day ON settlements(merchant_id, settled_on);\r\n\"\"\"\r\n\r\n\r\nclass LedgerError(LookupError):\r\n    pass\r\n\r\n\r\nclass LedgerStore:\r\n    def __init__(self, db_path: Path):\r\n        db_path.parent.mkdir(parents=True, exist_ok=True)\r\n        self._conn = sqlite3.connect(str(db_path))\r\n        self._conn.row_factory = sqlite3.Row\r\n        self._conn.executescript(SCHEMA)\r\n\r\n    def close(self) -> None:\r\n        self._conn.close()\r\n\r\n    def load_seed(self, seed_dir: Path, replace: bool = False) -> tuple[int, int]:\r\n        merchants = json.loads((seed_dir / \"merchants.json\").read_text())\r\n        settlements = json.loads((seed_dir / \"settlements.json\").read_text())\r\n        with self._conn:\r\n            if replace:\r\n                self._conn.execute(\"DELETE FROM settlements\")\r\n                self._conn.execute(\"DELETE FROM merchants\")\r\n            self._conn.executemany(\r\n                \"INSERT OR REPLACE INTO merchants VALUES (:merchant_id,:legal_name,:trading_name,:country,:currency,:settlement_reference,\"\r\n                \":iban,:account_number,:sort_code,:bank_name,:vat_number,:contact_email,:onboarded_at)\", merchants)\r\n            self._conn.executemany(\r\n                \"INSERT OR REPLACE INTO settlements VALUES (:settlement_id,:merchant_id,:settled_on,:currency,:gross_cents,:fees_cents,\"\r\n                \":refunds_cents,:transaction_count,:status)\", settlements)\r\n        return len(merchants), len(settlements)\r\n\r\n    def merchant(self, merchant_id: str) -> MerchantAccount:\r\n        row = self._conn.execute(\"SELECT * FROM merchants WHERE merchant_id = ?\", (merchant_id,)).fetchone()\r\n        if row is None:\r\n            raise LedgerError(f\"unknown merchant {merchant_id!r}\")\r\n        return MerchantAccount(**dict(row))\r\n\r\n    def merchants(self) -> list[MerchantAccount]:\r\n        return [MerchantAccount(**dict(r)) for r in self._conn.execute(\"SELECT * FROM merchants ORDER BY merchant_id\")]\r\n\r\n    def settlements_between(self, start: date, end_exclusive: date, merchant_id: str | None = None) -> list[Settlement]:\r\n        sql, params = \"SELECT * FROM settlements WHERE settled_on >= ? AND settled_on < ?\", [start.isoformat(), end_exclusive.isoformat()]\r\n        if merchant_id:\r\n            sql += \" AND merchant_id = ?\"; params.append(merchant_id)\r\n        return [Settlement(**dict(r)) for r in self._conn.execute(sql + \" ORDER BY settled_on, settlement_id\", params)]\r\n\r\n    def counts(self) -> dict[str, int]:\r\n        return {\"merchants\": self._conn.execute(\"SELECT COUNT(*) FROM merchants\").fetchone()[0],\r\n                \"settlements\": self._conn.execute(\"SELECT COUNT(*) FROM settlements\").fetchone()[0]}\r\n"]
