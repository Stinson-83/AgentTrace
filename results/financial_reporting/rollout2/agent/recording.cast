[56.397086, "o", "> "]
[56.397162, "o", "p = Path('ledgerline/integrations.py')\r\n\u001b[?2004l\r"]
[56.397175, "o", "\u001b[?2004h"]
[56.397182, "o", "> "]
[56.39823, "o", "s = p.read_text().replace('except urllib.error.URLError as e:\\n            raise GatewayError(f\"partner gateway unreachable at {self.base_url}: {e.reason}\") from e', 'except (urllib.error.URLError, OSError) as e:\\n            reason = e.reason if isinstance(e, urllib.error.URLError) else str(e)\\n            raise GatewayError(f\"partner gateway unreachable at {self.base_url}: {reason}\") from e')\r\n\u001b[?2004l\r"]
[56.39831, "o", "\u001b[?2004h"]
[56.398328, "o", "> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> "]
