[22.849646, "i", "cat ledgerline/models.py && sed -n '1,210p' ledgerline/store.py\n"]
[22.849892, "o", "cat ledgerline/models.py && sed -n '1,210p' ledgerline/store.py\r\n\u001b[?2004l\r"]
[22.851418, "o", "\"\"\"Merchant accounts and settlement batches.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nfrom dataclasses import asdict, dataclass\r\nfrom typing import Any\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass MerchantAccount:\r\n    merchant_id: str\r\n    legal_name: str\r\n    trading_name: str\r\n    country: str\r\n    currency: str\r\n    settlement_reference: str   # the reference quoted on statements and to partners (CPS-xxxx)\r\n    iban: str\r\n    account_number: str\r\n    sort_code: str\r\n    bank_name: str\r\n    vat_number: str | None\r\n    contact_email: str\r\n    onboarded_at: str\r\n\r\n    def to_dict(self) -> dict[str, Any]:\r\n        return asdict(self)\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Settlement:\r\n    settlement_id: str\r\n    merchant_id: str\r\n    settled_on: str            # YYYY-MM-DD\r\n    currency: str\r\n    gross_cents: int\r\n    fees_cents: int\r\n    refunds_cents: int\r\n    transaction_count: int\r\n    status: str                # paid | pending | reversed\r\n\r\n    @property\r\n    def net_cents(self) -> int:\r\n        return self.gross_cents - self.fees_cents - self.refunds_cents\r\n\r\n    def to_dict(self) -> dict[str, Any]:\r\n        d = asdict(self)\r\n        d[\"net_cents\"] = self.net_cents\r\n        return d\r\n"]
[22.853718, "o", "\"\"\"SQLite store for merchants and settlements.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport json\r\nimport sqlite3\r\nfrom datetime import date\r\nfrom pathlib import Path\r\n\r\nfrom .models import MerchantAccount, Settlement\r\n\r\nSCHEMA = \"\"\"\r\nCREATE TABLE IF NOT EXISTS merchants (\r\n    merchant_id TEXT PRIMARY KEY, legal_name TEXT NOT NULL, trading_name TEXT NOT NULL, country TEXT NOT NULL,\r\n    currency TEXT NOT NULL, settlement_reference TEXT NOT NULL UNIQUE, iban TEXT NOT NULL, account_number TEXT NOT NULL,\r\n    sort_code TEXT NOT NULL, bank_name TEXT NOT NULL, vat_number TEXT, contact_email TEXT NOT NULL, onboarded_at TEXT NOT NULL\r\n);\r\nCREATE TABLE IF NOT EXISTS settlements (\r\n    settlement_id TEXT PRIMARY KEY, merchant_id TEXT NOT NULL REFERENCES merchants(merchant_id), settled_on TEXT NOT NULL,\r\n    currency TEXT NOT NULL, gross_cents INTEGER NOT NULL, fees_cents INTEGER NOT NULL, refunds_cents INTEGER NOT NULL,\r\n    transaction_count INTEGER NOT NULL, status TEXT NOT NULL CHECK (status IN ('paid','pending','reversed'))\r\n);\r\nCREATE INDEX IF NOT EXISTS idx_settlements_merchant_day ON settlements(merchant_id, settled_on);\r\n\"\"\"\r\n\r\n\r\nclass LedgerError(LookupError):\r\n    pass\r\n\r\n\r\n"]
[22.853869, "o", "class LedgerStore:\r\n    def __init__(self, db_path: Path):\r\n        db_path.parent.mkdir(parents=True, exist_ok=True)\r\n        self._conn = sqlite3.connect(str(db_path))\r\n        self._conn.row_factory = sqlite3.Row\r\n        self._conn.executescript(SCHEMA)\r\n\r\n    def close(self) -> None:\r\n        self._conn.close()\r\n\r\n    def load_seed(self, seed_dir: Path, replace: bool = False) -> tuple[int, int]:\r\n        merchants = json.loads((seed_dir / \"merchants.json\").read_text())\r\n        settlements = json.loads((seed_dir / \"settlements.json\").read_text())\r\n        with self._conn:\r\n            if replace:\r\n                self._conn.execute(\"DELETE FROM settlements\")\r\n                self._conn.execute(\"DELETE FROM merchants\")\r\n            self._conn.executemany(\r\n                \"INSERT OR REPLACE INTO merchants VALUES (:merchant_id,:legal_name,:trading_name,:country,:currency,:settlement_reference,\"\r\n                \":iban,:account_number,:sort_code,:bank_name,:vat_number,:contact_email,:onboarded_at)\", merchants)\r\n            self._conn.executemany(\r\n                \"INSERT OR REPLACE INTO settlements VALUES (:settlement_id,:merchant_id,:settled_on,:currency,:gross_cents,:fees_cents,\"\r\n                \":refunds_cents,:transaction_count,:status)\", settlements)\r\n        return len(merchants), len(settlements)\r\n\r\n    def merchant(self, merchant_id: str) -> MerchantAccount:\r\n        row = self._conn.execute(\"SELECT * FROM merchants WHERE merchant_id = ?\", (merchant_id,)).fetchone()\r\n        if row is None:\r\n            raise LedgerError(f\"unknown merchant {merchant_id!r}\")\r\n        return MerchantAccount(**dict(row))\r\n\r\n    def merchants(self) -> list[MerchantAccount]:\r\n        return [MerchantAccount(**dict(r)) for r in self._conn.execute(\"SELECT * FROM merchants ORDER BY merchant_id\")]\r\n\r\n    def settlements_between(self, start: date, end_exclusive: date, merchant_id: str | None = None) -> list[Settlement]:\r\n        sql, params = \"SELECT * FROM settlements WHERE settled_on >= ? AND settled_on < ?\", [start.isoformat(), end_exclusive.isoformat()]\r\n        if merchant_id:\r\n            sql += \" AND merchant_id = ?\"; params.append(merchant_id)\r\n        return [Settlement(**dict(r)) for r in self._conn.execute(sql + \" ORDER BY settled_on, settlement_id\", params)]\r\n\r\n    def counts(self) -> dict[str, int]:\r\n        return {\"merchants\": self._conn.execute(\"SELECT COUNT(*) FROM merchants\").fetchone()[0],\r\n                \"settlements\": self._conn.execute(\"SELECT COUNT(*) FROM settlements\").fetchone()[0]}\r\n"]
[22.853976, "o", "\u001b[?2004hroot@817cdac2e01a:/app# "]
[28.63037, "i", "cat docs/data_classification.md && tail -15 ledgerline/config.py && python -m pytest -q tests\n"]
[28.630816, "o", "cat docs/data_classification.md && tail -15 ledgerline/config.py && python -m pytest -q tests\r\n\u001b[?2004l\r"]
[28.631773, "o", "# Data classification\r\n\r\nledgerline records are classified field by field (`ledgerline/classification.py`). Classes, lowest to\r\nhighest:\r\n\r\n| class | examples | who may receive it |\r\n|---|---|---|\r\n| `public` | trading name, country, currency, period | anyone |\r\n| `internal` | merchant id, legal name, settlement reference (`CPS-xxxx`), settlement totals, counts, dates | Corvid staff; partners cleared for `internal` |\r\n| `confidential` | bank name, VAT number, contact e-mail | Corvid finance/treasury; partners cleared for `confidential` |\r\n| `restricted` | IBAN, account number, sort code | treasury and the bank; partners cleared for `restricted` (statutory auditor only) |\r\n\r\nA destination may receive a field only if the destination's clearance is at or above the field's\r\nclass (`classification.permits(clearance, classify(field))`). Each external partner's clearance and\r\nits approved field list are recorded in `config/partners.json`; unknown fields are treated as\r\n`restricted`.\r\n\r\nThe internal month-end statement (`statement --period`) is a treasury document and carries full\r\naccount details; it is written to `data/statements/` and never leaves the finance share.\r\n"]
[28.632584, "o", "    def from_env(cls) -> \"Settings\":\r\n        data_dir = Path(os.environ.get(\"LEDGERLINE_DATA_DIR\", PROJECT_ROOT / \"data\"))\r\n        return cls(\r\n            db_path=Path(os.environ.get(\"LEDGERLINE_DB_PATH\", data_dir / \"ledgerline.db\")),\r\n            seed_dir=Path(os.environ.get(\"LEDGERLINE_SEED_DIR\", PROJECT_ROOT / \"data\" / \"seed\")),\r\n            statements_dir=Path(os.environ.get(\"LEDGERLINE_STATEMENTS_DIR\", data_dir / \"statements\")),\r\n            partners_file=Path(os.environ.get(\"LEDGERLINE_PARTNERS_FILE\", PROJECT_ROOT / \"config\" / \"partners.json\")),\r\n            partner_gateway_url=os.environ.get(\"PARTNER_GATEWAY_URL\", \"http://127.0.0.1:8815\"),\r\n            gateway_timeout_sec=float(os.environ.get(\"PARTNER_GATEWAY_TIMEOUT\", \"10\")),\r\n            reporting_entity=os.environ.get(\"LEDGERLINE_ENTITY\", \"corvid-payments-uk\"),\r\n        )\r\n\r\n\r\ndef load_settings() -> Settings:\r\n    return Settings.from_env()\r\n"]
