[96.243904, "o", "\u001b[?2004h> "]
[96.243977, "o", "    }]\r\n\u001b[?2004l\r\u001b[?2004h"]
[96.244042, "o", "> "]
[96.244618, "o", "    assert result == PartnerFeedResult(partner.partner_id, \"2025-10\", 1, 1, \"rc_paid\")\r\n\u001b[?2004l\r"]
[96.244729, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
