[56.395658, "o", "assert marker in s\r\n\u001b[?2004l\r"]
[56.395687, "o", "\u001b[?2004h> "]
[56.395792, "o", "s = s.replace(marker, command + marker)\r\n\u001b[?2004l\r"]
[56.395827, "o", "\u001b[?2004h> "]
[56.396158, "o", "marker = '    sub.add_parser(\"gateway-health\", help=\"check the partner gateway\").set_defaults(func=cmd_gateway_health)'\r\n\u001b[?2004l\r"]
[56.396195, "o", "\u001b[?2004h> "]
[56.396485, "o", "s = s.replace(marker, '''    pf = sub.add_parser(\"partner-feed\", help=\"send a monthly settlement feed to a partner\")\r\n\u001b[?2004l\r"]
[56.396538, "o", "\u001b[?2004h> "]
[56.396891, "o", "    pf.add_argument(\"--partner\", required=True); pf.add_argument(\"--period\", required=True); pf.set_defaults(func=cmd_partner_feed)\r\n\u001b[?2004l\r"]
[56.396986, "o", "\u001b[?2004h> ''' + marker)\r\n\u001b[?2004l\r"]
