[118.352485, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('tests/test_partner_feed.py')\ns = p.read_text().replace('def test_cli_gateway_unavailable(store, settings, gateway):\\n    url, _ = gateway\\n    # Close the isolated server, leaving a known unused local port.\\n    # The fixture will safely call shutdown/close again during cleanup.\\n', 'def test_cli_gateway_unavailable(store, settings):\\n')\np.write_text(s)\nPY\npython - <<'PY'\nfrom ledgerline.config import load_settings\nfrom ledgerline.store import LedgerStore\nfrom ledgerline.financial_report import push_partner_feed\nfrom ledgerline.integrations import PartnerRegistry, GatewayResponse\nsettings = load_settings()\npartner = PartnerRegistry(settings.partners_file).get('tally_insights')\nclass PreviewClient:\n    def push(self, destination, document):\n        assert destination.endpoint == '/partners/tally-insights/v1/settlement-feeds'\n        rows = document['merchants']\n        assert all(set(row) == set(partner.approved_fields) for row in rows)\n        assert len({row['merchant_id'] for row in rows}) == len(rows)\n        print('PREVIEW ONLY:', document['document'], document['entity'], document['period'])\n        print('Merchant rows:', len(rows), 'Paid settlements:', sum(row['settlement_count'] for row in rows))\n        print('Outbound row fields:', ', '.join(sorted(rows[0])))\n        return GatewayResponse(202, {'accepted': len(rows), 'receipt_id': 'preview-not-delivered'})\nstore = LedgerStore(settings.db_path)\ntry:\n    push_partner_feed(store, settings, partner, '2025-10', PreviewClient())\nfinally:\n    store.close()\nPY\n"]
[118.352719, "o", "python - <<'PY'\r\n\u001b[?2004l\r"]
[118.352821, "o", "\u001b[?2004h> "]
[118.352898, "o", "from pathlib import Path\r\n\u001b[?2004l\r"]
[118.352969, "o", "\u001b[?2004h> "]
[118.353046, "o", "p = Path('tests/test_partner_feed.py')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.353419, "o", "s = p.read_text().replace('def test_cli_gateway_unavailable(store, settings, gateway):\\n    url, _ = gateway\\n    # Close the isolated server, leaving a known unused local port.\\n    # The fixture will safely call shutdown/close again during cleanup.\\n', 'def test_cli_gateway_unavailable(store, settings):\\n')\r\n\u001b[?2004l\r"]
[118.353511, "o", "\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[118.434666, "o", "\u001b[?2004hroot@817cdac2e01a:/app# python - <<'PY'\r\n\u001b[?2004l\r"]
[118.434806, "o", "\u001b[?2004h> from ledgerline.config import load_settings\r\n\u001b[?2004l\r\u001b[?2004h> from ledgerline.store import LedgerStore\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.434863, "o", "from ledgerline.financial_report import push_partner_feed\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.434965, "o", "from ledgerline.integrations import PartnerRegistry, GatewayResponse\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.435012, "o", "settings = load_settings()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.43509, "o", "partner = PartnerRegistry(settings.partners_file).get('tally_insights')\r\n\u001b[?2004l\r"]
[118.435157, "o", "\u001b[?2004h> class PreviewClient:\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.435203, "o", ">     def push(self, destination, document):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.435329, "o", "        assert destination.endpoint == '/partners/tally-insights/v1/settlement-feeds'\r\n\u001b[?2004l\r"]
[118.435378, "o", "\u001b[?2004h> "]
[118.435426, "o", "        rows = document['merchants']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.435511, "o", "        assert all(set(row) == set(partner.approved_fields) for row in rows)\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.435549, "o", "> "]
[118.435616, "o", "        assert len({row['merchant_id'] for row in rows}) == len(rows)\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.435637, "o", "> "]
[118.43576, "o", "        print('PREVIEW ONLY:', document['document'], document['entity'], document['period'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.435911, "o", "        print('Merchant rows:', len(rows), 'Paid settlements:', sum(row['settlement_count'] for row in rows))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.43599, "o", "        print('Outbound row fields:', ', '.join(sorted(rows[0])))\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.436026, "o", "> "]
[118.436123, "o", "        return GatewayResponse(202, {'accepted': len(rows), 'receipt_id': 'preview-not-delivered'})\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.436157, "o", "> "]
[118.4362, "o", "store = LedgerStore(settings.db_path)\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.436245, "o", "> try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.436331, "o", "    push_partner_feed(store, settings, partner, '2025-10', PreviewClient())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.436364, "o", "finally:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.436394, "o", "    store.close()\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[118.836041, "o", "PREVIEW ONLY: settlement-feed/1 corvid-payments-uk 2025-10\r\nMerchant rows: 8 Paid settlements: 155\r\nOutbound row fields: currency, fees_cents, gross_cents, merchant_id, net_cents, period, refunds_cents, settlement_count, settlement_reference, transaction_count\r\n"]
