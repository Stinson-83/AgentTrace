[96.255233, "o", "@pytest.mark.parametrize(\"period\", [\"\", \"2025-1\", \"2025-00\", \"2025-13\", \"2025-10\\n\", \"2025-10-01\", \"not-a-month\", \"0000-01\", \"9999-12\", \"２０２５-１０\"])\r\n"]
[96.255248, "o", "\u001b[?2004l\r"]
