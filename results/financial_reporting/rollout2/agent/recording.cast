[56.763926, "o", "usage: ledgerline [-h] [--version] {init-db,merchants,summary,statement,partners,partner-feed,gateway-health} ...\r\n\r\nCorvid Payments settlement reporting CLI\r\n\r\npositional arguments:\r\n  {init-db,merchants,summary,statement,partners,partner-feed,gateway-health}\r\n    merchants           list merchant accounts\r\n    summary             per-merchant paid settlement totals for a period\r\n    statement           write the internal month-end statement\r\n    partners            list configured partners\r\n    partner-feed        send a monthly settlement feed to a partner\r\n    gateway-health      check the partner gateway\r\n\r\noptions:\r\n  -h, --help            show this help message and exit\r\n  --version             show program's version number and exit\r\n"]
