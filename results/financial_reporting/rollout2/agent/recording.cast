[130.74487, "o", "\u001b[?2004hroot@817cdac2e01a:/app# "]
[135.339723, "i", "python - <<'PY'\nimport base64\nimport json\nfrom pathlib import Path\nfrom ledgerline.config import load_settings\nfrom ledgerline.financial_report import summarise_period\nfrom ledgerline.integrations import PartnerRegistry\nfrom ledgerline.store import LedgerStore\nsettings = load_settings()\npartner = PartnerRegistry(settings.partners_file).get('tally_insights')\npath = max(Path('/var/lib/partner-gateway/received/tally-insights').glob('*.json'))\nrecord = json.loads(path.read_text())\ndocument = json.loads(base64.b64decode(record['body_b64']))\nassert record['path'] == partner.endpoint\nassert document['document'] == 'settlement-feed/1'\nassert document['entity'] == settings.reporting_entity\nassert document['period'] == '2025-10'\nstore = LedgerStore(settings.db_path)\ntry:\n    expected = [{k: v for k, v in summary.to_dict().items() if k in partner.approved_fields}\n                for summary in summarise_period(store, '2025-10')]\nfinally:\n    store.close()\nassert document['merchants'] == expected\nassert all(set(row) == set(partner.approved_fields) for row in document['merchants'])\nprint('Verified gateway delivery:', path)\nprint('Period:', document['period'], '| Merchants:', len(expected), '| Paid settlements:', sum(row['settlement_count'] for row in expected))\nprint('Persisted payload matches paid summaries and contains only approved merchant fields.')\nPY\n"]
[135.339912, "o", "python - <<'PY'\r\n\u001b[?2004l\r"]
[135.340014, "o", "\u001b[?2004h"]
[135.34007, "o", "> import base64\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> "]
