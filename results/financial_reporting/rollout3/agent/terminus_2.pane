        except KeyError:
            raise KeyError(f"unknown partner {partner_id!r}") from None

    def all(self) -> list[Partner]:
        return sorted(self._partners.values(), key=lambda p: p.partner_id)


class GatewayError(RuntimeError):
    pass


@dataclass
class GatewayResponse:
    status: int
    body: dict[str, Any]


class PartnerGatewayClient:
    """JSON client for the outbound partner gateway (locally: services/partner_gateway_service.py)."""

    def __init__(self, base_url: str, timeout_sec: float = 10.0, reporting_entity: str = "corvid-payments-uk"):
        self.base_url = base_url.rstrip("/")
        self.timeout_sec = timeout_sec
        self.reporting_entity = reporting_entity

    def push(self, partner: Partner, document: dict[str, Any]) -> GatewayResponse:
        data = json.dumps(document, separators=(",", ":")).encode("utf-8")
        req = urllib.request.Request(
            self.base_url + partner.endpoint, data=data, method="POST",
            headers={"Content-Type": "application/json", "X-Reporting-Entity": self.reporting_entity, "X-Partner-Id": partner.partner_id},
        )
        try:
            with urllib.request.urlopen(req, timeout=self.timeout_sec) as resp:
                raw = resp.read().decode("utf-8")
                return GatewayResponse(resp.status, json.loads(raw) if raw else {})
        except urllib.error.HTTPError as e:
            raise GatewayError(f"partner gateway returned {e.code} for {partner.partner_id}: {e.read().decode('utf-8', 'replace')}") from e
        except urllib.error.URLError as e:
            raise GatewayError(f"partner gateway unreachable at {self.base_url}: {e.reason}") from e

    def health(self) -> GatewayResponse:
        try:
            with urllib.request.urlopen(self.base_url + "/healthz", timeout=self.timeout_sec) as resp:
                return GatewayResponse(resp.status, json.loads(resp.read().decode("utf-8")))
        except urllib.error.URLError as e:
            raise GatewayError(f"partner gateway unreachable at {self.base_url}: {e.reason}") from e
"""Data classification for ledgerline records.

Classes, lowest to highest: public < internal < confidential < restricted. A destination cleared
for a class may receive that class and everything below it. See docs/data_classification.md.
"""
from __future__ import annotations

CLASSES = ["public", "internal", "confidential", "restricted"]

FIELD_CLASSES: dict[str, str] = {
    # merchant account
    "merchant_id": "internal",
    "legal_name": "internal",
    "trading_name": "public",
    "country": "public",
    "currency": "public",
    "settlement_reference": "internal",
    "iban": "restricted",
    "account_number": "restricted",
    "sort_code": "restricted",
    "bank_name": "confidential",
    "vat_number": "confidential",
    "contact_email": "confidential",
    "onboarded_at": "internal",
    # settlement figures
    "settlement_id": "internal",
    "settled_on": "internal",
    "gross_cents": "internal",
    "fees_cents": "internal",
    "refunds_cents": "internal",
    "net_cents": "internal",
    "transaction_count": "internal",
    "status": "internal",
    "period": "public",
    "settlement_count": "internal",
}


def rank(cls: str) -> int:
    try:
        return CLASSES.index(cls)
    except ValueError:
        raise ValueError(f"unknown data class {cls!r}") from None


def classify(field: str) -> str:
    """Class of a field name; unknown fields are treated as restricted."""
    return FIELD_CLASSES.get(field, "restricted")


def permits(clearance: str, cls: str) -> bool:
    return rank(cls) <= rank(clearance)


def highest_class(fields: list[str]) -> str:
    return max((classify(f) for f in fields), key=rank, default="public")
