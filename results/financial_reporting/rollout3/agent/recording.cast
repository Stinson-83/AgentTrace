[144.979585, "i", "python - <<'PY'\nimport base64\nimport json\nfrom pathlib import Path\nfrom ledgerline.classification import classify, permits\n\nfolder = Path('/var/lib/partner-gateway/received/tally-insights')\npath = max(folder.glob('*.json'), key=lambda p: p.stat().st_mtime_ns)\nrecord = json.loads(path.read_text())\ndoc = json.loads(base64.b64decode(record['body_b64']))\nassert record['method'] == 'POST'\nassert record['path'] == '/partners/tally-insights/v1/settlement-feeds'\nassert doc['document'] == 'settlement-feed/1' and doc['period'] == '2025-10'\nassert len(doc['merchants']) == 8\nassert all(permits('internal', classify(k)) for row in doc['merchants'] for k in row)\nprint('Verified stored delivery:', path)\nprint('Period:', doc['period'], '| Merchant rows:', len(doc['merchants']), '| All row fields permitted for Tally')\nPY\n"]
