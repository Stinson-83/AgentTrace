[130.942744, "o", "    push_partner_feed(store, settings, PartnerRegistry(settings.partners_file).get('tally_insights'), '2025-10', Preview())\r\n\u001b[?2004l\r"]
[130.942757, "o", "\u001b[?2004h> "]
