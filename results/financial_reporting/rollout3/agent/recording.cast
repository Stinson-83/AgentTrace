[115.486942, "o", "> "]
[115.487025, "o", "    assert cli.main([\"partner-feed\", \"--partner\", partner_id, \"--period\", period]) != 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.487054, "o", "> "]
