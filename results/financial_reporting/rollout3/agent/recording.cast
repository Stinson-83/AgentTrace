[130.940156, "o", "\u001b[?2004l\r\u001b[?2004h"]
[130.940177, "o", "> "]
[130.94028, "o", "        rows = doc['merchants']\r\n\u001b[?2004l\r"]
[130.940303, "o", "\u001b[?2004h"]
[130.940327, "o", "> "]
[130.940626, "o", "        assert all(permits(partner.clearance, classify(k)) for row in rows for k in row)\r\n\u001b[?2004l\r"]
[130.940675, "o", "\u001b[?2004h> "]
[130.940944, "o", "        print('Preview (not sent):', doc['document'], doc['entity'], doc['period'])\r\n\u001b[?2004l\r"]
[130.94097, "o", "\u001b[?2004h"]
[130.940992, "o", "> "]
[130.941264, "o", "        print('Merchant rows:', len(rows))\r\n"]
