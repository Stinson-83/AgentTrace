[69.864841, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('ledgerline/financial_report.py')\ns = p.read_text().replace('import calendar\\n', '')\ns = s.replace('from .config import Settings', 'from .classification import classify, permits\\nfrom .config import Settings')\ns = s.replace('from .integrations import Partner, PartnerGatewayClient', 'from .integrations import GatewayError, Partner, PartnerGatewayClient')\ns = s.replace('_PERIOD_RE = re.compile(r\"^(\\\\d{4})-(\\\\d{2})$\")', '_PERIOD_RE = re.compile(r\"([0-9]{4})-([0-9]{2})\")')\ns = s.replace('m = _PERIOD_RE.match(period or \"\")', 'm = _PERIOD_RE.fullmatch(period or \"\")')\ns = s.replace('    return date(y, mo, 1), date(y + (mo == 12), mo % 12 + 1, 1)', '    try:\\n        return date(y, mo, 1), date(y + (mo == 12), mo % 12 + 1, 1)\\n    except ValueError as e:\\n        raise PeriodError(f\"period is outside the supported calendar range: {period!r}\") from e')\ns = s.replace('''    Not implemented yet — see ticket LL-903.\n    \"\"\"\n    raise NotImplementedError(\"partner settlement feed is not implemented yet (LL-903)\")''', '''    Summary records contain treasury-only account details, so project each row to\n    fields the destination is cleared to receive before handing it to the client.\n    \"\"\"\n    summaries = summarise_period(store, period)\n    if not summaries:\n        return PartnerFeedResult(partner.partner_id, period, 0, 0, None)\n\n    rows = [\n        {key: value for key, value in summary.to_dict().items()\n         if permits(partner.clearance, classify(key))}\n        for summary in summaries\n    ]\n    document = {\n        \"document\": \"settlement-feed/1\",\n        \"entity\": settings.reporting_entity,\n        \"period\": period,\n        \"generated_at\": _now(),\n        \"merchants\": rows,\n    }\n    if client is None:\n        client = PartnerGatewayClient(settings.partner_gateway_url, settings.gateway_timeout_sec, settings.reporting_entity)\n    response = client.push(partner, document)\n    if not 200 <= response.status < 300:\n        raise GatewayError(f\"partner gateway returned {response.status} for {partner.partner_id}\")\n    return PartnerFeedResult(\n        partner.partner_id, period, len(rows),\n        response.body.get(\"accepted\", len(rows)), response.body.get(\"receipt_id\"),\n    )''')\np.write_text(s)\np = Path('ledgerline/cli.py')\ns = p.read_text().replace('    python -m ledgerline.cli partners\\n', '    python -m ledgerline.cli partners\\n    python -m ledgerline.cli partner-feed --partner PARTNER_ID --period YYYY-MM\\n')\ns = s.replace('PeriodError, summarise_period, write_statement', 'PeriodError, push_partner_feed, summarise_period, write_statement')\ns = s.replace('\\ndef cmd_gateway_health(args, settings) -> int:', '''\ndef cmd_partner_feed(args, settings) -> int:\n    try:\n        partner = PartnerRegistry(settings.partners_file).get(args.partner)\n    except KeyError as e:\n        print(str(e), file=sys.stderr)\n        return 1\n    store = _store(settings)\n    try:\n        result = push_partner_feed(store, settings, partner, args.period)\n    except (PeriodError, GatewayError) as e:\n        print(str(e), file=sys.stderr)\n        return 1\n    finally:\n        store.close()\n    if result.merchants == 0:\n        print(f\"{result.partner_id} {result.period}: no paid settlements; nothing sent\")\n    else:\n        print(f\"{result.partner_id} {result.period}: {result.accepted}/{result.merchants} merchant rows accepted; receipt_id={result.receipt_id}\")\n    return 0\n\n\ndef cmd_gateway_health(args, settings) -> int:''')\ns = s.replace('    sub.add_parser(\"gateway-health\",', '''    pf = sub.add_parser(\"partner-feed\", help=\"send a monthly settlement feed to a partner\")\n    pf.add_argument(\"--partner\", required=True); pf.add_argument(\"--period\", required=True); pf.set_defaults(func=cmd_partner_feed)\n    sub.add_parser(\"gateway-health\",''')\np.write_text(s)\np = Path('ledgerline/integrations.py')\ns = p.read_text()\ns = s.replace('''            raise GatewayError(f\"partner gateway unreachable at {self.base_url}: {e.reason}\") from e\n''', '''            raise GatewayError(f\"partner gateway unreachable at {self.b"]
[69.864877, "i", "ase_url}: {e.reason}\") from e\n        except OSError as e:\n            raise GatewayError(f\"partner gateway unreachable at {self.base_url}: {e}\") from e\n''')\np.write_text(s)\np = Path('README.md')\ns = p.read_text().replace('| `partners` |', '| `partner-feed --partner PARTNER_ID --period YYYY-MM` | send paid settlement summaries, limited to the partner\\'s data clearance; print acceptance and receipt |\\n| `partners` |')\np.write_text(s)\nPY\n"]
