[115.487313, "o", "> "]
[115.48737, "o", "    cli_gateway.side_effect = GatewayError(\"gateway unreachable\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.487396, "o", "> "]
[115.487486, "o", "    assert cli.main([\"partner-feed\", \"--partner\", \"tally_insights\", \"--period\", \"2025-10\"]) != 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.487512, "o", "> "]
[115.487536, "o", "    output = capsys.readouterr()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.487619, "o", "    assert \"gateway unreachable\" in output.err and output.out == \"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.487645, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.48772, "o", "@pytest.mark.parametrize(\"option\", [\"--partner\", \"--period\"])\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.487747, "o", "> "]
[115.487773, "o", "def test_cli_required_options(option):\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.487799, "o", "> "]
[115.487831, "o", "    with pytest.raises(SystemExit) as exc:\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.487857, "o", "> "]
[115.487899, "o", "        cli.main([\"partner-feed\", option, \"value\"])\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.487926, "o", "> "]
[115.487956, "o", "    assert exc.value.code != 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[115.487995, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.488073, "o", "def test_gateway_serializes_and_routes_feed(store, settings, partner, monkeypatch):\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.488099, "o", "> "]
[115.488124, "o", "    response = Mock()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.488147, "o", "    response.status = 202\r\n\u001b[?2004l\r"]
[115.488174, "o", "\u001b[?2004h> "]
[115.488244, "o", "    response.read.return_value = b'{\"accepted\": 8, \"receipt_id\": \"rc_http\"}'\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.488271, "o", "> "]
[115.488312, "o", "    response.__enter__ = Mock(return_value=response)\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.488338, "o", "> "]
[115.488377, "o", "    response.__exit__ = Mock(return_value=False)\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.488402, "o", "> "]
[115.488433, "o", "    urlopen = Mock(return_value=response)\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.488459, "o", "> "]
[115.488509, "o", "    monkeypatch.setattr(\"urllib.request.urlopen\", urlopen)\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.488535, "o", "> "]
[115.488594, "o", "    result = push_partner_feed(store, settings, partner, \"2025-10\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.488621, "o", "> "]
[115.488649, "o", "    request = urlopen.call_args.args[0]\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.488675, "o", "> "]
[115.488746, "o", "    assert request.full_url == settings.partner_gateway_url + partner.endpoint\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.488773, "o", "> "]
[115.488803, "o", "    assert request.get_method() == \"POST\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.488829, "o", "> "]
[115.488884, "o", "    headers = {k.lower(): v for k, v in request.header_items()}\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.48891, "o", "> "]
[115.488957, "o", "    assert headers[\"content-type\"] == \"application/json\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.488984, "o", "> "]
[115.48903, "o", "    assert headers[\"x-partner-id\"] == partner.partner_id\r\n\u001b[?2004l\r"]
[115.48906, "o", "\u001b[?2004h> "]
[115.489124, "o", "    assert headers[\"x-reporting-entity\"] == settings.reporting_entity\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.48915, "o", "> "]
[115.489173, "o", "    doc = json.loads(request.data)\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.489199, "o", "> "]
[115.489272, "o", "    assert doc[\"document\"] == \"settlement-feed/1\" and len(doc[\"merchants\"]) == 8\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.489299, "o", "> "]
[115.489352, "o", "    assert all(\"iban\" not in row for row in doc[\"merchants\"])\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.489378, "o", "> "]
[115.489448, "o", "    assert urlopen.call_args.kwargs[\"timeout\"] == settings.gateway_timeout_sec\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.489474, "o", "> "]
[115.489554, "o", "    assert result == PartnerFeedResult(partner.partner_id, \"2025-10\", 8, 8, \"rc_http\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.489581, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.489627, "o", "@pytest.mark.parametrize(\"error\", [\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.489653, "o", "> "]
[115.489691, "o", "    urllib.error.URLError(\"connection refused\"),\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.489717, "o", "> "]
[115.489746, "o", "    TimeoutError(\"timed out\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.489861, "o", "    urllib.error.HTTPError(\"http://gateway\", 422, \"rejected\", {}, io.BytesIO(b'invalid document')),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.489888, "o", "])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.489973, "o", "def test_gateway_transport_failures(store, settings, partner, monkeypatch, error):\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.489998, "o", "> "]
