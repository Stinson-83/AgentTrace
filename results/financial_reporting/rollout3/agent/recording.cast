[115.463617, "o", "\u001b[?2004h> )\r\n"]
[115.46369, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[115.464133, "o", "from ledgerline.integrations import GatewayError, GatewayResponse, PartnerGatewayClient, PartnerRegistry\r\n\u001b[?2004l\r"]
[115.464166, "o", "\u001b[?2004h> \r\n"]
[115.464219, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[115.464268, "o", "\u001b[?2004h> "]
[115.464347, "o", "@pytest.fixture()\r\n\u001b[?2004l\r"]
[115.464393, "o", "\u001b[?2004h> "]
[115.464505, "o", "def partner(settings):\r\n\u001b[?2004l\r"]
[115.46455, "o", "\u001b[?2004h> "]
[115.46491, "o", "    return PartnerRegistry(settings.partners_file).get(\"tally_insights\")\r\n\u001b[?2004l\r"]
[115.464961, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[115.465007, "o", "\u001b[?2004h"]
[115.465069, "o", "> \r\n\u001b[?2004l\r"]
[115.4651, "o", "\u001b[?2004h> "]
[115.465192, "o", "@pytest.fixture()\r\n\u001b[?2004l\r"]
[115.465239, "o", "\u001b[?2004h> "]
[115.465375, "o", "def client():\r\n\u001b[?2004l\r"]
[115.465438, "o", "\u001b[?2004h> "]
[115.465664, "o", "    client = Mock(spec=PartnerGatewayClient)\r\n\u001b[?2004l\r"]
[115.465724, "o", "\u001b[?2004h> "]
[115.46618, "o", "    client.push.return_value = GatewayResponse(202, {\"accepted\": 3, \"receipt_id\": \"rc_test\"})\r\n\u001b[?2004l\r"]
[115.46623, "o", "\u001b[?2004h> "]
[115.466318, "o", "    return client\r\n\u001b[?2004l\r"]
[115.466362, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[115.466406, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[115.466449, "o", "\u001b[?2004h> "]
[115.466835, "o", "def test_feed_document_and_paid_totals(store, settings, partner, client):\r\n\u001b[?2004l\r"]
[115.466901, "o", "\u001b[?2004h"]
[115.466943, "o", "> "]
[115.467308, "o", "    result = push_partner_feed(store, settings, partner, \"2025-10\", client=client)\r\n\u001b[?2004l\r"]
[115.467352, "o", "\u001b[?2004h> "]
[115.467548, "o", "    client.push.assert_called_once()\r\n\u001b[?2004l\r"]
[115.467591, "o", "\u001b[?2004h> "]
[115.467847, "o", "    destination, doc = client.push.call_args.args\r\n\u001b[?2004l\r"]
[115.467892, "o", "\u001b[?2004h> "]
[115.468075, "o", "    assert destination == partner\r\n\u001b[?2004l\r"]
[115.468118, "o", "\u001b[?2004h> "]
[115.468563, "o", "    assert set(doc) == {\"document\", \"entity\", \"period\", \"generated_at\", \"merchants\"}\r\n\u001b[?2004l\r"]
[115.468629, "o", "\u001b[?2004h> "]
[115.468859, "o", "    assert doc[\"document\"] == \"settlement-feed/1\"\r\n\u001b[?2004l\r"]
[115.468902, "o", "\u001b[?2004h> "]
[115.469199, "o", "    assert doc[\"entity\"] == settings.reporting_entity\r\n\u001b[?2004l\r"]
[115.469242, "o", "\u001b[?2004h> "]
[115.469435, "o", "    assert doc[\"period\"] == \"2025-10\"\r\n\u001b[?2004l\r"]
[115.469477, "o", "\u001b[?2004h> "]
[115.469707, "o", "    assert doc[\"generated_at\"].endswith(\"Z\")\r\n\u001b[?2004l\r"]
[115.469749, "o", "\u001b[?2004h> "]
[115.470362, "o", "    assert datetime.fromisoformat(doc[\"generated_at\"].replace(\"Z\", \"+00:00\")).utcoffset().total_seconds() == 0\r\n\u001b[?2004l\r"]
[115.470425, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[115.470469, "o", "\u001b[?2004h> "]
[115.470812, "o", "    settlements = store.settlements_between(*period_bounds(\"2025-10\"))\r\n\u001b[?2004l\r"]
[115.470878, "o", "\u001b[?2004h> "]
[115.471263, "o", "    assert {s.status for s in settlements} == {\"paid\", \"pending\", \"reversed\"}\r\n\u001b[?2004l\r"]
[115.471306, "o", "\u001b[?2004h> "]
[115.471599, "o", "    paid = [s for s in settlements if s.status == \"paid\"]\r\n\u001b[?2004l\r"]
[115.471644, "o", "\u001b[?2004h> "]
[115.471881, "o", "    ids = sorted({s.merchant_id for s in paid})\r\n\u001b[?2004l\r"]
[115.471924, "o", "\u001b[?2004h> "]
[115.472244, "o", "    assert [r[\"merchant_id\"] for r in doc[\"merchants\"]] == ids\r\n\u001b[?2004l\r"]
[115.472286, "o", "\u001b[?2004h> "]
[115.472455, "o", "    for row in doc[\"merchants\"]:\r\n\u001b[?2004l\r"]
[115.472497, "o", "\u001b[?2004h> "]
[115.472788, "o", "        merchant = store.merchant(row[\"merchant_id\"])\r\n\u001b[?2004l\r"]
[115.472834, "o", "\u001b[?2004h> "]
[115.473197, "o", "        batches = [s for s in paid if s.merchant_id == row[\"merchant_id\"]]\r\n\u001b[?2004l\r"]
[115.473251, "o", "\u001b[?2004h> "]
[115.473488, "o", "        assert row[\"settlement_reference\"] == merchant.settlement_reference\r\n\u001b[?2004l\r"]
[115.473533, "o", "\u001b[?2004h> "]
[115.473673, "o", "        assert row[\"currency\"] == merchant.currency\r\n\u001b[?2004l\r"]
[115.473716, "o", "\u001b[?2004h> "]
[115.473834, "o", "        assert row[\"period\"] == \"2025-10\"\r\n\u001b[?2004l\r"]
[115.473874, "o", "\u001b[?2004h> "]
[115.474005, "o", "        assert row[\"settlement_count\"] == len(batches)\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.474051, "o", "> "]
[115.474303, "o", "        for field in (\"transaction_count\", \"gross_cents\", \"fees_cents\", \"refunds_cents\", \"net_cents\"):\r\n\u001b[?2004l\r"]
[115.474344, "o", "\u001b[?2004h> "]
[115.474516, "o", "            assert row[field] == sum(getattr(s, field) for s in batches)\r\n\u001b[?2004l\r"]
[115.474555, "o", "\u001b[?2004h> "]
[115.474837, "o", "        summary = next(s for s in summarise_period(store, \"2025-10\") if s.account.merchant_id == row[\"merchant_id\"])\r\n\u001b[?2004l\r"]
[115.474879, "o", "\u001b[?2004h> "]
[115.475174, "o", "        assert row == {k: v for k, v in summary.to_dict().items() if permits(partner.clearance, classify(k))}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.47546, "o", "        assert not {\"iban\", \"account_number\", \"sort_code\", \"bank_name\", \"vat_number\", \"contact_email\"} & row.keys()\r\n\u001b[?2004l\r"]
[115.4755, "o", "\u001b[?2004h> "]
[115.475726, "o", "    assert result == PartnerFeedResult(partner.partner_id, \"2025-10\", len(ids), 3, \"rc_test\")\r\n\u001b[?2004l\r"]
[115.475769, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rn\u001b[?2004h> \r\n\u001b[?2004l\r"]
[115.475809, "o", "\u001b[?2004h> "]
[115.476018, "o", "def test_feed_filters_unknown_fields(store, settings, partner, client, monkeypatch):\r\n\u001b[?2004l\r"]
[115.476074, "o", "\u001b[?2004h> "]
[115.476205, "o", "    original = MerchantSettlementSummary.to_dict\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.47654, "o", "    monkeypatch.setattr(MerchantSettlementSummary, \"to_dict\", lambda s: {**original(s), \"future_private_field\": \"private\"})\r\n\u001b[?2004l\r"]
[115.476604, "o", "\u001b[?2004h> "]
[115.476766, "o", "    push_partner_feed(store, settings, partner, \"2025-10\", client)\r\n\u001b[?2004l\r"]
[115.47681, "o", "\u001b[?2004h> "]
[115.477103, "o", "    assert all(\"future_private_field\" not in row for row in client.push.call_args.args[1][\"merchants\"])\r\n\u001b[?2004l\r"]
[115.477149, "o", "\u001b[?2004h> \r\n\u001b[?2004l\re\u001b[?2004h> \r\n\u001b[?2004l\r"]
[115.477189, "o", "\u001b[?2004h> "]
[115.477407, "o", "@pytest.mark.parametrize(\"clearance\", [\"internal\", \"confidential\", \"restricted\"])\r\n\u001b[?2004l\r"]
[115.477448, "o", "\u001b[?2004h> "]
[115.477692, "o", "def test_feed_obeys_destination_clearance(store, settings, partner, client, clearance):\r\n\u001b[?2004l\r"]
[115.477753, "o", "\u001b[?2004h> "]
[115.47787, "o", "    partner = replace(partner, clearance=clearance)\r\n\u001b[?2004l\r"]
[115.477912, "o", "\u001b[?2004h> "]
[115.478105, "o", "    push_partner_feed(store, settings, partner, \"2025-10\", client)\r\n\u001b[?2004l\r"]
[115.478151, "o", "\u001b[?2004h> "]
[115.478295, "o", "    rows = client.push.call_args.args[1][\"merchants\"]\r\n\u001b[?2004l\r"]
[115.478337, "o", "\u001b[?2004h> "]
[115.478383, "o", "    for row in rows:\r\n\u001b[?2004l\r"]
[115.478424, "o", "\u001b[?2004h> "]
[115.478625, "o", "        assert all(permits(clearance, classify(field)) for field in row)\r\n\u001b[?2004l\r"]
[115.478667, "o", "\u001b[?2004h> "]
[115.478871, "o", "    assert (\"bank_name\" in rows[0]) == permits(clearance, \"confidential\")\r\n\u001b[?2004l\r"]
[115.478912, "o", "\u001b[?2004h> "]
[115.479086, "o", "    assert (\"iban\" in rows[0]) == permits(clearance, \"restricted\")\r\n\u001b[?2004l\r"]
[115.479126, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rc\u001b[?2004h> \r\n\u001b[?2004l\r"]
[115.479175, "o", "\u001b[?2004h> "]
[115.479385, "o", "def test_feed_uses_configured_client(store, settings, partner, client, monkeypatch):\r\n\u001b[?2004l\r"]
[115.479426, "o", "\u001b[?2004h> "]
[115.479517, "o", "    factory = Mock(return_value=client)\r\n\u001b[?2004l\r"]
[115.479557, "o", "\u001b[?2004h> "]
[115.479745, "o", "    monkeypatch.setattr(financial_report, \"PartnerGatewayClient\", factory)\r\n\u001b[?2004l\r"]
[115.479787, "o", "\u001b[?2004h> "]
[115.479914, "o", "    push_partner_feed(store, settings, partner, \"2025-10\")\r\n\u001b[?2004l\r"]
[115.479952, "o", "\u001b[?2004h> "]
[115.480252, "o", "    factory.assert_called_once_with(settings.partner_gateway_url, settings.gateway_timeout_sec, settings.reporting_entity)\r\n\u001b[?2004l\r"]
[115.480292, "o", "\u001b[?2004h> "]
[115.480364, "o", "    client.push.assert_called_once()\r\n\u001b[?2004l\r"]
[115.480406, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[115.480445, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.480559, "o", "@pytest.mark.parametrize(\"injected\", [True, False])\r\n\u001b[?2004l\r"]
[115.480597, "o", "\u001b[?2004h> "]
[115.480822, "o", "def test_empty_feed_does_not_push(store, settings, partner, client, monkeypatch, injected):\r\n\u001b[?2004l\r"]
[115.480874, "o", "\u001b[?2004h> "]
[115.481079, "o", "    factory = Mock(side_effect=AssertionError(\"empty period must not construct a gateway client\"))\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.481123, "o", "> "]
[115.481263, "o", "    monkeypatch.setattr(financial_report, \"PartnerGatewayClient\", factory)\r\n\u001b[?2004l\r"]
[115.481305, "o", "\u001b[?2004h> "]
[115.481505, "o", "    result = push_partner_feed(store, settings, partner, \"2024-01\", client if injected else None)\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.481544, "o", "> "]
[115.48171, "o", "    assert result == PartnerFeedResult(partner.partner_id, \"2024-01\", 0, 0, None)\r\n\u001b[?2004l\r"]
[115.481748, "o", "\u001b[?2004h> "]
[115.481811, "o", "    client.push.assert_not_called()\r\n\u001b[?2004l\r"]
[115.481848, "o", "\u001b[?2004h> "]
[115.481905, "o", "    factory.assert_not_called()\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.48194, "o", "> \r\n\u001b[?2004l\rt\u001b[?2004h> \r\n\u001b[?2004l\rt\u001b[?2004h"]
[115.481975, "o", "> "]
[115.482151, "o", "def test_period_with_only_unpaid_settlements_does_not_push(store, settings, partner, client):\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.482185, "o", "> "]
[115.482219, "o", "    with store._conn:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.4825, "o", "        store._conn.execute(\"UPDATE settlements SET status = 'pending' WHERE settled_on >= '2025-10-01' AND settled_on < '2025-11-01'\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.482532, "o", "> "]
[115.482772, "o", "    assert push_partner_feed(store, settings, partner, \"2025-10\", client) == PartnerFeedResult(partner.partner_id, \"2025-10\", 0, 0, None)\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.482806, "o", "> "]
[115.482855, "o", "    client.push.assert_not_called()\r\n\u001b[?2004l\r"]
[115.482889, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[115.48292, "o", "> \r\n\u001b[?2004l\r_\u001b[?2004h> "]
[115.483178, "o", "@pytest.mark.parametrize(\"period\", [\"\", \"2025-1\", \"2025-00\", \"2025-13\", \"2025-10-01\", \"2025-10\\n\", \"0000-01\", \"9999-12\", \"not-a-month\"])\r\n\u001b[?2004l\r"]
[115.48321, "o", "\u001b[?2004h> "]
[115.483351, "o", "def test_feed_invalid_period_does_not_push(store, settings, partner, client, period):\r\n\u001b[?2004l\r"]
[115.483384, "o", "\u001b[?2004h> "]
[115.483434, "o", "    with pytest.raises(PeriodError):\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.483466, "o", "> "]
[115.483573, "o", "        push_partner_feed(store, settings, partner, period, client)\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.483606, "o", "> "]
[115.483653, "o", "    client.push.assert_not_called()\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.483683, "o", "> \r\n\u001b[?2004l\rk\u001b[?2004h> \r\n\u001b[?2004l\r.\u001b[?2004h"]
[115.483712, "o", "> "]
[115.483807, "o", "def test_gateway_error_surfaces(store, settings, partner, client):\r\n\u001b[?2004l\r"]
[115.483835, "o", "\u001b[?2004h> "]
[115.483912, "o", "    error = GatewayError(\"gateway rejected document\")\r\n\u001b[?2004l\r"]
[115.48394, "o", "\u001b[?2004h> "]
[115.483986, "o", "    client.push.side_effect = error\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.484015, "o", "> "]
[115.484079, "o", "    with pytest.raises(GatewayError) as exc:\r\n\u001b[?2004l\r"]
[115.484113, "o", "\u001b[?2004h> "]
[115.48422, "o", "        push_partner_feed(store, settings, partner, \"2025-10\", client)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.484282, "o", "    assert exc.value is error\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[115.484315, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r.\u001b[?2004h> "]
[115.484431, "o", "def test_gateway_rejection_status(store, settings, partner, client):\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.484463, "o", "> "]
[115.484568, "o", "    client.push.return_value = GatewayResponse(422, {\"error\": \"invalid\"})\r\n\u001b[?2004l\r"]
[115.484597, "o", "\u001b[?2004h> "]
[115.484668, "o", "    with pytest.raises(GatewayError, match=\"422\"):\r\n\u001b[?2004l\r"]
[115.484697, "o", "\u001b[?2004h> "]
[115.484775, "o", "        push_partner_feed(store, settings, partner, \"2025-10\", client)\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.484805, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[115.484833, "o", "> "]
[115.484909, "o", "def test_gateway_receipt_only_response(store, settings, partner, client):\r\n\u001b[?2004l\r"]
[115.484939, "o", "\u001b[?2004h> "]
[115.485034, "o", "    client.push.return_value = GatewayResponse(202, {\"receipt_id\": \"rc_receipt_only\"})\r\n\u001b[?2004l\r"]
[115.485068, "o", "\u001b[?2004h> "]
[115.485148, "o", "    result = push_partner_feed(store, settings, partner, \"2025-10\", client)\r\n\u001b[?2004l\r"]
[115.48518, "o", "\u001b[?2004h> "]
[115.485218, "o", "    assert result.accepted == result.merchants\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.485245, "o", "> "]
[115.485284, "o", "    assert result.receipt_id == \"rc_receipt_only\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.48531, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.485337, "o", "@pytest.fixture()\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.485363, "o", "> "]
[115.485399, "o", "def cli_gateway(store, settings, monkeypatch):\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.485427, "o", "> "]
[115.485483, "o", "    monkeypatch.setattr(cli, \"load_settings\", lambda: settings)\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.485511, "o", "> "]
[115.485593, "o", "    push = Mock(return_value=GatewayResponse(202, {\"accepted\": 8, \"receipt_id\": \"rc_cli\"}))\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.48562, "o", "> "]
[115.485672, "o", "    monkeypatch.setattr(PartnerGatewayClient, \"push\", push)\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.485698, "o", ">     return push\r\n\u001b[?2004l\r"]
[115.485724, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[115.48575, "o", "> "]
[115.485787, "o", "def test_cli_feed_success(cli_gateway, capsys):\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.485813, "o", "> "]
[115.485903, "o", "    assert cli.main([\"partner-feed\", \"--partner\", \"tally_insights\", \"--period\", \"2025-10\"]) == 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.48593, "o", "> "]
[115.485956, "o", "    output = capsys.readouterr()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.486038, "o", "    assert \"tally_insights\" in output.out and \"2025-10\" in output.out\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.48607, "o", "> "]
[115.486115, "o", "    assert \"8/8\" in output.out and \"rc_cli\" in output.out\r\n\u001b[?2004l\r"]
[115.486142, "o", "\u001b[?2004h> "]
[115.486168, "o", "    assert output.err == \"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
