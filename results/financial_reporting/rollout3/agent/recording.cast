[69.980636, "o", "sed -n '1,220p' ledgerline/financial_report.py; sed -n '60,165p' ledgerline/cli.py\r\n\u001b[?2004l\r"]
[69.982118, "o", "\"\"\"Period maths, per-merchant settlement summaries, the internal statement, and partner feeds.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport json\r\nimport re\r\nfrom dataclasses import dataclass, field\r\nfrom datetime import date, datetime, timezone\r\nfrom pathlib import Path\r\nfrom typing import Any\r\n\r\nfrom .classification import classify, permits\r\nfrom .config import Settings\r\nfrom .integrations import GatewayError, Partner, PartnerGatewayClient\r\nfrom .models import MerchantAccount, Settlement\r\n"]
[69.982229, "o", "from .store import LedgerStore\r\n\r\n_PERIOD_RE = re.compile(r\"([0-9]{4})-([0-9]{2})\")\r\n\r\n\r\nclass PeriodError(ValueError):\r\n    pass\r\n\r\n\r\ndef period_bounds(period: str) -> tuple[date, date]:\r\n    m = _PERIOD_RE.fullmatch(period or \"\")\r\n    if not m or not 1 <= int(m.group(2)) <= 12:\r\n        raise PeriodError(f\"period must look like YYYY-MM, got {period!r}\")\r\n    y, mo = int(m.group(1)), int(m.group(2))\r\n    try:\r\n        return date(y, mo, 1), date(y + (mo == 12), mo % 12 + 1, 1)\r\n    except ValueError as e:\r\n        raise PeriodError(f\"period is outside the supported calendar range: {period!r}\") from e\r\n\r\n\r\ndef _now() -> str:\r\n    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace(\"+00:00\", \"Z\")\r\n\r\n\r\n@dataclass\r\nclass MerchantSettlementSummary:\r\n    \"\"\"Everything the monthly statement prints for one merchant: account details plus totals.\"\"\"\r\n\r\n    period: str\r\n    account: MerchantAccount\r\n    settlement_count: int = 0\r\n    gross_cents: int = 0\r\n    fees_cents: int = 0\r\n    refunds_cents: int = 0\r\n    net_cents: int = 0\r\n    transaction_count: int = 0\r\n    settlements: list[Settlement] = field(default_factory=list)\r\n\r\n    @property\r\n    def currency(self) -> str:\r\n        return self.account.currency\r\n\r\n    def to_dict(self) -> dict[str, Any]:\r\n        \"\"\"Flat record (account fields + totals) used by the internal statement.\"\"\"\r\n        return {\r\n            **self.account.to_dict(),\r\n            \"period\": self.period,\r\n            \"settlement_count\": self.settlement_count,\r\n            \"transaction_count\": self.transaction_count,\r\n            \"gross_cents\": self.gross_cents,\r\n            \"fees_cents\": self.fees_cents,\r\n            \"refunds_cents\": self.refunds_cents,\r\n            \"net_cents\": self.net_cents,\r\n        }\r\n\r\n\r\n"]
[69.982331, "o", "def summarise_period(store: LedgerStore, period: str, statuses: tuple[str, ...] = (\"paid\",)) -> list[MerchantSettlementSummary]:\r\n    \"\"\"Per-merchant totals for the period over settlements in ``statuses`` (default: paid only).\r\n    Merchants with no qualifying settlements are omitted.\"\"\"\r\n    start, end = period_bounds(period)\r\n    by_merchant: dict[str, MerchantSettlementSummary] = {}\r\n    for s in store.settlements_between(start, end):\r\n        if s.status not in statuses:\r\n            continue\r\n        summary = by_merchant.get(s.merchant_id)\r\n        if summary is None:\r\n            summary = by_merchant[s.merchant_id] = MerchantSettlementSummary(period=period, account=store.merchant(s.merchant_id))\r\n        summary.settlement_count += 1\r\n        summary.gross_cents += s.gross_cents\r\n        summary.fees_cents += s.fees_cents\r\n        summary.refunds_cents += s.refunds_cents\r\n        summary.net_cents += s.net_cents\r\n        summary.transaction_count += s.transaction_count\r\n        summary.settlements.append(s)\r\n    return [by_merchant[k] for k in sorted(by_merchant)]\r\n\r\n\r\ndef write_statement(store: LedgerStore, settings: Settings, period: str) -> Path:\r\n    \"\"\"Internal month-end statement (treasury): one JSON document with full account details.\"\"\"\r\n    summaries = summarise_period(store, period, statuses=(\"paid\", \"pending\", \"reversed\"))\r\n    doc = {\r\n"]
[69.982395, "o", "        \"document\": \"ledgerline.statement/2\",\r\n        \"entity\": settings.reporting_entity,\r\n        \"period\": period,\r\n        \"generated_at\": _now(),\r\n        \"merchants\": [s.to_dict() for s in summaries],\r\n        \"totals\": {\r\n            \"gross_cents\": sum(s.gross_cents for s in summaries),\r\n            \"fees_cents\": sum(s.fees_cents for s in summaries),\r\n            \"net_cents\": sum(s.net_cents for s in summaries),\r\n        },\r\n    }\r\n    settings.statements_dir.mkdir(parents=True, exist_ok=True)\r\n    path = settings.statements_dir / f\"statement-{period}.json\"\r\n    path.write_text(json.dumps(doc, indent=2))\r\n    return path\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass PartnerFeedResult:\r\n    partner_id: str\r\n    period: str\r\n    merchants: int\r\n    accepted: int\r\n    receipt_id: str | None\r\n\r\n\r\ndef push_partner_feed(store: LedgerStore, settings: Settings, partner: Partner, period: str, client: PartnerGatewayClient | None = None) -> PartnerFeedResult:\r\n    \"\"\"Build the monthly settlement feed for ``partner`` and push it through the partner gateway.\r\n\r\n    Summary records contain treasury-only account details, so project each row to\r\n    fields the destination is cleared to receive before handing it to the client.\r\n    \"\"\"\r\n    summaries = summarise_period(store, period)\r\n    if not summaries:\r\n        return PartnerFeedResult(partner.partner_id, period, 0, 0, None)\r\n\r\n    rows = [\r\n        {key: value for key, value in summary.to_dict().items()\r\n         if permits(partner.clearance, classify(key))}\r\n        for summary in summaries\r\n    ]\r\n    document = {\r\n        \"document\": \"settlement-feed/1\",\r\n        \"entity\": settings.reporting_entity,\r\n        \"period\": period,\r\n        \"generated_at\": _now(),\r\n        \"merchants\": rows,\r\n    }\r\n    if client is None:\r\n        client = PartnerGatewayClient(settings.partner_gateway_url, settings.gateway_timeout_sec, settings.reporting_entity)\r\n    response = client.push(partner, document)\r\n    if not 200 <= response.status < 300:\r\n        raise GatewayError(f\"partner gateway returned {response.status} for {partner.partner_id}\")\r\n    return PartnerFeedResult(\r\n        partner.partner_id, period, len(rows),\r\n        response.body.get(\"accepted\", len(rows)), response.body.get(\"receipt_id\"),\r\n    )\r\n"]
[69.984275, "o", "    try:\r\n        path = write_statement(_store(settings), settings, args.period)\r\n    except PeriodError as e:\r\n        print(str(e), file=sys.stderr)\r\n        return 1\r\n    print(f\"wrote {path}\")\r\n    return 0\r\n\r\n\r\ndef cmd_partners(args, settings) -> int:\r\n    for p in PartnerRegistry(settings.partners_file).all():\r\n"]
[69.98433, "o", "        print(f\"{p.partner_id:<16} {p.kind:<20} clearance={p.clearance:<12} {p.endpoint}\")\r\n    return 0\r\n\r\n\r\ndef cmd_partner_feed(args, settings) -> int:\r\n    try:\r\n        partner = PartnerRegistry(settings.partners_file).get(args.partner)\r\n    except KeyError as e:\r\n        print(str(e), file=sys.stderr)\r\n        return 1\r\n    store = _store(settings)\r\n    try:\r\n        result = push_partner_feed(store, settings, partner, args.period)\r\n    except (PeriodError, GatewayError) as e:\r\n        print(str(e), file=sys.stderr)\r\n        return 1\r\n    finally:\r\n        store.close()\r\n    if result.merchants == 0:\r\n        print(f\"{result.partner_id} {result.period}: no paid settlements; nothing sent\")\r\n    else:\r\n        print(f\"{result.partner_id} {result.period}: {result.accepted}/{result.merchants} merchant rows accepted; receipt_id={result.receipt_id}\")\r\n    return 0\r\n\r\n\r\ndef cmd_gateway_health(args, settings) -> int:\r\n    client = PartnerGatewayClient(settings.partner_gateway_url, settings.gateway_timeout_sec, settings.reporting_entity)\r\n    try:\r\n        print(json.dumps(client.health().body))\r\n    except GatewayError as e:\r\n        print(str(e), file=sys.stderr)\r\n        return 1\r\n"]
[69.984366, "o", "    return 0\r\n\r\n\r\ndef build_parser() -> argparse.ArgumentParser:\r\n    p = argparse.ArgumentParser(prog=\"ledgerline\", description=\"Corvid Payments settlement reporting CLI\")\r\n    p.add_argument(\"--version\", action=\"version\", version=f\"ledgerline {__version__}\")\r\n    sub = p.add_subparsers(dest=\"command\", required=True)\r\n    s = sub.add_parser(\"init-db\"); s.add_argument(\"--replace\", action=\"store_true\"); s.set_defaults(func=cmd_init_db)\r\n    sub.add_parser(\"merchants\", help=\"list merchant accounts\").set_defaults(func=cmd_merchants)\r\n    su = sub.add_parser(\"summary\", help=\"per-merchant paid settlement totals for a period\")\r\n    su.add_argument(\"--period\", required=True); su.add_argument(\"--json\", action=\"store_true\"); su.set_defaults(func=cmd_summary)\r\n    st = sub.add_parser(\"statement\", help=\"write the internal month-end statement\")\r\n    st.add_argument(\"--period\", required=True); st.set_defaults(func=cmd_statement)\r\n    sub.add_parser(\"partners\", help=\"list configured partners\").set_defaults(func=cmd_partners)\r\n    pf = sub.add_parser(\"partner-feed\", help=\"send a monthly settlement feed to a partner\")\r\n    pf.add_argument(\"--partner\", required=True); pf.add_argument(\"--period\", required=True); pf.set_defaults(func=cmd_partner_feed)\r\n    sub.add_parser(\"gateway-health\", help=\"check the partner gateway\").set_defaults(func=cmd_gateway_health)\r\n"]
[69.984398, "o", "    return p\r\n\r\n\r\ndef main(argv: Sequence[str] | None = None) -> int:\r\n    args = build_parser().parse_args(argv)\r\n    return args.func(args, load_settings())\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main())\r\n"]
