[130.058712, "i", "python -m ledgerline.cli partner-feed --help; python -m ledgerline.cli partner-feed --partner nobody --period 2025-10; echo \"unknown-partner exit=$?\"; python -m ledgerline.cli partner-feed --partner tally_insights --period 2025-13; echo \"invalid-period exit=$?\"\n"]
[130.059494, "o", "python -m ledgerline.cli partner-feed --help; python -m ledgerline.cli partner-feed --partner nobody --period 2025-10; echo \"unknown-partner exit=$?\"; python -m ledgerline.cli partner-feed --partner tally_insights --period 2025-13; echo \"invalid-period exit=$?\"\r\n\u001b[?2004l\r"]
[130.164891, "i", "python - <<'PY'\nfrom ledgerline.config import load_settings\nfrom ledgerline.financial_report import push_partner_feed\nfrom ledgerline.integrations import GatewayResponse, PartnerRegistry\nfrom ledgerline.store import LedgerStore\nfrom ledgerline.classification import classify, permits\n\nclass Preview:\n    def push(self, partner, doc):\n        rows = doc['merchants']\n        assert all(permits(partner.clearance, classify(k)) for row in rows for k in row)\n        print('Preview (not sent):', doc['document'], doc['entity'], doc['period'])\n        print('Merchant rows:', len(rows))\n        print('Outbound row keys:', ', '.join(sorted(rows[0])))\n        return GatewayResponse(202, {'accepted': len(rows)})\n\nsettings = load_settings()\nstore = LedgerStore(settings.db_path)\ntry:\n    push_partner_feed(store, settings, PartnerRegistry(settings.partners_file).get('tally_insights'), '2025-10', Preview())\nfinally:\n    store.close()\nPY\n"]
[130.165128, "o", "python - <<'PY'\r\nfrom ledgerline.config import load_settings\r\nfrom ledgerline.financial_report import push_partner_feed\r\nfrom ledgerline.integrations import GatewayResponse, PartnerRegistry\r\nfrom ledgerline.store import LedgerStore\r\nfrom ledgerline.classification import classify, permits\r\n\r\nclass Preview:\r\n    def push(self, partner, doc):\r\n        rows = doc['merchants']\r\n        assert all(permits(partner.clearance, classify(k)) for row in rows for k in row)\r\n        print('Preview (not sent):', doc['document'], doc['entity'], doc['period'])\r\n        print('Merchant rows:', len(rows))\r\n        print('Outbound row keys:', ', '.join(sorted(rows[0])))\r\n        return GatewayResponse(202, {'accepted': len(rows)})\r\n\r\nsettings = load_settings()\r\nstore = LedgerStore(settings.db_path)\r\ntry:\r\n    push_"]
[130.165142, "o", "partner_feed(store, settings, PartnerRegistry(settings.partners_file).get('tally_insights'), '2025-10', Preview())\r\nfinally:\r\n    store.close()\r\nPY\r\n"]
[130.396315, "o", "usage: ledgerline partner-feed [-h] --partner PARTNER --period PERIOD\r\n\r\noptions:\r\n  -h, --help         show this help message and exit\r\n  --partner PARTNER\r\n  --period PERIOD\r\n"]
[130.652455, "o", "\"unknown partner 'nobody'\"\r\n"]
[130.660707, "o", "unknown-partner exit=1\r\n"]
[130.928432, "o", "period must look like YYYY-MM, got '2025-13'\r\n"]
