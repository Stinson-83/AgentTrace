[130.939903, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.939965, "o", "class Preview:\r\n\u001b[?2004l\r"]
[130.939988, "o", "\u001b[?2004h"]
[130.940009, "o", "> "]
