[108.776643, "o", "\u001b[?2004h> "]
[108.777232, "o", "    expected = [{k: s.to_dict()[k] for k in fields} for s in summarise_period(store, '2025-10') if s.account.enrolled_in('benchmarking')]\r\n\u001b[?2004l\r"]
[108.777312, "o", "\u001b[?2004h> "]
