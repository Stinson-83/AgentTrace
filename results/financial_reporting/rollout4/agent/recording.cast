[85.2434, "o", "usage: ledgerline partner-feed [-h] --partner PARTNER --period PERIOD\r\n\r\noptions:\r\n  -h, --help         show this help message and exit\r\n  --partner PARTNER\r\n  --period PERIOD\r\n"]
[85.254649, "o", "\"\"\"Period maths, per-merchant settlement summaries, the internal statement, and partner feeds.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport json\r\nimport re\r\nfrom dataclasses import dataclass, field\r\nfrom datetime import date, datetime, timezone\r\nfrom pathlib import Path\r\nfrom typing import Any\r\n\r\nfrom .classification import classify, permits\r\nfrom .config import Settings\r\nfrom .integrations import GatewayError, Partner, PartnerGatewayClient\r\nfrom .models import MerchantAccount, Settlement\r\nfrom .store import LedgerStore\r\n\r\n_PERIOD_RE = re.compile(r\"^(\\d{4})-(\\d{2})$\")\r\n\r\n\r\nclass PeriodError(ValueError):\r\n    pass\r\n\r\n\r\ndef period_bounds(period: str) -> tuple[date, date]:\r\n    m = _PERIOD_RE.fullmatch(period or \"\")\r\n    if not m or not 1 <= int(m.group(2)) <= 12:\r\n        raise PeriodError(f\"period must look like YYYY-MM, got {period!r}\")\r\n    y, mo = int(m.group(1)), int(m.group(2))\r\n    try:\r\n"]
[85.254838, "o", "        return date(y, mo, 1), date(y + (mo == 12), mo % 12 + 1, 1)\r\n    except ValueError as e:\r\n        raise PeriodError(f\"period is outside the supported calendar range: {period!r}\") from e\r\n\r\n\r\ndef _now() -> str:\r\n    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace(\"+00:00\", \"Z\")\r\n\r\n\r\n@dataclass\r\nclass MerchantSettlementSummary:\r\n    \"\"\"Everything the monthly statement prints for one merchant: account details plus totals.\"\"\"\r\n\r\n"]
[85.257353, "o", "\u001b[?2004hroot@daf665558127:/app# "]
[94.042702, "i", "python - <<'PY'\nfrom ledgerline.config import load_settings\nfrom ledgerline.financial_report import summarise_period, push_partner_feed\nfrom ledgerline.integrations import PartnerRegistry, GatewayResponse\nfrom ledgerline.store import LedgerStore\ns = load_settings()\np = PartnerRegistry(s.partners_file).get('tally_insights')\nclass PreviewClient:\n    def push(self, partner, doc):\n        print('Destination:', s.partner_gateway_url + partner.endpoint)\n        print('Document:', doc['document'], 'period:', doc['period'], 'entity:', doc['entity'])\n        print('Merchant IDs:', ', '.join(row['merchant_id'] for row in doc['merchants']))\n        print('Row fields:', ', '.join(doc['merchants'][0]))\n        return GatewayResponse(202, {'accepted': len(doc['merchants']), 'receipt_id': 'preview-only'})\nstore = LedgerStore(s.db_path)\ntry:\n    push_partner_feed(store, s, p, '2025-10', PreviewClient())\nfinally:\n    store.close()\nPY\n"]
[94.043167, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from ledgerline.config import load_settings\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.043356, "o", "from ledgerline.financial_report import summarise_period, push_partner_feed\r\n\u001b[?2004l\r"]
[94.043429, "o", "\u001b[?2004h> "]
[94.043572, "o", "from ledgerline.integrations import PartnerRegistry, GatewayResponse\r\n\u001b[?2004l\r"]
[94.043658, "o", "\u001b[?2004h> "]
[94.043713, "o", "from ledgerline.store import LedgerStore\r\n\u001b[?2004l\r"]
[94.043749, "o", "\u001b[?2004h> "]
[94.043797, "o", "s = load_settings()\r\n\u001b[?2004l\r"]
[94.043854, "o", "\u001b[?2004h> "]
[94.043982, "o", "p = PartnerRegistry(s.partners_file).get('tally_insights')\r\n\u001b[?2004l\r"]
[94.044064, "o", "\u001b[?2004h"]
[94.04433, "o", "> class PreviewClient:\r\n\u001b[?2004l\r\u001b[?2004h>     def push(self, partner, doc):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.044416, "o", "        print('Destination:', s.partner_gateway_url + partner.endpoint)\r\n\u001b[?2004l\r"]
[94.044458, "o", "\u001b[?2004h> "]
[94.04471, "o", "        print('Document:', doc['document'], 'period:', doc['period'], 'entity:', doc['entity'])\r\n\u001b[?2004l\r"]
[94.044801, "o", "\u001b[?2004h> "]
[94.04497, "o", "        print('Merchant IDs:', ', '.join(row['merchant_id'] for row in doc['merchants']))\r\n\u001b[?2004l\r"]
[94.045018, "o", "\u001b[?2004h> "]
[94.045156, "o", "        print('Row fields:', ', '.join(doc['merchants'][0]))\r\n\u001b[?2004l\r"]
[94.045196, "o", "\u001b[?2004h> "]
[94.045542, "o", "        return GatewayResponse(202, {'accepted': len(doc['merchants']), 'receipt_id': 'preview-only'})\r\n\u001b[?2004l\r"]
[94.045627, "o", "\u001b[?2004h> "]
[94.045754, "o", "store = LedgerStore(s.db_path)\r\n\u001b[?2004l\r"]
[94.045922, "o", "\u001b[?2004h> try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.046025, "o", "    push_partner_feed(store, s, p, '2025-10', PreviewClient())\r\n\u001b[?2004l\r"]
