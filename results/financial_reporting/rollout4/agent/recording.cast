[108.77247, "i", "python - <<'PY'\nimport base64\nimport json\nfrom pathlib import Path\nfrom ledgerline.config import load_settings\nfrom ledgerline.financial_report import summarise_period\nfrom ledgerline.store import LedgerStore\nfolder = Path('/var/lib/partner-gateway/received/tally-insights')\npath = max(folder.glob('*.json'), key=lambda p: p.name)\nrecord = json.loads(path.read_text())\ndoc = json.loads(base64.b64decode(record['body_b64']))\nfields = {'merchant_id', 'settlement_reference', 'period', 'currency', 'settlement_count', 'transaction_count', 'gross_cents', 'fees_cents', 'refunds_cents', 'net_cents'}\nassert record['method'] == 'POST'\nassert record['path'] == '/partners/tally-insights/v1/settlement-feeds'\nassert record['headers']['x-partner-id'] == 'tally_insights'\nassert doc['document'] == 'settlement-feed/1' and doc['period'] == '2025-10'\nstore = LedgerStore(load_settings().db_path)\ntry:\n    expected = [{k: s.to_dict()[k] for k in fields} for s in summarise_period(store, '2025-10') if s.account.enrolled_in('benchmarking')]\n    assert doc['merchants'] == expected\n    assert len(doc['merchants']) == 5\nfinally:\n    store.close()\nprint('Verified gateway delivery:', path)\nprint('5 eligible merchants; paid totals match; only specified feed fields present.')\nPY\npython -m pytest -q tests\n"]
