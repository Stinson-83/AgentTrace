eriod,\r\n\u001b[?2004l\r\u001b[?2004h>         \"generated_at\": _now(),\r\n\u001b[?2004l\r\u001b[?2004h>         \"merchants\": rows,\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     if client is None:\r\n\u001b[?2004l\r\u001b[?2004h>         client = PartnerGatewayClient(settings.partner_gateway_url, settings.gateway_timeout_sec, settings.reporting_entity)\r\n\u001b[?2004l\r\u001b[?2004h>     response = client.push(partner, document)\r\n\u001b[?2004l\r\u001b[?2004h>     if response.status != 202:\r\n\u001b[?2004l\r\u001b[?2004h>         raise GatewayError(f\"partner gateway returned {response.status} for {partner.partner_id}\")\r\n\u001b[?2004l\r"]
