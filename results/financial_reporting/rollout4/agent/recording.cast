[78.005467, "o", "> "]
[78.005547, "o", "def test_insufficient_clearance_never_pushes(store, settings, partner, client):\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.005578, "o", "> "]
[78.005633, "o", "    with pytest.raises(GatewayError, match=\"clearance\"):\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.005665, "o", "> "]
[78.005773, "o", "        push_partner_feed(store, settings, replace(partner, clearance=\"public\"), \"2025-10\", client)\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.005807, "o", "> "]
[78.005841, "o", "    client.push.assert_not_called()\r\n\u001b[?2004l\r"]
[78.005872, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[78.005902, "o", "\u001b[?2004h> "]
[78.006012, "o", "def test_gateway_response_counts_and_default_client(store, settings, partner, monkeypatch, client):\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.006046, "o", "> "]
[78.00608, "o", "    factory = Mock(return_value=client)\r\n\u001b[?2004l\r"]
[78.006111, "o", "\u001b[?2004h> "]
[78.006207, "o", "    monkeypatch.setattr(\"ledgerline.financial_report.PartnerGatewayClient\", factory)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.006332, "o", "    client.push.return_value = GatewayResponse(202, {\"accepted\": 3, \"receipt_id\": \"rc_partial\"})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.006421, "o", "    result = push_partner_feed(store, settings, partner, \"2025-10\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.006453, "o", "> "]
[78.00658, "o", "    factory.assert_called_once_with(settings.partner_gateway_url, settings.gateway_timeout_sec, settings.reporting_entity)\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.006612, "o", "> "]
[78.006708, "o", "    assert (result.merchants, result.accepted, result.receipt_id) == (5, 3, \"rc_partial\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.006741, "o", "> "]
[78.006812, "o", "    # The documented minimal 202 response need only contain the receipt.\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.006844, "o", "> "]
[78.006927, "o", "    client.push.return_value = GatewayResponse(202, {\"receipt_id\": \"rc_minimal\"})\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.006958, "o", "> "]
[78.007049, "o", "    assert push_partner_feed(store, settings, partner, \"2025-10\", client).accepted == 5\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.007079, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[78.007111, "o", "> "]
[78.007174, "o", "@pytest.mark.parametrize(\"error\", [\"rejected\", \"unreachable\"])\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.007209, "o", "> "]
[78.007282, "o", "def test_gateway_error_propagates(store, settings, partner, client, error):\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.007314, "o", "> "]
[78.007344, "o", "    failure = GatewayError(error)\r\n\u001b[?2004l\r"]
[78.007376, "o", "\u001b[?2004h> "]
[78.007415, "o", "    client.push.side_effect = failure\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.007446, "o", "> "]
[78.00749, "o", "    with pytest.raises(GatewayError) as exc:\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.007522, "o", "> "]
[78.007593, "o", "        push_partner_feed(store, settings, partner, \"2025-10\", client)\r\n\u001b[?2004l\r"]
[78.007627, "o", "\u001b[?2004h> "]
[78.007661, "o", "    assert exc.value is failure\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[78.007695, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[78.007733, "o", "> "]
