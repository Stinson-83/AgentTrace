[78.008583, "o", "def test_http_client_failure_is_gateway_error(settings, partner, monkeypatch, error):\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.008613, "o", "> "]
[78.008691, "o", "    monkeypatch.setattr(\"urllib.request.urlopen\", Mock(side_effect=error))\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.008726, "o", "> "]
[78.008786, "o", "    client = PartnerGatewayClient(settings.partner_gateway_url)\r\n\u001b[?2004l\r"]
[78.008818, "o", "\u001b[?2004h> "]
[78.008855, "o", "    with pytest.raises(GatewayError):\r\n\u001b[?2004l\r"]
[78.008886, "o", "\u001b[?2004h> "]
[78.008981, "o", "        client.push(partner, {\"period\": \"2025-10\", \"merchants\": [{\"merchant_id\": \"test\"}]})\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.00901, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[78.009039, "o", "> "]
[78.009129, "o", "@pytest.mark.parametrize(\"case\", [\"success\", \"empty\", \"unknown\", \"invalid\", \"gateway\"])\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.009159, "o", "> "]
[78.009238, "o", "def test_cli_outcomes(store, settings, client, monkeypatch, capsys, case):\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.009268, "o", "> "]
[78.009332, "o", "    monkeypatch.setattr(cli, \"load_settings\", lambda: settings)\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.009362, "o", "> "]
[78.009469, "o", "    monkeypatch.setattr(\"ledgerline.financial_report.PartnerGatewayClient\", Mock(return_value=client))\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.0095, "o", "> "]
[78.009569, "o", "    partner_id = \"nobody\" if case == \"unknown\" else \"tally_insights\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.009603, "o", "> "]
[78.009682, "o", "    period = {\"empty\": \"2024-01\", \"invalid\": \"2025-13\"}.get(case, \"2025-10\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.009715, "o", "> "]
[78.009745, "o", "    if case == \"gateway\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.009831, "o", "        client.push.side_effect = GatewayError(\"gateway unavailable\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.009861, "o", "> "]
[78.009948, "o", "    status = cli.main([\"partner-feed\", \"--partner\", partner_id, \"--period\", period])\r\n\u001b[?2004l\r"]
[78.009979, "o", "\u001b[?2004h> "]
[78.01001, "o", "    out, err = capsys.readouterr()\r\n\u001b[?2004l\r"]
[78.01004, "o", "\u001b[?2004h> "]
[78.010078, "o", "    if case in {\"success\", \"empty\"}:\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.010109, "o", "> "]
[78.010145, "o", "        assert status == 0 and not err\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.010175, "o", "> "]
[78.010253, "o", "        assert f\"partner={partner_id}\" in out and f\"period={period}\" in out\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.010283, "o", "> "]
[78.010312, "o", "        if case == \"success\":\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.010341, "o", "> "]
[78.010411, "o", "            assert \"merchants=5 accepted=5 receipt_id=rc_test\" in out\r\n\u001b[?2004l\r"]
[78.010444, "o", "\u001b[?2004h> "]
[78.010473, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.010552, "o", "            assert \"merchants=0 accepted=0 receipt_id=-\" in out\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.010591, "o", ">     else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.010652, "o", "        assert status != 0 and err and not out\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.010681, "o", "> "]
[78.010748, "o", "    if case in {\"empty\", \"unknown\", \"invalid\"}:\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.010778, "o", "> "]
[78.010816, "o", "        client.push.assert_not_called()\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.010844, "o", "> PY\r\n\u001b[?2004l\r"]
