[108.773511, "o", "from ledgerline.store import LedgerStore\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.773667, "o", "folder = Path('/var/lib/partner-gateway/received/tally-insights')\r\n\u001b[?2004l\r"]
[108.773803, "o", "\u001b[?2004h> "]
[108.77391, "o", "path = max(folder.glob('*.json'), key=lambda p: p.name)\r\n\u001b[?2004l\r\u001b[?2004h"]
[108.774062, "o", "> record = json.loads(path.read_text())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.774263, "o", "doc = json.loads(base64.b64decode(record['body_b64']))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.775008, "o", "fields = {'merchant_id', 'settlement_reference', 'period', 'currency', 'settlement_count', 'transaction_count', 'gross_cents', 'fees_cents', 'refunds_cents', 'net_cents'}\r\n\u001b[?2004l\r"]
[108.775171, "o", "\u001b[?2004h> "]
[108.775305, "o", "assert record['method'] == 'POST'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.7756, "o", "assert record['path'] == '/partners/tally-insights/v1/settlement-feeds'\r\n\u001b[?2004l\r"]
[108.775755, "o", "\u001b[?2004h> "]
[108.775931, "o", "assert record['headers']['x-partner-id'] == 'tally_insights'\r\n\u001b[?2004l\r"]
[108.776055, "o", "\u001b[?2004h> "]
[108.776275, "o", "assert doc['document'] == 'settlement-feed/1' and doc['period'] == '2025-10'\r\n\u001b[?2004l\r"]
[108.776414, "o", "\u001b[?2004h"]
