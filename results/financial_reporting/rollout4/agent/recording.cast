[78.007817, "o", "> "]
[78.007908, "o", "    client.push.return_value = GatewayResponse(422, {\"error\": \"rejected\"})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.007979, "o", "    with pytest.raises(GatewayError, match=\"422\"):\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.008011, "o", "> "]
[78.00808, "o", "        push_partner_feed(store, settings, partner, \"2025-10\", client)\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.008109, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[78.00814, "o", "\u001b[?2004h> "]
