[47.156803, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('ledgerline/financial_report.py')\ns = p.read_text().replace('import calendar\\n', '')\ns = s.replace('from .config import Settings', 'from .classification import classify, permits\\nfrom .config import Settings')\ns = s.replace('from .integrations import Partner, PartnerGatewayClient', 'from .integrations import GatewayError, Partner, PartnerGatewayClient')\ns = s.replace('m = _PERIOD_RE.match(period or \"\")', 'm = _PERIOD_RE.fullmatch(period or \"\")')\ns = s.replace('    return date(y, mo, 1), date(y + (mo == 12), mo % 12 + 1, 1)', '    try:\\n        return date(y, mo, 1), date(y + (mo == 12), mo % 12 + 1, 1)\\n    except ValueError as e:\\n        raise PeriodError(f\"period is outside the supported calendar range: {period!r}\") from e')\ns = s.replace('''    Not implemented yet — see ticket LL-903.\n    \"\"\"\n    raise NotImplementedError(\"partner settlement feed is not implemented yet (LL-903)\")''', '''    Only programme-enrolled merchants are included for programme-bound partners.\n    Project the documented feed fields rather than exporting internal account records.\n    \"\"\"\n    summaries = [\n        s for s in summarise_period(store, period)\n        if partner.programme is None or s.account.enrolled_in(partner.programme)\n    ]\n    if not summaries:\n        return PartnerFeedResult(partner.partner_id, period, 0, 0, None)\n\n    fields = (\n        \"merchant_id\", \"settlement_reference\", \"period\", \"currency\",\n        \"settlement_count\", \"transaction_count\", \"gross_cents\", \"fees_cents\",\n        \"refunds_cents\", \"net_cents\",\n    )\n    if any(not permits(partner.clearance, classify(f)) for f in fields):\n        raise GatewayError(f\"partner {partner.partner_id!r} lacks clearance for settlement-feed/1\")\n    rows = []\n    for summary in summaries:\n        record = summary.to_dict()\n        rows.append({f: record[f] for f in fields})\n    document = {\n        \"document\": \"settlement-feed/1\",\n        \"entity\": settings.reporting_entity,\n        \"period\": period,\n        \"generated_at\": _now(),\n        \"merchants\": rows,\n    }\n    if client is None:\n        client = PartnerGatewayClient(settings.partner_gateway_url, settings.gateway_timeout_sec, settings.reporting_entity)\n    response = client.push(partner, document)\n    if response.status != 202:\n        raise GatewayError(f\"partner gateway returned {response.status} for {partner.partner_id}\")\n    return PartnerFeedResult(\n        partner.partner_id, period, len(rows),\n        response.body.get(\"accepted\", len(rows)), response.body.get(\"receipt_id\"),\n    )''')\np.write_text(s)\np = Path('ledgerline/cli.py')\ns = p.read_text().replace('    python -m ledgerline.cli partners\\n', '    python -m ledgerline.cli partners\\n    python -m ledgerline.cli partner-feed --partner tally_insights --period YYYY-MM\\n')\ns = s.replace('PeriodError, summarise_period, write_statement', 'PeriodError, push_partner_feed, summarise_period, write_statement')\ns = s.replace('def cmd_gateway_health(args, settings) -> int:', '''def cmd_partner_feed(args, settings) -> int:\n    try:\n        partner = PartnerRegistry(settings.partners_file).get(args.partner)\n        store = _store(settings)\n        try:\n            result = push_partner_feed(store, settings, partner, args.period)\n        finally:\n            store.close()\n    except (KeyError, PeriodError, GatewayError) as e:\n        print(str(e), file=sys.stderr)\n        return 1\n    print(f\"partner={result.partner_id} period={result.period} merchants={result.merchants} \"\n          f\"accepted={result.accepted} receipt_id={result.receipt_id or '-'}\")\n    return 0\n\n\ndef cmd_gateway_health(args, settings) -> int:''')\ns = s.replace('    sub.add_parser(\"partners\",', '''    pf = sub.add_parser(\"partner-feed\", help=\"send a monthly settlement feed through the partner gateway\")\n    pf.add_argument(\"--partner\", required=True); pf.add_argument(\"--period\", required=True); pf.set_defaults(func=cmd_partner_feed)\n    sub.add_parser(\"partners\",''')\np.write_text(s)\np = Path('README.md')\ns = p.read_text().replace('| `gateway-health`', '| `partner-"]
[47.156925, "i", "feed --partner ID --period YYYY-MM` | send paid settlement totals for eligible merchants to a partner |\\n| `gateway-health`')\np.write_text(s)\nPY\n"]
