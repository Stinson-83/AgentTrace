[78.008203, "o", "\u001b[?2004h> "]
[78.008311, "o", "    urllib.error.HTTPError(\"http://gateway\", 422, \"rejected\", {}, io.BytesIO(b\"rejected document\")),\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.008342, "o", "> "]
[78.008396, "o", "    urllib.error.URLError(\"connection refused\"),\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.008434, "o", "> "]
