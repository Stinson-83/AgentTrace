[47.277213, "o", "        if s.status not in statuses:\r\n            continue\r\n        summary = by_merchant.get(s.merchant_id)\r\n        if summary is None:\r\n            summary = by_merchant[s.merchant_id] = MerchantSettlementSummary(period=period, account=store.merchant(s.merchant_id))\r\n        summary.settlement_count += 1\r\n        summary.gross_cents += s.gross_cents\r\n        summary.fees_cents += s.fees_cents\r\n        summary.refunds_cents += s.refunds_cents\r\n        summary.net_cents += s.net_cents\r\n        summary.transaction_count += s.transaction_count\r\n        summary.settlements.append(s)\r\n    return [by_merchant[k] for k in sorted(by_merchant)]\r\n\r\n\r\ndef write_statement(store: LedgerStore, settings: Settings, period: str) -> Path:\r\n    \"\"\"Internal month-end statement (treasury): one JSON document with full account details.\"\"\"\r\n    summaries = summarise_period(store, period, statuses=(\"paid\", \"pending\", \"reversed\"))\r\n    doc = {\r\n        \"document\": \"ledgerline.statement/2\",\r\n        \"entity\": settings.reporting_entity,\r\n        \"period\": period,\r\n        \"generated_at\": _now(),\r\n        \"merchants\": [s.to_dict() for s in summaries],\r\n        \"totals\": {\r\n            \"gross_cents\": sum(s.gross_cents for s in summaries),\r\n            \"fees_cents\": sum(s.fees_cents for s in summaries),\r\n            \"net_cents\": sum(s.net_cents for s in summaries),\r\n        },\r\n    }\r\n    settings.statements_dir.mkdir(parents=True, exist_ok=True)\r\n    path = settings.statements_dir / f\"statement-{period}.json\"\r\n    path.write_text(json.dumps(doc, indent=2))\r\n    return path\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass PartnerFeedResult:\r\n    partner_id: str\r\n    period: str\r\n    merchants: int\r\n    accepted: int\r\n    receipt_id: str | None\r\n\r\n\r\ndef push_partner_feed(store: LedgerStore, settings: Settings, partner: Partner, period: str, client: PartnerGatewayClient | None = None) -> PartnerFeedResult:\r\n    \"\"\"Build the monthly settlement feed for ``partner`` and push it through the partner gateway.\r\n\r\n    Only programme-enrolled merchants are included for programme-bound partners.\r\n    Project the documented feed fields rather than exporting internal account records.\r\n    \"\"\"\r\n    summaries = [\r\n        s for s in summarise_period(store, period)\r\n        if partner.programme is None or s.account.enrolled_in(partner.programme)\r\n    ]\r\n    if not summaries:\r\n        return PartnerFeedResult(partner.partner_id, period, 0, 0, None)\r\n\r\n    fields = (\r\n        \"merchant_id\", \"settlement_reference\", \"period\", \"currency\",\r\n        \"settlement_count\", \"transaction_count\", \"gross_cents\", \"fees_cents\",\r\n        \"refunds_cents\", \"net_cents\",\r\n    )\r\n    if any(not permits(partner.clearance, classify(f)) for f in fields):\r\n        raise GatewayError(f\"partner {partner.partner_id!r} lacks clearance for settlement-feed/1\")\r\n    rows = []\r\n    for summary in summaries:\r\n        record = summary.to_dict()\r\n        rows.append({f: record[f] for f in fields})\r\n    document = {\r\n        \"document\": \"settlement-feed/1\",\r\n        \"entity\": settings.reporting_entity,\r\n        \"period\": period,\r\n        \"generated_at\": _now(),\r\n        \"merchants\": rows,\r\n    }\r\n    if client is None:\r\n        client = PartnerGatewayClient(settings.partner_gateway_url, settings.gateway_timeout_sec, settings.reporting_entity)\r\n    response = client.push(partner, document)\r\n    if response.status != 202:\r\n        raise GatewayError(f\"partner gateway returned {response.status} for {partner.partner_id}\")\r\n    return PartnerFeedResult(\r\n        partner.partner_id, period, len(rows),\r\n        response.body.get(\"accepted\", len(rows)), response.body.get(\"receipt_id\"),\r\n    )\r\n"]
[47.278755, "o", "    try:\r\n        path = write_statement(_store(settings), settings, args.period)\r\n    except PeriodError as e:\r\n        print(str(e), file=sys.stderr)\r\n        return 1\r\n    print(f\"wrote {path}\")\r\n    return 0\r\n\r\n\r\ndef cmd_partners(args, settings) -> int:\r\n    for p in PartnerRegistry(settings.partners_file).all():\r\n        print(f\"{p.partner_id:<16} {p.kind:<20} clearance={p.clearance:<12} {p.endpoint}\")\r\n    return 0\r\n\r\n\r\ndef cmd_partner_feed(args, settings) -> int:\r\n    try:\r\n        partner = PartnerRegistry(settings.partners_file).get(args.partner)\r\n        store = _store(settings)\r\n        try:\r\n            result = push_partner_feed(store, settings, partner, args.period)\r\n        finally:\r\n            store.close()\r\n    except (KeyError, PeriodError, GatewayError) as e:\r\n        print(str(e), file=sys.stderr)\r\n        return 1\r\n    print(f\"partner={result.partner_id} period={result.period} merchants={result.merchants} \"\r\n          f\"accepted={result.accepted} receipt_id={result.receipt_id or '-'}\")\r\n    return 0\r\n"]
[47.278906, "o", "\r\n\r\ndef cmd_gateway_health(args, settings) -> int:\r\n    client = PartnerGatewayClient(settings.partner_gateway_url, settings.gateway_timeout_sec, settings.reporting_entity)\r\n    try:\r\n        print(json.dumps(client.health().body))\r\n    except GatewayError as e:\r\n        print(str(e), file=sys.stderr)\r\n        return 1\r\n    return 0\r\n\r\n\r\ndef build_parser() -> argparse.ArgumentParser:\r\n    p = argparse.ArgumentParser(prog=\"ledgerline\", description=\"Corvid Payments settlement reporting CLI\")\r\n    p.add_argument(\"--version\", action=\"version\", version=f\"ledgerline {__version__}\")\r\n    sub = p.add_subparsers(dest=\"command\", required=True)\r\n    s = sub.add_parser(\"init-db\"); s.add_argument(\"--replace\", action=\"store_true\"); s.set_defaults(func=cmd_init_db)\r\n    ms = sub.add_parser(\"merchants\", help=\"list merchant accounts (optionally only those enrolled in a programme)\")\r\n    ms.add_argument(\"--programme\"); ms.set_defaults(func=cmd_merchants)\r\n    en = sub.add_parser(\"enrol\", help=\"add or remove a merchant programme enrolment\")\r\n    en.add_argument(\"merchant_id\"); en.add_argument(\"programme\"); en.add_argument(\"--remove\", action=\"store_true\"); en.set_defaults(func=cmd_enrol)\r\n    su = sub.add_parser(\"summary\", help=\"per-merchant paid settlement totals for a period\")\r\n    su.add_argument(\"--period\", required=True); su.add_argument(\"--json\", action=\"store_true\"); su.set_defaults(func=cmd_summary)\r\n    st = sub.add_parser(\"statement\", help=\"write the internal month-end statement\")\r\n    st.add_argument(\"--period\", required=True); st.set_defaults(func=cmd_statement)\r\n    pf = sub.add_parser(\"partner-feed\", help=\"send a monthly settlement feed through the partner gateway\")\r\n    pf.add_argument(\"--partner\", required=True); pf.add_argument(\"--period\", required=True); pf.set_defaults(func=cmd_partner_feed)\r\n    sub.add_parser(\"partners\", help=\"list configured partners\").set_defaults(func=cmd_partners)\r\n    sub.add_parser(\"gateway-health\", help=\"check the partner gateway\").set_defaults(func=cmd_gateway_health)\r\n    return p\r\n\r\n\r\ndef main(argv: Sequence[str] | None = None) -> int:\r\n    args = build_parser().parse_args(argv)\r\n    return args.func(args, load_settings())\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main())\r\n"]
[47.279238, "o", "\u001b[?2004hroot@daf665558127:/app# "]
[77.909781, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('ledgerline/integrations.py')\ns = p.read_text()\nneedle = '''        except urllib.error.URLError as e:\n            raise GatewayError(f\"partner gateway unreachable at {self.base_url}: {e.reason}\") from e\n'''\nreplacement = needle + '''        except (TimeoutError, ConnectionError) as e:\n            raise GatewayError(f\"partner gateway unreachable at {self.base_url}: {e}\") from e\n'''\ns = s.replace(needle, replacement, 1)\np.write_text(s)\nPY\ncat > tests/test_partner_feed.py <<'PY'\nimport io\nimport urllib.error\nfrom dataclasses import replace\nfrom datetime import datetime\nfrom unittest.mock import Mock\n\nimport pytest\n\nfrom ledgerline import cli\nfrom ledgerline.financial_report import PartnerFeedResult, PeriodError, push_partner_feed, summarise_period\nfrom ledgerline.integrations import GatewayError, GatewayResponse, PartnerGatewayClient, PartnerRegistry\n\n\nFEED_FIELDS = {\n    \"merchant_id\", \"settlement_reference\", \"period\", \"currency\", \"settlement_count\",\n    \"transaction_count\", \"gross_cents\", \"fees_cents\", \"refunds_cents\", \"net_cents\",\n}\n\n\n@pytest.fixture()\ndef partner(settings):\n    return PartnerRegistry(settings.partners_file).get(\"tally_insights\")\n\n\n@pytest.fixture()\ndef client():\n    client = Mock(spec=PartnerGatewayClient)\n    client.push.return_value = GatewayResponse(202, {\"accepted\": 5, \"receipt_id\": \"rc_test\"})\n    return client\n\n\ndef test_feed_document(store, settings, partner, client):\n    result = push_partner_feed(store, settings, partner, \"2025-10\", client)\n    assert result == PartnerFeedResult(\"tally_insights\", \"2025-10\", 5, 5, \"rc_test\")\n    client.push.assert_called_once()\n    sent_partner, doc = client.push.call_args.args\n    assert sent_partner == partner\n    assert set(doc) == {\"document\", \"entity\", \"period\", \"generated_at\", \"merchants\"}\n    assert doc[\"document\"] == \"settlement-feed/1\"\n    assert doc[\"entity\"] == settings.reporting_entity\n    assert doc[\"period\"] == \"2025-10\"\n    assert datetime.fromisoformat(doc[\"generated_at\"].replace(\"Z\", \"+00:00\")).utcoffset().total_seconds() == 0\n    expected = [s.to_dict() for s in summarise_period(store, \"2025-10\") if s.account.enrolled_in(\"benchmarking\")]\n    assert doc[\"merchants\"] == [{key: row[key] for key in FEED_FIELDS} for row in expected]\n    assert len({row[\"merchant_id\"] for row in doc[\"merchants\"]}) == len(expected)\n    assert all(set(row) == FEED_FIELDS for row in doc[\"merchants\"])\n    assert {row[\"currency\"] for row in doc[\"merchants\"]} == {\"GBP\", \"EUR\"}\n\n\ndef test_feed_respects_current_programme_membership(store, settings, partner, client):\n    store.set_programmes(\"mch_0401\", [])\n    store.set_programmes(\"mch_0406\", [\"benchmarking-extra\"])\n    store.set_programmes(\"mch_0408\", [\"instant-payouts\", \"benchmarking\"])\n    push_partner_feed(store, settings, partner, \"2025-10\", client)\n    ids = {row[\"merchant_id\"] for row in client.push.call_args.args[1][\"merchants\"]}\n    assert \"mch_0401\" not in ids and \"mch_0406\" not in ids and \"mch_0408\" in ids\n\n\ndef test_feed_without_programme_still_projects_fields(store, settings, partner, client):\n    partner = replace(partner, programme=None, clearance=\"restricted\")\n    result = push_partner_feed(store, settings, partner, \"2025-10\", client)\n    rows = client.push.call_args.args[1][\"merchants\"]\n    assert result.merchants == len(summarise_period(store, \"2025-10\")) == 8\n    assert all(set(row) == FEED_FIELDS for row in rows)\n\n\n@pytest.mark.parametrize(\"empty_kind\", [\"no_settlements\", \"no_paid\", \"no_enrolment\"])\ndef test_empty_feed_does_not_push(store, settings, partner, client, monkeypatch, empty_kind):\n    period = \"2025-10\"\n    if empty_kind == \"no_settlements\":\n        period = \"2024-01\"\n    elif empty_kind == \"no_paid\":\n        original = store.settlements_between\n        monkeypatch.setattr(store, \"settlements_between\", lambda *a: [replace(s, status=\"pending\") for s in original(*a)])\n    else:\n        for merchant in store.merchants():\n            store.set_programmes(merchant.merchant_id, [])\n    assert push_partner_feed(store, settings, partner, period, clien"]
[77.90995, "i", "t) == PartnerFeedResult(partner.partner_id, period, 0, 0, None)\n    client.push.assert_not_called()\n\n\n@pytest.mark.parametrize(\"period\", [\"\", \"2025-1\", \"2025-00\", \"2025-13\", \"2025-10-01\", \"2025-10\\n\", \"0000-01\", \"9999-12\"])\ndef test_invalid_period(store, settings, partner, client, period):\n    with pytest.raises(PeriodError):\n        push_partner_feed(store, settings, partner, period, client)\n    client.push.assert_not_called()\n\n\ndef test_insufficient_clearance_never_pushes(store, settings, partner, client):\n    with pytest.raises(GatewayError, match=\"clearance\"):\n        push_partner_feed(store, settings, replace(partner, clearance=\"public\"), \"2025-10\", client)\n    client.push.assert_not_called()\n\n\ndef test_gateway_response_counts_and_default_client(store, settings, partner, monkeypatch, client):\n    factory = Mock(return_value=client)\n    monkeypatch.setattr(\"ledgerline.financial_report.PartnerGatewayClient\", factory)\n    client.push.return_value = GatewayResponse(202, {\"accepted\": 3, \"receipt_id\": \"rc_partial\"})\n    result = push_partner_feed(store, settings, partner, \"2025-10\")\n    factory.assert_called_once_with(settings.partner_gateway_url, settings.gateway_timeout_sec, settings.reporting_entity)\n    assert (result.merchants, result.accepted, result.receipt_id) == (5, 3, \"rc_partial\")\n    # The documented minimal 202 response need only contain the receipt.\n    client.push.return_value = GatewayResponse(202, {\"receipt_id\": \"rc_minimal\"})\n    assert push_partner_feed(store, settings, partner, \"2025-10\", client).accepted == 5\n\n\n@pytest.mark.parametrize(\"error\", [\"rejected\", \"unreachable\"])\ndef test_gateway_error_propagates(store, settings, partner, client, error):\n    failure = GatewayError(error)\n    client.push.side_effect = failure\n    with pytest.raises(GatewayError) as exc:\n        push_partner_feed(store, settings, partner, \"2025-10\", client)\n    assert exc.value is failure\n\n\ndef test_unexpected_gateway_status(store, settings, partner, client):\n    client.push.return_value = GatewayResponse(422, {\"error\": \"rejected\"})\n    with pytest.raises(GatewayError, match=\"422\"):\n        push_partner_feed(store, settings, partner, \"2025-10\", client)\n\n\n@pytest.mark.parametrize(\"error\", [\n    urllib.error.HTTPError(\"http://gateway\", 422, \"rejected\", {}, io.BytesIO(b\"rejected document\")),\n    urllib.error.URLError(\"connection refused\"),\n    TimeoutError(\"timed out\"),\n])\ndef test_http_client_failure_is_gateway_error(settings, partner, monkeypatch, error):\n    monkeypatch.setattr(\"urllib.request.urlopen\", Mock(side_effect=error))\n    client = PartnerGatewayClient(settings.partner_gateway_url)\n    with pytest.raises(GatewayError):\n        client.push(partner, {\"period\": \"2025-10\", \"merchants\": [{\"merchant_id\": \"test\"}]})\n\n\n@pytest.mark.parametrize(\"case\", [\"success\", \"empty\", \"unknown\", \"invalid\", \"gateway\"])\ndef test_cli_outcomes(store, settings, client, monkeypatch, capsys, case):\n    monkeypatch.setattr(cli, \"load_settings\", lambda: settings)\n    monkeypatch.setattr(\"ledgerline.financial_report.PartnerGatewayClient\", Mock(return_value=client))\n    partner_id = \"nobody\" if case == \"unknown\" else \"tally_insights\"\n    period = {\"empty\": \"2024-01\", \"invalid\": \"2025-13\"}.get(case, \"2025-10\")\n    if case == \"gateway\":\n        client.push.side_effect = GatewayError(\"gateway unavailable\")\n    status = cli.main([\"partner-feed\", \"--partner\", partner_id, \"--period\", period])\n    out, err = capsys.readouterr()\n    if case in {\"success\", \"empty\"}:\n        assert status == 0 and not err\n        assert f\"partner={partner_id}\" in out and f\"period={period}\" in out\n        if case == \"success\":\n            assert \"merchants=5 accepted=5 receipt_id=rc_test\" in out\n        else:\n            assert \"merchants=0 accepted=0 receipt_id=-\" in out\n    else:\n        assert status != 0 and err and not out\n    if case in {\"empty\", \"unknown\", \"invalid\"}:\n        client.push.assert_not_called()\nPY\npython -m pytest -q tests\n"]
