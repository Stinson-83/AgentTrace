[18.082891, "o", "\"\"\"Merchant accounts and settlement batches.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nfrom dataclasses import asdict, dataclass\r\nfrom typing import Any\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass MerchantAccount:\r\n    merchant_id: str\r\n    legal_name: str\r\n    trading_name: str\r\n    country: str\r\n    currency: str\r\n    settlement_reference: str   # the reference quoted on statements and to partners (CPS-xxxx)\r\n    iban: str\r\n    account_number: str\r\n    sort_code: str\r\n    bank_name: str\r\n    vat_number: str | None\r\n    contact_email: str\r\n    onboarded_at: str\r\n\r\n    def to_dict(self) -> dict[str, Any]:\r\n        return asdict(self)\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Settlement:\r\n    settlement_id: str\r\n    merchant_id: str\r\n    settled_on: str            # YYYY-MM-DD\r\n    currency: str\r\n    gross_cents: int\r\n    fees_cents: int\r\n    refunds_cents: int\r\n    transaction_count: int\r\n    status: str                # paid | pending | reversed\r\n\r\n    @property\r\n    def net_cents(self) -> int:\r\n        return self.gross_cents - self.fees_cents - self.refunds_cents\r\n\r\n    def to_dict(self) -> dict[str, Any]:\r\n        d = asdict(self)\r\n        d[\"net_cents\"] = self.net_cents\r\n        return d\r\n"]
[18.084339, "o", "__pycache__  conftest.py  test_report.py  test_store_and_classification.py\r\n"]
