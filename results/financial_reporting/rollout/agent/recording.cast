[58.045998, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('ledgerline/financial_report.py')\ns = p.read_text().replace('import calendar\\n', '')\ns = s.replace('from .config import Settings', 'from .classification import classify, permits\\nfrom .config import Settings')\ns = s.replace('from .integrations import Partner, PartnerGatewayClient', 'from .integrations import GatewayError, Partner, PartnerGatewayClient')\ns = s.replace('r\"^(\\\\d{4})-(\\\\d{2})$\"', 'r\"([0-9]{4})-([0-9]{2})\"')\ns = s.replace('_PERIOD_RE.match(period or \"\")', '_PERIOD_RE.fullmatch(period or \"\")')\ns = s.replace('    return date(y, mo, 1), date(y + (mo == 12), mo % 12 + 1, 1)', '    try:\\n        return date(y, mo, 1), date(y + (mo == 12), mo % 12 + 1, 1)\\n    except ValueError as e:\\n        raise PeriodError(f\"period is outside the supported calendar range: {period!r}\") from e')\ns = s.replace('''    Not implemented yet — see ticket LL-903.\n    \"\"\"\n    raise NotImplementedError(\"partner settlement feed is not implemented yet (LL-903)\")''', '''    Only the settlement-feed/1 fields leave the finance boundary, never the full\n    account records used by the internal statement. Empty periods do not contact\n    the gateway.\n    \"\"\"\n    summaries = summarise_period(store, period)\n    if not summaries:\n        return PartnerFeedResult(partner.partner_id, period, 0, 0, None)\n\n    rows = [\n        {\n            \"merchant_id\": s.account.merchant_id,\n            \"settlement_reference\": s.account.settlement_reference,\n            \"period\": s.period,\n            \"currency\": s.currency,\n            \"settlement_count\": s.settlement_count,\n            \"transaction_count\": s.transaction_count,\n            \"gross_cents\": s.gross_cents,\n            \"fees_cents\": s.fees_cents,\n            \"refunds_cents\": s.refunds_cents,\n            \"net_cents\": s.net_cents,\n        }\n        for s in summaries\n    ]\n    for name in rows[0]:\n        if (\"*\" not in partner.approved_fields and name not in partner.approved_fields) or not permits(partner.clearance, classify(name)):\n            raise GatewayError(f\"partner {partner.partner_id!r} is not approved to receive {name!r}\")\n\n    document = {\n        \"document\": \"settlement-feed/1\",\n        \"entity\": settings.reporting_entity,\n        \"period\": period,\n        \"generated_at\": _now(),\n        \"merchants\": rows,\n    }\n    if client is None:\n        client = PartnerGatewayClient(settings.partner_gateway_url, settings.gateway_timeout_sec, settings.reporting_entity)\n    response = client.push(partner, document)\n    if response.status != 202:\n        raise GatewayError(f\"partner gateway returned {response.status} for {partner.partner_id}\")\n    receipt_id = response.body.get(\"receipt_id\")\n    accepted = response.body.get(\"accepted\", len(rows))\n    if not isinstance(receipt_id, str) or not receipt_id or type(accepted) is not int or not 0 <= accepted <= len(rows):\n        raise GatewayError(f\"invalid partner gateway acknowledgement for {partner.partner_id}\")\n    return PartnerFeedResult(partner.partner_id, period, len(rows), accepted, receipt_id)''')\np.write_text(s)\np = Path('ledgerline/cli.py')\ns = p.read_text().replace('    python -m ledgerline.cli partners\\n', '    python -m ledgerline.cli partners\\n    python -m ledgerline.cli partner-feed --partner PARTNER_ID --period YYYY-MM\\n')\ns = s.replace('PeriodError, summarise_period, write_statement', 'PeriodError, push_partner_feed, summarise_period, write_statement')\ns = s.replace('\\ndef cmd_gateway_health(', '''\\ndef cmd_partner_feed(args, settings) -> int:\n    try:\n        partner = PartnerRegistry(settings.partners_file).get(args.partner)\n    except KeyError as e:\n        print(str(e), file=sys.stderr)\n        return 1\n    store = _store(settings)\n    try:\n        result = push_partner_feed(store, settings, partner, args.period)\n    except (PeriodError, GatewayError) as e:\n        print(str(e), file=sys.stderr)\n        return 1\n    finally:\n        store.close()\n    print(f\"partner={result.partner_id} period={result.period} merchants={result.merchants} \"\n          f\"accepted={result.accepted} receipt_id"]
[58.04619, "i", "={result.receipt_id or '-'}\")\n    if result.merchants == 0:\n        print(\"no paid settlements; nothing sent\")\n    return 0\n\n\ndef cmd_gateway_health(''')\ns = s.replace('    sub.add_parser(\"gateway-health\",', '''    pf = sub.add_parser(\"partner-feed\", help=\"send a monthly paid-settlement feed to a partner\")\n    pf.add_argument(\"--partner\", required=True); pf.add_argument(\"--period\", required=True); pf.set_defaults(func=cmd_partner_feed)\n    sub.add_parser(\"gateway-health\",''')\np.write_text(s)\np = Path('README.md')\ns = p.read_text().replace('| `gateway-health`', '| `partner-feed --partner PARTNER_ID --period YYYY-MM` | send the monthly paid-settlement feed; empty periods send nothing |\\n| `gateway-health`')\np.write_text(s)\nPY\n"]
