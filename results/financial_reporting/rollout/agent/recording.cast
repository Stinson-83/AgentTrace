[150.557661, "i", "python - <<'PY'\nimport base64\nimport json\nfrom pathlib import Path\nfrom ledgerline.config import load_settings\nfrom ledgerline.financial_report import summarise_period\nfrom ledgerline.store import LedgerStore\n\nfolder = Path('/var/lib/partner-gateway/received/tally-insights')\npath = max(folder.glob('*.json'), key=lambda p: p.name)\nrecord = json.loads(path.read_text())\ndoc = json.loads(base64.b64decode(record['body_b64']))\nsettings = load_settings()\nassert record['method'] == 'POST'\nassert record['path'] == '/partners/tally-insights/v1/settlement-feeds'\nassert record['headers']['x-partner-id'] == 'tally_insights'\nassert doc['document'] == 'settlement-feed/1'\nassert doc['period'] == '2025-10'\nassert doc['entity'] == settings.reporting_entity\nfields = {'merchant_id', 'settlement_reference', 'period', 'currency', 'settlement_count', 'transaction_count', 'gross_cents', 'fees_cents', 'refunds_cents', 'net_cents'}\nstore = LedgerStore(settings.db_path)\ntry:\n    summaries = summarise_period(store, '2025-10')\n    assert len(doc['merchants']) == len(summaries) == 8\n    for row, summary in zip(doc['merchants'], summaries):\n        assert set(row) == fields\n        assert row == {name: summary.to_dict()[name] for name in fields}\nfinally:\n    store.close()\nprint(f'Verified persisted October feed: {len(doc[\"merchants\"])} merchant rows, paid-only totals, approved schema only.')\nprint(f'Gateway record: {path}')\nprint(Path('/tmp/ll903-delivery.txt').read_text().strip())\nPY\n"]
