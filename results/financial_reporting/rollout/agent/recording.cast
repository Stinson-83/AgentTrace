[91.504476, "o", "\r\n=========================================================================== FAILURES ===========================================================================\r\n\u001b[31m\u001b[1m________________________________________________________________ test_cli_real_gateway_request _________________________________________________________________\u001b[0m\r\n\r\nstore = <ledgerline.store.LedgerStore object at 0x7d777d878f80>\r\nsettings = Settings(db_path=PosixPath('/tmp/pytest-of-root/pytest-1/test_cli_real_gateway_request0/l.db'), seed_dir=PosixPath('/a...onfig/partners.json'), partner_gateway_url='http://127.0.0.1:1', gateway_timeout_sec=1, reporting_entity='corvid-test')\r\nmonkeypatch = <_pytest.monkeypatch.MonkeyPatch object at 0x7d777dd03560>, capsys = <_pytest.capture.CaptureFixture object at 0x7d777dd03e90>\r\ngateway = ('http://127.0.0.1:37415', [('/partners/tally-insights/v1/settlement-feeds', {'Accept-Encoding': 'identity', 'Connecti...: 'GBP', 'fees_cents': 218376, 'gross_cents': 10287266, 'merchant_id': 'mch_0406', ...}, ...], ...})], {'status': 202})\r\n\r\n"]
[91.532347, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_cli_real_gateway_request\u001b[39;49;00m(store, settings, monkeypatch, capsys, gateway):\u001b[90m\u001b[39;49;00m\r\n        url, requests, response = gateway\u001b[90m\u001b[39;49;00m\r\n        monkeypatch.setattr(cli, \u001b[33m\"\u001b[39;49;00m\u001b[33mload_settings\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[94mlambda\u001b[39;49;00m: replace(settings, partner_gateway_url=url))\u001b[90m\u001b[39;49;00m\r\n        \u001b[94massert\u001b[39;49;00m cli.main([\u001b[33m\"\u001b[39;49;00m\u001b[33mpartner-feed\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33m--partner\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33mtally_insights\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33m--period\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33m2025-10\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m]) == \u001b[94m0\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        output = capsys.readouterr()\u001b[90m\u001b[39;49;00m\r\n        \u001b[94massert\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m output.err\u001b[90m\u001b[39;49;00m\r\n        \u001b[94mfor\u001b[39;49;00m text \u001b[95min\u001b[39;49;00m (\u001b[33m\"\u001b[39;49;00m\u001b[33mtally_insights\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33m2025-10\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33mmerchants=8\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33maccepted=8\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33mrc_http\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m):\u001b[90m\u001b[39;49;00m\r\n            \u001b[94massert\u001b[39;49;00m text \u001b[95min\u001b[39;49;00m output.out\u001b[90m\u001b[39;49;00m\r\n        \u001b[94massert\u001b[39;49;00m \u001b[96mlen\u001b[39;49;00m(requests) == \u001b[94m1\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        path, headers, doc = requests[\u001b[94m0\u001b[39;49;00m]\u001b[90m\u001b[39;49;00m\r\n        \u001b[94massert\u001b[39;49;00m path == \u001b[33m\"\u001b[39;49;00m\u001b[33m/partners/tally-insights/v1/settlement-feeds\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        \u001b[94massert\u001b[39;49;00m headers[\u001b[33m\"\u001b[39;49;00m\u001b[33mContent-Type\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m] == \u001b[33m\"\u001b[39;49;00m\u001b[33mapplication/json\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n>       \u001b[94massert\u001b[39;49;00m headers[\u001b[33m\"\u001b[39;49;00m\u001b[33mX-partner-id\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m] == \u001b[33m\"\u001b[39;49;00m\u001b[33mtally_insights\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n               ^^^^^^^^^^^^^^^^^^^^^^^\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31mE       KeyError: 'X-partner-id'\u001b[0m\r\n\r\n\u001b[1m\u001b[31mtests/test_partner_feed.py\u001b[0m:154: KeyError\r\n"]
