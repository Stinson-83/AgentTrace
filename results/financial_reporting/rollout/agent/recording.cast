[89.810708, "o", "\u001b[?2004h> "]
[89.811121, "o", "    assert result == PartnerFeedResult(\"tally_insights\", \"2025-10\", len(ids), len(ids), \"rc_test\")\r\n\u001b[?2004l\r"]
[89.811165, "o", "\u001b[?2004h> "]
[89.811301, "o", "    client.push.assert_called_once()\r\n\u001b[?2004l\r"]
[89.811344, "o", "\u001b[?2004h> "]
[89.811529, "o", "    destination, doc = client.push.call_args.args\r\n\u001b[?2004l\r"]
[89.811567, "o", "\u001b[?2004h> "]
[89.811683, "o", "    assert destination == partner\r\n\u001b[?2004l\r"]
[89.811726, "o", "\u001b[?2004h"]
[89.811753, "o", "> "]
[89.811961, "o", "    assert set(doc) == {\"document\", \"entity\", \"period\", \"generated_at\", \"merchants\"}\r\n\u001b[?2004l\r"]
[89.811991, "o", "\u001b[?2004h> "]
[89.812062, "o", "    assert doc[\"document\"] == \"settlement-feed/1\"\r\n\u001b[?2004l\r"]
[89.812088, "o", "\u001b[?2004h> "]
[89.812152, "o", "    assert doc[\"entity\"] == settings.reporting_entity\r\n\u001b[?2004l\r"]
[89.8122, "o", "\u001b[?2004h> "]
[89.81223, "o", "    assert doc[\"period\"] == \"2025-10\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.812257, "o", "> "]
[89.812405, "o", "    assert datetime.fromisoformat(doc[\"generated_at\"].replace(\"Z\", \"+00:00\")).utcoffset().total_seconds() == 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.81262, "o", "    assert [row[\"merchant_id\"] for row in doc[\"merchants\"]] == ids\r\n\u001b[?2004l\r\u001b[?2004h>     for row in doc[\"merchants\"]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.812671, "o", "        merchant = store.merchant(row[\"merchant_id\"])\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.812703, "o", "> "]
[89.812805, "o", "        settlements = [s for s in paid if s.merchant_id == merchant.merchant_id]\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.812833, "o", "> "]
[89.812861, "o", "        assert row == {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.812932, "o", "            \"merchant_id\": merchant.merchant_id,\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.812959, "o", "> "]
[89.813043, "o", "            \"settlement_reference\": merchant.settlement_reference,\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.813071, "o", "> "]
[89.813102, "o", "            \"period\": \"2025-10\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.813129, "o", "> "]
[89.813181, "o", "            \"currency\": merchant.currency,\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.81321, "o", "> "]
[89.81327, "o", "            \"settlement_count\": len(settlements),\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.813302, "o", "> "]
[89.813454, "o", "            \"transaction_count\": sum(s.transaction_count for s in settlements),\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.813486, "o", "> "]
[89.813685, "o", "            \"gross_cents\": sum(s.gross_cents for s in settlements),\r\n\u001b[?2004l\r"]
[89.813747, "o", "\u001b[?2004h> "]
[89.813959, "o", "            \"fees_cents\": sum(s.fees_cents for s in settlements),\r\n\u001b[?2004l\r"]
[89.814039, "o", "\u001b[?2004h> "]
[89.814176, "o", "            \"refunds_cents\": sum(s.refunds_cents for s in settlements),\r\n\u001b[?2004l\r"]
[89.814273, "o", "\u001b[?2004h> "]
[89.814368, "o", "            \"net_cents\": sum(s.net_cents for s in settlements),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.814458, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.814523, "o", "    # Sensitive values must not leak elsewhere in the document either.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.814551, "o", "    encoded = json.dumps(doc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.814625, "o", "    for merchant in store.merchants():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.814733, "o", "        for name in (\"iban\", \"account_number\", \"sort_code\", \"bank_name\", \"contact_email\"):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.814819, "o", "            assert getattr(merchant, name) not in encoded\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.814888, "o", "> \r\n\u001b[?2004l\rs\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.815075, "o", "@pytest.mark.parametrize(\"nonpaid_only\", [False, True])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.815397, "o", "def test_empty_feed_does_not_send(store, settings, partner, client, monkeypatch, nonpaid_only):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.815528, "o", "    if nonpaid_only:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.815733, "o", "        settlements = store.settlements_between(*period_bounds(\"2025-10\"))\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.815828, "o", "> "]
[89.81613, "o", "        monkeypatch.setattr(store, \"settlements_between\", lambda *args: [s for s in settlements if s.status != \"paid\"])\r\n\u001b[?2004l\r"]
[89.816212, "o", "\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.816444, "o", "        monkeypatch.setattr(store, \"settlements_between\", lambda *args: [])\r\n\u001b[?2004l\r"]
[89.816503, "o", "\u001b[?2004h> "]
[89.816565, "o", "    factory = Mock()\r\n\u001b[?2004l\r"]
[89.81663, "o", "\u001b[?2004h> "]
[89.816826, "o", "    monkeypatch.setattr(\"ledgerline.financial_report.PartnerGatewayClient\", factory)\r\n\u001b[?2004l\r"]
[89.816886, "o", "\u001b[?2004h> "]
[89.816963, "o", "    for supplied in (client, None):\r\n\u001b[?2004l\r"]
[89.817013, "o", "\u001b[?2004h"]
[89.817039, "o", "> "]
[89.817432, "o", "        assert push_partner_feed(store, settings, partner, \"2025-10\", supplied) == PartnerFeedResult(\"tally_insights\", \"2025-10\", 0, 0, None)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.817516, "o", "    client.push.assert_not_called()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.817552, "o", "    factory.assert_not_called()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[89.817585, "o", "s\u001b[?2004h> \r\n\u001b[?2004l\r"]
[89.817591, "o", "a\u001b[?2004h> "]
[89.817794, "o", "@pytest.mark.parametrize(\"period\", [\"\", \"2025-1\", \"2025-00\", \"2025-13\", \"2025-10-01\", \"2025-10\\n\", \"0000-01\", \"9999-12\", \"２０２５-１０\"])\r\n\u001b[?2004l\r"]
[89.817818, "o", "\u001b[?2004h> "]
[89.81793, "o", "def test_feed_rejects_bad_period_before_sending(store, settings, partner, client, period):\r\n\u001b[?2004l\r"]
[89.817961, "o", "\u001b[?2004h> "]
[89.817998, "o", "    with pytest.raises(PeriodError):\r\n\u001b[?2004l\r"]
[89.81802, "o", "\u001b[?2004h> "]
[89.818107, "o", "        push_partner_feed(store, settings, partner, period, client)\r\n\u001b[?2004l\r"]
[89.818128, "o", "\u001b[?2004h> "]
[89.818169, "o", "    client.push.assert_not_called()\r\n\u001b[?2004l\r"]
[89.818199, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\ro"]
[89.81822, "o", "\u001b[?2004h> "]
[89.818302, "o", "def test_gateway_error_surfaces(store, settings, partner, client):\r\n\u001b[?2004l\r"]
[89.818323, "o", "\u001b[?2004h> "]
[89.818373, "o", "    failure = GatewayError(\"unreachable\")\r\n\u001b[?2004l\r"]
[89.8184, "o", "\u001b[?2004h"]
[89.818421, "o", "> "]
[89.818446, "o", "    client.push.side_effect = failure\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.818474, "o", "> "]
[89.818517, "o", "    with pytest.raises(GatewayError) as exc:\r\n\u001b[?2004l\r"]
[89.818537, "o", "\u001b[?2004h> "]
[89.818633, "o", "        push_partner_feed(store, settings, partner, \"2025-10\", client)\r\n\u001b[?2004l\r"]
[89.81866, "o", "\u001b[?2004h> "]
[89.818693, "o", "    assert exc.value is failure\r\n\u001b[?2004l\r"]
[89.818714, "o", "\u001b[?2004h> "]
[89.818735, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[89.818762, "o", "p\u001b[?2004h> "]
[89.81893, "o", "@pytest.mark.parametrize(\"body,accepted\", [({\"receipt_id\": \"rc_test\"}, 8), ({\"receipt_id\": \"rc_test\", \"accepted\": 2}, 2)])\r\n\u001b[?2004l\r"]
[89.818965, "o", "\u001b[?2004h"]
[89.818988, "o", "> "]
[89.819068, "o", "def test_gateway_acknowledgement(store, settings, partner, client, body, accepted):\r\n\u001b[?2004l\r"]
[89.819097, "o", "\u001b[?2004h> "]
[89.819161, "o", "    client.push.return_value = GatewayResponse(202, body)\r\n\u001b[?2004l\r"]
[89.819193, "o", "\u001b[?2004h> "]
[89.819309, "o", "    assert push_partner_feed(store, settings, partner, \"2025-10\", client).accepted == accepted\r\n\u001b[?2004l\r"]
[89.819336, "o", "\u001b[?2004h> "]
[89.819363, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.819541, "o", "@pytest.mark.parametrize(\"response\", [GatewayResponse(503, {}), GatewayResponse(202, {}), GatewayResponse(202, {\"receipt_id\": \"rc_test\", \"accepted\": -1})])\r\n\u001b[?2004l\r"]
[89.819562, "o", "\u001b[?2004h"]
[89.819569, "o", "> "]
[89.819637, "o", "def test_bad_gateway_response(store, settings, partner, client, response):\r\n\u001b[?2004l\r"]
[89.819657, "o", "\u001b[?2004h> "]
[89.819692, "o", "    client.push.return_value = response\r\n\u001b[?2004l\r"]
[89.819712, "o", "\u001b[?2004h> "]
[89.819745, "o", "    with pytest.raises(GatewayError):\r\n\u001b[?2004l\r"]
[89.819766, "o", "\u001b[?2004h> "]
[89.819837, "o", "        push_partner_feed(store, settings, partner, \"2025-10\", client)\r\n\u001b[?2004l\r"]
[89.819843, "o", "\u001b[?2004h> "]
[89.819895, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.819947, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.819983, "o", "@pytest.mark.parametrize(\"changes\", [{\"clearance\": \"public\"}, {\"approved_fields\": [\"merchant_id\"]}])\r\n\u001b[?2004l\r"]
[89.820015, "o", "\u001b[?2004h> "]
[89.820123, "o", "def test_partner_permissions_checked_before_send(store, settings, partner, client, changes):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.820188, "o", "    with pytest.raises(GatewayError):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.820277, "o", "        push_partner_feed(store, settings, replace(partner, **changes), \"2025-10\", client)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.820341, "o", "    client.push.assert_not_called()\r\n\u001b[?2004l\r"]
[89.82041, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.82047, "o", "@pytest.fixture()\r\n\u001b[?2004l\r\u001b[?2004h> def gateway():\r\n\u001b[?2004l\r\u001b[?2004h>     requests = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.820518, "o", "    response = {\"status\": 202}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.820565, "o", "    class Handler(BaseHTTPRequestHandler):\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.820608, "o", "> "]
[89.820662, "o", "        def log_message(self, *args):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.820702, "o", "            pass\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>         def do_POST(self):\r\n\u001b[?2004l\r"]
[89.820742, "o", "\u001b[?2004h> "]
[89.820889, "o", "            doc = json.loads(self.rfile.read(int(self.headers[\"Content-Length\"])))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.820947, "o", "            requests.append((self.path, dict(self.headers), doc))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.821038, "o", "            data = json.dumps({\"receipt_id\": \"rc_http\", \"accepted\": len(doc[\"merchants\"])}).encode()\r\n\u001b[?2004l\r"]
[89.821082, "o", "\u001b[?2004h> "]
[89.821135, "o", "            self.send_response(response[\"status\"])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.821191, "o", "            self.send_header(\"Content-Type\", \"application/json\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.821229, "o", "> "]
[89.82127, "o", "            self.send_header(\"Content-Length\", str(len(data)))\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.821307, "o", "> "]
[89.821344, "o", "            self.end_headers()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.821381, "o", "            self.wfile.write(data)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.821453, "o", "    server = ThreadingHTTPServer((\"127.0.0.1\", 0), Handler)\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.821491, "o", "> "]
[89.821543, "o", "    thread = threading.Thread(target=server.serve_forever, daemon=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.821582, "o", ">     thread.start()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.82162, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.821689, "o", "        yield f\"http://127.0.0.1:{server.server_port}\", requests, response\r\n\u001b[?2004l\r"]
[89.821727, "o", "\u001b[?2004h>     finally:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.821763, "o", "        server.shutdown()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.821859, "o", "        server.server_close()\r\n\u001b[?2004l\r\u001b[?2004h>         thread.join()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[89.821898, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.821968, "o", "def test_cli_real_gateway_request(store, settings, monkeypatch, capsys, gateway):\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.822005, "o", "> "]
[89.822041, "o", "    url, requests, response = gateway\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.822155, "o", "    monkeypatch.setattr(cli, \"load_settings\", lambda: replace(settings, partner_gateway_url=url))\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.822193, "o", "> "]
[89.822264, "o", "    assert cli.main([\"partner-feed\", \"--partner\", \"tally_insights\", \"--period\", \"2025-10\"]) == 0\r\n\u001b[?2004l\r"]
[89.822302, "o", "\u001b[?2004h> "]
[89.82234, "o", "    output = capsys.readouterr()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.822378, "o", "    assert not output.err\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.822473, "o", "    for text in (\"tally_insights\", \"2025-10\", \"merchants=8\", \"accepted=8\", \"rc_http\"):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.822555, "o", "        assert text in output.out\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.822621, "o", "    assert len(requests) == 1\r\n\u001b[?2004l\r\u001b[?2004h>     path, headers, doc = requests[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.822691, "o", "    assert path == \"/partners/tally-insights/v1/settlement-feeds\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.822738, "o", "> "]
[89.822795, "o", "    assert headers[\"Content-Type\"] == \"application/json\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.822845, "o", "    assert headers[\"X-partner-id\"] == \"tally_insights\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.82293, "o", "    assert headers[\"X-reporting-entity\"] == settings.reporting_entity\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.82297, "o", "> "]
[89.823009, "o", "    assert doc[\"document\"] == \"settlement-feed/1\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.823049, "o", "    response[\"status\"] = 503\r\n\u001b[?2004l\r"]
[89.823088, "o", "\u001b[?2004h> "]
[89.823176, "o", "    assert cli.main([\"partner-feed\", \"--partner\", \"tally_insights\", \"--period\", \"2025-10\"]) != 0\r\n\u001b[?2004l\r"]
[89.823224, "o", "\u001b[?2004h>     assert \"503\" in capsys.readouterr().err\r\n\u001b[?2004l\r"]
[89.823268, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.823428, "o", "@pytest.mark.parametrize(\"partner_id,period,message\", [(\"nobody\", \"2025-10\", \"unknown partner\"), (\"tally_insights\", \"2025-13\", \"period must look like\")])\r\n\u001b[?2004l\r"]
[89.823468, "o", "\u001b[?2004h> "]
[89.82355, "o", "def test_cli_invalid_arguments(store, settings, monkeypatch, capsys, partner_id, period, message):\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.823589, "o", "> "]
[89.823629, "o", "    monkeypatch.setattr(cli, \"load_settings\", lambda: settings)\r\n\u001b[?2004l\r"]
[89.823668, "o", "\u001b[?2004h>     push = Mock()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.823764, "o", "    monkeypatch.setattr(\"ledgerline.financial_report.PartnerGatewayClient\", push)\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.823844, "o", "> "]
[89.823883, "o", "    assert cli.main([\"partner-feed\", \"--partner\", partner_id, \"--period\", period]) != 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.823939, "o", "    assert message in capsys.readouterr().err\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.823977, "o", ">     push.assert_not_called()\r\n\u001b[?2004l\r"]
[89.824016, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.824087, "o", "def test_cli_empty_period(store, settings, monkeypatch, capsys):\r\n\u001b[?2004l\r"]
[89.824125, "o", "\u001b[?2004h> "]
[89.824169, "o", "    monkeypatch.setattr(cli, \"load_settings\", lambda: settings)\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.824207, "o", "> "]
[89.824286, "o", "    assert cli.main([\"partner-feed\", \"--partner\", \"tally_insights\", \"--period\", \"2024-01\"]) == 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.824324, "o", "> "]
[89.824362, "o", "    output = capsys.readouterr()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.824399, "o", "    assert \"merchants=0 accepted=0\" in output.out\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.824438, "o", "> "]
[89.824475, "o", "    assert \"nothing sent\" in output.out\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.824513, "o", "    assert not output.err\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[89.824551, "o", "\u001b[?2004h> "]
[89.824605, "o", "def test_cli_unreachable_gateway(store, settings, monkeypatch, capsys):\r\n\u001b[?2004l\r"]
[89.824642, "o", "\u001b[?2004h> "]
[89.824688, "o", "    monkeypatch.setattr(cli, \"load_settings\", lambda: settings)\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.824726, "o", "> "]
[89.824794, "o", "    # settings fixture points to a closed local port, not the real partner gateway.\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.824833, "o", "> "]
[89.824911, "o", "    assert cli.main([\"partner-feed\", \"--partner\", \"tally_insights\", \"--period\", \"2025-10\"]) != 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.824949, "o", "> "]
[89.824983, "o", "    assert \"unreachable\" in capsys.readouterr().err\r\n\u001b[?2004l\r\u001b[?2004h"]
