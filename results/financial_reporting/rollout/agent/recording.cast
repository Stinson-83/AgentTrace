[114.820603, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('ledgerline/integrations.py')\ns = p.read_text().replace('except urllib.error.URLError as e:\\n            raise GatewayError(f\"partner gateway unreachable at {self.base_url}: {e.reason}\") from e', 'except (urllib.error.URLError, TimeoutError, ConnectionError) as e:\\n            raise GatewayError(f\"partner gateway unreachable at {self.base_url}: {getattr(e, \\'reason\\', str(e))}\") from e')\np.write_text(s)\np = Path('tests/test_partner_feed.py')\ns = p.read_text() + '''\\n\\n@pytest.mark.parametrize(\"error\", [TimeoutError(\"timed out\"), ConnectionResetError(\"connection reset\")])\ndef test_gateway_connection_failure_wrapped(settings, partner, monkeypatch, error):\n    monkeypatch.setattr(\"urllib.request.urlopen\", Mock(side_effect=error))\n    client = PartnerGatewayClient(settings.partner_gateway_url)\n    with pytest.raises(GatewayError, match=\"unreachable\"):\n        client.push(partner, {\"period\": \"2025-10\", \"merchants\": []})\n'''\np.write_text(s)\nPY\npython -m pytest -q tests > /tmp/ll903-tests.txt 2>&1; cat /tmp/ll903-tests.txt\n"]
[114.820859, "o", "python - <<'PY'\r\n\u001b[?2004l\r"]
[114.820955, "o", "\u001b[?2004h> "]
[114.821043, "o", "from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.821143, "o", "p = Path('ledgerline/integrations.py')\r\n\u001b[?2004l\r"]
