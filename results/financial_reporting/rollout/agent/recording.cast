[24.251981, "o", "import sys\r\nfrom pathlib import Path\r\n\r\nimport pytest\r\n\r\nROOT = Path(__file__).resolve().parents[1]\r\nsys.path.insert(0, str(ROOT))\r\n\r\nfrom ledgerline.config import Settings  # noqa: E402\r\nfrom ledgerline.store import LedgerStore  # noqa: E402\r\n\r\n\r\n@pytest.fixture()\r\ndef settings(tmp_path):\r\n    return Settings(db_path=tmp_path / \"l.db\", seed_dir=ROOT / \"data\" / \"seed\", statements_dir=tmp_path / \"statements\",\r\n                    partners_file=ROOT / \"config\" / \"partners.json\", partner_gateway_url=\"http://127.0.0.1:1\", gateway_timeout_sec=1,\r\n                    reporting_entity=\"corvid-test\")\r\n\r\n\r\n@pytest.fixture()\r\ndef store(settings):\r\n    s = LedgerStore(settings.db_path)\r\n    s.load_seed(settings.seed_dir)\r\n    yield s\r\n    s.close()\r\n"]
[24.253409, "o", "import json\r\n\r\nimport pytest\r\n\r\nfrom ledgerline.financial_report import PeriodError, period_bounds, summarise_period, write_statement\r\nfrom ledgerline.integrations import PartnerRegistry\r\n\r\n\r\ndef test_period_bounds():\r\n    assert period_bounds(\"2025-12\")[1].isoformat() == \"2026-01-01\"\r\n    with pytest.raises(PeriodError):\r\n        period_bounds(\"2025-13\")\r\n\r\n\r\ndef test_summaries_paid_only(store):\r\n    summaries = {s.account.merchant_id: s for s in summarise_period(store, \"2025-10\")}\r\n    s = summaries[\"mch_0401\"]\r\n    paid = [x for x in store.settlements_between(*period_bounds(\"2025-10\"), merchant_id=\"mch_0401\") if x.status == \"paid\"]\r\n    assert s.settlement_count == len(paid) and s.gross_cents == sum(x.gross_cents for x in paid) and s.net_cents == sum(x.net_cents for x in paid)\r\n    assert s.to_dict()[\"iban\"].startswith(\"GB77\") and s.to_dict()[\"period\"] == \"2025-10\"\r\n    assert summarise_period(store, \"2024-01\") == []\r\n\r\n\r\ndef test_statement_written(store, settings):\r\n    path = write_statement(store, settings, \"2025-10\")\r\n    doc = json.loads(path.read_text())\r\n    assert doc[\"document\"] == \"ledgerline.statement/2\" and doc[\"merchants\"] and \"iban\" in doc[\"merchants\"][0]\r\n    assert doc[\"totals\"][\"net_cents\"] == sum(m[\"net_cents\"] for m in doc[\"merchants\"])\r\n\r\n\r\ndef test_partner_registry(settings):\r\n"]
[24.253432, "o", "    reg = PartnerRegistry(settings.partners_file)\r\n    tally = reg.get(\"tally_insights\")\r\n    assert tally.clearance == \"internal\" and \"iban\" not in tally.approved_fields and tally.endpoint.startswith(\"/partners/tally-insights/\")\r\n    assert [p.partner_id for p in reg.all()] == [\"northgate_audit\", \"tally_insights\"]\r\n    with pytest.raises(KeyError):\r\n        reg.get(\"nobody\")\r\n"]
[24.25452, "o", "from datetime import date\r\n\r\nimport pytest\r\n\r\nfrom ledgerline.classification import classify, highest_class, permits, rank\r\nfrom ledgerline.store import LedgerError\r\n\r\n\r\ndef test_seed_counts(store):\r\n    assert store.counts()[\"merchants\"] == 8 and store.counts()[\"settlements\"] > 100\r\n    m = store.merchant(\"mch_0403\")\r\n    assert m.currency == \"EUR\" and m.settlement_reference == \"CPS-0403\"\r\n    with pytest.raises(LedgerError):\r\n        store.merchant(\"mch_9999\")\r\n\r\n\r\ndef test_settlements_between_half_open(store):\r\n    rows = store.settlements_between(date(2025, 10, 1), date(2025, 11, 1), merchant_id=\"mch_0401\")\r\n    days = {r.settled_on for r in rows}\r\n    assert \"2025-10-01\" in days and \"2025-10-31\" in days and \"2025-09-30\" not in days and \"2025-11-01\" not in days\r\n    assert all(r.net_cents == r.gross_cents - r.fees_cents - r.refunds_cents for r in rows)\r\n\r\n\r\ndef test_classification_rules():\r\n    assert classify(\"iban\") == \"restricted\" and classify(\"net_cents\") == \"internal\" and classify(\"made_up\") == \"restricted\"\r\n    assert permits(\"internal\", \"public\") and permits(\"internal\", \"internal\") and not permits(\"internal\", \"restricted\")\r\n    assert highest_class([\"period\", \"iban\", \"net_cents\"]) == \"restricted\" and rank(\"confidential\") == 2\r\n    with pytest.raises(ValueError):\r\n        rank(\"secret\")\r\n"]
[24.255846, "o", "# Data classification\r\n\r\nledgerline records are classified field by field (`ledgerline/classification.py`). Classes, lowest to\r\nhighest:\r\n\r\n| class | examples | who may receive it |\r\n|---|---|---|\r\n| `public` | trading name, country, currency, period | anyone |\r\n| `internal` | merchant id, legal name, settlement reference (`CPS-xxxx`), settlement totals, counts, dates | Corvid staff; partners cleared for `internal` |\r\n| `confidential` | bank name, VAT number, contact e-mail | Corvid finance/treasury; partners cleared for `confidential` |\r\n| `restricted` | IBAN, account number, sort code | treasury and the bank; partners cleared for `restricted` (statutory auditor only) |\r\n\r\nA destination may receive a field only if the destination's clearance is at or above the field's\r\nclass (`classification.permits(clearance, classify(field))`). Each external partner's clearance and\r\nits approved field list are recorded in `config/partners.json`; unknown fields are treated as\r\n`restricted`.\r\n\r\nThe internal month-end statement (`statement --period`) is a treasury document and carries full\r\naccount details; it is written to `data/statements/` and never leaves the finance share.\r\n"]
