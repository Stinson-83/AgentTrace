[73.002297, "o", "\u001b[?2004h> "]
[73.002338, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[73.002379, "o", "> "]
[73.002448, "o", "    if client is None:\r\n\u001b[?2004l\r"]
[73.002488, "o", "\u001b[?2004h> "]
[73.002892, "o", "        client = PartnerGatewayClient(settings.partner_gateway_url, settings.gateway_timeout_sec, settings.reporting_entity)\r\n\u001b[?2004l\r"]
[73.002966, "o", "\u001b[?2004h> "]
[73.003091, "o", "    response = client.push(partner, document)\r\n\u001b[?2004l\r\u001b[?2004h"]
[73.003152, "o", "> "]
[73.003239, "o", "    if not 200 <= response.status < 300:\r\n\u001b[?2004l\r"]
[73.003275, "o", "\u001b[?2004h> "]
[73.003635, "o", "        raise GatewayError(f\"partner gateway returned {response.status} for {partner.partner_id}: {response.body}\")\r\n\u001b[?2004l\r"]
[73.00366, "o", "\u001b[?2004h> "]
[73.003748, "o", "    return PartnerFeedResult(\r\n\u001b[?2004l\r"]
[73.003778, "o", "\u001b[?2004h> "]
[73.003913, "o", "        partner.partner_id, period, len(rows),\r\n\u001b[?2004l\r"]
[73.003944, "o", "\u001b[?2004h> "]
[73.004182, "o", "        response.body.get(\"accepted\", len(rows)), response.body.get(\"receipt_id\"),\r\n\u001b[?2004l\r"]
