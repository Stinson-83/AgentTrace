[736.837614, "o", "def test_receipt_only_response(store, settings, partner, client):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[736.83765, "o", "    client.push.return_value = GatewayResponse(202, {\"receipt_id\": \"rc_only\"})\r\n\u001b[?2004l\r\u001b[?2004h>     result = push_partner_feed(store, settings, partner, \"2025-10\", client)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[736.837793, "o", "    assert result.accepted == result.merchants and result.receipt_id == \"rc_only\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_timeout_becomes_gateway_error(store, settings, partner, monkeypatch):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[736.837878, "o", "    import urllib.request\r\n\u001b[?2004l\r\u001b[?2004h> "]
[736.83792, "o", "    def timeout(*args, **kwargs):\r\n\u001b[?2004l\r\u001b[?2004h>         raise TimeoutError(\"timed out\")\r\n\u001b[?2004l\r"]
[736.837941, "o", "\u001b[?2004h> "]
[736.838039, "o", "    monkeypatch.setattr(urllib.request, \"urlopen\", timeout)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[736.838071, "o", "    with pytest.raises(GatewayError, match=\"timed out\"):\r\n\u001b[?2004l\r\u001b[?2004h"]
[736.838086, "o", "> "]
[736.838221, "o", "        push_partner_feed(store, settings, partner, \"2025-10\")\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
