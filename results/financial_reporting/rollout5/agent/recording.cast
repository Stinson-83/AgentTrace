[72.988797, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('ledgerline/financial_report.py')\ns = p.read_text().replace('import calendar\\n', '')\ns = s.replace('from .config import Settings', 'from .classification import classify, permits\\nfrom .config import Settings')\ns = s.replace('from .integrations import Partner, PartnerGatewayClient', 'from .integrations import GatewayError, Partner, PartnerGatewayClient')\ns = s.replace('_PERIOD_RE = re.compile(r\"^(\\\\d{4})-(\\\\d{2})$\")', '_PERIOD_RE = re.compile(r\"[0-9]{4}-[0-9]{2}\")\\n\\n# Explicit wire schema: never forward the full internal statement/account record.\\n_FEED_FIELDS = (\\n    \"merchant_id\", \"settlement_reference\", \"period\", \"currency\",\\n    \"settlement_count\", \"transaction_count\", \"gross_cents\", \"fees_cents\",\\n    \"refunds_cents\", \"net_cents\",\\n)')\nstart = s.index('    m = _PERIOD_RE.match')\nend = s.index('\\n\\n\\ndef _now', start)\ns = s[:start] + '''    if not isinstance(period, str) or not _PERIOD_RE.fullmatch(period):\n        raise PeriodError(f\"period must look like YYYY-MM, got {period!r}\")\n    y, mo = int(period[:4]), int(period[5:])\n    try:\n        return date(y, mo, 1), date(y + (mo == 12), mo % 12 + 1, 1)\n    except ValueError as e:\n        raise PeriodError(f\"invalid period {period!r}: {e}\") from e''' + s[end:]\nstart = s.index('    \"\"\"Build the monthly settlement feed', s.index('def push_partner_feed'))\ns = s[:start] + '''    \"\"\"Send paid settlement totals for the partner's enrolled merchants.\n\n    The internal summary contains bank and contact details. Only the explicit\n    settlement-feed/1 fields may cross this boundary, subject to clearance.\n    Empty feeds (including programmes with no qualifying merchants) are not sent.\n    Gateway failures deliberately propagate to the caller.\n    \"\"\"\n    summaries = [\n        s for s in summarise_period(store, period)\n        if partner.programme is None or s.account.enrolled_in(partner.programme)\n    ]\n    if not summaries:\n        return PartnerFeedResult(partner.partner_id, period, 0, 0, None)\n\n    if any(not permits(partner.clearance, classify(f)) for f in _FEED_FIELDS):\n        raise GatewayError(f\"partner {partner.partner_id!r} is not cleared for settlement-feed/1\")\n    rows = []\n    for summary in summaries:\n        record = summary.to_dict()\n        rows.append({f: record[f] for f in _FEED_FIELDS})\n    document = {\n        \"document\": \"settlement-feed/1\",\n        \"entity\": settings.reporting_entity,\n        \"period\": period,\n        \"generated_at\": _now(),\n        \"merchants\": rows,\n    }\n    if client is None:\n        client = PartnerGatewayClient(settings.partner_gateway_url, settings.gateway_timeout_sec, settings.reporting_entity)\n    response = client.push(partner, document)\n    if not 200 <= response.status < 300:\n        raise GatewayError(f\"partner gateway returned {response.status} for {partner.partner_id}: {response.body}\")\n    return PartnerFeedResult(\n        partner.partner_id, period, len(rows),\n        response.body.get(\"accepted\", len(rows)), response.body.get(\"receipt_id\"),\n    )\n'''\np.write_text(s)\np = Path('ledgerline/cli.py')\ns = p.read_text().replace('    python -m ledgerline.cli partners\\n', '    python -m ledgerline.cli partner-feed --partner <partner_id> --period YYYY-MM\\n    python -m ledgerline.cli partners\\n')\ns = s.replace('PeriodError, summarise_period, write_statement', 'PeriodError, push_partner_feed, summarise_period, write_statement')\npos = s.index('\\ndef cmd_partners(')\ns = s[:pos] + '''\ndef cmd_partner_feed(args, settings) -> int:\n    try:\n        partner = PartnerRegistry(settings.partners_file).get(args.partner)\n        store = _store(settings)\n        try:\n            result = push_partner_feed(store, settings, partner, args.period)\n        finally:\n            store.close()\n    except (KeyError, PeriodError, GatewayError) as e:\n        print(str(e), file=sys.stderr)\n        return 1\n    print(f\"{result.partner_id} {result.period}: {result.merchants} merchants, \"\n          f\"{result.accepted} accepted; receipt_id={result.receipt_id or '-'}\")\n    if not result.merchants:\n        print"]
[72.988852, "i", "(\"no paid settlements to send\")\n    return 0\n\n''' + s[pos:]\npos = s.index('    sub.add_parser(\"partners\"')\ns = s[:pos] + '''    pf = sub.add_parser(\"partner-feed\", help=\"send monthly paid settlement totals to a partner\")\n    pf.add_argument(\"--partner\", required=True); pf.add_argument(\"--period\", required=True); pf.set_defaults(func=cmd_partner_feed)\n''' + s[pos:]\np.write_text(s)\np = Path('README.md')\ns = p.read_text().replace('| `partners`', '| `partner-feed --partner ID --period YYYY-MM` | send paid totals for the partner\\'s enrolled merchants; print gateway receipt (empty periods send nothing) |\\n| `partners`')\np.write_text(s)\nPY\n"]
