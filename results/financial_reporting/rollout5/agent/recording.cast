[712.220289, "o", "def test_feed_schema_paid_totals_and_programme(store, settings, partner, client, monkeypatch):\r\n\u001b[?2004l\r"]
[712.220338, "o", "\u001b[?2004h> "]
[712.220593, "o", "    # A future field added to the internal summary must not leak onto the wire.\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.220651, "o", "> "]
[712.220767, "o", "    original = MerchantSettlementSummary.to_dict\r\n\u001b[?2004l\r"]
[712.220801, "o", "\u001b[?2004h> "]
[712.221262, "o", "    monkeypatch.setattr(MerchantSettlementSummary, \"to_dict\", lambda s: {**original(s), \"future_secret\": \"private\"})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[712.221501, "o", "    result = push_partner_feed(store, settings, partner, \"2025-10\", client)\r\n\u001b[?2004l\r"]
[712.221552, "o", "\u001b[?2004h> "]
[712.221654, "o", "    client.push.assert_called_once()\r\n\u001b[?2004l\r"]
[712.221711, "o", "\u001b[?2004h> "]
[712.221809, "o", "    destination, doc = client.push.call_args.args\r\n\u001b[?2004l\r"]
[712.221854, "o", "\u001b[?2004h> "]
[712.221936, "o", "    assert destination == partner\r\n\u001b[?2004l\r"]
[712.221981, "o", "\u001b[?2004h> "]
[712.222216, "o", "    assert set(doc) == {\"document\", \"entity\", \"period\", \"generated_at\", \"merchants\"}\r\n\u001b[?2004l\r"]
[712.222263, "o", "\u001b[?2004h> "]
[712.222389, "o", "    assert doc[\"document\"] == \"settlement-feed/1\"\r\n\u001b[?2004l\r"]
[712.222436, "o", "\u001b[?2004h> "]
[712.222603, "o", "    assert doc[\"entity\"] == settings.reporting_entity\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.222652, "o", "> "]
[712.22273, "o", "    assert doc[\"period\"] == \"2025-10\"\r\n\u001b[?2004l\r"]
[712.222778, "o", "\u001b[?2004h> "]
[712.223089, "o", "    assert datetime.fromisoformat(doc[\"generated_at\"].replace(\"Z\", \"+00:00\")).utcoffset().total_seconds() == 0\r\n\u001b[?2004l\r"]
[712.223162, "o", "\u001b[?2004h> "]
[712.223412, "o", "    summaries = [s for s in summarise_period(store, \"2025-10\") if s.account.enrolled_in(\"benchmarking\")]\r\n\u001b[?2004l\r"]
[712.22346, "o", "\u001b[?2004h> "]
[712.223681, "o", "    assert doc[\"merchants\"] == [{k: s.to_dict()[k] for k in FEED_FIELDS} for s in summaries]\r\n\u001b[?2004l\r"]
[712.223723, "o", "\u001b[?2004h> "]
[712.223895, "o", "    assert len({r[\"merchant_id\"] for r in doc[\"merchants\"]}) == len(summaries)\r\n\u001b[?2004l\r"]
[712.223936, "o", "\u001b[?2004h> "]
[712.224169, "o", "    assert result == PartnerFeedResult(partner.partner_id, \"2025-10\", len(summaries), 3, \"rc_test\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.224213, "o", "> "]
[712.224269, "o", "    for row in doc[\"merchants\"]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.224311, "o", "> "]
[712.224388, "o", "        assert set(row) == FEED_FIELDS\r\n\u001b[?2004l\r"]
[712.224551, "o", "\u001b[?2004h> "]
[712.224605, "o", "        assert all(permits(partner.clearance, classify(k)) for k in row)\r\n\u001b[?2004l\r"]
[712.224645, "o", "\u001b[?2004h> "]
[712.22496, "o", "        paid = [s for s in store.settlements_between(*period_bounds(\"2025-10\"), merchant_id=row[\"merchant_id\"]) if s.status == \"paid\"]\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.225007, "o", "> "]
[712.225135, "o", "        assert row[\"settlement_count\"] == len(paid)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[712.225382, "o", "        for field in (\"gross_cents\", \"fees_cents\", \"refunds_cents\", \"net_cents\", \"transaction_count\"):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[712.225523, "o", "            assert row[field] == sum(getattr(s, field) for s in paid)\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.225561, "o", "> \r\n\u001b[?2004l\rt\u001b[?2004h> \r\n\u001b[?2004l\r.\u001b[?2004h"]
[712.225597, "o", "> "]
[712.225728, "o", "def test_feed_uses_current_enrolment(store, settings, partner, client):\r\n\u001b[?2004l\r"]
[712.225764, "o", "\u001b[?2004h> "]
[712.225837, "o", "    store.set_programmes(\"mch_0401\", [])\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.225873, "o", "> "]
[712.22597, "o", "    store.set_programmes(\"mch_0406\", [\"benchmarking\"])\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.226019, "o", "> "]
[712.226143, "o", "    push_partner_feed(store, settings, partner, \"2025-10\", client)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[712.226318, "o", "    ids = {r[\"merchant_id\"] for r in client.push.call_args.args[1][\"merchants\"]}\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.226356, "o", "> "]
[712.226445, "o", "    assert \"mch_0401\" not in ids and \"mch_0406\" in ids\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.226483, "o", "> \r\n\u001b[?2004l\re\u001b[?2004h> \r\n\u001b[?2004l\rr\u001b[?2004h"]
[712.226518, "o", "> "]
[712.226641, "o", "def test_partner_without_programme(store, settings, partner, client):\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.22668, "o", "> "]
[712.226759, "o", "    partner = replace(partner, programme=None)\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.226794, "o", "> "]
[712.22694, "o", "    result = push_partner_feed(store, settings, partner, \"2025-10\", client)\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.226976, "o", "> "]
[712.227115, "o", "    assert result.merchants == len(summarise_period(store, \"2025-10\"))\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.227153, "o", "> "]
[712.227317, "o", "    assert all(set(r) == FEED_FIELDS for r in client.push.call_args.args[1][\"merchants\"])\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.227354, "o", "> \r\n\u001b[?2004l\r \u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h"]
[712.227391, "o", "> "]
[712.227592, "o", "@pytest.mark.parametrize(\"period,programme\", [(\"2024-01\", \"benchmarking\"), (\"2025-10\", \"not-enrolled\")])\r\n\u001b[?2004l\r"]
[712.227627, "o", "\u001b[?2004h> "]
[712.227786, "o", "def test_empty_feed_does_not_push(store, settings, partner, client, period, programme):\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.227815, "o", "> "]
[712.22797, "o", "    result = push_partner_feed(store, settings, replace(partner, programme=programme), period, client)\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.227998, "o", "> "]
[712.228114, "o", "    assert result == PartnerFeedResult(partner.partner_id, period, 0, 0, None)\r\n\u001b[?2004l\r"]
[712.228143, "o", "\u001b[?2004h> "]
[712.228188, "o", "    client.push.assert_not_called()\r\n\u001b[?2004l\r"]
[712.228215, "o", "\u001b[?2004h> \r\n\u001b[?2004l\ra\u001b[?2004h> \r\n\u001b[?2004l\rd"]
[712.228243, "o", "\u001b[?2004h> "]
[712.228362, "o", "def test_pending_and_reversed_only_does_not_push(store, settings, partner, client):\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.22839, "o", "> "]
[712.228417, "o", "    with store._conn:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[712.22857, "o", "        store._conn.execute(\"UPDATE settlements SET status='pending' WHERE status='paid'\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.228599, "o", "> "]
[712.228652, "o", "    assert store.counts()[\"settlements\"] > 0\r\n\u001b[?2004l\r"]
[712.22868, "o", "\u001b[?2004h> "]
[712.228808, "o", "    assert push_partner_feed(store, settings, partner, \"2025-10\", client).merchants == 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.228836, "o", "> "]
[712.228879, "o", "    client.push.assert_not_called()\r\n\u001b[?2004l\r"]
[712.228907, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r "]
[712.228935, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r "]
[712.228963, "o", "\u001b[?2004h> "]
[712.229154, "o", "@pytest.mark.parametrize(\"period\", [\"2025-00\", \"2025-13\", \"2025-1\", \"25-10\", \"\", \"2025-10\\n\", \"0000-10\", \"9999-12\", \"nonsense\"])\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.229187, "o", "> "]
[712.229257, "o", "def test_feed_invalid_period(store, settings, partner, client, period):\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.229283, "o", "> "]
[712.229331, "o", "    with pytest.raises(PeriodError):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[712.22943, "o", "        push_partner_feed(store, settings, partner, period, client)\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.229457, "o", "> "]
[712.229504, "o", "    client.push.assert_not_called()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[712.229532, "o", "a\u001b[?2004h> \r\n\u001b[?2004l\rc\u001b[?2004h> "]
[712.22963, "o", "def test_gateway_error_propagates(store, settings, partner, client):\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.229656, "o", "> "]
[712.229695, "o", "    error = GatewayError(\"gateway unavailable\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.229721, "o", "> "]
[712.229746, "o", "    client.push.side_effect = error\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.229772, "o", "> "]
[712.229804, "o", "    with pytest.raises(GatewayError) as exc:\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.22983, "o", "> "]
[712.229893, "o", "        push_partner_feed(store, settings, partner, \"2025-10\", client)\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.229918, "o", "> "]
[712.229944, "o", "    assert exc.value is error\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[712.229974, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[712.230037, "o", "def test_rejected_response(store, settings, partner, client):\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.230063, "o", "> "]
[712.230133, "o", "    client.push.return_value = GatewayResponse(422, {\"error\": \"rejected\"})\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.230159, "o", "> "]
[712.230199, "o", "    with pytest.raises(GatewayError, match=\"422\"):\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.230225, "o", "> "]
[712.230288, "o", "        push_partner_feed(store, settings, partner, \"2025-10\", client)\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.230314, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[712.230406, "o", "def test_clearance_is_enforced_before_push(store, settings, partner, client):\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.230434, "o", "> "]
[712.23048, "o", "    with pytest.raises(GatewayError, match=\"not cleared\"):\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.230506, "o", "> "]
[712.230605, "o", "        push_partner_feed(store, settings, replace(partner, clearance=\"public\"), \"2025-10\", client)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[712.230654, "o", "    client.push.assert_not_called()\r\n\u001b[?2004l\r"]
[712.230684, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[712.230712, "o", "@pytest.fixture()\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.230747, "o", "> def gateway(tmp_path):\r\n\u001b[?2004l\r"]
[712.230778, "o", "\u001b[?2004h> "]
[712.230804, "o", "    state = tmp_path / \"gateway\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[712.230831, "o", "    state.mkdir()\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.230857, "o", "> "]
[712.230884, "o", "    class TestHandler(Handler):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[712.230917, "o", "        state_dir = state\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.230944, "o", "> "]
[712.230999, "o", "    server = ThreadingHTTPServer((\"127.0.0.1\", 0), TestHandler)\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.231034, "o", "> "]
[712.231089, "o", "    thread = threading.Thread(target=server.serve_forever, daemon=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.231121, "o", ">     thread.start()\r\n\u001b[?2004l\r"]
[712.231147, "o", "\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[712.231223, "o", "        yield f\"http://127.0.0.1:{server.server_port}\", state\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.231252, "o", ">     finally:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[712.231288, "o", "        server.shutdown()\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.231316, "o", "> "]
[712.231342, "o", "        server.server_close()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[712.231367, "o", "        thread.join()\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.231394, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[712.231421, "o", "> "]
[712.231503, "o", "def test_cli_delivers_through_default_client(store, settings, gateway, monkeypatch, capsys):\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.231531, "o", "> "]
[712.231557, "o", "    url, state = gateway\r\n\u001b[?2004l\r\u001b[?2004h> "]
[712.23166, "o", "    monkeypatch.setattr(cli, \"load_settings\", lambda: replace(settings, partner_gateway_url=url))\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.231687, "o", "> "]
[712.231779, "o", "    assert cli.main([\"partner-feed\", \"--partner\", \"tally_insights\", \"--period\", \"2025-10\"]) == 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.231806, "o", "> "]
[712.231836, "o", "    out = capsys.readouterr().out\r\n\u001b[?2004l\r"]
[712.231862, "o", "\u001b[?2004h> "]
[712.231927, "o", "    assert \"tally_insights 2025-10\" in out and \"accepted; receipt_id=rc_\" in out\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.231953, "o", "> "]
[712.23202, "o", "    records = list((state / \"received\" / \"tally-insights\").glob(\"*.json\"))\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.232047, "o", "> "]
[712.232073, "o", "    assert len(records) == 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[712.232131, "o", "    record = json.loads(records[0].read_text())\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.232157, "o", "> "]
[712.232229, "o", "    assert record[\"path\"] == \"/partners/tally-insights/v1/settlement-feeds\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[712.232321, "o", "    assert record[\"headers\"][\"x-reporting-entity\"] == settings.reporting_entity\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.232347, "o", "> "]
[712.232403, "o", "    assert record[\"headers\"][\"x-partner-id\"] == \"tally_insights\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.232429, "o", "> "]
[712.232479, "o", "    doc = json.loads(base64.b64decode(record[\"body_b64\"]))\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.232505, "o", "> "]
[712.23256, "o", "    assert all(set(r) == FEED_FIELDS for r in doc[\"merchants\"])\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.232586, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[712.232655, "o", "@pytest.mark.parametrize(\"partner_id,period,message\", [\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.232681, "o", "> "]
[712.232717, "o", "    (\"nobody\", \"2025-10\", \"unknown partner\"),\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.232743, "o", "> "]
[712.232785, "o", "    (\"tally_insights\", \"2025-13\", \"invalid period\"),\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.232811, "o", "> "]
[712.232857, "o", "    (\"tally_insights\", \"bad\", \"period must look like\"),\r\n\u001b[?2004l\r"]
[712.232892, "o", "\u001b[?2004h> ])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[712.232989, "o", "def test_cli_input_errors(store, settings, monkeypatch, capsys, partner_id, period, message):\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.233016, "o", "> "]
[712.23307, "o", "    monkeypatch.setattr(cli, \"load_settings\", lambda: settings)\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.233099, "o", "> "]
[712.233179, "o", "    assert cli.main([\"partner-feed\", \"--partner\", partner_id, \"--period\", period]) != 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.233205, "o", "> "]
[712.233241, "o", "    assert message in capsys.readouterr().err\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.233267, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[712.233345, "o", "def test_cli_empty_period(store, settings, monkeypatch, capsys):\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.233374, "o", "> "]
[712.233426, "o", "    monkeypatch.setattr(cli, \"load_settings\", lambda: settings)\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.233453, "o", "> "]
[712.233542, "o", "    assert cli.main([\"partner-feed\", \"--partner\", \"tally_insights\", \"--period\", \"2024-01\"]) == 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.233568, "o", "> "]
[712.233623, "o", "    assert \"0 merchants, 0 accepted\" in capsys.readouterr().out\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.233649, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[712.233743, "o", "def test_cli_gateway_rejection(store, settings, gateway, monkeypatch, capsys):\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.23377, "o", ">     url, _ = gateway\r\n\u001b[?2004l\r"]
[712.233798, "o", "\u001b[?2004h> "]
[712.233857, "o", "    registry = json.loads(settings.partners_file.read_text())\r\n\u001b[?2004l\r\u001b[?2004h"]
[712.233888, "o", "> "]
