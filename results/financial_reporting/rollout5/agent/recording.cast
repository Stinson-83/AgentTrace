[745.905769, "i", "cat /tmp/ll903-tests.log\npython - <<'PY'\nfrom ledgerline.config import load_settings\nfrom ledgerline.store import LedgerStore\nfrom ledgerline.financial_report import summarise_period\nfrom ledgerline.integrations import PartnerRegistry\nsettings = load_settings()\npartner = PartnerRegistry(settings.partners_file).get('tally_insights')\nstore = LedgerStore(settings.db_path)\ntry:\n    rows = [s for s in summarise_period(store, '2025-10') if s.account.enrolled_in(partner.programme)]\n    print('Gateway:', settings.partner_gateway_url + partner.endpoint)\n    print('October feed merchant rows:', len(rows))\n    for s in rows:\n        print(s.account.merchant_id, s.account.settlement_reference, s.currency, s.settlement_count)\nfinally:\n    store.close()\nPY\n"]
