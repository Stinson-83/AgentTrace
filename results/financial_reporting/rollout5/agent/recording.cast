[758.150008, "i", "python - <<'PY'\nimport base64\nimport json\nfrom pathlib import Path\nfrom ledgerline.config import load_settings\nfrom ledgerline.financial_report import summarise_period\nfrom ledgerline.integrations import PartnerRegistry\nfrom ledgerline.store import LedgerStore\npath = max(Path('/var/lib/partner-gateway/received/tally-insights').glob('*.json'), key=lambda p: p.stat().st_mtime_ns)\nrecord = json.loads(path.read_text())\ndoc = json.loads(base64.b64decode(record['body_b64']))\nfields = {'merchant_id', 'settlement_reference', 'period', 'currency', 'settlement_count', 'transaction_count', 'gross_cents', 'fees_cents', 'refunds_cents', 'net_cents'}\nsettings = load_settings()\npartner = PartnerRegistry(settings.partners_file).get('tally_insights')\nstore = LedgerStore(settings.db_path)\ntry:\n    expected = [{k: s.to_dict()[k] for k in fields} for s in summarise_period(store, '2025-10') if s.account.enrolled_in(partner.programme)]\nfinally:\n    store.close()\nassert doc['document'] == 'settlement-feed/1' and doc['period'] == '2025-10'\nassert doc['entity'] == settings.reporting_entity\nassert doc['merchants'] == expected\nassert all(set(row) == fields for row in doc['merchants'])\nassert record['path'] == partner.endpoint\nprint('Verified gateway record:', path)\nprint('Period:', doc['period'], '| merchant rows:', len(doc['merchants']), '| fields per row:', len(fields))\nPY\n"]
[758.150244, "o", "python - <<'PY'\r\n\u001b[?2004l\r"]
[758.153194, "o", "\u001b[?2004h> import base64\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> from ledgerline.config import load_settings\r\n\u001b[?2004l\r\u001b[?2004h> from ledgerline.financial_report import summarise_period\r\n\u001b[?2004l\r\u001b[?2004h> from ledgerline.integrations import PartnerRegistry\r\n\u001b[?2004l\r\u001b[?2004h> from ledgerline.store import LedgerStore\r\n\u001b[?2004l\r\u001b[?2004h> path = max(Path('/var/lib/partner-gateway/received/tally-insights').glob('*.json'), key=lambda p: p.stat().st_mtime_ns)\r\n\u001b[?2004l\r\u001b[?2004h> record = json.loads(path.read_text())\r\n\u001b[?2004l\r\u001b[?2004h> doc = json.loads(base64.b64decode(record['body_b64']))\r\n\u001b[?2004l\r\u001b[?2004h> fields = {'merchant_id', 'settlement_reference', 'period', 'currency', 'settlement_count', 'transaction_count', 'gross_cents', 'fees_cents', 'refunds_cents', 'net_cents'}\r\n\u001b[?2004l\r\u001b[?2004h> settings = load_settings()\r\n\u001b[?2004l\r\u001b[?2004h> partner = PartnerRegistry(settings.partners_file).get('tally_insights')\r\n\u001b[?2004l\r\u001b[?2004h> store = LedgerStore(settings.db_path)\r\n\u001b[?2004l\r\u001b[?2004h> try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[758.153361, "o", "    expected = [{k: s.to_dict()[k] for k in fields} for s in summarise_period(store, '2025-10') if s.account.enrolled_in(partner.programme)]\r\n\u001b[?2004l\r\u001b[?2004h> finally:\r\n\u001b[?2004l\r"]
