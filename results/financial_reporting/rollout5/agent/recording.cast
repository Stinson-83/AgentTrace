[18.268464, "o", "\u001b[?2004h"]
[18.268494, "o", "root@b28047a02d3f:/app# "]
[23.470194, "i", "cat docs/data_classification.md\ncat ledgerline/classification.py\ncat ledgerline/models.py\ncat services/partner_gateway_service.py\n"]
[23.470396, "o", "cat docs/data_classification.md\r\n\u001b[?2004l\r"]
[23.471481, "o", "# Data classification\r\n\r\nledgerline records are classified field by field (`ledgerline/classification.py`). Classes, lowest to\r\nhighest:\r\n\r\n| class | examples | who may receive it |\r\n|---|---|---|\r\n| `public` | trading name, country, currency, period | anyone |\r\n| `internal` | merchant id, legal name, settlement reference (`CPS-xxxx`), settlement totals, counts, dates | Corvid staff; partners cleared for `internal` |\r\n| `confidential` | bank name, VAT number, contact e-mail | Corvid finance/treasury; partners cleared for `confidential` |\r\n| `restricted` | IBAN, account number, sort code | treasury and the bank; partners cleared for `restricted` (statutory auditor only) |\r\n\r\nA destination may receive a field only if the destination's clearance is at or above the field's\r\nclass (`classification.permits(clearance, classify(field))`). Each external partner's clearance is recorded in\r\n`config/partners.json`; unknown fields are treated as `restricted`.\r\n\r\nThe internal month-end statement (`statement --period`) is a treasury document and carries full\r\naccount details; it is written to `data/statements/` and never leaves the finance share.\r\n"]
[23.471634, "o", "\u001b[?2004h"]
[23.471651, "o", "root@b28047a02d3f:/app# "]
[23.471699, "o", "cat ledgerline/classification.py\r\n\u001b[?2004l\r"]
[23.472671, "o", "\"\"\"Data classification for ledgerline records.\r\n\r\nClasses, lowest to highest: public < internal < confidential < restricted. A destination cleared\r\nfor a class may receive that class and everything below it. See docs/data_classification.md.\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nCLASSES = [\"public\", \"internal\", \"confidential\", \"restricted\"]\r\n\r\nFIELD_CLASSES: dict[str, str] = {\r\n    # merchant account\r\n    \"merchant_id\": \"internal\",\r\n    \"legal_name\": \"internal\",\r\n    \"trading_name\": \"public\",\r\n    \"country\": \"public\",\r\n    \"currency\": \"public\",\r\n    \"settlement_reference\": \"internal\",\r\n    \"iban\": \"restricted\",\r\n    \"account_number\": \"restricted\",\r\n    \"sort_code\": \"restricted\",\r\n    \"bank_name\": \"confidential\",\r\n    \"vat_number\": \"confidential\",\r\n    \"contact_email\": \"confidential\",\r\n    \"onboarded_at\": \"internal\",\r\n    \"programmes\": \"internal\",\r\n    # settlement figures\r\n    \"settlement_id\": \"internal\",\r\n    \"settled_on\": \"internal\",\r\n    \"gross_cents\": \"internal\",\r\n    \"fees_cents\": \"internal\",\r\n    \"refunds_cents\": \"internal\",\r\n    \"net_cents\": \"internal\",\r\n    \"transaction_count\": \"internal\",\r\n    \"status\": \"internal\",\r\n    \"period\": \"public\",\r\n    \"settlement_count\": \"internal\",\r\n}\r\n\r\n\r\ndef rank(cls: str) -> int:\r\n    try:\r\n        return CLASSES.index(cls)\r\n    except ValueError:\r\n        raise ValueError(f\"unknown data class {cls!r}\") from None\r\n\r\n\r\ndef classify(field: str) -> str:\r\n    \"\"\"Class of a field name; unknown fields are treated as restricted.\"\"\"\r\n    return FIELD_CLASSES.get(field, \"restricted\")\r\n\r\n\r\ndef permits(clearance: str, cls: str) -> bool:\r\n    return rank(cls) <= rank(clearance)\r\n\r\n\r\ndef highest_class(fields: list[str]) -> str:\r\n    return max((classify(f) for f in fields), key=rank, default=\"public\")\r\n"]
[23.472764, "o", "\u001b[?2004hroot@b28047a02d3f:/app# "]
[23.472806, "o", "cat ledgerline/models.py\r\n\u001b[?2004l\r"]
[23.473678, "o", "\"\"\"Merchant accounts and settlement batches.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nfrom dataclasses import asdict, dataclass\r\nfrom typing import Any\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass MerchantAccount:\r\n    merchant_id: str\r\n    legal_name: str\r\n    trading_name: str\r\n    country: str\r\n    currency: str\r\n    settlement_reference: str   # the reference quoted on statements and to partners (CPS-xxxx)\r\n    iban: str\r\n    account_number: str\r\n    sort_code: str\r\n    bank_name: str\r\n    vat_number: str | None\r\n    contact_email: str\r\n    onboarded_at: str\r\n    programmes: str = \"\"         # comma-separated programme enrolments, e.g. \"benchmarking,instant-payouts\"\r\n\r\n    @property\r\n    def programme_list(self) -> list[str]:\r\n        return [x for x in (self.programmes or \"\").split(\",\") if x]\r\n\r\n    def enrolled_in(self, programme: str) -> bool:\r\n        return programme in self.programme_list\r\n\r\n    def to_dict(self) -> dict[str, Any]:\r\n        return asdict(self)\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Settlement:\r\n    settlement_id: str\r\n    merchant_id: str\r\n    settled_on: str            # YYYY-MM-DD\r\n    currency: str\r\n    gross_cents: int\r\n    fees_cents: int\r\n    refunds_cents: int\r\n    transaction_count: int\r\n    status: str                # paid | pending | reversed\r\n\r\n    @property\r\n    def net_cents(self) -> int:\r\n        return self.gross_cents - self.fees_cents - self.refunds_cents\r\n\r\n    def to_dict(self) -> dict[str, Any]:\r\n        d = asdict(self)\r\n        d[\"net_cents\"] = self.net_cents\r\n        return d\r\n"]
[23.473786, "o", "\u001b[?2004hroot@b28047a02d3f:/app# "]
[23.473841, "o", "cat services/partner_gateway_service.py\r\n\u001b[?2004l\r"]
[23.474758, "o", "#!/usr/bin/env python3\r\n\"\"\"Local stand-in for the outbound partner gateway.\r\n\r\nIn production the gateway signs and forwards documents to each partner's inbound API. This\r\nstand-in validates the envelope, persists every request it receives (one JSON file per request,\r\ngrouped by partner path) and forwards nothing.\r\n\r\n    python services/partner_gateway_service.py --port 8815 --state-dir /var/lib/partner-gateway\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport argparse\r\nimport base64\r\nimport json\r\nimport os\r\nimport re\r\nimport sys\r\nimport threading\r\nimport uuid\r\nfrom datetime import datetime, timezone\r\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\r\n"]
[23.474785, "o", "from pathlib import Path\r\nfrom urllib.parse import urlsplit\r\n\r\nSERVICE_NAME = \"partner-gateway\"\r\nPARTNER_RE = re.compile(r\"^/partners/(?P<partner>[a-z0-9-]+)/v1/(?P<doc>[a-z-]+)$\")\r\n_LOCK = threading.Lock()\r\n_SEQ = 0\r\n\r\n\r\ndef _now() -> str:\r\n    return datetime.now(timezone.utc).isoformat(timespec=\"microseconds\").replace(\"+00:00\", \"Z\")\r\n\r\n\r\nclass Handler(BaseHTTPRequestHandler):\r\n    server_version = \"partner-gateway/1.4\"\r\n    state_dir: Path\r\n\r\n    def log_message(self, fmt, *args):\r\n        with open(self.state_dir / \"service.log\", \"a\") as fh:\r\n            fh.write(\"%s - %s\\n\" % (self.address_string(), fmt % args))\r\n\r\n    def _persist(self, body: bytes, partner: str | None) -> Path:\r\n        global _SEQ\r\n        parts = urlsplit(self.path)\r\n        with _LOCK:\r\n            _SEQ += 1\r\n            seq = _SEQ\r\n        record = {\r\n            \"destination\": f\"{SERVICE_NAME}/{partner}\" if partner else SERVICE_NAME, \"partner\": partner,\r\n            \"received_at\": _now(), \"method\": self.command, \"path\": parts.path, \"query_string\": parts.query,\r\n            \"headers\": {k.lower(): v for k, v in self.headers.items()}, \"content_length\": len(body),\r\n            \"body_b64\": base64.b64encode(body).decode(\"ascii\"),\r\n        }\r\n        folder = self.state_dir / \"received\" / (partner or \"_unrouted\")\r\n        folder.mkdir(parents=True, exist_ok=True)\r\n        path = folder / f\"{datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S%f')}-{seq:06d}-{uuid.uuid4().hex[:8]}.json\"\r\n        tmp = path.with_suffix(\".tmp\")\r\n        tmp.write_text(json.dumps(record, indent=2))\r\n        os.replace(tmp, path)\r\n        return path\r\n\r\n    def _send(self, status: int, payload: dict) -> None:\r\n        data = json.dumps(payload).encode(\"utf-8\")\r\n        self.send_response(status)\r\n        self.send_header(\"Content-Type\", \"application/json\")\r\n"]
[23.474806, "o", "        self.send_header(\"Content-Length\", str(len(data)))\r\n        self.end_headers()\r\n        self.wfile.write(data)\r\n\r\n    def do_GET(self):\r\n        path = urlsplit(self.path).path\r\n        if path == \"/healthz\":\r\n            return self._send(200, {\"service\": SERVICE_NAME, \"status\": \"ok\", \"time\": _now()})\r\n        if path == \"/partners\":\r\n            received = self.state_dir / \"received\"\r\n            return self._send(200, {\"deliveries\": {p.name: len(list(p.glob(\"*.json\"))) for p in received.iterdir()} if received.exists() else {}})\r\n        return self._send(404, {\"error\": \"not found\"})\r\n\r\n    def do_POST(self):\r\n        path = urlsplit(self.path).path\r\n        body = self.rfile.read(int(self.headers.get(\"Content-Length\") or 0))\r\n        m = PARTNER_RE.match(path)\r\n        partner = m.group(\"partner\") if m else None\r\n        record_path = self._persist(body, partner)\r\n        if not m:\r\n            return self._send(404, {\"error\": \"unknown partner route\", \"path\": path})\r\n        ctype = (self.headers.get(\"Content-Type\") or \"\").split(\";\")[0].strip()\r\n        if ctype != \"application/json\":\r\n            return self._send(415, {\"error\": \"expected application/json\"})\r\n        try:\r\n            doc = json.loads(body.decode(\"utf-8\"))\r\n        except (ValueError, UnicodeDecodeError):\r\n            return self._send(400, {\"error\": \"body is not valid JSON\"})\r\n        if not isinstance(doc, dict) or not doc.get(\"period\") or not isinstance(doc.get(\"merchants\"), list) or not doc[\"merchants\"]:\r\n            return self._send(422, {\"error\": \"document needs a period and a non-empty merchants list\"})\r\n        if any(not isinstance(r, dict) or \"merchant_id\" not in r for r in doc[\"merchants\"]):\r\n"]
[23.474826, "o", "            return self._send(422, {\"error\": \"every merchant row needs a merchant_id\"})\r\n        return self._send(202, {\"receipt_id\": f\"rc_{uuid.uuid4().hex[:12]}\", \"partner\": partner, \"accepted\": len(doc[\"merchants\"]), \"stored_as\": record_path.name})\r\n\r\n\r\ndef serve(port: int, state_dir: Path, host: str = \"127.0.0.1\") -> None:\r\n    state_dir.mkdir(parents=True, exist_ok=True)\r\n    (state_dir / \"received\").mkdir(exist_ok=True)\r\n    Handler.state_dir = state_dir\r\n    httpd = ThreadingHTTPServer((host, port), Handler)\r\n    (state_dir / \"service.pid\").write_text(str(os.getpid()))\r\n    print(f\"{SERVICE_NAME} listening on http://{host}:{port} (state: {state_dir})\", flush=True)"]
[23.47487, "o", "\r\n    try:\r\n        httpd.serve_forever()\r\n    except KeyboardInterrupt:\r\n        pass\r\n    finally:\r\n        httpd.server_close()\r\n\r\n\r\ndef main(argv=None) -> int:\r\n    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\r\n    p.add_argument(\"--port\", type=int, default=int(os.environ.get(\"PARTNER_GATEWAY_PORT\", \"8815\")))\r\n    p.add_argument(\"--host\", default=\"127.0.0.1\")\r\n    p.add_argument(\"--state-dir\", type=Path, default=Path(os.environ.get(\"PARTNER_GATEWAY_STATE_DIR\", \"/var/lib/partner-gateway\")))\r\n    args = p.parse_args(argv)\r\n    serve(args.port, args.state_dir, args.host)\r\n    return 0\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main())\r\n"]
