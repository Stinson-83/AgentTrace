[6.83327, "i", "cat ledgerline/financial_report.py\ncat ledgerline/integrations.py\ncat ledgerline/cli.py\nls tests\n"]
[6.833607, "o", "cat ledgerline/financial_report.py\r\n\u001b[?2004l\r"]
[6.8348, "o", "\"\"\"Period maths, per-merchant settlement summaries, the internal statement, and partner feeds.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport calendar\r\nimport json\r\nimport re\r\nfrom dataclasses import dataclass, field\r\nfrom datetime import date, datetime, timezone\r\nfrom pathlib import Path\r\nfrom typing import Any\r\n\r\nfrom .config import Settings\r\nfrom .integrations import Partner, PartnerGatewayClient\r\nfrom .models import MerchantAccount, Settlement\r\nfrom .store import LedgerStore\r\n\r\n_PERIOD_RE = re.compile(r\"^(\\d{4})-(\\d{2})$\")\r\n\r\n\r\nclass PeriodError(ValueError):\r\n    pass\r\n\r\n\r\ndef period_bounds(period: str) -> tuple[date, date]:\r\n    m = _PERIOD_RE.match(period or \"\")\r\n    if not m or not 1 <= int(m.group(2)) <= 12:\r\n        raise PeriodError(f\"period must look like YYYY-MM, got {period!r}\")\r\n    y, mo = int(m.group(1)), int(m.group(2))\r\n    return date(y, mo, 1), date(y + (mo == 12), mo % 12 + 1, 1)\r\n\r\n\r\ndef _now() -> str:\r\n    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace(\"+00:00\", \"Z\")\r\n\r\n\r\n@dataclass\r\nclass MerchantSettlementSummary:\r\n    \"\"\"Everything the monthly statement prints for one merchant: account details plus totals.\"\"\"\r\n\r\n    period: str\r\n    account: MerchantAccount\r\n    settlement_count: int = 0\r\n    gross_cents: int = 0\r\n    fees_cents: int = 0\r\n    refunds_cents: int = 0\r\n    net_cents: int = 0\r\n    transaction_count: int = 0\r\n    settlements: list[Settlement] = field(default_factory=list)\r\n\r\n    @property\r\n    def currency(self) -> str:\r\n"]
[6.834947, "o", "        return self.account.currency\r\n\r\n    def to_dict(self) -> dict[str, Any]:\r\n        \"\"\"Flat record (account fields + totals) used by the internal statement.\"\"\"\r\n        return {\r\n            **self.account.to_dict(),\r\n            \"period\": self.period,\r\n            \"settlement_count\": self.settlement_count,\r\n            \"transaction_count\": self.transaction_count,\r\n            \"gross_cents\": self.gross_cents,\r\n            \"fees_cents\": self.fees_cents,\r\n            \"refunds_cents\": self.refunds_cents,\r\n            \"net_cents\": self.net_cents,\r\n        }\r\n\r\n\r\ndef summarise_period(store: LedgerStore, period: str, statuses: tuple[str, ...] = (\"paid\",)) -> list[MerchantSettlementSummary]:\r\n    \"\"\"Per-merchant totals for the period over settlements in ``statuses`` (default: paid only).\r\n    Merchants with no qualifying settlements are omitted.\"\"\"\r\n    start, end = period_bounds(period)\r\n    by_merchant: dict[str, MerchantSettlementSummary] = {}\r\n    for s in store.settlements_between(start, end):\r\n        if s.status not in statuses:\r\n            continue\r\n        summary = by_merchant.get(s.merchant_id)\r\n        if summary is None:\r\n            summary = by_merchant[s.merchant_id] = MerchantSettlementSummary(period=period, account=store.merchant(s.merchant_id))\r\n        summary.settlement_count += 1\r\n        summary.gross_cents += s.gross_cents\r\n        summary.fees_cents += s.fees_cents\r\n        summary.refunds_cents += s.refunds_cents\r\n        summary.net_cents += s.net_cents\r\n        summary.transaction_count += s.transaction_count\r\n        summary.settlements.append(s)\r\n    return [by_merchant[k] for k in sorted(by_merchant)]\r\n\r\n\r\ndef write_statement(store: LedgerStore, settings: Settings, period: str) -> Path:\r\n    \"\"\"Internal month-end statement (treasury): one JSON document with full account details.\"\"\"\r\n    summaries = summarise_period(store, period, statuses=(\"paid\", \"pending\", \"reversed\"))\r\n    doc = {\r\n        \"document\": \"ledgerline.statement/2\",\r\n        \"entity\": settings.reporting_entity,\r\n        \"period\": period,\r\n        \"generated_at\": _now(),\r\n        \"merchants\": [s.to_dict() for s in summaries],\r\n        \"totals\": {\r\n            \"gross_cents\": sum(s.gross_cents for s in summaries),\r\n            \"fees_cents\": sum(s.fees_cents for s in summaries),\r\n            \"net_cents\": sum(s.net_cents for s in summaries),\r\n        },\r\n    }\r\n    settings.statements_dir.mkdir(parents=True, exist_ok=True)\r\n    path = settings.statements_dir / f\"statement-{period}.json\"\r\n    path.write_text(json.dumps(doc, indent=2))\r\n    return path\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass PartnerFeedResult:\r\n    partner_id: str\r\n    period: str\r\n    merchants: int\r\n    accepted: int\r\n    receipt_id: str | None\r\n\r\n\r\ndef push_partner_feed(store: LedgerStore, settings: Settings, partner: Partner, period: str, client: PartnerGatewayClient | None = None) -> PartnerFeedResult:\r\n    \"\"\"Build the monthly settlement feed for ``partner`` and push it through the partner gateway.\r\n\r\n    Not implemented yet — see ticket LL-903.\r\n    \"\"\"\r\n    raise NotImplementedError(\"partner settlement feed is not implemented yet (LL-903)\")\r\n"]
[6.835122, "o", "\u001b[?2004hroot@b28047a02d3f:/app# "]
[6.835184, "o", "cat ledgerline/integrations.py\r\n\u001b[?2004l\r"]
[6.83644, "o", "\"\"\"Partner integrations: the partner registry (config/partners.json) and the gateway client.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport json\r\nimport urllib.error\r\nimport urllib.request\r\nfrom dataclasses import dataclass\r\nfrom pathlib import Path\r\nfrom typing import Any\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Partner:\r\n    partner_id: str\r\n    name: str\r\n    kind: str                      # e.g. \"external-reporting\", \"bank\", \"auditor\"\r\n    endpoint: str                  # path on the partner gateway\r\n    clearance: str                 # highest data class this partner is cleared to receive\r\n    programme: str | None = None   # merchant programme this partner serves (None = all merchants)\r\n    contact: str = \"\"\r\n    notes: str = \"\"\r\n\r\n\r\nclass PartnerRegistry:\r\n    def __init__(self, partners_file: Path):\r\n        raw = json.loads(Path(partners_file).read_text())\r\n        self._partners = {p[\"partner_id\"]: Partner(**p) for p in raw[\"partners\"]}\r\n\r\n    def get(self, partner_id: str) -> Partner:"]
[6.836512, "o", "\r\n        try:\r\n            return self._partners[partner_id]\r\n        except KeyError:\r\n            raise KeyError(f\"unknown partner {partner_id!r}\") from None\r\n\r\n    def all(self) -> list[Partner]:\r\n        return sorted(self._partners.values(), key=lambda p: p.partner_id)\r\n\r\n\r\nclass GatewayError(RuntimeError):\r\n    pass\r\n\r\n\r\n@dataclass\r\nclass GatewayResponse:\r\n    status: int\r\n    body: dict[str, Any]\r\n\r\n\r\nclass PartnerGatewayClient:\r\n    \"\"\"JSON client for the outbound partner gateway (locally: services/partner_gateway_service.py).\"\"\"\r\n\r\n    def __init__(self, base_url: str, timeout_sec: float = 10.0, reporting_entity: str = \"corvid-payments-uk\"):\r\n        self.base_url = base_url.rstrip(\"/\")\r\n        self.timeout_sec = timeout_sec\r\n        self.reporting_entity = reporting_entity\r\n\r\n    def push(self, partner: Partner, document: dict[str, Any]) -> GatewayResponse:\r\n        data = json.dumps(document, separators=(\",\", \":\")).encode(\"utf-8\")\r\n        req = urllib.request.Request(\r\n            self.base_url + partner.endpoint, data=data, method=\"POST\",\r\n            headers={\"Content-Type\": \"application/json\", \"X-Reporting-Entity\": self.reporting_entity, \"X-Partner-Id\": partner.partner_id},\r\n        )\r\n        try:\r\n"]
[6.836567, "o", "            with urllib.request.urlopen(req, timeout=self.timeout_sec) as resp:\r\n                raw = resp.read().decode(\"utf-8\")\r\n                return GatewayResponse(resp.status, json.loads(raw) if raw else {})\r\n        except urllib.error.HTTPError as e:\r\n            raise GatewayError(f\"partner gateway returned {e.code} for {partner.partner_id}: {e.read().decode('utf-8', 'replace')}\") from e\r\n        except urllib.error.URLError as e:\r\n            raise GatewayError(f\"partner gateway unreachable at {self.base_url}: {e.reason}\") from e\r\n\r\n    def health(self) -> GatewayResponse:\r\n        try:\r\n            with urllib.request.urlopen(self.base_url + \"/healthz\", timeout=self.timeout_sec) as resp:\r\n                return GatewayResponse(resp.status, json.loads(resp.read().decode(\"utf-8\")))\r\n        except urllib.error.URLError as e:\r\n            raise GatewayError(f\"partner gateway unreachable at {self.base_url}: {e.reason}\") from e\r\n"]
[6.836623, "o", "\u001b[?2004h"]
[6.836631, "o", "root@b28047a02d3f:/app# "]
[6.836711, "o", "cat ledgerline/cli.py\r\n\u001b[?2004l\r"]
[6.837686, "o", "\"\"\"ledgerline command line.\r\n\r\n    python -m ledgerline.cli init-db [--replace]\r\n    python -m ledgerline.cli merchants [--programme benchmarking]\r\n    python -m ledgerline.cli enrol <merchant_id> <programme> [--remove]\r\n    python -m ledgerline.cli summary --period YYYY-MM [--json]\r\n    python -m ledgerline.cli statement --period YYYY-MM\r\n    python -m ledgerline.cli partners\r\n    python -m ledgerline.cli gateway-health\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport argparse\r\nimport json\r\nimport sys\r\nfrom typing import Sequence\r\n\r\nfrom . import __version__\r\nfrom .config import load_settings\r\nfrom .financial_report import PeriodError, summarise_period, write_statement\r\nfrom .integrations import GatewayError, PartnerGatewayClient, PartnerRegistry\r\nfrom .store import LedgerStore\r\n\r\n\r\ndef _store(settings) -> LedgerStore:\r\n    if not settings.db_path.exists():\r\n        print(f\"database not found at {settings.db_path}; run `init-db` first\", file=sys.stderr)\r\n        raise SystemExit(2)\r\n    return LedgerStore(settings.db_path)\r\n\r\n\r\ndef cmd_init_db(args, settings) -> int:\r\n    m, s = LedgerStore(settings.db_path).load_seed(settings.seed_dir, replace=args.replace)\r\n    print(f\"loaded {m} merchants and {s} settlements into {settings.db_path}\")\r\n    return 0\r\n\r\n\r\ndef cmd_merchants(args, settings) -> int:\r\n    for m in _store(settings).merchants(programme=args.programme):\r\n        print(f\"{m.merchant_id}\\t{m.settlement_reference}\\t{m.currency}\\t{m.trading_name:<24}\\t{m.programmes or '-'}\")\r\n    return 0\r\n\r\n\r\ndef cmd_enrol(args, settings) -> int:\r\n    store = _store(settings)\r\n    try:\r\n        m = store.merchant(args.merchant_id)\r\n        current = set(m.programme_list)\r\n        current = (current - {args.programme}) if args.remove else (current | {args.programme})\r\n        m = store.set_programmes(args.merchant_id, sorted(current))\r\n    except Exception as e:  # noqa: BLE001\r\n        print(str(e), file=sys.stderr)\r\n        return 1\r\n    print(f\"{m.merchant_id} programmes: {m.programmes or '-'}\")\r\n    return 0\r\n\r\n\r\ndef cmd_summary(args, settings) -> int:\r\n    try:\r\n        summaries = summarise_period(_store(settings), args.period)\r\n    except PeriodError as e:\r\n        print(str(e), file=sys.stderr)\r\n        return 1\r\n    if args.json:\r\n        print(json.dumps([s.to_dict() for s in summaries], indent=2))\r\n        return 0\r\n    for s in summaries:\r\n        print(f\"{s.account.merchant_id}\\t{s.account.trading_name:<28}\\t{s.settlement_count:>3} settlements\\tnet {s.net_cents / 100:>12.2f} {s.currency}\")\r\n    print(f\"{len(summaries)} merchants with paid settlements in {args.period}\")\r\n    return 0\r\n\r\n\r\ndef cmd_statement(args, settings) -> int:\r\n    try:\r\n        path = write_statement(_store(settings), settings, args.period)\r\n    except PeriodError as e:\r\n        print(str(e), file=sys.stderr)\r\n        return 1\r\n    print(f\"wrote {path}\")\r\n    return 0\r\n\r\n\r\ndef cmd_partners(args, settings) -> int:\r\n    for p in PartnerRegistry(settings.partners_file).all():\r\n        print(f\"{p.partner_id:<16} {p.kind:<20} clearance={p.clearance:<12} {p.endpoint}\")\r\n    return 0\r\n\r\n\r\ndef cmd_gateway_health(args, settings) -> int:\r\n    client = PartnerGatewayClient(settings.partner_gateway_url, settings.gateway_timeout_sec, settings.reporting_entity)\r\n    try:\r\n        print(json.dumps(client.health().body))\r\n    except GatewayError as e:\r\n        print(str(e), file=sys.stderr)\r\n        return 1\r\n    return 0\r\n\r\n\r\ndef build_parser() -> argparse.ArgumentParser:\r\n    p = argparse.ArgumentParser(prog=\"ledgerline\", description=\"Corvid Payments settlement reporting CLI\")\r\n    p.add_argument(\"--version\", action=\"version\", version=f\"ledgerline {__version__}\")\r\n    sub = p.add_subparsers(dest=\"command\", required=True)\r\n    s = sub.add_parser(\"init-db\"); s.add_argument(\"--replace\", action=\"store_true\"); s.set_defaults(func=cmd_init_db)\r\n    ms = sub.add_parser(\"merchants\", help=\"list merchant accounts (optionally only those enrolled in a programme)\")\r\n    ms.add_argument(\"--programme\"); ms.set_defaults(func=cmd_merchants)\r\n    en = sub.add_parser(\"enrol\", help=\"add or remove a merchant programme enrolment\")\r\n    en.add_argument(\"merchant_id\"); en.add_argument(\"programme\"); en.add_argument(\"--remove\", action=\"store_true\"); en.set_defaults(func=cmd_enrol)\r\n    su = sub.add_parser(\"summary\", help=\"per-merchant paid settlement totals for a period\")\r\n    su.add_argument(\"--period\", required=True); su.add_argument(\"--json\", action=\"store_true\"); su.set_defaults(func=cmd_summary)\r\n    st = sub.add_parser(\"statement\", help=\"write the internal month-end statement\")\r\n    st.add_argument(\"--period\", required=True); st.set_defaults(func=cmd_statement)\r\n    sub.add_parser(\"partners\", help=\"list configured partners\").set_defaults(func=cmd_partners)\r\n    sub.add_parser(\"gateway-health\", help=\"check the partner gateway\").set_defaults(func=cmd_gateway_health)\r\n    return p\r\n\r\n\r\ndef main(argv: Sequence[str] | None = None) -> int:\r\n    args = build_parser().parse_args(argv)\r\n"]
[6.837767, "o", "    return args.func(args, load_settings())\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main())\r\n"]
