[73.004405, "o", "\u001b[?2004h> "]
[73.00448, "o", "p = Path('ledgerline/cli.py')\r\n\u001b[?2004l\r"]
[73.00451, "o", "\u001b[?2004h> "]
[73.005065, "o", "s = p.read_text().replace('    python -m ledgerline.cli partners\\n', '    python -m ledgerline.cli partner-feed --partner <partner_id> --period YYYY-MM\\n    python -m ledgerline.cli partners\\n')\r\n\u001b[?2004l\r\u001b[?2004h"]
[73.005082, "o", "> "]
[73.00545, "o", "s = s.replace('PeriodError, summarise_period, write_statement', 'PeriodError, push_partner_feed, summarise_period, write_statement')\r\n\u001b[?2004l\r"]
[73.005522, "o", "\u001b[?2004h> "]
[73.005595, "o", "pos = s.index('\\ndef cmd_partners(')\r\n"]
[73.005615, "o", "\u001b[?2004l\r"]
[73.005635, "o", "\u001b[?2004h> "]
[73.005688, "o", "s = s[:pos] + '''\r\n\u001b[?2004l\r"]
[73.005718, "o", "\u001b[?2004h> "]
[73.005849, "o", "def cmd_partner_feed(args, settings) -> int:\r\n\u001b[?2004l\r"]
[73.005894, "o", "\u001b[?2004h> "]
[73.005932, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[73.005964, "o", "> "]
[73.006169, "o", "        partner = PartnerRegistry(settings.partners_file).get(args.partner)\r\n\u001b[?2004l\r"]
[73.006218, "o", "\u001b[?2004h> "]
[73.006308, "o", "        store = _store(settings)\r\n\u001b[?2004l\r"]
[73.006344, "o", "\u001b[?2004h> "]
[73.006374, "o", "        try:\r\n\u001b[?2004l\r"]
[73.006405, "o", "\u001b[?2004h> "]
[73.006631, "o", "            result = push_partner_feed(store, settings, partner, args.period)\r\n\u001b[?2004l\r"]
[73.006663, "o", "\u001b[?2004h> "]
[73.006704, "o", "        finally:\r\n\u001b[?2004l\r"]
[73.006732, "o", "\u001b[?2004h> "]
[73.006802, "o", "            store.close()\r\n\u001b[?2004l\r"]
[73.006831, "o", "\u001b[?2004h> "]
[73.006975, "o", "    except (KeyError, PeriodError, GatewayError) as e:\r\n\u001b[?2004l\r"]
[73.007005, "o", "\u001b[?2004h> "]
[73.00711, "o", "        print(str(e), file=sys.stderr)\r\n\u001b[?2004l\r"]
[73.007139, "o", "\u001b[?2004h> "]
[73.007184, "o", "        return 1\r\n\u001b[?2004l\r"]
[73.007216, "o", "\u001b[?2004h"]
[73.007245, "o", "> "]
[73.007431, "o", "    print(f\"{result.partner_id} {result.period}: {result.merchants} merchants, \"\r\n\u001b[?2004l\r"]
[73.007461, "o", "\u001b[?2004h> "]
[73.00767, "o", "          f\"{result.accepted} accepted; receipt_id={result.receipt_id or '-'}\")\r\n\u001b[?2004l\r"]
[73.007698, "o", "\u001b[?2004h> "]
[73.007776, "o", "    if not result.merchants:\r\n\u001b[?2004l\r"]
[73.007804, "o", "\u001b[?2004h> "]
[73.007923, "o", "        print(\"no paid settlements to send\")\r\n\u001b[?2004l\r"]
[73.007951, "o", "\u001b[?2004h> "]
[73.007984, "o", "    return 0\r\n\u001b[?2004l\r"]
[73.008012, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[73.00804, "o", "\u001b[?2004h> "]
[73.008083, "o", "''' + s[pos:]\r\n\u001b[?2004l\r"]
[73.008115, "o", "\u001b[?2004h> "]
[73.008248, "o", "pos = s.index('    sub.add_parser(\"partners\"')\r\n\u001b[?2004l\r"]
[73.008284, "o", "\u001b[?2004h> "]
[73.008564, "o", "s = s[:pos] + '''    pf = sub.add_parser(\"partner-feed\", help=\"send monthly paid settlement totals to a partner\")\r\n\u001b[?2004l\r"]
[73.008597, "o", "\u001b[?2004h> "]
[73.008932, "o", "    pf.add_argument(\"--partner\", required=True); pf.add_argument(\"--period\", required=True); pf.set_defaults(func=cmd_partner_feed)\r\n\u001b[?2004l\r"]
[73.008951, "o", "\u001b[?2004h> "]
[73.008998, "o", "''' + s[pos:]\r\n\u001b[?2004l\r"]
[73.009028, "o", "\u001b[?2004h> "]
[73.009072, "o", "p.write_text(s)\r\n\u001b[?2004l\r"]
[73.009109, "o", "\u001b[?2004h> "]
