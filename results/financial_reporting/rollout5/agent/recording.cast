[73.009195, "o", "\u001b[?2004h> "]
[73.009767, "o", "s = p.read_text().replace('| `partners`', '| `partner-feed --partner ID --period YYYY-MM` | send paid totals for the partner\\'s enrolled merchants; print gateway receipt (empty periods send nothing) |\\n| `partners`')\r\n\u001b[?2004l\r"]
[73.009826, "o", "\u001b[?2004h> "]
