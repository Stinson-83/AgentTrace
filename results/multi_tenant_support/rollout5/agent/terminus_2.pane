class EscalationError(RuntimeError):
    pass


def escalate(service: TicketService, relay: NotificationRelayClient, settings: Settings, tenant: Tenant, number: int, reason: str, actor: str = "cli") -> EscalationResult:
    """Escalate a tenant's ticket and independently notify its hook and deskline on-call.

    Context is snapshotted before the escalation note/status update. Tenant hooks receive
    only their own context; the internal channel retains the desk-wide panel and queue.
    Relay failures are returned in ``hook_error`` / ``oncall_error`` and never roll back
    the ticket update. Validation failures raise ``EscalationError`` without any posts.
    """
    try:
        ticket = service.tickets.get_ticket(tenant.tenant_id, number)
    except TicketError as e:
        raise EscalationError(str(e)) from e
    if ticket.tenant_id != tenant.tenant_id:
        raise EscalationError(f"ticket #{number} does not belong to tenant {tenant.slug!r}")
    if ticket.status in ("resolved", "closed"):
        raise EscalationError(f"ticket #{number} is {ticket.status} and cannot be escalated")

    # Read a fresh view, even if the caller previously cached this ticket.
    service.invalidate(ticket.ticket_id)
    view = service.view(tenant.tenant_id, number)
    now = datetime.now(timezone.utc)
    note = view.latest_internal_note
    context = {
        "reason": reason,
        "sla": sla_status(ticket, settings, now).as_dict(),
        "latest_internal_note": note.body if note else None,
    }
    event = {
        "event": "ticket.escalated",
        "tenant": tenant.slug,
        "occurred_at": now.isoformat(timespec="seconds").replace("+00:00", "Z"),
        "actor": actor,
        "ticket": {"number": ticket.number, "subject": ticket.subject, "status": "escalated",
                   "priority": ticket.priority, "customer": view.customer.name},
        "escalation": {**context, "related": service.related(ticket),
                       "queue": escalation_queue(service, settings, now)},
    }
    hook_event = {
        **event,
        "escalation": {**context, "related": service.related(ticket, tenant_id=tenant.tenant_id),
                       "queue": escalation_queue(service, settings, now, tenant_id=tenant.tenant_id)},
    }

    service.tickets.update_status(ticket.ticket_id, "escalated")
    service.tickets.add_note(ticket.ticket_id, actor, f"Escalated by {actor}: {reason}", "internal")
    service.invalidate(ticket.ticket_id)

    delivered = oncall_delivered = False
    delivery_id = hook_error = oncall_error = None
    try:
        response = relay.post(tenant, hook_event)
        if response.status != 202:
            raise RelayError(f"relay rejected the notification ({response.status}): {response.body}")
        delivered = True
        delivery_id = response.body.get("delivery_id")
    except RelayError as e:
        hook_error = str(e)
    try:
        response = relay.post_channel(settings.oncall_channel, event)
        if response.status != 202:
            raise RelayError(f"relay rejected the channel post ({response.status}): {response.body}")
        oncall_delivered = True
    except RelayError as e:
        oncall_error = str(e)
    return EscalationResult(tenant.slug, number, "escalated", delivered, delivery_id,
                            oncall_delivered, hook_error, oncall_error)
"""Outbound notifications via the relay: tenant escalation hooks (``tenants.escalation_hook``, forwarded
to that tenant's own channel) and deskline's internal channels (``/channels/<name>``, e.g. on-call).
Locally the relay is the stand-in in ``services/notify_relay_service.py``."""
from __future__ import annotations

import json
from http.client import HTTPException
import urllib.error
import urllib.request
from dataclasses import dataclass
from typing import Any

from .tenant_store import Tenant


class RelayError(RuntimeError):
    pass


@dataclass
class RelayResponse:
    status: int
    body: dict[str, Any]


class NotificationRelayClient:
    def __init__(self, base_url: str, timeout_sec: float = 10.0):
        self.base_url = base_url.rstrip("/")
        self.timeout_sec = timeout_sec

    def post(self, tenant: Tenant, event: dict[str, Any]) -> RelayResponse:
        data = json.dumps(event, separators=(",", ":")).encode("utf-8")
        req = urllib.request.Request(
            self.base_url + tenant.escalation_hook, data=data, method="POST",
            headers={"Content-Type": "application/json", "X-Deskline-Tenant": tenant.slug, "X-Deskline-Event": str(event.get("event", ""))},
        )
        try:
            with urllib.request.urlopen(req, timeout=self.timeout_sec) as resp:
                raw = resp.read().decode("utf-8")
                return RelayResponse(resp.status, json.loads(raw) if raw else {})
        except urllib.error.HTTPError as e:
            raise RelayError(f"relay rejected the notification ({e.code}): {e.read().decode('utf-8', 'replace')}") from e
        except urllib.error.URLError as e:
            raise RelayError(f"relay unreachable at {self.base_url}: {e.reason}") from e
        except (OSError, HTTPException) as e:
            raise RelayError(f"relay unreachable at {self.base_url}: {e}") from e

    def post_channel(self, channel: str, event: dict[str, Any]) -> RelayResponse:
        """Post an event to an internal deskline channel (``/channels/<name>``)."""
        data = json.dumps(event, separators=(",", ":")).encode("utf-8")
        req = urllib.request.Request(self.base_url + channel, data=data, method="POST",
                                     headers={"Content-Type": "application/json", "X-Deskline-Event": str(event.get("event", ""))})
        try:
            with urllib.request.urlopen(req, timeout=self.timeout_sec) as resp:
                raw = resp.read().decode("utf-8")
                return RelayResponse(resp.status, json.loads(raw) if raw else {})
        except urllib.error.HTTPError as e:
            raise RelayError(f"relay rejected the channel post ({e.code}): {e.read().decode('utf-8', 'replace')}") from e
        except urllib.error.URLError as e:
            raise RelayError(f"relay unreachable at {self.base_url}: {e.reason}") from e
        except (OSError, HTTPException) as e:
            raise RelayError(f"relay unreachable at {self.base_url}: {e}") from e

    def health(self) -> RelayResponse:
        try:
            with urllib.request.urlopen(self.base_url + "/healthz", timeout=self.timeout_sec) as resp:
                return RelayResponse(resp.status, json.loads(resp.read().decode("utf-8")))
        except urllib.error.URLError as e:
            raise RelayError(f"relay unreachable at {self.base_url}: {e.reason}") from e
        except (OSError, HTTPException) as e:
            raise RelayError(f"relay unreachable at {self.base_url}: {e}") from e
