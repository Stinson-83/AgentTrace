[167.723455, "o", "\u001b[?2004h> "]
[167.723816, "o", "def test_relay_request(db, monkeypatch, destination):\r\n\u001b[?2004l\r\u001b[?2004h>     _, tenants, _ = db\r\n\u001b[?2004l\r\u001b[?2004h>     tenant = tenants.by_slug(\"northwind\")\r\n\u001b[?2004l\r\u001b[?2004h>     event = {\"event\": \"ticket.escalated\", \"ticket\": {\"number\": 1042}}\r\n\u001b[?2004l\r\u001b[?2004h>     response = MagicMock()\r\n\u001b[?2004l\rnt hooks must not disclose other\r\ntenants' data (see `tenancy.md`): th"]
[167.723848, "o", "eir `related` and `queue` contain only tickets belonging to the\r\nrecipient tenant. Tenant filte\u001b[?2004h> "]
[167.723925, "o", "    response.__enter__.return_value = response\r\n\u001b[?2004l\r"]
[167.723948, "o", "\u001b[?2004h> "]
[167.723994, "o", "    response.status = 202\r\n\u001b[?2004l\r"]
[167.724014, "o", "\u001b[?2004h> "]
[167.724116, "o", "    response.read.return_value = b'{\"delivery_id\": \"dl_test\"}'\r\n\u001b[?2004l\r"]
[167.724136, "o", "\u001b[?2004h> "]
[167.724166, "o", "    requests = []\r\n\u001b[?2004l\r"]
[167.724184, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[167.724193, "o", "\u001b[?2004h"]
[167.72426, "o", "> "]
[167.724269, "o", "    def urlopen(request, timeout):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.724348, "o", "        requests.append((request, timeout))\r\n\u001b[?2004l\r"]
[167.724378, "o", "\u001b[?2004h"]
[167.724402, "o", "> "]
[167.724424, "o", "        return response\r\n\u001b[?2004l\r"]
[167.724453, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rv\u001b[?2004h"]
[167.724478, "o", "> "]
[167.724568, "o", "    monkeypatch.setattr(\"deskline.notification.urllib.request.urlopen\", urlopen)\r\n\u001b[?2004l\r"]
[167.724597, "o", "\u001b[?2004h"]
[167.724609, "o", "> "]
[167.724698, "o", "    client = NotificationRelayClient(\"http://relay.test/\", timeout_sec=3)\r\n\u001b[?2004l\r"]
[167.724729, "o", "\u001b[?2004h> "]
[167.724894, "o", "    result = client.post(tenant, event) if destination == \"hook\" else client.post_channel(\"/channels/test\", event)\r\n\u001b[?2004l\r"]
[167.724926, "o", "\u001b[?2004h> "]
[167.72497, "o", "    request, timeout = requests[0]\r\n\u001b[?2004l\r"]
[167.725, "o", "\u001b[?2004h> "]
[167.725116, "o", "    headers = {k.lower(): v for k, v in request.header_items()}\r\n\u001b[?2004l\r"]
[167.725184, "o", "\u001b[?2004h"]
[167.725385, "o", "> "]
[167.725434, "o", "    assert timeout == 3 and request.method == \"POST\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.725524, "o", "    assert json.loads(request.data) == event\r\n\u001b[?2004l\r"]
[167.725567, "o", "\u001b[?2004h"]
[167.72561, "o", "> "]
[167.725737, "o", "    assert headers[\"content-type\"] == \"application/json\"\r\n\u001b[?2004l\r"]
[167.72578, "o", "\u001b[?2004h"]
[167.725839, "o", "> "]
[167.725968, "o", "    assert headers[\"x-deskline-event\"] == \"ticket.escalated\"\r\n\u001b[?2004l\r"]
[167.726014, "o", "\u001b[?2004h"]
[167.726057, "o", "> "]
[167.726236, "o", "    assert result.status == 202 and result.body[\"delivery_id\"] == \"dl_test\"\r\n\u001b[?2004l\r"]
[167.726281, "o", "\u001b[?2004h"]
[167.726325, "o", "> "]
[167.726377, "o", "    if destination == \"hook\":\r\n\u001b[?2004l\r"]
[167.726392, "o", "\u001b[?2004h> "]
[167.726687, "o", "        assert request.full_url == \"http://relay.test\" + tenant.escalation_hook\r\n\u001b[?2004l\r"]
[167.726744, "o", "\u001b[?2004h"]
[167.726802, "o", "> "]
[167.726969, "o", "        assert headers[\"x-deskline-tenant\"] == \"northwind\"\r\n\u001b[?2004l\r"]
[167.727014, "o", "\u001b[?2004h"]
[167.727058, "o", ">     else:\r\n\u001b[?2004l\r"]
[167.727101, "o", "\u001b[?2004h> "]
[167.727274, "o", "        assert request.full_url == \"http://relay.test/channels/test\"\r\n\u001b[?2004l\r"]
[167.727319, "o", "\u001b[?2004h"]
[167.727363, "o", "> "]
[167.727471, "o", "        assert \"x-deskline-tenant\" not in headers\r\n\u001b[?2004l\r"]
[167.727515, "o", "\u001b[?2004h"]
[167.72756, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r(\u001b[?2004h> "]
[167.727779, "o", "@pytest.mark.parametrize(\"destination\", [\"hook\", \"channel\", \"health\"])\r\n\u001b[?2004l\r"]
[167.727823, "o", "\u001b[?2004h"]
[167.727871, "o", "> "]
[167.72809, "o", "@pytest.mark.parametrize(\"failure\", [\"rejected\", \"unreachable\", \"timeout\", \"disconnected\"])\r\n\u001b[?2004l\r"]
[167.728135, "o", "\u001b[?2004h"]
[167.728179, "o", "> "]
[167.728363, "o", "def test_relay_errors_are_normalized(db, monkeypatch, destination, failure):\r\n\u001b[?2004l\r"]
[167.728404, "o", "\u001b[?2004h"]
[167.728442, "o", "> "]
[167.728478, "o", "    _, tenants, _ = db\r\n\u001b[?2004l\r\u001b[?2004h"]
[167.728517, "o", "> "]
[167.728556, "o", "    errors = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.728761, "o", "        \"rejected\": urllib.error.HTTPError(\"http://relay.test\", 422, \"Invalid\", {}, io.BytesIO(b'invalid event')),\r\n\u001b[?2004l\r"]
[167.728828, "o", "\u001b[?2004h"]
[167.728837, "o", "> "]
[167.728927, "o", "        \"unreachable\": urllib.error.URLError(\"connection refused\"),\r\n\u001b[?2004l\r"]
[167.728966, "o", "\u001b[?2004h"]
[167.729002, "o", "> "]
[167.729053, "o", "        \"timeout\": TimeoutError(\"timed out\"),\r\n\u001b[?2004l\r"]
[167.729088, "o", "\u001b[?2004h> "]
[167.729214, "o", "        \"disconnected\": RemoteDisconnected(\"connection closed\"),\r\n\u001b[?2004l\r"]
[167.72925, "o", "\u001b[?2004h"]
[167.729289, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[167.729301, "o", "> \r\n\u001b[?2004l\ri\u001b[?2004h> "]
[167.729368, "o", "    def urlopen(*args, **kwargs):\r\n\u001b[?2004l\r"]
[167.729403, "o", "\u001b[?2004h"]
[167.72944, "o", "> "]
[167.729479, "o", "        raise errors[failure]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[167.729512, "o", "\u001b[?2004h> "]
[167.729648, "o", "    monkeypatch.setattr(\"deskline.notification.urllib.request.urlopen\", urlopen)\r\n\u001b[?2004l\r"]
[167.729673, "o", "\u001b[?2004h> "]
[167.729734, "o", "    client = NotificationRelayClient(\"http://relay.test\")\r\n\u001b[?2004l\r"]
[167.729763, "o", "\u001b[?2004h> "]
[167.729806, "o", "    with pytest.raises(RelayError) as exc:\r\n\u001b[?2004l\r"]
[167.729838, "o", "\u001b[?2004h> "]
[167.729864, "o", "        if destination == \"hook\":\r\n\u001b[?2004l\r"]
[167.729889, "o", "\u001b[?2004h> "]
[167.729979, "o", "            client.post(tenants.by_slug(\"northwind\"), {\"event\": \"ticket.escalated\"})\r\n\u001b[?2004l\r"]
[167.730009, "o", "\u001b[?2004h> "]
[167.730043, "o", "        elif destination == \"channel\":\r\n\u001b[?2004l\r"]
[167.730071, "o", "\u001b[?2004h> "]
[167.730155, "o", "            client.post_channel(\"/channels/oncall\", {\"event\": \"ticket.escalated\"})\r\n\u001b[?2004l\r"]
[167.730185, "o", "\u001b[?2004h> "]
[167.730205, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[167.730231, "o", "> "]
[167.730254, "o", "            client.health()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.730298, "o", "    assert \"relay\" in str(exc.value)\r\n\u001b[?2004l\r"]
[167.730323, "o", "\u001b[?2004h> "]
[167.730352, "o", "    if failure == \"rejected\":\r\n\u001b[?2004l\r"]
[167.730377, "o", "\u001b[?2004h> "]
[167.730416, "o", "        assert \"422\" in str(exc.value)\r\n\u001b[?2004l\r"]
[167.730444, "o", "\u001b[?2004h> "]
[167.730471, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[167.730497, "o", "> "]
[167.730523, "o", "        assert \"unreachable\" in str(exc.value)\r\n\u001b[?2004l\r\u001b[?2004h"]
[167.730551, "o", "> PY\r\n\u001b[?2004l\r"]
[167.731936, "o", "\u001b[?2004h"]
[167.731944, "o", "root@2a80eeb81ffc:/app# "]
[167.732004, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.732028, "o", "from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.732062, "o", "p = Path('README.md')\r\n\u001b[?2004l\r"]
[167.732087, "o", "\u001b[?2004h> "]
[167.732371, "o", "s = p.read_text().replace('| `sla-report --tenant', '| `escalate --tenant <slug> --ticket <number> --reason \"<text>\" [--actor <name>]` | mark a ticket escalated, record an internal note, and notify the tenant and deskline on-call |\\n| `sla-report --tenant')\r\n\u001b[?2004l\r"]
[167.732427, "o", "\u001b[?2004h> s += '''\r\n\u001b[?2004l\r\u001b[?2004h"]
[167.732455, "o", "> "]
[167.732482, "o", "### Escalating a ticket\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[167.732509, "o", "\u001b[?2004h> ```\r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.732619, "o", "python -m deskline.cli escalate --tenant northwind --ticket 1042 --reason \"SLA breached, customer chasing\"\r\n\u001b[?2004l\r"]
[167.73263, "o", "\u001b[?2004h> "]
[167.732672, "o", "```\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[167.732705, "o", "\u001b[?2004h> "]
[167.732781, "o", "The command reports the new status, tenant-hook delivery ID, and separate hook/on-call delivery\r\n\u001b[?2004l\r"]
[167.732811, "o", "\u001b[?2004h> "]
[167.732915, "o", "outcomes. It exits non-zero for unknown tenants/tickets, resolved/closed tickets, or either delivery\r\n\u001b[?2004l\r"]
[167.732945, "o", "\u001b[?2004h> "]
[167.733045, "o", "failure. Delivery failures do **not** undo the escalation or its internal note; the relay error is\r\n\u001b[?2004l\r"]
[167.733075, "o", "\u001b[?2004h> "]
[167.733175, "o", "printed to stderr and both destinations are attempted independently. Avoid blindly retrying: a\r\n\u001b[?2004l\r"]
[167.733196, "o", "\u001b[?2004h> "]
[167.733289, "o", "retry adds another escalation note and may duplicate a delivery that already succeeded.\r\n\u001b[?2004l\r"]
[167.733317, "o", "\u001b[?2004h> "]
[167.733345, "o", "'''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.733371, "o", "p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.733419, "o", "p = Path('docs/escalation_notifications.md')\r\n\u001b[?2004l\r"]
[167.733426, "o", "\u001b[?2004h> "]
[167.733501, "o", "s = p.read_text()\r\n\u001b[?2004l\r\u001b[?2004h> s += '''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.733545, "o", "## Context boundaries and delivery outcomes\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[167.733568, "o", "\u001b[?2004h> "]
[167.733663, "o", "Context is captured before changing the ticket or writing the escalation note. The queue therefore\r\n\u001b[?2004l\r"]
[167.733686, "o", "\u001b[?2004h> "]
[167.733774, "o", "shows tickets already waiting, rather than adding this new escalation to its own context.\r\n\u001b[?2004l\r"]
[167.733801, "o", "\u001b[?2004h> "]
[167.733808, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.73391, "o", "The example queue above illustrates the **deskline on-call** event. That internal destination gets\r\n\u001b[?2004l\r"]
[167.733933, "o", "\u001b[?2004h> "]
[167.734026, "o", "the desk-wide related-ticket panel and escalation queue. Tenant hooks must not disclose other\r\n\u001b[?2004l\r"]
[167.734046, "o", "\u001b[?2004h> "]
[167.734148, "o", "tenants' data (see `tenancy.md`): their `related` and `queue` contain only tickets belonging to the\r\n\u001b[?2004l\r"]
[167.734171, "o", "\u001b[?2004h> "]
[167.734271, "o", "recipient tenant. Tenant filtering happens **before** the usual five-row limits, so foreign tickets\r\n\u001b[?2004l\r"]
[167.734292, "o", "\u001b[?2004h> "]
[167.734406, "o", "do not crowd out the recipient's own context. The desk-wide CLI panel and hourly digest are unchanged.\r\n\u001b[?2004l\r"]
[167.734428, "o", "\u001b[?2004h> "]
[167.734457, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.734556, "o", "`escalate()` returns separate `delivered` (hook) and `oncall_delivered` flags. `delivery_id` is the\r\n\u001b[?2004l\r"]
[167.734579, "o", "\u001b[?2004h> "]
[167.734683, "o", "hook relay response's ID, or null if the hook failed. `hook_error` and `oncall_error` carry relay\r\n\u001b[?2004l\r"]
[167.734705, "o", "\u001b[?2004h> "]
[167.734811, "o", "failure messages; the CLI prints these to stderr and exits non-zero if either delivery failed.\r\n\u001b[?2004l\r"]
[167.734844, "o", "\u001b[?2004h> "]
[167.73494, "o", "Both destinations are attempted even when the first fails, and the ticket update remains committed.\r\n\u001b[?2004l\r"]
[167.734962, "o", "\u001b[?2004h> "]
[167.734991, "o", "'''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.73502, "o", "p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.735049, "o", "p = Path('deskline/escalation.py')\r\n\u001b[?2004l\r\u001b[?2004h"]
[167.735078, "o", "> "]
[167.735423, "o", "s = p.read_text().replace('terms, with the context the panel shows (customer, last internal note).\"\"\"', 'terms, with the context the panel shows (customer, last internal note).\\n        ``tenant_id`` restricts tenant-facing context before the search limit is applied.\"\"\"')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.735842, "o", "s = s.replace('most recent activity first, with the context the digest shows (tenant, customer, SLA, latest note).\"\"\"', 'most recent activity first, with the context the digest shows (tenant, customer, SLA, latest note).\\n    ``tenant_id`` restricts tenant-facing context before the queue limit is applied.\"\"\"')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.735874, "o", "p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.735907, "o", "p = Path('tests/test_escalation_workflow.py')\r\n\u001b[?2004l\r"]
[167.735938, "o", "\u001b[?2004h> "]
[167.736111, "o", "s = p.read_text().replace('from dataclasses import replace\\n', '').replace('    conn, tenants, tickets = db\\n', '    _, tenants, tickets = db\\n', 1)\r\n\u001b[?2004l\r"]
[167.736135, "o", "\u001b[?2004h> "]
[167.736557, "o", "s = s.replace('        assert context[\"sla\"] == sla_status(view.ticket, settings, now).as_dict()\\n', '        expected_sla = sla_status(view.ticket, settings, now).as_dict()\\n        assert context[\"sla\"] == {**expected_sla, \"age_hours\": pytest.approx(expected_sla[\"age_hours\"], abs=0.01)}\\n')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[167.736662, "o", "s = s.replace('    foreign = []\\n', '').replace('        foreign.append(ticket.ticket_id)\\n', '')\r\n\u001b[?2004l\r"]
[167.736688, "o", "\u001b[?2004h> "]
[167.736719, "o", "p.write_text(s)\r\n\u001b[?2004l\r"]
[167.736746, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[167.816728, "o", "\u001b[?2004hroot@2a80eeb81ffc:/app# "]
[167.816982, "o", "python -m pytest -q tests > /tmp/deskline-tests.log 2>&1; tail -70 /tmp/deskline-tests.log\r\n\u001b[?2004l\r"]
[169.708322, "o", "..................................F...............                       [100%]\r\n=================================== FAILURES ===================================\r\n______________ test_relay_errors_are_normalized[rejected-health] _______________\r\n\r\ndb = (<sqlite3.Connection object at 0x742c9763b880>, <deskline.tenant_store.TenantStore object at 0x742c97985c10>, <deskline.ticket_store.TicketStore object at 0x742c979873b0>)\r\nmonkeypatch = <_pytest.monkeypatch.MonkeyPatch object at 0x742c97984410>\r\ndestination = 'health', failure = 'rejected'\r\n\r\n    @pytest.mark.parametrize(\"destination\", [\"hook\", \"channel\", \"health\"])\r\n    @pytest.mark.parametrize(\"failure\", [\"rejected\", \"unreachable\", \"timeout\", \"disconnected\"])\r\n    def test_relay_errors_are_normalized(db, monkeypatch, destination, failure):\r\n        _, tenants, _ = db\r\n        errors = {\r\n            \"rejected\": urllib.error.HTTPError(\"http://relay.test\", 422, \"Invalid\", {}, io.BytesIO(b'invalid event')),\r\n            \"unreachable\": urllib.error.URLError(\"connection refused\"),\r\n            \"timeout\": TimeoutError(\"timed out\"),\r\n            \"disconnected\": RemoteDisconnected(\"connection closed\"),\r\n        }\r\n    \r\n        def urlopen(*args, **kwargs):\r\n            raise errors[failure]\r\n    \r\n        monkeypatch.setattr(\"deskline.notification.urllib.request.urlopen\", urlopen)\r\n        client = NotificationRelayClient(\"http://relay.test\")\r\n        with pytest.raises(RelayError) as exc:\r\n            if destination == \"hook\":\r\n                client.post(tenants.by_slug(\"northwind\"), {\"event\": \"ticket.escalated\"})\r\n            elif destination == \"channel\":\r\n                client.post_channel(\"/channels/oncall\", {\"event\": \"ticket.escalated\"})\r\n            else:\r\n                client.health()\r\n        assert \"relay\" in str(exc.value)\r\n        if failure == \"rejected\":\r\n>           assert \"422\" in str(exc.value)\r\nE           AssertionError: assert '422' in 'relay unreachable at http://relay.test: Invalid'\r\nE            +  where 'relay unreachable at http://relay.test: Invalid' = str(RelayError('relay unreachable at http://relay.test: Invalid'))\r\nE            +    where RelayError('relay unreachable at http://relay.test: Invalid') = <ExceptionInfo RelayError('relay unreachable at http://relay.test: Invalid') tblen=2>.value\r\n\r\ntests/test_notification.py:70: AssertionError\r\n=========================== short test summary info ============================\r\nFAILED tests/test_notification.py::test_relay_errors_are_normalized[rejected-health]\r\n1 failed, 49 passed in 1.37s\r\n"]
[169.708504, "o", "\u001b[?2004h"]
[169.708554, "o", "root@2a80eeb81ffc:/app# "]
