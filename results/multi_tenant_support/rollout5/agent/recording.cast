[110.539833, "o", "    relay = RecordingRelay()\r\n\u001b[?2004l\r"]
[110.539863, "o", "\u001b[?2004h"]
[110.539887, "o", "> "]
[110.540053, "o", "    with pytest.raises(EscalationError, match=status):\r\n\u001b[?2004l\r"]
[110.5401, "o", "\u001b[?2004h> "]
