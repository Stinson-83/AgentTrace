[110.540351, "o", "\u001b[?2004h"]
[110.540365, "o", "> "]
[110.540583, "o", "    assert tickets.get_ticket(tenant.tenant_id, 1042) == before\r\n\u001b[?2004l\r"]
[110.540609, "o", "\u001b[?2004h"]
[110.540623, "o", "> "]
