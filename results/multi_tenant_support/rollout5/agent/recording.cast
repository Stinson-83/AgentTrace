[217.31995, "o", "                and event.get('ticket', {}).get('number') == 1042\r\n\u001b[?2004l\r\u001b[?2004h"]
[217.320032, "o", "> "]
[217.320237, "o", "                and event.get('escalation', {}).get('reason') == reason):\r\n\u001b[?2004l\r"]
[217.320298, "o", "\u001b[?2004h> "]
[217.32046, "o", "            matches.append((path, record, event))\r\n\u001b[?2004l\r"]
[217.320557, "o", "\u001b[?2004h> "]
[217.320629, "o", "    assert matches, destination\r\n\u001b[?2004l\r"]
[217.32067, "o", "\u001b[?2004h> "]
[217.320966, "o", "    path, record, event = matches[-1]\r\n\u001b[?2004l\r"]
[217.32106, "o", "\u001b[?2004h> "]
[217.321199, "o", "    assert event['ticket']['status'] == 'escalated'\r\n\u001b[?2004l\r"]
[217.32126, "o", "\u001b[?2004h> "]
[217.32156, "o", "    assert event['escalation']['latest_internal_note'] != f'Escalated by cli: {reason}'\r\n\u001b[?2004l\r"]
[217.321621, "o", "\u001b[?2004h> "]
[217.3217, "o", "    if destination == 'northwind':\r\n\u001b[?2004l\r"]
[217.321747, "o", "\u001b[?2004h> "]
[217.321965, "o", "        assert all(row['tenant'] == 'northwind' for row in event['escalation']['queue'])\r\n\u001b[?2004l\r"]
[217.322011, "o", "\u001b[?2004h> "]
[217.322184, "o", "        assert record['headers']['x-deskline-tenant'] == 'northwind'\r\n\u001b[?2004l\r"]
[217.322226, "o", "\u001b[?2004h> "]
[217.322268, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[217.32251, "o", "        assert any(row['tenant'] != 'northwind' for row in event['escalation']['queue'])\r\n\u001b[?2004l\r"]
[217.32256, "o", "\u001b[?2004h> "]
[217.322951, "o", "    print(f\"Verified {record['path']}: {path.name}; related={len(event['escalation']['related'])}, queue={len(event['escalation']['queue'])}\")\r\n\u001b[?2004l\r"]
[217.322997, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[217.323037, "o", "> "]
[217.323087, "o", "settings = load_settings()\r\n\u001b[?2004l\r"]
[217.323127, "o", "\u001b[?2004h> "]
[217.323247, "o", "with open_connection(settings.db_path) as conn:\r\n\u001b[?2004l\r"]
[217.323287, "o", "\u001b[?2004h> "]
[217.323442, "o", "    tickets, tenants = TicketStore(conn), TenantStore(conn)\r\n\u001b[?2004l\r"]
[217.323482, "o", "\u001b[?2004h> "]
[217.323589, "o", "    tenant = tenants.by_slug('northwind')\r\n\u001b[?2004l\r"]
[217.323631, "o", "\u001b[?2004h> "]
[217.32377, "o", "    ticket = tickets.get_ticket(tenant.tenant_id, 1042)\r\n\u001b[?2004l\r"]
[217.323849, "o", "\u001b[?2004h> "]
[217.32396, "o", "    note = tickets.notes_for(ticket.ticket_id)[-1]\r\n\u001b[?2004l\r"]
[217.324002, "o", "\u001b[?2004h> "]
[217.324099, "o", "    assert ticket.status == 'escalated'\r\n\u001b[?2004l\r"]
[217.32414, "o", "\u001b[?2004h> "]
[217.324313, "o", "    assert note.author == 'cli' and note.visibility == 'internal'\r\n\u001b[?2004l\r"]
[217.324358, "o", "\u001b[?2004h> "]
[217.324491, "o", "    assert note.body == f'Escalated by cli: {reason}'\r\n\u001b[?2004l\r"]
[217.324538, "o", "\u001b[?2004h> "]
[217.324886, "o", "    print(f'Verified persisted ticket: {tenant.slug} #{ticket.number}, status={ticket.status}, internal note #{note.note_id}')\r\n\u001b[?2004l\r"]
[217.324951, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[217.463482, "o", "Verified /hooks/northwind/escalations: 20261117T061447535224-000001-c4717d48.json; related=5, queue=1\r\nVerified /channels/oncall: 20261117T061447536735-000002-dfe40d80.json; related=5, queue=5\r\n"]
[217.463936, "o", "Verified persisted ticket: northwind #1042, status=escalated, internal note #219\r\n"]
