[110.544672, "o", "\u001b[?2004h"]
[110.54469, "o", "> "]
[110.545018, "o", "@pytest.mark.parametrize(\"hook_fails,oncall_fails\", [(True, False), (False, True), (True, True)])\r\n\u001b[?2004l\r"]
[110.545041, "o", "\u001b[?2004h"]
[110.545054, "o", "> "]
[110.54541, "o", "def test_delivery_errors_are_returned_and_updates_stand(db, settings, service, hook_fails, oncall_fails):\r\n\u001b[?2004l\r"]
[110.545473, "o", "\u001b[?2004h> "]
[110.545542, "o", "    _, tenants, tickets = db\r\n"]
[110.545556, "o", "\u001b[?2004l\r"]
[110.545574, "o", "\u001b[?2004h> "]
[110.545818, "o", "    relay = RecordingRelay(\"hook unreachable\" if hook_fails else None,\r\n\u001b[?2004l\r"]
[110.545859, "o", "\u001b[?2004h> "]
[110.546126, "o", "                           \"channel rejected (422)\" if oncall_fails else None)\r\n\u001b[?2004l\r"]
[110.546162, "o", "\u001b[?2004h> "]
[110.546504, "o", "    result = escalate(service, relay, settings, tenants.by_slug(\"northwind\"), 1042, \"Review\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.546533, "o", "> "]
[110.546669, "o", "    assert result.delivered == (not hook_fails)\r\n"]
[110.54669, "o", "\u001b[?2004l\r"]
[110.546702, "o", "\u001b[?2004h> "]
[110.546903, "o", "    assert result.oncall_delivered == (not oncall_fails)\r\n"]
[110.546925, "o", "\u001b[?2004l\r"]
[110.546946, "o", "\u001b[?2004h"]
[110.546973, "o", "> "]
[110.54718, "o", "    assert result.delivery_id == (None if hook_fails else \"hook-123\")\r\n\u001b[?2004l\r"]
[110.54721, "o", "\u001b[?2004h"]
[110.54723, "o", "> "]
[110.547571, "o", "    assert result.hook_error == relay.hook_error and result.oncall_error == relay.oncall_error\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.54761, "o", "> "]
[110.547762, "o", "    assert len(relay.hooks) == len(relay.channels) == 1\r\n\u001b[?2004l\r"]
[110.547794, "o", "\u001b[?2004h"]
[110.547816, "o", "> "]
[110.548035, "o", "    assert service.view(\"ten_nw\", 1042).ticket.status == \"escalated\"\r\n\u001b[?2004l\r"]
[110.548063, "o", "\u001b[?2004h"]
[110.54809, "o", "> "]
[110.548326, "o", "    assert \"Review\" in service.view(\"ten_nw\", 1042).latest_internal_note.body\r\n\u001b[?2004l\r"]
[110.548358, "o", "\u001b[?2004h"]
[110.548378, "o", "> \r\n\u001b[?2004l\r"]
[110.548404, "o", "\u001b[?2004h> \r\n"]
[110.548431, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[110.548612, "o", "def test_nonaccepted_responses_are_failures(db, settings, service):\r\n"]
[110.548633, "o", "\u001b[?2004l\r"]
[110.548658, "o", "\u001b[?2004h> "]
[110.548699, "o", "    _, tenants, _ = db\r\n\u001b[?2004l\r"]
[110.548728, "o", "\u001b[?2004h"]
[110.548755, "o", "> "]
[110.548887, "o", "    relay = RecordingRelay(hook_status=422, oncall_status=503)\r\n\u001b[?2004l\r"]
[110.548916, "o", "\u001b[?2004h"]
[110.548937, "o", "> "]
[110.549153, "o", "    result = escalate(service, relay, settings, tenants.by_slug(\"northwind\"), 1042, \"Review\")\r\n\u001b[?2004l\r"]
[110.549186, "o", "\u001b[?2004h> "]
[110.549407, "o", "    assert not result.delivered and not result.oncall_delivered and result.delivery_id is None\r\n\u001b[?2004l\r"]
[110.549434, "o", "\u001b[?2004h"]
[110.549463, "o", "> "]
[110.549612, "o", "    assert \"422\" in result.hook_error and \"503\" in result.oncall_error\r\n\u001b[?2004l\r"]
[110.549641, "o", "\u001b[?2004h"]
[110.549668, "o", "> \r\n\u001b[?2004l\r"]
[110.549693, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[110.549714, "o", "\u001b[?2004h> "]
[110.549878, "o", "def test_tenant_scoping_happens_before_limits(db, settings, service):\r\n\u001b[?2004l\r"]
[110.549908, "o", "\u001b[?2004h"]
[110.549936, "o", "> "]
[110.549981, "o", "    _, tenants, tickets = db\r\n\u001b[?2004l\r"]
[110.550005, "o", "\u001b[?2004h> "]
[110.550113, "o", "    tenant = tenants.by_slug(\"northwind\")\r\n\u001b[?2004l\r"]
[110.550141, "o", "\u001b[?2004h"]
[110.550168, "o", "> "]
[110.55028, "o", "    source = tickets.get_ticket(tenant.tenant_id, 1042)\r\n\u001b[?2004l\r"]
[110.550304, "o", "\u001b[?2004h> "]
[110.550543, "o", "    own = tickets.create_ticket(tenant.tenant_id, source.subject, \"normal\", source.customer_id)\r\n\u001b[?2004l\r"]
[110.550575, "o", "\u001b[?2004h> "]
[110.550743, "o", "    tickets.add_note(own.ticket_id, \"agent\", \"Our tenant context\")\r\n\u001b[?2004l\r"]
[110.550769, "o", "\u001b[?2004h"]
[110.550799, "o", "> "]
[110.550913, "o", "    tickets.update_status(own.ticket_id, \"escalated\")\r\n\u001b[?2004l\r"]
[110.55094, "o", "\u001b[?2004h> "]
[110.550988, "o", "    foreign = []\r\n"]
[110.551015, "o", "\u001b[?2004l\r"]
[110.551044, "o", "\u001b[?2004h> "]
[110.551073, "o", "    for _ in range(7):\r\n\u001b[?2004l\r"]
[110.551104, "o", "\u001b[?2004h"]
[110.551138, "o", "> "]
[110.551315, "o", "        ticket = tickets.create_ticket(\"ten_hl\", source.subject, \"high\", \"cst_0001\")\r\n\u001b[?2004l\r"]
[110.551339, "o", "\u001b[?2004h> "]
[110.551537, "o", "        tickets.add_note(ticket.ticket_id, \"agent\", \"FOREIGN PRIVATE CONTEXT\")\r\n\u001b[?2004l\r"]
[110.551561, "o", "\u001b[?2004h> "]
[110.551714, "o", "        tickets.update_status(ticket.ticket_id, \"escalated\")\r\n\u001b[?2004l\r"]
[110.551748, "o", "\u001b[?2004h> "]
[110.551848, "o", "        foreign.append(ticket.ticket_id)\r\n\u001b[?2004l\r"]
[110.551878, "o", "\u001b[?2004h> "]
[110.551949, "o", "    relay = RecordingRelay()\r\n\u001b[?2004l\r"]
[110.551977, "o", "\u001b[?2004h"]
[110.552009, "o", "> "]
[110.552137, "o", "    escalate(service, relay, settings, tenant, 1042, \"Review\")\r\n\u001b[?2004l\r"]
[110.552162, "o", "\u001b[?2004h> "]
[110.552288, "o", "    hook_context = relay.hooks[0][1][\"escalation\"]\r\n\u001b[?2004l\r"]
[110.552319, "o", "\u001b[?2004h"]
[110.552347, "o", "> "]
[110.552508, "o", "    assert any(r[\"number\"] == own.number for r in hook_context[\"related\"])\r\n\u001b[?2004l\r"]
[110.552538, "o", "\u001b[?2004h> "]
[110.552711, "o", "    assert any(r[\"number\"] == own.number for r in hook_context[\"queue\"])\r\n\u001b[?2004l\r"]
[110.552736, "o", "\u001b[?2004h> "]
[110.552927, "o", "    assert all(r[\"tenant\"] == \"northwind\" for r in hook_context[\"queue\"])\r\n\u001b[?2004l\r"]
[110.552958, "o", "\u001b[?2004h> "]
[110.553105, "o", "    assert \"FOREIGN PRIVATE CONTEXT\" not in str(relay.hooks)\r\n\u001b[?2004l\r"]
[110.553134, "o", "\u001b[?2004h"]
[110.553162, "o", "> "]
[110.553281, "o", "    assert \"FOREIGN PRIVATE CONTEXT\" in str(relay.channels)\r\n\u001b[?2004l\r"]
[110.553305, "o", "\u001b[?2004h> "]
[110.553538, "o", "    assert len(escalation_queue(service, settings, tenant_id=tenant.tenant_id, limit=1)) == 1\r\n\u001b[?2004l\r"]
[110.553566, "o", "\u001b[?2004h"]
[110.55358, "o", "> \r\n\u001b[?2004l\r"]
[110.553623, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[110.553648, "o", "\u001b[?2004h> "]
[110.553674, "o", "@pytest.fixture\r\n\u001b[?2004l\r"]
[110.553701, "o", "\u001b[?2004h> "]
[110.553804, "o", "def cli_setup(db, settings, monkeypatch):\r\n\u001b[?2004l\r"]
[110.553834, "o", "\u001b[?2004h"]
[110.553862, "o", "> "]
[110.553906, "o", "    relay = RecordingRelay()\r\n\u001b[?2004l\r"]
[110.553933, "o", "\u001b[?2004h"]
[110.55396, "o", "> "]
[110.554098, "o", "    monkeypatch.setattr(cli, \"load_settings\", lambda: settings)\r\n"]
[110.554121, "o", "\u001b[?2004l\r"]
[110.554148, "o", "\u001b[?2004h> "]
[110.554315, "o", "    monkeypatch.setattr(cli, \"NotificationRelayClient\", lambda *args: relay)\r\n\u001b[?2004l\r"]
[110.554347, "o", "\u001b[?2004h> "]
[110.554387, "o", "    return relay\r\n\u001b[?2004l\r"]
[110.554411, "o", "\u001b[?2004h> "]
[110.554438, "o", "\r\n\u001b[?2004l\r"]
[110.554468, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[110.554498, "o", "\u001b[?2004h> "]
[110.554604, "o", "@pytest.mark.parametrize(\"actor\", [None, \"jordan\"])\r\n\u001b[?2004l\r"]
[110.554627, "o", "\u001b[?2004h> "]
[110.55475, "o", "def test_cli_success(cli_setup, capsys, actor):\r\n\u001b[?2004l\r"]
[110.554775, "o", "\u001b[?2004h> "]
[110.555032, "o", "    args = [\"escalate\", \"--tenant\", \"northwind\", \"--ticket\", \"1042\", \"--reason\", \"Customer chasing\"]\r\n\u001b[?2004l\r"]
[110.555057, "o", "\u001b[?2004h> "]
[110.555096, "o", "    if actor:\r\n\u001b[?2004l\r"]
[110.555123, "o", "\u001b[?2004h"]
[110.555153, "o", "> "]
[110.555213, "o", "        args += [\"--actor\", actor]\r\n\u001b[?2004l\r"]
[110.555237, "o", "\u001b[?2004h> "]
[110.555319, "o", "    assert cli.main(args) == 0\r\n\u001b[?2004l\r"]
[110.555349, "o", "\u001b[?2004h> "]
[110.555423, "o", "    out = capsys.readouterr()\r\n\u001b[?2004l\r"]
[110.555447, "o", "\u001b[?2004h> "]
[110.55564, "o", "    assert \"northwind #1042: escalated\" in out.out and \"hook-123\" in out.out\r\n\u001b[?2004l\r"]
[110.555665, "o", "\u001b[?2004h> "]
[110.555829, "o", "    assert \"on-call=delivered\" in out.out and not out.err\r\n\u001b[?2004l\r"]
[110.555862, "o", "\u001b[?2004h> "]
[110.555999, "o", "    assert cli_setup.hooks[0][1][\"actor\"] == (actor or \"cli\")\r\n\u001b[?2004l\r"]
[110.556053, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.556087, "o", "\r\n\u001b[?2004l\r"]
[110.556134, "o", "\u001b[?2004h> "]
[110.556292, "o", "@pytest.mark.parametrize(\"tenant,number\", [(\"unknown\", 1042), (\"northwind\", 1055)])\r\n\u001b[?2004l\r"]
[110.556323, "o", "\u001b[?2004h"]
[110.556328, "o", "> "]
[110.556521, "o", "def test_cli_unknown_records(cli_setup, capsys, tenant, number):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.556768, "o", "    assert cli.main([\"escalate\", \"--tenant\", tenant, \"--ticket\", str(number), \"--reason\", \"Review\"]) != 0\r\n\u001b[?2004l\r"]
[110.556805, "o", "\u001b[?2004h> "]
[110.556888, "o", "    assert capsys.readouterr().err\r\n\u001b[?2004l\r"]
[110.556915, "o", "\u001b[?2004h"]
[110.556943, "o", "> "]
[110.557061, "o", "    assert not cli_setup.hooks and not cli_setup.channels\r\n\u001b[?2004l\r"]
[110.557088, "o", "\u001b[?2004h> "]
[110.557109, "o", "\r\n\u001b[?2004l\r"]
[110.557115, "o", "\u001b[?2004h"]
[110.557154, "o", "> \r\n"]
[110.557175, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[110.557282, "o", "def test_cli_terminal_ticket(db, cli_setup, capsys):\r\n\u001b[?2004l\r"]
[110.557311, "o", "\u001b[?2004h"]
[110.557338, "o", "> "]
[110.55737, "o", "    _, _, tickets = db\r\n\u001b[?2004l\r"]
[110.557394, "o", "\u001b[?2004h> "]
[110.557517, "o", "    ticket = tickets.get_ticket(\"ten_nw\", 1042)\r\n\u001b[?2004l\r"]
[110.557543, "o", "\u001b[?2004h"]
[110.55757, "o", "> "]
[110.557719, "o", "    tickets.update_status(ticket.ticket_id, \"closed\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.558008, "o", "    assert cli.main([\"escalate\", \"--tenant\", \"northwind\", \"--ticket\", \"1042\", \"--reason\", \"Review\"]) != 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.558151, "o", "    assert \"closed\" in capsys.readouterr().err\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.558321, "o", "    assert not cli_setup.hooks and not cli_setup.channels\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
