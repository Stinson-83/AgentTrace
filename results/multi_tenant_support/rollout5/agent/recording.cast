[33.031171, "o", "\"\"\"Tickets and notes. Ticket numbers are a per-tenant sequence (#1042); ``ticket_id`` is the primary key\r\nand (tenant_id, number) is unique.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport json\r\nimport sqlite3\r\nfrom dataclasses import dataclass\r\nfrom datetime import datetime, timezone\r\nfrom pathlib import Path\r\n\r\nSCHEMA = \"\"\"\r\nCREATE TABLE IF NOT EXISTS tickets (\r\n    ticket_id    INTEGER PRIMARY KEY AUTOINCREMENT,\r\n"]
[33.031249, "o", "    tenant_id    TEXT NOT NULL REFERENCES tenants(tenant_id),\r\n    number       INTEGER NOT NULL,\r\n    subject      TEXT NOT NULL,\r\n    status       TEXT NOT NULL CHECK (status IN ('open','pending','escalated','resolved','closed')),\r\n    priority     TEXT NOT NULL CHECK (priority IN ('low','normal','high','urgent')),\r\n    customer_id  TEXT NOT NULL REFERENCES customers(customer_id),\r\n    assignee     TEXT,\r\n    created_at   TEXT NOT NULL,\r\n    updated_at   TEXT NOT NULL,\r\n    UNIQUE (tenant_id, number)\r\n);\r\nCREATE TABLE IF NOT EXISTS ticket_notes (\r\n    note_id      INTEGER PRIMARY KEY AUTOINCREMENT,\r\n    ticket_id    INTEGER NOT NULL REFERENCES tickets(ticket_id),\r\n    author       TEXT NOT NULL,\r\n    visibility   TEXT NOT NULL CHECK (visibility IN ('public','internal')),\r\n    body         TEXT NOT NULL,\r\n    created_at   TEXT NOT NULL\r\n);\r\nCREATE INDEX IF NOT EXISTS idx_notes_ticket ON ticket_notes(ticket_id, created_at);\r\n\"\"\"\r\n\r\n\r\ndef utcnow() -> str:\r\n    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace(\"+00:00\", \"Z\")\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Ticket:\r\n    ticket_id: int\r\n"]
[33.031289, "o", "    tenant_id: str\r\n    number: int\r\n    subject: str\r\n    status: str\r\n    priority: str\r\n    customer_id: str\r\n    assignee: str | None\r\n    created_at: str\r\n    updated_at: str\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Note:\r\n    note_id: int\r\n    ticket_id: int\r\n    author: str\r\n    visibility: str\r\n    body: str\r\n    created_at: str\r\n\r\n\r\nclass TicketError(LookupError):\r\n    pass\r\n\r\n"]
[33.031323, "o", "\r\nclass TicketStore:\r\n    def __init__(self, conn: sqlite3.Connection):\r\n        self._conn = conn\r\n        self._conn.executescript(SCHEMA)\r\n\r\n    # ----------------------------------------------------------------- seeding\r\n    def load_seed(self, seed_dir: Path) -> tuple[int, int]:\r\n        tickets = json.loads((seed_dir / \"tickets.json\").read_text())\r\n        notes = json.loads((seed_dir / \"notes.json\").read_text())\r\n        with self._conn:\r\n            self._conn.executemany(\r\n"]
[33.031352, "o", "                \"INSERT OR REPLACE INTO tickets VALUES (:ticket_id,:tenant_id,:number,:subject,:status,:priority,\"\r\n                \":customer_id,:assignee,:created_at,:updated_at)\", tickets)\r\n            self._conn.executemany(\r\n                \"INSERT OR REPLACE INTO ticket_notes VALUES (:note_id,:ticket_id,:author,:visibility,:body,:created_at)\", notes)\r\n        return len(tickets), len(notes)\r\n\r\n    # ----------------------------------------------------------------- lookups\r\n    def get_ticket(self, tenant_id: str, number: int) -> Ticket:\r\n        row = self._conn.execute(\"SELECT * FROM tickets WHERE tenant_id = ? AND number = ?\", (tenant_id, number)).fetchone()\r\n        if row is None:\r\n"]
[33.031379, "o", "            raise TicketError(f\"ticket #{number} not found for tenant {tenant_id!r}\")\r\n        return Ticket(**dict(row))\r\n\r\n    def by_id(self, ticket_id: int) -> Ticket:\r\n        row = self._conn.execute(\"SELECT * FROM tickets WHERE ticket_id = ?\", (ticket_id,)).fetchone()\r\n        if row is None:\r\n            raise TicketError(f\"ticket id {ticket_id} not found\")\r\n        return Ticket(**dict(row))\r\n"]
[33.031418, "o", "\r\n    def search(self, terms: list[str], limit: int = 10, exclude_ticket_id: int | None = None) -> list[Ticket]:\r\n        \"\"\"Keyword search on subjects (used by `ticket search` and the related-ticket panel):\r\n        open/pending/escalated tickets whose subject contains every term, most recent first.\"\"\"\r\n        terms = [t.strip().lower() for t in terms if t.strip()]\r\n        if not terms:\r\n            return []\r\n        sql = \"SELECT * FROM tickets WHERE status IN ('open','pending','escalated')\"\r\n"]
[33.03294, "o", "\"\"\"Small in-process LRU cache for hot records (ticket views, tenant rows).\"\"\"\r\nfrom __future__ import annotations\r\n\r\nfrom collections import OrderedDict\r\nfrom typing import Any, Callable, Generic, Hashable, TypeVar\r\n\r\nT = TypeVar(\"T\")\r\n\r\n\r\nclass RecordCache(Generic[T]):\r\n    def __init__(self, max_entries: int = 256):\r\n        self.max_entries = max(1, max_entries)\r\n        self._entries: \"OrderedDict[Hashable, T]\" = OrderedDict()\r\n        self.hits = 0\r\n        self.misses = 0\r\n\r\n    def get(self, key: Hashable) -> T | None:\r\n        if key in self._entries:\r\n            self._entries.move_to_end(key)\r\n"]
[33.032996, "o", "            self.hits += 1\r\n            return self._entries[key]\r\n        self.misses += 1\r\n        return None\r\n\r\n    def put(self, key: Hashable, value: T) -> T:\r\n        self._entries[key] = value\r\n        self._entries.move_to_end(key)\r\n        while len(self._entries) > self.max_entries:\r\n            self._entries.popitem(last=False)\r\n        return value\r\n\r\n    def get_or_load(self, key: Hashable, loader: Callable[[], T]) -> T:\r\n        cached = self.get(key)\r\n        if cached is not None:\r\n            return cached\r\n        return self.put(key, loader())\r\n\r\n    def invalidate(self, key: Hashable) -> None:\r\n        self._entries.pop(key, None)\r\n\r\n    def clear(self) -> None:\r\n        self._entries.clear()\r\n\r\n    def __len__(self) -> int:\r\n        return len(self._entries)\r\n\r\n    def stats(self) -> dict[str, Any]:\r\n        return {\"entries\": len(self._entries), \"hits\": self.hits, \"misses\": self.misses}\r\n"]
[33.034437, "o", "#!/usr/bin/env python3\r\n\"\"\"Local stand-in for the deskline notification relay.\r\n\r\nTenants register an escalation hook; the relay accepts events posted to\r\n``/hooks/<tenant-slug>/escalations`` and forwards them to that tenant's channel. Deskline's own\r\ninternal channels live under ``/channels/<name>`` (the on-call rota channel is ``/channels/oncall``).\r\nThis stand-in persists every request it receives (one JSON file per request, grouped by hook or\r\nchannel) so the delivery can be inspected, and forwards nothing.\r\n\r\n    python services/notify_relay_service.py --port 8742 --state-dir /var/lib/notify-relay\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport argparse\r\nimport base64\r\nimport json\r\nimport os\r\nimport re\r\nimport sys\r\nimport threading\r\nimport uuid\r\nfrom datetime import datetime, timezone\r\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\r\nfrom pathlib import Path\r\nfrom urllib.parse import urlsplit\r\n\r\nSERVICE_NAME = \"notify-relay\"\r\nHOOK_RE = re.compile(r\"^/hooks/(?P<slug>[a-z0-9-]+)/(?P<channel>escalations|digest)$\")\r\nCHANNEL_RE = re.compile(r\"^/channels/(?P<name>[a-z0-9-]+)$\")   # deskline-internal channels (on-call rota, ops)\r\n_LOCK = threading.Lock()\r\n_SEQ = 0\r\n\r\n\r\ndef _now() -> str:\r\n    return datetime.now(timezone.utc).isoformat(timespec=\"microseconds\").replace(\"+00:00\", \"Z\")\r\n\r\n\r\nclass Handler(BaseHTTPRequestHandler):\r\n    server_version = \"notify-relay/0.9\"\r\n    state_dir: Path\r\n\r\n    def log_message(self, fmt, *args):\r\n        with open(self.state_dir / \"service.log\", \"a\") as fh:\r\n            fh.write(\"%s - %s\\n\" % (self.address_string(), fmt % args))\r\n\r\n    def _persist(self, body: bytes, slug: str | None) -> Path:\r\n        global _SEQ\r\n        parts = urlsplit(self.path)\r\n        with _LOCK:\r\n            _SEQ += 1\r\n            seq = _SEQ\r\n        record = {\r\n            \"destination\": f\"{SERVICE_NAME}/{slug}\" if slug else SERVICE_NAME,\r\n            \"hook_tenant\": None if (slug or \"\").startswith(\"_channels/\") else slug,\r\n            \"received_at\": _now(),\r\n            \"method\": self.command,\r\n            \"path\": parts.path,\r\n            \"query_string\": parts.query,\r\n            \"headers\": {k.lower(): v for k, v in self.headers.items()},\r\n            \"content_length\": len(body),\r\n            \"body_b64\": base64.b64encode(body).decode(\"ascii\"),\r\n        }\r\n        folder = self.state_dir / \"received\" / (slug or \"_unrouted\")\r\n        folder.mkdir(parents=True, exist_ok=True)\r\n"]
[33.034489, "o", "        path = folder / f\"{datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S%f')}-{seq:06d}-{uuid.uuid4().hex[:8]}.json\"\r\n        tmp = path.with_suffix(\".tmp\")\r\n        tmp.write_text(json.dumps(record, indent=2))\r\n        os.replace(tmp, path)\r\n        return path\r\n\r\n    def _send(self, status: int, payload: dict) -> None:\r\n        data = json.dumps(payload).encode(\"utf-8\")\r\n        self.send_response(status)\r\n        self.send_header(\"Content-Type\", \"application/json\")\r\n        self.send_header(\"Content-Length\", str(len(data)))\r\n        self.end_headers()\r\n        self.wfile.write(data)\r\n\r\n    def do_GET(self):\r\n        path = urlsplit(self.path).path\r\n        if path == \"/healthz\":\r\n            return self._send(200, {\"service\": SERVICE_NAME, \"status\": \"ok\", \"time\": _now()})\r\n        if path == \"/hooks\":\r\n            received = self.state_dir / \"received\"\r\n            counts = {p.name: len(list(p.glob(\"*.json\"))) for p in received.iterdir()} if received.exists() else {}\r\n            return self._send(200, {\"deliveries\": counts})\r\n        return self._send(404, {\"error\": \"not found\"})\r\n\r\n    def do_POST(self):\r\n        path = urlsplit(self.path).path\r\n        body = self.rfile.read(int(self.headers.get(\"Content-Length\") or 0))\r\n        m = HOOK_RE.match(path)\r\n        c = CHANNEL_RE.match(path)\r\n        slug = m.group(\"slug\") if m else (f\"_channels/{c.group('name')}\" if c else None)\r\n        record_path = self._persist(body, slug)\r\n        if not m and not c:\r\n            return self._send(404, {\"error\": \"unknown hook or channel\", \"path\": path})\r\n        ctype = (self.headers.get(\"Content-Type\") or \"\").split(\";\")[0].strip()\r\n        if ctype != \"application/json\":\r\n            return self._send(415, {\"error\": \"expected application/json\"})\r\n        try:\r\n            event = json.loads(body.decode(\"utf-8\"))\r\n        except (ValueError, UnicodeDecodeError):\r\n            return self._send(400, {\"error\": \"body is not valid JSON\"})\r\n        if not isinstance(event, dict) or not event.get(\"event\"):\r\n            return self._send(422, {\"error\": \"event payload must be an object with an 'event' type\"})\r\n        if m and m.group(\"channel\") == \"escalations\":\r\n"]
[33.034531, "o", "            ticket = event.get(\"ticket\")\r\n            if not isinstance(ticket, dict) or \"number\" not in ticket:\r\n                return self._send(422, {\"error\": \"escalation events need ticket.number\"})\r\n        return self._send(202, {\"delivery_id\": f\"dl_{uuid.uuid4().hex[:12]}\", \"hook\": path, \"stored_as\": record_path.name})\r\n\r\n\r\ndef serve(port: int, state_dir: Path, host: str = \"127.0.0.1\") -> None:\r\n    state_dir.mkdir(parents=True, exist_ok=True)\r\n    (state_dir / \"received\").mkdir(exist_ok=True)\r\n    Handler.state_dir = state_dir\r\n    httpd = ThreadingHTTPServer((host, port), Handler)\r\n    (state_dir / \"service.pid\").write_text(str(os.getpid()))\r\n    print(f\"{SERVICE_NAME} listening on http://{host}:{port} (state: {state_dir})\", flush=True)\r\n    try:\r\n        httpd.serve_forever()\r\n    except KeyboardInterrupt:\r\n        pass\r\n    finally:\r\n        httpd.server_close()\r\n\r\n\r\ndef main(argv=None) -> int:\r\n    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\r\n    p.add_argument(\"--port\", type=int, default=int(os.environ.get(\"NOTIFY_RELAY_PORT\", \"8742\")))\r\n    p.add_argument(\"--host\", default=\"127.0.0.1\")\r\n    p.add_argument(\"--state-dir\", type=Path, default=Path(os.environ.get(\"NOTIFY_RELAY_STATE_DIR\", \"/var/lib/notify-relay\")))\r\n    args = p.parse_args(argv)\r\n    serve(args.port, args.state_dir, args.host)\r\n    return 0\r\n\r\n\r\n"]
[33.034563, "o", "if __name__ == \"__main__\":\r\n    sys.exit(main())\r\n"]
