[66.586718, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('deskline/ticket_store.py')\ns = p.read_text().replace('def search(self, terms: list[str], limit: int = 10, exclude_ticket_id: int | None = None)', 'def search(self, terms: list[str], limit: int = 10, exclude_ticket_id: int | None = None, *, tenant_id: str | None = None)')\ns = s.replace('        for term in terms:\\n', '        if tenant_id is not None:\\n            sql += \" AND tenant_id = ?\"\\n            params.append(tenant_id)\\n        for term in terms:\\n')\np.write_text(s)\np = Path('deskline/escalation.py')\ns = p.read_text().replace('from .notification import NotificationRelayClient', 'from .notification import NotificationRelayClient, RelayError').replace('from .ticket_store import Note, Ticket, TicketStore', 'from .ticket_store import Note, Ticket, TicketError, TicketStore')\ns = s.replace('def related(self, ticket: Ticket, limit: int = 5)', 'def related(self, ticket: Ticket, limit: int = 5, *, tenant_id: str | None = None)')\ns = s.replace('exclude_ticket_id=ticket.ticket_id):', 'exclude_ticket_id=ticket.ticket_id, tenant_id=tenant_id):')\ns = s.replace('now: datetime | None = None, limit: int = 5) -> list[dict[str, Any]]:', 'now: datetime | None = None, limit: int = 5, *, tenant_id: str | None = None) -> list[dict[str, Any]]:')\ns = s.replace('    for tenant in service.tenants.list_tenants():\\n', '    for tenant in service.tenants.list_tenants():\\n        if tenant_id is not None and tenant.tenant_id != tenant_id:\\n            continue\\n')\ns = s.replace('    oncall_delivered: bool = False\\n', '    oncall_delivered: bool = False\\n    hook_error: str | None = None\\n    oncall_error: str | None = None\\n')\ns = s[:s.index('    \"\"\"Escalate ticket ``number``')] + '''    \"\"\"Escalate a tenant's ticket and independently notify its hook and deskline on-call.\n\n    Context is snapshotted before the escalation note/status update. Tenant hooks receive\n    only their own context; the internal channel retains the desk-wide panel and queue.\n    Relay failures are returned in ``hook_error`` / ``oncall_error`` and never roll back\n    the ticket update. Validation failures raise ``EscalationError`` without any posts.\n    \"\"\"\n    try:\n        ticket = service.tickets.get_ticket(tenant.tenant_id, number)\n    except TicketError as e:\n        raise EscalationError(str(e)) from e\n    if ticket.tenant_id != tenant.tenant_id:\n        raise EscalationError(f\"ticket #{number} does not belong to tenant {tenant.slug!r}\")\n    if ticket.status in (\"resolved\", \"closed\"):\n        raise EscalationError(f\"ticket #{number} is {ticket.status} and cannot be escalated\")\n\n    # Read a fresh view, even if the caller previously cached this ticket.\n    service.invalidate(ticket.ticket_id)\n    view = service.view(tenant.tenant_id, number)\n    now = datetime.now(timezone.utc)\n    note = view.latest_internal_note\n    context = {\n        \"reason\": reason,\n        \"sla\": sla_status(ticket, settings, now).as_dict(),\n        \"latest_internal_note\": note.body if note else None,\n    }\n    event = {\n        \"event\": \"ticket.escalated\",\n        \"tenant\": tenant.slug,\n        \"occurred_at\": now.isoformat(timespec=\"seconds\").replace(\"+00:00\", \"Z\"),\n        \"actor\": actor,\n        \"ticket\": {\"number\": ticket.number, \"subject\": ticket.subject, \"status\": \"escalated\",\n                   \"priority\": ticket.priority, \"customer\": view.customer.name},\n        \"escalation\": {**context, \"related\": service.related(ticket),\n                       \"queue\": escalation_queue(service, settings, now)},\n    }\n    hook_event = {\n        **event,\n        \"escalation\": {**context, \"related\": service.related(ticket, tenant_id=tenant.tenant_id),\n                       \"queue\": escalation_queue(service, settings, now, tenant_id=tenant.tenant_id)},\n    }\n\n    service.tickets.update_status(ticket.ticket_id, \"escalated\")\n    service.tickets.add_note(ticket.ticket_id, actor, f\"Escalated by {actor}: {reason}\", \"internal\")\n    service.invalidate(ticket.ticket_id)\n\n    delivered = oncall_delivered = False\n    delivery_id = hook_error = oncall_error = None\n"]
[66.586883, "i", "    try:\n        response = relay.post(tenant, hook_event)\n        if response.status != 202:\n            raise RelayError(f\"relay rejected the notification ({response.status}): {response.body}\")\n        delivered = True\n        delivery_id = response.body.get(\"delivery_id\")\n    except RelayError as e:\n        hook_error = str(e)\n    try:\n        response = relay.post_channel(settings.oncall_channel, event)\n        if response.status != 202:\n            raise RelayError(f\"relay rejected the channel post ({response.status}): {response.body}\")\n        oncall_delivered = True\n    except RelayError as e:\n        oncall_error = str(e)\n    return EscalationResult(tenant.slug, number, \"escalated\", delivered, delivery_id,\n                            oncall_delivered, hook_error, oncall_error)\n'''\np.write_text(s)\np = Path('deskline/cli.py')\ns = p.read_text().replace('sla-report | oncall-digest | relay-health.', 'sla-report | escalate | oncall-digest | relay-health.')\ns = s.replace('from .escalation import TicketService, escalation_queue, sla_report, sla_status', 'from .escalation import EscalationError, TicketService, escalate, escalation_queue, sla_report, sla_status')\npos = s.index('def cmd_oncall_digest(')\ns = s[:pos] + '''def cmd_escalate(args, settings) -> int:\n    ctx = Context(settings)\n    try:\n        tenant = ctx.tenants.by_slug(args.tenant)\n        result = escalate(ctx.service, ctx.relay, settings, tenant, args.ticket, args.reason, args.actor)\n    except (TenantError, TicketError, EscalationError) as e:\n        print(str(e), file=sys.stderr)\n        return 1\n    finally:\n        ctx.conn.close()\n    print(f\"{result.tenant} #{result.number}: {result.status}; \"\n          f\"hook={'delivered' if result.delivered else 'FAILED'} \"\n          f\"(delivery_id={result.delivery_id}); \"\n          f\"on-call={'delivered' if result.oncall_delivered else 'FAILED'}\")\n    if result.hook_error:\n        print(f\"tenant hook: {result.hook_error}\", file=sys.stderr)\n    if result.oncall_error:\n        print(f\"on-call: {result.oncall_error}\", file=sys.stderr)\n    return 0 if result.delivered and result.oncall_delivered else 1\n\n\n''' + s[pos:]\npos = s.index('    od = sub.add_parser(')\ns = s[:pos] + '''    e = sub.add_parser(\"escalate\", help=\"escalate a ticket and notify the tenant and on-call\")\n    e.add_argument(\"--tenant\", required=True); e.add_argument(\"--ticket\", required=True, type=int)\n    e.add_argument(\"--reason\", required=True); e.add_argument(\"--actor\", default=\"cli\")\n    e.set_defaults(func=cmd_escalate)\n\n''' + s[pos:]\np.write_text(s)\np = Path('deskline/notification.py')\ns = p.read_text().replace('import json\\n', 'import json\\nfrom http.client import HTTPException\\n')\ns = s.replace('            raise RelayError(f\"relay unreachable at {self.base_url}: {e.reason}\") from e\\n', '            raise RelayError(f\"relay unreachable at {self.base_url}: {e.reason}\") from e\\n        except (OSError, HTTPException) as e:\\n            raise RelayError(f\"relay unreachable at {self.base_url}: {e}\") from e\\n')\np.write_text(s)\nPY\n"]
