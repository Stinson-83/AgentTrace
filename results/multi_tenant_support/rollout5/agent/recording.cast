[217.31724, "i", "python - <<'PY'\nimport base64\nimport json\nfrom pathlib import Path\nfrom deskline.config import load_settings\nfrom deskline.tenant_store import TenantStore\nfrom deskline.ticket_store import TicketStore, open_connection\n\nreason = 'SLA breached, customer chasing'\nfor destination in ('northwind', '_channels/oncall'):\n    folder = Path('/var/lib/notify-relay/received') / destination\n    matches = []\n    for path in sorted(folder.glob('*.json')):\n        record = json.loads(path.read_text())\n        event = json.loads(base64.b64decode(record['body_b64']))\n        if (event.get('event') == 'ticket.escalated' and event.get('tenant') == 'northwind'\n                and event.get('ticket', {}).get('number') == 1042\n                and event.get('escalation', {}).get('reason') == reason):\n            matches.append((path, record, event))\n    assert matches, destination\n    path, record, event = matches[-1]\n    assert event['ticket']['status'] == 'escalated'\n    assert event['escalation']['latest_internal_note'] != f'Escalated by cli: {reason}'\n    if destination == 'northwind':\n        assert all(row['tenant'] == 'northwind' for row in event['escalation']['queue'])\n        assert record['headers']['x-deskline-tenant'] == 'northwind'\n    else:\n        assert any(row['tenant'] != 'northwind' for row in event['escalation']['queue'])\n    print(f\"Verified {record['path']}: {path.name}; related={len(event['escalation']['related'])}, queue={len(event['escalation']['queue'])}\")\n\nsettings = load_settings()\nwith open_connection(settings.db_path) as conn:\n    tickets, tenants = TicketStore(conn), TenantStore(conn)\n    tenant = tenants.by_slug('northwind')\n    ticket = tickets.get_ticket(tenant.tenant_id, 1042)\n    note = tickets.notes_for(ticket.ticket_id)[-1]\n    assert ticket.status == 'escalated'\n    assert note.author == 'cli' and note.visibility == 'internal'\n    assert note.body == f'Escalated by cli: {reason}'\n    print(f'Verified persisted ticket: {tenant.slug} #{ticket.number}, status={ticket.status}, internal note #{note.note_id}')\nPY\n"]
