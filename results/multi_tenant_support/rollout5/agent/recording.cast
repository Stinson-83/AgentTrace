[110.513867, "i", "cat > tests/test_escalation_workflow.py <<'PY'\nfrom copy import deepcopy\nfrom dataclasses import replace\nfrom datetime import datetime\n\nimport pytest\n\nfrom deskline import cli\nfrom deskline.escalation import EscalationError, escalate, escalation_queue, sla_status\nfrom deskline.notification import RelayError, RelayResponse\n\n\nclass RecordingRelay:\n    def __init__(self, hook_error=None, oncall_error=None, hook_status=202, oncall_status=202):\n        self.hook_error = hook_error\n        self.oncall_error = oncall_error\n        self.hook_status = hook_status\n        self.oncall_status = oncall_status\n        self.hooks = []\n        self.channels = []\n\n    def post(self, tenant, event):\n        self.hooks.append((tenant, deepcopy(event)))\n        if self.hook_error:\n            raise RelayError(self.hook_error)\n        return RelayResponse(self.hook_status, {\"delivery_id\": \"hook-123\"})\n\n    def post_channel(self, channel, event):\n        self.channels.append((channel, deepcopy(event)))\n        if self.oncall_error:\n            raise RelayError(self.oncall_error)\n        return RelayResponse(self.oncall_status, {\"delivery_id\": \"channel-456\"})\n\n\ndef test_escalate_context_and_updates(db, settings, service):\n    conn, tenants, tickets = db\n    tenant = tenants.by_slug(\"northwind\")\n    view = service.view(tenant.tenant_id, 1042)  # warm the cache\n    other_ticket = tickets.get_ticket(\"ten_hl\", 1042)\n    notes = tickets.notes_for(view.ticket.ticket_id)\n    relay = RecordingRelay()\n    result = escalate(service, relay, settings, tenant, 1042, \"Customer chasing\", actor=\"alex\")\n\n    assert (result.tenant, result.number, result.status) == (\"northwind\", 1042, \"escalated\")\n    assert result.delivered and result.oncall_delivered and result.delivery_id == \"hook-123\"\n    assert result.hook_error is None and result.oncall_error is None\n    assert relay.hooks[0][0] == tenant\n    assert relay.channels[0][0] == settings.oncall_channel\n    hook, channel = relay.hooks[0][1], relay.channels[0][1]\n    for event in (hook, channel):\n        assert event[\"event\"] == \"ticket.escalated\" and event[\"tenant\"] == \"northwind\"\n        assert event[\"actor\"] == \"alex\"\n        now = datetime.fromisoformat(event[\"occurred_at\"].replace(\"Z\", \"+00:00\"))\n        assert now.utcoffset().total_seconds() == 0\n        assert event[\"ticket\"] == {\"number\": 1042, \"subject\": view.ticket.subject,\n                                   \"status\": \"escalated\", \"priority\": \"high\", \"customer\": \"Dev Patel\"}\n        context = event[\"escalation\"]\n        assert context[\"reason\"] == \"Customer chasing\"\n        assert context[\"latest_internal_note\"] == view.latest_internal_note.body\n        assert context[\"sla\"] == sla_status(view.ticket, settings, now).as_dict()\n        assert all({\"number\", \"subject\", \"status\", \"priority\", \"customer\", \"last_internal_note\"} <= r.keys()\n                   for r in context[\"related\"])\n        assert not any(r[\"tenant\"] == \"northwind\" and r[\"number\"] == 1042 for r in context[\"queue\"])\n    assert channel[\"escalation\"][\"related\"] == service.related(view.ticket)\n    assert any(r[\"tenant\"] == \"harbourline\" and r[\"number\"] == 1042 for r in channel[\"escalation\"][\"queue\"])\n    assert all(r[\"tenant\"] == \"northwind\" for r in hook[\"escalation\"][\"queue\"])\n    assert hook[\"escalation\"][\"related\"] == service.related(view.ticket, tenant_id=tenant.tenant_id)\n    assert any(r[\"number\"] == 1018 for r in hook[\"escalation\"][\"related\"])\n\n    refreshed = service.view(tenant.tenant_id, 1042)\n    assert refreshed.ticket.status == \"escalated\"\n    added = tickets.notes_for(view.ticket.ticket_id)[len(notes):]\n    assert len(added) == 1 and added[0].visibility == \"internal\" and added[0].author == \"alex\"\n    assert \"alex\" in added[0].body and \"Customer chasing\" in added[0].body\n    assert refreshed.latest_internal_note == added[0]\n    assert tickets.get_ticket(\"ten_hl\", 1042) == other_ticket\n    # The status and note are committed, not only visible in the workflow's connection.\n    from deskline.ticket_store import TicketStore, open_connection\n    with open_connection(settings.db_path) "]
[110.514092, "i", "as second:\n        assert TicketStore(second).get_ticket(tenant.tenant_id, 1042).status == \"escalated\"\n        assert TicketStore(second).notes_for(view.ticket.ticket_id)[-1] == added[0]\n\n\ndef test_latest_note_is_fresh_internal_context(db, settings, service):\n    _, tenants, tickets = db\n    tenant = tenants.by_slug(\"northwind\")\n    view = service.view(tenant.tenant_id, 1042)\n    tickets.add_note(view.ticket.ticket_id, \"engineer\", \"Fresh internal context\")\n    tickets.add_note(view.ticket.ticket_id, \"customer\", \"Newer public reply\", \"public\")\n    relay = RecordingRelay()\n    escalate(service, relay, settings, tenant, 1042, \"Investigate\")\n    assert relay.hooks[0][1][\"escalation\"][\"latest_internal_note\"] == \"Fresh internal context\"\n\n\ndef test_no_internal_note(db, settings, service):\n    _, tenants, tickets = db\n    tenant = tenants.by_slug(\"northwind\")\n    ticket = tickets.create_ticket(tenant.tenant_id, \"A unique incident\", \"low\", \"cst_0004\")\n    relay = RecordingRelay()\n    escalate(service, relay, settings, tenant, ticket.number, \"Needs review\")\n    assert relay.hooks[0][1][\"escalation\"][\"latest_internal_note\"] is None\n    assert relay.hooks[0][1][\"actor\"] == \"cli\"\n\n\n@pytest.mark.parametrize(\"status\", [\"resolved\", \"closed\"])\ndef test_terminal_ticket_rejected_even_with_stale_view(db, settings, service, status):\n    _, tenants, tickets = db\n    tenant = tenants.by_slug(\"northwind\")\n    view = service.view(tenant.tenant_id, 1042)\n    before = tickets.update_status(view.ticket.ticket_id, status)\n    notes = tickets.notes_for(before.ticket_id)\n    relay = RecordingRelay()\n    with pytest.raises(EscalationError, match=status):\n        escalate(service, relay, settings, tenant, 1042, \"Not allowed\")\n    assert tickets.get_ticket(tenant.tenant_id, 1042) == before\n    assert tickets.notes_for(before.ticket_id) == notes\n    assert not relay.hooks and not relay.channels\n\n\n@pytest.mark.parametrize(\"number\", [1055, 99999])\ndef test_wrong_tenant_or_unknown_ticket_has_no_side_effects(db, settings, service, number):\n    conn, tenants, _ = db\n    before = conn.total_changes\n    relay = RecordingRelay()\n    with pytest.raises(EscalationError, match=\"not found\"):\n        escalate(service, relay, settings, tenants.by_slug(\"northwind\"), number, \"No\")\n    assert conn.total_changes == before\n    assert not relay.hooks and not relay.channels\n\n\n@pytest.mark.parametrize(\"status\", [\"open\", \"pending\", \"escalated\"])\ndef test_active_statuses_can_be_escalated(db, settings, service, status):\n    _, tenants, tickets = db\n    ticket = tickets.get_ticket(\"ten_nw\", 1042)\n    tickets.update_status(ticket.ticket_id, status)\n    assert escalate(service, RecordingRelay(), settings, tenants.by_slug(\"northwind\"), 1042, \"Review\").delivered\n\n\n@pytest.mark.parametrize(\"hook_fails,oncall_fails\", [(True, False), (False, True), (True, True)])\ndef test_delivery_errors_are_returned_and_updates_stand(db, settings, service, hook_fails, oncall_fails):\n    _, tenants, tickets = db\n    relay = RecordingRelay(\"hook unreachable\" if hook_fails else None,\n                           \"channel rejected (422)\" if oncall_fails else None)\n    result = escalate(service, relay, settings, tenants.by_slug(\"northwind\"), 1042, \"Review\")\n    assert result.delivered == (not hook_fails)\n    assert result.oncall_delivered == (not oncall_fails)\n    assert result.delivery_id == (None if hook_fails else \"hook-123\")\n    assert result.hook_error == relay.hook_error and result.oncall_error == relay.oncall_error\n    assert len(relay.hooks) == len(relay.channels) == 1\n    assert service.view(\"ten_nw\", 1042).ticket.status == \"escalated\"\n    assert \"Review\" in service.view(\"ten_nw\", 1042).latest_internal_note.body\n\n\ndef test_nonaccepted_responses_are_failures(db, settings, service):\n    _, tenants, _ = db\n    relay = RecordingRelay(hook_status=422, oncall_status=503)\n    result = escalate(service, relay, settings, tenants.by_slug(\"northwind\"), 1042, \"Review\")\n    assert not result.delivered and not result.oncall_delivered and result.delivery_id is None\n    assert \"422\" in result.hook_error and \"503\" in"]
[110.514205, "i", " result.oncall_error\n\n\ndef test_tenant_scoping_happens_before_limits(db, settings, service):\n    _, tenants, tickets = db\n    tenant = tenants.by_slug(\"northwind\")\n    source = tickets.get_ticket(tenant.tenant_id, 1042)\n    own = tickets.create_ticket(tenant.tenant_id, source.subject, \"normal\", source.customer_id)\n    tickets.add_note(own.ticket_id, \"agent\", \"Our tenant context\")\n    tickets.update_status(own.ticket_id, \"escalated\")\n    foreign = []\n    for _ in range(7):\n        ticket = tickets.create_ticket(\"ten_hl\", source.subject, \"high\", \"cst_0001\")\n        tickets.add_note(ticket.ticket_id, \"agent\", \"FOREIGN PRIVATE CONTEXT\")\n        tickets.update_status(ticket.ticket_id, \"escalated\")\n        foreign.append(ticket.ticket_id)\n    relay = RecordingRelay()\n    escalate(service, relay, settings, tenant, 1042, \"Review\")\n    hook_context = relay.hooks[0][1][\"escalation\"]\n    assert any(r[\"number\"] == own.number for r in hook_context[\"related\"])\n    assert any(r[\"number\"] == own.number for r in hook_context[\"queue\"])\n    assert all(r[\"tenant\"] == \"northwind\" for r in hook_context[\"queue\"])\n    assert \"FOREIGN PRIVATE CONTEXT\" not in str(relay.hooks)\n    assert \"FOREIGN PRIVATE CONTEXT\" in str(relay.channels)\n    assert len(escalation_queue(service, settings, tenant_id=tenant.tenant_id, limit=1)) == 1\n\n\n@pytest.fixture\ndef cli_setup(db, settings, monkeypatch):\n    relay = RecordingRelay()\n    monkeypatch.setattr(cli, \"load_settings\", lambda: settings)\n    monkeypatch.setattr(cli, \"NotificationRelayClient\", lambda *args: relay)\n    return relay\n\n\n@pytest.mark.parametrize(\"actor\", [None, \"jordan\"])\ndef test_cli_success(cli_setup, capsys, actor):\n    args = [\"escalate\", \"--tenant\", \"northwind\", \"--ticket\", \"1042\", \"--reason\", \"Customer chasing\"]\n    if actor:\n        args += [\"--actor\", actor]\n    assert cli.main(args) == 0\n    out = capsys.readouterr()\n    assert \"northwind #1042: escalated\" in out.out and \"hook-123\" in out.out\n    assert \"on-call=delivered\" in out.out and not out.err\n    assert cli_setup.hooks[0][1][\"actor\"] == (actor or \"cli\")\n\n\n@pytest.mark.parametrize(\"tenant,number\", [(\"unknown\", 1042), (\"northwind\", 1055)])\ndef test_cli_unknown_records(cli_setup, capsys, tenant, number):\n    assert cli.main([\"escalate\", \"--tenant\", tenant, \"--ticket\", str(number), \"--reason\", \"Review\"]) != 0\n    assert capsys.readouterr().err\n    assert not cli_setup.hooks and not cli_setup.channels\n\n\ndef test_cli_terminal_ticket(db, cli_setup, capsys):\n    _, _, tickets = db\n    ticket = tickets.get_ticket(\"ten_nw\", 1042)\n    tickets.update_status(ticket.ticket_id, \"closed\")\n    assert cli.main([\"escalate\", \"--tenant\", \"northwind\", \"--ticket\", \"1042\", \"--reason\", \"Review\"]) != 0\n    assert \"closed\" in capsys.readouterr().err\n    assert not cli_setup.hooks and not cli_setup.channels\n\n\n@pytest.mark.parametrize(\"destination\", [\"hook\", \"oncall\"])\ndef test_cli_delivery_failure(cli_setup, capsys, destination):\n    setattr(cli_setup, destination + \"_error\", \"relay unreachable\")\n    assert cli.main([\"escalate\", \"--tenant\", \"northwind\", \"--ticket\", \"1042\", \"--reason\", \"Review\"]) != 0\n    out = capsys.readouterr()\n    assert \"escalated\" in out.out and \"FAILED\" in out.out\n    assert \"relay unreachable\" in out.err\n    assert len(cli_setup.hooks) == len(cli_setup.channels) == 1\n\n\n@pytest.mark.parametrize(\"missing\", [\"--tenant\", \"--ticket\", \"--reason\"])\ndef test_cli_requires_arguments(missing):\n    args = [\"escalate\", \"--tenant\", \"northwind\", \"--ticket\", \"1042\", \"--reason\", \"Review\"]\n    index = args.index(missing)\n    del args[index:index + 2]\n    with pytest.raises(SystemExit) as exc:\n        cli.build_parser().parse_args(args)\n    assert exc.value.code == 2\nPY\npython -m pytest -q tests\n"]
[110.514385, "o", "cat > tests/test_escalation_workflow.py <<'PY'\r\n\u001b[?2004l\r"]
[110.514496, "o", "\u001b[?2004h> "]
[110.51457, "o", "from copy import deepcopy\r\n\u001b[?2004l\r"]
[110.514616, "o", "\u001b[?2004h> "]
[110.514814, "o", "from dataclasses import replace\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.514853, "o", "from datetime import datetime\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.514908, "o", "> \r\n\u001b[?2004l\rd"]
[110.514963, "o", "\u001b[?2004h> import pytest\r\n\u001b[?2004l\r"]
[110.514996, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[110.515009, "o", "\u001b[?2004h"]
[110.515017, "o", "> "]
[110.515139, "o", "from deskline import cli\r\n\u001b[?2004l\r"]
[110.515189, "o", "\u001b[?2004h> "]
[110.515561, "o", "from deskline.escalation import EscalationError, escalate, escalation_queue, sla_status\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.515708, "o", "from deskline.notification import RelayError, RelayResponse\r\n\u001b[?2004l\r"]
[110.515822, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.515938, "o", "class RecordingRelay:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.516294, "o", "    def __init__(self, hook_error=None, oncall_error=None, hook_status=202, oncall_status=202):\r\n\u001b[?2004l\r"]
[110.516368, "o", "\u001b[?2004h> "]
[110.516459, "o", "        self.hook_error = hook_error\r\n\u001b[?2004l\r"]
[110.516503, "o", "\u001b[?2004h> "]
[110.516645, "o", "        self.oncall_error = oncall_error\r\n\u001b[?2004l\r"]
[110.516686, "o", "\u001b[?2004h> "]
[110.51683, "o", "        self.hook_status = hook_status\r\n\u001b[?2004l\r"]
[110.516874, "o", "\u001b[?2004h> "]
[110.517036, "o", "        self.oncall_status = oncall_status\r\n\u001b[?2004l\r"]
[110.517123, "o", "\u001b[?2004h> "]
[110.517187, "o", "        self.hooks = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.517282, "o", "        self.channels = []\r\n\u001b[?2004l\r"]
[110.51737, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rt"]
[110.517426, "o", "\u001b[?2004h> "]
[110.517468, "o", "    def post(self, tenant, event):\r\n\u001b[?2004l\r"]
[110.517511, "o", "\u001b[?2004h> "]
[110.517687, "o", "        self.hooks.append((tenant, deepcopy(event)))\r\n\u001b[?2004l\r"]
[110.517733, "o", "\u001b[?2004h> "]
[110.517827, "o", "        if self.hook_error:\r\n\u001b[?2004l\r"]
[110.517871, "o", "\u001b[?2004h> "]
[110.518021, "o", "            raise RelayError(self.hook_error)\r\n\u001b[?2004l\r"]
[110.518063, "o", "\u001b[?2004h> "]
[110.518318, "o", "        return RelayResponse(self.hook_status, {\"delivery_id\": \"hook-123\"})\r\n\u001b[?2004l\r"]
[110.518359, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[110.518399, "o", "> "]
[110.518532, "o", "    def post_channel(self, channel, event):\r\n\u001b[?2004l\r"]
[110.518573, "o", "\u001b[?2004h> "]
[110.518767, "o", "        self.channels.append((channel, deepcopy(event)))\r\n\u001b[?2004l\r"]
[110.518834, "o", "\u001b[?2004h> "]
[110.518908, "o", "        if self.oncall_error:\r\n\u001b[?2004l\r"]
[110.518952, "o", "\u001b[?2004h> "]
[110.519133, "o", "            raise RelayError(self.oncall_error)\r\n\u001b[?2004l\r"]
[110.519195, "o", "\u001b[?2004h> "]
[110.519465, "o", "        return RelayResponse(self.oncall_status, {\"delivery_id\": \"channel-456\"})\r\n\u001b[?2004l\r"]
[110.519511, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[110.519602, "o", "> \r\n\u001b[?2004l\r"]
[110.519669, "o", "\u001b[?2004h> "]
[110.519804, "o", "def test_escalate_context_and_updates(db, settings, service):\r\n\u001b[?2004l\r"]
[110.519865, "o", "\u001b[?2004h> "]
[110.519987, "o", "    conn, tenants, tickets = db\r\n\u001b[?2004l\r"]
[110.520032, "o", "\u001b[?2004h> "]
[110.52018, "o", "    tenant = tenants.by_slug(\"northwind\")\r\n\u001b[?2004l\r"]
[110.520222, "o", "\u001b[?2004h> "]
[110.520465, "o", "    view = service.view(tenant.tenant_id, 1042)  # warm the cache\r\n\u001b[?2004l\r"]
[110.520508, "o", "\u001b[?2004h> "]
[110.520687, "o", "    other_ticket = tickets.get_ticket(\"ten_hl\", 1042)\r\n\u001b[?2004l\r"]
[110.520734, "o", "\u001b[?2004h> "]
[110.520936, "o", "    notes = tickets.notes_for(view.ticket.ticket_id)\r\n\u001b[?2004l\r"]
[110.520978, "o", "\u001b[?2004h> "]
[110.521069, "o", "    relay = RecordingRelay()\r\n\u001b[?2004l\r"]
[110.521109, "o", "\u001b[?2004h> "]
[110.521495, "o", "    result = escalate(service, relay, settings, tenant, 1042, \"Customer chasing\", actor=\"alex\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[110.521537, "o", "\u001b[?2004h> "]
[110.521883, "o", "    assert (result.tenant, result.number, result.status) == (\"northwind\", 1042, \"escalated\")\r\n\u001b[?2004l\r"]
[110.521924, "o", "\u001b[?2004h> "]
[110.522267, "o", "    assert result.delivered and result.oncall_delivered and result.delivery_id == \"hook-123\"\r\n\u001b[?2004l\r"]
[110.522307, "o", "\u001b[?2004h> "]
[110.522558, "o", "    assert result.hook_error is None and result.oncall_error is None\r\n\u001b[?2004l\r"]
[110.522599, "o", "\u001b[?2004h> "]
[110.522733, "o", "    assert relay.hooks[0][0] == tenant\r\n\u001b[?2004l\r"]
[110.522773, "o", "\u001b[?2004h> "]
[110.522988, "o", "    assert relay.channels[0][0] == settings.oncall_channel\r\n\u001b[?2004l\r"]
[110.523029, "o", "\u001b[?2004h> "]
[110.523236, "o", "    hook, channel = relay.hooks[0][1], relay.channels[0][1]\r\n\u001b[?2004l\r"]
[110.523277, "o", "\u001b[?2004h> "]
[110.523389, "o", "    for event in (hook, channel):\r\n\u001b[?2004l\r"]
[110.52343, "o", "\u001b[?2004h> "]
[110.523778, "o", "        assert event[\"event\"] == \"ticket.escalated\" and event[\"tenant\"] == \"northwind\"\r\n\u001b[?2004l\r"]
[110.52385, "o", "\u001b[?2004h> "]
[110.523926, "o", "        assert event[\"actor\"] == \"alex\"\r\n\u001b[?2004l\r"]
[110.523968, "o", "\u001b[?2004h> "]
[110.524249, "o", "        now = datetime.fromisoformat(event[\"occurred_at\"].replace(\"Z\", \"+00:00\"))\r\n\u001b[?2004l\r"]
[110.5243, "o", "\u001b[?2004h> "]
[110.524478, "o", "        assert now.utcoffset().total_seconds() == 0\r\n\u001b[?2004l\r"]
[110.524514, "o", "\u001b[?2004h> "]
[110.524863, "o", "        assert event[\"ticket\"] == {\"number\": 1042, \"subject\": view.ticket.subject,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.525212, "o", "                                   \"status\": \"escalated\", \"priority\": \"high\", \"customer\": \"Dev Patel\"}\r\n\u001b[?2004l\r"]
[110.525236, "o", "\u001b[?2004h"]
[110.525259, "o", "> "]
[110.525382, "o", "        context = event[\"escalation\"]\r\n"]
[110.525402, "o", "\u001b[?2004l\r\u001b[?2004h"]
[110.525417, "o", "> "]
[110.525613, "o", "        assert context[\"reason\"] == \"Customer chasing\"\r\n"]
[110.52563, "o", "\u001b[?2004l\r"]
[110.525647, "o", "\u001b[?2004h> "]
[110.525976, "o", "        assert context[\"latest_internal_note\"] == view.latest_internal_note.body\r\n\u001b[?2004l\r"]
[110.526033, "o", "\u001b[?2004h> "]
[110.526316, "o", "        assert context[\"sla\"] == sla_status(view.ticket, settings, now).as_dict()\r\n\u001b[?2004l\r"]
[110.526352, "o", "\u001b[?2004h> "]
[110.52684, "o", "        assert all({\"number\", \"subject\", \"status\", \"priority\", \"customer\", \"last_internal_note\"} <= r.keys()\r\n\u001b[?2004l\r"]
[110.526921, "o", "\u001b[?2004h> "]
[110.527039, "o", "                   for r in context[\"related\"])\r\n\u001b[?2004l\r"]
[110.527101, "o", "\u001b[?2004h> "]
[110.527552, "o", "        assert not any(r[\"tenant\"] == \"northwind\" and r[\"number\"] == 1042 for r in context[\"queue\"])\r\n\u001b[?2004l\r"]
[110.527636, "o", "\u001b[?2004h"]
[110.527701, "o", "> "]
[110.527951, "o", "    assert channel[\"escalation\"][\"related\"] == service.related(view.ticket)\r\n"]
[110.528002, "o", "\u001b[?2004l\r"]
[110.528052, "o", "\u001b[?2004h> "]
[110.528505, "o", "    assert any(r[\"tenant\"] == \"harbourline\" and r[\"number\"] == 1042 for r in channel[\"escalation\"][\"queue\"])\r\n\u001b[?2004l\r"]
[110.528594, "o", "\u001b[?2004h> "]
[110.528935, "o", "    assert all(r[\"tenant\"] == \"northwind\" for r in hook[\"escalation\"][\"queue\"])\r\n\u001b[?2004l\r"]
[110.528986, "o", "\u001b[?2004h> "]
[110.529508, "o", "    assert hook[\"escalation\"][\"related\"] == service.related(view.ticket, tenant_id=tenant.tenant_id)\r\n\u001b[?2004l\r"]
[110.529559, "o", "\u001b[?2004h> "]
[110.529887, "o", "    assert any(r[\"number\"] == 1018 for r in hook[\"escalation\"][\"related\"])\r\n\u001b[?2004l\r"]
[110.52996, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[110.530004, "o", "\u001b[?2004h> "]
[110.530212, "o", "    refreshed = service.view(tenant.tenant_id, 1042)\r\n"]
[110.530255, "o", "\u001b[?2004l\r"]
[110.530297, "o", "\u001b[?2004h> "]
[110.530493, "o", "    assert refreshed.ticket.status == \"escalated\"\r\n"]
[110.53053, "o", "\u001b[?2004l\r"]
[110.530569, "o", "\u001b[?2004h> "]
[110.530874, "o", "    added = tickets.notes_for(view.ticket.ticket_id)[len(notes):]\r\n\u001b[?2004l\r"]
[110.530918, "o", "\u001b[?2004h"]
[110.530962, "o", "> "]
[110.531407, "o", "    assert len(added) == 1 and added[0].visibility == \"internal\" and added[0].author == \"alex\"\r\n"]
[110.531465, "o", "\u001b[?2004l\r"]
[110.53151, "o", "\u001b[?2004h> "]
[110.531831, "o", "    assert \"alex\" in added[0].body and \"Customer chasing\" in added[0].body\r\n\u001b[?2004l\r"]
[110.531881, "o", "\u001b[?2004h> "]
[110.532131, "o", "    assert refreshed.latest_internal_note == added[0]\r\n"]
[110.53217, "o", "\u001b[?2004l\r"]
[110.532208, "o", "\u001b[?2004h> "]
[110.532441, "o", "    assert tickets.get_ticket(\"ten_hl\", 1042) == other_ticket\r\n\u001b[?2004l\r"]
[110.532475, "o", "\u001b[?2004h> "]
[110.532772, "o", "    # The status and note are committed, not only visible in the workflow's connection.\r\n\u001b[?2004l\r"]
[110.532823, "o", "\u001b[?2004h> "]
[110.533043, "o", "    from deskline.ticket_store import TicketStore, open_connection\r\n"]
[110.533069, "o", "\u001b[?2004l\r"]
[110.533096, "o", "\u001b[?2004h> "]
[110.533262, "o", "    with open_connection(settings.db_path) as second:\r\n"]
[110.533287, "o", "\u001b[?2004l\r"]
[110.533315, "o", "\u001b[?2004h> "]
[110.533607, "o", "        assert TicketStore(second).get_ticket(tenant.tenant_id, 1042).status == \"escalated\"\r\n\u001b[?2004l\r"]
[110.533649, "o", "\u001b[?2004h> "]
[110.533934, "o", "        assert TicketStore(second).notes_for(view.ticket.ticket_id)[-1] == added[0]\r\n\u001b[?2004l\r"]
[110.533974, "o", "\u001b[?2004h"]
[110.534004, "o", "> "]
[110.534036, "o", "\r\n\u001b[?2004l\r"]
[110.534063, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[110.534094, "o", "\u001b[?2004h> "]
[110.534317, "o", "def test_latest_note_is_fresh_internal_context(db, settings, service):\r\n\u001b[?2004l\r"]
[110.534355, "o", "\u001b[?2004h> "]
[110.534449, "o", "    _, tenants, tickets = db\r\n"]
[110.534476, "o", "\u001b[?2004l\r"]
[110.534506, "o", "\u001b[?2004h> "]
[110.534622, "o", "    tenant = tenants.by_slug(\"northwind\")\r\n\u001b[?2004l\r"]
[110.534647, "o", "\u001b[?2004h"]
[110.534669, "o", "> "]
[110.53482, "o", "    view = service.view(tenant.tenant_id, 1042)\r\n"]
[110.534854, "o", "\u001b[?2004l\r"]
[110.53488, "o", "\u001b[?2004h> "]
[110.535135, "o", "    tickets.add_note(view.ticket.ticket_id, \"engineer\", \"Fresh internal context\")\r\n\u001b[?2004l\r"]
[110.535189, "o", "\u001b[?2004h> "]
[110.535489, "o", "    tickets.add_note(view.ticket.ticket_id, \"customer\", \"Newer public reply\", \"public\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.535565, "o", "> "]
[110.53561, "o", "    relay = RecordingRelay()\r\n\u001b[?2004l\r"]
[110.535648, "o", "\u001b[?2004h> "]
[110.535886, "o", "    escalate(service, relay, settings, tenant, 1042, \"Investigate\")\r\n"]
[110.535912, "o", "\u001b[?2004l\r"]
[110.535936, "o", "\u001b[?2004h> "]
[110.536297, "o", "    assert relay.hooks[0][1][\"escalation\"][\"latest_internal_note\"] == \"Fresh internal context\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.536335, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[110.536367, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[110.536399, "o", "> "]
[110.536535, "o", "def test_no_internal_note(db, settings, service):\r\n"]
[110.536571, "o", "\u001b[?2004l\r"]
[110.536577, "o", "\u001b[?2004h> "]
[110.53667, "o", "    _, tenants, tickets = db\r\n"]
[110.5367, "o", "\u001b[?2004l\r"]
[110.536724, "o", "\u001b[?2004h> "]
[110.53685, "o", "    tenant = tenants.by_slug(\"northwind\")\r\n\u001b[?2004l\r"]
[110.536882, "o", "\u001b[?2004h> "]
[110.537197, "o", "    ticket = tickets.create_ticket(tenant.tenant_id, \"A unique incident\", \"low\", \"cst_0004\")\r\n\u001b[?2004l\r"]
[110.537226, "o", "\u001b[?2004h> "]
[110.537327, "o", "    relay = RecordingRelay()\r\n\u001b[?2004l\r"]
[110.537353, "o", "\u001b[?2004h"]
[110.537382, "o", "> "]
[110.537625, "o", "    escalate(service, relay, settings, tenant, ticket.number, \"Needs review\")\r\n\u001b[?2004l\r"]
[110.537655, "o", "\u001b[?2004h> "]
[110.537916, "o", "    assert relay.hooks[0][1][\"escalation\"][\"latest_internal_note\"] is None\r\n\u001b[?2004l\r"]
[110.53795, "o", "\u001b[?2004h> "]
[110.538108, "o", "    assert relay.hooks[0][1][\"actor\"] == \"cli\"\r\n\u001b[?2004l\r"]
