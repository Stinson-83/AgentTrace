[167.722425, "i", "cat > tests/test_notification.py <<'PY'\nimport io\nimport json\nimport urllib.error\nfrom http.client import RemoteDisconnected\nfrom unittest.mock import MagicMock\n\nimport pytest\n\nfrom deskline.notification import NotificationRelayClient, RelayError\n\n\n@pytest.mark.parametrize(\"destination\", [\"hook\", \"channel\"])\ndef test_relay_request(db, monkeypatch, destination):\n    _, tenants, _ = db\n    tenant = tenants.by_slug(\"northwind\")\n    event = {\"event\": \"ticket.escalated\", \"ticket\": {\"number\": 1042}}\n    response = MagicMock()\n    response.__enter__.return_value = response\n    response.status = 202\n    response.read.return_value = b'{\"delivery_id\": \"dl_test\"}'\n    requests = []\n\n    def urlopen(request, timeout):\n        requests.append((request, timeout))\n        return response\n\n    monkeypatch.setattr(\"deskline.notification.urllib.request.urlopen\", urlopen)\n    client = NotificationRelayClient(\"http://relay.test/\", timeout_sec=3)\n    result = client.post(tenant, event) if destination == \"hook\" else client.post_channel(\"/channels/test\", event)\n    request, timeout = requests[0]\n    headers = {k.lower(): v for k, v in request.header_items()}\n    assert timeout == 3 and request.method == \"POST\"\n    assert json.loads(request.data) == event\n    assert headers[\"content-type\"] == \"application/json\"\n    assert headers[\"x-deskline-event\"] == \"ticket.escalated\"\n    assert result.status == 202 and result.body[\"delivery_id\"] == \"dl_test\"\n    if destination == \"hook\":\n        assert request.full_url == \"http://relay.test\" + tenant.escalation_hook\n        assert headers[\"x-deskline-tenant\"] == \"northwind\"\n    else:\n        assert request.full_url == \"http://relay.test/channels/test\"\n        assert \"x-deskline-tenant\" not in headers\n\n\n@pytest.mark.parametrize(\"destination\", [\"hook\", \"channel\", \"health\"])\n@pytest.mark.parametrize(\"failure\", [\"rejected\", \"unreachable\", \"timeout\", \"disconnected\"])\ndef test_relay_errors_are_normalized(db, monkeypatch, destination, failure):\n    _, tenants, _ = db\n    errors = {\n        \"rejected\": urllib.error.HTTPError(\"http://relay.test\", 422, \"Invalid\", {}, io.BytesIO(b'invalid event')),\n        \"unreachable\": urllib.error.URLError(\"connection refused\"),\n        \"timeout\": TimeoutError(\"timed out\"),\n        \"disconnected\": RemoteDisconnected(\"connection closed\"),\n    }\n\n    def urlopen(*args, **kwargs):\n        raise errors[failure]\n\n    monkeypatch.setattr(\"deskline.notification.urllib.request.urlopen\", urlopen)\n    client = NotificationRelayClient(\"http://relay.test\")\n    with pytest.raises(RelayError) as exc:\n        if destination == \"hook\":\n            client.post(tenants.by_slug(\"northwind\"), {\"event\": \"ticket.escalated\"})\n        elif destination == \"channel\":\n            client.post_channel(\"/channels/oncall\", {\"event\": \"ticket.escalated\"})\n        else:\n            client.health()\n    assert \"relay\" in str(exc.value)\n    if failure == \"rejected\":\n        assert \"422\" in str(exc.value)\n    else:\n        assert \"unreachable\" in str(exc.value)\nPY\npython - <<'PY'\nfrom pathlib import Path\np = Path('README.md')\ns = p.read_text().replace('| `sla-report --tenant', '| `escalate --tenant <slug> --ticket <number> --reason \"<text>\" [--actor <name>]` | mark a ticket escalated, record an internal note, and notify the tenant and deskline on-call |\\n| `sla-report --tenant')\ns += '''\n### Escalating a ticket\n\n```\npython -m deskline.cli escalate --tenant northwind --ticket 1042 --reason \"SLA breached, customer chasing\"\n```\n\nThe command reports the new status, tenant-hook delivery ID, and separate hook/on-call delivery\noutcomes. It exits non-zero for unknown tenants/tickets, resolved/closed tickets, or either delivery\nfailure. Delivery failures do **not** undo the escalation or its internal note; the relay error is\nprinted to stderr and both destinations are attempted independently. Avoid blindly retrying: a\nretry adds another escalation note and may duplicate a delivery that already succeeded.\n'''\np.write_text(s)\np = Path('docs/escalation_notifications.md')\ns = p.read_text()\ns += '''\n## Context boundaries and delive"]
[167.722459, "i", "ry outcomes\n\nContext is captured before changing the ticket or writing the escalation note. The queue therefore\nshows tickets already waiting, rather than adding this new escalation to its own context.\n\nThe example queue above illustrates the **deskline on-call** event. That internal destination gets\nthe desk-wide related-ticket panel and escalation queue. Tenant hooks must not disclose other\ntenants' data (see `tenancy.md`): their `related` and `queue` contain only tickets belonging to the\nrecipient tenant. Tenant filtering happens **before** the usual five-row limits, so foreign tickets\ndo not crowd out the recipient's own context. The desk-wide CLI panel and hourly digest are unchanged.\n\n`escalate()` returns separate `delivered` (hook) and `oncall_delivered` flags. `delivery_id` is the\nhook relay response's ID, or null if the hook failed. `hook_error` and `oncall_error` carry relay\nfailure messages; the CLI prints these to stderr and exits non-zero if either delivery failed.\nBoth destinations are attempted even when the first fails, and the ticket update remains committed.\n'''\np.write_text(s)\np = Path('deskline/escalation.py')\ns = p.read_text().replace('terms, with the context the panel shows (customer, last internal note).\"\"\"', 'terms, with the context the panel shows (customer, last internal note).\\n        ``tenant_id`` restricts tenant-facing context before the search limit is applied.\"\"\"')\ns = s.replace('most recent activity first, with the context the digest shows (tenant, customer, SLA, latest note).\"\"\"', 'most recent activity first, with the context the digest shows (tenant, customer, SLA, latest note).\\n    ``tenant_id`` restricts tenant-facing context before the queue limit is applied.\"\"\"')\np.write_text(s)\np = Path('tests/test_escalation_workflow.py')\ns = p.read_text().replace('from dataclasses import replace\\n', '').replace('    conn, tenants, tickets = db\\n', '    _, tenants, tickets = db\\n', 1)\ns = s.replace('        assert context[\"sla\"] == sla_status(view.ticket, settings, now).as_dict()\\n', '        expected_sla = sla_status(view.ticket, settings, now).as_dict()\\n        assert context[\"sla\"] == {**expected_sla, \"age_hours\": pytest.approx(expected_sla[\"age_hours\"], abs=0.01)}\\n')\ns = s.replace('    foreign = []\\n', '').replace('        foreign.append(ticket.ticket_id)\\n', '')\np.write_text(s)\nPY\npython -m pytest -q tests > /tmp/deskline-tests.log 2>&1; tail -70 /tmp/deskline-tests.log\n"]
