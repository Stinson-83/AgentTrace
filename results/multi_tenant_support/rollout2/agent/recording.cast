[179.745754, "i", "python - <<'PY'\nimport json\nfrom pathlib import Path\nfrom deskline.config import load_settings\nfrom deskline.escalation import TicketService\nfrom deskline.tenant_store import TenantStore\nfrom deskline.ticket_store import TicketStore, open_connection\nconn = open_connection(load_settings().db_path)\nservice = TicketService(TicketStore(conn), TenantStore(conn))\nview = service.view('ten_nw', 1042)\nsnapshot = {'latest_internal_note': view.latest_internal_note.body if view.latest_internal_note else None,\n            'deliveries': [p.name for p in Path('/var/lib/notify-relay/received/northwind').glob('*.json')]}\nPath('/tmp/northwind-escalation-before.json').write_text(json.dumps(snapshot))\nconn.close()\nPY\npython -m deskline.cli escalate --tenant northwind --ticket 1042 --reason \"SLA breached, customer chasing\" > /tmp/northwind-escalation-result.json; status=$?; cat /tmp/northwind-escalation-result.json; echo \"CLI exit status: $status\"\n"]
