[68.486319, "o", "    except (TenantError, TicketError, EscalationError) as exc:\r\n\u001b[?2004l\r\u001b[?2004h>         print(str(exc), file=sys.stderr)\r\n\u001b[?2004l\r\u001b[?2004h>         return 1\r\n\u001b[?2004l\r\u001b[?2004h>     finally:\r\n\u001b[?2004l\r\u001b[?2004h>         ctx.conn.close()\r\n\u001b[?2004l\r\u001b[?2004h>     print(json.dumps(result.__dict__, indent=2))\r\n\u001b[?2004l\r\u001b[?2004h>     if not result.delivered:\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"ticket escalated but notification delivery failed: {result.error}\", file=sys.stderr)\r\n\u001b[?2004l\r\u001b[?2004h>         return 1\r\n\u001b[?2004l\r\u001b[?2004h>     return 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
