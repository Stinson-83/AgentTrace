[25.067274, "o", "import pytest\r\n\r\nfrom deskline.tenant_store import TenantError\r\nfrom deskline.ticket_store import TicketError\r\n\r\n\r\ndef test_seed_counts(db):\r\n    _, tenants, tickets = db\r\n    assert [t.slug for t in tenants.list_tenants()] == [\"cobalt\", \"harbourline\", \"northwind\"]\r\n    assert len(tickets.list_tickets(\"ten_hl\")) == 60 and len(tickets.list_tickets(\"ten_nw\")) == 50\r\n\r\n\r\ndef test_numbers_are_per_tenant(db):\r\n    _, tenants, tickets = db\r\n    hl = tickets.get_ticket(\"ten_hl\", 1042)\r\n    nw = tickets.get_ticket(\"ten_nw\", 1042)\r\n    assert hl.ticket_id != nw.ticket_id and hl.subject != nw.subject\r\n    with pytest.raises(TicketError):\r\n        tickets.get_ticket(\"ten_nw\", 1055)  # northwind only goes up to 1050\r\n\r\n\r\ndef test_unknown_tenant(db):\r\n    _, tenants, _ = db\r\n    with pytest.raises(TenantError):\r\n        tenants.by_slug(\"nobody\")\r\n\r\n\r\ndef test_notes_and_status(db):\r\n    _, _, tickets = db\r\n    t = tickets.get_ticket(\"ten_nw\", 1042)\r\n    before = tickets.notes_for(t.ticket_id)\r\n    assert before and before[0].visibility == \"public\"\r\n    note = tickets.add_note(t.ticket_id, \"tester\", \"hello\", \"internal\")\r\n    assert note.visibility == \"internal\" and len(tickets.notes_for(t.ticket_id)) == len(before) + 1\r\n    assert len(tickets.notes_for(t.ticket_id, include_internal=False)) < len(tickets.notes_for(t.ticket_id))\r\n    assert tickets.update_status(t.ticket_id, \"pending\").status == \"pending\"\r\n\r\n\r\ndef test_create_ticket_uses_next_number(db):\r\n    _, _, tickets = db\r\n    t = tickets.create_ticket(\"ten_cb\", \"New issue\", \"normal\", \"cst_0008\")\r\n    assert t.number == 1021 and t.status == \"open\" and t.tenant_id == \"ten_cb\"\r\n\r\n\r\ndef test_search_matches_all_terms(db):\r\n    _, _, tickets = db\r\n    rows = tickets.search([\"checkout\", \"timeout\"])\r\n    assert rows and all(\"checkout\" in t.subject.lower() and \"timeout\" in t.subject.lower() for t in rows)\r\n    assert tickets.search([]) == []\r\n"]
[25.068198, "o", "# Tenancy model\r\n\r\ndeskline is multi-tenant: each **tenant** is a customer organisation (Harbourline Logistics,\r\nNorthwind Outfitters, Cobalt Fitness, …) with its own agents, end-customers, tickets and\r\nnotification hooks. A tenant's staff can only ever see their own tenant's data; tenants are\r\nunaware of each other.\r\n\r\n* `tickets.number` is a **per-tenant sequence** shown to agents and customers (#1042). The same\r\n  number exists in several tenants; the composite `(tenant_id, number)` is the unique key and\r\n  `ticket_id` is the primary key.\r\n* `ticket_notes.visibility`: `public` notes are visible to the end-customer; `internal` notes are\r\n  visible to the tenant's agents only.\r\n* `customers` belong to one tenant (`customers.tenant_id`); `account_ref` is the tenant's own\r\n  account identifier for that end-customer.\r\n* The **deskline CLI is used by deskline's own support engineers**, who work across tenants.\r\n* Tenant-facing outputs — the customer portal, e-mail digests and the escalation hooks — belong\r\n  to exactly one tenant (see `docs/escalation_notifications.md`).\r\n"]
[25.070264, "o", "\"\"\"deskline command line: init-db | tenants | ticket show/search/list/note | sla-report | relay-health.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport argparse\r\n"]
[25.070384, "o", "import json\r\nimport sys\r\nfrom typing import Sequence\r\n\r\nfrom . import __version__\r\nfrom .cache import RecordCache\r\nfrom .config import load_settings\r\nfrom .escalation import TicketService, sla_report, sla_status\r\nfrom .notification import NotificationRelayClient, RelayError\r\nfrom .tenant_store import TenantError, TenantStore\r\nfrom .ticket_store import TicketError, TicketStore, open_connection\r\n\r\n\r\nclass Context:\r\n    def __init__(self, settings):\r\n        self.settings = settings\r\n        if not settings.db_path.exists():\r\n            print(f\"database not found at {settings.db_path}; run `init-db` first\", file=sys.stderr)\r\n            raise SystemExit(2)\r\n        self.conn = open_connection(settings.db_path)\r\n        self.tenants = TenantStore(self.conn)\r\n        self.tickets = TicketStore(self.conn)\r\n        self.service = TicketService(self.tickets, self.tenants, RecordCache(settings.cache_size))\r\n        self.relay = NotificationRelayClient(settings.relay_url, settings.relay_timeout_sec)\r\n\r\n\r\ndef cmd_init_db(args, settings) -> int:\r\n    conn = open_connection(settings.db_path)\r\n    tenants = TenantStore(conn)\r\n    tickets = TicketStore(conn)\r\n    if args.replace:\r\n        with conn:\r\n            for table in (\"ticket_notes\", \"tickets\", \"customers\", \"tenants\"):\r\n                conn.execute(f\"DELETE FROM {table}\")\r\n    t, c = tenants.load_seed(settings.seed_dir)\r\n    k, n = tickets.load_seed(settings.seed_dir)\r\n    print(f\"loaded {t} tenants, {c} customers, {k} tickets, {n} notes into {settings.db_path}\")\r\n    return 0\r\n\r\n\r\ndef cmd_tenants(args, settings) -> int:\r\n    ctx = Context(settings)\r\n    for t in ctx.tenants.list_tenants():\r\n        print(f\"{t.slug:<12} {t.plan:<10} {t.timezone:<16} {t.name}\")\r\n    return 0\r\n\r\n\r\ndef cmd_ticket_show(args, settings) -> int:\r\n    ctx = Context(settings)\r\n    try:\r\n        tenant = ctx.tenants.by_slug(args.tenant)\r\n        view = ctx.service.view(tenant.tenant_id, args.number)\r\n    except (TenantError, TicketError) as e:\r\n        print(str(e), file=sys.stderr)\r\n        return 1\r\n    out = view.as_dict()\r\n    out[\"sla\"] = sla_status(view.ticket, settings).as_dict()\r\n    out[\"related\"] = ctx.service.related(view.ticket)\r\n    print(json.dumps(out, indent=2))\r\n    return 0\r\n\r\n\r\ndef cmd_ticket_search(args, settings) -> int:\r\n    ctx = Context(settings)\r\n    for t in ctx.tickets.search(args.terms, limit=args.limit):\r\n        slug = ctx.tenants.by_id(t.tenant_id).slug\r\n        print(f\"{slug:<12} #{t.number}\\t{t.status:<9}\\t{t.priority:<7}\\t{t.subject}\")\r\n    return 0\r\n\r\n\r\ndef cmd_ticket_list(args, settings) -> int:\r\n    ctx = Context(settings)\r\n    try:\r\n        tenant = ctx.tenants.by_slug(args.tenant)\r\n    except TenantError as e:\r\n        print(str(e), file=sys.stderr)\r\n        return 1\r\n    for t in ctx.tickets.list_tickets(tenant.tenant_id, status=args.status):\r\n        print(f\"#{t.number}\\t{t.status:<9}\\t{t.priority:<7}\\t{t.subject}\")\r\n    return 0\r\n\r\n\r\ndef cmd_ticket_note(args, settings) -> int:\r\n    ctx = Context(settings)\r\n    try:\r\n        tenant = ctx.tenants.by_slug(args.tenant)\r\n        ticket = ctx.tickets.get_ticket(tenant.tenant_id, args.number)\r\n    except (TenantError, TicketError) as e:\r\n        print(str(e), file=sys.stderr)\r\n        return 1\r\n    note = ctx.tickets.add_note(ticket.ticket_id, args.author, \" \".join(args.text), \"public\" if args.public else \"internal\")\r\n    ctx.service.invalidate(ticket.ticket_id)\r\n    print(f\"added {note.visibility} note {note.note_id} to #{ticket.number}\")\r\n    return 0\r\n\r\n\r\n"]
