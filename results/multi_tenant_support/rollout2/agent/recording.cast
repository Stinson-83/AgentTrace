[149.082867, "o", "from deskline.notification import NotificationRelayClient, RelayError\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.082908, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.083058, "o", "def test_post_routes_to_tenant_hook(db, monkeypatch):\r\n\u001b[?2004l\r"]
[149.083098, "o", "\u001b[?2004h> "]
[149.083202, "o", "    tenant = db[1].by_slug(\"northwind\")\r\n\u001b[?2004l\r"]
[149.08324, "o", "\u001b[?2004h> "]
[149.083325, "o", "    response = MagicMock()\r\n\u001b[?2004l\r"]
[149.083365, "o", "\u001b[?2004h> "]
[149.083426, "o", "    response.status = 202\r\n\u001b[?2004l\r"]
[149.083464, "o", "\u001b[?2004h> "]
[149.083651, "o", "    response.read.return_value = b'{\"delivery_id\":\"dl_transport\"}'\r\n\u001b[?2004l\r"]
[149.083689, "o", "\u001b[?2004h> "]
[149.083815, "o", "    response.__enter__.return_value = response\r\n\u001b[?2004l\r"]
[149.083853, "o", "\u001b[?2004h> "]
[149.084178, "o", "    event = {\"event\": \"ticket.escalated\", \"ticket\": {\"number\": 1042}, \"escalation\": {\"reason\": \"Chasing — urgent\"}}\r\n\u001b[?2004l\r"]
[149.084231, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[149.084274, "o", "> "]
[149.084339, "o", "    def urlopen(request, timeout):\r\n\u001b[?2004l\r"]
[149.084378, "o", "\u001b[?2004h> "]
[149.084592, "o", "        assert request.full_url == \"http://relay.test\" + tenant.escalation_hook\r\n\u001b[?2004l\r"]
[149.084629, "o", "\u001b[?2004h> "]
[149.084778, "o", "        assert request.method == \"POST\" and timeout == 2\r\n\u001b[?2004l\r"]
[149.084815, "o", "\u001b[?2004h> "]
[149.084996, "o", "        headers = {k.lower(): v for k, v in request.header_items()}\r\n\u001b[?2004l\r"]
[149.085034, "o", "\u001b[?2004h> "]
[149.085193, "o", "        assert headers[\"content-type\"] == \"application/json\"\r\n\u001b[?2004l\r"]
[149.085232, "o", "\u001b[?2004h> "]
[149.085394, "o", "        assert headers[\"x-deskline-tenant\"] == \"northwind\"\r\n\u001b[?2004l\r"]
[149.085433, "o", "\u001b[?2004h> "]
[149.085603, "o", "        assert headers[\"x-deskline-event\"] == \"ticket.escalated\"\r\n\u001b[?2004l\r"]
[149.085642, "o", "\u001b[?2004h> "]
[149.085769, "o", "        assert json.loads(request.data) == event\r\n\u001b[?2004l\r"]
[149.085807, "o", "\u001b[?2004h> "]
[149.085866, "o", "        return response\r\n\u001b[?2004l\r"]
[149.085904, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[149.085942, "o", "\u001b[?2004h> "]
[149.086129, "o", "    monkeypatch.setattr(\"urllib.request.urlopen\", urlopen)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.086414, "o", "    result = NotificationRelayClient(\"http://relay.test/\", 2).post(tenant, event)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.086603, "o", "    assert result.status == 202 and result.body[\"delivery_id\"] == \"dl_transport\"\r\n\u001b[?2004l\r"]
[149.086645, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[149.086683, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[149.086721, "o", "> "]
[149.086823, "o", "@pytest.mark.parametrize(\"error,message\", [\r\n\u001b[?2004l\r"]
[149.086861, "o", "\u001b[?2004h> "]
[149.08713, "o", "    (HTTPError(\"http://relay.test\", 422, \"invalid\", {}, io.BytesIO(b'{\"error\":\"bad event\"}')), \"422\"),\r\n\u001b[?2004l\r"]
[149.087169, "o", "\u001b[?2004h> "]
[149.087311, "o", "    (URLError(\"connection refused\"), \"unreachable\"),\r\n\u001b[?2004l\r"]
[149.08735, "o", "\u001b[?2004h> "]
[149.087457, "o", "    (TimeoutError(\"timed out\"), \"timed out\"),\r\n\u001b[?2004l\r"]
[149.087495, "o", "\u001b[?2004h> "]
[149.087669, "o", "    (RemoteDisconnected(\"connection closed\"), \"connection closed\"),\r\n\u001b[?2004l\r"]
[149.087707, "o", "\u001b[?2004h> ])\r\n\u001b[?2004l\r"]
[149.087879, "o", "\u001b[?2004h> "]
[149.087986, "o", "def test_post_wraps_transport_errors(db, monkeypatch, error, message):\r\n\u001b[?2004l\r"]
[149.088035, "o", "\u001b[?2004h> "]
[149.088077, "o", "    def urlopen(*args, **kwargs):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.088164, "o", "        raise error\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.088223, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.08837, "o", "    monkeypatch.setattr(\"urllib.request.urlopen\", urlopen)\r\n\u001b[?2004l\r"]
[149.088437, "o", "\u001b[?2004h> "]
[149.088539, "o", "    with pytest.raises(RelayError, match=message):\r\n\u001b[?2004l\r"]
[149.088594, "o", "\u001b[?2004h> "]
[149.08888, "o", "        NotificationRelayClient(\"http://relay.test\").post(db[1].by_slug(\"northwind\"), {\"event\": \"ticket.escalated\"})\r\n\u001b[?2004l\r"]
[149.088922, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[149.088962, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[149.089001, "o", "> "]
[149.08914, "o", "@pytest.mark.parametrize(\"raw\", [b\"not json\", b\"[]\", b\"null\"])\r\n\u001b[?2004l\r"]
[149.089179, "o", "\u001b[?2004h> "]
[149.089342, "o", "def test_post_rejects_invalid_response(db, monkeypatch, raw):\r\n\u001b[?2004l\r"]
[149.089396, "o", "\u001b[?2004h"]
[149.089467, "o", "> "]
[149.089529, "o", "    response = MagicMock()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.089574, "o", "    response.status = 202\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.089613, "o", "> "]
[149.089687, "o", "    response.read.return_value = raw\r\n\u001b[?2004l\r"]
[149.089726, "o", "\u001b[?2004h> "]
[149.089848, "o", "    response.__enter__.return_value = response\r\n\u001b[?2004l\r"]
[149.089886, "o", "\u001b[?2004h> "]
[149.090104, "o", "    monkeypatch.setattr(\"urllib.request.urlopen\", lambda *args, **kwargs: response)\r\n\u001b[?2004l\r"]
[149.090147, "o", "\u001b[?2004h> "]
[149.090234, "o", "    with pytest.raises(RelayError):\r\n\u001b[?2004l\r"]
[149.090282, "o", "\u001b[?2004h> "]
[149.09059, "o", "        NotificationRelayClient(\"http://relay.test\").post(db[1].by_slug(\"northwind\"), {\"event\": \"ticket.escalated\"})\r\n\u001b[?2004l\r"]
