[196.648028, "i", "python - <<'PY'\nimport base64\nimport json\nfrom pathlib import Path\nfrom deskline.config import load_settings\nfrom deskline.escalation import TicketService\nfrom deskline.tenant_store import TenantStore\nfrom deskline.ticket_store import TicketStore, open_connection\nbefore = json.loads(Path('/tmp/northwind-escalation-before.json').read_text())\nresult = json.loads(Path('/tmp/northwind-escalation-result.json').read_text())\nnew_files = [p for p in Path('/var/lib/notify-relay/received/northwind').glob('*.json') if p.name not in before['deliveries']]\nassert len(new_files) == 1, new_files\nrecord_path = new_files[0]\nrecord = json.loads(record_path.read_text())\nevent = json.loads(base64.b64decode(record['body_b64']))\nassert record['hook_tenant'] == 'northwind'\nassert record['path'] == '/hooks/northwind/escalations'\nassert record['headers']['x-deskline-tenant'] == 'northwind'\nassert record['headers']['x-deskline-event'] == 'ticket.escalated'\nassert event['event'] == 'ticket.escalated' and event['tenant'] == 'northwind'\nassert event['ticket']['number'] == 1042 and event['ticket']['status'] == 'escalated'\nassert event['escalation']['reason'] == 'SLA breached, customer chasing'\nassert event['escalation']['latest_internal_note'] == before['latest_internal_note']\nassert result['delivered'] and result['delivery_id'] == 'dl_1f9accd96241'\nconn = open_connection(load_settings().db_path)\nservice = TicketService(TicketStore(conn), TenantStore(conn))\nview = service.view('ten_nw', 1042)\nassert view.ticket.status == 'escalated'\nassert view.latest_internal_note.visibility == 'internal'\nassert view.latest_internal_note.author == 'cli'\nassert 'SLA breached, customer chasing' in view.latest_internal_note.body\nassert event['escalation']['related'] == service.related(view.ticket)\nfor related in event['escalation']['related']:\n    own = service.view('ten_nw', related['number'])\n    assert related['customer'] == own.customer.name\n    assert related['subject'] == own.ticket.subject\n    assert related['last_internal_note'] == (own.latest_internal_note.body if own.latest_internal_note else None)\nprint('Verified delivery:', result['delivery_id'])\nprint('Stored request:', record_path)\nprint('Ticket status:', view.ticket.status)\nprint('Audit note:', view.latest_internal_note.body)\nprint('Verified pre-escalation note and', len(event['escalation']['related']), 'tenant-scoped related tickets')\nconn.close()\nPY\npython -m pytest -q tests > /tmp/deskline-final-tests.txt 2>&1; cat /tmp/deskline-final-tests.txt\n"]
