[115.864864, "o", "    _, tenants, tickets = db\r\n\u001b[?2004l\r"]
[115.864913, "o", "\u001b[?2004h> "]
[115.865056, "o", "    tenant = tenants.by_slug(\"northwind\")\r\n\u001b[?2004l\r"]
[115.86511, "o", "\u001b[?2004h> "]
[115.865258, "o", "    before = service.view(tenant.tenant_id, 1042)\r\n\u001b[?2004l\r"]
[115.865306, "o", "\u001b[?2004h> "]
[115.865453, "o", "    relay = RecordingRelay(response, error)\r\n\u001b[?2004l\r"]
[115.865519, "o", "\u001b[?2004h> "]
[115.865736, "o", "    result = escalate(service, relay, settings, tenant, 1042, \"urgent\")\r\n"]
[115.865796, "o", "\u001b[?2004l\r"]
[115.865879, "o", "\u001b[?2004h> "]
[115.866017, "o", "    assert result.status == \"escalated\" and not result.delivered\r\n\u001b[?2004l\r"]
[115.866064, "o", "\u001b[?2004h> "]
[115.866299, "o", "    assert result.delivery_id is None and message in result.error\r\n\u001b[?2004l\r"]
[115.866382, "o", "\u001b[?2004h> "]
[115.866659, "o", "    after = service.view(tenant.tenant_id, 1042)\r\n\u001b[?2004l\r\u001b[?2004h>     assert after.ticket.status == \"escalated\"\r\n\u001b[?2004l\r \"unreachable\" in result[\"error\"] and \"unreachable\" in captured.err\r\n    ticket = db[2"]
[115.86673, "o", "\u001b[?2004h> "]
[115.866875, "o", "    assert len(after.notes) == len(before.notes) + 1\r\n\u001b[?2004l\r"]
[115.866908, "o", "\u001b[?2004h> "]
[115.8671, "o", "    assert after.latest_internal_note.author == \"cli\"\r\n\u001b[?2004l\r"]
[115.867127, "o", "\u001b[?2004h> "]
[115.867465, "o", "    assert relay.calls[0][1][\"escalation\"][\"latest_internal_note\"] == before.latest_internal_note.body\r\n\u001b[?2004l\r"]
[115.867498, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[115.867534, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[115.867549, "o", "\u001b[?2004h> "]
[115.867716, "o", "def test_escalate_without_internal_note(db, settings, service):\r\n\u001b[?2004l\r"]
[115.867747, "o", "\u001b[?2004h> "]
[115.867833, "o", "    _, tenants, tickets = db\r\n\u001b[?2004l\r"]
[115.868188, "o", "\u001b[?2004h>     tenant = tenants.by_slug(\"northwind\")\r\n\u001b[?2004l\r\u001b[?2004h>     customer = service.view(tenant.tenant_id, 1042).customer\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.868465, "o", "    ticket = tickets.create_ticket(tenant.tenant_id, \"Unique flibbertigibbet\", \"low\", customer.customer_id)\r\n\u001b[?2004l\r"]
[115.868544, "o", "\u001b[?2004h> "]
[115.868711, "o", "    tickets.add_note(ticket.ticket_id, \"customer\", \"Public only\", \"public\")\r\n\u001b[?2004l\r"]
[115.868775, "o", "\u001b[?2004h> "]
[115.86882, "o", "    relay = RecordingRelay()\r\n\u001b[?2004l\r"]
[115.868919, "o", "\u001b[?2004h> "]
[115.869094, "o", "    assert escalate(service, relay, settings, tenant, ticket.number, \"please review\").delivered\r\n\u001b[?2004l\r"]
[115.869118, "o", "\u001b[?2004h> "]
[115.869226, "o", "    event = relay.calls[0][1]\r\n"]
[115.869534, "o", "\u001b[?2004l\r\u001b[?2004h>     assert event[\"actor\"] == \"cli\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.869611, "o", "    assert event[\"escalation\"][\"latest_internal_note\"] is None\r\n\u001b[?2004l\r"]
[115.869663, "o", "\u001b[?2004h>     assert event[\"escalation\"][\"related\"] == []\r\n\u001b[?2004l\r"]
[115.869685, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
