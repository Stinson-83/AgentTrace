[115.869797, "o", "def test_related_filters_tenant_before_limit(db, service):\r\n\u001b[?2004l\r"]
[115.869818, "o", "\u001b[?2004h> "]
[115.869894, "o", "    _, _, tickets = db\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.869946, "o", "    own = tickets.get_ticket(\"ten_nw\", 1042)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.870022, "o", "    foreign = tickets.get_ticket(\"ten_hl\", 1042)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.870043, "o", "    for _ in range(7):\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.870105, "o", "> "]
[115.870448, "o", "        other = tickets.create_ticket(foreign.tenant_id, own.subject, \"high\", foreign.customer_id)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.870533, "o", "        tickets.add_note(other.ticket_id, \"foreign-agent\", \"Other tenant confidential context\", \"internal\")\r\n\u001b[?2004l\r\u001b[?2004h>     related = service.related(own, limit=1)\r\n\u001b[?2004l\r\u001b[?2004h>     assert len(related) == 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.870605, "o", "    assert related[0][\"number\"] == 1018\r\n\u001b[?2004l\r\u001b[?2004h>     # The desk-wide support search remains desk-wide.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.87072, "o", "    assert tickets.search(subject_terms(own.subject), limit=1)[0].tenant_id == foreign.tenant_id\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[115.873377, "o", "\u001b[?2004hroot@1d09b8137982:/app# "]
[115.874007, "o", "cat > tests/test_cli.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> import pytest\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> from deskline import cli\r\n\u001b[?2004l\r\u001b[?2004h> from deskline.notification import NotificationRelayClient, RelayError, RelayResponse\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.fixture\r\n\u001b[?2004l\r\u001b[?2004h> def cli_setup(db, settings, monkeypatch):\r\n\u001b[?2004l\r\u001b[?2004h>     monkeypatch.setattr(cli, \"load_settings\", lambda: settings)\r\n\u001b[?2004l\r\u001b[?2004h>     calls = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def post(self, tenant, event):\r\n\u001b[?2004l\r\u001b[?2004h>         calls.append((tenant, event))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.874102, "o", "        return RelayResponse(202, {\"delivery_id\": \"dl_cli\"})\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.874189, "o", "    monkeypatch.setattr(NotificationRelayClient, \"post\", post)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.874266, "o", "    return calls\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.874401, "o", "@pytest.mark.parametrize(\"actor_args,actor\", [([], \"cli\"), ([\"--actor\", \"sam\"], \"sam\")])\r\n\u001b[?2004l\r"]
[115.87446, "o", "\u001b[?2004h> "]
[115.874517, "o", "def test_cli_escalate_success(cli_setup, capsys, actor_args, actor):\r\n\u001b[?2004l\r"]
[115.87456, "o", "\u001b[?2004h> "]
[115.874701, "o", "    code = cli.main([\"escalate\", \"--tenant\", \"northwind\", \"--ticket\", \"1042\", \"--reason\", \"needs on-call\"] + actor_args)\r\n\u001b[?2004l\r"]
[115.87475, "o", "\u001b[?2004h> "]
[115.874766, "o", "    captured = capsys.readouterr()\r\n\u001b[?2004l\r"]
[115.87478, "o", "\u001b[?2004h> "]
[115.874866, "o", "    assert code == 0 and captured.err == \"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.874937, "o", "    result = json.loads(captured.out)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.875026, "o", "    assert result[\"delivered\"] is True and result[\"delivery_id\"] == \"dl_cli\"\r\n\u001b[?2004l\r"]
[115.875044, "o", "\u001b[?2004h> "]
[115.875145, "o", "    assert result[\"tenant\"] == \"northwind\" and result[\"status\"] == \"escalated\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.875164, "o", "> "]
[115.875221, "o", "    assert cli_setup[0][1][\"actor\"] == actor\r\n\u001b[?2004l\r"]
[115.875278, "o", "\u001b[?2004h> "]
[115.875348, "o", "    assert cli_setup[0][1][\"escalation\"][\"reason\"] == \"needs on-call\"\r\n\u001b[?2004l\r"]
[115.875416, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.875473, "o", "@pytest.mark.parametrize(\"tenant,number,status,message\", [\r\n\u001b[?2004l\r"]
[115.875525, "o", "\u001b[?2004h> "]
[115.875548, "o", "    (\"nobody\", \"1042\", None, \"unknown tenant\"),\r\n\u001b[?2004l\r"]
[115.875562, "o", "\u001b[?2004h> "]
[115.875647, "o", "    (\"northwind\", \"99999\", None, \"not found\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.875738, "o", "    (\"northwind\", \"1055\", None, \"not found\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.87581, "o", "    (\"northwind\", \"1042\", \"resolved\", \"resolved\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
