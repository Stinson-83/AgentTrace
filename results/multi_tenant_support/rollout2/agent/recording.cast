[115.856532, "o", "    assert event[\"ticket\"] == {\"number\": 1042, \"subject\": ticket.subject, \"status\": \"escalated\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.856581, "o", "> "]
[115.856681, "o", "                               \"priority\": original_priority, \"customer\": \"Dev Patel\"}\r\n\u001b[?2004l\r"]
[115.856724, "o", "\u001b[?2004h> "]
[115.856788, "o", "    escalation = event[\"escalation\"]\r\n\u001b[?2004l\r"]
[115.856831, "o", "\u001b[?2004h> "]
[115.856939, "o", "    assert escalation[\"reason\"] == \"SLA breached, customer chasing\"\r\n\u001b[?2004l\r"]
[115.856981, "o", "\u001b[?2004h> "]
[115.857084, "o", "    assert escalation[\"latest_internal_note\"] == context.body\r\n\u001b[?2004l\r"]
[115.857135, "o", "\u001b[?2004h> "]
[115.857272, "o", "    assert set(escalation[\"sla\"]) == {\"priority\", \"target_hours\", \"age_hours\", \"breached\"}\r\n\u001b[?2004l\r"]
[115.857321, "o", "\u001b[?2004h> "]
[115.857423, "o", "    assert escalation[\"sla\"][\"priority\"] == original_priority\r\n\u001b[?2004l\r"]
[115.857465, "o", "\u001b[?2004h> "]
[115.857616, "o", "    assert escalation[\"sla\"][\"target_hours\"] == settings.sla_hours[original_priority]\r\n\u001b[?2004l\r"]
[115.857657, "o", "\u001b[?2004h> "]
[115.857727, "o", "    assert escalation[\"sla\"][\"breached\"] is True\r\n\u001b[?2004l\r"]
[115.857767, "o", "\u001b[?2004h> "]
[115.857864, "o", "    assert escalation[\"related\"] == service.related(ticket)\r\n\u001b[?2004l\r"]
[115.857904, "o", "\u001b[?2004h> "]
[115.858013, "o", "    assert any(r[\"number\"] == 1018 for r in escalation[\"related\"])\r\n\u001b[?2004l\r"]
[115.858053, "o", "\u001b[?2004h> "]
[115.858115, "o", "    for related in escalation[\"related\"]:\r\n\u001b[?2004l\r"]
[115.858155, "o", "\u001b[?2004h> "]
[115.858262, "o", "        own = service.view(tenant.tenant_id, related[\"number\"])\r\n\u001b[?2004l\r"]
[115.858307, "o", "\u001b[?2004h> "]
[115.858402, "o", "        assert related[\"subject\"] == own.ticket.subject\r\n\u001b[?2004l\r"]
[115.858444, "o", "\u001b[?2004h> "]
[115.85853, "o", "        assert related[\"customer\"] == own.customer.name\r\n\u001b[?2004l\r"]
[115.85857, "o", "\u001b[?2004h> "]
[115.858738, "o", "        assert related[\"last_internal_note\"] == (own.latest_internal_note.body if own.latest_internal_note else None)\r\n\u001b[?2004l\r"]
[115.858779, "o", "\u001b[?2004h> "]
[115.858852, "o", "    after = tickets.notes_for(ticket.ticket_id)\r\n\u001b[?2004l\r"]
[115.858892, "o", "\u001b[?2004h> "]
[115.858949, "o", "    assert len(after) == len(before) + 1\r\n\u001b[?2004l\r"]
[115.85899, "o", "\u001b[?2004h> "]
[115.85903, "o", "    audit = after[-1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.859162, "o", "    assert audit.visibility == \"internal\" and audit.author == \"alice\"\r\n\u001b[?2004l\r"]
[115.859202, "o", "\u001b[?2004h> "]
[115.859328, "o", "    assert \"alice\" in audit.body and escalation[\"reason\"] in audit.body\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.859386, "o", "> "]
[115.859462, "o", "    assert tickets.get_ticket(tenant.tenant_id, 1042).priority == original_priority\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.859508, "o", "> "]
[115.859598, "o", "    assert tickets.by_id(foreign_view.ticket.ticket_id) == foreign_view.ticket\r\n\u001b[?2004l\r"]
[115.859638, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\r\n\u001b[?2004h> "]
[115.859727, "o", "@pytest.mark.parametrize(\"status\", [\"resolved\", \"closed\"])\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.859766, "o", "> "]
[115.859861, "o", "def test_terminal_ticket_rejected_without_side_effects(db, settings, service, status):\r\n\u001b[?2004l\r"]
[115.859901, "o", "\u001b[?2004h> "]
[115.859953, "o", "    _, tenants, tickets = db\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.860004, "o", "    tenant = tenants.by_slug(\"northwind\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.86009, "o", "    ticket = tickets.get_ticket(tenant.tenant_id, 1042)\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.86014, "o", "> "]
[115.86022, "o", "    service.view(tenant.tenant_id, 1042)  # stale open view must not bypass validation\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.860258, "o", "> "]
[115.860343, "o", "    ticket = tickets.update_status(ticket.ticket_id, status)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.860415, "o", "    notes = tickets.notes_for(ticket.ticket_id)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.860491, "o", "    relay = RecordingRelay()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.86058, "o", "    with pytest.raises(EscalationError, match=status):\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.86064, "o", "> "]
[115.860745, "o", "        escalate(service, relay, settings, tenant, 1042, \"urgent\")\r\n\u001b[?2004l\r"]
[115.860802, "o", "\u001b[?2004h> "]
[115.860922, "o", "    assert relay.calls == []\r\n\u001b[?2004l\r\u001b[?2004h>     assert tickets.by_id(ticket.ticket_id) == ticket\r\n\u001b[?2004l\r"]
[115.860941, "o", "\u001b[?2004h> "]
[115.861067, "o", "    assert tickets.notes_for(ticket.ticket_id) == notes\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.861123, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r[\u001b[?2004h> "]
[115.861222, "o", "def test_ticket_from_other_tenant_is_not_found(db, settings, service):\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.861252, "o", "> "]
[115.861291, "o", "    _, tenants, tickets = db\r\n\u001b[?2004l\r"]
[115.861331, "o", "\u001b[?2004h> "]
[115.86149, "o", "    # #1055 exists only in Harbourline; do not fall back to a desk-wide lookup.\r\n\u001b[?2004l\r"]
[115.86154, "o", "\u001b[?2004h> "]
[115.861777, "o", "    foreign = tickets.get_ticket(\"ten_hl\", 1055)\r\n\u001b[?2004l\r\u001b[?2004h>     notes = tickets.notes_for(foreign.ticket_id)\r\n\u001b[?2004l\r\u001b[?2004h>     relay = RecordingRelay()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.861962, "o", "    with pytest.raises(EscalationError, match=\"not found\"):\r\n\u001b[?2004l\r"]
[115.862004, "o", "\u001b[?2004h"]
[115.862034, "o", "> "]
[115.86235, "o", "        escalate(service, relay, settings, tenants.by_slug(\"northwind\"), 1055, \"urgent\")\r\n\u001b[?2004l\r"]
[115.862395, "o", "\u001b[?2004h> "]
[115.862477, "o", "    assert relay.calls == []\r\n\u001b[?2004l\r"]
[115.862497, "o", "\u001b[?2004h"]
[115.862518, "o", "> "]
[115.862706, "o", "    assert tickets.by_id(foreign.ticket_id) == foreign\r\n"]
[115.862728, "o", "\u001b[?2004l\r"]
[115.862753, "o", "\u001b[?2004h> "]
[115.862969, "o", "    assert tickets.notes_for(foreign.ticket_id) == notes\r\n\u001b[?2004l\r"]
[115.863006, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[115.863036, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[115.863064, "o", "> "]
[115.863243, "o", "@pytest.mark.parametrize(\"response,error,message\", [\r\n\u001b[?2004l\r"]
[115.863273, "o", "\u001b[?2004h> "]
[115.863505, "o", "    (None, RelayError(\"relay unreachable\"), \"unreachable\"),\r\n\u001b[?2004l\r"]
[115.863542, "o", "\u001b[?2004h> "]
[115.863783, "o", "    (None, RelayError(\"relay rejected the notification (422)\"), \"422\"),\r\n\u001b[?2004l\r"]
[115.863863, "o", "\u001b[?2004h> "]
[115.864032, "o", "    (RelayResponse(503, {\"error\": \"maintenance\"}), None, \"503\"),\r\n\u001b[?2004l\r"]
[115.864097, "o", "\u001b[?2004h> "]
[115.864267, "o", "    (RelayResponse(202, {}), None, \"delivery_id\"),\r\n\u001b[?2004l\r"]
[115.864345, "o", "\u001b[?2004h> ])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.864719, "o", "def test_delivery_failure_keeps_ticket_and_surfaces_error(db, settings, service, response, error, message):\r\n\u001b[?2004l\r"]
