[68.468669, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('deskline/ticket_store.py')\ns = p.read_text().replace('def search(self, terms: list[str], limit: int = 10, exclude_ticket_id: int | None = None)', 'def search(self, terms: list[str], limit: int = 10, exclude_ticket_id: int | None = None, tenant_id: str | None = None)')\ns = s.replace('        params: list = []\\n        for term in terms:', '        params: list = []\\n        if tenant_id is not None:\\n            sql += \" AND tenant_id = ?\"\\n            params.append(tenant_id)\\n        for term in terms:')\np.write_text(s)\np = Path('deskline/escalation.py')\ns = p.read_text().replace('from .notification import NotificationRelayClient', 'from .notification import NotificationRelayClient, RelayError').replace('from .ticket_store import Note, Ticket, TicketStore', 'from .ticket_store import Note, Ticket, TicketError, TicketStore')\ns = s.replace('terms, with the context', \"terms within this tenant, with the context\")\ns = s.replace('exclude_ticket_id=ticket.ticket_id):', 'exclude_ticket_id=ticket.ticket_id, tenant_id=ticket.tenant_id):')\ns = s.replace('    delivery_id: str | None\\n', '    delivery_id: str | None\\n    error: str | None = None\\n')\ns = s.replace('    Not implemented yet — see ticket DL-1187.\\n    \"\"\"\\n    raise NotImplementedError(\"escalation workflow is not implemented yet (DL-1187)\")', '''    Delivery failures are returned in ``error`` with ``delivered=False``; the ticket\n    update and audit note are retained. Validation failures raise EscalationError\n    before any mutation or notification.\n    \"\"\"\n    try:\n        ticket = service.tickets.get_ticket(tenant.tenant_id, number)\n    except TicketError as exc:\n        raise EscalationError(str(exc)) from exc\n    if ticket.tenant_id != tenant.tenant_id:\n        raise EscalationError(f\"ticket #{number} does not belong to tenant {tenant.slug!r}\")\n    if ticket.status in (\"resolved\", \"closed\"):\n        raise EscalationError(f\"ticket #{number} is {ticket.status} and cannot be escalated\")\n\n    # Refresh any cached view before taking the context snapshot. The audit note\n    # below must not replace the agent's last internal note in the notification.\n    service.invalidate(ticket.ticket_id)\n    view = service.view(tenant.tenant_id, number)\n    note = view.latest_internal_note\n    now = datetime.now(timezone.utc)\n    event = {\n        \"event\": \"ticket.escalated\",\n        \"tenant\": tenant.slug,\n        \"occurred_at\": now.isoformat().replace(\"+00:00\", \"Z\"),\n        \"actor\": actor,\n        \"ticket\": {\n            \"number\": ticket.number,\n            \"subject\": ticket.subject,\n            \"status\": \"escalated\",\n            \"priority\": ticket.priority,\n            \"customer\": view.customer.name,\n        },\n        \"escalation\": {\n            \"reason\": reason,\n            \"sla\": sla_status(ticket, settings, now).as_dict(),\n            \"latest_internal_note\": note.body if note else None,\n            \"related\": service.related(ticket),\n        },\n    }\n\n    try:\n        updated = service.tickets.update_status(ticket.ticket_id, \"escalated\")\n        service.tickets.add_note(ticket.ticket_id, actor, f\"Escalated by {actor}: {reason}\", \"internal\")\n    finally:\n        service.invalidate(ticket.ticket_id)\n\n    try:\n        response = relay.post(tenant, event)\n        if response.status != 202:\n            raise RelayError(f\"relay rejected the notification ({response.status}): {response.body}\")\n        delivery_id = response.body.get(\"delivery_id\")\n        if not isinstance(delivery_id, str) or not delivery_id:\n            raise RelayError(\"relay response is missing delivery_id\")\n    except RelayError as exc:\n        return EscalationResult(tenant.slug, number, updated.status, False, None, str(exc))\n    return EscalationResult(tenant.slug, number, updated.status, True, delivery_id)''')\np.write_text(s)\np = Path('deskline/cli.py')\ns = p.read_text().replace('sla-report | relay-health.', 'sla-report | escalate | relay-health.')\ns = s.replace('from .escalation import TicketService, sla_report, sla_status', 'from .escalation import Escalatio"]
[68.468852, "i", "nError, TicketService, escalate, sla_report, sla_status')\ns = s.replace('def cmd_relay_health(args, settings) -> int:', '''def cmd_escalate(args, settings) -> int:\n    ctx = Context(settings)\n    try:\n        tenant = ctx.tenants.by_slug(args.tenant)\n        result = escalate(ctx.service, ctx.relay, settings, tenant, args.ticket, args.reason, args.actor)\n    except (TenantError, TicketError, EscalationError) as exc:\n        print(str(exc), file=sys.stderr)\n        return 1\n    finally:\n        ctx.conn.close()\n    print(json.dumps(result.__dict__, indent=2))\n    if not result.delivered:\n        print(f\"ticket escalated but notification delivery failed: {result.error}\", file=sys.stderr)\n        return 1\n    return 0\n\n\ndef cmd_relay_health(args, settings) -> int:''')\ns = s.replace('    sub.add_parser(\"relay-health\",', '''    e = sub.add_parser(\"escalate\", help=\"escalate a ticket and notify the tenant's on-call\")\n    e.add_argument(\"--tenant\", required=True)\n    e.add_argument(\"--ticket\", required=True, type=int)\n    e.add_argument(\"--reason\", required=True)\n    e.add_argument(\"--actor\", default=\"cli\")\n    e.set_defaults(func=cmd_escalate)\n\n    sub.add_parser(\"relay-health\",''')\np.write_text(s)\np = Path('deskline/notification.py')\ns = p.read_text().replace('import json\\n', 'import json\\nfrom http.client import HTTPException\\n')\ns = s.replace('    def health(self) -> RelayResponse:', '''        except (OSError, HTTPException, ValueError) as e:\n            raise RelayError(f\"relay delivery failed at {self.base_url}: {e}\") from e\n\n    def health(self) -> RelayResponse:''')\np.write_text(s)\np = Path('README.md')\ns = p.read_text().replace('| `relay-health`', '| `escalate --tenant <slug> --ticket <number> --reason \"<text>\" [--actor <name>]` | escalate and notify the tenant on-call |\\n| `relay-health`')\ns += '\\nEscalation prints a JSON result including `delivered`, `delivery_id`, and any delivery `error`.\\nDelivery failures exit non-zero but leave the ticket escalated and its internal audit note saved.\\n'\np.write_text(s)\nPY\npython -m pytest -q tests\n"]
