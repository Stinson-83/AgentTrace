[196.651413, "o", "assert record['path'] == '/hooks/northwind/escalations'\r\n\u001b[?2004l\r"]
[196.651465, "o", "\u001b[?2004h> "]
[196.651567, "o", "assert record['headers']['x-deskline-tenant'] == 'northwind'\r\n\u001b[?2004l\r"]
[196.651619, "o", "\u001b[?2004h> "]
[196.651746, "o", "assert record['headers']['x-deskline-event'] == 'ticket.escalated'\r\n\u001b[?2004l\r"]
[196.651834, "o", "\u001b[?2004h> "]
[196.651933, "o", "assert event['event'] == 'ticket.escalated' and event['tenant'] == 'northwind'\r\n\u001b[?2004l\r"]
[196.651996, "o", "\u001b[?2004h> "]
[196.652129, "o", "assert event['ticket']['number'] == 1042 and event['ticket']['status'] == 'escalated'\r\n\u001b[?2004l\r"]
[196.652187, "o", "\u001b[?2004h> "]
[196.652312, "o", "assert event['escalation']['reason'] == 'SLA breached, customer chasing'\r\n\u001b[?2004l\r"]
[196.65237, "o", "\u001b[?2004h> "]
[196.652483, "o", "assert event['escalation']['latest_internal_note'] == before['latest_internal_note']\r\n\u001b[?2004l\r"]
[196.65254, "o", "\u001b[?2004h> "]
[196.652649, "o", "assert result['delivered'] and result['delivery_id'] == 'dl_1f9accd96241'\r\n\u001b[?2004l\r"]
[196.652703, "o", "\u001b[?2004h> "]
[196.652765, "o", "conn = open_connection(load_settings().db_path)\r\n\u001b[?2004l\r"]
[196.652822, "o", "\u001b[?2004h> "]
[196.65291, "o", "service = TicketService(TicketStore(conn), TenantStore(conn))\r\n\u001b[?2004l\r"]
[196.652963, "o", "\u001b[?2004h> "]
[196.653021, "o", "view = service.view('ten_nw', 1042)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[196.653104, "o", "assert view.ticket.status == 'escalated'\r\n\u001b[?2004l\r"]
[196.653244, "o", "\u001b[?2004h> "]
[196.653325, "o", "assert view.latest_internal_note.visibility == 'internal'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[196.653418, "o", "assert view.latest_internal_note.author == 'cli'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[196.653479, "o", "assert 'SLA breached, customer chasing' in view.latest_internal_note.body\r\n\u001b[?2004l\r\u001b[?2004h"]
[196.653527, "o", "> "]
[196.653587, "o", "assert event['escalation']['related'] == service.related(view.ticket)\r\n\u001b[?2004l\r"]
[196.653632, "o", "\u001b[?2004h> "]
[196.653674, "o", "for related in event['escalation']['related']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[196.653754, "o", "    own = service.view('ten_nw', related['number'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[196.653797, "o", "> "]
[196.65384, "o", "    assert related['customer'] == own.customer.name\r\n\u001b[?2004l\r\u001b[?2004h"]
[196.653883, "o", "> "]
[196.653924, "o", "    assert related['subject'] == own.ticket.subject\r\n\u001b[?2004l\r\u001b[?2004h"]
[196.653967, "o", "> "]
[196.654094, "o", "    assert related['last_internal_note'] == (own.latest_internal_note.body if own.latest_internal_note else None)\r\n\u001b[?2004l\r"]
[196.654136, "o", "\u001b[?2004h> "]
[196.654175, "o", "print('Verified delivery:', result['delivery_id'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[196.654216, "o", "> "]
[196.654257, "o", "print('Stored request:', record_path)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[196.654338, "o", "print('Ticket status:', view.ticket.status)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[196.654398, "o", "print('Audit note:', view.latest_internal_note.body)\r\n\u001b[?2004l\r\u001b[?2004h"]
[196.654439, "o", "> "]
[196.654556, "o", "print('Verified pre-escalation note and', len(event['escalation']['related']), 'tenant-scoped related tickets')\r\n\u001b[?2004l\r\u001b[?2004h"]
[196.654598, "o", "> conn.close()\r\n\u001b[?2004l\r"]
[196.654639, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
