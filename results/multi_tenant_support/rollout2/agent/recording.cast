[129.897604, "o", "root@1d09b8137982:/app# "]
[148.997978, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('deskline/notification.py')\ns = p.read_text().replace('                return RelayResponse(resp.status, json.loads(raw) if raw else {})', '''                body = json.loads(raw) if raw else {}\n                if not isinstance(body, dict):\n                    raise RelayError(\"relay response must be a JSON object\")\n                return RelayResponse(resp.status, body)''').replace('\\n\\n        except (OSError', '\\n        except (OSError')\np.write_text(s)\np = Path('deskline/ticket_store.py')\ns = p.read_text().replace('open/pending/escalated tickets whose subject contains every term, most recent first.', 'open/pending/escalated tickets whose subject contains every term, most recent first.\\n        Pass tenant_id for tenant-facing results; omit it for desk-wide searches.')\np.write_text(s)\np = Path('tests/test_escalation.py')\ns = p.read_text().replace('from datetime import datetime, timezone\\n\\nfrom deskline.escalation import sla_report, sla_status, subject_terms', '''from datetime import datetime, timezone\n\nimport pytest\n\nfrom deskline.escalation import EscalationError, escalate, sla_report, sla_status, subject_terms\nfrom deskline.notification import RelayError, RelayResponse''')\ns = s.replace('\\n\\nimport pytest\\n\\nfrom deskline.escalation import EscalationError, escalate\\nfrom deskline.notification import RelayError, RelayResponse\\n', '')\np.write_text(s)\nPY\ncat > tests/test_notification.py <<'PY'\nimport io\nimport json\nfrom http.client import RemoteDisconnected\nfrom unittest.mock import MagicMock\nfrom urllib.error import HTTPError, URLError\n\nimport pytest\n\nfrom deskline.notification import NotificationRelayClient, RelayError\n\n\ndef test_post_routes_to_tenant_hook(db, monkeypatch):\n    tenant = db[1].by_slug(\"northwind\")\n    response = MagicMock()\n    response.status = 202\n    response.read.return_value = b'{\"delivery_id\":\"dl_transport\"}'\n    response.__enter__.return_value = response\n    event = {\"event\": \"ticket.escalated\", \"ticket\": {\"number\": 1042}, \"escalation\": {\"reason\": \"Chasing — urgent\"}}\n\n    def urlopen(request, timeout):\n        assert request.full_url == \"http://relay.test\" + tenant.escalation_hook\n        assert request.method == \"POST\" and timeout == 2\n        headers = {k.lower(): v for k, v in request.header_items()}\n        assert headers[\"content-type\"] == \"application/json\"\n        assert headers[\"x-deskline-tenant\"] == \"northwind\"\n        assert headers[\"x-deskline-event\"] == \"ticket.escalated\"\n        assert json.loads(request.data) == event\n        return response\n\n    monkeypatch.setattr(\"urllib.request.urlopen\", urlopen)\n    result = NotificationRelayClient(\"http://relay.test/\", 2).post(tenant, event)\n    assert result.status == 202 and result.body[\"delivery_id\"] == \"dl_transport\"\n\n\n@pytest.mark.parametrize(\"error,message\", [\n    (HTTPError(\"http://relay.test\", 422, \"invalid\", {}, io.BytesIO(b'{\"error\":\"bad event\"}')), \"422\"),\n    (URLError(\"connection refused\"), \"unreachable\"),\n    (TimeoutError(\"timed out\"), \"timed out\"),\n    (RemoteDisconnected(\"connection closed\"), \"connection closed\"),\n])\ndef test_post_wraps_transport_errors(db, monkeypatch, error, message):\n    def urlopen(*args, **kwargs):\n        raise error\n\n    monkeypatch.setattr(\"urllib.request.urlopen\", urlopen)\n    with pytest.raises(RelayError, match=message):\n        NotificationRelayClient(\"http://relay.test\").post(db[1].by_slug(\"northwind\"), {\"event\": \"ticket.escalated\"})\n\n\n@pytest.mark.parametrize(\"raw\", [b\"not json\", b\"[]\", b\"null\"])\ndef test_post_rejects_invalid_response(db, monkeypatch, raw):\n    response = MagicMock()\n    response.status = 202\n    response.read.return_value = raw\n    response.__enter__.return_value = response\n    monkeypatch.setattr(\"urllib.request.urlopen\", lambda *args, **kwargs: response)\n    with pytest.raises(RelayError):\n        NotificationRelayClient(\"http://relay.test\").post(db[1].by_slug(\"northwind\"), {\"event\": \"ticket.escalated\"})\nPY\npython -m pytest -q tests > /tmp/deskline-tests.txt 2>&1; cat /tmp/deskline-tests.txt\n"]
