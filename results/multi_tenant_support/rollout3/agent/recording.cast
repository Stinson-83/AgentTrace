[215.665584, "o", "\u001b[32m.\u001b[0m"]
[216.069712, "o", "\u001b[32m.\u001b[0m"]
[216.401891, "o", "\u001b[32m.\u001b[0m"]
[216.715301, "o", "\u001b[32m.\u001b[0m"]
[217.023683, "o", "\u001b[32m.\u001b[0m"]
[217.346328, "o", "\u001b[32m.\u001b[0m"]
[217.722412, "o", "\u001b[32m.\u001b[0m"]
