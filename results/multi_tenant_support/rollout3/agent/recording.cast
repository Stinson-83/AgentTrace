[214.08415, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.084196, "o", "        yield state\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.084253, "o", "    finally:\r\n\u001b[?2004l\r"]
[214.084294, "o", "\u001b[?2004h> "]
[214.084377, "o", "        server.shutdown()\r\n\u001b[?2004l\r"]
[214.084418, "o", "\u001b[?2004h> "]
[214.084516, "o", "        server.server_close()\r\n\u001b[?2004l\r"]
[214.084557, "o", "\u001b[?2004h> "]
[214.084629, "o", "        thread.join()\r\n\u001b[?2004l\r"]
[214.084669, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[214.084707, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[214.084746, "o", "> "]
[214.084848, "o", "def run_cli(settings, url, *args):\r\n\u001b[?2004l\r"]
[214.084899, "o", "\u001b[?2004h> "]
[214.085306, "o", "    env = dict(os.environ, DESKLINE_DB_PATH=str(settings.db_path), NOTIFY_RELAY_URL=url, NOTIFY_RELAY_TIMEOUT=\"1\")\r\n\u001b[?2004l\r"]
[214.085358, "o", "\u001b[?2004h> "]
[214.0857, "o", "    return subprocess.run([sys.executable, \"-m\", \"deskline.cli\", \"escalate\", *args], cwd=ROOT,\r\n\u001b[?2004l\r"]
[214.085757, "o", "\u001b[?2004h> "]
[214.086023, "o", "                          env=env, capture_output=True, text=True, timeout=10)\r\n\u001b[?2004l\r"]
[214.086075, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.086116, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.086455, "o", "@pytest.mark.parametrize(\"actor_args,actor\", [([], \"cli\"), ([\"--actor\", \"Dana\"], \"Dana\")])\r\n\u001b[?2004l\r"]
[214.086507, "o", "\u001b[?2004h> "]
[214.086836, "o", "def test_cli_delivers_contract_to_tenant_hook(db, settings, relay_server, actor_args, actor):\r\n\u001b[?2004l\r"]
[214.086908, "o", "\u001b[?2004h> "]
[214.086988, "o", "    _, _, tickets = db\r\n\u001b[?2004l\r"]
[214.087069, "o", "\u001b[?2004h> "]
[214.087179, "o", "    before = tickets.get_ticket(\"ten_nw\", 1042)\r\n\u001b[?2004l\r"]
[214.087225, "o", "\u001b[?2004h> "]
[214.087625, "o", "    previous_internal = [n for n in tickets.notes_for(before.ticket_id) if n.visibility == \"internal\"][-1].body\r\n\u001b[?2004l\r"]
[214.087672, "o", "\u001b[?2004h> "]
[214.088018, "o", "    result = run_cli(settings, relay_server.url, \"--tenant\", \"northwind\", \"--ticket\", \"1042\",\r\n"]
[214.088066, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[214.08834, "o", "                     \"--reason\", \"SLA breached, customer chasing\", *actor_args)\r\n\u001b[?2004l\r"]
[214.088396, "o", "\u001b[?2004h> "]
[214.08865, "o", "    assert result.returncode == 0, result.stderr\r\n\u001b[?2004l\r"]
[214.088698, "o", "\u001b[?2004h> "]
[214.088827, "o", "    outcome = json.loads(result.stdout)\r\n\u001b[?2004l\r"]
[214.088866, "o", "\u001b[?2004h> "]
[214.089133, "o", "    assert outcome[\"delivered\"] and outcome[\"delivery_id\"] == \"dl_cli_test\"\r\n\u001b[?2004l\r"]
[214.089174, "o", "\u001b[?2004h> "]
[214.089557, "o", "    assert outcome[\"status\"] == \"escalated\" and outcome[\"tenant\"] == \"northwind\" and outcome[\"number\"] == 1042\r\n\u001b[?2004l\r"]
[214.089605, "o", "\u001b[?2004h> "]
[214.089691, "o", "    assert not result.stderr\r\n\u001b[?2004l\r"]
[214.089732, "o", "\u001b[?2004h> "]
[214.089881, "o", "    assert len(relay_server.requests) == 1\r\n\u001b[?2004l\r"]
[214.089925, "o", "\u001b[?2004h> "]
[214.090108, "o", "    path, headers, event = relay_server.requests[0]\r\n\u001b[?2004l\r"]
[214.09015, "o", "\u001b[?2004h> "]
[214.090281, "o", "    assert path == \"/hooks/northwind/escalations\"\r\n\u001b[?2004l\r"]
[214.090323, "o", "\u001b[?2004h> "]
[214.090468, "o", "    assert headers[\"content-type\"] == \"application/json\"\r\n\u001b[?2004l\r"]
[214.090509, "o", "\u001b[?2004h> "]
[214.090652, "o", "    assert headers[\"x-deskline-tenant\"] == \"northwind\"\r\n\u001b[?2004l\r"]
[214.090696, "o", "\u001b[?2004h> "]
[214.090851, "o", "    assert headers[\"x-deskline-event\"] == \"ticket.escalated\"\r\n\u001b[?2004l\r"]
[214.090914, "o", "\u001b[?2004h> "]
[214.091004, "o", "    assert event[\"actor\"] == actor\r\n\u001b[?2004l\r"]
[214.091046, "o", "\u001b[?2004h> "]
[214.091246, "o", "    assert event[\"escalation\"][\"latest_internal_note\"] == previous_internal\r\n\u001b[?2004l\r"]
[214.091288, "o", "\u001b[?2004h> "]
[214.091471, "o", "    assert tickets.get_ticket(\"ten_nw\", 1042).status == \"escalated\"\r\n\u001b[?2004l\r"]
[214.091524, "o", "\u001b[?2004h> "]
[214.091691, "o", "    assert tickets.notes_for(before.ticket_id)[-1].author == actor\r\n\u001b[?2004l\r"]
[214.091734, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[214.091775, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[214.091815, "o", "> "]
[214.092017, "o", "@pytest.mark.parametrize(\"tenant,number,status,error\", [\r\n\u001b[?2004l\r"]
[214.092065, "o", "\u001b[?2004h> "]
[214.092197, "o", "    (\"unknown\", \"1042\", None, \"unknown tenant\"),\r\n\u001b[?2004l\r"]
[214.092239, "o", "\u001b[?2004h> "]
[214.092378, "o", "    (\"northwind\", \"999999\", None, \"not found\"),\r\n\u001b[?2004l\r"]
[214.09243, "o", "\u001b[?2004h> "]
[214.09252, "o", "    (\"northwind\", \"1055\", None, \"not found\"),\r\n\u001b[?2004l\r"]
[214.092561, "o", "\u001b[?2004h> "]
[214.092723, "o", "    (\"northwind\", \"1042\", \"resolved\", \"cannot be escalated\"),\r\n\u001b[?2004l\r"]
[214.092769, "o", "\u001b[?2004h> "]
[214.092974, "o", "    (\"northwind\", \"1042\", \"closed\", \"cannot be escalated\"),\r\n\u001b[?2004l\r"]
[214.093049, "o", "\u001b[?2004h> ])\r\n\u001b[?2004l\r\u001b[?2004h"]
[214.093115, "o", "> "]
[214.093384, "o", "def test_cli_validation_failures_do_not_post(db, settings, relay_server, tenant, number, status, error):\r\n\u001b[?2004l\r"]
[214.093442, "o", "\u001b[?2004h> "]
[214.093503, "o", "    conn, _, tickets = db\r\n\u001b[?2004l\r"]
[214.093567, "o", "\u001b[?2004h>     if status:\r\n\u001b[?2004l\r"]
[214.093613, "o", "\u001b[?2004h> "]
[214.093834, "o", "        tickets.update_status(tickets.get_ticket(\"ten_nw\", 1042).ticket_id, status)\r\n\u001b[?2004l\r"]
[214.093917, "o", "\u001b[?2004h> "]
[214.093966, "o", "    before = list(conn.iterdump())\r\n\u001b[?2004l\r"]
[214.094008, "o", "\u001b[?2004h> "]
[214.09432, "o", "    result = run_cli(settings, relay_server.url, \"--tenant\", tenant, \"--ticket\", number, \"--reason\", \"Help\")\r\n\u001b[?2004l\r"]
[214.094393, "o", "\u001b[?2004h> "]
[214.094522, "o", "    assert result.returncode != 0 and error in result.stderr\r\n\u001b[?2004l\r"]
[214.094583, "o", "\u001b[?2004h> "]
[214.094671, "o", "    assert \"Traceback\" not in result.stderr\r\n\u001b[?2004l\r"]
[214.094714, "o", "\u001b[?2004h> "]
[214.094807, "o", "    assert not relay_server.requests\r\n\u001b[?2004l\r"]
[214.09485, "o", "\u001b[?2004h> "]
[214.094965, "o", "    assert list(conn.iterdump()) == before\r\n\u001b[?2004l\r"]
[214.095007, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[214.095047, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.095299, "o", "def test_cli_relay_rejection_is_visible_but_update_stands(db, settings, relay_server):\r\n\u001b[?2004l\r"]
[214.095341, "o", "\u001b[?2004h> "]
[214.095411, "o", "    relay_server.status = 422\r\n\u001b[?2004l\r"]
[214.095451, "o", "\u001b[?2004h> "]
[214.095612, "o", "    relay_server.body = {\"error\": \"rejected by test relay\"}\r\n\u001b[?2004l\r"]
[214.095654, "o", "\u001b[?2004h> "]
[214.09598, "o", "    result = run_cli(settings, relay_server.url, \"--tenant\", \"northwind\", \"--ticket\", \"1042\", \"--reason\", \"Help\")\r\n\u001b[?2004l\r"]
[214.096028, "o", "\u001b[?2004h> "]
[214.096093, "o", "    assert result.returncode != 0\r\n\u001b[?2004l\r"]
[214.096132, "o", "\u001b[?2004h> "]
[214.096348, "o", "    assert \"422\" in result.stderr and \"rejected by test relay\" in result.stderr\r\n\u001b[?2004l\r"]
[214.096396, "o", "\u001b[?2004h> "]
[214.096498, "o", "    outcome = json.loads(result.stdout)\r\n\u001b[?2004l\r"]
[214.096541, "o", "\u001b[?2004h> "]
[214.096725, "o", "    assert not outcome[\"delivered\"] and outcome[\"delivery_id\"] is None\r\n\u001b[?2004l\r"]
[214.096766, "o", "\u001b[?2004h> "]
[214.096852, "o", "    assert outcome[\"error\"]\r\n\u001b[?2004l\r"]
[214.096906, "o", "\u001b[?2004h> "]
[214.097055, "o", "    assert db[2].get_ticket(\"ten_nw\", 1042).status == \"escalated\"\r\n\u001b[?2004l\r"]
[214.097096, "o", "\u001b[?2004h> "]
[214.09734, "o", "    assert \"Help\" in db[2].notes_for(db[2].get_ticket(\"ten_nw\", 1042).ticket_id)[-1].body\r\n\u001b[?2004l\r"]
[214.097382, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[214.097423, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[214.097462, "o", "> "]
[214.097639, "o", "def test_cli_unreachable_relay_is_visible_but_update_stands(db, settings):\r\n\u001b[?2004l\r"]
[214.097682, "o", "\u001b[?2004h> "]
[214.09788, "o", "    # Reserve a port without listening, guaranteeing connection refusal.\r\n\u001b[?2004l\r"]
[214.097934, "o", "\u001b[?2004h> "]
[214.098012, "o", "    with socket.socket() as sock:\r\n\u001b[?2004l\r"]
[214.098063, "o", "\u001b[?2004h> "]
[214.098156, "o", "        sock.bind((\"127.0.0.1\", 0))\r\n\u001b[?2004l\r"]
[214.098195, "o", "\u001b[?2004h> "]
[214.098338, "o", "        url = f\"http://127.0.0.1:{sock.getsockname()[1]}\"\r\n\u001b[?2004l\r"]
[214.098369, "o", "\u001b[?2004h> "]
[214.098643, "o", "        result = run_cli(settings, url, \"--tenant\", \"northwind\", \"--ticket\", \"1042\", \"--reason\", \"Help\")\r\n\u001b[?2004l\r"]
[214.098671, "o", "\u001b[?2004h> "]
[214.09889, "o", "    assert result.returncode != 0 and \"relay unreachable\" in result.stderr\r\n\u001b[?2004l\r"]
[214.098936, "o", "\u001b[?2004h> "]
[214.099142, "o", "    assert \"Traceback\" not in result.stderr\r\n\u001b[?2004l\r"]
[214.099187, "o", "\u001b[?2004h> "]
[214.099317, "o", "    assert not json.loads(result.stdout)[\"delivered\"]\r\n\u001b[?2004l\r"]
[214.099351, "o", "\u001b[?2004h> "]
[214.099527, "o", "    assert db[2].get_ticket(\"ten_nw\", 1042).status == \"escalated\"\r\n\u001b[?2004l\r"]
[214.099556, "o", "\u001b[?2004h> "]
[214.099585, "o", "PY\r\n\u001b[?2004l\r"]
[214.101367, "o", "\u001b[?2004hroot@b69aa034b24b:/app# "]
[214.10144, "o", "cat > tests/test_notification.py <<'PY'\r\n\u001b[?2004l\r"]
[214.101476, "o", "\u001b[?2004h"]
[214.101503, "o", "> "]
[214.101531, "o", "import io\r\n\u001b[?2004l\r\u001b[?2004h"]
[214.101559, "o", "> "]
[214.10159, "o", "import urllib.error\r\n\u001b[?2004l\r"]
[214.101618, "o", "\u001b[?2004h> "]
[214.101723, "o", "from unittest.mock import MagicMock, patch\r\n\u001b[?2004l\r"]
[214.101751, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[214.101778, "o", "\u001b[?2004h> "]
[214.101816, "o", "import pytest\r\n\u001b[?2004l\r"]
[214.101842, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[214.101869, "o", "\u001b[?2004h> "]
[214.10204, "o", "from deskline.notification import NotificationRelayClient, RelayError\r\n\u001b[?2004l\r"]
[214.102067, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[214.102094, "o", "\u001b[?2004h> "]
[214.102121, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.102229, "o", "@pytest.mark.parametrize(\"error,match\", [\r\n\u001b[?2004l\r"]
[214.102255, "o", "\u001b[?2004h> "]
[214.102423, "o", "    (TimeoutError(\"timed out\"), \"relay unreachable.*timed out\"),\r\n\u001b[?2004l\r"]
[214.102457, "o", "\u001b[?2004h> "]
[214.102597, "o", "    (ConnectionResetError(\"reset\"), \"relay unreachable.*reset\"),\r\n\u001b[?2004l\r"]
[214.102623, "o", "\u001b[?2004h> "]
[214.102846, "o", "    (urllib.error.URLError(\"connection refused\"), \"relay unreachable.*connection refused\"),\r\n\u001b[?2004l\r"]
[214.102877, "o", "\u001b[?2004h> "]
[214.103171, "o", "    (urllib.error.HTTPError(\"http://relay\", 422, \"invalid\", {}, io.BytesIO(b'rejected event')), \"422.*rejected event\"),\r\n\u001b[?2004l\r"]
[214.103198, "o", "\u001b[?2004h> "]
[214.103227, "o", "])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.103387, "o", "def test_transport_errors_are_relay_errors(db, error, match):\r\n\u001b[?2004l\r"]
[214.103415, "o", "\u001b[?2004h> "]
[214.103522, "o", "    tenant = db[1].by_slug(\"northwind\")\r\n\u001b[?2004l\r"]
[214.103551, "o", "\u001b[?2004h> "]
[214.10371, "o", "    with patch(\"urllib.request.urlopen\", side_effect=error):\r\n\u001b[?2004l\r"]
[214.103737, "o", "\u001b[?2004h> "]
[214.103878, "o", "        with pytest.raises(RelayError, match=match):\r\n\u001b[?2004l\r"]
[214.103915, "o", "\u001b[?2004h"]
[214.103942, "o", "> "]
[214.104042, "o", "            NotificationRelayClient(\"http://relay\").post(tenant, {\"event\": \"ticket.escalated\"})\r\n\u001b[?2004l\r"]
[214.104069, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[214.104097, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.104181, "o", "@pytest.mark.parametrize(\"body\", [b\"not json\", b\"[]\", b\"null\", b\"\\xff\"])\r\n\u001b[?2004l\r"]
[214.104208, "o", "\u001b[?2004h> "]
[214.104262, "o", "def test_invalid_response_is_relay_error(db, body):\r\n\u001b[?2004l\r\u001b[?2004h"]
[214.10429, "o", "> "]
[214.104317, "o", "    response = MagicMock()\r\n\u001b[?2004l\r\u001b[?2004h"]
[214.104344, "o", "> "]
[214.104384, "o", "    response.__enter__.return_value = response\r\n\u001b[?2004l\r"]
[214.104411, "o", "\u001b[?2004h> "]
[214.104438, "o", "    response.status = 202\r\n\u001b[?2004l\r\u001b[?2004h"]
[214.104464, "o", "> "]
[214.104495, "o", "    response.read.return_value = body\r\n\u001b[?2004l\r\u001b[?2004h"]
[214.104521, "o", "> "]
[214.104587, "o", "    with patch(\"urllib.request.urlopen\", return_value=response):\r\n\u001b[?2004l\r\u001b[?2004h"]
[214.104614, "o", "> "]
[214.10465, "o", "        with pytest.raises(RelayError):\r\n\u001b[?2004l\r"]
[214.104678, "o", "\u001b[?2004h> "]
[214.1048, "o", "            NotificationRelayClient(\"http://relay\").post(db[1].by_slug(\"northwind\"), {\"event\": \"ticket.escalated\"})\r\n\u001b[?2004l\r\u001b[?2004h"]
[214.104826, "o", "> PY\r\n\u001b[?2004l\r"]
[214.106297, "o", "\u001b[?2004hroot@b69aa034b24b:/app# "]
[214.106363, "o", "python -m pytest -q tests\r\n\u001b[?2004l\r"]
