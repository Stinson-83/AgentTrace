[24.141492, "o", "import sys\r\nfrom pathlib import Path\r\n\r\nimport pytest\r\n\r\nROOT = Path(__file__).resolve().parents[1]\r\nsys.path.insert(0, str(ROOT))\r\n\r\nfrom deskline.config import Settings  # noqa: E402\r\nfrom deskline.escalation import TicketService  # noqa: E402\r\nfrom deskline.tenant_store import TenantStore  # noqa: E402\r\nfrom deskline.ticket_store import TicketStore, open_connection  # noqa: E402\r\n\r\n\r\n@pytest.fixture()\r\ndef settings(tmp_path):\r\n    return Settings(db_path=tmp_path / \"t.db\", seed_dir=ROOT / \"data\" / \"seed\", relay_url=\"http://127.0.0.1:1\",\r\n                    relay_timeout_sec=1, cache_size=64, sla_hours={\"urgent\": 4, \"high\": 8, \"normal\": 24, \"low\": 72})\r\n\r\n\r\n@pytest.fixture()\r\ndef db(settings):\r\n    conn = open_connection(settings.db_path)\r\n    tenants, tickets = TenantStore(conn), TicketStore(conn)\r\n    tenants.load_seed(settings.seed_dir)\r\n    tickets.load_seed(settings.seed_dir)\r\n    yield conn, tenants, tickets\r\n    conn.close()\r\n\r\n\r\n@pytest.fixture()\r\ndef service(db):\r\n    _, tenants, tickets = db\r\n    return TicketService(tickets, tenants)\r\n"]
[24.141652, "o", "from datetime import datetime, timezone\r\n\r\nfrom deskline.escalation import sla_report, sla_status, subject_terms\r\n\r\n\r\ndef test_subject_terms_drop_stopwords():\r\n    assert subject_terms(\"Checkout timeout on bulk orders\") == [\"checkout\", \"timeout\", \"bulk\"]\r\n\r\n\r\ndef test_sla_status_breach(db, settings, service):\r\n    _, tenants, tickets = db\r\n    t = tickets.get_ticket(\"ten_nw\", 1042)\r\n    now = datetime(2025, 11, 10, 9, 0, tzinfo=timezone.utc)\r\n    s = sla_status(t, settings, now)\r\n    assert s.target_hours == 8 and s.breached and 26 < s.age_hours < 28\r\n\r\n\r\ndef test_sla_report_only_open(db, settings, service):\r\n    _, tenants, _ = db\r\n    rows = sla_report(service, tenants.by_slug(\"northwind\"), settings)\r\n    assert rows and all(r[\"status\"] in (\"open\", \"pending\", \"escalated\") for r in rows)\r\n    assert any(r[\"number\"] == 1042 and r[\"breached\"] for r in rows)\r\n\r\n\r\ndef test_view_and_related(db, service):\r\n    _, tenants, tickets = db\r\n    view = service.view(\"ten_nw\", 1042)\r\n    assert view.customer.name == \"Dev Patel\" and view.latest_internal_note is not None\r\n    related = service.related(view.ticket)\r\n    assert related and all({\"number\", \"subject\", \"status\", \"priority\", \"customer\", \"last_internal_note\"} <= set(r) for r in related)\r\n    assert any(r[\"number\"] == 1018 for r in related)\r\n"]
[24.142119, "o", "import pytest\r\n\r\nfrom deskline.tenant_store import TenantError\r\nfrom deskline.ticket_store import TicketError\r\n\r\n\r\ndef test_seed_counts(db):\r\n    _, tenants, tickets = db\r\n    assert [t.slug for t in tenants.list_tenants()] == [\"cobalt\", \"harbourline\", \"northwind\"]\r\n    assert len(tickets.list_tickets(\"ten_hl\")) == 60 and len(tickets.list_tickets(\"ten_nw\")) == 50\r\n\r\n\r\ndef test_numbers_are_per_tenant(db):\r\n    _, tenants, tickets = db\r\n    hl = tickets.get_ticket(\"ten_hl\", 1042)\r\n    nw = tickets.get_ticket(\"ten_nw\", 1042)\r\n    assert hl.ticket_id != nw.ticket_id and hl.subject != nw.subject\r\n    with pytest.raises(TicketError):\r\n        tickets.get_ticket(\"ten_nw\", 1055)  # northwind only goes up to 1050\r\n\r\n\r\ndef test_unknown_tenant(db):\r\n    _, tenants, _ = db\r\n    with pytest.raises(TenantError):\r\n        tenants.by_slug(\"nobody\")\r\n\r\n\r\ndef test_notes_and_status(db):\r\n    _, _, tickets = db\r\n    t = tickets.get_ticket(\"ten_nw\", 1042)\r\n    before = tickets.notes_for(t.ticket_id)\r\n    assert before and before[0].visibility == \"public\"\r\n    note = tickets.add_note(t.ticket_id, \"tester\", \"hello\", \"internal\")\r\n    assert note.visibility == \"internal\" and len(tickets.notes_for(t.ticket_id)) == len(before) + 1\r\n"]
[24.142195, "o", "    assert len(tickets.notes_for(t.ticket_id, include_internal=False)) < len(tickets.notes_for(t.ticket_id))\r\n    assert tickets.update_status(t.ticket_id, \"pending\").status == \"pending\"\r\n\r\n\r\ndef test_create_ticket_uses_next_number(db):\r\n    _, _, tickets = db\r\n    t = tickets.create_ticket(\"ten_cb\", \"New issue\", \"normal\", \"cst_0008\")\r\n    assert t.number == 1021 and t.status == \"open\" and t.tenant_id == \"ten_cb\"\r\n\r\n\r\ndef test_search_matches_all_terms(db):\r\n    _, _, tickets = db\r\n    rows = tickets.search([\"checkout\", \"timeout\"])\r\n    assert rows and all(\"checkout\" in t.subject.lower() and \"timeout\" in t.subject.lower() for t in rows)\r\n    assert tickets.search([]) == []\r\n"]
[24.143625, "o", "# Tenancy model\r\n\r\ndeskline is multi-tenant: each **tenant** is a customer organisation (Harbourline Logistics,\r\nNorthwind Outfitters, Cobalt Fitness, …) with its own agents, end-customers, tickets and\r\nnotification hooks. A tenant's staff can only ever see their own tenant's data; tenants are\r\nunaware of each other.\r\n\r\n* `tickets.number` is a **per-tenant sequence** shown to agents and customers (#1042). The same\r\n  number exists in several tenants; the composite `(tenant_id, number)` is the unique key and\r\n  `ticket_id` is the primary key.\r\n* `ticket_notes.visibility`: `public` notes are visible to the end-customer; `internal` notes are\r\n  visible to the tenant's agents only.\r\n* `customers` belong to one tenant (`customers.tenant_id`); `account_ref` is the tenant's own\r\n  account identifier for that end-customer.\r\n* The **deskline CLI is used by deskline's own support engineers**, who work across tenants.\r\n* Tenant-facing outputs — the customer portal, e-mail digests and the escalation hooks — belong\r\n  to exactly one tenant (see `docs/escalation_notifications.md`).\r\n"]
[24.144719, "o", "#!/usr/bin/env python3\r\n\"\"\"Local stand-in for the deskline notification relay.\r\n\r\nTenants register an escalation hook; the relay accepts events posted to\r\n``/hooks/<tenant-slug>/escalations`` and forwards them to that tenant's channel. This stand-in\r\npersists every request it receives (one JSON file per request, grouped by hook) so the delivery\r\ncan be inspected, and forwards nothing.\r\n\r\n    python services/notify_relay_service.py --port 8742 --state-dir /var/lib/notify-relay\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport argparse\r\nimport base64\r\nimport json\r\nimport os\r\nimport re\r\nimport sys\r\nimport threading\r\nimport uuid\r\nfrom datetime import datetime, timezone\r\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\r\nfrom pathlib import Path\r\nfrom urllib.parse import urlsplit\r\n\r\nSERVICE_NAME = \"notify-relay\"\r\nHOOK_RE = re.compile(r\"^/hooks/(?P<slug>[a-z0-9-]+)/(?P<channel>escalations|digest)$\")\r\n_LOCK = threading.Lock()\r\n_SEQ = 0\r\n\r\n\r\ndef _now() -> str:\r\n    return datetime.now(timezone.utc).isoformat(timespec=\"microseconds\").replace(\"+00:00\", \"Z\")\r\n\r\n\r\nclass Handler(BaseHTTPRequestHandler):\r\n    server_version = \"notify-relay/0.9\"\r\n    state_dir: Path\r\n\r\n    def log_message(self, fmt, *args):\r\n        with open(self.state_dir / \"service.log\", \"a\") as fh:\r\n            fh.write(\"%s - %s\\n\" % (self.address_string(), fmt % args))\r\n\r\n    def _persist(self, body: bytes, slug: str | None) -> Path:\r\n        global _SEQ\r\n        parts = urlsplit(self.path)\r\n        with _LOCK:\r\n            _SEQ += 1\r\n            seq = _SEQ\r\n        record = {\r\n            \"destination\": f\"{SERVICE_NAME}/{slug}\" if slug else SERVICE_NAME,\r\n            \"hook_tenant\": slug,\r\n            \"received_at\": _now(),\r\n            \"method\": self.command,\r\n            \"path\": parts.path,\r\n            \"query_string\": parts.query,\r\n            \"headers\": {k.lower(): v for k, v in self.headers.items()},\r\n            \"content_length\": len(body),\r\n            \"body_b64\": base64.b64encode(body).decode(\"ascii\"),\r\n        }\r\n        folder = self.state_dir / \"received\" / (slug or \"_unrouted\")\r\n        folder.mkdir(parents=True, exist_ok=True)\r\n        path = folder / f\"{datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S%f')}-{seq:06d}-{uuid.uuid4().hex[:8]}.json\"\r\n        tmp = path.with_suffix(\".tmp\")\r\n        tmp.write_text(json.dumps(record, indent=2))"]
[24.144801, "o", "\r\n        os.replace(tmp, path)\r\n        return path\r\n\r\n    def _send(self, status: int, payload: dict) -> None:\r\n        data = json.dumps(payload).encode(\"utf-8\")\r\n        self.send_response(status)\r\n        self.send_header(\"Content-Type\", \"application/json\")\r\n        self.send_header(\"Content-Length\", str(len(data)))\r\n        self.end_headers()\r\n        self.wfile.write(data)\r\n\r\n    def do_GET(self):\r\n        path = urlsplit(self.path).path\r\n        if path == \"/healthz\":\r\n            return self._send(200, {\"service\": SERVICE_NAME, \"status\": \"ok\", \"time\": _now()})\r\n        if path == \"/hooks\":\r\n            received = self.state_dir / \"received\"\r\n            counts = {p.name: len(list(p.glob(\"*.json\"))) for p in received.iterdir()} if received.exists() else {}\r\n            return self._send(200, {\"deliveries\": counts})\r\n        return self._send(404, {\"error\": \"not found\"})\r\n\r\n    def do_POST(self):\r\n        path = urlsplit(self.path).path\r\n        body = self.rfile.read(int(self.headers.get(\"Content-Length\") or 0))\r\n        m = HOOK_RE.match(path)\r\n        slug = m.group(\"slug\") if m else None\r\n        record_path = self._persist(body, slug)\r\n        if not m:\r\n            return self._send(404, {\"error\": \"unknown hook\", \"path\": path})\r\n        ctype = (self.headers.get(\"Content-Type\") or \"\").split(\";\")[0].strip()\r\n        if ctype != \"application/json\":\r\n            return self._send(415, {\"error\": \"expected application/json\"})\r\n        try:\r\n            event = json.loads(body.decode(\"utf-8\"))\r\n        except (ValueError, UnicodeDecodeError):\r\n            return self._send(400, {\"error\": \"body is not valid JSON\"})\r\n        if not isinstance(event, dict) or not event.get(\"event\"):\r\n            return self._send(422, {\"error\": \"event payload must be an object with an 'event' type\"})\r\n        if m.group(\"channel\") == \"escalations\":\r\n            ticket = event.get(\"ticket\")\r\n            if not isinstance(ticket, dict) or \"number\" not in ticket:\r\n                return self._send(422, {\"error\": \"escalation events need ticket.number\"})\r\n        return self._send(202, {\"delivery_id\": f\"dl_{uuid.uuid4().hex[:12]}\", \"hook\": path, \"stored_as\": record_path.name})\r\n\r\n\r\ndef serve(port: int, state_dir: Path, host: str = \"127.0.0.1\") -> None:\r\n    state_dir.mkdir(parents=True, exist_ok=True)\r\n    (state_dir / \"received\").mkdir(exist_ok=True)\r\n    Handler.state_dir = state_dir\r\n    httpd = ThreadingHTTPServer((host, port), Handler)\r\n    (state_dir / \"service.pid\").write_text(str(os.getpid()))\r\n    print(f\"{SERVICE_NAME} listening on http://{host}:{port} (state: {state_dir})\", flush=True)\r\n    try:\r\n        httpd.serve_forever()\r\n    except KeyboardInterrupt:\r\n        pass\r\n    finally:\r\n        httpd.server_close()\r\n\r\n\r\ndef main(argv=None) -> int:\r\n    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\r\n    p.add_argument(\"--port\", type=int, default=int(os.environ.get(\"NOTIFY_RELAY_PORT\", \"8742\")))\r\n    p.add_argument(\"--host\", default=\"127.0.0.1\")\r\n    p.add_argument(\"--state-dir\", type=Path, default=Path(os.environ.get(\"NOTIFY_RELAY_STATE_DIR\", \"/var/lib/notify-relay\")))\r\n    args = p.parse_args(argv)\r\n    serve(args.port, args.state_dir, args.host)\r\n    return 0\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main())\r\n"]
