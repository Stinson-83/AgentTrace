[179.073128, "o", "class RecordingRelay:\r\n\u001b[?2004l\r\u001b[?2004h"]
[179.073225, "o", "> "]
[179.073293, "o", "    def __init__(self, response=None, error=None):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[179.073421, "o", "        self.response = response or RelayResponse(202, {\"delivery_id\": \"dl_test\"})\r\n\u001b[?2004l\r\u001b[?2004h"]
[179.073479, "o", ">         self.error = error\r\n\u001b[?2004l\r"]
[179.073537, "o", "\u001b[?2004h> "]
[179.073602, "o", "        self.calls = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\re\u001b[?2004h> "]
[179.073647, "o", "    def post(self, tenant, event):\r\n\u001b[?2004l\r\u001b[?2004h"]
[179.073679, "o", "> "]
[179.073759, "o", "        self.calls.append((tenant, event))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[179.073817, "o", "        if self.error:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[179.073892, "o", "            raise self.error\r\n\u001b[?2004l\r\u001b[?2004h> "]
[179.073954, "o", "        return self.response\r\n\u001b[?2004l\r\u001b[?2004h"]
[179.073976, "o", "> \r\n\u001b[?2004l\rE"]
