[218.249591, "o", "\u001b[32m.\u001b[0m"]
[218.274916, "o", "\u001b[32m.\u001b[0m"]
[218.301346, "o", "\u001b[32m.\u001b[0m"]
[218.327359, "o", "\u001b[32m.\u001b[0m"]
[218.353938, "o", "\u001b[32m.\u001b[0m"]
[218.372669, "o", "\u001b[32m.\u001b[0m"]
[218.398386, "o", "\u001b[32m.\u001b[0m"]
[218.424835, "o", "\u001b[32m.\u001b[0m"]
[218.449616, "o", "\u001b[32m.\u001b[0m"]
[218.490511, "o", "\u001b[32m.\u001b[0m"]
[218.511041, "o", "\u001b[32m.\u001b[0m"]
[218.527767, "o", "\u001b[32m.\u001b[0m"]
[218.547883, "o", "\u001b[32m.\u001b[0m"]
[218.564213, "o", "\u001b[32m.\u001b[0m"]
[218.58056, "o", "\u001b[32m.\u001b[0m"]
[218.604118, "o", "\u001b[32m.\u001b[0m"]
[218.626801, "o", "\u001b[32m.\u001b[0m"]
[218.649822, "o", "\u001b[32m.\u001b[0m"]
