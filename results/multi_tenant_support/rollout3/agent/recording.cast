[179.082673, "o", "> "]
[179.082745, "o", "def test_ticket_not_in_tenant_is_rejected(db, service, settings, number):\r\n\u001b[?2004l\r\u001b[?2004h"]
[179.082774, "o", "> "]
[179.082803, "o", "    conn, tenants, _ = db\r\n\u001b[?2004l\r\u001b[?2004h> "]
[179.08286, "o", "    tenant = tenants.by_slug(\"northwind\")\r\n\u001b[?2004l\r"]
[179.082892, "o", "\u001b[?2004h> "]
[179.082928, "o", "    before = list(conn.iterdump())\r\n\u001b[?2004l\r"]
[179.082957, "o", "\u001b[?2004h> "]
[179.082987, "o", "    relay = RecordingRelay()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[179.08307, "o", "    with pytest.raises(EscalationError, match=\"not found\"):\r\n\u001b[?2004l\r"]
[179.083102, "o", "\u001b[?2004h> "]
[179.083165, "o", "        escalate(service, relay, settings, tenant, number, \"No\")\r\n\u001b[?2004l\r"]
[179.083194, "o", "\u001b[?2004h> "]
[179.083238, "o", "    assert list(conn.iterdump()) == before\r\n\u001b[?2004l\r"]
[179.083267, "o", "\u001b[?2004h> "]
[179.083297, "o", "    assert not relay.calls\r\n\u001b[?2004l\r\u001b[?2004h"]
[179.083325, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[179.083354, "o", "> "]
[179.083386, "o", "@pytest.mark.parametrize(\"relay\", [\r\n\u001b[?2004l\r"]
[179.083426, "o", "\u001b[?2004h> "]
[179.083535, "o", "    RecordingRelay(error=RelayError(\"relay rejected the notification (422)\")),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[179.083601, "o", "    RecordingRelay(error=RelayError(\"relay unreachable\")),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[179.083698, "o", "    RecordingRelay(response=RelayResponse(503, {\"error\": \"unavailable\"})),\r\n\u001b[?2004l\r\u001b[?2004h"]
[179.083732, "o", "> "]
[179.083777, "o", "    RecordingRelay(response=RelayResponse(202, {})),\r\n\u001b[?2004l\r\u001b[?2004h"]
[179.083811, "o", "> ])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[179.083923, "o", "def test_delivery_failure_preserves_update_and_exposes_error(db, service, settings, relay):\r\n\u001b[?2004l\r\u001b[?2004h"]
[179.083958, "o", "> "]
[179.083989, "o", "    _, tenants, tickets = db\r\n\u001b[?2004l\r\u001b[?2004h> "]
[179.084045, "o", "    tenant = tenants.by_slug(\"northwind\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[179.084077, "o", "> "]
[179.084161, "o", "    result = escalate(service, relay, settings, tenant, 1042, \"Still record this\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[179.084196, "o", "> "]
[179.084276, "o", "    assert not result.delivered and result.delivery_id is None and result.error\r\n\u001b[?2004l\r\u001b[?2004h"]
[179.084309, "o", "> "]
[179.084359, "o", "    assert result.status == \"escalated\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[179.084401, "o", "> "]
[179.084462, "o", "    after = service.view(tenant.tenant_id, 1042)\r\n\u001b[?2004l\r\u001b[?2004h"]
[179.084496, "o", "> "]
[179.084561, "o", "    assert after.ticket.status == \"escalated\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[179.084583, "o", "> "]
[179.084698, "o", "    assert \"Still record this\" in after.latest_internal_note.body\r\n\u001b[?2004l\r\u001b[?2004h"]
[179.084731, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[179.084762, "o", "\u001b[?2004h> "]
[179.084896, "o", "def test_related_is_tenant_scoped_before_limit(db, service, settings):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[179.084942, "o", "    _, tenants, tickets = db\r\n\u001b[?2004l\r"]
[179.084972, "o", "\u001b[?2004h> "]
[179.085049, "o", "    source = tickets.get_ticket(\"ten_nw\", 1042)\r\n\u001b[?2004l\r\u001b[?2004h"]
[179.085078, "o", "> "]
[179.085196, "o", "    # Newer foreign matches must not displace the tenant's real related records.\r\n\u001b[?2004l\r\u001b[?2004h"]
[179.085225, "o", "> "]
[179.085256, "o", "    for i in range(7):\r\n\u001b[?2004l\r"]
[179.085288, "o", "\u001b[?2004h> "]
[179.08543, "o", "        foreign = tickets.create_ticket(\"ten_hl\", source.subject, \"urgent\", \"cst_0001\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[179.085576, "o", "        tickets.add_note(foreign.ticket_id, \"private\", f\"Foreign private context {i}\")\r\n\u001b[?2004l\r"]
[179.085616, "o", "\u001b[?2004h> "]
[179.085792, "o", "    expected = tickets.search([\"checkout\", \"timeout\", \"bulk\"], tenant_id=\"ten_nw\", exclude_ticket_id=source.ticket_id, limit=2)\r\n\u001b[?2004l\r"]
[179.085829, "o", "\u001b[?2004h> "]
[179.085905, "o", "    related = service.related(source, limit=2)\r\n\u001b[?2004l\r"]
[179.08594, "o", "\u001b[?2004h> "]
[179.086068, "o", "    assert related and [r[\"number\"] for r in related] == [t.number for t in expected]\r\n\u001b[?2004l\r\u001b[?2004h"]
[179.086096, "o", "> "]
[179.086165, "o", "    for row, ticket in zip(related, expected):\r\n\u001b[?2004l\r"]
[179.086198, "o", "\u001b[?2004h> "]
[179.08627, "o", "        view = service.view(\"ten_nw\", ticket.number)\r\n\u001b[?2004l\r\u001b[?2004h"]
[179.086301, "o", "> "]
[179.086353, "o", "        assert row[\"customer\"] == view.customer.name\r\n\u001b[?2004l\r\u001b[?2004h"]
[179.086384, "o", "> "]
[179.086507, "o", "        assert row[\"last_internal_note\"] == (view.latest_internal_note.body if view.latest_internal_note else None)\r\n\u001b[?2004l\r\u001b[?2004h"]
[179.08654, "o", "> "]
[179.086571, "o", "    relay = RecordingRelay()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[179.086687, "o", "    escalate(service, relay, settings, tenants.by_slug(\"northwind\"), 1042, \"Check duplicates\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[179.08672, "o", "> "]
[179.086783, "o", "    assert \"Foreign private context\" not in str(relay.calls)\r\n\u001b[?2004l\r\u001b[?2004h"]
[179.086813, "o", "> "]
[179.086893, "o", "    # Desk-wide search is still available to deskline support engineers.\r\n\u001b[?2004l\r\u001b[?2004h"]
[179.086925, "o", "> "]
[179.087033, "o", "    assert any(t.tenant_id == \"ten_hl\" for t in tickets.search([\"checkout\", \"timeout\", \"bulk\"]))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[179.087069, "o", "PY\r\n\u001b[?2004l\r"]
[179.088491, "o", "\u001b[?2004hroot@b69aa034b24b:/app# "]
[179.088559, "o", "python -m pytest -q tests/test_escalation_workflow.py\r\n\u001b[?2004l\r"]
