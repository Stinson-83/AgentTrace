[218.119164, "o", "\u001b[32m.\u001b[0m"]
[218.136912, "o", "\u001b[32m.\u001b[0m"]
[218.162838, "o", "\u001b[32m.\u001b[0m"]
[218.193227, "o", "\u001b[32m.\u001b[0m"]
