[284.489671, "i", "python - <<'PY'\nimport base64\nimport json\nfrom pathlib import Path\nfrom deskline.cli import Context\nfrom deskline.config import load_settings\nctx = Context(load_settings())\ntenant = ctx.tenants.by_slug('northwind')\nview = ctx.service.view(tenant.tenant_id, 1042)\nassert view.ticket.status == 'escalated'\ninternal = [n for n in view.notes if n.visibility == 'internal']\nassert internal[-1].author == 'cli'\nassert internal[-1].body == 'Escalated by cli: SLA breached, customer chasing'\nrecord_path = max(Path('/var/lib/notify-relay/received/northwind').glob('*.json'))\nrecord = json.loads(record_path.read_text())\nevent = json.loads(base64.b64decode(record['body_b64']))\nassert record['path'] == tenant.escalation_hook\nassert record['headers']['x-deskline-tenant'] == tenant.slug\nassert record['headers']['x-deskline-event'] == 'ticket.escalated'\nassert event['ticket']['number'] == 1042 and event['ticket']['status'] == 'escalated'\nassert event['escalation']['reason'] == 'SLA breached, customer chasing'\nassert event['escalation']['latest_internal_note'] == internal[-2].body\nassert event['escalation']['related'] == ctx.service.related(view.ticket)\nprint(json.dumps({'verified': True, 'status': view.ticket.status, 'audit_note_id': internal[-1].note_id, 'relay_record': str(record_path), 'related_ticket_numbers': [r['number'] for r in event['escalation']['related']]}, indent=2))\nctx.conn.close()\nPY\n"]
[284.489925, "o", "python - <<'PY'\r\n\u001b[?2004l\r"]
