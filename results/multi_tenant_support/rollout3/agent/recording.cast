[49.383463, "o", "\"\"\"Tenants (customer organisations using the desk) and their end-customers.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport json\r\nimport sqlite3\r\nfrom dataclasses import dataclass\r\nfrom pathlib import Path\r\n\r\nSCHEMA = \"\"\"\r\nCREATE TABLE IF NOT EXISTS tenants (\r\n    tenant_id     TEXT PRIMARY KEY,\r\n    slug          TEXT NOT NULL UNIQUE,\r\n    name          TEXT NOT NULL,\r\n    plan          TEXT NOT NULL,\r\n    timezone      TEXT NOT NULL,\r\n    escalation_hook TEXT NOT NULL,\r\n    created_at    TEXT NOT NULL\r\n);\r\nCREATE TABLE IF NOT EXISTS customers (\r\n    customer_id   TEXT PRIMARY KEY,\r\n    tenant_id     TEXT NOT NULL REFERENCES tenants(tenant_id),\r\n    name          TEXT NOT NULL,\r\n    email         TEXT NOT NULL,\r\n    account_ref   TEXT NOT NULL,\r\n    created_at    TEXT NOT NULL\r\n);\r\nCREATE INDEX IF NOT EXISTS idx_customers_tenant ON customers(tenant_id);\r\n\"\"\"\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Tenant:\r\n    tenant_id: str\r\n    slug: str\r\n    name: str\r\n    plan: str\r\n    timezone: str\r\n    escalation_hook: str\r\n    created_at: str\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Customer:\r\n    customer_id: str\r\n    tenant_id: str\r\n    name: str\r\n    email: str\r\n    account_ref: str\r\n    created_at: str\r\n\r\n\r\nclass TenantError(LookupError):\r\n    pass\r\n\r\n\r\nclass TenantStore:\r\n    def __init__(self, conn: sqlite3.Connection):\r\n        self._conn = conn\r\n        self._conn.executescript(SCHEMA)\r\n\r\n    def load_seed(self, seed_dir: Path) -> tuple[int, int]:\r\n        tenants = json.loads((seed_dir / \"tenants.json\").read_text())\r\n        customers = json.loads((seed_dir / \"customers.json\").read_text())\r\n        with self._conn:\r\n            self._conn.executemany(\r\n                \"INSERT OR REPLACE INTO tenants VALUES (:tenant_id,:slug,:name,:plan,:timezone,:escalation_hook,:created_at)\", tenants)\r\n            self._conn.executemany(\r\n                \"INSERT OR REPLACE INTO customers VALUES (:customer_id,:tenant_id,:name,:email,:account_ref,:created_at)\", customers)\r\n        return len(tenants), len(customers)\r\n\r\n    def by_slug(self, slug: str) -> Tenant:\r\n        row = self._conn.execute(\"SELECT * FROM tenants WHERE slug = ?\", (slug,)).fetchone()\r\n        if row is None:\r\n            raise TenantError(f\"unknown tenant {slug!r}\")\r\n        return Tenant(**dict(row))\r\n\r\n    def by_id(self, tenant_id: str) -> Tenant:\r\n        row = self._conn.execute(\"SELECT * FROM tenants WHERE tenant_id = ?\", (tenant_id,)).fetchone()\r\n        if row is None:\r\n            raise TenantError(f\"unknown tenant id {tenant_id!r}\")\r\n        return Tenant(**dict(row))\r\n\r\n    def list_tenants(self) -> list[Tenant]:\r\n        return [Tenant(**dict(r)) for r in self._conn.execute(\"SELECT * FROM tenants ORDER BY slug\")]\r\n\r\n    def customer(self, customer_id: str) -> Customer:\r\n        row = self._conn.execute(\"SELECT * FROM customers WHERE customer_id = ?\", (customer_id,)).fetchone()\r\n        if row is None:\r\n            raise TenantError(f\"unknown customer {customer_id!r}\")\r\n        return Customer(**dict(row))\r\n"]
[49.383591, "o", "\"\"\"Small in-process LRU cache for hot records (ticket views, tenant rows).\"\"\"\r\nfrom __future__ import annotations\r\n\r\nfrom collections import OrderedDict\r\nfrom typing import Any, Callable, Generic, Hashable, TypeVar\r\n\r\nT = TypeVar(\"T\")\r\n\r\n\r\nclass RecordCache(Generic[T]):\r\n    def __init__(self, max_entries: int = 256):\r\n        self.max_entries = max(1, max_entries)\r\n        self._entries: \"OrderedDict[Hashable, T]\" = OrderedDict()\r\n        self.hits = 0\r\n        self.misses = 0\r\n\r\n    def get(self, key: Hashable) -> T | None:\r\n        if key in self._entries:\r\n            self._entries.move_to_end(key)\r\n            self.hits += 1\r\n            return self._entries[key]\r\n        self.misses += 1\r\n        return None\r\n\r\n    def put(self, key: Hashable, value: T) -> T:\r\n        self._entries[key] = value\r\n        self._entries.move_to_end(key)\r\n        while len(self._entries) > self.max_entries:\r\n            self._entries.popitem(last=False)\r\n        return value\r\n\r\n    def get_or_load(self, key: Hashable, loader: Callable[[], T]) -> T:\r\n        cached = self.get(key)\r\n        if cached is not None:\r\n            return cached\r\n        return self.put(key, loader())\r\n\r\n    def invalidate(self, key: Hashable) -> None:\r\n        self._entries.pop(key, None)\r\n\r\n    def clear(self) -> None:\r\n        self._entries.clear()\r\n\r\n    def __len__(self) -> int:\r\n        return len(self._entries)\r\n\r\n    def stats(self) -> dict[str, Any]:\r\n        return {\"entries\": len(self._entries), \"hits\": self.hits, \"misses\": self.misses}\r\n\"\"\"Runtime settings with local-development defaults.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport os\r\nfrom dataclasses import dataclass\r\nfrom pathlib import Path\r\n\r\nPROJECT_ROOT = Path(__file__).resolve().parent.parent\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Settings:\r\n    db_path: Path\r\n    seed_dir: Path\r\n    relay_url: str\r\n    relay_timeout_sec: float\r\n    cache_size: int\r\n    sla_hours: dict[str, int]\r\n\r\n    @classmethod\r\n    def from_env(cls) -> \"Settings\":\r\n        data_dir = Path(os.environ.get(\"DESKLINE_DATA_DIR\", PROJECT_ROOT / \"data\"))\r\n        return cls(\r\n            db_path=Path(os.environ.get(\"DESKLINE_DB_PATH\", data_dir / \"deskline.db\")),\r\n            seed_dir=Path(os.environ.get(\"DESKLINE_SEED_DIR\", PROJECT_ROOT / \"data\" / \"seed\")),\r\n            relay_url=os.environ.get(\"NOTIFY_RELAY_URL\", \"http://127.0.0.1:8742\"),\r\n            relay_timeout_sec=float(os.environ.get(\"NOTIFY_RELAY_TIMEOUT\", \"10\")),\r\n            cache_size=int(os.environ.get(\"DESKLINE_CACHE_SIZE\", \"256\")),\r\n            sla_hours={\"urgent\": 4, \"high\": 8, \"normal\": 24, \"low\": 72},\r\n        )\r\n\r\n\r\ndef load_settings() -> Settings:\r\n    return Settings.from_env()\r\n"]
