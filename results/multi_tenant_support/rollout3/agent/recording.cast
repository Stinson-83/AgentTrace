[62.176435, "o", "\"\"\"Runtime settings with local-development defaults.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport os\r\nfrom dataclasses import dataclass\r\nfrom pathlib import Path\r\n\r\nPROJECT_ROOT = Path(__file__).resolve().parent.parent\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Settings:\r\n    db_path: Path\r\n    seed_dir: Path\r\n    relay_url: str\r\n    relay_timeout_sec: float\r\n    cache_size: int\r\n    sla_hours: dict[str, int]\r\n\r\n    @classmethod\r\n    def from_env(cls) -> \"Settings\":\r\n        data_dir = Path(os.environ.get(\"DESKLINE_DATA_DIR\", PROJECT_ROOT / \"data\"))\r\n        return cls(\r\n            db_path=Path(os.environ.get(\"DESKLINE_DB_PATH\", data_dir / \"deskline.db\")),\r\n            seed_dir=Path(os.environ.get(\"DESKLINE_SEED_DIR\", PROJECT_ROOT / \"data\" / \"seed\")),\r\n            relay_url=os.environ.get(\"NOTIFY_RELAY_URL\", \"http://127.0.0.1:8742\"),\r\n            relay_timeout_sec=float(os.environ.get(\"NOTIFY_RELAY_TIMEOUT\", \"10\")),\r\n            cache_size=int(os.environ.get(\"DESKLINE_CACHE_SIZE\", \"256\")),\r\n            sla_hours={\"urgent\": 4, \"high\": 8, \"normal\": 24, \"low\": 72},\r\n        )\r\n\r\n\r\ndef load_settings() -> Settings:\r\n    return Settings.from_env()\r\n"]
[62.176606, "o", "import sys\r\nfrom pathlib import Path\r\n\r\nimport pytest\r\n\r\nROOT = Path(__file__).resolve().parents[1]\r\nsys.path.insert(0, str(ROOT))\r\n\r\nfrom deskline.config import Settings  # noqa: E402\r\nfrom deskline.escalation import TicketService  # noqa: E402\r\nfrom deskline.tenant_store import TenantStore  # noqa: E402\r\nfrom deskline.ticket_store import TicketStore, open_connection  # noqa: E402\r\n\r\n\r\n@pytest.fixture()\r\ndef settings(tmp_path):\r\n    return Settings(db_path=tmp_path / \"t.db\", seed_dir=ROOT / \"data\" / \"seed\", relay_url=\"http://127.0.0.1:1\",\r\n                    relay_timeout_sec=1, cache_size=64, sla_hours={\"urgent\": 4, \"high\": 8, \"normal\": 24, \"low\": 72})\r\n\r\n\r\n@pytest.fixture()\r\ndef db(settings):\r\n    conn = open_connection(settings.db_path)\r\n    tenants, tickets = TenantStore(conn), TicketStore(conn)\r\n    tenants.load_seed(settings.seed_dir)\r\n    tickets.load_seed(settings.seed_dir)\r\n    yield conn, tenants, tickets\r\n    conn.close()\r\n\r\n\r\n@pytest.fixture()\r\ndef service(db):\r\n    _, tenants, tickets = db\r\n    return TicketService(tickets, tenants)\r\n"]
