[139.804775, "i", "cat > /tmp/implement_escalation.py <<'PY'\nfrom pathlib import Path\n\np = Path('deskline/ticket_store.py')\ns = p.read_text().replace('exclude_ticket_id: int | None = None) -> list[Ticket]:', 'exclude_ticket_id: int | None = None, *, tenant_id: str | None = None) -> list[Ticket]:')\ns = s.replace('        for term in terms:\\n', '        if tenant_id is not None:\\n            sql += \" AND tenant_id = ?\"\\n            params.append(tenant_id)\\n        for term in terms:\\n')\np.write_text(s)\n\np = Path('deskline/escalation.py')\ns = p.read_text().replace('from .notification import NotificationRelayClient', 'from .notification import NotificationRelayClient, RelayError')\ns = s.replace('from .ticket_store import Note, Ticket, TicketStore', 'from .ticket_store import Note, Ticket, TicketError, TicketStore')\ns = s.replace('limit=limit, exclude_ticket_id=ticket.ticket_id)', 'limit=limit, exclude_ticket_id=ticket.ticket_id, tenant_id=ticket.tenant_id)')\ns = s.replace('    delivery_id: str | None\\n', '    delivery_id: str | None\\n    error: str | None = None\\n')\ns = s.replace('''    Not implemented yet — see ticket DL-1187.\n    \"\"\"\n    raise NotImplementedError(\"escalation workflow is not implemented yet (DL-1187)\")\n''', '''    Validation failures raise EscalationError without changing the ticket or posting.\n    Delivery failures are returned in the result; they never undo the local update.\n    \"\"\"\n    try:\n        ticket = service.tickets.get_ticket(tenant.tenant_id, number)\n    except TicketError as exc:\n        raise EscalationError(str(exc)) from exc\n    if ticket.status in (\"resolved\", \"closed\"):\n        raise EscalationError(f\"ticket #{number} is {ticket.status} and cannot be escalated\")\n\n    # Read context afresh, before adding the escalation's own audit note.\n    service.invalidate(ticket.ticket_id)\n    view = service.view(tenant.tenant_id, number)\n    note = view.latest_internal_note\n    related = service.related(ticket)\n    now = datetime.now(timezone.utc)\n    ticket = service.tickets.update_status(ticket.ticket_id, \"escalated\")\n    try:\n        service.tickets.add_note(ticket.ticket_id, actor, f\"Escalated by {actor}: {reason}\", \"internal\")\n    finally:\n        service.invalidate(ticket.ticket_id)\n\n    event = {\n        \"event\": \"ticket.escalated\",\n        \"tenant\": tenant.slug,\n        \"occurred_at\": now.isoformat().replace(\"+00:00\", \"Z\"),\n        \"actor\": actor,\n        \"ticket\": {\n            \"number\": ticket.number,\n            \"subject\": ticket.subject,\n            \"status\": ticket.status,\n            \"priority\": ticket.priority,\n            \"customer\": view.customer.name,\n        },\n        \"escalation\": {\n            \"reason\": reason,\n            \"sla\": sla_status(ticket, settings, now).as_dict(),\n            \"latest_internal_note\": note.body if note else None,\n            \"related\": related,\n        },\n    }\n    try:\n        response = relay.post(tenant, event)\n        if response.status != 202:\n            raise RelayError(f\"relay rejected the notification ({response.status}): {response.body}\")\n        delivery_id = response.body.get(\"delivery_id\")\n        if not isinstance(delivery_id, str) or not delivery_id:\n            raise RelayError(\"relay accepted the notification without a delivery_id\")\n    except RelayError as exc:\n        return EscalationResult(tenant.slug, number, ticket.status, False, None, str(exc))\n    return EscalationResult(tenant.slug, number, ticket.status, True, delivery_id)\n''')\np.write_text(s)\n\np = Path('deskline/notification.py')\ns = p.read_text().replace('''                return RelayResponse(resp.status, json.loads(raw) if raw else {})''', '''                body = json.loads(raw) if raw else {}\n                if not isinstance(body, dict):\n                    raise RelayError(\"relay returned a non-object response\")\n                return RelayResponse(resp.status, body)''')\nneedle = '''        except urllib.error.URLError as e:\n            raise RelayError(f\"relay unreachable at {self.base_url}: {e.reason}\") from e\n'''\ns = s.replace(needle, needle + '''        except OSError as e:\n       "]
[139.804925, "i", "     raise RelayError(f\"relay unreachable at {self.base_url}: {e}\") from e\n        except (ValueError, UnicodeDecodeError) as e:\n            raise RelayError(f\"invalid response from relay: {e}\") from e\n''', 1)\np.write_text(s)\n\np = Path('deskline/cli.py')\ns = p.read_text().replace('sla-report | relay-health.', 'sla-report | escalate | relay-health.')\ns = s.replace('from .escalation import TicketService, sla_report, sla_status', 'from .escalation import EscalationError, TicketService, escalate, sla_report, sla_status')\npos = s.index('def cmd_relay_health(')\ns = s[:pos] + '''def cmd_escalate(args, settings) -> int:\n    ctx = Context(settings)\n    try:\n        tenant = ctx.tenants.by_slug(args.tenant)\n        result = escalate(ctx.service, ctx.relay, settings, tenant, args.ticket, args.reason, args.actor)\n    except (TenantError, TicketError, EscalationError) as e:\n        print(str(e), file=sys.stderr)\n        return 1\n    print(json.dumps(result.__dict__))\n    if not result.delivered:\n        print(result.error or \"escalation notification delivery failed\", file=sys.stderr)\n        return 1\n    return 0\n\n\n''' + s[pos:]\nneedle = '    sub.add_parser(\"relay-health\", help=\"check the notification relay\").set_defaults(func=cmd_relay_health)'\ns = s.replace(needle, '''    e = sub.add_parser(\"escalate\", help=\"escalate a ticket and notify the tenant's on-call\")\n    e.add_argument(\"--tenant\", required=True)\n    e.add_argument(\"--ticket\", type=int, required=True)\n    e.add_argument(\"--reason\", required=True)\n    e.add_argument(\"--actor\", default=\"cli\")\n    e.set_defaults(func=cmd_escalate)\n\n''' + needle)\np.write_text(s)\n\np = Path('README.md')\ns = p.read_text().replace('| `relay-health`', '| `escalate --tenant <slug> --ticket <number> --reason \"<text>\" [--actor <name>]` | escalate a ticket and notify the tenant\\'s on-call; exits non-zero if delivery fails (ticket stays escalated) |\\n| `relay-health`')\np.write_text(s)\nPY\npython /tmp/implement_escalation.py\npython -m pytest -q tests\n"]
