[252.343114, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('tests/test_escalation_workflow.py')\ns = p.read_text().replace('from deskline.ticket_store import TicketError, TicketStore, open_connection', 'from deskline.ticket_store import TicketStore, open_connection')\ns = s.replace('ticket = tickets.create_ticket(tenant.tenant_id, \"Unique new issue\", \"normal\", \"cst_0005\")', 'customer_id = tickets.get_ticket(tenant.tenant_id, 1042).customer_id\\n    ticket = tickets.create_ticket(tenant.tenant_id, \"Unique new issue\", \"normal\", customer_id)')\ns = s.replace('    for i in range(7):\\n        foreign = tickets.create_ticket(\"ten_hl\", source.subject, \"urgent\", \"cst_0001\")', '    foreign_customer = tickets.get_ticket(\"ten_hl\", 1042).customer_id\\n    for i in range(7):\\n        foreign = tickets.create_ticket(\"ten_hl\", source.subject, \"urgent\", foreign_customer)')\np.write_text(s)\np = Path('deskline/escalation.py')\ns = p.read_text().replace('''        for other in self.tickets.search(subject_terms(ticket.subject), limit=limit, exclude_ticket_id=ticket.ticket_id, tenant_id=ticket.tenant_id):''', '''        for other in self.tickets.search(\n            subject_terms(ticket.subject), limit=limit,\n            exclude_ticket_id=ticket.ticket_id, tenant_id=ticket.tenant_id,\n        ):''')\np.write_text(s)\np = Path('deskline/ticket_store.py')\ns = p.read_text().replace('''        open/pending/escalated tickets whose subject contains every term, most recent first.\"\"\"''', '''        open/pending/escalated tickets whose subject contains every term, most recent first.\n        Tenant-facing callers must pass tenant_id; the default is a desk-wide search.\"\"\"''')\np.write_text(s)\np = Path('README.md')\ns = p.read_text().replace('Configuration: `DESKLINE_DATA_DIR`', 'Escalation prints a JSON outcome including `delivered` and `delivery_id`. On delivery failure,\\n`error` contains the relay error (also printed to stderr); the status and internal audit note\\nremain saved. The event includes the internal-note context from before the escalation note\\nand only related tickets belonging to the same tenant.\\n\\nConfiguration: `DESKLINE_DATA_DIR`')\np.write_text(s)\nPY\npython -m deskline.cli escalate --help\n"]
