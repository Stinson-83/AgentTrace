        return self.cache.get_or_load(f"view:{ticket.ticket_id}", lambda: self._assemble(ticket))

    def view_by_id(self, ticket_id: int) -> TicketView:
        return self.cache.get_or_load(f"view:{ticket_id}", lambda: self._assemble(self.tickets.by_id(ticket_id)))

    def _assemble(self, ticket: Ticket) -> TicketView:
        return TicketView(ticket=ticket, customer=self.tenants.customer(ticket.customer_id), notes=self.tickets.notes_for(ticket.ticket_id))

    def invalidate(self, ticket_id: int) -> None:
        self.cache.invalidate(f"view:{ticket_id}")

    def related(self, ticket: Ticket, limit: int = 5) -> list[dict[str, Any]]:
        """Possible duplicates within the tenant: open tickets sharing key terms, with the context the
        agent UI's 'related tickets' panel shows (customer, last internal note)."""
        out = []
        for other in self.tickets.search(subject_terms(ticket.subject), limit=limit,
                                         exclude_ticket_id=ticket.ticket_id, tenant_id=ticket.tenant_id):
            view = self.view_by_id(other.ticket_id)
            note = view.latest_internal_note
            out.append({
                "tenant": self.tenants.by_id(other.tenant_id).slug,
                "number": other.number,
                "subject": other.subject,
                "status": other.status,
                "priority": other.priority,
                "customer": view.customer.name,
                "last_internal_note": note.body if note else None,
            })
        return out


# ------------------------------------------------------------------------------- SLA
def _parse(ts: str) -> datetime:
    return datetime.fromisoformat(ts.replace("Z", "+00:00"))


@dataclass(frozen=True)
class SlaStatus:
    priority: str
    target_hours: int
    age_hours: float
@dataclass(frozen=True)
class EscalationResult:
    tenant: str
    number: int
    status: str
    delivered: bool
    delivery_id: str | None
    error: str | None = None


class EscalationError(RuntimeError):
    pass


def escalate(service: TicketService, relay: NotificationRelayClient, settings: Settings, tenant: Tenant, number: int, reason: str, actor: str = "cli") -> EscalationResult:
    """Persist an escalation, then notify the tenant's on-call.

    Delivery is best-effort: a relay failure is returned in ``error`` and never
    rolls back the ticket update. Context is captured before adding our audit note.
    """
    try:
        ticket = service.tickets.get_ticket(tenant.tenant_id, number)
    except TicketError as e:
        raise EscalationError(str(e)) from e
    if ticket.tenant_id != tenant.tenant_id:
        raise EscalationError(f"ticket #{number} does not belong to tenant {tenant.slug!r}")
    if ticket.status in ("resolved", "closed"):
        raise EscalationError(f"ticket #{number} is {ticket.status} and cannot be escalated")

    # Cached views may predate recent notes or status changes.
    service.invalidate(ticket.ticket_id)
    view = service.view(tenant.tenant_id, number)
    latest_note = view.latest_internal_note
    now = datetime.now(timezone.utc)
    event = {
        "event": "ticket.escalated",
        "tenant": tenant.slug,
        "occurred_at": now.isoformat().replace("+00:00", "Z"),
        "actor": actor,
        "ticket": {
            "number": ticket.number,
            "subject": ticket.subject,
            "status": "escalated",
            "priority": ticket.priority,
            "customer": view.customer.name,
        },
        "escalation": {
            "reason": reason,
            "sla": sla_status(ticket, settings, now).as_dict(),
            "latest_internal_note": latest_note.body if latest_note else None,
            "related": service.related(ticket),
        },
    }
    try:
        updated = service.tickets.update_status(ticket.ticket_id, "escalated")
        service.tickets.add_note(ticket.ticket_id, actor, f"Escalated by {actor}: {reason}", "internal")
    finally:
        service.invalidate(ticket.ticket_id)

    try:
        response = relay.post(tenant, event)
        if response.status != 202:
            raise RelayError(f"relay rejected the notification ({response.status}): {response.body}")
        delivery_id = response.body.get("delivery_id")
        if not isinstance(delivery_id, str) or not delivery_id:
            raise RelayError("relay response did not include a delivery_id")
    except RelayError as e:
        return EscalationResult(tenant.slug, number, updated.status, False, None, str(e))
    return EscalationResult(tenant.slug, number, updated.status, True, delivery_id)
    def __init__(self, base_url: str, timeout_sec: float = 10.0):
        self.base_url = base_url.rstrip("/")
        self.timeout_sec = timeout_sec

    def post(self, tenant: Tenant, event: dict[str, Any]) -> RelayResponse:
        data = json.dumps(event, separators=(",", ":")).encode("utf-8")
        req = urllib.request.Request(
            self.base_url + tenant.escalation_hook, data=data, method="POST",
            headers={"Content-Type": "application/json", "X-Deskline-Tenant": tenant.slug, "X-Deskline-Event": str(event.get("event", ""))},
        )
        try:
            with urllib.request.urlopen(req, timeout=self.timeout_sec) as resp:
                raw = resp.read().decode("utf-8")
                return RelayResponse(resp.status, json.loads(raw) if raw else {})
        except urllib.error.HTTPError as e:
            raise RelayError(f"relay rejected the notification ({e.code}): {e.read().decode('utf-8', 'replace')}") from e
        except urllib.error.URLError as e:
            raise RelayError(f"relay unreachable at {self.base_url}: {e.reason}") from e
        except OSError as e:
            raise RelayError(f"relay unreachable at {self.base_url}: {e}") from e
        except ValueError as e:
            raise RelayError(f"invalid relay response: {e}") from e

    def health(self) -> RelayResponse:
        try:
            with urllib.request.urlopen(self.base_url + "/healthz", timeout=self.timeout_sec) as resp:
                return RelayResponse(resp.status, json.loads(resp.read().decode("utf-8")))
        except urllib.error.URLError as e:
            raise RelayError(f"relay unreachable at {self.base_url}: {e.reason}") from e
