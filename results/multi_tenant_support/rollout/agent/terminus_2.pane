[?2004l"""deskline command line: init-db | tenants | ticket show/search/list/note | sla-report | relay-health."""
from __future__ import annotations

import argparse
import json
import sys
from typing import Sequence

from . import __version__
from .cache import RecordCache
from .config import load_settings
from .escalation import TicketService, sla_report, sla_status
from .notification import NotificationRelayClient, RelayError
from .tenant_store import TenantError, TenantStore
from .ticket_store import TicketError, TicketStore, open_connection


class Context:
    def __init__(self, settings):
        self.settings = settings
        if not settings.db_path.exists():
            print(f"database not found at {settings.db_path}; run `init-db` first", file=sys.stderr)
            raise SystemExit(2)
        self.conn = open_connection(settings.db_path)
        self.tenants = TenantStore(self.conn)
        self.tickets = TicketStore(self.conn)
        self.service = TicketService(self.tickets, self.tenants, RecordCache(settings.cache_size))
        self.relay = NotificationRelayClient(settings.relay_url, settings.relay_timeout_sec)


def cmd_init_db(args, settings) -> int:
    conn = open_connection(settings.db_path)
    tenants = TenantStore(conn)
    tickets = TicketStore(conn)
    if args.replace:
        with conn:
            for table in ("ticket_notes", "tickets", "customers", "tenants"):
                conn.execute(f"DELETE FROM {table}")
    t, c = tenants.load_seed(settings.seed_dir)
    k, n = tickets.load_seed(settings.seed_dir)
    print(f"loaded {t} tenants, {c} customers, {k} tickets, {n} notes into {settings.db_path}")
    return 0


def cmd_tenants(args, settings) -> int:
    ctx = Context(settings)
    for t in ctx.tenants.list_tenants():
        print(f"{t.slug:<12} {t.plan:<10} {t.timezone:<16} {t.name}")
    return 0


def cmd_ticket_show(args, settings) -> int:
    ctx = Context(settings)
    try:
        tenant = ctx.tenants.by_slug(args.tenant)
        view = ctx.service.view(tenant.tenant_id, args.number)
    except (TenantError, TicketError) as e:
        print(str(e), file=sys.stderr)
        return 1
    out = view.as_dict()
    out["sla"] = sla_status(view.ticket, settings).as_dict()
    out["related"] = ctx.service.related(view.ticket)
    print(json.dumps(out, indent=2))
    return 0


def cmd_ticket_search(args, settings) -> int:
    ctx = Context(settings)
    for t in ctx.tickets.search(args.terms, limit=args.limit):
        slug = ctx.tenants.by_id(t.tenant_id).slug
        print(f"{slug:<12} #{t.number}\t{t.status:<9}\t{t.priority:<7}\t{t.subject}")
    return 0


def cmd_ticket_list(args, settings) -> int:
    ctx = Context(settings)
    try:
        tenant = ctx.tenants.by_slug(args.tenant)
    except TenantError as e:
        print(str(e), file=sys.stderr)
        return 1
    for t in ctx.tickets.list_tickets(tenant.tenant_id, status=args.status):
        print(f"#{t.number}\t{t.status:<9}\t{t.priority:<7}\t{t.subject}")
    return 0


def cmd_ticket_note(args, settings) -> int:
    ctx = Context(settings)
    try:
        tenant = ctx.tenants.by_slug(args.tenant)
        ticket = ctx.tickets.get_ticket(tenant.tenant_id, args.number)
    except (TenantError, TicketError) as e:
        print(str(e), file=sys.stderr)
        return 1
    note = ctx.tickets.add_note(ticket.ticket_id, args.author, " ".join(args.text), "public" if args.public else "internal")
    ctx.service.invalidate(ticket.ticket_id)
    print(f"added {note.visibility} note {note.note_id} to #{ticket.number}")
    return 0


def cmd_sla_report(args, settings) -> int:
    ctx = Context(settings)
    try:
        tenant = ctx.tenants.by_slug(args.tenant)
    except TenantError as e:
        print(str(e), file=sys.stderr)
        return 1
    rows = sla_report(ctx.service, tenant, settings)
    if args.json:
        print(json.dumps(rows, indent=2))
    else:
        for r in rows:
            flag = "BREACH" if r["breached"] else ""
            print(f"#{r['number']}\t{r['priority']:<7}\t{r['status']:<9}\t{r['age_hours']:>7.1f}h\t{flag}\t{r['customer']}")
    return 0


def cmd_relay_health(args, settings) -> int:
    ctx = Context(settings)
    try:
        resp = ctx.relay.health()
    except RelayError as e:
        print(str(e), file=sys.stderr)
        return 1
    print(json.dumps(resp.body))
    return 0


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="deskline", description="deskline support desk CLI")
    p.add_argument("--version", action="version", version=f"deskline {__version__}")
    sub = p.add_subparsers(dest="command", required=True)

    s = sub.add_parser("init-db", help="create the SQLite database from the seed files")
    s.add_argument("--replace", action="store_true")
    s.set_defaults(func=cmd_init_db)

    sub.add_parser("tenants", help="list tenants").set_defaults(func=cmd_tenants)

    t = sub.add_parser("ticket", help="ticket operations")
    tsub = t.add_subparsers(dest="ticket_command", required=True)
    show = tsub.add_parser("show"); show.add_argument("number", type=int); show.add_argument("--tenant", required=True); show.set_defaults(func=cmd_ticket_show)
    search = tsub.add_parser("search"); search.add_argument("terms", nargs="+"); search.add_argument("--limit", type=int, default=10); search.set_defaults(func=cmd_ticket_search)
    lst = tsub.add_parser("list"); lst.add_argument("--tenant", required=True); lst.add_argument("--status"); lst.set_defaults(func=cmd_ticket_list)
    note = tsub.add_parser("note"); note.add_argument("number", type=int); note.add_argument("--tenant", required=True)
    note.add_argument("--author", required=True); note.add_argument("--public", action="store_true"); note.add_argument("text", nargs="+")
    note.set_defaults(func=cmd_ticket_note)

    r = sub.add_parser("sla-report", help="open tickets against their SLA target")
    r.add_argument("--tenant", required=True); r.add_argument("--json", action="store_true"); r.set_defaults(func=cmd_sla_report)

    sub.add_parser("relay-health", help="check the notification relay").set_defaults(func=cmd_relay_health)
    return p


def main(argv: Sequence[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    return args.func(args, load_settings())


if __name__ == "__main__":
    sys.exit(main())
"""Tickets and notes. Ticket numbers are a per-tenant sequence (#1042); ``ticket_id`` is the primary key
and (tenant_id, number) is unique."""
from __future__ import annotations

import json
import sqlite3
from dataclasses import dataclass
from datetime import datetime, timezone
from pathlib import Path

SCHEMA = """
CREATE TABLE IF NOT EXISTS tickets (
    ticket_id    INTEGER PRIMARY KEY AUTOINCREMENT,
    tenant_id    TEXT NOT NULL REFERENCES tenants(tenant_id),
    number       INTEGER NOT NULL,
    subject      TEXT NOT NULL,
    status       TEXT NOT NULL CHECK (status IN ('open','pending','escalated','resolved','closed')),
    priority     TEXT NOT NULL CHECK (priority IN ('low','normal','high','urgent')),
    customer_id  TEXT NOT NULL REFERENCES customers(customer_id),
    assignee     TEXT,
    created_at   TEXT NOT NULL,
    updated_at   TEXT NOT NULL,
    UNIQUE (tenant_id, number)
);
CREATE TABLE IF NOT EXISTS ticket_notes (
    note_id      INTEGER PRIMARY KEY AUTOINCREMENT,
    ticket_id    INTEGER NOT NULL REFERENCES tickets(ticket_id),
    author       TEXT NOT NULL,
    visibility   TEXT NOT NULL CHECK (visibility IN ('public','internal')),
    body         TEXT NOT NULL,
    created_at   TEXT NOT NULL
);
CREATE INDEX IF NOT EXISTS idx_notes_ticket ON ticket_notes(ticket_id, created_at);
"""


def utcnow() -> str:
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


@dataclass(frozen=True)
class Ticket:
    ticket_id: int
    tenant_id: str
    number: int
    subject: str
    status: str
    priority: str
    customer_id: str
    assignee: str | None
    created_at: str
    updated_at: str


@dataclass(frozen=True)
class Note:
    note_id: int
    ticket_id: int
    author: str
    visibility: str
    body: str
    created_at: str


class TicketError(LookupError):
    pass


class TicketStore:
    def __init__(self, conn: sqlite3.Connection):
        self._conn = conn
        self._conn.executescript(SCHEMA)

    # ----------------------------------------------------------------- seeding
    def load_seed(self, seed_dir: Path) -> tuple[int, int]:
        tickets = json.loads((seed_dir / "tickets.json").read_text())
        notes = json.loads((seed_dir / "notes.json").read_text())
        with self._conn:
            self._conn.executemany(
                "INSERT OR REPLACE INTO tickets VALUES (:ticket_id,:tenant_id,:number,:subject,:status,:priority,"
                ":customer_id,:assignee,:created_at,:updated_at)", tickets)
            self._conn.executemany(
                "INSERT OR REPLACE INTO ticket_notes VALUES (:note_id,:ticket_id,:author,:visibility,:body,:created_at)", notes)
        return len(tickets), len(notes)

    # ----------------------------------------------------------------- lookups
    def get_ticket(self, tenant_id: str, number: int) -> Ticket:
        row = self._conn.execute("SELECT * FROM tickets WHERE tenant_id = ? AND number = ?", (tenant_id, number)).fetchone()
        if row is None:
            raise TicketError(f"ticket #{number} not found for tenant {tenant_id!r}")
        return Ticket(**dict(row))

    def by_id(self, ticket_id: int) -> Ticket:
        row = self._conn.execute("SELECT * FROM tickets WHERE ticket_id = ?", (ticket_id,)).fetchone()
        if row is None:
            raise TicketError(f"ticket id {ticket_id} not found")
        return Ticket(**dict(row))

    def search(self, terms: list[str], limit: int = 10, exclude_ticket_id: int | None = None) -> list[Ticket]:
        """Desk-wide keyword search on subjects (used by `ticket search` and the related-ticket panel):
        open/pending/escalated tickets whose subject contains every term, most recent first."""
        terms = [t.strip().lower() for t in terms if t.strip()]
        if not terms:
            return []
        sql = "SELECT * FROM tickets WHERE status IN ('open','pending','escalated')"
        params: list = []
        for term in terms:
            sql += " AND lower(subject) LIKE ?"
            params.append(f"%{term}%")
        if exclude_ticket_id is not None:
            sql += " AND ticket_id != ?"
            params.append(exclude_ticket_id)
        sql += " ORDER BY created_at DESC, ticket_id DESC LIMIT ?"
        params.append(limit)
        return [Ticket(**dict(r)) for r in self._conn.execute(sql, params)]

    def list_tickets(self, tenant_id: str, status: str | None = None) -> list[Ticket]:
        sql, params = "SELECT * FROM tickets WHERE tenant_id = ?", [tenant_id]
        if status:
            sql += " AND status = ?"
            params.append(status)
        return [Ticket(**dict(r)) for r in self._conn.execute(sql + " ORDER BY number", params)]

    def notes_for(self, ticket_id: int, include_internal: bool = True) -> list[Note]:
        sql = "SELECT * FROM ticket_notes WHERE ticket_id = ?"
        if not include_internal:
            sql += " AND visibility = 'public'"
        return [Note(**dict(r)) for r in self._conn.execute(sql + " ORDER BY created_at, note_id", (ticket_id,))]

    # ----------------------------------------------------------------- mutations
    def add_note(self, ticket_id: int, author: str, body: str, visibility: str = "internal") -> Note:
        if visibility not in ("public", "internal"):
            raise ValueError("visibility must be 'public' or 'internal'")
        now = utcnow()
        with self._conn:
            cur = self._conn.execute(
                "INSERT INTO ticket_notes (ticket_id, author, visibility, body, created_at) VALUES (?,?,?,?,?)",
                (ticket_id, author, visibility, body, now))
            self._conn.execute("UPDATE tickets SET updated_at = ? WHERE ticket_id = ?", (now, ticket_id))
        return Note(cur.lastrowid, ticket_id, author, visibility, body, now)

    def update_status(self, ticket_id: int, status: str) -> Ticket:
        now = utcnow()
        with self._conn:
            cur = self._conn.execute("UPDATE tickets SET status = ?, updated_at = ? WHERE ticket_id = ?", (status, now, ticket_id))
            if cur.rowcount != 1:
                raise TicketError(f"ticket id {ticket_id} not found")
        row = self._conn.execute("SELECT * FROM tickets WHERE ticket_id = ?", (ticket_id,)).fetchone()
        return Ticket(**dict(row))

    def next_number(self, tenant_id: str) -> int:
        row = self._conn.execute("SELECT COALESCE(MAX(number), 1000) + 1 FROM tickets WHERE tenant_id = ?", (tenant_id,)).fetchone()
        return int(row[0])

    def create_ticket(self, tenant_id: str, subject: str, priority: str, customer_id: str, assignee: str | None = None) -> Ticket:
        now = utcnow()
        number = self.next_number(tenant_id)
        with self._conn:
            cur = self._conn.execute(
                "INSERT INTO tickets (tenant_id, number, subject, status, priority, customer_id, assignee, created_at, updated_at)"
                " VALUES (?,?,?,?,?,?,?,?,?)", (tenant_id, number, subject, "open", priority, customer_id, assignee, now, now))
        return self.by_id(cur.lastrowid)


def open_connection(db_path: Path) -> sqlite3.Connection:
    db_path.parent.mkdir(parents=True, exist_ok=True)
    conn = sqlite3.connect(str(db_path))
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA foreign_keys = ON")
    return conn
"""Tenants (customer organisations using the desk) and their end-customers."""
from __future__ import annotations

import json
import sqlite3
from dataclasses import dataclass
from pathlib import Path

SCHEMA = """
CREATE TABLE IF NOT EXISTS tenants (
    tenant_id     TEXT PRIMARY KEY,
    slug          TEXT NOT NULL UNIQUE,
    name          TEXT NOT NULL,
    plan          TEXT NOT NULL,
    timezone      TEXT NOT NULL,
    escalation_hook TEXT NOT NULL,
    created_at    TEXT NOT NULL
);
CREATE TABLE IF NOT EXISTS customers (
    customer_id   TEXT PRIMARY KEY,
    tenant_id     TEXT NOT NULL REFERENCES tenants(tenant_id),
    name          TEXT NOT NULL,
    email         TEXT NOT NULL,
    account_ref   TEXT NOT NULL,
    created_at    TEXT NOT NULL
);
CREATE INDEX IF NOT EXISTS idx_customers_tenant ON customers(tenant_id);
"""


@dataclass(frozen=True)
class Tenant:
    tenant_id: str
    slug: str
    name: str
    plan: str
    timezone: str
    escalation_hook: str
    created_at: str


@dataclass(frozen=True)
class Customer:
    customer_id: str
    tenant_id: str
    name: str
    email: str
    account_ref: str
    created_at: str


class TenantError(LookupError):
    pass


class TenantStore:
    def __init__(self, conn: sqlite3.Connection):
        self._conn = conn
        self._conn.executescript(SCHEMA)

    def load_seed(self, seed_dir: Path) -> tuple[int, int]:
        tenants = json.loads((seed_dir / "tenants.json").read_text())
        customers = json.loads((seed_dir / "customers.json").read_text())
        with self._conn:
            self._conn.executemany(
                "INSERT OR REPLACE INTO tenants VALUES (:tenant_id,:slug,:name,:plan,:timezone,:escalation_hook,:created_at)", tenants)
            self._conn.executemany(
                "INSERT OR REPLACE INTO customers VALUES (:customer_id,:tenant_id,:name,:email,:account_ref,:created_at)", customers)
        return len(tenants), len(customers)

    def by_slug(self, slug: str) -> Tenant:
        row = self._conn.execute("SELECT * FROM tenants WHERE slug = ?", (slug,)).fetchone()
        if row is None:
            raise TenantError(f"unknown tenant {slug!r}")
        return Tenant(**dict(row))

    def by_id(self, tenant_id: str) -> Tenant:
        row = self._conn.execute("SELECT * FROM tenants WHERE tenant_id = ?", (tenant_id,)).fetchone()
        if row is None:
            raise TenantError(f"unknown tenant id {tenant_id!r}")
        return Tenant(**dict(row))

    def list_tenants(self) -> list[Tenant]:
        return [Tenant(**dict(r)) for r in self._conn.execute("SELECT * FROM tenants ORDER BY slug")]

    def customer(self, customer_id: str) -> Customer:
        row = self._conn.execute("SELECT * FROM customers WHERE customer_id = ?", (customer_id,)).fetchone()
        if row is None:
            raise TenantError(f"unknown customer {customer_id!r}")
        return Customer(**dict(row))
"""Small in-process LRU cache for hot records (ticket views, tenant rows)."""
from __future__ import annotations

from collections import OrderedDict
from typing import Any, Callable, Generic, Hashable, TypeVar

T = TypeVar("T")


class RecordCache(Generic[T]):
    def __init__(self, max_entries: int = 256):
        self.max_entries = max(1, max_entries)
        self._entries: "OrderedDict[Hashable, T]" = OrderedDict()
        self.hits = 0
        self.misses = 0

    def get(self, key: Hashable) -> T | None:
        if key in self._entries:
            self._entries.move_to_end(key)
            self.hits += 1
            return self._entries[key]
        self.misses += 1
        return None

    def put(self, key: Hashable, value: T) -> T:
        self._entries[key] = value
        self._entries.move_to_end(key)
        while len(self._entries) > self.max_entries:
            self._entries.popitem(last=False)
        return value

    def get_or_load(self, key: Hashable, loader: Callable[[], T]) -> T:
        cached = self.get(key)
        if cached is not None:
            return cached
        return self.put(key, loader())

    def invalidate(self, key: Hashable) -> None:
        self._entries.pop(key, None)

    def clear(self) -> None:
        self._entries.clear()

    def __len__(self) -> int:
        return len(self._entries)

    def stats(self) -> dict[str, Any]:
        return {"entries": len(self._entries), "hits": self.hits, "misses": self.misses}
