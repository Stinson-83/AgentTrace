[144.097824, "o", "> "]
[144.097988, "o", "def test_transport_failure_returns_failed_result(db, service, settings, monkeypatch, error, expected):\r\n\u001b[?2004l\r"]
[144.098036, "o", "\u001b[?2004h> "]
[144.098165, "o", "    monkeypatch.setattr(\"urllib.request.urlopen\", Mock(side_effect=error))\r\n\u001b[?2004l\r"]
[144.098204, "o", "\u001b[?2004h> "]
[144.098334, "o", "    client = NotificationRelayClient(\"http://relay\", timeout_sec=0.01)\r\n\u001b[?2004l\r"]
[144.098373, "o", "\u001b[?2004h"]
[144.098416, "o", "> "]
[144.098559, "o", "    result = escalate(service, client, settings, db[1].by_slug(\"northwind\"), 1042, \"Investigate\")\r\n\u001b[?2004l\r"]
[144.098599, "o", "\u001b[?2004h> "]
[144.098706, "o", "    assert not result.delivered and expected in result.error\r\n\u001b[?2004l\r"]
[144.098765, "o", "\u001b[?2004h> "]
[144.098902, "o", "    assert service.view(\"ten_nw\", 1042).ticket.status == \"escalated\"\r\n\u001b[?2004l\r"]
[144.098952, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[144.100797, "o", "\u001b[?2004hroot@be17504a2265:/app# "]
[144.101022, "o", "python -m pytest -q tests > /tmp/escalation-tests.log 2>&1; cat /tmp/escalation-tests.log\r\n\u001b[?2004l\r"]
