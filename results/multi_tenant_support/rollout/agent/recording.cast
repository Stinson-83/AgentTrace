[158.821685, "o", "        return self.cache.get_or_load(f\"view:{ticket.ticket_id}\", lambda: self._assemble(ticket))\r\n\r\n    def view_by_id(self, ticket_id: int) -> TicketView:\r\n        return self.cache.get_or_load(f\"view:{ticket_id}\", lambda: self._assemble(self.tickets.by_id(ticket_id)))\r\n\r\n    def _assemble(self, ticket: Ticket) -> TicketView:\r\n        return TicketView(ticket=ticket, customer=self.tenants.customer(ticket.customer_id), notes=self.tickets.notes_for(ticket.ticket_id))\r\n\r\n    def invalidate(self, ticket_id: int) -> None:\r\n        self.cache.invalidate(f\"view:{ticket_id}\")\r\n\r\n    def related(self, ticket: Ticket, limit: int = 5) -> list[dict[str, Any]]:\r\n        \"\"\"Possible duplicates within the tenant: open tickets sharing key terms, with the context the\r\n        agent UI's 'related tickets' panel shows (customer, last internal note).\"\"\"\r\n        out = []\r\n        for other in self.tickets.search(subject_terms(ticket.subject), limit=limit,\r\n"]
[158.821788, "o", "                                         exclude_ticket_id=ticket.ticket_id, tenant_id=ticket.tenant_id):\r\n            view = self.view_by_id(other.ticket_id)\r\n            note = view.latest_internal_note\r\n            out.append({\r\n                \"tenant\": self.tenants.by_id(other.tenant_id).slug,\r\n                \"number\": other.number,\r\n                \"subject\": other.subject,\r\n                \"status\": other.status,\r\n                \"priority\": other.priority,\r\n                \"customer\": view.customer.name,\r\n                \"last_internal_note\": note.body if note else None,\r\n            })\r\n        return out\r\n\r\n\r\n# ------------------------------------------------------------------------------- SLA\r\ndef _parse(ts: str) -> datetime:\r\n"]
[158.821827, "o", "    return datetime.fromisoformat(ts.replace(\"Z\", \"+00:00\"))\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass SlaStatus:\r\n    priority: str\r\n    target_hours: int\r\n    age_hours: float\r\n"]
[158.823437, "o", "@dataclass(frozen=True)\r\nclass EscalationResult:\r\n    tenant: str\r\n    number: int\r\n    status: str\r\n    delivered: bool\r\n    delivery_id: str | None\r\n    error: str | None = None\r\n\r\n\r\nclass EscalationError(RuntimeError):\r\n    pass\r\n\r\n\r\ndef escalate(service: TicketService, relay: NotificationRelayClient, settings: Settings, tenant: Tenant, number: int, reason: str, actor: str = \"cli\") -> EscalationResult:\r\n    \"\"\"Persist an escalation, then notify the tenant's on-call.\r\n\r\n    Delivery is best-effort: a relay failure is returned in ``error`` and never\r\n    rolls back the ticket update. Context is captured before adding our audit note.\r\n    \"\"\"\r\n    try:\r\n"]
[158.823447, "o", "        ticket = service.tickets.get_ticket(tenant.tenant_id, number)\r\n    except TicketError as e:\r\n        raise EscalationError(str(e)) from e\r\n    if ticket.tenant_id != tenant.tenant_id:\r\n        raise EscalationError(f\"ticket #{number} does not belong to tenant {tenant.slug!r}\")\r\n    if ticket.status in (\"resolved\", \"closed\"):\r\n        raise EscalationError(f\"ticket #{number} is {ticket.status} and cannot be escalated\")\r\n\r\n    # Cached views may predate recent notes or status changes.\r\n    service.invalidate(ticket.ticket_id)\r\n    view = service.view(tenant.tenant_id, number)\r\n"]
[158.823529, "o", "    latest_note = view.latest_internal_note\r\n    now = datetime.now(timezone.utc)\r\n    event = {\r\n        \"event\": \"ticket.escalated\",\r\n        \"tenant\": tenant.slug,\r\n        \"occurred_at\": now.isoformat().replace(\"+00:00\", \"Z\"),\r\n        \"actor\": actor,\r\n        \"ticket\": {\r\n            \"number\": ticket.number,\r\n            \"subject\": ticket.subject,\r\n            \"status\": \"escalated\",\r\n            \"priority\": ticket.priority,\r\n            \"customer\": view.customer.name,\r\n        },\r\n        \"escalation\": {\r\n            \"reason\": reason,\r\n            \"sla\": sla_status(ticket, settings, now).as_dict(),\r\n            \"latest_internal_note\": latest_note.body if latest_note else None,\r\n            \"related\": service.related(ticket),\r\n        },\r\n    }\r\n    try:\r\n        updated = service.tickets.update_status(ticket.ticket_id, \"escalated\")\r\n        service.tickets.add_note(ticket.ticket_id, actor, f\"Escalated by {actor}: {reason}\", \"internal\")\r\n    finally:\r\n        service.invalidate(ticket.ticket_id)\r\n\r\n    try:\r\n        response = relay.post(tenant, event)\r\n"]
[158.823537, "o", "        if response.status != 202:\r\n            raise RelayError(f\"relay rejected the notification ({response.status}): {response.body}\")\r\n        delivery_id = response.body.get(\"delivery_id\")\r\n        if not isinstance(delivery_id, str) or not delivery_id:\r\n            raise RelayError(\"relay response did not include a delivery_id\")\r\n    except RelayError as e:\r\n        return EscalationResult(tenant.slug, number, updated.status, False, None, str(e))\r\n    return EscalationResult(tenant.slug, number, updated.status, True, delivery_id)\r\n"]
[158.82501, "o", "    def __init__(self, base_url: str, timeout_sec: float = 10.0):\r\n        self.base_url = base_url.rstrip(\"/\")\r\n        self.timeout_sec = timeout_sec\r\n\r\n    def post(self, tenant: Tenant, event: dict[str, Any]) -> RelayResponse:\r\n        data = json.dumps(event, separators=(\",\", \":\")).encode(\"utf-8\")\r\n"]
[158.825062, "o", "        req = urllib.request.Request(\r\n            self.base_url + tenant.escalation_hook, data=data, method=\"POST\",\r\n            headers={\"Content-Type\": \"application/json\", \"X-Deskline-Tenant\": tenant.slug, \"X-Deskline-Event\": str(event.get(\"event\", \"\"))},\r\n        )\r\n        try:\r\n            with urllib.request.urlopen(req, timeout=self.timeout_sec) as resp:\r\n"]
[158.825098, "o", "                raw = resp.read().decode(\"utf-8\")\r\n                return RelayResponse(resp.status, json.loads(raw) if raw else {})\r\n        except urllib.error.HTTPError as e:\r\n            raise RelayError(f\"relay rejected the notification ({e.code}): {e.read().decode('utf-8', 'replace')}\") from e\r\n        except urllib.error.URLError as e:\r\n            raise RelayError(f\"relay unreachable at {self.base_url}: {e.reason}\") from e\r\n        except OSError as e:\r\n            raise RelayError(f\"relay unreachable at {self.base_url}: {e}\") from e\r\n        except ValueError as e:\r\n            raise RelayError(f\"invalid relay response: {e}\") from e\r\n\r\n    def health(self) -> RelayResponse:\r\n        try:\r\n            with urllib.request.urlopen(self.base_url + \"/healthz\", timeout=self.timeout_sec) as resp:\r\n                return RelayResponse(resp.status, json.loads(resp.read().decode(\"utf-8\")))\r\n        except urllib.error.URLError as e:\r\n            raise RelayError(f\"relay unreachable at {self.base_url}: {e.reason}\") from e\r\n"]
