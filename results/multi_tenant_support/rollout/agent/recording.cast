[175.545688, "i", "python - <<'PY'\nfrom pathlib import Path\np=Path('deskline/notification.py')\ns=p.read_text().replace('import json\\n', 'import json\\nfrom http.client import HTTPException\\n')\ns=s.replace('                return RelayResponse(resp.status, json.loads(raw) if raw else {})', '                body = json.loads(raw) if raw else {}\\n                if not isinstance(body, dict):\\n                    raise RelayError(\"invalid relay response: expected a JSON object\")\\n                return RelayResponse(resp.status, body)')\ns=s.replace('        except OSError as e:', '        except (OSError, HTTPException) as e:')\np.write_text(s)\np=Path('tests/test_notification_escalation.py')\ns=p.read_text().replace('from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer', 'from http.client import IncompleteRead\\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer')\ns=s.replace('    (ConnectionResetError(\"connection reset\"), \"connection reset\"),', '    (ConnectionResetError(\"connection reset\"), \"connection reset\"),\\n    (IncompleteRead(b\"partial\"), \"unreachable\"),')\ns += '''\n\n@pytest.mark.parametrize(\"raw\", [b\"not-json\", b\"[]\", b'{\"delivery_id\":null}'])\ndef test_malformed_relay_response_is_failed_delivery(db, service, settings, monkeypatch, raw):\n    response = Mock(status=202)\n    response.read.return_value = raw\n    context = Mock()\n    context.__enter__ = Mock(return_value=response)\n    context.__exit__ = Mock(return_value=False)\n    monkeypatch.setattr(\"urllib.request.urlopen\", Mock(return_value=context))\n    result = escalate(service, NotificationRelayClient(\"http://relay\"), settings,\n                      db[1].by_slug(\"northwind\"), 1042, \"Investigate\")\n    assert not result.delivered and result.error\n    assert service.view(\"ten_nw\", 1042).ticket.status == \"escalated\"\n'''\np.write_text(s)\nPY\npython -m pytest -q tests > /tmp/escalation-tests.log 2>&1; tail -n 6 /tmp/escalation-tests.log\n"]
