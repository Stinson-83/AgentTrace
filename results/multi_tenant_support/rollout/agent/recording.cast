[68.842127, "o", "\u001b[?2004h"]
[68.842136, "o", "> "]
[68.842477, "o", "s = p.read_text().replace('def search(self, terms: list[str], limit: int = 10, exclude_ticket_id: int | None = None)', 'def search(self, terms: list[str], limit: int = 10, exclude_ticket_id: int | None = None, tenant_id: str | None = None)')\r\n\u001b[?2004l\r"]
[68.842524, "o", "\u001b[?2004h> "]
[68.843115, "o", "s = s.replace('Desk-wide keyword search on subjects (used by `ticket search` and the related-ticket panel):\\n        open/pending/escalated tickets whose subject contains every term, most recent first.', 'Keyword search on subjects, optionally scoped to a tenant:\\n        open/pending/escalated tickets whose subject contains every term, most recent first.')\r\n\u001b[?2004l\r"]
[68.84315, "o", "\u001b[?2004h> "]
[68.843571, "o", "s = s.replace('        params: list = []\\n        for term in terms:', '        params: list = []\\n        if tenant_id is not None:\\n            sql += \" AND tenant_id = ?\"\\n            params.append(tenant_id)\\n        for term in terms:')\r\n\u001b[?2004l\r"]
[68.843595, "o", "\u001b[?2004h> "]
[68.843664, "o", "p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.843709, "o", "p = Path('deskline/escalation.py')\r\n\u001b[?2004l\r"]
[68.843754, "o", "\u001b[?2004h> "]
[68.844323, "o", "s = p.read_text().replace('from .notification import NotificationRelayClient', 'from .notification import NotificationRelayClient, RelayError').replace('from .ticket_store import Note, Ticket, TicketStore', 'from .ticket_store import Note, Ticket, TicketError, TicketStore')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.844767, "o", "s = s.replace('\"\"\"Possible duplicates: open tickets sharing the subject\\'s key terms, with the context the', '\"\"\"Possible duplicates within the tenant: open tickets sharing key terms, with the context the')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.845313, "o", "s = s.replace('self.tickets.search(subject_terms(ticket.subject), limit=limit, exclude_ticket_id=ticket.ticket_id)', 'self.tickets.search(subject_terms(ticket.subject), limit=limit,\\n                                         exclude_ticket_id=ticket.ticket_id, tenant_id=ticket.tenant_id)')\r\n\u001b[?2004l\r"]
[68.845359, "o", "\u001b[?2004h> "]
[68.845537, "o", "s = s.replace('    delivery_id: str | None\\n', '    delivery_id: str | None\\n    error: str | None = None\\n')\r\n\u001b[?2004l\r"]
[68.84557, "o", "\u001b[?2004h> "]
[68.845665, "o", "start = s.index('    \"\"\"Escalate ticket ``number``')\r\n\u001b[?2004l\r"]
[68.845697, "o", "\u001b[?2004h> "]
[68.845853, "o", "s = s[:start] + '''    \"\"\"Persist an escalation, then notify the tenant's on-call.\r\n\u001b[?2004l\r"]
[68.845887, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[68.84592, "o", "> "]
[68.846037, "o", "    Delivery is best-effort: a relay failure is returned in ``error`` and never\r\n\u001b[?2004l\r"]
[68.846062, "o", "\u001b[?2004h> "]
[68.846218, "o", "    rolls back the ticket update. Context is captured before adding our audit note.\r\n\u001b[?2004l\r"]
[68.846224, "o", "\u001b[?2004h> "]
[68.846277, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.846303, "o", ">     try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.846326, "o", "> "]
[68.846427, "o", "        ticket = service.tickets.get_ticket(tenant.tenant_id, number)\r\n\u001b[?2004l\r"]
[68.846459, "o", "\u001b[?2004h> "]
[68.846503, "o", "    except TicketError as e:\r\n\u001b[?2004l\r"]
[68.846517, "o", "\u001b[?2004h> "]
[68.846608, "o", "        raise EscalationError(str(e)) from e\r\n\u001b[?2004l\r"]
[68.846634, "o", "\u001b[?2004h"]
[68.846663, "o", "> "]
[68.846709, "o", "    if ticket.tenant_id != tenant.tenant_id:\r\n\u001b[?2004l\r"]
[68.846743, "o", "\u001b[?2004h> "]
[68.846927, "o", "        raise EscalationError(f\"ticket #{number} does not belong to tenant {tenant.slug!r}\")\r\n\u001b[?2004l\r"]
[68.846961, "o", "\u001b[?2004h"]
[68.846986, "o", "> "]
[68.847039, "o", "    if ticket.status in (\"resolved\", \"closed\"):\r\n\u001b[?2004l\r"]
[68.84705, "o", "\u001b[?2004h> "]
[68.847235, "o", "        raise EscalationError(f\"ticket #{number} is {ticket.status} and cannot be escalated\")\r\n\u001b[?2004l\r"]
[68.84727, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.847387, "o", "    # Cached views may predate recent notes or status changes.\r\n\u001b[?2004l\r"]
[68.847433, "o", "\u001b[?2004h"]
[68.847455, "o", "> "]
[68.847477, "o", "    service.invalidate(ticket.ticket_id)\r\n\u001b[?2004l\r"]
[68.847498, "o", "\u001b[?2004h> "]
[68.84753, "o", "    view = service.view(tenant.tenant_id, number)\r\n\u001b[?2004l\r"]
[68.84756, "o", "\u001b[?2004h> "]
[68.847596, "o", "    latest_note = view.latest_internal_note\r\n\u001b[?2004l\r"]
[68.847626, "o", "\u001b[?2004h> "]
[68.847657, "o", "    now = datetime.now(timezone.utc)\r\n\u001b[?2004l\r"]
[68.847691, "o", "\u001b[?2004h>     event = {\r\n"]
[68.847701, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[68.848696, "o", "        \"event\": \"ticket.escalated\",\r\n\u001b[?2004l\r"]
[68.848755, "o", "\u001b[?2004h"]
[68.848783, "o", ">         \"tenant\": tenant.slug,\r\n\u001b[?2004l\r"]
[68.848789, "o", "\u001b[?2004h> "]
[68.848854, "o", "        \"occurred_at\": now.isoformat().replace(\"+00:00\", \"Z\"),\r\n\u001b[?2004l\r"]
[68.84888, "o", "\u001b[?2004h> "]
[68.848907, "o", "        \"actor\": actor,\r\n\u001b[?2004l\r"]
[68.848932, "o", "\u001b[?2004h> "]
[68.848959, "o", "        \"ticket\": {\r\n\u001b[?2004l\r"]
[68.848981, "o", "\u001b[?2004h> "]
[68.849009, "o", "            \"number\": ticket.number,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.849052, "o", "            \"subject\": ticket.subject,\r\n\u001b[?2004l\r"]
[68.849074, "o", "\u001b[?2004h"]
[68.84908, "o", "> "]
[68.849118, "o", "            \"status\": \"escalated\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.849165, "o", "            \"priority\": ticket.priority,\r\n\u001b[?2004l\r"]
[68.849186, "o", "\u001b[?2004h> "]
[68.849252, "o", "            \"customer\": view.customer.name,\r\n\u001b[?2004l\r"]
[68.849258, "o", "\u001b[?2004h>         },\r\n\u001b[?2004l\r"]
[68.849307, "o", "\u001b[?2004h> "]
[68.849331, "o", "        \"escalation\": {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.849359, "o", "            \"reason\": reason,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.849434, "o", "            \"sla\": sla_status(ticket, settings, now).as_dict(),\r\n\u001b[?2004l\r"]
[68.849467, "o", "\u001b[?2004h> "]
[68.84954, "o", "            \"latest_internal_note\": latest_note.body if latest_note else None,\r\n\u001b[?2004l\r"]
[68.84957, "o", "\u001b[?2004h"]
[68.849577, "o", "> "]
[68.849617, "o", "            \"related\": service.related(ticket),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.849648, "o", "        },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.849671, "o", "    }\r\n\u001b[?2004l\r"]
[68.849677, "o", "\u001b[?2004h>     try:\r\n\u001b[?2004l\r"]
[68.8497, "o", "\u001b[?2004h> "]
[68.84978, "o", "        updated = service.tickets.update_status(ticket.ticket_id, \"escalated\")\r\n\u001b[?2004l\r"]
[68.849812, "o", "\u001b[?2004h> "]
[68.849913, "o", "        service.tickets.add_note(ticket.ticket_id, actor, f\"Escalated by {actor}: {reason}\", \"internal\")\r\n\u001b[?2004l\r"]
[68.849944, "o", "\u001b[?2004h> "]
[68.849965, "o", "    finally:\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.849987, "o", "> "]
[68.850018, "o", "        service.invalidate(ticket.ticket_id)\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.85004, "o", "> \r\n\u001b[?2004l\r"]
[68.850061, "o", "\u001b[?2004h>     try:\r\n\u001b[?2004l\r"]
[68.850082, "o", "\u001b[?2004h> "]
[68.850115, "o", "        response = relay.post(tenant, event)\r\n\u001b[?2004l\r"]
[68.850137, "o", "\u001b[?2004h"]
[68.850159, "o", "> "]
[68.850185, "o", "        if response.status != 202:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.8503, "o", "            raise RelayError(f\"relay rejected the notification ({response.status}): {response.body}\")\r\n\u001b[?2004l\r"]
[68.850331, "o", "\u001b[?2004h> "]
[68.850378, "o", "        delivery_id = response.body.get(\"delivery_id\")\r\n\u001b[?2004l\r"]
[68.850409, "o", "\u001b[?2004h> "]
[68.850468, "o", "        if not isinstance(delivery_id, str) or not delivery_id:\r\n\u001b[?2004l\r"]
[68.850499, "o", "\u001b[?2004h"]
[68.850521, "o", "> "]
[68.85057, "o", "            raise RelayError(\"relay response did not include a delivery_id\")\r\n\u001b[?2004l\r"]
[68.850592, "o", "\u001b[?2004h> "]
[68.850624, "o", "    except RelayError as e:\r\n\u001b[?2004l\r"]
[68.850634, "o", "\u001b[?2004h> "]
[68.850727, "o", "        return EscalationResult(tenant.slug, number, updated.status, False, None, str(e))\r\n\u001b[?2004l\r"]
[68.850769, "o", "\u001b[?2004h> "]
[68.850839, "o", "    return EscalationResult(tenant.slug, number, updated.status, True, delivery_id)\r\n\u001b[?2004l\r"]
[68.850869, "o", "\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.85089, "o", "> "]
[68.85092, "o", "p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.85094, "o", "> "]
[68.850972, "o", "p = Path('deskline/notification.py')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.851948, "o", "s = p.read_text().replace('        except urllib.error.URLError as e:\\n            raise RelayError(f\"relay unreachable at {self.base_url}: {e.reason}\") from e\\n\\n    def health', '        except urllib.error.URLError as e:\\n            raise RelayError(f\"relay unreachable at {self.base_url}: {e.reason}\") from e\\n        except OSError as e:\\n            raise RelayError(f\"relay unreachable at {self.base_url}: {e}\") from e\\n        except ValueError as e:\\n            raise RelayError(f\"invalid relay response: {e}\") from e\\n\\n    def health')\r\n\u001b[?2004l\r"]
[68.851961, "o", "\u001b[?2004h> "]
[68.852056, "o", "p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.852096, "o", "p = Path('deskline/cli.py')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.852567, "o", "s = p.read_text().replace(' | sla-report | relay-health.', ' | escalate | sla-report | relay-health.').replace('from .escalation import TicketService, sla_report, sla_status', 'from .escalation import EscalationError, TicketService, escalate, sla_report, sla_status')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.852604, "o", "pos = s.index('def cmd_relay_health(')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.852656, "o", "s = s[:pos] + '''def cmd_escalate(args, settings) -> int:\r\n\u001b[?2004l\r"]
[68.852688, "o", "\u001b[?2004h> "]
[68.852719, "o", "    ctx = Context(settings)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.852755, "o", "    try:\r\n\u001b[?2004l\r"]
[68.852781, "o", "\u001b[?2004h> "]
[68.852804, "o", "        tenant = ctx.tenants.by_slug(args.tenant)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.85292, "o", "        result = escalate(ctx.service, ctx.relay, settings, tenant, args.ticket, args.reason, args.actor)\r\n\u001b[?2004l\r"]
[68.852951, "o", "\u001b[?2004h> "]
[68.852999, "o", "    except (TenantError, TicketError, EscalationError) as e:\r\n\u001b[?2004l\r"]
[68.853021, "o", "\u001b[?2004h> "]
[68.853055, "o", "        print(str(e), file=sys.stderr)\r\n\u001b[?2004l\r"]
[68.853076, "o", "\u001b[?2004h"]
[68.853082, "o", "> "]
[68.85312, "o", "        return 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.853174, "o", "    print(f\"{result.tenant} #{result.number}: {result.status}; \"\r\n\u001b[?2004l\r"]
[68.853196, "o", "\u001b[?2004h> "]
[68.853262, "o", "          f\"delivery {'succeeded' if result.delivered else 'failed'}\"\r\n\u001b[?2004l\r"]
[68.853283, "o", "\u001b[?2004h"]
[68.85329, "o", "> "]
[68.853357, "o", "          + (f\" ({result.delivery_id})\" if result.delivery_id else \"\"))\r\n\u001b[?2004l\r"]
[68.853379, "o", "\u001b[?2004h"]
[68.853385, "o", "> "]
[68.853411, "o", "    if not result.delivered:\r\n\u001b[?2004l\r"]
[68.853433, "o", "\u001b[?2004h> "]
[68.853507, "o", "        print(result.error or \"notification delivery failed\", file=sys.stderr)\r\n\u001b[?2004l\r"]
[68.853538, "o", "\u001b[?2004h> "]
[68.853562, "o", "        return 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.853585, "o", ">     return 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[68.853606, "o", "> "]
[68.853635, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.853641, "o", "''' + s[pos:]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.853691, "o", "pos = s.index('    sub.add_parser(\"relay-health\"')\r\n\u001b[?2004l\r"]
[68.853725, "o", "\u001b[?2004h> "]
[68.85383, "o", "s = s[:pos] + '''    e = sub.add_parser(\"escalate\", help=\"escalate a ticket and notify the tenant's on-call\")\r\n\u001b[?2004l\r"]
[68.853855, "o", "\u001b[?2004h> "]
[68.853893, "o", "    e.add_argument(\"--tenant\", required=True)\r\n\u001b[?2004l\r"]
[68.853918, "o", "\u001b[?2004h> "]
[68.85397, "o", "    e.add_argument(\"--ticket\", required=True, type=int)\r\n\u001b[?2004l\r"]
[68.85398, "o", "\u001b[?2004h"]
[68.854017, "o", "> "]
[68.854044, "o", "    e.add_argument(\"--reason\", required=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.854065, "o", "> "]
[68.854094, "o", "    e.add_argument(\"--actor\", default=\"cli\")\r\n\u001b[?2004l\r"]
[68.854115, "o", "\u001b[?2004h"]
[68.854136, "o", "> "]
[68.854161, "o", "    e.set_defaults(func=cmd_escalate)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[68.854182, "o", "\u001b[?2004h"]
[68.854209, "o", "> ''' + s[pos:]\r\n\u001b[?2004l\r"]
[68.85423, "o", "\u001b[?2004h> "]
[68.854258, "o", "p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.854278, "o", "p = Path('README.md')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.854561, "o", "s = p.read_text().replace('| `relay-health`', '| `escalate --tenant <slug> --ticket <number> --reason \"<text>\" [--actor <name>]` | record an escalation and notify the tenant\\'s on-call (non-zero exit on delivery failure; ticket remains escalated) |\\n| `relay-health`')\r\n\u001b[?2004l\r"]
[68.85461, "o", "\u001b[?2004h> "]
[68.854633, "o", "p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
