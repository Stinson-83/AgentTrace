[197.041935, "i", "python - <<'PY'\nimport base64\nimport json\nfrom pathlib import Path\nfrom deskline.cli import Context\nfrom deskline.config import load_settings\nrecords = sorted(Path('/var/lib/notify-relay/received/northwind').glob('*.json'))\npath = records[-1]\nrecord = json.loads(path.read_text())\nevent = json.loads(base64.b64decode(record['body_b64']))\nassert record['path'] == '/hooks/northwind/escalations'\nassert record['headers']['x-deskline-tenant'] == 'northwind'\nassert record['headers']['x-deskline-event'] == 'ticket.escalated'\nassert event['event'] == 'ticket.escalated' and event['tenant'] == 'northwind'\nassert event['ticket']['number'] == 1042 and event['ticket']['status'] == 'escalated'\nassert event['escalation']['reason'] == 'SLA breached, customer chasing'\nassert all(r['tenant'] == 'northwind' for r in event['escalation']['related'])\nctx = Context(load_settings())\nview = ctx.service.view('ten_nw', 1042)\nassert view.ticket.status == 'escalated'\naudit = view.latest_internal_note\nassert audit.author == 'cli' and audit.visibility == 'internal'\nassert audit.body == 'Escalated by cli: SLA breached, customer chasing'\nprior = [n for n in view.notes if n.visibility == 'internal' and n.note_id != audit.note_id]\nassert event['escalation']['latest_internal_note'] == (prior[-1].body if prior else None)\nprint('Verified ticket status:', view.ticket.status)\nprint('Verified internal audit note:', audit.note_id)\nprint('Verified relay event:', path)\nprint('Related tickets:', len(event['escalation']['related']), '(all Northwind)')\nctx.conn.close()\nPY\n"]
