[101.403457, "o", "    duplicate_view = service.view(tenant.tenant_id, 1018)\r\n\u001b[?2004l\r"]
[101.403511, "o", "\u001b[?2004h> "]
[101.403814, "o", "    assert duplicate[\"customer\"] == duplicate_view.customer.name\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.40389, "o", "> "]
[101.404252, "o", "    assert duplicate[\"last_internal_note\"] == duplicate_view.latest_internal_note.body\r\n\u001b[?2004l\r"]
[101.404328, "o", "\u001b[?2004h> "]
[101.404836, "o", "    # Neither overlapping ticket numbers nor similar subjects may cross tenants.\r\n\u001b[?2004l\r"]
[101.404964, "o", "\u001b[?2004h> "]
[101.405233, "o", "    assert tickets.get_ticket(\"ten_hl\", 1042) == other_tenant\r\n\u001b[?2004l\r"]
[101.405315, "o", "\u001b[?2004h> "]
[101.405636, "o", "    assert tickets.notes_for(other_tenant.ticket_id) == other_notes\r\n\u001b[?2004l\r"]
[101.405681, "o", "\u001b[?2004h> "]
[101.405945, "o", "    after = service.view(tenant.tenant_id, 1042)\r\n\u001b[?2004l\r"]
[101.406052, "o", "\u001b[?2004h> "]
[101.406138, "o", "    assert after.ticket.status == \"escalated\"\r\n\u001b[?2004l\r"]
[101.406199, "o", "\u001b[?2004h> "]
[101.406404, "o", "    assert after.latest_internal_note.author == \"oncall.agent\"\r\n\u001b[?2004l\r"]
[101.406458, "o", "\u001b[?2004h> "]
[101.406632, "o", "    assert len(after.notes) == len(before.notes) + 3\r\n\u001b[?2004l\r"]
[101.406689, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[101.406761, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.407051, "o", "def test_escalate_without_internal_context(db, service, settings, relay):\r\n\u001b[?2004l\r"]
[101.407138, "o", "\u001b[?2004h> "]
[101.407272, "o", "    _, tenants, tickets = db\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.407393, "o", "    tenant = tenants.by_slug(\"northwind\")\r\n\u001b[?2004l\r"]
[101.407469, "o", "\u001b[?2004h> "]
[101.40779, "o", "    ticket = tickets.create_ticket(tenant.tenant_id, \"Unique new issue\", \"low\", \"cst_0005\")\r\n\u001b[?2004l\r"]
[101.407851, "o", "\u001b[?2004h> "]
[101.408012, "o", "    tickets.add_note(ticket.ticket_id, \"customer\", \"Public context only\", \"public\")\r\n\u001b[?2004l\r"]
[101.408053, "o", "\u001b[?2004h> "]
[101.40829, "o", "    result = escalate(service, relay, settings, tenant, ticket.number, \"Needs attention\")\r\n\u001b[?2004l\r"]
[101.408347, "o", "\u001b[?2004h> "]
[101.408421, "o", "    event = relay.post.call_args.args[1]\r\n\u001b[?2004l\r"]
[101.408442, "o", "\u001b[?2004h> "]
[101.408618, "o", "    assert result.delivered and event[\"actor\"] == \"cli\"\r\n\u001b[?2004l\r"]
[101.408647, "o", "\u001b[?2004h"]
[101.408715, "o", "> "]
[101.408849, "o", "    assert event[\"escalation\"][\"latest_internal_note\"] is None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.409008, "o", "    assert event[\"escalation\"][\"related\"] == []\r\n\u001b[?2004l\r"]
[101.409092, "o", "\u001b[?2004h> "]
[101.409361, "o", "    assert service.view(tenant.tenant_id, ticket.number).latest_internal_note.author == \"cli\"\r\n\u001b[?2004l\r"]
[101.409421, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[101.409492, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.409689, "o", "@pytest.mark.parametrize(\"status\", [\"resolved\", \"closed\"])\r\n\u001b[?2004l\r"]
[101.409798, "o", "\u001b[?2004h> "]
[101.410049, "o", "def test_cannot_escalate_finished_ticket_even_if_cached(db, service, settings, relay, status):\r\n\u001b[?2004l\r"]
[101.410109, "o", "\u001b[?2004h> "]
[101.410182, "o", "    _, tenants, tickets = db\r\n\u001b[?2004l\r"]
[101.410234, "o", "\u001b[?2004h> "]
[101.410356, "o", "    tenant = tenants.by_slug(\"northwind\")\r\n\u001b[?2004l\r"]
[101.410417, "o", "\u001b[?2004h> "]
[101.410565, "o", "    cached = service.view(tenant.tenant_id, 1042)\r\n\u001b[?2004l\r"]
[101.41062, "o", "\u001b[?2004h> "]
[101.410831, "o", "    ticket = tickets.update_status(cached.ticket.ticket_id, status)\r\n\u001b[?2004l\r"]
[101.41091, "o", "\u001b[?2004h> "]
[101.41103, "o", "    notes = tickets.notes_for(ticket.ticket_id)\r\n\u001b[?2004l\r"]
[101.411131, "o", "\u001b[?2004h> "]
[101.411229, "o", "    with pytest.raises(EscalationError, match=status):\r\n\u001b[?2004l\r"]
[101.411284, "o", "\u001b[?2004h> "]
[101.411474, "o", "        escalate(service, relay, settings, tenant, 1042, \"Too late\")\r\n\u001b[?2004l\r"]
[101.411523, "o", "\u001b[?2004h> "]
[101.411624, "o", "    relay.post.assert_not_called()\r\n\u001b[?2004l\r"]
[101.411671, "o", "\u001b[?2004h> "]
[101.411851, "o", "    assert tickets.get_ticket(tenant.tenant_id, 1042) == ticket\r\n\u001b[?2004l\r"]
[101.411894, "o", "\u001b[?2004h> "]
[101.412028, "o", "    assert tickets.notes_for(ticket.ticket_id) == notes\r\n\u001b[?2004l\r"]
[101.412078, "o", "\u001b[?2004h"]
[101.412123, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[101.412166, "o", "\u001b[?2004h> "]
[101.41235, "o", "def test_unknown_or_other_tenants_ticket_is_not_escalated(db, service, settings, relay):\r\n\u001b[?2004l\r"]
[101.412394, "o", "\u001b[?2004h> "]
[101.412457, "o", "    _, tenants, tickets = db\r\n\u001b[?2004l\r"]
[101.412505, "o", "\u001b[?2004h> "]
[101.412709, "o", "    foreign = tickets.create_ticket(\"ten_hl\", \"Private ticket\", \"high\", \"cst_0001\")\r\n\u001b[?2004l\r"]
[101.412775, "o", "\u001b[?2004h"]
[101.412817, "o", "> "]
[101.412875, "o", "    notes = tickets.notes_for(foreign.ticket_id)\r\n\u001b[?2004l\r"]
[101.412921, "o", "\u001b[?2004h> "]
[101.413064, "o", "    with pytest.raises(EscalationError, match=\"not found\"):\r\n\u001b[?2004l\r"]
[101.413108, "o", "\u001b[?2004h> "]
[101.413364, "o", "        escalate(service, relay, settings, tenants.by_slug(\"northwind\"), foreign.number, \"Wrong tenant\")\r\n\u001b[?2004l\r"]
[101.413405, "o", "\u001b[?2004h> "]
[101.413558, "o", "    with pytest.raises(EscalationError, match=\"not found\"):\r\n\u001b[?2004l\r"]
[101.413613, "o", "\u001b[?2004h> "]
[101.413821, "o", "        escalate(service, relay, settings, tenants.by_slug(\"northwind\"), 999999, \"Missing\")\r\n\u001b[?2004l\r"]
[101.413864, "o", "\u001b[?2004h> "]
[101.413942, "o", "    relay.post.assert_not_called()\r\n\u001b[?2004l\r"]
[101.414001, "o", "\u001b[?2004h"]
[101.414045, "o", "> "]
[101.414116, "o", "    assert tickets.by_id(foreign.ticket_id) == foreign\r\n\u001b[?2004l\r"]
[101.414166, "o", "\u001b[?2004h"]
[101.414206, "o", "> "]
[101.414295, "o", "    assert tickets.notes_for(foreign.ticket_id) == notes\r\n\u001b[?2004l\r"]
[101.414334, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[101.414374, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[101.414412, "o", "> "]
[101.41469, "o", "@pytest.mark.parametrize(\"error\", [\"relay rejected the notification (422)\", \"relay unreachable: connection refused\"])\r\n\u001b[?2004l\r"]
[101.414738, "o", "\u001b[?2004h> "]
[101.414967, "o", "def test_delivery_failure_keeps_update_and_surfaces_error(db, service, settings, relay, error):\r\n\u001b[?2004l\r"]
[101.415006, "o", "\u001b[?2004h> "]
[101.415066, "o", "    _, tenants, tickets = db\r\n\u001b[?2004l\r"]
[101.415106, "o", "\u001b[?2004h> "]
[101.415324, "o", "    tenant = tenants.by_slug(\"northwind\")\r\n\u001b[?2004l\r"]
[101.415375, "o", "\u001b[?2004h> "]
[101.415531, "o", "    before = service.view(tenant.tenant_id, 1042)\r\n\u001b[?2004l\r"]
[101.415567, "o", "\u001b[?2004h> "]
[101.415677, "o", "    relay.post.side_effect = RelayError(error)\r\n\u001b[?2004l\r"]
[101.415719, "o", "\u001b[?2004h> "]
[101.415925, "o", "    result = escalate(service, relay, settings, tenant, 1042, \"Please investigate\")\r\n\u001b[?2004l\r"]
[101.415959, "o", "\u001b[?2004h> "]
[101.416176, "o", "    assert not result.delivered and result.delivery_id is None and result.error == error\r\n\u001b[?2004l\r"]
[101.416209, "o", "\u001b[?2004h> "]
[101.416299, "o", "    assert result.status == \"escalated\"\r\n\u001b[?2004l\r"]
[101.416329, "o", "\u001b[?2004h> "]
[101.416454, "o", "    after = service.view(tenant.tenant_id, 1042)\r\n\u001b[?2004l\r"]
[101.416499, "o", "\u001b[?2004h> "]
[101.416724, "o", "    assert after.ticket.status == \"escalated\" and len(after.notes) == len(before.notes) + 1\r\n\u001b[?2004l\r"]
[101.416767, "o", "\u001b[?2004h> "]
[101.416946, "o", "    assert \"Please investigate\" in after.latest_internal_note.body\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.416996, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[101.417035, "o", "\u001b[?2004h> "]
[101.4173, "o", "@pytest.mark.parametrize(\"response\", [RelayResponse(422, {\"error\": \"rejected\"}), RelayResponse(202, {})])\r\n\u001b[?2004l\r"]
[101.417332, "o", "\u001b[?2004h> "]
[101.417554, "o", "def test_unaccepted_response_is_failed_delivery(db, service, settings, relay, response):\r\n\u001b[?2004l\r"]
[101.417585, "o", "\u001b[?2004h> "]
[101.417689, "o", "    relay.post.return_value = response\r\n\u001b[?2004l\r"]
[101.417722, "o", "\u001b[?2004h> "]
[101.417951, "o", "    result = escalate(service, relay, settings, db[1].by_slug(\"northwind\"), 1042, \"Investigate\")\r\n\u001b[?2004l\r"]
[101.417978, "o", "\u001b[?2004h> "]
[101.418174, "o", "    assert not result.delivered and result.error and result.delivery_id is None\r\n\u001b[?2004l\r"]
[101.418196, "o", "\u001b[?2004h"]
[101.418212, "o", "> "]
[101.418379, "o", "    assert service.view(\"ten_nw\", 1042).ticket.status == \"escalated\"\r\n\u001b[?2004l\r"]
[101.418397, "o", "\u001b[?2004h"]
[101.418413, "o", "> \r\n\u001b[?2004l\r"]
[101.418427, "o", "\u001b[?2004h"]
[101.418441, "o", "> \r\n\u001b[?2004l\r"]
[101.418456, "o", "\u001b[?2004h"]
[101.418473, "o", "> "]
[101.418666, "o", "def test_related_scopes_before_limit_but_desk_search_stays_global(db, service):\r\n\u001b[?2004l\r"]
[101.418684, "o", "\u001b[?2004h"]
[101.4187, "o", "> "]
[101.418759, "o", "    _, _, tickets = db\r\n\u001b[?2004l\r"]
[101.418777, "o", "\u001b[?2004h"]
[101.418794, "o", "> "]
[101.418909, "o", "    source = tickets.get_ticket(\"ten_nw\", 1042)\r\n\u001b[?2004l\r"]
[101.418926, "o", "\u001b[?2004h"]
[101.418943, "o", "> "]
[101.418995, "o", "    for _ in range(7):\r\n\u001b[?2004l\r"]
[101.419014, "o", "\u001b[?2004h"]
[101.41904, "o", "> "]
[101.419215, "o", "        tickets.create_ticket(\"ten_hl\", source.subject, \"high\", \"cst_0001\")\r\n\u001b[?2004l\r"]
[101.419233, "o", "\u001b[?2004h"]
[101.419249, "o", "> "]
[101.419416, "o", "    global_matches = tickets.search([\"checkout\", \"timeout\", \"bulk\"])\r\n\u001b[?2004l\r"]
[101.419433, "o", "\u001b[?2004h"]
[101.41945, "o", "> "]
[101.419605, "o", "    assert any(t.tenant_id == \"ten_hl\" for t in global_matches)\r\n\u001b[?2004l\r"]
[101.419623, "o", "\u001b[?2004h"]
[101.41964, "o", "> "]
[101.419756, "o", "    related = service.related(source, limit=1)\r\n\u001b[?2004l\r"]
[101.419775, "o", "\u001b[?2004h"]
[101.419792, "o", "> "]
[101.419862, "o", "    assert len(related) == 1\r\n\u001b[?2004l\r"]
[101.41988, "o", "\u001b[?2004h"]
[101.419896, "o", "> "]
[101.4201, "o", "    assert related[0][\"tenant\"] == \"northwind\" and related[0][\"number\"] == 1018\r\n\u001b[?2004l\r"]
[101.420118, "o", "\u001b[?2004h"]
[101.420137, "o", "> PY\r\n\u001b[?2004l\r"]
[101.421798, "o", "\u001b[?2004hroot@be17504a2265:/app# "]
