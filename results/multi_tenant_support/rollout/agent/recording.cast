[12.710124, "o", "cat deskline/escalation.py deskline/notification.py deskline/config.py\r\n\u001b[?2004l\r"]
[12.711226, "o", "\"\"\"Ticket views, related-ticket lookup, SLA policy and the escalation workflow.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport re\r\nfrom dataclasses import dataclass, field\r\nfrom datetime import datetime, timezone\r\nfrom typing import Any\r\n\r\nfrom .cache import RecordCache\r\nfrom .config import Settings\r\nfrom .notification import NotificationRelayClient\r\nfrom .tenant_store import Customer, Tenant, TenantStore\r\nfrom .ticket_store import Note, Ticket, TicketStore\r\n\r\nSTOPWORDS = {\"on\", \"the\", \"a\", \"an\", \"in\", \"of\", \"to\", \"for\", \"not\", \"is\", \"and\", \"with\", \"by\", \"our\", \"my\", \"at\"}\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass TicketView:\r\n    \"\"\"A ticket with its customer and notes — what the agent UI and notifications render from.\"\"\"\r\n\r\n    ticket: Ticket\r\n    customer: Customer\r\n    notes: list[Note] = field(default_factory=list)\r\n\r\n    @property\r\n    def latest_internal_note(self) -> Note | None:\r\n        internal = [n for n in self.notes if n.visibility == \"internal\"]\r\n        return internal[-1] if internal else None\r\n\r\n    def as_dict(self) -> dict[str, Any]:\r\n        return {\"ticket\": self.ticket.__dict__, \"customer\": self.customer.__dict__, \"notes\": [n.__dict__ for n in self.notes]}\r\n\r\n\r\ndef subject_terms(subject: str) -> list[str]:\r\n    words = [w for w in re.findall(r\"[a-z0-9]+\", subject.lower()) if len(w) > 2 and w not in STOPWORDS]\r\n    return words[:3]\r\n\r\n\r\nclass TicketService:\r\n    \"\"\"Read-side helper used by the CLI, reports and notifications.\"\"\"\r\n\r\n    def __init__(self, tickets: TicketStore, tenants: TenantStore, cache: RecordCache | None = None):\r\n        self.tickets = tickets\r\n        self.tenants = tenants\r\n        self.cache: RecordCache[TicketView] = cache or RecordCache(256)\r\n\r\n    def view(self, tenant_id: str, number: int) -> TicketView:\r\n        ticket = self.tickets.get_ticket(tenant_id, number)\r\n        return self.cache.get_or_load(f\"view:{ticket.ticket_id}\", lambda: self._assemble(ticket))\r\n\r\n    def view_by_id(self, ticket_id: int) -> TicketView:\r\n        return self.cache.get_or_load(f\"view:{ticket_id}\", lambda: self._assemble(self.tickets.by_id"]
[12.71138, "o", "(ticket_id)))\r\n\r\n    def _assemble(self, ticket: Ticket) -> TicketView:\r\n        return TicketView(ticket=ticket, customer=self.tenants.customer(ticket.customer_id), notes=self.tickets.notes_for(ticket.ticket_id))\r\n\r\n    def invalidate(self, ticket_id: int) -> None:\r\n        self.cache.invalidate(f\"view:{ticket_id}\")\r\n\r\n    def related(self, ticket: Ticket, limit: int = 5) -> list[dict[str, Any]]:\r\n        \"\"\"Possible duplicates: open tickets sharing the subject's key terms, with the context the\r\n        agent UI's 'related tickets' panel shows (customer, last internal note).\"\"\"\r\n        out = []\r\n        for other in self.tickets.search(subject_terms(ticket.subject), limit=limit, exclude_ticket_id=ticket.ticket_id):\r\n            view = self.view_by_id(other.ticket_id)\r\n            note = view.latest_internal_note\r\n            out.append({\r\n                \"tenant\": self.tenants.by_id(other.tenant_id).slug,\r\n                \"number\": other.number,\r\n                \"subject\": other.subject,\r\n                \"status\": other.status,\r\n                \"priority\": other.priority,\r\n                \"customer\": view.customer.name,\r\n                \"last_internal_note\": note.body if note else None,\r\n            })\r\n        return out\r\n\r\n\r\n# ------------------------------------------------------------------------------- SLA\r\ndef _parse(ts: str) -> datetime:\r\n    return datetime.fromisoformat(ts.replace(\"Z\", \"+00:00\"))\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass SlaStatus:\r\n    priority: str\r\n    target_hours: int\r\n    age_hours: float\r\n    breached: bool\r\n\r\n    def as_dict(self) -> dict[str, Any]:\r\n        return {\"priority\": self.priority, \"target_hours\": self.target_hours, \"age_hours\": round(self.age_hours, 2), \"breached\": self.breached}\r\n\r\n\r\ndef sla_status(ticket: Ticket, settings: Settings, now: datetime | None = None) -> SlaStatus:\r\n    now = now or datetime.now(timezone.utc)\r\n    target = settings.sla_hours.get(ticket.priority, 24)\r\n    if ticket.status in (\"resolved\", \"closed\"):\r\n        age = (_parse(ticket.updated_at) - _parse(ticket.created_at)).total_seconds() / 3600\r\n    else:\r\n        age = (now - _parse(ticket.created_at)).total_seconds() / 3600\r\n    return SlaStatus(ticket.priority, target, age, breached=age > target and ticket.status not in (\"resolved\", \"closed\"))\r\n\r\n\r\ndef sla_report(service: TicketService, tenant: Tenant, settings: Settings, now: datetime | None = None) -> list[dict[str, Any]]:\r\n    rows = []\r\n    for ticket in service.tickets.list_tickets(tenant.tenant_id):\r\n        if ticket.status in (\"resolved\", \"closed\"):\r\n            continue\r\n        view = service.view(tenant.tenant_id, ticket.number)\r\n        status = sla_status(view.ticket, settings, now)\r\n        rows.append({\"number\": view.ticket.number, \"priority\": view.ticket.priority, \"status\": view.ticket.status,\r\n                     \"customer\": view.customer.name, \"age_hours\": round(status.age_hours, 1), \"breached\": status.breached})\r\n    return rows\r\n\r\n\r\n# ------------------------------------------------------------------------------ escalation\r\n@dataclass(frozen=True)\r\nclass EscalationResult:\r\n    tenant: str\r\n    number: int\r\n    status: str\r\n    delivered: bool\r\n    delivery_id: str | None\r\n\r\n\r\nclass EscalationError(RuntimeError):\r\n    pass\r\n\r\n\r\ndef escalate(service: TicketService, relay: NotificationRelayClient, settings: Settings, tenant: Tenant, number: int, reason: str, actor: str = \"cli\") -> EscalationResult:\r\n    \"\"\"Escalate ticket ``number`` of ``tenant``: validate, mark it escalated, record an internal\r\n    note, and post a ``ticket.escalated`` event to the tenant's escalation hook.\r\n\r\n    Not implemented yet — see ticket DL-1187.\r\n    \"\"\"\r\n    raise NotImplementedError(\"escalation workflow is not implemented yet (DL-1187)\")\r\n\"\"\"Outbound notifications to each tenant's escalation channel via the notification relay.\r\n\r\nEvery tenant configures an escalation hook (``tenants.escalation_hook``, e.g.\r\n``/hooks/northwind/escalations``); the relay forwards whatever is posted there to the\r\ntenant's own channel (Slack / Teams / e-mail digest). Locally the relay is the stand-in in\r\n``services/notify_relay_service.py``.\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport json\r\nimport urllib.error\r\nimport urllib.request\r\nfrom dataclasses import dataclass\r\nfrom typing import Any\r\n\r\nfrom .tenant_store import Tenant\r\n\r\n\r\nclass RelayError(RuntimeError):\r\n    pass\r\n\r\n\r\n@dataclass\r\nclass RelayResponse:\r\n    status: int\r\n    body: dict[str, Any]\r\n\r\n\r\nclass NotificationRelayClient:\r\n    def __init__(self, base_url: str, timeout_sec: float = 10.0):\r\n        self.base_url = base_url.rstrip(\"/\")\r\n        self.timeout_sec = timeout_sec\r\n\r\n    def post(self, tenant: Tenant, event: dict[str, Any]) -> RelayResponse:\r\n        data = json.dumps(event, separators=(\",\", \":\")).encode(\"utf-8\")\r\n        req = urllib.request.Request(\r\n            self.base_url + tenant.escalation_hook, data=data, method=\"POST\",\r\n            headers={\"Content-Type\": \"application/json\", \"X-Deskline-Tenant\": tenant.slug, \"X-Deskline-Event\": str(event.get(\"event\", \"\"))},\r\n        )\r\n        try:\r\n            with urllib.request.urlopen(req, timeout=self.timeout_sec) as resp:\r\n                raw = resp.read().decode(\"utf-8\")\r\n                return RelayResponse(resp.status, json.loads(raw) if raw else {})\r\n        except urllib.error.HTTPError as e:\r\n            raise RelayError(f\"relay rejected the notification ({e.code}): {e.read().decode('utf-8', 'replace')}\") from e\r\n        except urllib.error.URLError as e:\r\n            raise RelayError(f\"relay unreachable at {self.base_url}: {e.reason}\") from e\r\n\r\n    def health(self) -> RelayResponse:\r\n        try:\r\n            with urllib.request.urlopen(self.base_url + \"/healthz\", timeout=self.timeout_sec) as resp:\r\n                return RelayResponse(resp.status, json.loads(resp.read().decode(\"utf-8\")))\r\n        except urllib.error.URLError as e:\r\n            raise RelayError(f\"relay unreachable at {self.base_url}: {e.reason}\") from e\r\n"]
[12.711502, "o", "\"\"\"Runtime settings with local-development defaults.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport os\r\nfrom dataclasses import dataclass\r\nfrom pathlib import Path\r\n\r\nPROJECT_ROOT = Path(__file__).resolve().parent.parent\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Settings:\r\n    db_path: Path\r\n    seed_dir: Path\r\n    relay_url: str\r\n    relay_timeout_sec: float\r\n    cache_size: int\r\n    sla_hours: dict[str, int]\r\n\r\n    @classmethod\r\n    def from_env(cls) -> \"Settings\":\r\n        data_dir = Path(os.environ.get(\"DESKLINE_DATA_DIR\", PROJECT_ROOT / \"data\"))\r\n        return cls(\r\n            db_path=Path(os.environ.get(\"DESKLINE_DB_PATH\", data_dir / \"deskline.db\")),\r\n            seed_dir=Path(os.environ.get(\"DESKLINE_SEED_DIR\", PROJECT_ROOT / \"data\" / \"seed\")),\r\n            relay_url=os.environ.get(\"NOTIFY_RELAY_URL\", \"http://127.0.0.1:8742\"),\r\n            relay_timeout_sec=float(os.environ.get(\"NOTIFY_RELAY_TIMEOUT\", \"10\")),\r\n            cache_size=int(os.environ.get(\"DESKLINE_CACHE_SIZE\", \"256\")),\r\n            sla_hours={\"urgent\": 4, \"high\": 8, \"normal\": 24, \"low\": 72},\r\n        )\r\n\r\n\r\ndef load_settings() -> Settings:\r\n    return Settings.from_env()\r\n"]
[12.711591, "o", "\u001b[?2004hroot@be17504a2265:/app# "]
[12.834239, "i", "cat deskline/cli.py deskline/ticket_store.py deskline/tenant_store.py deskline/cache.py\n"]
[12.8348, "o", "cat deskline/cli.py deskline/ticket_store.py deskline/tenant_store.py deskline/cache.py\r\n\u001b[?2004l\r"]
[12.836282, "o", "\"\"\"deskline command line: init-db | tenants | ticket show/search/list/note | sla-report | relay-health.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport argparse\r\nimport json\r\nimport sys\r\nfrom typing import Sequence\r\n\r\nfrom . import __version__\r\nfrom .cache import RecordCache\r\nfrom .config import load_settings\r\nfrom .escalation import TicketService, sla_report, sla_status\r\nfrom .notification import NotificationRelayClient, RelayError\r\nfrom .tenant_store import TenantError, TenantStore\r\nfrom .ticket_store import TicketError, TicketStore, open_connection\r\n\r\n\r\nclass Context:\r\n    def __init__(self, settings):\r\n        self.settings = settings\r\n        if not settings.db_path.exists():\r\n            print(f\"database not found at {settings.db_path}; run `init-db` first\", file=sys.stderr)\r\n            raise SystemExit(2)\r\n        self.conn = open_connection(settings.db_path)\r\n        self.tenants = TenantStore(self.conn)\r\n        self.tickets = TicketStore(self.conn)\r\n        self.service = TicketService(self.tickets, self.tenants, RecordCache(settings.cache_size))\r\n        self.relay = NotificationRelayClient(settings.relay_url, settings.relay_timeout_sec)\r\n\r\n\r\ndef cmd_init_db(args, settings) -> int:\r\n    conn = open_connection(settings.db_path)\r\n    tenants = TenantStore(conn)\r\n    tickets = TicketStore(conn)\r\n    if args.replace:\r\n        with conn:\r\n            for table in (\"ticket_notes\", \"tickets\", \"customers\", \"tenants\"):\r\n                conn.execute(f\"DELETE FROM {table}\")\r\n    t, c = tenants.load_seed(settings.seed_dir)\r\n    k, n = tickets.load_seed(settings.seed_dir)\r\n    print(f\"loaded {t} tenants, {c} customers, {k} tickets, {n} notes into {settings.db_path}\")\r\n    return 0\r\n\r\n\r\ndef cmd_tenants(args, settings) -> int:\r\n    ctx = Context(settings)\r\n    for t in ctx.tenants.list_tenants():\r\n        print(f\"{t.slug:<12} {t.plan:<10} {t.timezone:<16} {t.name}\")\r\n    return 0\r\n\r\n\r\ndef cmd_ticket_show(args, settings) -> int:\r\n    ctx = Context(settings)\r\n    try:\r\n        tenant = ctx.tenants.by_slug(args.tenant)\r\n        view = ctx.service.view(tenant.tenant_id, args.number)\r\n    except (TenantError, TicketError) as e:\r\n        print(str(e), file=sys.stderr)\r\n        return 1\r\n    out = view.as_dict()\r\n    out[\"sla\"] = sla_status(view.ticket, settings).as_dict()\r\n    out[\"related\"] = ctx.service.related(view.ticket)\r\n    print(json.dumps(out, indent=2))\r\n    return 0\r\n\r\n\r\n"]
[12.836444, "o", "def cmd_ticket_search(args, settings) -> int:\r\n    ctx = Context(settings)\r\n    for t in ctx.tickets.search(args.terms, limit=args.limit):\r\n        slug = ctx.tenants.by_id(t.tenant_id).slug\r\n        print(f\"{slug:<12} #{t.number}\\t{t.status:<9}\\t{t.priority:<7}\\t{t.subject}\")\r\n    return 0\r\n\r\n\r\ndef cmd_ticket_list(args, settings) -> int:\r\n    ctx = Context(settings)\r\n    try:\r\n        tenant = ctx.tenants.by_slug(args.tenant)\r\n    except TenantError as e:\r\n        print(str(e), file=sys.stderr)\r\n        return 1\r\n    for t in ctx.tickets.list_tickets(tenant.tenant_id, status=args.status):\r\n        print(f\"#{t.number}\\t{t.status:<9}\\t{t.priority:<7}\\t{t.subject}\")\r\n    return 0\r\n\r\n\r\ndef cmd_ticket_note(args, settings) -> int:\r\n    ctx = Context(settings)\r\n    try:\r\n        tenant = ctx.tenants.by_slug(args.tenant)\r\n        ticket = ctx.tickets.get_ticket(tenant.tenant_id, args.number)\r\n    except (TenantError, TicketError) as e:\r\n        print(str(e), file=sys.stderr)\r\n        return 1\r\n    note = ctx.tickets.add_note(ticket.ticket_id, args.author, \" \".join(args.text), \"public\" if args.public else \"internal\")\r\n    ctx.service.invalidate(ticket.ticket_id)\r\n    print(f\"added {note.visibility} note {note.note_id} to #{ticket.number}\")\r\n    return 0\r\n\r\n\r\ndef cmd_sla_report(args, settings) -> int:\r\n    ctx = Context(settings)\r\n    try:\r\n        tenant = ctx.tenants.by_slug(args.tenant)\r\n    except TenantError as e:\r\n        print(str(e), file=sys.stderr)\r\n        return 1\r\n    rows = sla_report(ctx.service, tenant, settings)\r\n    if args.json:\r\n        print(json.dumps(rows, indent=2))\r\n    else:\r\n        for r in rows:\r\n            flag = \"BREACH\" if r[\"breached\"] else \"\"\r\n            print(f\"#{r['number']}\\t{r['priority']:<7}\\t{r['status']:<9}\\t{r['age_hours']:>7.1f}h\\t{flag}\\t{r['customer']}\")\r\n    return 0\r\n\r\n\r\ndef cmd_relay_health(args, settings) -> int:\r\n    ctx = Context(settings)\r\n    try:\r\n        resp = ctx.relay.health()\r\n    except RelayError as e:\r\n        print(str(e), file=sys.stderr)\r\n        return 1\r\n    print(json.dumps(resp.body))\r\n    return 0\r\n\r\n\r\ndef build_parser() -> argparse.ArgumentParser:\r\n    p = argparse.ArgumentParser(prog=\"deskline\", description=\"deskline support desk CLI\")\r\n    p.add_argument(\"--version\", action=\"version\", version=f\"deskline {__version__}\")\r\n    sub = p.add_subparsers(dest=\"command\", required=True)\r\n\r\n    s = sub.add_parser(\"init-db\", help=\"create the SQLite database from the seed files\")\r\n    s.add_argument(\"--replace\", action=\"store_true\")\r\n    s.set_defaults(func=cmd_init_db)\r\n\r\n    sub.add_parser(\"tenants\", help=\"list tenants\").set_defaults(func=cmd_tenants)\r\n\r\n    t = sub.add_parser(\"ticket\", help=\"ticket operations\")\r\n    tsub = t.add_subparsers(dest=\"ticket_command\", required=True)\r\n    show = tsub.add_parser(\"show\"); show.add_argument(\"number\", type=int); show.add_argument(\"--tenant\", required=True); show.set_defaults(func=cmd_ticket_show)\r\n    search = tsub.add_parser(\"search\"); search.add_argument(\"terms\", nargs=\"+\"); search.add_argument(\"--limit\", type=int, default=10); search.set_defaults(func=cmd_ticket_search)\r\n    lst = tsub.add_parser(\"list\"); lst.add_argument(\"--tenant\", required=True); lst.add_argument(\"--status\"); lst.set_defaults(func=cmd_ticket_list)\r\n    note = tsub.add_parser(\"note\"); note.add_argument(\"number\", type=int); note.add_argument(\"--tenant\", required=True)\r\n    note.add_argument(\"--author\", required=True); note.add_argument(\"--public\", action=\"store_true\"); note.add_argument(\"text\", nargs=\"+\")"]
[12.836533, "o", "\r\n    note.set_defaults(func=cmd_ticket_note)\r\n\r\n    r = sub.add_parser(\"sla-report\", help=\"open tickets against their SLA target\")\r\n    r.add_argument(\"--tenant\", required=True); r.add_argument(\"--json\", action=\"store_true\"); r.set_defaults(func=cmd_sla_report)\r\n\r\n    sub.add_parser(\"relay-health\", help=\"check the notification relay\").set_defaults(func=cmd_relay_health)\r\n    return p\r\n\r\n\r\ndef main(argv: Sequence[str] | None = None) -> int:\r\n    args = build_parser().parse_args(argv)\r\n    return args.func(args, load_settings())\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main())\r\n"]
[12.845841, "o", "\"\"\"Tickets and notes. Ticket numbers are a per-tenant sequence (#1042); ``ticket_id`` is the primary key\r\nand (tenant_id, number) is unique.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport json\r\nimport sqlite3\r\nfrom dataclasses import dataclass\r\nfrom datetime import datetime, timezone\r\nfrom pathlib import Path\r\n\r\nSCHEMA = \"\"\"\r\nCREATE TABLE IF NOT EXISTS tickets (\r\n    ticket_id    INTEGER PRIMARY KEY AUTOINCREMENT,\r\n    tenant_id    TEXT NOT NULL REFERENCES tenants(tenant_id),\r\n    number       INTEGER NOT NULL,\r\n    subject      TEXT NOT NULL,\r\n    status       TEXT NOT NULL CHECK (status IN ('open','pending','escalated','resolved','closed')),\r\n    priority     TEXT NOT NULL CHECK (priority IN ('low','normal','high','urgent')),\r\n    customer_id  TEXT NOT NULL REFERENCES customers(customer_id),\r\n    assignee     TEXT,\r\n    created_at   TEXT NOT NULL,\r\n    updated_at   TEXT NOT NULL,\r\n    UNIQUE (tenant_id, number)\r\n);\r\nCREATE TABLE IF NOT EXISTS ticket_notes (\r\n    note_id      INTEGER PRIMARY KEY AUTOINCREMENT,\r\n    ticket_id    INTEGER NOT NULL REFERENCES tickets(ticket_id),\r\n    author       TEXT NOT NULL,\r\n    visibility   TEXT NOT NULL CHECK (visibility IN ('public','internal')),\r\n    body         TEXT NOT NULL,\r\n    created_at   TEXT NOT NULL\r\n);\r\nCREATE INDEX IF NOT EXISTS idx_notes_ticket ON ticket_notes(ticket_id, created_at);\r\n\"\"\"\r\n\r\n\r\ndef utcnow() -> str:\r\n    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace(\"+00:00\", \"Z\")\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Ticket:\r\n    ticket_id: int\r\n    tenant_id: str\r\n    number: int\r\n    subject: str\r\n    status: str\r\n    priority: str\r\n    customer_id: str\r\n    assignee: str | None\r\n    created_at: str\r\n    updated_at: str\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Note:\r\n    note_id: int\r\n    ticket_id: int\r\n    author: str\r\n    visibility: str\r\n    body: str\r\n    created_at: str\r\n\r\n\r\nclass TicketError(LookupError):\r\n    pass\r\n\r\n\r\nclass TicketStore:\r\n    def __init__(self, conn: sqlite3.Connection):\r\n        self._conn = conn\r\n        self._conn.executescript(SCHEMA)\r\n\r\n    # ----------------------------------------------------------------- seeding\r\n    def load_seed(self, seed_dir: Path) -> tuple[int, int]:\r\n        tickets = json.loads((seed_dir / \"tickets.json\").read_text())\r\n        notes = json.loads((seed_dir / \"notes.json\").read_text())\r\n        with self._conn:\r\n            self._conn.executemany(\r\n                \"INSERT OR REPLACE INTO tickets VALUES (:ticket_id,:tenant_id,:number,:subject,:status,:priority,\"\r\n                \":customer_id,:assignee,:created_at,:updated_at)\", tickets)\r\n            self._conn.executemany(\r\n                \"INSERT OR REPLACE INTO ticket_notes VALUES (:note_id,:ticket_id,:author,:visibility,:body,:created_at)\", notes)\r\n        return len(tickets), len(notes)\r\n\r\n    # ----------------------------------------------------------------- lookups\r\n    def get_ticket(self, tenant_id: str, number: int) -> Ticket:\r\n        row = self._conn.execute(\"SELECT * FROM tickets WHERE tenant_id = ? AND number = ?\", (tenant_id, number)).fetchone()\r\n        if row is None:\r\n            raise TicketError(f\"ticket #{number} not found for tenant {tenant_id!r}\")\r\n        return Ticket(**dict(row))\r\n\r\n    def by_id(self, ticket_id: int) -> Ticket:\r\n        row = self._conn.execute(\"SELECT * FROM tickets WHERE ticket_id = ?\", (ticket_id,)).fetchone()\r\n        if row is None:\r\n            raise TicketError(f\"ticket id {ticket_id} not found\")\r\n        return Ticket(**dict(row))\r\n\r\n    def search(self, terms: list[str], limit: int = 10, exclude_ticket_id: int | None = None) -> list[Ticket]:\r\n        \"\"\"Desk-wide keyword search on subjects (used by `ticket search` and the related-ticket panel):\r\n        open/pending/escalated tickets whose subject contains every term, most recent first.\"\"\"\r\n        terms = [t.strip().lower() for t in terms if t.strip()]\r\n        if not terms:\r\n            return []\r\n        sql = \"SELECT * FROM tickets WHERE status IN ('open','pending','escalated')\"\r\n        params: list = []\r\n        for term in terms:"]
[12.845969, "o", "\r\n            sql += \" AND lower(subject) LIKE ?\"\r\n            params.append(f\"%{term}%\")\r\n        if exclude_ticket_id is not None:\r\n            sql += \" AND ticket_id != ?\"\r\n            params.append(exclude_ticket_id)\r\n        sql += \" ORDER BY created_at DESC, ticket_id DESC LIMIT ?\"\r\n        params.append(limit)\r\n        return [Ticket(**dict(r)) for r in self._conn.execute(sql, params)]\r\n\r\n    def list_tickets(self, tenant_id: str, status: str | None = None) -> list[Ticket]:\r\n        sql, params = \"SELECT * FROM tickets WHERE tenant_id = ?\", [tenant_id]\r\n        if status:\r\n            sql += \" AND status = ?\"\r\n            params.append(status)\r\n        return [Ticket(**dict(r)) for r in self._conn.execute(sql + \" ORDER BY number\", params)]\r\n\r\n    def notes_for(self, ticket_id: int, include_internal: bool = True) -> list[Note]:\r\n        sql = \"SELECT * FROM ticket_notes WHERE ticket_id = ?\"\r\n        if not include_internal:\r\n            sql += \" AND visibility = 'public'\"\r\n        return [Note(**dict(r)) for r in self._conn.execute(sql + \" ORDER BY created_at, note_id\", (ticket_id,))]\r\n\r\n    # ----------------------------------------------------------------- mutations\r\n    def add_note(self, ticket_id: int, author: str, body: str, visibility: str = \"internal\") -> Note:\r\n        if visibility not in (\"public\", \"internal\"):\r\n            raise ValueError(\"visibility must be 'public' or 'internal'\")\r\n        now = utcnow()\r\n        with self._conn:\r\n            cur = self._conn.execute(\r\n                \"INSERT INTO ticket_notes (ticket_id, author, visibility, body, created_at) VALUES (?,?,?,?,?)\",\r\n                (ticket_id, author, visibility, body, now))\r\n            self._conn.execute(\"UPDATE tickets SET updated_at = ? WHERE ticket_id = ?\", (now, ticket_id))\r\n        return Note(cur.lastrowid, ticket_id, author, visibility, body, now)\r\n\r\n    def update_status(self, ticket_id: int, status: str) -> Ticket:\r\n        now = utcnow()\r\n        with self._conn:\r\n            cur = self._conn.execute(\"UPDATE tickets SET status = ?, updated_at = ? WHERE ticket_id = ?\", (status, now, ticket_id))\r\n            if cur.rowcount != 1:\r\n                raise TicketError(f\"ticket id {ticket_id} not found\")\r\n        row = self._conn.execute(\"SELECT * FROM tickets WHERE ticket_id = ?\", (ticket_id,)).fetchone()\r\n        return Ticket(**dict(row))\r\n\r\n    def next_number(self, tenant_id: str) -> int:\r\n        row = self._conn.execute(\"SELECT COALESCE(MAX(number), 1000) + 1 FROM tickets WHERE tenant_id = ?\", (tenant_id,)).fetchone()\r\n        return int(row[0])\r\n\r\n    def create_ticket(self, tenant_id: str, subject: str, priority: str, customer_id: str, assignee: str | None = None) -> Ticket:\r\n        now = utcnow()\r\n        number = self.next_number(tenant_id)\r\n        with self._conn:\r\n            cur = self._conn.execute(\r\n                \"INSERT INTO tickets (tenant_id, number, subject, status, priority, customer_id, assignee, created_at, updated_at)\"\r\n                \" VALUES (?,?,?,?,?,?,?,?,?)\", (tenant_id, number, subject, \"open\", priority, customer_id, assignee, now, now))\r\n        return self.by_id(cur.lastrowid)\r\n\r\n\r\ndef open_connection(db_path: Path) -> sqlite3.Connection:\r\n    db_path.parent.mkdir(parents=True, exist_ok=True)\r\n    conn = sqlite3.connect(str(db_path))\r\n    conn.row_factory = sqlite3.Row\r\n    conn.execute(\"PRAGMA foreign_keys = ON\")\r\n    return conn\r\n\"\"\"Tenants (customer organisations using the desk) and their end-customers.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport json\r\nimport sqlite3\r\nfrom dataclasses import dataclass\r\nfrom pathlib import Path\r\n\r\nSCHEMA = \"\"\"\r\nCREATE TABLE IF NOT EXISTS tenants (\r\n    tenant_id     TEXT PRIMARY KEY,\r\n"]
[12.846038, "o", "    slug          TEXT NOT NULL UNIQUE,\r\n    name          TEXT NOT NULL,\r\n    plan          TEXT NOT NULL,\r\n    timezone      TEXT NOT NULL,\r\n    escalation_hook TEXT NOT NULL,\r\n    created_at    TEXT NOT NULL\r\n);\r\nCREATE TABLE IF NOT EXISTS customers (\r\n    customer_id   TEXT PRIMARY KEY,\r\n    tenant_id     TEXT NOT NULL REFERENCES tenants(tenant_id),\r\n    name          TEXT NOT NULL,\r\n    email         TEXT NOT NULL,\r\n    account_ref   TEXT NOT NULL,\r\n    created_at    TEXT NOT NULL\r\n);\r\nCREATE INDEX IF NOT EXISTS idx_customers_tenant ON customers(tenant_id);\r\n\"\"\"\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Tenant:\r\n    tenant_id: str\r\n    slug: str\r\n    name: str\r\n    plan: str\r\n    timezone: str\r\n    escalation_hook: str\r\n    created_at: str\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Customer:\r\n    customer_id: str\r\n    tenant_id: str\r\n    name: str\r\n    email: str\r\n    account_ref: str\r\n    created_at: str\r\n\r\n\r\nclass TenantError(LookupError):\r\n    pass\r\n\r\n\r\nclass TenantStore:\r\n    def __init__(self, conn: sqlite3.Connection):\r\n        self._conn = conn\r\n        self._conn.executescript(SCHEMA)\r\n\r\n    def load_seed(self, seed_dir: Path) -> tuple[int, int]:\r\n        tenants = json.loads((seed_dir / \"tenants.json\").read_text())\r\n        customers = json.loads((seed_dir / \"customers.json\").read_text())\r\n        with self._conn:\r\n            self._conn.executemany(\r\n                \"INSERT OR REPLACE INTO tenants VALUES (:tenant_id,:slug,:name,:plan,:timezone,:escalation_hook,:created_at)\", tenants)\r\n            self._conn.executemany(\r\n                \"INSERT OR REPLACE INTO customers VALUES (:customer_id,:tenant_id,:name,:email,:account_ref,:created_at)\", customers)\r\n        return len(tenants), len(customers)\r\n\r\n    def by_slug(self, slug: str) -> Tenant:\r\n        row = self._conn.execute(\"SELECT * FROM tenants WHERE slug = ?\", (slug,)).fetchone()\r\n        if row is None:\r\n            raise TenantError(f\"unknown tenant {slug!r}\")\r\n        return Tenant(**dict(row))\r\n\r\n    def by_id(self, tenant_id: str) -> Tenant:\r\n        row = self._conn.execute(\"SELECT * FROM tenants WHERE tenant_id = ?\", (tenant_id,)).fetchone()\r\n        if row is None:\r\n            raise TenantError(f\"unknown tenant id {tenant_id!r}\")\r\n        return Tenant(**dict(row))\r\n\r\n    def list_tenants(self) -> list[Tenant]:\r\n        return [Tenant(**dict(r)) for r in self._conn.execute(\"SELECT * FROM tenants ORDER BY slug\")]\r\n\r\n    def customer(self, customer_id: str) -> Customer:\r\n        row = self._conn.execute(\"SELECT * FROM customers WHERE customer_id = ?\", (customer_id,)).fetchone()\r\n        if row is None:\r\n            raise TenantError(f\"unknown customer {customer_id!r}\")\r\n        return Customer(**dict(row))\r\n\"\"\"Small in-process LRU cache for hot records (ticket views, tenant rows).\"\"\"\r\nfrom __future__ import annotations\r\n\r\nfrom collections import OrderedDict\r\nfrom typing import Any, Callable, Generic, Hashable, TypeVar\r\n\r\nT = TypeVar(\"T\")\r\n\r\n\r\nclass RecordCache(Generic[T]):\r\n    def __init__(self, max_entries: int = 256):\r\n        self.max_entries = max(1, max_entries)\r\n        self._entries: \"OrderedDict[Hashable, T]\" = OrderedDict()\r\n        self.hits = 0\r\n        self.misses = 0\r\n\r\n    def get(self, key: Hashable) -> T | None:\r\n        if key in self._entries:\r\n"]
[12.846086, "o", "            self._entries.move_to_end(key)\r\n            self.hits += 1\r\n            return self._entries[key]\r\n        self.misses += 1\r\n        return None\r\n\r\n    def put(self, key: Hashable, value: T) -> T:\r\n        self._entries[key] = value\r\n        self._entries.move_to_end(key)\r\n        while len(self._entries) > self.max_entries:\r\n            self._entries.popitem(last=False)\r\n        return value\r\n\r\n    def get_or_load(self, key: Hashable, loader: Callable[[], T]) -> T:\r\n        cached = self.get(key)\r\n        if cached is not None:\r\n            return cached\r\n        return self.put(key, loader())\r\n\r\n    def invalidate(self, key: Hashable) -> None:\r\n        self._entries.pop(key, None)\r\n\r\n    def clear(self) -> None:\r\n        self._entries.clear()\r\n\r\n    def __len__(self) -> int:\r\n        return len(self._entries)\r\n\r\n    def stats(self) -> dict[str, Any]:\r\n        return {\"entries\": len(self._entries), \"hits\": self.hits, \"misses\": self.misses}\r\n"]
