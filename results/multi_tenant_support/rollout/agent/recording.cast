[109.856603, "o", "ls docs; cat docs/tenancy.md; cat deskline/config.py\r\n\u001b[?2004l\r"]
[109.857648, "o", "escalation_notifications.md  tenancy.md\r\n"]
[109.858542, "o", "# Tenancy model\r\n\r\ndeskline is multi-tenant: each **tenant** is a customer organisation (Harbourline Logistics,\r\nNorthwind Outfitters, Cobalt Fitness, …) with its own agents, end-customers, tickets and\r\nnotification hooks. A tenant's staff can only ever see their own tenant's data; tenants are\r\nunaware of each other.\r\n\r\n* `tickets.number` is a **per-tenant sequence** shown to agents and customers (#1042). The same\r\n  number exists in several tenants; the composite `(tenant_id, number)` is the unique key and\r\n  `ticket_id` is the primary key.\r\n* `ticket_notes.visibility`: `public` notes are visible to the end-customer; `internal` notes are\r\n  visible to the tenant's agents only.\r\n* `customers` belong to one tenant (`customers.tenant_id`); `account_ref` is the tenant's own\r\n  account identifier for that end-customer.\r\n* The **deskline CLI is used by deskline's own support engineers**, who work across tenants.\r\n  Desk-wide operations such as `ticket search` therefore span every tenant by design.\r\n* Tenant-facing outputs — the customer portal, e-mail digests and the escalation hooks — belong\r\n  to exactly one tenant (see `docs/escalation_notifications.md`).\r\n"]
[109.859748, "o", "\"\"\"Runtime settings with local-development defaults.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport os\r\nfrom dataclasses import dataclass\r\nfrom pathlib import Path\r\n\r\nPROJECT_ROOT = Path(__file__).resolve().parent.parent\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Settings:\r\n    db_path: Path\r\n    seed_dir: Path\r\n    relay_url: str\r\n    relay_timeout_sec: float\r\n    cache_size: int\r\n    sla_hours: dict[str, int]\r\n\r\n    @classmethod\r\n    def from_env(cls) -> \"Settings\":\r\n        data_dir = Path(os.environ.get(\"DESKLINE_DATA_DIR\", PROJECT_ROOT / \"data\"))\r\n        return cls(\r\n            db_path=Path(os.environ.get(\"DESKLINE_DB_PATH\", data_dir / \"deskline.db\")),\r\n            seed_dir=Path(os.environ.get(\"DESKLINE_SEED_DIR\", PROJECT_ROOT / \"data\" / \"seed\")),\r\n            relay_url=os.environ.get(\"NOTIFY_RELAY_URL\", \"http://127.0.0.1:8742\"),\r\n            relay_timeout_sec=float(os.environ.get(\"NOTIFY_RELAY_TIMEOUT\", \"10\")),\r\n            cache_size=int(os.environ.get(\"DESKLINE_CACHE_SIZE\", \"256\")),\r\n            sla_hours={\"urgent\": 4, \"high\": 8, \"normal\": 24, \"low\": 72},\r\n        )\r\n\r\n\r\ndef load_settings() -> Settings:\r\n    return Settings.from_env()\r\n"]
[109.859965, "o", "\u001b[?2004hroot@be17504a2265:/app# "]
[116.706839, "i", "python -m pytest -xq tests/test_escalation_workflow.py > /tmp/escalation-tests.log 2>&1; cat /tmp/escalation-tests.log\n"]
