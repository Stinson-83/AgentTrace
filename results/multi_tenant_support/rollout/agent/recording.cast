[102.698916, "o", "=========================================================================== FAILURES ===========================================================================\r\n\u001b[31m\u001b[1m___________________________________________________________ test_escalate_event_and_persisted_update ___________________________________________________________\u001b[0m\r\n\r\ndb = (<sqlite3.Connection object at 0x7dd0e8ff27a0>, <deskline.tenant_store.TenantStore object at 0x7dd0e9cbbf20>, <deskline.ticket_store.TicketStore object at 0x7dd0e9cbb680>)\r\nservice = <deskline.escalation.TicketService object at 0x7dd0e9afe180>"]
[102.698999, "o", "\r\nsettings = Settings(db_path=PosixPath('/tmp/pytest-of-root/pytest-2/test_escalate_event_and_persis0/t.db'), seed_dir=PosixPath('/...='http://127.0.0.1:1', relay_timeout_sec=1, cache_size=64, sla_hours={'urgent': 4, 'high': 8, 'normal': 24, 'low': 72})\r\nrelay = <Mock id='138336229314144'>\r\n\r\n"]
[102.726597, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_escalate_event_and_persisted_update\u001b[39;49;00m(db, service, settings, relay):\u001b[90m\u001b[39;49;00m\r\n        _, tenants, tickets = db\u001b[90m\u001b[39;49;00m\r\n        tenant = tenants.by_slug(\u001b[33m\"\u001b[39;49;00m\u001b[33mnorthwind\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n        before = service.view(tenant.tenant_id, \u001b[94m1042\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# A previously cached view must not hide new context.\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n"]
[102.72674, "o", "        context = tickets.add_note(before.ticket.ticket_id, \u001b[33m\"\u001b[39;49;00m\u001b[33magent\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33mLatest investigation: café checkout\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n        tickets.add_note(before.ticket.ticket_id, \u001b[33m\"\u001b[39;49;00m\u001b[33mcustomer\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33mA newer public note\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33mpublic\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n        other_tenant = tickets.get_ticket(\u001b[33m\"\u001b[39;49;00m\u001b[33mten_hl\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[94m1042\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n        other_notes = tickets.notes_for(other_tenant.ticket_id)\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mdeliver\u001b[39;49;00m(destination, event):\u001b[90m\u001b[39;49;00m\r\n            \u001b[90m# The write must have committed before making an external request.\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n            conn = open_connection(settings.db_path)\u001b[90m\u001b[39;49;00m\r\n            \u001b[94mtry\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n                persisted = TicketStore(conn)\u001b[90m\u001b[39;49;00m\r\n                \u001b[94massert\u001b[39;49;00m persisted.get_ticket(tenant.tenant_id, \u001b[94m1042\u001b[39;49;00m).status == \u001b[33m\"\u001b[39;49;00m\u001b[33mescalated\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n                note = persisted.notes_for(before.ticket.ticket_id)[-\u001b[94m1\u001b[39;49;00m]\u001b[90m\u001b[39;49;00m\r\n                \u001b[94massert\u001b[39;49;00m note.visibility == \u001b[33m\"\u001b[39;49;00m\u001b[33minternal\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m \u001b[95mand\u001b[39;49;00m note.author == \u001b[33m\"\u001b[39;49;00m\u001b[33moncall.agent\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n                \u001b[94massert\u001b[39;49;00m \u001b[33m\"\u001b[39;49;00m\u001b[33moncall.agent\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m \u001b[95min\u001b[39;49;00m note.body \u001b[95mand\u001b[39;49;00m \u001b[33m\"\u001b[39;49;00m\u001b[33mSLA breached, customer chasing\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m \u001b[95min\u001b[39;49;00m note.body\u001b[90m\u001b[39;49;00m\r\n            \u001b[94mfinally\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n                conn.close()\u001b[90m\u001b[39;49;00m\r\n            \u001b[94mreturn\u001b[39;49;00m RelayResponse(\u001b[94m202\u001b[39;49;00m, {\u001b[33m\"\u001b[39;49;00m\u001b[33mdelivery_id\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: \u001b[33m\"\u001b[39;49;00m\u001b[33mdl_test\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m})\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        relay.post.side_effect = deliver\u001b[90m\u001b[39;49;00m\r\n        result = escalate(service, relay, settings, tenant, \u001b[94m1042\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n                          \u001b[33m\"\u001b[39;49;00m\u001b[33mSLA breached, customer chasing\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, actor=\u001b[33m\"\u001b[39;49;00m\u001b[33moncall.agent\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n        \u001b[94massert\u001b[39;49;00m (result.tenant, result.number, result.status) == (\u001b[33m\"\u001b[39;49;00m\u001b[33mnorthwind\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[94m1042\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33mescalated\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n        \u001b[94massert\u001b[39;49;00m result.delivered \u001b[95mand\u001b[39;49;00m result.delivery_id == \u001b[33m\"\u001b[39;49;00m\u001b[33mdl_test\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m \u001b[95mand\u001b[39;49;00m result.error \u001b[95mis\u001b[39;49;00m \u001b[94mNone\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        relay.post.assert_called_once()\u001b[90m\u001b[39;49;00m"]
[102.726848, "o", "\r\n        destination, event = relay.post.call_args.args\u001b[90m\u001b[39;49;00m\r\n        \u001b[94massert\u001b[39;49;00m destination == tenant\u001b[90m\u001b[39;49;00m\r\n        \u001b[94massert\u001b[39;49;00m event[\u001b[33m\"\u001b[39;49;00m\u001b[33mevent\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m] == \u001b[33m\"\u001b[39;49;00m\u001b[33mticket.escalated\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m \u001b[95mand\u001b[39;49;00m event[\u001b[33m\"\u001b[39;49;00m\u001b[33mtenant\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m] == tenant.slug\u001b[90m\u001b[39;49;00m\r\n        \u001b[94massert\u001b[39;49;00m event[\u001b[33m\"\u001b[39;49;00m\u001b[33mactor\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m] == \u001b[33m\"\u001b[39;49;00m\u001b[33moncall.agent\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        occurred = datetime.fromisoformat(event[\u001b[33m\"\u001b[39;49;00m\u001b[33moccurred_at\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m].replace(\u001b[33m\"\u001b[39;49;00m\u001b[33mZ\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33m+00:00\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m))\u001b[90m\u001b[39;49;00m\r\n        \u001b[94massert\u001b[39;49;00m occurred.utcoffset().total_seconds() == \u001b[94m0\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        \u001b[94massert\u001b[39;49;00m event[\u001b[33m\"\u001b[39;49;00m\u001b[33mticket\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m] == {\u001b[90m\u001b[39;49;00m\r\n            \u001b[33m\"\u001b[39;49;00m\u001b[33mnumber\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: \u001b[94m1042\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33msubject\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: before.ticket.subject, \u001b[33m\"\u001b[39;49;00m\u001b[33mstatus\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: \u001b[33m\"\u001b[39;49;00m\u001b[33mescalated\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n            \u001b[33m\"\u001b[39;49;00m\u001b[33mpriority\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: \u001b[33m\"\u001b[39;49;00m\u001b[33mhigh\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33mcustomer\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: before.customer.name,\u001b[90m\u001b[39;49;00m\r\n        }\u001b[90m\u001b[39;49;00m\r\n        escalation = event[\u001b[33m\"\u001b[39;49;00m\u001b[33mescalation\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m]\u001b[90m\u001b[39;49;00m\r\n        \u001b[94massert\u001b[39;49;00m escalation[\u001b[33m\"\u001b[39;49;00m\u001b[33mreason\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m] == \u001b[33m\"\u001b[39;49;00m\u001b[33mSLA breached, customer chasing\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        \u001b[94massert\u001b[39;49;00m escalation[\u001b[33m\"\u001b[39;49;00m\u001b[33mlatest_internal_note\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m] == context.body\u001b[90m\u001b[39;49;00m\r\n        \u001b[94massert\u001b[39;49;00m escalation[\u001b[33m\"\u001b[39;49;00m\u001b[33msla\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m] == sla_status(before.ticket, settings, occurred).as_dict()\u001b[90m\u001b[39;49;00m\r\n        \u001b[94massert\u001b[39;49;00m escalation[\u001b[33m\"\u001b[39;49;00m\u001b[33msla\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m][\u001b[33m\"\u001b[39;49;00m\u001b[33mbreached\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m]\u001b[90m\u001b[39;49;00m\r\n        related = escalation[\u001b[33m\"\u001b[39;49;00m\u001b[33mrelated\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m]\u001b[90m\u001b[39;49;00m\r\n        \u001b[94massert\u001b[39;49;00m related \u001b[95mand\u001b[39;49;00m \u001b[96mall\u001b[39;49;00m(r[\u001b[33m\"\u001b[39;49;00m\u001b[33mtenant\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m] == \u001b[33m\"\u001b[39;49;00m\u001b[33mnorthwind\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m \u001b[94mfor\u001b[39;49;00m r \u001b[95min\u001b[39;49;00m related)\u001b[90m\u001b[39;49;00m\r\n        duplicate = \u001b[96mnext\u001b[39;49;00m(r \u001b[94mfor\u001b[39;49;00m r \u001b[95min\u001b[39;49;00m related \u001b[94mif\u001b[39;49;00m r[\u001b[33m\"\u001b[39;49;00m\u001b[33mnumber\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m] == \u001b[94m1018\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n        duplicate_view = service.view(tenant.tenant_id, \u001b[94m1018\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n"]
[102.726977, "o", "        \u001b[94massert\u001b[39;49;00m duplicate[\u001b[33m\"\u001b[39;49;00m\u001b[33mcustomer\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m] == duplicate_view.customer.name\u001b[90m\u001b[39;49;00m\r\n>       \u001b[94massert\u001b[39;49;00m duplicate[\u001b[33m\"\u001b[39;49;00m\u001b[33mlast_internal_note\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m] == duplicate_view.latest_internal_note.body\u001b[90m\u001b[39;49;00m\r\n                                                  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31mE       AttributeError: 'NoneType' object has no attribute 'body'\u001b[0m\r\n\r\n\u001b[1m\u001b[31mtests/test_escalation_workflow.py\u001b[0m:65: AttributeError\r\n"]
[102.727109, "o", "\u001b[36m\u001b[1m=================================================================== short test summary info ====================================================================\u001b[0m\r\n\u001b[31mFAILED\u001b[0m tests/test_escalation_workflow.py::\u001b[1mtest_escalate_event_and_persisted_update\u001b[0m - AttributeError: 'NoneType' object has no attribute 'body'\r\n"]
