[68.841754, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('deskline/ticket_store.py')\ns = p.read_text().replace('def search(self, terms: list[str], limit: int = 10, exclude_ticket_id: int | None = None)', 'def search(self, terms: list[str], limit: int = 10, exclude_ticket_id: int | None = None, tenant_id: str | None = None)')\ns = s.replace('Desk-wide keyword search on subjects (used by `ticket search` and the related-ticket panel):\\n        open/pending/escalated tickets whose subject contains every term, most recent first.', 'Keyword search on subjects, optionally scoped to a tenant:\\n        open/pending/escalated tickets whose subject contains every term, most recent first.')\ns = s.replace('        params: list = []\\n        for term in terms:', '        params: list = []\\n        if tenant_id is not None:\\n            sql += \" AND tenant_id = ?\"\\n            params.append(tenant_id)\\n        for term in terms:')\np.write_text(s)\np = Path('deskline/escalation.py')\ns = p.read_text().replace('from .notification import NotificationRelayClient', 'from .notification import NotificationRelayClient, RelayError').replace('from .ticket_store import Note, Ticket, TicketStore', 'from .ticket_store import Note, Ticket, TicketError, TicketStore')\ns = s.replace('\"\"\"Possible duplicates: open tickets sharing the subject\\'s key terms, with the context the', '\"\"\"Possible duplicates within the tenant: open tickets sharing key terms, with the context the')\ns = s.replace('self.tickets.search(subject_terms(ticket.subject), limit=limit, exclude_ticket_id=ticket.ticket_id)', 'self.tickets.search(subject_terms(ticket.subject), limit=limit,\\n                                         exclude_ticket_id=ticket.ticket_id, tenant_id=ticket.tenant_id)')\ns = s.replace('    delivery_id: str | None\\n', '    delivery_id: str | None\\n    error: str | None = None\\n')\nstart = s.index('    \"\"\"Escalate ticket ``number``')\ns = s[:start] + '''    \"\"\"Persist an escalation, then notify the tenant's on-call.\n\n    Delivery is best-effort: a relay failure is returned in ``error`` and never\n    rolls back the ticket update. Context is captured before adding our audit note.\n    \"\"\"\n    try:\n        ticket = service.tickets.get_ticket(tenant.tenant_id, number)\n    except TicketError as e:\n        raise EscalationError(str(e)) from e\n    if ticket.tenant_id != tenant.tenant_id:\n        raise EscalationError(f\"ticket #{number} does not belong to tenant {tenant.slug!r}\")\n    if ticket.status in (\"resolved\", \"closed\"):\n        raise EscalationError(f\"ticket #{number} is {ticket.status} and cannot be escalated\")\n\n    # Cached views may predate recent notes or status changes.\n    service.invalidate(ticket.ticket_id)\n    view = service.view(tenant.tenant_id, number)\n    latest_note = view.latest_internal_note\n    now = datetime.now(timezone.utc)\n    event = {\n        \"event\": \"ticket.escalated\",\n        \"tenant\": tenant.slug,\n        \"occurred_at\": now.isoformat().replace(\"+00:00\", \"Z\"),\n        \"actor\": actor,\n        \"ticket\": {\n            \"number\": ticket.number,\n            \"subject\": ticket.subject,\n            \"status\": \"escalated\",\n            \"priority\": ticket.priority,\n            \"customer\": view.customer.name,\n        },\n        \"escalation\": {\n            \"reason\": reason,\n            \"sla\": sla_status(ticket, settings, now).as_dict(),\n            \"latest_internal_note\": latest_note.body if latest_note else None,\n            \"related\": service.related(ticket),\n        },\n    }\n    try:\n        updated = service.tickets.update_status(ticket.ticket_id, \"escalated\")\n        service.tickets.add_note(ticket.ticket_id, actor, f\"Escalated by {actor}: {reason}\", \"internal\")\n    finally:\n        service.invalidate(ticket.ticket_id)\n\n    try:\n        response = relay.post(tenant, event)\n        if response.status != 202:\n            raise RelayError(f\"relay rejected the notification ({response.status}): {response.body}\")\n        delivery_id = response.body.get(\"delivery_id\")\n        if not isinstance(delivery_id, str) or not delivery_id:\n            raise RelayError(\"relay respon"]
[68.841789, "i", "se did not include a delivery_id\")\n    except RelayError as e:\n        return EscalationResult(tenant.slug, number, updated.status, False, None, str(e))\n    return EscalationResult(tenant.slug, number, updated.status, True, delivery_id)\n'''\np.write_text(s)\np = Path('deskline/notification.py')\ns = p.read_text().replace('        except urllib.error.URLError as e:\\n            raise RelayError(f\"relay unreachable at {self.base_url}: {e.reason}\") from e\\n\\n    def health', '        except urllib.error.URLError as e:\\n            raise RelayError(f\"relay unreachable at {self.base_url}: {e.reason}\") from e\\n        except OSError as e:\\n            raise RelayError(f\"relay unreachable at {self.base_url}: {e}\") from e\\n        except ValueError as e:\\n            raise RelayError(f\"invalid relay response: {e}\") from e\\n\\n    def health')\np.write_text(s)\np = Path('deskline/cli.py')\ns = p.read_text().replace(' | sla-report | relay-health.', ' | escalate | sla-report | relay-health.').replace('from .escalation import TicketService, sla_report, sla_status', 'from .escalation import EscalationError, TicketService, escalate, sla_report, sla_status')\npos = s.index('def cmd_relay_health(')\ns = s[:pos] + '''def cmd_escalate(args, settings) -> int:\n    ctx = Context(settings)\n    try:\n        tenant = ctx.tenants.by_slug(args.tenant)\n        result = escalate(ctx.service, ctx.relay, settings, tenant, args.ticket, args.reason, args.actor)\n    except (TenantError, TicketError, EscalationError) as e:\n        print(str(e), file=sys.stderr)\n        return 1\n    print(f\"{result.tenant} #{result.number}: {result.status}; \"\n          f\"delivery {'succeeded' if result.delivered else 'failed'}\"\n          + (f\" ({result.delivery_id})\" if result.delivery_id else \"\"))\n    if not result.delivered:\n        print(result.error or \"notification delivery failed\", file=sys.stderr)\n        return 1\n    return 0\n\n\n''' + s[pos:]\npos = s.index('    sub.add_parser(\"relay-health\"')\ns = s[:pos] + '''    e = sub.add_parser(\"escalate\", help=\"escalate a ticket and notify the tenant's on-call\")\n    e.add_argument(\"--tenant\", required=True)\n    e.add_argument(\"--ticket\", required=True, type=int)\n    e.add_argument(\"--reason\", required=True)\n    e.add_argument(\"--actor\", default=\"cli\")\n    e.set_defaults(func=cmd_escalate)\n\n''' + s[pos:]\np.write_text(s)\np = Path('README.md')\ns = p.read_text().replace('| `relay-health`', '| `escalate --tenant <slug> --ticket <number> --reason \"<text>\" [--actor <name>]` | record an escalation and notify the tenant\\'s on-call (non-zero exit on delivery failure; ticket remains escalated) |\\n| `relay-health`')\np.write_text(s)\nPY\n"]
