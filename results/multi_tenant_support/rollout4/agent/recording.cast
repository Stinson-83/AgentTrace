[60.112229, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('deskline/cli.py')\ns = p.read_text().replace('sla-report | oncall-digest | relay-health.', 'sla-report | escalate | oncall-digest | relay-health.').replace('from .escalation import TicketService,', 'from .escalation import EscalationError, TicketService, escalate,')\npos = s.index('def cmd_oncall_digest(')\ns = s[:pos] + '''def cmd_escalate(args, settings) -> int:\n    ctx = Context(settings)\n    error = None\n    try:\n        tenant = ctx.tenants.by_slug(args.tenant)\n        result = escalate(ctx.service, ctx.relay, settings, tenant, args.ticket, args.reason, args.actor)\n    except TenantError as exc:\n        print(str(exc), file=sys.stderr)\n        return 1\n    except EscalationError as exc:\n        print(str(exc), file=sys.stderr)\n        if exc.result is None:\n            return 1\n        result = exc.result\n        error = exc\n    print(f\"{result.tenant} #{result.number}: {result.status}; \"\n          f\"tenant hook={'delivered' if result.delivered else 'FAILED'} \"\n          f\"(delivery_id={result.delivery_id}); \"\n          f\"on-call={'delivered' if result.oncall_delivered else 'FAILED'}\")\n    return 1 if error else 0\n\n\n''' + s[pos:]\npos = s.index('    od = sub.add_parser(\"oncall-digest\"')\ns = s[:pos] + '''    esc = sub.add_parser(\"escalate\", help=\"escalate a ticket and notify its tenant and the on-call rota\")\n    esc.add_argument(\"--tenant\", required=True)\n    esc.add_argument(\"--ticket\", required=True, type=int)\n    esc.add_argument(\"--reason\", required=True)\n    esc.add_argument(\"--actor\", default=\"cli\")\n    esc.set_defaults(func=cmd_escalate)\n\n''' + s[pos:]\np.write_text(s)\np = Path('README.md')\ns = p.read_text().replace('| `oncall-digest', '| `escalate --tenant <slug> --ticket <number> --reason \"<text>\" [--actor <name>]` | escalate and notify the tenant hook and on-call channel |\\n| `oncall-digest', 1)\np.write_text(s)\np = Path('docs/escalation_notifications.md')\ns = p.read_text() + '''\n## Context boundaries and failures\n\nThe hook is tenant-facing: its related tickets and queue contain only that tenant's\nrecords (scoped before the usual five-record limits). The internal on-call event\ncontains desk-wide related tickets and the desk-wide queue. Context is captured\nbefore changing the ticket, so the queue describes what is already waiting and the\nlatest internal note is not the escalation audit note.\n\nThe status and internal audit note are saved before either delivery is attempted.\nBoth destinations are attempted even if the first fails. `escalate()` raises\n`EscalationError` on validation or delivery failure. For delivery failures its\n`result` attribute contains the committed `EscalationResult`, including independent\nhook/on-call success flags and the hook's delivery ID (if successful); the error\nmessage identifies failed destinations and relay errors. The CLI prints the saved\noutcome and errors, and exits non-zero if either delivery fails.\n'''\np.write_text(s)\nPY\npython -m pytest -q tests\n"]
