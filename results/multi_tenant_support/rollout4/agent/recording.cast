[72.046644, "o", "{'ticket_id': 29, 'tenant_id': 'ten_cb', 'number': 1010, 'subject': 'App push notifications silent', 'status': 'pending', 'priority': 'urgent', 'customer_id': 'cst_0009', 'assignee': None, 'created_at': '2025-10-31T22:54:00Z', 'updated_at': '2025-11-01T01:06:00Z'}\r\n{'ticket_id': 30, 'tenant_id': 'ten_nw', 'number': 1010, 'subject': 'Wholesale pricing not shown', 'status': 'open', 'priority': 'normal', 'customer_id': 'cst_0006', 'assignee': 'ravi.menon', 'created_at': '2025-11-06T13:40:00Z', 'updated_at': '2025-11-06T18:28:00Z'}\r\n{'ticket_id': 31, 'tenant_id': 'ten_hl', 'number': 1011, 'subject': 'Driver app crashes on sign-off', 'status': 'open', 'priority': 'normal', 'customer_id': 'cst_0002', 'assignee': 'beth.okoro', 'created_at': '2025-11-03T05:31:00Z', 'updated_at': '2025-11-03T08:44:00Z'}\r\n{'ticket_id': 32, 'tenant_id': 'ten_cb', 'number': 1011, 'subject': 'Trainer calendar off by one hour', 'status': 'closed', 'priority': 'normal', 'customer_id': 'cst_0008', 'assignee': 'sam.ortiz', 'created_at': '2025-10-27T19:09:00Z', 'updated_at': '2025-10-27T20:09:00Z'}\r\n{'ticket_id': 33, 'tenant_id': 'ten_nw', 'number': 1011, 'subject': 'Promo code rejected at checkout', 'status': 'open', 'priority': 'normal', 'customer_id': 'cst_0005', 'assignee': None, 'created_at': '2025-11-08T23:38:00Z', 'updated_at': '2025-11-09T07:20:00Z'}\r\n{'ticket_id': 34, 'tenant_id': 'ten_hl', 'number': 1012, 'subject': 'Duplicate consignment labels', 'status': 'resolved', 'priority': 'high', 'customer_id': 'cst_0002', 'assignee': 'jo.lindgren', 'created_at': '2025-10-30T23:17:00Z', 'updated_at': '2025-10-31T05:17:00Z'}\r\n{'ticket_id': 35, 'tenant_id': 'ten_cb', 'number': 1012, 'subject': 'Membership freeze not applied', 'status': 'open', 'priority': 'high', 'customer_id': 'cst_0008', 'assignee': 'jo.lindgren', 'created_at': '2025-10-27T18:11:00Z', 'updated_at': '2025-10-28T01:32:00Z'}\r\n{'ticket_id': 36, 'tenant_id': 'ten_nw', 'number': 1012, 'subject': 'Wholesale