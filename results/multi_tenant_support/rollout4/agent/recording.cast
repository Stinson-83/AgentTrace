[71.921815, "i", "cat tests/test_stores.py; sed -n '1,220p' services/notify_relay_service.py; python - <<'PY'\nimport json\nfrom pathlib import Path\nfor name in ['tickets', 'notes']:\n p=Path('data/seed')/(name+'.json')\n if p.exists():\n  for row in json.loads(p.read_text()): print(row)\nPY\n"]
[71.922238, "o", "cat tests/test_stores.py; sed -n '1,220p' services/notify_relay_service.py; python - <<'PY'\r\n\u001b[?2004l\r"]
[71.922298, "o", "\u001b[?2004h"]
[71.922328, "o", "> "]
[71.922355, "o", "import json\r\n\u001b[?2004l\r"]
[71.922408, "o", "\u001b[?2004h> "]
[71.922457, "o", "from pathlib import Path\r\n\u001b[?2004l\r"]
[71.922486, "o", "\u001b[?2004h> "]
[71.922584, "o", "for name in ['tickets', 'notes']:\r\n\u001b[?2004l\r"]
[71.922601, "o", "\u001b[?2004h"]
[71.922694, "o", "> "]
[71.922762, "o", " p=Path('data/seed')/(name+'.json')\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.922855, "o", "> "]
[71.922938, "o", " if p.exists():\r\n\u001b[?2004l\r\u001b[?2004h> "]
