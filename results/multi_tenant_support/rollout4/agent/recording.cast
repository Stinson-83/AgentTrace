[803.952994, "o", "\u001bM\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[K\"\r\n\u001b[?2004l\r"]
[804.280943, "o", "northwind #1042: escalated; tenant hook=delivered (delivery_id=dl_98d742813258); on-call=delivered\r\n"]
[804.298318, "o", "exit_code=0\r\n\u001b[?2004h"]
[804.298446, "o", "root@8a04ae3a55a8:/app# "]
[804.963421, "i", "python - <<'PY'\nimport base64\nimport json\nfrom pathlib import Path\nfrom deskline.config import load_settings\nfrom deskline.tenant_store import TenantStore\nfrom deskline.ticket_store import TicketStore, open_connection\n\nfor destination in ('northwind', '_channels/oncall'):\n    folder = Path('/var/lib/notify-relay/received') / destination\n    record_path = sorted(folder.glob('*.json'))[-1]\n    record = json.loads(record_path.read_text())\n    event = json.loads(base64.b64decode(record['body_b64']))\n    assert event['event'] == 'ticket.escalated'\n    assert event['tenant'] == 'northwind' and event['ticket']['number'] == 1042\n    assert event['ticket']['status'] == 'escalated'\n    assert event['escalation']['reason'] == 'SLA breached, customer chasing'\n    if destination == 'northwind':\n        assert all(row['tenant'] == 'northwind' for row in event['escalation']['queue'])\n        assert record['headers']['x-deskline-tenant'] == 'northwind'\n    print(f\"Verified {record['path']}: {record_path}\")\n    print(f\"  prior note: {event['escalation']['latest_internal_note']}\")\n    print(f\"  related={len(event['escalation']['related'])}, queue={len(event['escalation']['queue'])}\")\n\nconn = open_connection(load_settings().db_path)\ntenants, tickets = TenantStore(conn), TicketStore(conn)\nticket = tickets.get_ticket(tenants.by_slug('northwind').tenant_id, 1042)\nassert ticket.status == 'escalated'\nnote = tickets.notes_for(ticket.ticket_id)[-1]\nassert note.visibility == 'internal' and note.author == 'cli'\nassert 'SLA breached, customer chasing' in note.body\nprint(f'Saved ticket #{ticket.number}: {ticket.status}; audit note: {note.body}')\nconn.close()\nPY\n"]
