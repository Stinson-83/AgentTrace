[758.766616, "o", "deskline/cli.py:1:\"\"\"deskline command line: init-db | tenants | ticket show/search/list/note | sla-report | escalate | oncall-digest | relay-health.\"\"\"\r\ndeskline/cli.py:12:from .escalation import EscalationError, TicketService, escalate, escalation_queue, sla_report, sla_status\r\ndeskline/cli.py:118:def cmd_escalate(args, settings) -> int:\r\ndeskline/cli.py:123:        result = escalate(ctx.service, ctx.relay, settings, tenant, args.ticket, args.reason, args.actor)\r\ndeskline/cli.py:191:    esc = sub.add_parser(\"escalate\", help=\"escalate a ticket and notify its tenant and the on-call rota\")\r\ndeskline/cli.py:196:    esc.set_defaults(func=cmd_escalate)\r\ndeskline/notification.py:48:        except (OSError, ValueError) as e:\r\ndeskline/notification.py:64:        except (OSError, ValueError) as e:\r\ndeskline/notification.py:73:        except (OSError, ValueError) as e:\r\n"]
