[108.908664, "o", "cat deskline/cache.py\r\n\u001b[?2004l\r"]
[108.909689, "o", "\"\"\"Small in-process LRU cache for hot records (ticket views, tenant rows).\"\"\"\r\nfrom __future__ import annotations\r\n\r\nfrom collections import OrderedDict\r\nfrom typing import Any, Callable, Generic, Hashable, TypeVar\r\n\r\nT = TypeVar(\"T\")\r\n\r\n\r\nclass RecordCache(Generic[T]):\r\n    def __init__(self, max_entries: int = 256):\r\n        self.max_entries = max(1, max_entries)\r\n        self._entries: \"OrderedDict[Hashable, T]\" = OrderedDict()\r\n        self.hits = 0\r\n        self.misses = 0\r\n\r\n    def get(self, key: Hashable) -> T | None:\r\n        if key in self._entries:\r\n            self._entries.move_to_end(key)\r\n            self.hits += 1\r\n            return self._entries[key]\r\n        self.misses += 1\r\n        return None\r\n\r\n    def put(self, key: Hashable, value: T) -> T:\r\n        self._entries[key] = value\r\n        self._entries.move_to_end(key)\r\n        while len(self._entries) > self.max_entries:\r\n            self._entries.popitem(last=False)\r\n        return value\r\n\r\n    def get_or_load(self, key: Hashable, loader: Callable[[], T]) -> T:\r\n        cached = self.get(key)\r\n        if cached is not None:\r\n            return cached\r\n        return self.put(key, loader())\r\n\r\n    def invalidate(self, key: Hashable) -> None:\r\n        self._entries.pop(key, None)\r\n\r\n    def clear(self) -> None:\r\n        self._entries.clear()\r\n\r\n    def __len__(self) -> int:\r\n        return len(self._entries)\r\n\r\n    def stats(self) -> dict[str, Any]:\r\n        return {\"entries\": len(self._entries), \"hits\": self.hits, \"misses\": self.misses}\r\n"]
[108.909885, "o", "\u001b[?2004hroot@8a04ae3a55a8:/app# "]
[131.248776, "i", "python - <<'PY'\nfrom pathlib import Path\np=Path('tests/test_escalation.py')\ns=p.read_text().replace('from datetime import datetime, timezone\\n\\nfrom deskline.escalation import escalation_queue, sla_report, sla_status, subject_terms', '''import copy\nfrom datetime import datetime, timezone\n\nimport pytest\n\nfrom deskline.escalation import EscalationError, escalate, escalation_queue, sla_report, sla_status, subject_terms\nfrom deskline.notification import RelayError, RelayResponse''')\ns=s.replace('\\n\\nimport copy\\nfrom dataclasses import replace\\n\\nimport pytest\\n\\nfrom deskline.escalation import EscalationError, escalate\\nfrom deskline.notification import RelayError, RelayResponse\\n', '')\ns=s.replace('''    ticket = tickets.create_ticket(\"ten_nw\", \"Entirely new issue\", \"normal\", \"cst_0001\")\n    # Use an actual Northwind customer rather than relying on seed customer IDs.\n    customer = service.view(\"ten_nw\", 1042).customer\n    with tickets._conn:\n        tickets._conn.execute(\"UPDATE tickets SET customer_id = ? WHERE ticket_id = ?\", (customer.customer_id, ticket.ticket_id))''', '''    customer = service.view(\"ten_nw\", 1042).customer\n    ticket = tickets.create_ticket(\"ten_nw\", \"Entirely new issue\", \"normal\", customer.customer_id)''')\np.write_text(s)\nPY\ncat > tests/test_cli.py <<'PY'\nimport pytest\n\nfrom deskline import cli\nfrom test_escalation import RecordingRelay\n\n\ndef setup_cli(monkeypatch, settings, relay):\n    monkeypatch.setattr(cli, \"load_settings\", lambda: settings)\n    monkeypatch.setattr(cli, \"NotificationRelayClient\", lambda *args: relay)\n\n\n@pytest.mark.parametrize(\"actor\", [None, \"night-shift\"])\ndef test_cli_escalate_success(db, settings, monkeypatch, capsys, actor):\n    relay = RecordingRelay()\n    setup_cli(monkeypatch, settings, relay)\n    args = [\"escalate\", \"--tenant\", \"northwind\", \"--ticket\", \"1042\", \"--reason\", \"Customer chasing\"]\n    if actor:\n        args += [\"--actor\", actor]\n    assert cli.main(args) == 0\n    output = capsys.readouterr()\n    assert \"northwind #1042: escalated\" in output.out\n    assert \"tenant hook=delivered\" in output.out and \"on-call=delivered\" in output.out\n    assert \"hook-123\" in output.out and not output.err\n    assert all(event[\"actor\"] == (actor or \"cli\") for _, event in relay.calls)\n\n\n@pytest.mark.parametrize(\"tenant,number,status,expected\", [\n    (\"unknown\", 1042, None, \"unknown tenant\"),\n    (\"northwind\", 1055, None, \"not found\"),\n    (\"northwind\", 1042, \"resolved\", \"resolved\"),\n    (\"northwind\", 1042, \"closed\", \"closed\"),\n])\ndef test_cli_escalate_validation_failure(db, settings, monkeypatch, capsys, tenant, number, status, expected):\n    relay = RecordingRelay()\n    setup_cli(monkeypatch, settings, relay)\n    if status:\n        ticket = db[2].get_ticket(\"ten_nw\", 1042)\n        db[2].update_status(ticket.ticket_id, status)\n    assert cli.main([\"escalate\", \"--tenant\", tenant, \"--ticket\", str(number), \"--reason\", \"Help\"]) != 0\n    assert expected in capsys.readouterr().err\n    assert not relay.calls\n\n\n@pytest.mark.parametrize(\"hook_error,channel_error\", [(\"rejected (422)\", None), (None, \"unreachable\"), (\"unreachable\", \"unreachable\")])\ndef test_cli_escalate_delivery_failure(db, settings, monkeypatch, capsys, hook_error, channel_error):\n    relay = RecordingRelay(hook_error, channel_error)\n    setup_cli(monkeypatch, settings, relay)\n    assert cli.main([\"escalate\", \"--tenant\", \"northwind\", \"--ticket\", \"1042\", \"--reason\", \"Help\"]) != 0\n    output = capsys.readouterr()\n    assert \"northwind #1042: escalated\" in output.out and \"FAILED\" in output.out\n    if hook_error:\n        assert hook_error in output.err\n    if channel_error:\n        assert channel_error in output.err\n    assert len(relay.calls) == 2\n    assert db[2].get_ticket(\"ten_nw\", 1042).status == \"escalated\"\n\n\ndef test_cli_escalate_requires_reason():\n    with pytest.raises(SystemExit) as caught:\n        cli.build_parser().parse_args([\"escalate\", \"--tenant\", \"northwind\", \"--ticket\", \"1042\"])\n    assert caught.value.code != 0\nPY\ncat > tests/test_notification.py <<'PY'\nimport io\nimport json\nimport urllib.error\nfrom unittest.moc"]
[131.248913, "i", "k import MagicMock\n\nimport pytest\n\nfrom deskline.notification import NotificationRelayClient, RelayError\n\n\ndef test_relay_escalation_destinations_and_headers(db, monkeypatch):\n    requests = []\n\n    def urlopen(req, timeout):\n        requests.append(req)\n        assert timeout == 2\n        response = MagicMock()\n        response.status = 202\n        response.read.return_value = b'{\"delivery_id\":\"delivery-123\"}'\n        response.__enter__.return_value = response\n        return response\n\n    monkeypatch.setattr(\"urllib.request.urlopen\", urlopen)\n    relay = NotificationRelayClient(\"http://relay.local/\", 2)\n    event = {\"event\": \"ticket.escalated\", \"ticket\": {\"number\": 1042, \"status\": \"escalated\"}, \"escalation\": {\"reason\": \"Help\"}}\n    assert relay.post(db[1].by_slug(\"northwind\"), event).body[\"delivery_id\"] == \"delivery-123\"\n    assert relay.post_channel(\"/channels/custom-oncall\", event).status == 202\n    assert [req.full_url for req in requests] == [\"http://relay.local/hooks/northwind/escalations\", \"http://relay.local/channels/custom-oncall\"]\n    for request in requests:\n        headers = {key.lower(): value for key, value in request.header_items()}\n        assert headers[\"content-type\"] == \"application/json\"\n        assert headers[\"x-deskline-event\"] == \"ticket.escalated\"\n        assert json.loads(request.data) == event\n    assert requests[0].get_header(\"X-deskline-tenant\") == \"northwind\"\n    assert requests[1].get_header(\"X-deskline-tenant\") is None\n\n\n@pytest.mark.parametrize(\"destination\", [\"hook\", \"channel\"])\n@pytest.mark.parametrize(\"error,expected\", [\n    (urllib.error.HTTPError(\"http://relay.local\", 422, \"Rejected\", {}, io.BytesIO(b'invalid event')), \"422\"),\n    (urllib.error.URLError(\"connection refused\"), \"unreachable\"),\n    (TimeoutError(\"timed out\"), \"timed out\"),\n])\ndef test_relay_errors_are_normalized(db, monkeypatch, destination, error, expected):\n    def fail(*args, **kwargs):\n        raise error\n\n    monkeypatch.setattr(\"urllib.request.urlopen\", fail)\n    relay = NotificationRelayClient(\"http://relay.local\")\n    with pytest.raises(RelayError, match=expected):\n        if destination == \"hook\":\n            relay.post(db[1].by_slug(\"northwind\"), {})\n        else:\n            relay.post_channel(\"/channels/oncall\", {})\nPY\npython -m pytest -q tests\n"]
