[131.339711, "o", "    relay = RecordingRelay()\r\n\u001b[?2004l\r\u001b[?2004h>     setup_cli(monkeypatch, settings, relay)\r\n\u001b[?2004l\r\u001b[?2004h>     args = [\"escalate\", \"--tenant\", \"northwind\", \"--ticket\", \"1042\", \"--reason\", \"Customer chasing\"]\r\n\u001b[?2004l\r\u001b[?2004h>     if actor:\r\n\u001b[?2004l\r\u001b[?2004h>         args += [\"--actor\", actor]\r\n\u001b[?2004l\r\u001b[?2004h>     assert cli.main(args) == 0\r\n\u001b[?2004l\r\u001b[?2004h>     output = capsys.readouterr()\r\n\u001b[?2004l\r\u001b[?2004h>     assert \"northwind #1042: escalated\" in output.out\r\n\u001b[?2004l\r\u001b[?2004h>     assert \"tenant hook=delivered\" in output.out and \"on-call=delivered\" in output.out\r\n\u001b[?2004l\r\u001b[?2004h>     assert \"hook-123\" in output.out and not output.err\r\n\u001b[?2004l\r\u001b[?2004h>     assert all(event[\"actor\"] == (actor or \"cli\") for _, event in relay.calls)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"tenant,number,status,expected\", [\r\n\u001b[?2004l\r\u001b[?2004h>     (\"unknown\", 1042, None, \"unknown tenant\"),\r\n\u001b[?2004l\r\u001b[?2004h>     (\"northwind\", 1055, None, \"not found\"),\r\n\u001b[?2004l\r\u001b[?2004h>     (\"northwind\", 1042, \"resolved\", \"resolved\"),\r\n\u001b[?2004l\r\u001b[?2004h>     (\"northwind\", 1042, \"closed\", \"closed\"),\r\n\u001b[?2004l\r\u001b[?2004h> ])\r\n\u001b[?2004l\r\u001b[?2004h> def test_cli_escalate_validation_failure(db, settings, monkeypatch, capsys, tenant, number, status, expected):\r\n\u001b[?2004l\r\u001b[?2004h>     relay = RecordingRelay()\r\n\u001b[?2004l\r\u001b[?2004h>     setup_cli(monkeypatch, settings, relay)\r\n\u001b[?2004l\r\u001b[?2004h>     if status:\r\n\u001b[?2004l\r\u001b[?2004h>         ticket = db[2].get_ticket(\"ten_nw\", 1042)\r\n\u001b[?2004l\r\u001b[?2004h>         db[2].update_status(ticket.ticket_id, status)\r\n\u001b[?2004l\r\u001b[?2004h>     assert cli.main([\"escalate\", \"--tenant\", tenant, \"--ticket\", str(number), \"--reason\", \"Help\"]) != 0\r\n\u001b[?2004l\r\u001b[?2004h>     assert expected in capsys.readouterr().err\r\n\u001b[?2004l\r\u001b[?2004h>     assert not relay.calls\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"hook_error,channel_error\", [(\"rejected (422)\", None), (None, \"unreachable\"), (\"unreachable\", \"unreachable\")])\r\n\u001b[?2004l\r\u001b[?2004h> def test_cli_escalate_delivery_failure(db, settings, monkeypatch, capsys, hook_error, channel_error):\r\n\u001b[?2004l\r\u001b[?2004h>     relay = RecordingRelay(hook_error, channel_error)\r\n\u001b[?2004l\r\u001b[?2004h>     setup_cli(monkeypatch, settings, relay)\r\n\u001b[?2004l\r\u001b[?2004h>     assert cli.main([\"escalate\", \"--tenant\", \"northwind\", \"--ticket\", \"1042\", \"--reason\", \"Help\"]) != 0\r\n\u001b[?2004l\r\u001b[?2004h>     output = capsys.readouterr()\r\n\u001b[?2004l\r\u001b[?2004h>     assert \"northwind #1042: escalated\" in output.out and \"FAILED\" in output.out\r\n\u001b[?2004l\r\u001b[?2004h>     if hook_error:\r\n\u001b[?2004l\r\u001b[?2004h>         assert hook_error in output.err\r\n\u001b[?2004l\r\u001b[?2004h>     if channel_error:\r\n\u001b[?2004l\r\u001b[?2004h>         assert channel_error in output.err\r\n\u001b[?2004l\r\u001b[?2004h>     assert len(relay.calls) == 2\r\n\u001b[?2004l\r\u001b[?2004h>     assert db[2].get_ticket(\"ten_nw\", 1042).status == \"escalated\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_cli_escalate_requires_reason():\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(SystemExit) as caught:\r\n\u001b[?2004l\r\u001b[?2004h>         cli.build_parser().parse_args([\"escalate\", \"--tenant\", \"northwind\", \"--ticket\", \"1042\"])\r\n\u001b[?2004l\r\u001b[?2004h>     assert caught.value.code != 0\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r\"connection refused\"), \"unreachable\"),\r\n    (TimeoutError(\"timed out\"), \"timed out\"),\r\n])\r\ndef test_relay_errors_are_normalized(db, monkeypatch, destination, error, expected):\r\n    def fail(*args, **kwargs):\r\n        raise error\r\n\r\n    monkeypatch.setattr(\"urllib.request.urlopen\", fail)\r\n    relay = NotificationRelayClient(\"http://relay.local\")\r\n    with pytest.raises(RelayError, match=expected):\r\n        if destination == \"hook\":\r\n            relay.post(db[1].by_slug(\"northwind\"), {})\r\n      "]
[131.339737, "o", "  else:\r\n            relay.post_channel(\"/channels/oncall\", {})\r\nPY\r\npython -m pytest -q tests\r\n"]
