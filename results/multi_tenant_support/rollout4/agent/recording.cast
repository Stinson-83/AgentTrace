[786.594818, "i", "python - <<'PY'\nfrom pathlib import Path\np=Path('deskline/escalation.py')\ns=p.read_text().replace('TicketError, TicketStore, utcnow', 'TicketError, TicketStore')\ns=s.replace('''        terms, with the context the panel shows (customer, last internal note).\"\"\"''', '''        terms, with the context the panel shows (customer, last internal note).\n        Tenant-facing callers must supply tenant_id to scope the search before limiting.\n        \"\"\"''')\ns=s.replace('''    shows (tenant, customer, SLA position, latest internal note).\"\"\"''', '''    shows (tenant, customer, SLA position, latest internal note). Supply tenant_id\n    for a tenant-facing queue; the default remains desk-wide for the digest.\n    \"\"\"''')\ns=s.replace('''            \"occurred_at\": utcnow(), \"actor\": actor,''', '''            \"occurred_at\": now.isoformat(timespec=\"seconds\").replace(\"+00:00\", \"Z\"), \"actor\": actor,''')\ns=s.replace('    oncall_event[\"occurred_at\"] = hook_event[\"occurred_at\"]\\n', '')\np.write_text(s)\nPY\ncat >> tests/test_escalation.py <<'PY'\n\n\n@pytest.mark.parametrize(\"status\", [\"open\", \"pending\", \"escalated\"])\ndef test_escalate_active_status_with_configured_channel(db, settings, service, status):\n    from dataclasses import replace\n\n    _, tenants, tickets = db\n    tenant = tenants.by_slug(\"northwind\")\n    ticket = tickets.get_ticket(tenant.tenant_id, 1042)\n    tickets.update_status(ticket.ticket_id, status)\n    relay = RecordingRelay()\n    result = escalate(service, relay, replace(settings, oncall_channel=\"/channels/rota\"), tenant, 1042, \"Help\")\n    assert result.delivered and result.oncall_delivered\n    assert relay.calls[1][0] == \"/channels/rota\"\n    assert tickets.by_id(ticket.ticket_id).priority == ticket.priority\n    context = relay.calls[1][1][\"escalation\"]\n    if status == \"escalated\":\n        row = next(r for r in context[\"queue\"] if r[\"tenant\"] == \"northwind\" and r[\"number\"] == 1042)\n        assert row[\"latest_internal_note\"] == context[\"latest_internal_note\"]\nPY\npython -m pytest -q tests > /tmp/deskline-tests.log 2>&1; cat /tmp/deskline-tests.log\n"]
