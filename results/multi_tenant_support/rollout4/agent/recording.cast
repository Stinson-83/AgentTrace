[108.867402, "o", "    _, tenants, tickets = db\r\n\u001b[?2004l\r"]
[108.86744, "o", "\u001b[?2004h> "]
[108.867587, "o", "    tenant = tenants.by_slug(\"northwind\")\r\n\u001b[?2004l\r"]
[108.867616, "o", "\u001b[?2004h"]
[108.867642, "o", "> "]
[108.867923, "o", "    before = service.view(tenant.tenant_id, 1042)  # prime the view cache\r\n\u001b[?2004l\r"]
[108.86797, "o", "\u001b[?2004h> "]
[108.868126, "o", "    other_before = tickets.get_ticket(\"ten_hl\", 1042)\r\n\u001b[?2004l\r"]
[108.868148, "o", "\u001b[?2004h"]
[108.868169, "o", "> "]
[108.868457, "o", "    queue_before = escalation_queue(service, settings)\r\n\u001b[?2004l\r"]
[108.8685, "o", "\u001b[?2004h> "]
[108.868815, "o", "    # A note added after caching must be included; a newer public note must not be.\r\n\u001b[?2004l\r"]
[108.86886, "o", "\u001b[?2004h> "]
[108.869153, "o", "    tickets.add_note(before.ticket.ticket_id, \"agent\", \"Fresh investigation context\")\r\n\u001b[?2004l\r"]
[108.869195, "o", "\u001b[?2004h> "]
[108.869482, "o", "    tickets.add_note(before.ticket.ticket_id, \"customer\", \"Any news?\", \"public\")\r\n\u001b[?2004l\r"]
[108.869523, "o", "\u001b[?2004h> "]
[108.86963, "o", "    relay = RecordingRelay()\r\n\u001b[?2004l\r"]
[108.869663, "o", "\u001b[?2004h> "]
[108.870015, "o", "    result = escalate(service, relay, settings, tenant, 1042, \"Customer chasing\", \"alice\")\r\n\u001b[?2004l\r"]
[108.870071, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.870419, "o", "    assert (result.tenant, result.number, result.status) == (\"northwind\", 1042, \"escalated\")\r\n\u001b[?2004l\r"]
[108.87046, "o", "\u001b[?2004h> "]
[108.870813, "o", "    assert result.delivered and result.oncall_delivered and result.delivery_id == \"hook-123\"\r\n\u001b[?2004l\r"]
[108.870855, "o", "\u001b[?2004h> "]
[108.871043, "o", "    after = service.view(tenant.tenant_id, 1042)\r\n\u001b[?2004l\r"]
[108.871076, "o", "\u001b[?2004h"]
[108.8711, "o", "> "]
[108.871251, "o", "    assert after.ticket.status == \"escalated\"\r\n\u001b[?2004l\r"]
[108.871275, "o", "\u001b[?2004h"]
[108.871294, "o", "> "]
[108.871482, "o", "    assert len(after.notes) == len(before.notes) + 3\r\n"]
[108.871505, "o", "\u001b[?2004l\r"]
[108.871524, "o", "\u001b[?2004h"]
[108.871545, "o", "> "]
[108.871754, "o", "    assert after.latest_internal_note.author == \"alice\"\r\n\u001b[?2004l\r"]
[108.871776, "o", "\u001b[?2004h"]
[108.871798, "o", "> "]
[108.872027, "o", "    assert after.latest_internal_note.visibility == \"internal\"\r\n"]
[108.872052, "o", "\u001b[?2004l\r"]
[108.872073, "o", "\u001b[?2004h> "]
[108.872489, "o", "    assert \"alice\" in after.latest_internal_note.body and \"Customer chasing\" in after.latest_internal_note.body\r\n\u001b[?2004l\r"]
[108.872523, "o", "\u001b[?2004h> "]
[108.872759, "o", "    assert tickets.get_ticket(\"ten_hl\", 1042) == other_before\r\n\u001b[?2004l\r"]
[108.872779, "o", "\u001b[?2004h"]
[108.872798, "o", "> \r\n\u001b[?2004l\r"]
[108.87282, "o", "\u001b[?2004h> "]
[108.873201, "o", "    assert [path for path, _ in relay.calls] == [tenant.escalation_hook, settings.oncall_channel]\r\n\u001b[?2004l\r"]
[108.873236, "o", "\u001b[?2004h> "]
[108.873439, "o", "    hook, oncall = [event for _, event in relay.calls]\r\n"]
[108.873462, "o", "\u001b[?2004l\r"]
[108.873481, "o", "\u001b[?2004h> "]
[108.873593, "o", "    for event in (hook, oncall):\r\n\u001b[?2004l\r"]
[108.873618, "o", "\u001b[?2004h"]
[108.873677, "o", "> "]
[108.873749, "o", "        assert event[\"event\"] == \"ticket.escalated\"\r\n\u001b[?2004l\r"]
[108.873781, "o", "\u001b[?2004h> "]
[108.873896, "o", "        assert event[\"tenant\"] == \"northwind\" and event[\"actor\"] == \"alice\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[108.873932, "o", "> "]
[108.873988, "o", "        assert event[\"occurred_at\"].endswith(\"Z\")\r\n\u001b[?2004l\r"]
[108.874018, "o", "\u001b[?2004h> "]
[108.874136, "o", "        assert event[\"ticket\"] == {\"number\": 1042, \"subject\": before.ticket.subject,\r\n\u001b[?2004l\r"]
[108.874169, "o", "\u001b[?2004h> "]
[108.87431, "o", "                                   \"status\": \"escalated\", \"priority\": \"high\", \"customer\": \"Dev Patel\"}\r\n\u001b[?2004l\r\u001b[?2004h"]
[108.874342, "o", "> "]
[108.874386, "o", "        context = event[\"escalation\"]\r\n\u001b[?2004l\r"]
[108.874415, "o", "\u001b[?2004h> "]
[108.874494, "o", "        assert context[\"reason\"] == \"Customer chasing\"\r\n\u001b[?2004l\r"]
[108.874523, "o", "\u001b[?2004h> "]
[108.874677, "o", "        assert context[\"latest_internal_note\"] == \"Fresh investigation context\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.874807, "o", "        assert context[\"sla\"][\"breached\"] and context[\"sla\"][\"target_hours\"] == 8\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.874955, "o", "        assert context[\"sla\"][\"priority\"] == \"high\" and context[\"sla\"][\"age_hours\"] > 8\r\n\u001b[?2004l\r\u001b[?2004h"]
[108.874992, "o", "> "]
[108.875123, "o", "        assert not any(r[\"tenant\"] == \"northwind\" and r[\"number\"] == 1042 for r in context[\"queue\"])\r\n\u001b[?2004l\r\u001b[?2004h"]
[108.875158, "o", "> "]
[108.875229, "o", "    assert hook[\"occurred_at\"] == oncall[\"occurred_at\"]\r\n\u001b[?2004l\r"]
[108.875261, "o", "\u001b[?2004h> "]
[108.875368, "o", "    assert oncall[\"escalation\"][\"related\"] == service.related(before.ticket)\r\n\u001b[?2004l\r"]
[108.875399, "o", "\u001b[?2004h> "]
[108.875591, "o", "    assert [(r[\"tenant\"], r[\"number\"]) for r in oncall[\"escalation\"][\"queue\"]] == [(r[\"tenant\"], r[\"number\"]) for r in queue_before]\r\n\u001b[?2004l\r"]
[108.875683, "o", "\u001b[?2004h> "]
[108.875782, "o", "    assert any(r[\"tenant\"] == \"harbourline\" and r[\"number\"] == 1042 for r in oncall[\"escalation\"][\"queue\"])\r\n\u001b[?2004l\r"]
[108.875828, "o", "\u001b[?2004h> "]
[108.875921, "o", "    assert all(r[\"tenant\"] == \"northwind\" for r in hook[\"escalation\"][\"queue\"])\r\n\u001b[?2004l\r"]
[108.875989, "o", "\u001b[?2004h> \r\n\u001b[?2004l\ra\u001b[?2004h"]
[108.876035, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.876087, "o", "@pytest.mark.parametrize(\"status\", [\"resolved\", \"closed\"])\r\n\u001b[?2004l\r"]
[108.876132, "o", "\u001b[?2004h> "]
[108.876289, "o", "def test_escalate_terminal_ticket_does_not_mutate_or_post(db, settings, service, status):\r\n\u001b[?2004l\r"]
[108.876353, "o", "\u001b[?2004h> "]
[108.876408, "o", "    _, tenants, tickets = db\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.876494, "o", "    ticket = tickets.get_ticket(\"ten_nw\", 1042)\r\n\u001b[?2004l\r"]
[108.876537, "o", "\u001b[?2004h> "]
[108.876704, "o", "    service.view(\"ten_nw\", 1042)  # validation must not trust a stale cached status\r\n\u001b[?2004l\r"]
[108.876745, "o", "\u001b[?2004h> "]
[108.876838, "o", "    tickets.update_status(ticket.ticket_id, status)\r\n\u001b[?2004l\r"]
[108.876878, "o", "\u001b[?2004h> "]
[108.876948, "o", "    before = tickets.by_id(ticket.ticket_id)\r\n\u001b[?2004l\r"]
[108.876985, "o", "\u001b[?2004h> "]
[108.877054, "o", "    notes = tickets.notes_for(ticket.ticket_id)\r\n\u001b[?2004l\r"]
[108.877093, "o", "\u001b[?2004h> "]
[108.877127, "o", "    relay = RecordingRelay()\r\n\u001b[?2004l\r"]
[108.877166, "o", "\u001b[?2004h> "]
[108.877278, "o", "    with pytest.raises(EscalationError, match=status) as caught:\r\n\u001b[?2004l\r"]
[108.877316, "o", "\u001b[?2004h> "]
[108.877459, "o", "        escalate(service, relay, settings, tenants.by_slug(\"northwind\"), 1042, \"test\")\r\n\u001b[?2004l\r"]
[108.877499, "o", "\u001b[?2004h> "]
[108.87755, "o", "    assert caught.value.result is None\r\n\u001b[?2004l\r"]
[108.877588, "o", "\u001b[?2004h> "]
[108.877632, "o", "    assert not relay.calls\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.877749, "o", "    assert tickets.by_id(ticket.ticket_id) == before\r\n\u001b[?2004l\r"]
[108.87783, "o", "\u001b[?2004h> "]
[108.877883, "o", "    assert tickets.notes_for(ticket.ticket_id) == notes\r\n\u001b[?2004l\r"]
[108.877942, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rn"]
[108.87798, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rt\u001b[?2004h> "]
[108.87807, "o", "@pytest.mark.parametrize(\"number\", [9999, 1055])  # 1055 exists only at Harbourline\r\n\u001b[?2004l\r"]
[108.878104, "o", "\u001b[?2004h> "]
[108.878134, "o", "ndef_placeholder = None\r\n\u001b[?2004l\r\u001b[?2004h"]
[108.878164, "o", "> PY\r\n\u001b[?2004l\r"]
[108.889875, "o", "\u001b[?2004hroot@8a04ae3a55a8:/app# "]
[108.890127, "o", "# Remove the placeholder before completing the parameterized test.\r\n\u001b[?2004l\r"]
[108.890194, "o", "\u001b[?2004hroot@8a04ae3a55a8:/app# "]
[108.890414, "o", "sed -i '/^ndef_placeholder = None$/d' tests/test_escalation.py\r\n\u001b[?2004l\r"]
[108.892671, "o", "\u001b[?2004hroot@8a04ae3a55a8:/app# "]
[108.892819, "o", "cat >> tests/test_escalation.py <<'PY'\r\n\u001b[?2004l\r"]
[108.895637, "o", "\u001b[?2004h> def test_escalate_unknown_or_other_tenant_ticket(db, settings, service, number):\r\n\u001b[?2004l\r\u001b[?2004h>     conn, tenants, _ = db\r\n\u001b[?2004l\r\u001b[?2004h>     relay = RecordingRelay()\r\n\u001b[?2004l\r\u001b[?2004h>     before = conn.total_changes\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(EscalationError, match=\"not found\"):\r\n\u001b[?2004l\r\u001b[?2004h>         escalate(service, relay, settings, tenants.by_slug(\"northwind\"), number, \"test\")\r\n\u001b[?2004l\r\u001b[?2004h>     assert conn.total_changes == before\r\n\u001b[?2004l\r\u001b[?2004h>     assert not relay.calls\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"hook_error,channel_error\", [\r\n\u001b[?2004l\r\u001b[?2004h>     (\"relay rejected the notification (422)\", None),\r\n\u001b[?2004l\r\u001b[?2004h>     (None, \"relay unreachable\"),\r\n\u001b[?2004l\r\u001b[?2004h>     (\"relay unreachable\", \"relay unreachable\"),\r\n\u001b[?2004l\r\u001b[?2004h> ])\r\n\u001b[?2004l\r\u001b[?2004h> def test_escalation_delivery_failures_preserve_update_and_attempt_both(db, settings, service, hook_error, channel_error):\r\n\u001b[?2004l\r\u001b[?2004h>     _, tenants, tickets = db\r\n\u001b[?2004l\r\u001b[?2004h>     relay = RecordingRelay(hook_error, channel_error)\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(EscalationError) as caught:\r\n\u001b[?2004l\r\u001b[?2004h"]
[108.895715, "o", "> "]
[108.895876, "o", "        escalate(service, relay, settings, tenants.by_slug(\"northwind\"), 1042, \"Urgent\")\r\n\u001b[?2004l\r"]
[108.895921, "o", "\u001b[?2004h> "]
[108.895997, "o", "    result = caught.value.result\r\n\u001b[?2004l\r"]
[108.896037, "o", "\u001b[?2004h> "]
[108.89613, "o", "    assert result.status == \"escalated\"\r\n\u001b[?2004l\r"]
[108.89617, "o", "\u001b[?2004h> "]
[108.896297, "o", "    assert result.delivered == (hook_error is None)\r\n\u001b[?2004l\r"]
[108.896347, "o", "\u001b[?2004h> "]
[108.896485, "o", "    assert result.oncall_delivered == (channel_error is None)\r\n\u001b[?2004l\r"]
[108.896527, "o", "\u001b[?2004h> "]
[108.89672, "o", "    assert result.delivery_id == (\"hook-123\" if hook_error is None else None)\r\n\u001b[?2004l\r"]
[108.896762, "o", "\u001b[?2004h> "]
[108.896834, "o", "    assert len(relay.calls) == 2\r\n\u001b[?2004l\r"]
[108.896874, "o", "\u001b[?2004h> "]
[108.897114, "o", "    for destination, error in ((\"tenant hook\", hook_error), (\"on-call channel\", channel_error)):\r\n\u001b[?2004l\r"]
[108.897153, "o", "\u001b[?2004h> "]
[108.897192, "o", "        if error:\r\n\u001b[?2004l\r"]
[108.897231, "o", "\u001b[?2004h> "]
[108.897434, "o", "            assert destination in str(caught.value) and error in str(caught.value)\r\n\u001b[?2004l\r"]
[108.897474, "o", "\u001b[?2004h> "]
[108.897565, "o", "    view = service.view(\"ten_nw\", 1042)\r\n\u001b[?2004l\r"]
[108.89761, "o", "\u001b[?2004h> "]
[108.89783, "o", "    assert view.ticket.status == tickets.get_ticket(\"ten_nw\", 1042).status == \"escalated\"\r\n\u001b[?2004l\r"]
[108.897872, "o", "\u001b[?2004h> "]
[108.898, "o", "    assert view.latest_internal_note.author == \"cli\"\r\n\u001b[?2004l\r"]
[108.898051, "o", "\u001b[?2004h> "]
[108.898178, "o", "    assert \"Urgent\" in view.latest_internal_note.body\r\n\u001b[?2004l\r"]
[108.898225, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[108.89827, "o", "\u001b[?2004h> "]
[108.898422, "o", "def test_escalate_without_internal_note(db, settings, service):\r\n\u001b[?2004l\r"]
[108.898463, "o", "\u001b[?2004h> "]
[108.898526, "o", "    _, tenants, tickets = db\r\n\u001b[?2004l\r"]
[108.898566, "o", "\u001b[?2004h> "]
[108.89879, "o", "    ticket = tickets.create_ticket(\"ten_nw\", \"Entirely new issue\", \"normal\", \"cst_0001\")\r\n\u001b[?2004l\r"]
[108.898833, "o", "\u001b[?2004h> "]
[108.899031, "o", "    # Use an actual Northwind customer rather than relying on seed customer IDs.\r\n\u001b[?2004l\r"]
[108.899073, "o", "\u001b[?2004h> "]
[108.899195, "o", "    customer = service.view(\"ten_nw\", 1042).customer\r\n\u001b[?2004l\r"]
[108.899241, "o", "\u001b[?2004h> "]
[108.899292, "o", "    with tickets._conn:\r\n\u001b[?2004l\r"]
[108.899337, "o", "\u001b[?2004h> "]
[108.899654, "o", "        tickets._conn.execute(\"UPDATE tickets SET customer_id = ? WHERE ticket_id = ?\", (customer.customer_id, ticket.ticket_id))\r\n\u001b[?2004l\r"]
[108.899704, "o", "\u001b[?2004h> "]
[108.89976, "o", "    relay = RecordingRelay()\r\n\u001b[?2004l\r"]
[108.899801, "o", "\u001b[?2004h> "]
[108.900025, "o", "    escalate(service, relay, settings, tenants.by_slug(\"northwind\"), ticket.number, \"Help\")\r\n\u001b[?2004l\r"]
[108.90007, "o", "\u001b[?2004h> "]
[108.900297, "o", "    assert all(event[\"escalation\"][\"latest_internal_note\"] is None for _, event in relay.calls)\r\n\u001b[?2004l\r"]
[108.900337, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[108.900377, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.900613, "o", "def test_hook_context_scoped_before_limit_and_never_leaks(db, settings, service):\r\n\u001b[?2004l\r"]
[108.900671, "o", "\u001b[?2004h> "]
[108.900714, "o", "    conn, tenants, tickets = db\r\n\u001b[?2004l\r"]
[108.900756, "o", "\u001b[?2004h> "]
[108.900846, "o", "    nw = service.view(\"ten_nw\", 1042)\r\n\u001b[?2004l\r"]
[108.900887, "o", "\u001b[?2004h> "]
[108.900974, "o", "    hl = service.view(\"ten_hl\", 1042)\r\n\u001b[?2004l\r"]
[108.901015, "o", "\u001b[?2004h> "]
[108.901251, "o", "    own = tickets.create_ticket(\"ten_nw\", nw.ticket.subject, \"normal\", nw.customer.customer_id)\r\n\u001b[?2004l\r"]
[108.901292, "o", "\u001b[?2004h> "]
[108.901454, "o", "    tickets.add_note(own.ticket_id, \"agent\", \"OWN related context\")\r\n\u001b[?2004l\r"]
[108.901494, "o", "\u001b[?2004h> "]
[108.901625, "o", "    tickets.update_status(own.ticket_id, \"escalated\")\r\n\u001b[?2004l\r"]
[108.901666, "o", "\u001b[?2004h> "]
[108.901708, "o", "    foreign_ids = []\r\n\u001b[?2004l\r"]
[108.901748, "o", "\u001b[?2004h> "]
[108.901802, "o", "    for i in range(6):\r\n\u001b[?2004l\r"]
[108.901841, "o", "\u001b[?2004h> "]
[108.902101, "o", "        other = tickets.create_ticket(\"ten_hl\", nw.ticket.subject, \"urgent\", hl.customer.customer_id)\r\n\u001b[?2004l\r"]
[108.902155, "o", "\u001b[?2004h> "]
[108.902331, "o", "        tickets.add_note(other.ticket_id, \"other\", f\"FOREIGN SECRET {i}\")\r\n\u001b[?2004l\r"]
[108.902421, "o", "\u001b[?2004h> "]
[108.902521, "o", "        tickets.update_status(other.ticket_id, \"escalated\")\r\n\u001b[?2004l\r"]
[108.902586, "o", "\u001b[?2004h> "]
[108.902662, "o", "        foreign_ids.append(other.ticket_id)\r\n\u001b[?2004l\r"]
[108.902713, "o", "\u001b[?2004h> "]
[108.902742, "o", "    with conn:\r\n\u001b[?2004l\r\u001b[?2004h"]
[108.902799, "o", "> "]
[108.903013, "o", "        conn.executemany(\"UPDATE tickets SET created_at = ?, updated_at = ? WHERE ticket_id = ?\",\r\n\u001b[?2004l\r"]
[108.903053, "o", "\u001b[?2004h> "]
[108.903311, "o", "                         [(\"2090-01-01T00:00:00Z\", \"2090-01-01T00:00:00Z\", tid) for tid in foreign_ids])\r\n\u001b[?2004l\r"]
[108.903358, "o", "\u001b[?2004h> "]
[108.903407, "o", "    service.cache.clear()\r\n\u001b[?2004l\r"]
[108.903472, "o", "\u001b[?2004h"]
[108.903517, "o", ">     relay = RecordingRelay()\r\n\u001b[?2004l\r"]
[108.903558, "o", "\u001b[?2004h> "]
