[147.425936, "i", "python - <<'PY'\nimport json\nimport tempfile\nfrom dataclasses import replace\nfrom pathlib import Path\nfrom unittest.mock import patch\nfrom taskforge.config import load_settings\nfrom taskforge.job_store import JobStore\nfrom taskforge.runner import run_queue\n\nwith tempfile.TemporaryDirectory() as root:\n    root = Path(root)\n    settings = replace(load_settings(), db_path=root / 'jobs.db', failure_log=root / 'failures.jsonl', output_dir=root / 'out')\n    store = JobStore(settings.db_path)\n    store.load_seed(settings.seed_dir)\n    credentials = set()\n    for job in store.list():\n        for key, value in job.context.query.items():\n            if key.lower() == 'api_key':\n                credentials.add(value)\n        for key, value in job.context.headers.items():\n            if key.lower() == 'authorization':\n                credentials.add(value)\n                credentials.add(value.removeprefix('Bearer '))\n    events = []\n    with patch('taskforge.diagnostics.ObservabilityClient.post_events', side_effect=events.extend):\n        summary = run_queue(store, settings)\n    wire = json.dumps(events)\n    assert not any(secret and secret in wire for secret in credentials), 'Credential detected in generated events'\n    assert summary.diagnostics_sent == 7 and summary.diagnostics_errors == []\n    print('Isolated seed run: 7 diagnostic events; no captured authentication credentials in events.')\n    print('Event request parameter names:', sorted({key for event in events for key in event['request']['params']}))\n    store.close()\nPY\n"]
[147.426034, "o", "python - <<'PY'\r\nimport json\r\nimport tempfile\r\nfrom dataclasses import replace\r\nfrom pathlib import Path\r\nfrom unittest.mock import patch\r\nfrom taskforge.config import load_settings\r\nfrom taskforge.job_store import JobStore\r\nfrom taskforge.runner"]
