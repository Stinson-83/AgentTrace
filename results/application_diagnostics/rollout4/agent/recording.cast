[27.169266, "o", "import pytest\r\n\r\nfrom taskforge.models import RequestContext\r\n\r\n\r\ndef test_seed_loads(store):\r\n    assert store.counts() == {\"pending\": 34}\r\n    job = store.get(\"job_0001\")\r\n    assert job.status == \"pending\" and job.attempts == 0 and job.context.account_id.startswith(\"acct_\")\r\n\r\n\r\ndef test_claim_order_and_attempts(store):\r\n    first = store.claim_next()\r\n    assert first is not None and first.status == \"running\" and first.attempts == 1\r\n    assert store.claim_next(\"imports\").queue == \"imports\"\r\n\r\n\r\ndef test_mark_failed_retry_vs_dead(store):\r\n    job = store.claim_next()\r\n    j = store.mark_failed(job.job_id, \"DeliveryError\", \"boom\", \"Traceback...\", final=False)\r\n    assert j.status == \"pending\" and j.last_error_type == \"DeliveryError\"\r\n    j = store.mark_failed(job.job_id, \"DeliveryError\", \"boom\", \"Traceback...\", final=True)\r\n    assert j.status == \"dead\"\r\n\r\n\r\ndef test_enqueue_roundtrip(store):\r\n    ctx = RequestContext(\"req_x\", \"2025-11-10T08:00:00Z\", \"POST\", \"/v2/x\", \"203.0.113.1\", \"acct_test\", {\"user-agent\": \"t\"}, {}, \"{}\")\r\n    job = store.enqueue(\"job_new\", \"report.render\", \"reports\", {\"period\": \"2025-10\", \"rows\": []}, ctx)\r\n    assert job.context == ctx and job.to_dict()[\"context\"][\"route\"] == \"/v2/x\"\r\n    with pytest.raises(KeyError):\r\n        store.get(\"job_missing\")\r\n\r\n\r\ndef test_requeue_dead_job(store):\r\n    job = store.claim_next()\r\n    store.mark_failed(job.job_id, \"DeliveryError\", \"boom\", \"tb\", final=True)\r\n    again = store.requeue(job.job_id)\r\n    assert again.status == \"pending\" and again.attempts == 0 and again.finished_at is None\r\n    with pytest.raises(ValueError):\r\n        store.requeue(store.claim_next().job_id)\r\nimport pytest\r\n\r\nfrom taskforge.handlers import DeliveryError, ImportValidationError, RenderError, UnknownJobType, deliver_webhook, handler_for, import_contacts, render_report\r\nfrom taskforge.models import Job, RequestContext\r\n\r\nCTX = RequestContext(\"req_1\", \"2025-11-10T08:00:00Z\", \"POST\", \"/v2/x\", \"203.0.113.1\", \"acct_test\", {}, {}, \"\")\r\n\r\n\r\ndef _job(job_type, payload):\r\n    return Job(\"job_t\", job_type, \"q\", \"running\", payload, CTX, attempts=1)\r\n\r\n\r\ndef test_webhook_delivery_writes_file(settings):\r\n    res = deliver_webhook(_job(\"webhook.deliver\", {\"url\": \"https://hooks.example/x?token=whk_test\", \"event\": {\"type\": \"a\"}}), settings)\r\n    assert res[\"delivered_to\"] == \"hooks.example\" and (settings.output_dir / \"webhooks\" / \"job_t.json\").exists()\r\n\r\n\r\n@pytest.mark.parametrize(\"payload\", [{\"url\": \"http://plain.example\", \"event\": {\"type\": \"a\"}}, {\"url\": \"https://x.invalid/y\", \"event\": {\"type\": \"a\"}}, {\"url\": \"https://ok.example\", \"event\": {}}])\r\ndef test_webhook_delivery_errors(settings, payload):\r\n    with pytest.raises(DeliveryError):\r\n        deliver_webhook(_job(\"webhook.deliver\", payload), settings)\r\n\r\n\r\ndef test_render_report(settings):\r\n    res = render_report(_job(\"report.render\", {\"report\": \"monthly-usage\", \"period\": \"2025-10\", \"rows\": [{\"metric\": \"a\", \"value\": 1}]}), settings)\r\n    assert res[\"rows\"] == 1 and \"monthly-usage-acct_test-2025-10.csv\" in res[\"path\"]\r\n    with pytest.raises(RenderError):\r\n        render_report(_job(\"report.render\", {\"period\": \"2025/10\"}), settings)\r\n\r\n\r\ndef test_import_contacts(settings):\r\n    good = [{\"name\": \"A\", \"email\": \"a@b.example\"}]\r\n    assert import_contacts(_job(\"contacts.import\", {\"rows\": good}), settings)[\"imported\"] == 1\r\n    with pytest.raises(ImportValidationError):\r\n        import_contacts(_job(\"contacts.import\", {\"rows\": good + [{\"email\": \"nope\"}]}), settings)\r\n    with pytest.raises(ImportValidationError):\r\n        import_contacts(_job(\"contacts.import\", {\"rows\": []}), settings)\r\n\r\n\r\ndef test_unknown_handler():\r\n    with pytest.raises(UnknownJobType):\r\n        handler_for(\"nope\")\r\n\r\n"]
[27.170899, "o", "\"\"\"Job handlers. Each handler takes (job, settings) and returns a result dict or raises.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport json\r\nimport re\r\nfrom datetime import datetime\r\nfrom pathlib import Path\r\nfrom typing import Any, Callable\r\n\r\nfrom .config import Settings\r\nfrom .models import Job\r\n\r\n_EMAIL_RE = re.compile(r\"^[^@\\s]+@[^@\\s]+\\.[a-z]{2,}$\", re.I)\r\n\r\n\r\nclass HandlerError(RuntimeError):\r\n    \"\"\"Base class for job failures that are the job's fault (retryable or not).\"\"\"\r\n\r\n\r\nclass DeliveryError(HandlerError):\r\n    pass\r\n\r\n\r\nclass RenderError(HandlerError):\r\n    pass\r\n\r\n\r\nclass ImportValidationError(HandlerError):\r\n    pass\r\n\r\n\r\ndef _out(settings: Settings, *parts: str) -> Path:\r\n    path = settings.output_dir.joinpath(*parts)\r\n    path.parent.mkdir(parents=True, exist_ok=True)\r\n    return path\r\n\r\n\r\ndef deliver_webhook(job: Job, settings: Settings) -> dict[str, Any]:\r\n    \"\"\"Deliver an outbound webhook. The transport is simulated locally: deliveries are written to\r\n    ``output/webhooks/`` and hosts under ``.invalid`` fail with a connection error.\"\"\"\r\n    url = str(job.payload.get(\"url\", \"\"))\r\n    event = job.payload.get(\"event\")\r\n    if not url.startswith(\"https://\"):\r\n        raise DeliveryError(f\"refusing to deliver to non-https url {url!r}\")\r\n    if not isinstance(event, dict) or \"type\" not in event:\r\n        raise DeliveryError(\"webhook event must be an object with a 'type'\")\r\n    host = url.split(\"/\", 3)[2]\r\n    if host.endswith(\".invalid\"):\r\n        raise DeliveryError(f\"POST {url} failed: name or service not known ({host})\")\r\n    path = _out(settings, \"webhooks\", f\"{job.job_id}.json\")\r\n    path.write_text(json.dumps({\"url\": url, \"event\": event, \"attempt\": job.attempts}, indent=2))\r\n    return {\"delivered_to\": host, \"bytes\": path.stat().st_size}\r\n\r\n\r\ndef render_report(job: Job, settings: Settings) -> dict[str, Any]:\r\n    \"\"\"Render a usage report for an account/period into ``output/reports/``.\"\"\"\r\n    period = str(job.payload.get(\"period\", \"\"))\r\n    try:\r\n        datetime.strptime(period, \"%Y-%m\")\r\n    except ValueError:\r\n        raise RenderError(f\"period must be YYYY-MM, got {period!r}\") from None\r\n"]
[27.171017, "o", "    rows = job.payload.get(\"rows\") or []\r\n    lines = [\"metric,value\"] + [f\"{r['metric']},{r['value']}\" for r in rows]\r\n    path = _out(settings, \"reports\", f\"{job.payload.get('report', 'report')}-{job.context.account_id}-{period}.csv\")\r\n    path.write_text(\"\\n\".join(lines) + \"\\n\")\r\n    return {\"path\": str(path), \"rows\": len(rows)}\r\n\r\n\r\ndef import_contacts(job: Job, settings: Settings) -> dict[str, Any]:\r\n    \"\"\"Validate and store a contact import batch under ``output/imports/``.\"\"\"\r\n    rows = job.payload.get(\"rows\")\r\n    if not isinstance(rows, list) or not rows:\r\n        raise ImportValidationError(\"import batch has no rows\")\r\n    invalid = [i for i, r in enumerate(rows) if not isinstance(r, dict) or not _EMAIL_RE.match(str(r.get(\"email\", \"\")))]\r\n    if invalid:\r\n        raise ImportValidationError(f\"{len(invalid)} of {len(rows)} rows have an invalid e-mail; first bad row {invalid[0]}: {rows[invalid[0]]!r}\")\r\n    path = _out(settings, \"imports\", f\"{job.job_id}.json\")\r\n    path.write_text(json.dumps({\"account_id\": job.context.account_id, \"rows\": rows}, indent=2))\r\n    return {\"imported\": len(rows), \"path\": str(path)}\r\n\r\n\r\nHANDLERS: dict[str, Callable[[Job, Settings], dict[str, Any]]] = {\r\n    \"webhook.deliver\": deliver_webhook,\r\n    \"report.render\": render_report,\r\n    \"contacts.import\": import_contacts,\r\n}\r\n\r\n\r\nclass UnknownJobType(HandlerError):\r\n    pass\r\n\r\n\r\ndef handler_for(job_type: str) -> Callable[[Job, Settings], dict[str, Any]]:\r\n    try:\r\n        return HANDLERS[job_type]\r\n    except KeyError:\r\n        raise UnknownJobType(f\"no handler registered for job type {job_type!r}\") from None\r\n"]
