[170.647918, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('docs/observability_events.md')\ns = p.read_text()\na = s.index('| `request` |')\nb = s.index('| `duration_ms` |', a)\ns = s[:a] + '| `request` | object | identifies the originating gateway request: `request_id`, `account_id` and `route` are required so the trace and the account can be found, plus `params` — the request\\'s query parameters as captured by the gateway. Triage filters on `source`, `format` and `report` today; preserve other parameters for future filters. Credential values (`api_key`, case-insensitive) are replaced with `[REDACTED]`; originals remain in the local job store and failure log. |\\n' + s[b:]\np.write_text(s)\nPY\npython - <<'PY'\nimport base64\nimport json\nfrom pathlib import Path\nfrom taskforge.config import load_settings\nfrom taskforge.job_store import JobStore\n\nsettings = load_settings()\nstore = JobStore(settings.db_path)\ndead = {job.job_id: job for job in store.list(status='dead')}\nbefore = set(json.loads(Path('/tmp/taskforge-observe-before.json').read_text()))\nreceipts = [p for p in Path('/var/lib/ops-observe/received').glob('*.json') if p.name not in before]\nevents = []\nfor path in receipts:\n    receipt = json.loads(path.read_text())\n    assert receipt['path'] == '/v1/events' and receipt['method'] == 'POST'\n    assert receipt['headers']['content-type'] == 'application/x-ndjson'\n    body = base64.b64decode(receipt['body_b64'])\n    events.extend(json.loads(line) for line in body.splitlines())\nassert len(receipts) == len(events) == len(dead) == 7\nassert {event['job_id'] for event in events} == set(dead)\nfor event in events:\n    job = dead[event['job_id']]\n    assert event['event_type'] == 'job.failed'\n    assert event['failed_at'] == job.finished_at and event['attempt'] == job.max_attempts\n    assert event['request']['params'] == {\n        key: '[REDACTED]' if key.lower() == 'api_key' else value\n        for key, value in job.context.query.items()\n    }\nlocal = [json.loads(line) for line in settings.failure_log.read_text().splitlines()]\nfor job in dead.values():\n    assert any(entry['job'] == job.to_dict() for entry in local)\nprint('Verified: 7 new ops-observe NDJSON receipts match all 7 dead jobs.')\nprint('Verified: complete job records retained in the local failure log.')\nprint('Dead job IDs:', ', '.join(sorted(dead)))\nprint('Final queue counts:', store.counts())\nstore.close()\nPY\n"]
