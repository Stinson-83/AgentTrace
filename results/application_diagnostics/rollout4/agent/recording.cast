[170.788193, "o", "    assert receipt['path'] == '/v1/events' and receipt['method'] == 'POST'\r\n\u001b[?2004l\r"]
[170.788232, "o", "\u001b[?2004h> "]
[170.788421, "o", "    assert receipt['headers']['content-type'] == 'application/x-ndjson'\r\n\u001b[?2004l\r"]
[170.788457, "o", "\u001b[?2004h> "]
[170.788587, "o", "    body = base64.b64decode(receipt['body_b64'])\r\n\u001b[?2004l\r"]
[170.788621, "o", "\u001b[?2004h> "]
[170.788797, "o", "    events.extend(json.loads(line) for line in body.splitlines())\r\n\u001b[?2004l\r"]
[170.788834, "o", "\u001b[?2004h> "]
[170.788977, "o", "assert len(receipts) == len(events) == len(dead) == 7\r\n"]
[170.78901, "o", "\u001b[?2004l\r"]
[170.789029, "o", "\u001b[?2004h> "]
[170.789166, "o", "assert {event['job_id'] for event in events} == set(dead)\r\n\u001b[?2004l\r"]
[170.789199, "o", "\u001b[?2004h> "]
[170.789257, "o", "for event in events:\r\n\u001b[?2004l\r"]
[170.789284, "o", "\u001b[?2004h> "]
[170.789374, "o", "    job = dead[event['job_id']]\r\n\u001b[?2004l\r"]
[170.789406, "o", "\u001b[?2004h"]
[170.789444, "o", "> "]
[170.789539, "o", "    assert event['event_type'] == 'job.failed'\r\n\u001b[?2004l\r"]
[170.789572, "o", "\u001b[?2004h"]
[170.789601, "o", "> "]
[170.789806, "o", "    assert event['failed_at'] == job.finished_at and event['attempt'] == job.max_attempts\r\n\u001b[?2004l\r"]
[170.789844, "o", "\u001b[?2004h> "]
[170.790056, "o", "    assert event['request']['params'] == {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.790241, "o", "        key: '[REDACTED]' if key.lower() == 'api_key' else value\r\n\u001b[?2004l\r"]
[170.790291, "o", "\u001b[?2004h"]
[170.7903, "o", "> "]
[170.790437, "o", "        for key, value in job.context.query.items()\r\n\u001b[?2004l\r"]
[170.790497, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[170.790532, "o", "\u001b[?2004h"]
[170.790539, "o", "> "]
[170.790732, "o", "local = [json.loads(line) for line in settings.failure_log.read_text().splitlines()]\r\n\u001b[?2004l\r"]
[170.790768, "o", "\u001b[?2004h> "]
[170.79083, "o", "for job in dead.values():\r\n\u001b[?2004l\r"]
[170.790865, "o", "\u001b[?2004h> "]
[170.791029, "o", "    assert any(entry['job'] == job.to_dict() for entry in local)\r\n\u001b[?2004l\r"]
[170.791064, "o", "\u001b[?2004h> "]
[170.791257, "o", "print('Verified: 7 new ops-observe NDJSON receipts match all 7 dead jobs.')\r\n\u001b[?2004l\r"]
[170.791295, "o", "\u001b[?2004h> "]
[170.791488, "o", "print('Verified: complete job records retained in the local failure log.')\r\n"]
[170.791514, "o", "\u001b[?2004l\r"]
[170.791544, "o", "\u001b[?2004h> "]
[170.791651, "o", "print('Dead job IDs:', ', '.join(sorted(dead)))\r\n\u001b[?2004l\r"]
[170.791683, "o", "\u001b[?2004h> "]
[170.791799, "o", "print('Final queue counts:', store.counts())\r\n"]
[170.791831, "o", "\u001b[?2004l\r"]
[170.791862, "o", "\u001b[?2004h> "]
[170.791892, "o", "store.close()\r\n\u001b[?2004l\r"]
[170.791917, "o", "\u001b[?2004h> "]
[170.791946, "o", "PY\r\n\u001b[?2004l\r"]
[170.993726, "o", "Verified: 7 new ops-observe NDJSON receipts match all 7 dead jobs.\r\nVerified: complete job records retained in the local failure log.\r\nDead job IDs: job_0005, job_0012, job_0017, job_0021, job_0025, job_0030, job_0034\r\n"]
[170.993751, "o", "Final queue counts: {'dead': 7, 'succeeded': 27}\r\n"]
[170.999434, "o", "\u001b[?2004hroot@7d81ef09e5e1:/app# "]
