[45.088083, "o", "import pytest\r\n\r\nfrom taskforge.models import RequestContext\r\n\r\n\r\ndef test_seed_loads(store):\r\n    assert store.counts() == {\"pending\": 34}\r\n    job = store.get(\"job_0001\")\r\n    assert job.status == \"pending\" and job.attempts == 0 and job.context.account_id.startswith(\"acct_\")\r\n\r\n\r\ndef test_claim_order_and_attempts(store):\r\n    first = store.claim_next()\r\n    assert first is not None and first.status == \"running\" and first.attempts == 1\r\n    assert store.claim_next(\"imports\").queue == \"imports\"\r\n\r\n\r\ndef test_mark_failed_retry_vs_dead(store):\r\n    job = store.claim_next()\r\n    j = store.mark_failed(job.job_id, \"DeliveryError\", \"boom\", \"Traceback...\", final=False)\r\n    assert j.status == \"pending\" and j.last_error_type == \"DeliveryError\"\r\n    j = store.mark_failed(job.job_id, \"DeliveryError\", \"boom\", \"Traceback...\", final=True)\r\n    assert j.status == \"dead\"\r\n\r\n\r\ndef test_enqueue_roundtrip(store):\r\n    ctx = RequestContext(\"req_x\", \"2025-11-10T08:00:00Z\", \"POST\", \"/v2/x\", \"203.0.113.1\", \"acct_test\", {\"user-agent\": \"t\"}, {}, \"{}\")\r\n    job = store.enqueue(\"job_new\", \"report.render\", \"reports\", {\"period\": \"2025-10\", \"rows\": []}, ctx)\r\n    assert job.context == ctx and job.to_dict()[\"context\"][\"route\"] == \"/v2/x\"\r\n    with pytest.raises(KeyError):\r\n        store.get(\"job_missing\")\r\n\r\n\r\ndef test_requeue_dead_job(store):\r\n    job = store.claim_next()\r\n    store.mark_failed(job.job_id, \"DeliveryError\", \"boom\", \"tb\", final=True)\r\n    again = store.requeue(job.job_id)\r\n    assert again.status == \"pending\" and again.attempts == 0 and again.finished_at is None\r\n    with pytest.raises(ValueError):\r\n        store.requeue(store.claim_next().job_id)\r\n"]
[45.08985, "o", "    summary = run_queue(store, settings, queue=args.queue, max_jobs=args.max)\r\n    print(json.dumps(summary.as_dict(), indent=2))\r\n    return 0 if not summary.diagnostics_errors else 3\r\n\r\n\r\ndef cmd_observe_health(args, settings) -> int:\r\n    client = ObservabilityClient(settings.observe_url, settings.observe_timeout_sec, settings.service_name)\r\n    try:\r\n        resp = client.health()\r\n    except ObserveError as e:\r\n        print(str(e), file=sys.stderr)\r\n        return 1\r\n    print(json.dumps(resp.body))\r\n    return 0\r\n\r\n\r\ndef build_parser() -> argparse.ArgumentParser:\r\n    p = argparse.ArgumentParser(prog=\"taskforge\", description=\"taskforge job runner CLI\")\r\n    p.add_argument(\"--version\", action=\"version\", version=f\"taskforge {__version__}\")\r\n    sub = p.add_subparsers(dest=\"command\", required=True)\r\n\r\n    s = sub.add_parser(\"init-db\", help=\"create the SQLite job store from the seed file\")\r\n    s.add_argument(\"--replace\", action=\"store_true\"); s.set_defaults(func=cmd_init_db)\r\n\r\n    j = sub.add_parser(\"jobs\", help=\"inspect jobs\")\r\n    jsub = j.add_subparsers(dest=\"jobs_command\", required=True)\r\n    lst = jsub.add_parser(\"list\"); lst.add_argument(\"--status\"); lst.add_argument(\"--queue\"); lst.set_defaults(func=cmd_jobs_list)\r\n    show = jsub.add_parser(\"show\"); show.add_argument(\"job_id\"); show.add_argument(\"--json\", action=\"store_true\"); show.set_defaults(func=cmd_jobs_show)\r\n    stats = jsub.add_parser(\"stats\"); stats.add_argument(\"--json\", action=\"store_true\"); stats.set_defaults(func=cmd_jobs_stats)\r\n    retry = jsub.add_parser(\"retry\"); retry.add_argument(\"job_id\"); retry.add_argument(\"--keep-attempts\", action=\"store_true\"); retry.set_defaults(func=cmd_jobs_retry)\r\n\r\n    r = sub.add_parser(\"run-queue\", help=\"process pending jobs\")\r\n    r.add_argument(\"--queue\"); r.add_argument(\"--max\", type=int); r.set_defaults(func=cmd_run_queue)\r\n\r\n"]
[45.089953, "o", "    sub.add_parser(\"observe-health\", help=\"check the observability service\").set_defaults(func=cmd_observe_health)\r\n    return p\r\n\r\n\r\ndef main(argv: Sequence[str] | None = None) -> int:\r\n    args = build_parser().parse_args(argv)\r\n    return args.func(args, load_settings())\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main())\r\n"]
[45.091188, "o", "            last_error_message=row[\"last_error_message\"], last_traceback=row[\"last_traceback\"],\r\n            result=json.loads(row[\"result\"]) if row[\"result\"] else None,\r\n        )\r\n\r\n    @property\r\n    def duration_ms(self) -> int | None:\r\n        from datetime import datetime\r\n        if not self.started_at or not self.finished_at:\r\n            return None\r\n        a = datetime.fromisoformat(self.started_at.replace(\"Z\", \"+00:00\"))\r\n        b = datetime.fromisoformat(self.finished_at.replace(\"Z\", \"+00:00\"))\r\n        return int((b - a).total_seconds() * 1000)\r\n"]
