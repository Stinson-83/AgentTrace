[7.722515, "o", "__init__.py  __pycache__  cli.py  config.py  diagnostics.py  handlers.py  job_store.py\tmodels.py  observability_client.py  runner.py\r\n\r\ntests:\r\n__pycache__  conftest.py  test_handlers.py  test_runner.py  test_store.py\r\n"]
[7.724079, "o", "\"\"\"Failure diagnostics for the engineering observability service (ops-observe).\r\n\r\nSee docs/observability_events.md for the event contract.\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport re\r\nfrom typing import Any\r\n\r\nfrom .config import Settings\r\nfrom .models import Job\r\n\r\n_FRAME_RE = re.compile(r'^\\s*File \"(?P<file>[^\"]+)\", line (?P<line>\\d+), in (?P<function>\\S+)')\r\n\r\n\r\ndef stack_summary(traceback_text: str, frames: int = 5) -> list[dict[str, Any]]:\r\n    \"\"\"The innermost ``frames`` frames of a formatted traceback as (file, line, function) entries,\r\n    innermost last. Only frame locations — never locals or source.\"\"\"\r\n    found = []\r\n    for line in traceback_text.splitlines():\r\n        m = _FRAME_RE.match(line)\r\n        if m:\r\n            found.append({\"file\": m.group(\"file\").split(\"/\")[-1], \"line\": int(m.group(\"line\")), \"function\": m.group(\"function\")})\r\n"]
[7.724165, "o", "    return found[-frames:]\r\n\r\n\r\ndef truncate(text: str | None, limit: int = 500) -> str:\r\n    text = text or \"\"\r\n    return text if len(text) <= limit else text[: limit - 1] + \"…\"\r\n\r\n\r\ndef report_failure(job: Job, exc: BaseException, traceback_text: str, settings: Settings) -> dict[str, Any]:\r\n    \"\"\"Build the ``job.failed`` diagnostic event for a job that has exhausted its attempts and\r\n    send it to ops-observe. Returns the event that was sent.\r\n\r\n    Not implemented yet — see ticket TF-642.\r\n    \"\"\"\r\n    raise NotImplementedError(\"failure diagnostics are not wired up yet (TF-642)\")\r\n"]
[7.724241, "o", "\"\"\"HTTP client for the engineering observability service (ops-observe).\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport json\r\nimport urllib.error\r\nimport urllib.request\r\nfrom dataclasses import dataclass\r\nfrom typing import Any\r\n\r\n\r\nclass ObserveError(RuntimeError):\r\n    pass\r\n\r\n\r\n@dataclass\r\nclass ObserveResponse:\r\n    status: int\r\n    body: dict[str, Any]\r\n\r\n\r\nclass ObservabilityClient:\r\n    \"\"\"Sends newline-delimited JSON events to ``POST /v1/events``.\"\"\"\r\n\r\n    def __init__(self, base_url: str, timeout_sec: float = 10.0, service_name: str = \"taskforge\"):\r\n        self.base_url = base_url.rstrip(\"/\")\r\n        self.timeout_sec = timeout_sec\r\n        self.service_name = service_name\r\n\r\n    def post_events(self, events: list[dict[str, Any]]) -> ObserveResponse:\r\n        if not events:\r\n            raise ObserveError(\"no events to send\")\r\n        body = \"\\n\".join(json.dumps(e, separators=(\",\", \":\")) for e in events) + \"\\n\"\r\n        req = urllib.request.Request(\r\n            self.base_url + \"/v1/events\", data=body.encode(\"utf-8\"), method=\"POST\",\r\n            headers={\"Content-Type\": \"application/x-ndjson\", \"X-Service\": self.service_name, \"Accept\": \"application/json\"},\r\n        )\r\n        try:\r\n            with urllib.request.urlopen(req, timeout=self.timeout_sec) as resp:\r\n                raw = resp.read().decode(\"utf-8\")\r\n                return ObserveResponse(resp.status, json.loads(raw) if raw else {})\r\n        except urllib.error.HTTPError as e:\r\n            raise ObserveError(f\"ops-observe rejected events ({e.code}): {e.read().decode('utf-8', 'replace')}\") from e\r\n        except urllib.error.URLError as e:\r\n            raise ObserveError(f\"ops-observe unreachable at {self.base_url}: {e.reason}\") from e\r\n\r\n    def health(self) -> ObserveResponse:\r\n        try:\r\n"]
[7.724307, "o", "            with urllib.request.urlopen(self.base_url + \"/healthz\", timeout=self.timeout_sec) as resp:\r\n                return ObserveResponse(resp.status, json.loads(resp.read().decode(\"utf-8\")))\r\n        except urllib.error.URLError as e:\r\n            raise ObserveError(f\"ops-observe unreachable at {self.base_url}: {e.reason}\") from e\r\n"]
