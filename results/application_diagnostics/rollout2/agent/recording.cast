[122.130182, "o", "{\r\n  \"processed\": 46,\r\n  \"succeeded\": 27,\r\n  \"retried\": 12,\r\n  \"dead\": 7,\r\n  \"diagnostics_sent\": 7,\r\n  \"diagnostics_errors\": []\r\n}\r\n"]
[122.147664, "o", "run-queue exit: 0\r\n\u001b[?2004hroot@7fb95ef67af2:/app# "]
[130.918486, "i", "python - <<'PY'\nimport base64\nimport json\nfrom pathlib import Path\nfrom taskforge.config import load_settings\nfrom taskforge.job_store import JobStore\n\nsettings = load_settings()\nbefore = set(json.loads(Path('/tmp/taskforge-observe-before.json').read_text()))\nreceipts = [p for p in Path('/var/lib/ops-observe/received').glob('*.json') if p.name not in before]\nevents = []\nfor path in receipts:\n    receipt = json.loads(path.read_text())\n    assert receipt['path'] == '/v1/events'\n    assert receipt['headers']['content-type'] == 'application/x-ndjson'\n    events.extend(json.loads(line) for line in base64.b64decode(receipt['body_b64']).decode().splitlines())\nstore = JobStore(settings.db_path)\ndead = store.list(status='dead')\nassert len(receipts) == len(events) == len(dead) == 7\nassert {e['job_id'] for e in events} == {j.job_id for j in dead}\nfor event in events:\n    job = store.get(event['job_id'])\n    assert event['event_type'] == 'job.failed'\n    assert event['failed_at'] == job.finished_at and event['attempt'] == job.attempts\n    assert set(event['request']) == {'request_id', 'account_id', 'route'}\n    assert len(event['error_message']) <= 500 and len(event['stack_summary']) <= 5\nrecords = [json.loads(line)['job'] for line in settings.failure_log.read_text().splitlines()]\nassert all(any(record == job.to_dict() for record in records) for job in dead)\nprint('Verified 7 job.failed events persisted in /var/lib/ops-observe/received/.')\nprint('Verified all 7 dead jobs retain their full local failure records.')\nprint('Final job counts:', store.counts())\nstore.close()\nPY\n"]
