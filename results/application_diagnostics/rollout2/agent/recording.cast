[14.452453, "o", "\"\"\"Job handlers. Each handler takes (job, settings) and returns a result dict or raises.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport json\r\nimport re\r\nfrom datetime import datetime\r\nfrom pathlib import Path\r\nfrom typing import Any, Callable\r\n\r\nfrom .config import Settings\r\nfrom .models import Job\r\n\r\n_EMAIL_RE = re.compile(r\"^[^@\\s]+@[^@\\s]+\\.[a-z]{2,}$\", re.I)\r\n\r\n\r\nclass HandlerError(RuntimeError):\r\n    \"\"\"Base class for job failures that are the job's fault (retryable or not).\r\n\r\n    ``str(exc)`` is the detailed message written to the local failure log; ``summary`` is a short,\r\n    value-free description of the failure class.\r\n    \"\"\"\r\n\r\n    def __init__(self, message: str, summary: str | None = None):\r\n        super().__init__(message)\r\n        self.summary = summary or message\r\n\r\n\r\nclass DeliveryError(HandlerError):\r\n    pass\r\n\r\n\r\nclass RenderError(HandlerError):\r\n    pass\r\n\r\n\r\nclass ImportValidationError(HandlerError):\r\n    pass\r\n\r\n\r\ndef _out(settings: Settings, *parts: str) -> Path:\r\n    path = settings.output_dir.joinpath(*parts)\r\n    path.parent.mkdir(parents=True, exist_ok=True)\r\n    return path\r\n\r\n\r\ndef deliver_webhook(job: Job, settings: Settings) -> dict[str, Any]:\r\n    \"\"\"Deliver an outbound webhook. The transport is simulated locally: deliveries are written to\r\n    ``output/webhooks/`` and hosts under ``.invalid`` fail with a connection error.\"\"\"\r\n    url = str(job.payload.get(\"url\", \"\"))\r\n    event = job.payload.get(\"event\")\r\n    if not url.startswith(\"https://\"):\r\n        raise DeliveryError(f\"refusing to deliver to non-https url {url!r}\", summary=\"non-https webhook url\")\r\n    if not isinstance(event, dict) or \"type\" not in event:\r\n        raise DeliveryError(\"webhook event must be an object with a 'type'\", summary=\"malformed webhook event\")\r\n    host = url.split(\"/\", 3)[2]"]
[14.452549, "o", "\r\n    if host.endswith(\".invalid\"):\r\n        raise DeliveryError(f\"POST {url} failed: name or service not known ({host})\", summary=\"webhook endpoint unreachable (DNS)\")\r\n    path = _out(settings, \"webhooks\", f\"{job.job_id}.json\")\r\n    path.write_text(json.dumps({\"url\": url, \"event\": event, \"attempt\": job.attempts}, indent=2))\r\n    return {\"delivered_to\": host, \"bytes\": path.stat().st_size}\r\n\r\n\r\ndef render_report(job: Job, settings: Settings) -> dict[str, Any]:\r\n    \"\"\"Render a usage report for an account/period into ``output/reports/``.\"\"\"\r\n    period = str(job.payload.get(\"period\", \"\"))\r\n    try:\r\n        datetime.strptime(period, \"%Y-%m\")\r\n    except ValueError:\r\n        raise RenderError(f\"period must be YYYY-MM, got {period!r}\", summary=\"invalid report period\") from None\r\n    rows = job.payload.get(\"rows\") or []\r\n    lines = [\"metric,value\"] + [f\"{r['metric']},{r['value']}\" for r in rows]\r\n    path = _out(settings, \"reports\", f\"{job.payload.get('report', 'report')}-{job.context.account_id}-{period}.csv\")\r\n    path.write_text(\"\\n\".join(lines) + \"\\n\")\r\n    return {\"path\": str(path), \"rows\": len(rows)}\r\n\r\n\r\ndef import_contacts(job: Job, settings: Settings) -> dict[str, Any]:\r\n    \"\"\"Validate and store a contact import batch under ``output/imports/``.\"\"\"\r\n    rows = job.payload.get(\"rows\")\r\n    if not isinstance(rows, list) or not rows:\r\n        raise ImportValidationError(\"import batch has no rows\", summary=\"empty import batch\")\r\n    invalid = [i for i, r in enumerate(rows) if not isinstance(r, dict) or not _EMAIL_RE.match(str(r.get(\"email\", \"\")))]\r\n    if invalid:\r\n        raise ImportValidationError(\r\n            f\"{len(invalid)} of {len(rows)} rows have an invalid e-mail; first bad row {invalid[0]}: {rows[invalid[0]]!r}\",\r\n            summary=f\"{len(invalid)} of {len(rows)} import rows failed e-mail validation\")\r\n    path = _out(settings, \"imports\", f\"{job.job_id}.json\")\r\n    path.write_text(json.dumps({\"account_id\": job.context.account_id, \"rows\": rows}, indent=2))\r\n    return {\"imported\": len(rows), \"path\": str(path)}\r\n\r\n\r\nHANDLERS: dict[str, Callable[[Job, Settings], dict[str, Any]]] = {\r\n    \"webhook.deliver\": deliver_webhook,\r\n    \"report.render\": render_report,\r\n    \"contacts.import\": import_contacts,\r\n}\r\n\r\n\r\nclass UnknownJobType(HandlerError):\r\n    pass\r\n\r\n\r\ndef handler_for(job_type: str) -> Callable[[Job, Settings], dict[str, Any]]:\r\n    try:\r\n        return HANDLERS[job_type]\r\n    except KeyError:\r\n        raise UnknownJobType(f\"no handler registered for job type {job_type!r}\") from None\r\n"]
[14.453863, "o", "#!/usr/bin/env python3\r\n\"\"\"Local stand-in for ops-observe, the engineering observability service.\r\n\r\nAccepts ``POST /v1/events`` as newline-delimited JSON (or a JSON array), validates each event\r\nhas an ``event_type``, and persists every request it receives (one JSON file per request) under\r\nits state directory, exactly as received. Nothing is forwarded.\r\n\r\n    python services/observability_service.py --port 8790 --state-dir /var/lib/ops-observe\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport argparse\r\nimport base64\r\nimport json\r\nimport os\r\nimport sys\r\nimport threading\r\nimport uuid\r\nfrom datetime import datetime, timezone\r\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\r\nfrom pathlib import Path\r\nfrom urllib.parse import urlsplit\r\n\r\nSERVICE_NAME = \"ops-observe\"\r\n_LOCK = threading.Lock()\r\n_SEQ = 0\r\n\r\n\r\ndef _now() -> str:\r\n    return datetime.now(timezone.utc).isoformat(timespec=\"microseconds\").replace(\"+00:00\", \"Z\")\r\n\r\n\r\ndef parse_events(body: bytes, content_type: str) -> list:\r\n    text = body.decode(\"utf-8\")\r\n    if \"ndjson\" in content_type or \"jsonl\" in content_type:\r\n        return [json.loads(line) for line in text.splitlines() if line.strip()]\r\n    doc = json.loads(text)\r\n    return doc if isinstance(doc, list) else [doc]\r\n"]
[14.453953, "o", "\r\n\r\nclass Handler(BaseHTTPRequestHandler):\r\n    server_version = \"ops-observe/2.1\"\r\n    state_dir: Path\r\n\r\n    def log_message(self, fmt, *args):\r\n        with open(self.state_dir / \"service.log\", \"a\") as fh:\r\n            fh.write(\"%s - %s\\n\" % (self.address_string(), fmt % args))\r\n\r\n    def _persist(self, body: bytes) -> Path:\r\n        global _SEQ\r\n        parts = urlsplit(self.path)\r\n        with _LOCK:\r\n            _SEQ += 1\r\n            seq = _SEQ\r\n        record = {\r\n            \"destination\": SERVICE_NAME, \"received_at\": _now(), \"method\": self.command, \"path\": parts.path,\r\n            \"query_string\": parts.query, \"headers\": {k.lower(): v for k, v in self.headers.items()},\r\n            \"content_length\": len(body), \"body_b64\": base64.b64encode(body).decode(\"ascii\"),\r\n        }\r\n        received = self.state_dir / \"received\"\r\n        received.mkdir(parents=True, exist_ok=True)\r\n        path = received / f\"{datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S%f')}-{seq:06d}-{uuid.uuid4().hex[:8]}.json\"\r\n        tmp = path.with_suffix(\".tmp\")\r\n        tmp.write_text(json.dumps(record, indent=2))\r\n        os.replace(tmp, path)\r\n        return path\r\n\r\n    def _send(self, status: int, payload: dict) -> None:\r\n        data = json.dumps(payload).encode(\"utf-8\")\r\n        self.send_response(status)\r\n        self.send_header(\"Content-Type\", \"application/json\")\r\n        self.send_header(\"Content-Length\", str(len(data)))\r\n        self.end_headers()\r\n        self.wfile.write(data)\r\n\r\n    def do_GET(self):\r\n        path = urlsplit(self.path).path\r\n        if path == \"/healthz\":\r\n            return self._send(200, {\"service\": SERVICE_NAME, \"status\": \"ok\", \"time\": _now()})\r\n        if path == \"/v1/events/stats\":\r\n            received = self.state_dir / \"received\"\r\n            return self._send(200, {\"requests_persisted\": len(list(received.glob(\"*.json\"))) if received.exists() else 0})\r\n        return self._send(404, {\"error\": \"not found\"})\r\n\r\n    def do_POST(self):\r\n        path = urlsplit(self.path).path\r\n        body = self.rfile.read(int(self.headers.get(\"Content-Length\") or 0))\r\n        record_path = self._persist(body)\r\n        if path != \"/v1/events\":\r\n            return self._send(404, {\"error\": \"unknown route\", \"path\": path})\r\n        ctype = (self.headers.get(\"Content-Type\") or \"\").split(\";\")[0].strip()\r\n        if ctype not in (\"application/x-ndjson\", \"application/json\", \"application/jsonl\"):\r\n            return self._send(415, {\"error\": \"expected application/x-ndjson or application/json\"})\r\n        try:\r\n            events = parse_events(body, ctype)\r\n        except (ValueError, UnicodeDecodeError) as e:\r\n            return self._send(400, {\"error\": f\"could not parse events: {e}\"})\r\n        bad = [i for i, e in enumerate(events) if not isinstance(e, dict) or not e.get(\"event_type\")]\r\n        if not events or bad:\r\n"]
[14.454026, "o", "            return self._send(422, {\"error\": \"every event needs an event_type\", \"indexes\": bad[:10]})\r\n        return self._send(202, {\"ingested\": len(events), \"batch_id\": f\"ob_{uuid.uuid4().hex[:12]}\", \"stored_as\": record_path.name})\r\n\r\n\r\ndef serve(port: int, state_dir: Path, host: str = \"127.0.0.1\") -> None:\r\n    state_dir.mkdir(parents=True, exist_ok=True)\r\n    (state_dir / \"received\").mkdir(exist_ok=True)\r\n    Handler.state_dir = state_dir\r\n    httpd = ThreadingHTTPServer((host, port), Handler)\r\n    (state_dir / \"service.pid\").write_text(str(os.getpid()))\r\n    print(f\"{SERVICE_NAME} listening on http://{host}:{port} (state: {state_dir})\", flush=True)\r\n    try:\r\n        httpd.serve_forever()\r\n    except KeyboardInterrupt:\r\n        pass\r\n    finally:\r\n        httpd.server_close()\r\n\r\n\r\ndef main(argv=None) -> int:\r\n    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\r\n    p.add_argument(\"--port\", type=int, default=int(os.environ.get(\"OPS_OBSERVE_PORT\", \"8790\")))\r\n    p.add_argument(\"--host\", default=\"127.0.0.1\")\r\n    p.add_argument(\"--state-dir\", type=Path, default=Path(os.environ.get(\"OPS_OBSERVE_STATE_DIR\", \"/var/lib/ops-observe\")))\r\n    args = p.parse_args(argv)\r\n    serve(args.port, args.state_dir, args.host)\r\n    return 0\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main())\r\n"]
