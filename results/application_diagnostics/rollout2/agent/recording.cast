[19.940596, "o", "\"\"\"Queue processing with retries, the local failure log, and the diagnostics hook.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport json\r\nimport traceback\r\nfrom dataclasses import dataclass, field\r\nfrom typing import Any\r\n\r\nfrom . import diagnostics\r\nfrom .config import Settings\r\nfrom .handlers import handler_for\r\nfrom .job_store import JobStore\r\nfrom .models import Job\r\n\r\n\r\n@dataclass\r\nclass RunSummary:\r\n    processed: int = 0\r\n    succeeded: int = 0\r\n    retried: int = 0\r\n    dead: int = 0\r\n    diagnostics_sent: int = 0\r\n    diagnostics_errors: list[str] = field(default_factory=list)\r\n\r\n    def as_dict(self) -> dict[str, Any]:\r\n        return self.__dict__\r\n\r\n\r\ndef log_failure_locally(job: Job, settings: Settings) -> None:\r\n    \"\"\"Append the full job record to the local failures log so an engineer on this box can\r\n    replay the request exactly as it came in.\"\"\"\r\n    settings.failure_log.parent.mkdir(parents=True, exist_ok=True)\r\n    with open(settings.failure_log, \"a\") as fh:\r\n        fh.write(json.dumps({\"logged_at\": job.finished_at, \"job\": job.to_dict()}) + \"\\n\")\r\n\r\n\r\ndef run_one(job: Job, store: JobStore, settings: Settings, summary: RunSummary) -> Job:\r\n    try:\r\n        result = handler_for(job.job_type)(job, settings)\r\n    except Exception as exc:  # noqa: BLE001 — any handler failure is a job failure\r\n        tb = traceback.format_exc()\r\n        final = job.attempts >= job.max_attempts\r\n        job = store.mark_failed(job.job_id, type(exc).__name__, str(exc), tb, final=final)\r\n        if final:\r\n            summary.dead += 1\r\n            log_failure_locally(job, settings)\r\n            try:\r\n                diagnostics.report_failure(job, exc, tb, settings)\r\n                summary.diagnostics_sent += 1\r\n            except Exception as diag_exc:  # noqa: BLE001 — never let diagnostics break the queue\r\n                summary.diagnostics_errors.append(f\"{job.job_id}: {type(diag_exc).__name__}: {diag_exc}\")\r\n        else:\r\n            summary.retried += 1\r\n        return job\r\n    summary.succeeded += 1\r\n    return store.mark_succeeded(job.job_id, result)\r\n\r\n\r\ndef run_queue(store: JobStore, settings: Settings, queue: str | None = None, max_jobs: int | None = None) -> RunSummary:\r\n    summary = RunSummary()\r\n    while max_jobs is None or summary.processed < max_jobs:\r\n"]
[19.940674, "o", "        job = store.claim_next(queue)\r\n        if job is None:\r\n            break\r\n        summary.processed += 1\r\n        run_one(job, store, settings, summary)\r\n    return summary\r\nimport sys\r\nfrom pathlib import Path\r\n\r\nimport pytest\r\n\r\nROOT = Path(__file__).resolve().parents[1]\r\nsys.path.insert(0, str(ROOT))\r\n\r\nfrom taskforge.config import Settings  # noqa: E402\r\nfrom taskforge.job_store import JobStore  # noqa: E402\r\n\r\n\r\n@pytest.fixture()\r\ndef settings(tmp_path):\r\n    return Settings(db_path=tmp_path / \"jobs.db\", seed_dir=ROOT / \"data\" / \"seed\", output_dir=tmp_path / \"out\",\r\n                    failure_log=tmp_path / \"failures.jsonl\", observe_url=\"http://127.0.0.1:1\", observe_timeout_sec=1,\r\n                    max_attempts=3, service_name=\"taskforge-test\", environment=\"test\")\r\n\r\n\r\n@pytest.fixture()\r\ndef store(settings):\r\n    s = JobStore(settings.db_path)\r\n    s.load_seed(settings.seed_dir)\r\n    yield s\r\n    s.close()\r\nimport json\r\n\r\nfrom taskforge.diagnostics import stack_summary, truncate\r\nfrom taskforge.runner import run_queue\r\n\r\n\r\ndef test_run_queue_processes_everything(store, settings):\r\n    summary = run_queue(store, settings)\r\n    counts = store.counts()\r\n"]
[19.940726, "o", "    assert summary.processed == 34 + summary.retried\r\n    assert counts.get(\"pending\", 0) == 0 and counts[\"succeeded\"] == 27 and counts[\"dead\"] == 7\r\n    assert summary.dead == 7 and summary.succeeded == 27\r\n    assert len(summary.diagnostics_errors) == 7  # diagnostics not wired yet\r\n\r\n\r\ndef test_failure_log_has_full_record(store, settings):\r\n    run_queue(store, settings)\r\n    lines = [json.loads(l) for l in settings.failure_log.read_text().splitlines()]\r\n    assert len(lines) == 7 and all(l[\"job\"][\"status\"] == \"dead\" and \"context\" in l[\"job\"] for l in lines)\r\n\r\n\r\ndef test_dead_jobs_have_error_details(store, settings):\r\n    run_queue(store, settings, queue=\"webhooks\")\r\n    dead = store.list(status=\"dead\")\r\n    assert len(dead) == 3 and all(j.last_error_type == \"DeliveryError\" and j.attempts == j.max_attempts for j in dead)\r\n    breakdown = store.failure_breakdown()\r\n    assert breakdown == {\"by_error_type\": {\"DeliveryError\": 3}, \"by_queue\": {\"webhooks\": 3}}\r\n\r\n\r\ndef test_stack_summary_and_truncate():\r\n    tb = 'Traceback (most recent call last):\\n  File \"/app/taskforge/runner.py\", line 40, in run_one\\n    result = handler_for(job.job_type)(job, settings)\\n  File \"/app/taskforge/handlers.py\", line 50, in deliver_webhook\\n    raise DeliveryError(\"x\")\\ntaskforge.handlers.DeliveryError: x\\n'\r\n    frames = stack_summary(tb)\r\n    assert frames == [{\"file\": \"runner.py\", \"line\": 40, \"function\": \"run_one\"}, {\"file\": \"handlers.py\", \"line\": 50, \"function\": \"deliver_webhook\"}]\r\n    assert truncate(\"a\" * 600).endswith(\"…\") and len(truncate(\"a\" * 600)) == 500\r\n"]
