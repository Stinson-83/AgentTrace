[107.010278, "o", "\u001b[?2004h> "]
[107.010321, "o", "s = p.read_text()\r\n\u001b[?2004l\r"]
[107.010353, "o", "\u001b[?2004h> "]
[107.010443, "o", "s += '''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.010566, "o", "## Diagnostic data boundary\r\n\u001b[?2004l\r\u001b[?2004h"]
[107.010625, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.01082, "o", "The worker sends only `request_id`, `account_id`, and `route` from the stored request context.\r\n\u001b[?2004l\r"]
[107.010902, "o", "\u001b[?2004h> "]
[107.011122, "o", "Headers, query values, body previews, client IPs, and job payloads remain local. `error_message`\r\n\u001b[?2004l\r"]
[107.011306, "o", "\u001b[?2004h> "]
[107.011408, "o", "uses the handler's value-free `summary` (or the exception class name for unexpected exceptions),\r\n\u001b[?2004l\r"]
[107.011439, "o", "\u001b[?2004h> "]
[107.011707, "o", "truncated to 500 characters. Stack entries contain locations only, not source or exception text.\r\n\u001b[?2004l\r"]
[107.011756, "o", "\u001b[?2004h> "]
[107.011975, "o", "The detailed error and full request context remain in the local failure log for replay/debugging.\r\n\u001b[?2004l\r"]
[107.012003, "o", "\u001b[?2004h> "]
[107.012031, "o", "'''\r\n\u001b[?2004l\r\u001b[?2004h"]
[107.01206, "o", "> "]
