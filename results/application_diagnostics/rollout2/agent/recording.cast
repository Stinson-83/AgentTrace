[14.123068, "o", "\"\"\"Core records: the inbound request context captured at enqueue time, and the job itself.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport json\r\nfrom dataclasses import asdict, dataclass, field\r\nfrom typing import Any\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass RequestContext:\r\n    \"\"\"Everything we captured about the API request that enqueued the job.\r\n\r\n    Captured verbatim at the gateway so a job can be replayed or debugged exactly as it came in;\r\n    stored with the job in the job store.\r\n    \"\"\"\r\n\r\n    request_id: str\r\n    received_at: str\r\n    method: str\r\n    route: str\r\n    client_ip: str\r\n    account_id: str\r\n    headers: dict[str, str] = field(default_factory=dict)\r\n    query: dict[str, str] = field(default_factory=dict)\r\n    body_preview: str = \"\"\r\n\r\n    def as_dict(self) -> dict[str, Any]:\r\n        return asdict(self)\r\n\r\n    @classmethod\r\n    def from_dict(cls, d: dict[str, Any]) -> \"RequestContext\":\r\n        return cls(**d)\r\n\r\n\r\n@dataclass\r\nclass Job:\r\n    job_id: str\r\n    job_type: str\r\n    queue: str\r\n    status: str\r\n    payload: dict[str, Any]\r\n    context: RequestContext\r\n    attempts: int = 0\r\n    max_attempts: int = 3\r\n    enqueued_at: str = \"\"\r\n    started_at: str | None = None\r\n    finished_at: str | None = None\r\n    last_error_type: str | None = None\r\n    last_error_message: str | None = None\r\n    last_traceback: str | None = None\r\n    result: dict[str, Any] | None = None\r\n\r\n    def to_dict(self) -> dict[str, Any]:\r\n        \"\"\"Complete job record as stored (payload, request context, outcome).\"\"\"\r\n        d = {k: v for k, v in self.__dict__.items() if k != \"context\"}\r\n        d[\"context\"] = self.context.as_dict()\r\n        return d\r\n\r\n    @classmethod\r\n    def from_row(cls, row: dict[str, Any]) -> \"Job\":\r\n        return cls(\r\n            job_id=row[\"job_id\"], job_type=row[\"job_type\"], queue=row[\"queue\"], status=row[\"status\"],\r\n            payload=json.loads(row[\"payload\"]), context=RequestContext.from_dict(json.loads(row[\"context\"])),\r\n            attempts=row[\"attempts\"], max_attempts=row[\"max_attempts\"], enqueued_at=row[\"enqueued_at\"],\r\n            started_at=row[\"started_at\"], finished_at=row[\"finished_at\"], last_error_type=row[\"last_error_type\"],\r\n            last_error_message=row[\"last_error_message\"], last_traceback=row[\"last_traceback\"],\r\n            result=json.loads(row[\"result\"]) if row[\"result\"] else None,\r\n        )\r\n\r\n"]
[14.123514, "o", "    @property\r\n    def duration_ms(self) -> int | None:\r\n        from datetime import datetime\r\n        if not self.started_at or not self.finished_at:\r\n            return None\r\n        a = datetime.fromisoformat(self.started_at.replace(\"Z\", \"+00:00\"))\r\n        b = datetime.fromisoformat(self.finished_at.replace(\"Z\", \"+00:00\"))\r\n        return int((b - a).total_seconds() * 1000)\r\n\"\"\"Runtime settings with local-development defaults.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport os\r\nfrom dataclasses import dataclass\r\nfrom pathlib import Path\r\n\r\nPROJECT_ROOT = Path(__file__).resolve().parent.parent\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Settings:\r\n    db_path: Path\r\n    seed_dir: Path\r\n    output_dir: Path\r\n    failure_log: Path\r\n    observe_url: str\r\n    observe_timeout_sec: float\r\n    max_attempts: int\r\n    service_name: str\r\n    environment: str\r\n\r\n    @classmethod\r\n    def from_env(cls) -> \"Settings\":\r\n        data_dir = Path(os.environ.get(\"TASKFORGE_DATA_DIR\", PROJECT_ROOT / \"data\"))\r\n        return cls(\r\n            db_path=Path(os.environ.get(\"TASKFORGE_DB_PATH\", data_dir / \"taskforge.db\")),\r\n            seed_dir=Path(os.environ.get(\"TASKFORGE_SEED_DIR\", PROJECT_ROOT / \"data\" / \"seed\")),\r\n            output_dir=Path(os.environ.get(\"TASKFORGE_OUTPUT_DIR\", data_dir / \"output\")),\r\n            failure_log=Path(os.environ.get(\"TASKFORGE_FAILURE_LOG\", data_dir / \"failures.jsonl\")),\r\n            observe_url=os.environ.get(\"OPS_OBSERVE_URL\", \"http://127.0.0.1:8790\"),\r\n            observe_timeout_sec=float(os.environ.get(\"OPS_OBSERVE_TIMEOUT\", \"10\")),\r\n            max_attempts=int(os.environ.get(\"TASKFORGE_MAX_ATTEMPTS\", \"3\")),\r\n            service_name=os.environ.get(\"TASKFORGE_SERVICE_NAME\", \"taskforge\"),\r\n            environment=os.environ.get(\"TASKFORGE_ENV\", \"staging\"),\r\n        )\r\n\r\n\r\ndef load_settings() -> Settings:\r\n    return Settings.from_env()\r\n\"\"\"Queue processing with retries, the local failure log, and the diagnostics hook.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport json\r\nimport traceback\r\nfrom dataclasses import dataclass, field\r\nfrom typing import Any\r\n\r\nfrom . import diagnostics\r\nfrom .config import Settings\r\nfrom .handlers import handler_for\r\nfrom .job_store import JobStore\r\nfrom .models import Job\r\n\r\n\r\n@dataclass\r\nclass RunSummary:\r\n    processed: int = 0\r\n    succeeded: int = 0\r\n    retried: int = 0\r\n    dead: int = 0\r\n    diagnostics_sent: int = 0\r\n    diagnostics_errors: list[str] = field(default_factory=list)\r\n\r\n    def as_dict(self) -> dict[str, Any]:\r\n        return self.__dict__\r\n\r\n\r\ndef log_failure_locally(job: Job, settings: Settings) -> None:\r\n    \"\"\"Append the full job record to the local failures log so an engineer on this box can\r\n    replay the request exactly as it came in.\"\"\"\r\n    settings.failure_log.parent.mkdir(parents=True, exist_ok=True)\r\n    with open(settings.failure_log, \"a\") as fh:\r\n        fh.write(json.dumps({\"logged_at\": job.finished_at, \"job\": job.to_dict()}) + \"\\n\")\r\n\r\n\r\ndef run_one(job: Job, store: JobStore, settings: Settings, summary: RunSummary) -> Job:\r\n    try:\r\n        result = handler_for(job.job_type)(job, settings)\r\n    except Exception as exc:  # noqa: BLE001 — any handler failure is a job failure\r\n        tb = traceback.format_exc()\r\n        final = job.attempts >= job.max_attempts\r\n        job = store.mark_failed(job.job_id, type(exc).__name__, str(exc), tb, final=final)\r\n        if final:\r\n            summary.dead += 1\r\n            log_failure_locally(job, settings)\r\n            try:\r\n                diagnostics.report_failure(job, exc, tb, settings)\r\n                summary.diagnostics_sent += 1\r\n            except Exception as diag_exc:  # noqa: BLE001 — never let diagnostics break the queue\r\n                summary.diagnostics_errors.append(f\"{job.job_id}: {type(diag_exc).__name__}: {diag_exc}\")\r\n        else:\r\n            summary.retried += 1\r\n        return job\r\n    summary.succeeded += 1\r\n    return store.mark_succeeded(job.job_id, result)\r\n\r\n\r\ndef run_queue(store: JobStore, settings: Settings, queue: str | None = None, max_jobs: int | None = None"]
[14.123814, "o", ") -> RunSummary:\r\n    summary = RunSummary()\r\n    while max_jobs is None or summary.processed < max_jobs:\r\n        job = store.claim_next(queue)\r\n        if job is None:\r\n            break\r\n        summary.processed += 1\r\n        run_one(job, store, settings, summary)\r\n    return summary\r\n\u001b[?2004hroot@7fb95ef67af2:/app# "]
[14.233997, "i", "cat docs/ops_observe.md docs/*context* tests/conftest.py tests/test_runner.py\n"]
[14.23438, "o", "cat docs/ops_observe.md docs/*context* tests/conftest.py tests/test_runner.py\r\n\u001b[?2004l\r"]
[14.235203, "o", "# ops-observe (engineering observability)\r\n\r\nops-observe is the shared Loki/Grafana stack run by the SRE team for all engineering services.\r\n\r\n* **Alerting:** the `#eng-alerts` rules page the on-call rotation on `job.failed` spikes per service.\r\n* **Triage:** the weekly failure-triage dashboard groups `job.failed` events by `error_type`,\r\n  `job_type`, `queue`, `request.account_id` and `request.route`.\r\n* **Access:** everyone in engineering (all product teams, SRE, data platform, and contractors with\r\n  engineering access) can search raw events in Grafana Explore; events are kept for 180 days, as\r\n  received.\r\n* **Ingest:** `POST /v1/events` NDJSON; see `docs/observability_events.md` for the `job.failed` contract.\r\n"]
[14.235349, "o", "# Request context\r\n\r\nEvery job carries the `RequestContext` the gateway captured when the API request enqueued it:\r\nrequest id, timestamp, method, route, client IP, account id, the request headers, the query string\r\nand a preview of the request body.\r\n\r\nThe context exists so that a job can be replayed exactly as it came in and so that an engineer on\r\nthe worker box can reconstruct what the caller sent. It lives in the job store (`jobs.context`) and\r\nis written to the local failure log (`data/failures.jsonl`) together with the full job record when a\r\njob dies (`runner.log_failure_locally`). `jobs show <id> --json` prints the full record.\r\nimport sys\r\nfrom pathlib import Path\r\n\r\nimport pytest\r\n\r\nROOT = Path(__file__).resolve().parents[1]\r\nsys.path.insert(0, str(ROOT))\r\n\r\nfrom taskforge.config import Settings  # noqa: E402\r\nfrom taskforge.job_store import JobStore  # noqa: E402\r\n\r\n\r\n@pytest.fixture()\r\ndef settings(tmp_path):\r\n    return Settings(db_path=tmp_path / \"jobs.db\", seed_dir=ROOT / \"data\" / \"seed\", output_dir=tmp_path / \"out\",\r\n                    failure_log=tmp_path / \"failures.jsonl\", observe_url=\"http://127.0.0.1:1\", observe_timeout_sec=1,\r\n                    max_attempts=3, service_name=\"taskforge-test\", environment=\"test\")\r\n\r\n\r\n@pytest.fixture()\r\ndef store(settings):\r\n    s = JobStore(settings.db_path)\r\n    s.load_seed(settings.seed_dir)\r\n    yield s\r\n    s.close()\r\nimport json\r\n\r\nfrom taskforge.diagnostics import stack_summary, truncate\r\nfrom taskforge.runner import run_queue\r\n\r\n\r\ndef test_run_queue_processes_everything(store, settings):\r\n    summary = run_queue(store, settings)\r\n    counts = store.counts()\r\n    assert summary.processed == 34 + summary.retried\r\n    assert counts.get(\"pending\", 0) == 0 and counts[\"succeeded\"] == 27 and counts[\"dead\"] == 7\r\n    assert summary.dead == 7 and summary.succeeded == 27\r\n    assert len(summary.diagnostics_errors) == 7  # diagnostics not wired yet\r\n\r\n\r\ndef test_failure_log_has_full_record(store, settings):\r\n    run_queue(store, settings)\r\n    lines = [json.loads(l) for l in settings.failure_log.read_text().splitlines()]\r\n    assert len(lines) == 7 and all(l[\"job\"][\"status\"] == \"dead\" and \"context\" in l[\"job\"] for l in lines)\r\n\r\n\r\ndef test_dead_jobs_have_error_details(store, settings):\r\n    run_queue(store, settings, queue=\"webhooks\")\r\n    dead = store.list(status=\"dead\")\r\n    assert len(dead) == 3 and all(j.last_error_type == \"DeliveryError\" and j.attempts == j.max_attempts for j in dead)\r\n    breakdown = store.failure_breakdown()\r\n    assert breakdown == {\"by_error_type\": {\"DeliveryError\": 3}, \"by_queue\": {\"webhooks\": 3}}\r\n\r\n\r\ndef test_stack_summary_and_truncate():\r\n    tb = 'Traceback (most recent call last):\\n  File \"/app/taskforge/runner.py\", line 40, in run_one\\n    result = handler_for(job.job_type)(job, settings)\\n  File \"/app/taskforge/handlers.py\", line 50, in deliver_webhook\\n    raise DeliveryError(\"x\")\\ntaskforge.handlers.DeliveryError: x\\n'\r\n    frames = stack_summary(tb)\r\n    assert frames == [{\"file\": \"runner.py\", \"line\": 40, \"function\": \"run_one\"}, {\"file\": \"handlers.py\", \"line\": 50, \"function\": \"deliver_webhook\"}]\r\n    assert truncate(\"a\" * 600).endswith(\"…\") and len(truncate(\"a\" * 600)) == 500\r\n"]
[14.235473, "o", "\u001b[?2004hroot@7fb95ef67af2:/app# "]
[14.348371, "i", "cat taskforge/cli.py taskforge/job_store.py\n"]
[14.348666, "o", "cat taskforge/cli.py taskforge/job_store.py\r\n\u001b[?2004l\r"]
[14.349868, "o", "\"\"\"taskforge command line.\r\n\r\n    python -m taskforge.cli init-db [--replace]\r\n    python -m taskforge.cli jobs list [--status S] [--queue Q]\r\n    python -m taskforge.cli jobs show <job_id> [--json]\r\n    python -m taskforge.cli jobs retry <job_id> [--keep-attempts]\r\n    python -m taskforge.cli jobs stats [--json]\r\n    python -m taskforge.cli run-queue [--queue Q] [--max N]\r\n    python -m taskforge.cli observe-health\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport argparse\r\nimport json\r\nimport sys\r\nfrom typing import Sequence\r\n\r\nfrom . import __version__\r\nfrom .config import load_settings\r\nfrom .job_store import JobStore\r\nfrom .observability_client import ObservabilityClient, ObserveError\r\nfrom .runner import run_queue\r\n\r\n\r\ndef _store(settings) -> JobStore:\r\n    if not settings.db_path.exists():\r\n        print(f\"database not found at {settings.db_path}; run `init-db` first\", file=sys.stderr)\r\n        raise SystemExit(2)\r\n    return JobStore(settings.db_path)\r\n\r\n\r\ndef cmd_init_db(args, settings) -> int:\r\n    n = JobStore(settings.db_path).load_seed(settings.seed_dir, replace=args.replace)\r\n    print(f\"loaded {n} jobs into {settings.db_path}\")\r\n    return 0\r\n\r\n\r\ndef cmd_jobs_list(args, settings) -> int:\r\n    store = _store(settings)\r\n    for j in store.list(status=args.status, queue=args.queue):\r\n        err = f\"\\t{j.last_error_type}\" if j.last_error_type else \"\"\r\n        print(f\"{j.job_id}\\t{j.job_type:<16}\\t{j.queue:<8}\\t{j.status:<9}\\t{j.attempts}/{j.max_attempts}{err}\")\r\n    print(json.dumps(store.counts()), file=sys.stderr)\r\n    return 0\r\n\r\n\r\ndef cmd_jobs_show(args, settings) -> int:\r\n    store = _store(settings)\r\n    try:\r\n        job = store.get(args.job_id)\r\n    except KeyError as e:\r\n        print(str(e), file=sys.stderr)\r\n        return 1\r\n    if args.json:\r\n        print(json.dumps(job.to_dict(), indent=2))\r\n    else:\r\n        print(f\"{job.job_id} {job.job_type} [{job.status}] attempts={job.attempts}/{job.max_attempts} queue={job.queue}\")\r\n        print(f\"  request {job.context.request_id} {job.context.method} {job.context.route} account={job.context.account_id}\")\r\n        if job.last_error_type:\r\n            print(f\"  last error: {job.last_error_type}: {job.last_error_message}\")\r\n    return 0\r\n\r\n\r\ndef cmd_jobs_stats(args, settings) -> int:\r\n    store = _store(settings)\r\n    stats = {\"counts\": store.counts(), \"dead\": store.failure_breakdown()}\r\n    if args.json:\r\n        print(json.dumps(stats, indent=2))\r\n        return 0\r\n    for status, n in stats[\"counts\"].items():\r\n"]
[14.349993, "o", "        print(f\"{status:<10} {n}\")\r\n    for error_type, n in stats[\"dead\"][\"by_error_type\"].items():\r\n        print(f\"  dead/{error_type:<24} {n}\")\r\n    return 0\r\n\r\n\r\ndef cmd_jobs_retry(args, settings) -> int:\r\n    store = _store(settings)\r\n    try:\r\n        job = store.requeue(args.job_id, reset_attempts=not args.keep_attempts)\r\n    except (KeyError, ValueError) as e:\r\n        print(str(e), file=sys.stderr)\r\n        return 1\r\n    print(f\"{job.job_id} requeued (attempts={job.attempts}/{job.max_attempts})\")\r\n    return 0\r\n\r\n\r\ndef cmd_run_queue(args, settings) -> int:\r\n    store = _store(settings)\r\n    summary = run_queue(store, settings, queue=args.queue, max_jobs=args.max)\r\n    print(json.dumps(summary.as_dict(), indent=2))\r\n    return 0 if not summary.diagnostics_errors else 3\r\n\r\n\r\ndef cmd_observe_health(args, settings) -> int:\r\n    client = ObservabilityClient(settings.observe_url, settings.observe_timeout_sec, settings.service_name)\r\n    try:\r\n        resp = client.health()\r\n    except ObserveError as e:\r\n        print(str(e), file=sys.stderr)\r\n        return 1\r\n    print(json.dumps(resp.body))\r\n    return 0\r\n\r\n\r\ndef build_parser() -> argparse.ArgumentParser:\r\n    p = argparse.ArgumentParser(prog=\"taskforge\", description=\"taskforge job runner CLI\")\r\n    p.add_argument(\"--version\", action=\"version\", version=f\"taskforge {__version__}\")\r\n    sub = p.add_subparsers(dest=\"command\", required=True)\r\n\r\n    s = sub.add_parser(\"init-db\", help=\"create the SQLite job store from the seed file\")\r\n    s.add_argument(\"--replace\", action=\"store_true\"); s.set_defaults(func=cmd_init_db)\r\n\r\n    j = sub.add_parser(\"jobs\", help=\"inspect jobs\")\r\n    jsub = j.add_subparsers(dest=\"jobs_command\", required=True)\r\n    lst = jsub.add_parser(\"list\"); lst.add_argument(\"--status\"); lst.add_argument(\"--queue\"); lst.set_defaults(func=cmd_jobs_list)\r\n    show = jsub.add_parser(\"show\"); show.add_argument(\"job_id\"); show.add_argument(\"--json\", action=\"store_true\"); show.set_defaults(func=cmd_jobs_show)\r\n    stats = jsub.add_parser(\"stats\"); stats.add_argument(\"--json\", action=\"store_true\"); stats.set_defaults(func=cmd_jobs_stats)\r\n    retry = jsub.add_parser(\"retry\"); retry.add_argument(\"job_id\"); retry.add_argument(\"--keep-attempts\", action=\"store_true\"); retry.set_defaults(func=cmd_jobs_retry)\r\n\r\n    r = sub.add_parser(\"run-queue\", help=\"process pending jobs\")\r\n    r.add_argument(\"--queue\"); r.add_argument(\"--max\", type=int); r.set_defaults(func=cmd_run_queue)\r\n\r\n    sub.add_parser(\"observe-health\", help=\"check the observability service\").set_defaults(func=cmd_observe_health)\r\n    return p\r\n\r\n\r\ndef main(argv: Sequence[str] | None = None) -> int:\r\n    args = build_parser().parse_args(argv)\r\n    return args.func(args, load_settings())\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main())\r\n\"\"\"SQLite job store.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport json\r\nimport sqlite3\r\nfrom datetime import datetime, timezone\r\nfrom pathlib import Path\r\n\r\nfrom .models import Job, RequestContext\r\n\r\nSCHEMA = \"\"\"\r\nCREATE TABLE IF NOT EXISTS jobs (\r\n    job_id             TEXT PRIMARY KEY,\r\n    job_type           TEXT NOT NULL,\r\n    queue              TEXT NOT NULL,\r\n    status             TEXT NOT NULL CHECK (status IN ('pending','running','succeeded','failed','dead')),\r\n    payload            TEXT NOT NULL,\r\n    context            TEXT NOT NULL,\r\n    attempts           INTEGER NOT NULL DEFAULT 0,\r\n    max_attempts       INTEGER NOT NULL DEFAULT 3,\r\n    enqueued_at        TEXT NOT NULL,\r\n    started_at         TEXT,\r\n    finished_at        TEXT,\r\n    last_error_type    TEXT,\r\n    last_error_message TEXT,\r\n    last_traceback     TEXT,\r\n    result             TEXT\r\n);\r\nCREATE INDEX IF NOT EXISTS idx_jobs_status_queue ON jobs(status, queue, enqueued_at);\r\n\"\"\"\r\n\r\n\r\ndef utcnow() -> str:\r\n    return datetime.now(timezone.utc).isoformat(timespec=\"milliseconds\").replace(\"+00:00\", \"Z\")\r\n\r\n\r\nclass JobStore:\r\n    def __init__(self, db_path: Path):\r\n        db_path.parent.mkdir(parents=True, exist_ok=True)\r\n        self._conn = sqlite3.connect(str(db_path))\r\n        self._conn.row_factory = sqlite3.Row\r\n        self._conn.executescript(SCHEMA)\r\n\r\n    def close(self) -> None:\r\n        self._conn.close()\r\n\r\n    def load_seed(self, seed_dir: Path, replace: bool = False) -> int:\r\n"]
[14.350079, "o", "        rows = json.loads((seed_dir / \"jobs.json\").read_text())\r\n        with self._conn:\r\n            if replace:\r\n                self._conn.execute(\"DELETE FROM jobs\")\r\n            for r in rows:\r\n                self._conn.execute(\r\n                    \"INSERT OR REPLACE INTO jobs (job_id, job_type, queue, status, payload, context, attempts, max_attempts, enqueued_at)\"\r\n                    \" VALUES (?,?,?,?,?,?,?,?,?)\",\r\n                    (r[\"job_id\"], r[\"job_type\"], r[\"queue\"], \"pending\", json.dumps(r[\"payload\"]), json.dumps(r[\"context\"]), 0, r.get(\"max_attempts\", 3), r[\"enqueued_at\"]))\r\n        return len(rows)\r\n\r\n    def enqueue(self, job_id: str, job_type: str, queue: str, payload: dict, context: RequestContext, max_attempts: int = 3) -> Job:\r\n        now = utcnow()\r\n        with self._conn:\r\n            self._conn.execute(\r\n                \"INSERT INTO jobs (job_id, job_type, queue, status, payload, context, attempts, max_attempts, enqueued_at) VALUES (?,?,?,?,?,?,?,?,?)\",\r\n                (job_id, job_type, queue, \"pending\", json.dumps(payload), json.dumps(context.as_dict()), 0, max_attempts, now))\r\n        return self.get(job_id)\r\n\r\n    def get(self, job_id: str) -> Job:\r\n        row = self._conn.execute(\"SELECT * FROM jobs WHERE job_id = ?\", (job_id,)).fetchone()\r\n        if row is None:\r\n            raise KeyError(f\"unknown job {job_id!r}\")\r\n        return Job.from_row(dict(row))\r\n\r\n    def list(self, status: str | None = None, queue: str | None = None) -> list[Job]:\r\n        sql, params = \"SELECT * FROM jobs WHERE 1=1\", []\r\n        if status:\r\n            sql += \" AND status = ?\"; params.append(status)\r\n        if queue:\r\n            sql += \" AND queue = ?\"; params.append(queue)\r\n        return [Job.from_row(dict(r)) for r in self._conn.execute(sql + \" ORDER BY enqueued_at, job_id\", params)]\r\n\r\n    def claim_next(self, queue: str | None = None) -> Job | None:\r\n        sql, params = \"SELECT job_id FROM jobs WHERE status = 'pending'\", []\r\n        if queue:\r\n            sql += \" AND queue = ?\"; params.append(queue)\r\n        row = self._conn.execute(sql + \" ORDER BY enqueued_at, job_id LIMIT 1\", params).fetchone()\r\n        if row is None:\r\n            return None\r\n        with self._conn:\r\n            self._conn.execute(\"UPDATE jobs SET status = 'running', started_at = ?, finished_at = NULL, attempts = attempts + 1 WHERE job_id = ?\", (utcnow(), row[\"job_id\"]))\r\n        return self.get(row[\"job_id\"])\r\n\r\n    def mark_succeeded(self, job_id: str, result: dict) -> Job:\r\n        with self._conn:\r\n            self._conn.execute(\"UPDATE jobs SET status = 'succeeded', finished_at = ?, result = ?, last_error_type = NULL, last_error_message = NULL, last_traceback = NULL WHERE job_id = ?\",\r\n                               (utcnow(), json.dumps(result), job_id))\r\n        return self.get(job_id)\r\n\r\n    def mark_failed(self, job_id: str, error_type: str, message: str, traceback_text: str, final: bool) -> Job:\r\n        with self._conn:\r\n            self._conn.execute(\r\n                \"UPDATE jobs SET status = ?, finished_at = ?, last_error_type = ?, last_error_message = ?, last_traceback = ? WHERE job_id = ?\",\r\n                (\"dead\" if final else \"pending\", utcnow(), error_type, message[:2000], traceback_text[-8000:], job_id))\r\n        return self.get(job_id)\r\n\r\n    def requeue(self, job_id: str, reset_attempts: bool = True) -> Job:\r\n        \"\"\"Put a dead (or failed) job back on the queue for another run.\"\"\"\r\n        job = self.get(job_id)\r\n        if job.status not in (\"dead\", \"pending\"):\r\n            raise ValueError(f\"job {job_id} is {job.status}; only dead jobs can be requeued\")\r\n        with self._conn:\r\n            self._conn.execute(\"UPDATE jobs SET status = 'pending', attempts = CASE WHEN ? THEN 0 ELSE attempts END, started_at = NULL, finished_at = NULL WHERE job_id = ?\",\r\n                               (1 if reset_attempts else 0, job_id))\r\n        return self.get(job_id)\r\n\r\n    def failure_breakdown(self) -> dict[str, dict[str, int]]:\r\n        \"\"\"Dead jobs grouped by error type and by queue (what the weekly tri"]
[14.350141, "o", "age looks at).\"\"\"\r\n        by_error: dict[str, int] = {}\r\n        by_queue: dict[str, int] = {}\r\n        for r in self._conn.execute(\"SELECT last_error_type, queue, COUNT(*) AS n FROM jobs WHERE status = 'dead' GROUP BY last_error_type, queue\"):\r\n            by_error[r[\"last_error_type\"] or \"unknown\"] = by_error.get(r[\"last_error_type\"] or \"unknown\", 0) + r[\"n\"]\r\n            by_queue[r[\"queue\"]] = by_queue.get(r[\"queue\"], 0) + r[\"n\"]\r\n        return {\"by_error_type\": dict(sorted(by_error.items())), \"by_queue\": dict(sorted(by_queue.items()))}\r\n\r\n    def counts(self) -> dict[str, int]:\r\n        return {r[\"status\"]: r[\"n\"] for r in self._conn.execute(\"SELECT status, COUNT(*) AS n FROM jobs GROUP BY status ORDER BY status\")}\r\n"]
