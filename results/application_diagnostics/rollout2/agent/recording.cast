[83.2951, "o", "\u001b[?2004h"]
[83.295117, "o", "> "]
[83.295308, "o", "    assert {e[\"job_id\"] for e in events} == {j.job_id for j in dead}\r\n\u001b[?2004l\r"]
[83.295344, "o", "\u001b[?2004h"]
[83.295378, "o", "> "]
[83.295446, "o", "    for event in events:\r\n\u001b[?2004l\r"]
[83.295491, "o", "\u001b[?2004h> "]
[83.295681, "o", "        job = store.get(event[\"job_id\"])\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.295747, "o", "> "]
[83.295941, "o", "        assert event[\"attempt\"] == job.attempts == job.max_attempts\r\n\u001b[?2004l\r"]
[83.295987, "o", "\u001b[?2004h> "]
[83.296358, "o", "        assert event[\"failed_at\"] == job.finished_at\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.296397, "o", "        assert event[\"duration_ms\"] == job.duration_ms''')\r\n\u001b[?2004l\r"]
[83.296427, "o", "\u001b[?2004h> "]
[83.296456, "o", "s += '''\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.296503, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.296705, "o", "@pytest.mark.parametrize(\"status\", [202, 422, 503, \"unreachable\"])\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.296748, "o", "> "]
[83.297043, "o", "def test_cli_delivery_outcome_preserves_dead_jobs_and_log(store, settings, observe_server, monkeypatch, capsys, status):\r\n\u001b[?2004l\r"]
[83.297112, "o", "\u001b[?2004h> "]
[83.297173, "o", "    if status == \"unreachable\":\r\n\u001b[?2004l\r"]
[83.297224, "o", "\u001b[?2004h> "]
[83.297298, "o", "        import urllib.error\r\n\u001b[?2004l\r"]
[83.297332, "o", "\u001b[?2004h> "]
[83.297417, "o", "        import urllib.request\r\n\u001b[?2004l\r"]
[83.297452, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[83.297491, "o", "\u001b[?2004h> "]
[83.2976, "o", "        def unavailable(*args, **kwargs):\r\n\u001b[?2004l\r"]
[83.297636, "o", "\u001b[?2004h> "]
[83.297827, "o", "            raise urllib.error.URLError(\"connection refused\")\r\n\u001b[?2004l\r"]
[83.297861, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[83.297892, "o", "\u001b[?2004h> "]
[83.298091, "o", "        monkeypatch.setattr(urllib.request, \"urlopen\", unavailable)\r\n\u001b[?2004l\r"]
[83.298121, "o", "\u001b[?2004h> "]
[83.29816, "o", "    else:\r\n\u001b[?2004l\r"]
[83.298198, "o", "\u001b[?2004h> "]
[83.298383, "o", "        observe_server.status = status\r\n\u001b[?2004l\r"]
[83.298416, "o", "\u001b[?2004h> "]
[83.298617, "o", "    settings = replace(settings, observe_url=observe_server.url)\r\n\u001b[?2004l\r"]
[83.298649, "o", "\u001b[?2004h> "]
[83.298847, "o", "    monkeypatch.setattr(cli, \"load_settings\", lambda: settings)\r\n\u001b[?2004l\r"]
[83.298879, "o", "\u001b[?2004h> "]
[83.299072, "o", "    monkeypatch.setattr(cli, \"_store\", lambda settings: store)\r\n\u001b[?2004l\r"]
[83.299113, "o", "\u001b[?2004h> "]
[83.299245, "o", "    exit_code = cli.main([\"run-queue\"])\r\n\u001b[?2004l\r"]
[83.299268, "o", "\u001b[?2004h"]
[83.299289, "o", "> "]
[83.299433, "o", "    summary = json.loads(capsys.readouterr().out)\r\n\u001b[?2004l\r"]
[83.299455, "o", "\u001b[?2004h"]
[83.299476, "o", "> "]
[83.299644, "o", "    assert store.counts() == {\"dead\": 7, \"succeeded\": 27}\r\n\u001b[?2004l\r"]
[83.299667, "o", "\u001b[?2004h"]
[83.299687, "o", "> "]
[83.299984, "o", "    records = [json.loads(line)[\"job\"] for line in settings.failure_log.read_text().splitlines()]\r\n\u001b[?2004l\r"]
[83.300049, "o", "\u001b[?2004h> "]
[83.30036, "o", "    assert {r[\"job_id\"] for r in records} == {j.job_id for j in store.list(status=\"dead\")}\r\n\u001b[?2004l\r"]
[83.300417, "o", "\u001b[?2004h> "]
[83.300468, "o", "    for record in records:\r\n\u001b[?2004l\r"]
[83.300506, "o", "\u001b[?2004h> "]
[83.300717, "o", "        assert record == store.get(record[\"job_id\"]).to_dict()\r\n\u001b[?2004l\r"]
[83.300769, "o", "\u001b[?2004h> "]
[83.301074, "o", "        assert record[\"last_error_message\"] and record[\"last_traceback\"] and record[\"context\"]\r\n\u001b[?2004l\r"]
[83.301115, "o", "\u001b[?2004h> "]
[83.301212, "o", "    if status == 202:\r\n\u001b[?2004l\r"]
[83.301256, "o", "\u001b[?2004h> "]
[83.301462, "o", "        assert exit_code == 0 and summary[\"diagnostics_sent\"] == 7\r\n\u001b[?2004l\r"]
[83.301504, "o", "\u001b[?2004h> "]
[83.301675, "o", "        assert summary[\"diagnostics_errors\"] == []\r\n\u001b[?2004l\r"]
[83.301721, "o", "\u001b[?2004h> "]
[83.301769, "o", "    else:\r\n\u001b[?2004l\r"]
[83.301803, "o", "\u001b[?2004h> "]
[83.302008, "o", "        assert exit_code == 3 and summary[\"diagnostics_sent\"] == 0\r\n\u001b[?2004l\r"]
[83.302041, "o", "\u001b[?2004h> "]
[83.302203, "o", "        errors = summary[\"diagnostics_errors\"]\r\n\u001b[?2004l\r"]
[83.302233, "o", "\u001b[?2004h"]
[83.302267, "o", "> "]
[83.302346, "o", "        assert len(errors) == 7\r\n\u001b[?2004l\r"]
[83.302374, "o", "\u001b[?2004h> "]
[83.302664, "o", "        detail = \"unreachable\" if status == \"unreachable\" else f\"rejected events ({status})\"\r\n\u001b[?2004l\r"]
[83.302719, "o", "\u001b[?2004h> "]
[83.302952, "o", "        assert all(\"ObserveError\" in error and detail in error for error in errors)\r\n\u001b[?2004l\r"]
[83.302982, "o", "\u001b[?2004h> "]
[83.303244, "o", "        assert all(any(r[\"job_id\"] in error for error in errors) for r in records)\r\n\u001b[?2004l\r"]
[83.303275, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[83.303304, "o", "\u001b[?2004h"]
[83.303333, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[83.303363, "o", "> "]
[83.303605, "o", "def test_diagnostics_only_sent_after_final_attempt(store, settings, observe_server):\r\n\u001b[?2004l\r"]
[83.303635, "o", "\u001b[?2004h> "]
[83.303869, "o", "    settings = replace(settings, observe_url=observe_server.url)\r\n\u001b[?2004l\r"]
[83.303903, "o", "\u001b[?2004h> "]
[83.304037, "o", "    context = store.get(\"job_0001\").context\r\n\u001b[?2004l\r"]
[83.304069, "o", "\u001b[?2004h> "]
[83.304375, "o", "    store.enqueue(\"job_retry_test\", \"unknown.type\", \"test-retries\", {}, context, max_attempts=2)\r\n\u001b[?2004l\r"]
[83.304433, "o", "\u001b[?2004h"]
[83.304463, "o", "> "]
[83.304636, "o", "    first = run_queue(store, settings, queue=\"test-retries\", max_jobs=1)\r\n\u001b[?2004l\r"]
[83.304669, "o", "\u001b[?2004h> "]
[83.304912, "o", "    assert first.retried == 1 and first.dead == first.diagnostics_sent == 0\r\n\u001b[?2004l\r"]
[83.304961, "o", "\u001b[?2004h> "]
[83.305147, "o", "    assert first.diagnostics_errors == [] and observe_server.requests == []\r\n\u001b[?2004l\r"]
[83.305182, "o", "\u001b[?2004h> "]
[83.305305, "o", "    assert not settings.failure_log.exists()\r\n\u001b[?2004l\r"]
[83.305333, "o", "\u001b[?2004h"]
[83.30535, "o", "> "]
[83.3055, "o", "    final = run_queue(store, settings, queue=\"test-retries\")\r\n"]
[83.305518, "o", "\u001b[?2004l\r"]
[83.305533, "o", "\u001b[?2004h> "]
[83.305779, "o", "    assert final.dead == final.diagnostics_sent == 1 and final.diagnostics_errors == []\r\n\u001b[?2004l\r"]
[83.305821, "o", "\u001b[?2004h> "]
[83.305949, "o", "    assert len(observe_server.requests) == 1\r\n\u001b[?2004l\r"]
[83.30598, "o", "\u001b[?2004h> "]
[83.306116, "o", "    event = json.loads(observe_server.requests[0][\"body\"])\r\n\u001b[?2004l\r"]
[83.306144, "o", "\u001b[?2004h> "]
[83.306352, "o", "    assert event[\"job_id\"] == \"job_retry_test\" and event[\"attempt\"] == 2\r\n\u001b[?2004l\r"]
[83.306385, "o", "\u001b[?2004h> "]
[83.306404, "o", "'''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.306452, "o", "p.write_text(s)\r\n\u001b[?2004l\r"]
[83.306486, "o", "\u001b[?2004h> "]
[83.306521, "o", "PY\r\n\u001b[?2004l\r"]
[83.387399, "o", "\u001b[?2004hroot@7fb95ef67af2:/app# "]
