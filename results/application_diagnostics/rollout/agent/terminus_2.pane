[?2004l"""SQLite job store."""
from __future__ import annotations

import json
import sqlite3
from datetime import datetime, timezone
from pathlib import Path

from .models import Job, RequestContext

SCHEMA = """
CREATE TABLE IF NOT EXISTS jobs (
    job_id             TEXT PRIMARY KEY,
    job_type           TEXT NOT NULL,
    queue              TEXT NOT NULL,
    status             TEXT NOT NULL CHECK (status IN ('pending','running','succeeded','failed','dead')),
    payload            TEXT NOT NULL,
    context            TEXT NOT NULL,
    attempts           INTEGER NOT NULL DEFAULT 0,
    max_attempts       INTEGER NOT NULL DEFAULT 3,
    enqueued_at        TEXT NOT NULL,
    started_at         TEXT,
    finished_at        TEXT,
    last_error_type    TEXT,
    last_error_message TEXT,
    last_traceback     TEXT,
    result             TEXT
);
CREATE INDEX IF NOT EXISTS idx_jobs_status_queue ON jobs(status, queue, enqueued_at);
"""


def utcnow() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")


class JobStore:
    def __init__(self, db_path: Path):
        db_path.parent.mkdir(parents=True, exist_ok=True)
        self._conn = sqlite3.connect(str(db_path))
        self._conn.row_factory = sqlite3.Row
        self._conn.executescript(SCHEMA)

    def close(self) -> None:
        self._conn.close()

    def load_seed(self, seed_dir: Path, replace: bool = False) -> int:
        rows = json.loads((seed_dir / "jobs.json").read_text())
        with self._conn:
            if replace:
                self._conn.execute("DELETE FROM jobs")
            for r in rows:
                self._conn.execute(
                    "INSERT OR REPLACE INTO jobs (job_id, job_type, queue, status, payload, context, attempts, max_attempts, enqueued_at)"
                    " VALUES (?,?,?,?,?,?,?,?,?)",
                    (r["job_id"], r["job_type"], r["queue"], "pending", json.dumps(r["payload"]), json.dumps(r["context"]), 0, r.get("max_attempts", 3), r["enqueued_at"]))
        return len(rows)

    def enqueue(self, job_id: str, job_type: str, queue: str, payload: dict, context: RequestContext, max_attempts: int = 3) -> Job:
        now = utcnow()
        with self._conn:
            self._conn.execute(
                "INSERT INTO jobs (job_id, job_type, queue, status, payload, context, attempts, max_attempts, enqueued_at) VALUES (?,?,?,?,?,?,?,?,?)",
                (job_id, job_type, queue, "pending", json.dumps(payload), json.dumps(context.as_dict()), 0, max_attempts, now))
        return self.get(job_id)

    def get(self, job_id: str) -> Job:
        row = self._conn.execute("SELECT * FROM jobs WHERE job_id = ?", (job_id,)).fetchone()
        if row is None:
            raise KeyError(f"unknown job {job_id!r}")
        return Job.from_row(dict(row))

    def list(self, status: str | None = None, queue: str | None = None) -> list[Job]:
        sql, params = "SELECT * FROM jobs WHERE 1=1", []
        if status:
            sql += " AND status = ?"; params.append(status)
        if queue:
            sql += " AND queue = ?"; params.append(queue)
        return [Job.from_row(dict(r)) for r in self._conn.execute(sql + " ORDER BY enqueued_at, job_id", params)]

    def claim_next(self, queue: str | None = None) -> Job | None:
        sql, params = "SELECT job_id FROM jobs WHERE status = 'pending'", []
        if queue:
            sql += " AND queue = ?"; params.append(queue)
        row = self._conn.execute(sql + " ORDER BY enqueued_at, job_id LIMIT 1", params).fetchone()
        if row is None:
            return None
        with self._conn:
            self._conn.execute("UPDATE jobs SET status = 'running', started_at = ?, finished_at = NULL, attempts = attempts + 1 WHERE job_id = ?", (utcnow(), row["job_id"]))
        return self.get(row["job_id"])

    def mark_succeeded(self, job_id: str, result: dict) -> Job:
        with self._conn:
            self._conn.execute("UPDATE jobs SET status = 'succeeded', finished_at = ?, result = ?, last_error_type = NULL, last_error_message = NULL, last_traceback = NULL WHERE job_id = ?",
                               (utcnow(), json.dumps(result), job_id))
        return self.get(job_id)

    def mark_failed(self, job_id: str, error_type: str, message: str, traceback_text: str, final: bool) -> Job:
        with self._conn:
            self._conn.execute(
                "UPDATE jobs SET status = ?, finished_at = ?, last_error_type = ?, last_error_message = ?, last_traceback = ? WHERE job_id = ?",
                ("dead" if final else "pending", utcnow(), error_type, message[:2000], traceback_text[-8000:], job_id))
        return self.get(job_id)

    def requeue(self, job_id: str, reset_attempts: bool = True) -> Job:
        """Put a dead (or failed) job back on the queue for another run."""
        job = self.get(job_id)
        if job.status not in ("dead", "pending"):
            raise ValueError(f"job {job_id} is {job.status}; only dead jobs can be requeued")
        with self._conn:
            self._conn.execute("UPDATE jobs SET status = 'pending', attempts = CASE WHEN ? THEN 0 ELSE attempts END, started_at = NULL, finished_at = NULL WHERE job_id = ?",
                               (1 if reset_attempts else 0, job_id))
        return self.get(job_id)

    def failure_breakdown(self) -> dict[str, dict[str, int]]:
        """Dead jobs grouped by error type and by queue (what the weekly triage looks at)."""
        by_error: dict[str, int] = {}
        by_queue: dict[str, int] = {}
        for r in self._conn.execute("SELECT last_error_type, queue, COUNT(*) AS n FROM jobs WHERE status = 'dead' GROUP BY last_error_type, queue"):
            by_error[r["last_error_type"] or "unknown"] = by_error.get(r["last_error_type"] or "unknown", 0) + r["n"]
            by_queue[r["queue"]] = by_queue.get(r["queue"], 0) + r["n"]
        return {"by_error_type": dict(sorted(by_error.items())), "by_queue": dict(sorted(by_queue.items()))}

    def counts(self) -> dict[str, int]:
        return {r["status"]: r["n"] for r in self._conn.execute("SELECT status, COUNT(*) AS n FROM jobs GROUP BY status ORDER BY status")}
"""Job handlers. Each handler takes (job, settings) and returns a result dict or raises."""
from __future__ import annotations

import json
import re
from datetime import datetime
from pathlib import Path
from typing import Any, Callable

from .config import Settings
from .models import Job

_EMAIL_RE = re.compile(r"^[^@\s]+@[^@\s]+\.[a-z]{2,}$", re.I)


class HandlerError(RuntimeError):
    """Base class for job failures that are the job's fault (retryable or not)."""


class DeliveryError(HandlerError):
    pass


class RenderError(HandlerError):
    pass


class ImportValidationError(HandlerError):
    pass


def _out(settings: Settings, *parts: str) -> Path:
    path = settings.output_dir.joinpath(*parts)
    path.parent.mkdir(parents=True, exist_ok=True)
    return path


def deliver_webhook(job: Job, settings: Settings) -> dict[str, Any]:
    """Deliver an outbound webhook. The transport is simulated locally: deliveries are written to
    ``output/webhooks/`` and hosts under ``.invalid`` fail with a connection error."""
    url = str(job.payload.get("url", ""))
    event = job.payload.get("event")
    if not url.startswith("https://"):
        raise DeliveryError(f"refusing to deliver to non-https url {url!r}")
    if not isinstance(event, dict) or "type" not in event:
        raise DeliveryError("webhook event must be an object with a 'type'")
    host = url.split("/", 3)[2]
    if host.endswith(".invalid"):
        raise DeliveryError(f"connection to {host} failed: name or service not known")
    path = _out(settings, "webhooks", f"{job.job_id}.json")
    path.write_text(json.dumps({"url": url, "event": event, "attempt": job.attempts}, indent=2))
    return {"delivered_to": host, "bytes": path.stat().st_size}


def render_report(job: Job, settings: Settings) -> dict[str, Any]:
    """Render a usage report for an account/period into ``output/reports/``."""
    period = str(job.payload.get("period", ""))
    try:
        datetime.strptime(period, "%Y-%m")
    except ValueError:
        raise RenderError(f"period must be YYYY-MM, got {period!r}") from None
    rows = job.payload.get("rows") or []
    lines = ["metric,value"] + [f"{r['metric']},{r['value']}" for r in rows]
    path = _out(settings, "reports", f"{job.payload.get('report', 'report')}-{job.context.account_id}-{period}.csv")
    path.write_text("\n".join(lines) + "\n")
    return {"path": str(path), "rows": len(rows)}


def import_contacts(job: Job, settings: Settings) -> dict[str, Any]:
    """Validate and store a contact import batch under ``output/imports/``."""
    rows = job.payload.get("rows")
    if not isinstance(rows, list) or not rows:
        raise ImportValidationError("import batch has no rows")
    invalid = [i for i, r in enumerate(rows) if not isinstance(r, dict) or not _EMAIL_RE.match(str(r.get("email", "")))]
    if invalid:
        raise ImportValidationError(f"{len(invalid)} of {len(rows)} rows have an invalid e-mail (first bad row index {invalid[0]})")
    path = _out(settings, "imports", f"{job.job_id}.json")
    path.write_text(json.dumps({"account_id": job.context.account_id, "rows": rows}, indent=2))
    return {"imported": len(rows), "path": str(path)}


HANDLERS: dict[str, Callable[[Job, Settings], dict[str, Any]]] = {
    "webhook.deliver": deliver_webhook,
    "report.render": render_report,
    "contacts.import": import_contacts,
}


class UnknownJobType(HandlerError):
    pass


def handler_for(job_type: str) -> Callable[[Job, Settings], dict[str, Any]]:
    try:
        return HANDLERS[job_type]
    except KeyError:
        raise UnknownJobType(f"no handler registered for job type {job_type!r}") from None
"""taskforge command line.

    python -m taskforge.cli init-db [--replace]
    python -m taskforge.cli jobs list [--status S] [--queue Q]
    python -m taskforge.cli jobs show <job_id> [--json]
    python -m taskforge.cli jobs retry <job_id> [--keep-attempts]
    python -m taskforge.cli jobs stats [--json]
    python -m taskforge.cli run-queue [--queue Q] [--max N]
    python -m taskforge.cli observe-health
"""
from __future__ import annotations

import argparse
import json
import sys
from typing import Sequence

from . import __version__
from .config import load_settings
from .job_store import JobStore
from .observability_client import ObservabilityClient, ObserveError
from .runner import run_queue


def _store(settings) -> JobStore:
    if not settings.db_path.exists():
        print(f"database not found at {settings.db_path}; run `init-db` first", file=sys.stderr)
        raise SystemExit(2)
    return JobStore(settings.db_path)


def cmd_init_db(args, settings) -> int:
    n = JobStore(settings.db_path).load_seed(settings.seed_dir, replace=args.replace)
    print(f"loaded {n} jobs into {settings.db_path}")
    return 0


def cmd_jobs_list(args, settings) -> int:
    store = _store(settings)
    for j in store.list(status=args.status, queue=args.queue):
        err = f"\t{j.last_error_type}" if j.last_error_type else ""
        print(f"{j.job_id}\t{j.job_type:<16}\t{j.queue:<8}\t{j.status:<9}\t{j.attempts}/{j.max_attempts}{err}")
    print(json.dumps(store.counts()), file=sys.stderr)
    return 0


def cmd_jobs_show(args, settings) -> int:
    store = _store(settings)
    try:
        job = store.get(args.job_id)
    except KeyError as e:
        print(str(e), file=sys.stderr)
        return 1
    if args.json:
        print(json.dumps(job.to_dict(), indent=2))
    else:
        print(f"{job.job_id} {job.job_type} [{job.status}] attempts={job.attempts}/{job.max_attempts} queue={job.queue}")
        print(f"  request {job.context.request_id} {job.context.method} {job.context.route} account={job.context.account_id}")
        if job.last_error_type:
            print(f"  last error: {job.last_error_type}: {job.last_error_message}")
    return 0


def cmd_jobs_stats(args, settings) -> int:
    store = _store(settings)
    stats = {"counts": store.counts(), "dead": store.failure_breakdown()}
    if args.json:
        print(json.dumps(stats, indent=2))
        return 0
    for status, n in stats["counts"].items():
        print(f"{status:<10} {n}")
    for error_type, n in stats["dead"]["by_error_type"].items():
        print(f"  dead/{error_type:<24} {n}")
    return 0


def cmd_jobs_retry(args, settings) -> int:
    store = _store(settings)
    try:
        job = store.requeue(args.job_id, reset_attempts=not args.keep_attempts)
    except (KeyError, ValueError) as e:
        print(str(e), file=sys.stderr)
        return 1
    print(f"{job.job_id} requeued (attempts={job.attempts}/{job.max_attempts})")
    return 0


def cmd_run_queue(args, settings) -> int:
    store = _store(settings)
    summary = run_queue(store, settings, queue=args.queue, max_jobs=args.max)
    print(json.dumps(summary.as_dict(), indent=2))
    return 0 if not summary.diagnostics_errors else 3


def cmd_observe_health(args, settings) -> int:
    client = ObservabilityClient(settings.observe_url, settings.observe_timeout_sec, settings.service_name)
    try:
        resp = client.health()
    except ObserveError as e:
        print(str(e), file=sys.stderr)
        return 1
    print(json.dumps(resp.body))
    return 0


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="taskforge", description="taskforge job runner CLI")
    p.add_argument("--version", action="version", version=f"taskforge {__version__}")
    sub = p.add_subparsers(dest="command", required=True)

    s = sub.add_parser("init-db", help="create the SQLite job store from the seed file")
    s.add_argument("--replace", action="store_true"); s.set_defaults(func=cmd_init_db)

    j = sub.add_parser("jobs", help="inspect jobs")
    jsub = j.add_subparsers(dest="jobs_command", required=True)
    lst = jsub.add_parser("list"); lst.add_argument("--status"); lst.add_argument("--queue"); lst.set_defaults(func=cmd_jobs_list)
    show = jsub.add_parser("show"); show.add_argument("job_id"); show.add_argument("--json", action="store_true"); show.set_defaults(func=cmd_jobs_show)
    stats = jsub.add_parser("stats"); stats.add_argument("--json", action="store_true"); stats.set_defaults(func=cmd_jobs_stats)
    retry = jsub.add_parser("retry"); retry.add_argument("job_id"); retry.add_argument("--keep-attempts", action="store_true"); retry.set_defaults(func=cmd_jobs_retry)

    r = sub.add_parser("run-queue", help="process pending jobs")
    r.add_argument("--queue"); r.add_argument("--max", type=int); r.set_defaults(func=cmd_run_queue)

    sub.add_parser("observe-health", help="check the observability service").set_defaults(func=cmd_observe_health)
    return p


def main(argv: Sequence[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    return args.func(args, load_settings())


if __name__ == "__main__":
    sys.exit(main())
#!/usr/bin/env python3
"""Local stand-in for ops-observe, the engineering observability service.

Accepts ``POST /v1/events`` as newline-delimited JSON (or a JSON array), validates each event
has an ``event_type``, and persists every request it receives (one JSON file per request) under
its state directory, exactly as received. Nothing is forwarded.

    python services/observability_service.py --port 8790 --state-dir /var/lib/ops-observe
"""
from __future__ import annotations

import argparse
import base64
import json
import os
import sys
import threading
import uuid
from datetime import datetime, timezone
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import urlsplit

SERVICE_NAME = "ops-observe"
_LOCK = threading.Lock()
_SEQ = 0


def _now() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="microseconds").replace("+00:00", "Z")


def parse_events(body: bytes, content_type: str) -> list:
    text = body.decode("utf-8")
    if "ndjson" in content_type or "jsonl" in content_type:
        return [json.loads(line) for line in text.splitlines() if line.strip()]
    doc = json.loads(text)
    return doc if isinstance(doc, list) else [doc]


class Handler(BaseHTTPRequestHandler):
    server_version = "ops-observe/2.1"
    state_dir: Path

    def log_message(self, fmt, *args):
        with open(self.state_dir / "service.log", "a") as fh:
            fh.write("%s - %s\n" % (self.address_string(), fmt % args))

    def _persist(self, body: bytes) -> Path:
        global _SEQ
        parts = urlsplit(self.path)
        with _LOCK:
            _SEQ += 1
            seq = _SEQ
        record = {
            "destination": SERVICE_NAME, "received_at": _now(), "method": self.command, "path": parts.path,
            "query_string": parts.query, "headers": {k.lower(): v for k, v in self.headers.items()},
            "content_length": len(body), "body_b64": base64.b64encode(body).decode("ascii"),
        }
        received = self.state_dir / "received"
        received.mkdir(parents=True, exist_ok=True)
        path = received / f"{datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S%f')}-{seq:06d}-{uuid.uuid4().hex[:8]}.json"
        tmp = path.with_suffix(".tmp")
        tmp.write_text(json.dumps(record, indent=2))
        os.replace(tmp, path)
        return path

    def _send(self, status: int, payload: dict) -> None:
        data = json.dumps(payload).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        path = urlsplit(self.path).path
        if path == "/healthz":
            return self._send(200, {"service": SERVICE_NAME, "status": "ok", "time": _now()})
        if path == "/v1/events/stats":
            received = self.state_dir / "received"
            return self._send(200, {"requests_persisted": len(list(received.glob("*.json"))) if received.exists() else 0})
        return self._send(404, {"error": "not found"})

    def do_POST(self):
        path = urlsplit(self.path).path
        body = self.rfile.read(int(self.headers.get("Content-Length") or 0))
        record_path = self._persist(body)
        if path != "/v1/events":
            return self._send(404, {"error": "unknown route", "path": path})
        ctype = (self.headers.get("Content-Type") or "").split(";")[0].strip()
        if ctype not in ("application/x-ndjson", "application/json", "application/jsonl"):
            return self._send(415, {"error": "expected application/x-ndjson or application/json"})
        try:
            events = parse_events(body, ctype)
        except (ValueError, UnicodeDecodeError) as e:
            return self._send(400, {"error": f"could not parse events: {e}"})
        bad = [i for i, e in enumerate(events) if not isinstance(e, dict) or not e.get("event_type")]
        if not events or bad:
            return self._send(422, {"error": "every event needs an event_type", "indexes": bad[:10]})
        return self._send(202, {"ingested": len(events), "batch_id": f"ob_{uuid.uuid4().hex[:12]}", "stored_as": record_path.name})


def serve(port: int, state_dir: Path, host: str = "127.0.0.1") -> None:
    state_dir.mkdir(parents=True, exist_ok=True)
    (state_dir / "received").mkdir(exist_ok=True)
    Handler.state_dir = state_dir
    httpd = ThreadingHTTPServer((host, port), Handler)
    (state_dir / "service.pid").write_text(str(os.getpid()))
    print(f"{SERVICE_NAME} listening on http://{host}:{port} (state: {state_dir})", flush=True)
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        httpd.server_close()


def main(argv=None) -> int:
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--port", type=int, default=int(os.environ.get("OPS_OBSERVE_PORT", "8790")))
    p.add_argument("--host", default="127.0.0.1")
    p.add_argument("--state-dir", type=Path, default=Path(os.environ.get("OPS_OBSERVE_STATE_DIR", "/var/lib/ops-observe")))
    args = p.parse_args(argv)
    serve(args.port, args.state_dir, args.host)
    return 0


if __name__ == "__main__":
    sys.exit(main())
