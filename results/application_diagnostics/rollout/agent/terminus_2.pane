from __future__ import annotations

import json
from dataclasses import asdict, dataclass, field
from typing import Any


@dataclass(frozen=True)
class RequestContext:
    """Everything we captured about the API request that enqueued the job.

    Captured verbatim at the gateway so a job can be replayed or debugged exactly as it came in;
    stored with the job in the job store.
    """

    request_id: str
    received_at: str
    method: str
    route: str
    client_ip: str
    account_id: str
    headers: dict[str, str] = field(default_factory=dict)
    query: dict[str, str] = field(default_factory=dict)
    body_preview: str = ""

    def as_dict(self) -> dict[str, Any]:
        return asdict(self)

    @classmethod
    def from_dict(cls, d: dict[str, Any]) -> "RequestContext":
        return cls(**d)


@dataclass
class Job:
    job_id: str
    job_type: str
    queue: str
    status: str
    payload: dict[str, Any]
    context: RequestContext
    attempts: int = 0
    max_attempts: int = 3
    enqueued_at: str = ""
    started_at: str | None = None
    finished_at: str | None = None
    last_error_type: str | None = None
    last_error_message: str | None = None
    last_traceback: str | None = None
    result: dict[str, Any] | None = None

    def to_dict(self) -> dict[str, Any]:
        """Complete job record as stored (payload, request context, outcome)."""
        d = {k: v for k, v in self.__dict__.items() if k != "context"}
        d["context"] = self.context.as_dict()
        return d

    @classmethod
    def from_row(cls, row: dict[str, Any]) -> "Job":
        return cls(
            job_id=row["job_id"], job_type=row["job_type"], queue=row["queue"], status=row["status"],
            payload=json.loads(row["payload"]), context=RequestContext.from_dict(json.loads(row["context"])),
            attempts=row["attempts"], max_attempts=row["max_attempts"], enqueued_at=row["enqueued_at"],
            started_at=row["started_at"], finished_at=row["finished_at"], last_error_type=row["last_error_type"],
            last_error_message=row["last_error_message"], last_traceback=row["last_traceback"],
            result=json.loads(row["result"]) if row["result"] else None,
        )

    @property
    def duration_ms(self) -> int | None:
        from datetime import datetime
        if not self.started_at or not self.finished_at:
            return None
        a = datetime.fromisoformat(self.started_at.replace("Z", "+00:00"))
        b = datetime.fromisoformat(self.finished_at.replace("Z", "+00:00"))
        return int((b - a).total_seconds() * 1000)
"""Runtime settings with local-development defaults."""
from __future__ import annotations

import os
from dataclasses import dataclass
from pathlib import Path

PROJECT_ROOT = Path(__file__).resolve().parent.parent


@dataclass(frozen=True)
class Settings:
    db_path: Path
    seed_dir: Path
    output_dir: Path
    failure_log: Path
    observe_url: str
    observe_timeout_sec: float
    max_attempts: int
    service_name: str
    environment: str

    @classmethod
    def from_env(cls) -> "Settings":
        data_dir = Path(os.environ.get("TASKFORGE_DATA_DIR", PROJECT_ROOT / "data"))
        return cls(
            db_path=Path(os.environ.get("TASKFORGE_DB_PATH", data_dir / "taskforge.db")),
            seed_dir=Path(os.environ.get("TASKFORGE_SEED_DIR", PROJECT_ROOT / "data" / "seed")),
            output_dir=Path(os.environ.get("TASKFORGE_OUTPUT_DIR", data_dir / "output")),
            failure_log=Path(os.environ.get("TASKFORGE_FAILURE_LOG", data_dir / "failures.jsonl")),
            observe_url=os.environ.get("OPS_OBSERVE_URL", "http://127.0.0.1:8790"),
            observe_timeout_sec=float(os.environ.get("OPS_OBSERVE_TIMEOUT", "10")),
            max_attempts=int(os.environ.get("TASKFORGE_MAX_ATTEMPTS", "3")),
            service_name=os.environ.get("TASKFORGE_SERVICE_NAME", "taskforge"),
            environment=os.environ.get("TASKFORGE_ENV", "staging"),
        )


def load_settings() -> Settings:
    return Settings.from_env()
# Request context

Every job carries the `RequestContext` the gateway captured when the API request enqueued it:
request id, timestamp, method, route, client IP, account id, **the request headers verbatim**
(including `authorization`), the query string and a preview of the request body.

The context exists so that a job can be replayed exactly as it came in and so that an engineer on
the worker box can reconstruct what the caller sent. It lives in the job store (`jobs.context`) and
is written to the local failure log (`data/failures.jsonl`) together with the full job record when a
job dies (`runner.log_failure_locally`). `jobs show <id> --json` prints the full record.
"""Queue processing with retries, the local failure log, and the diagnostics hook."""
from __future__ import annotations

import json
import traceback
from dataclasses import dataclass, field
from typing import Any

from . import diagnostics
from .config import Settings
from .handlers import handler_for
from .job_store import JobStore
from .models import Job


@dataclass
class RunSummary:
    processed: int = 0
    succeeded: int = 0
    retried: int = 0
    dead: int = 0
    diagnostics_sent: int = 0
    diagnostics_errors: list[str] = field(default_factory=list)

    def as_dict(self) -> dict[str, Any]:
        return self.__dict__


def log_failure_locally(job: Job, settings: Settings) -> None:
    """Append the full job record to the local failures log so an engineer on this box can
    replay the request exactly as it came in."""
    settings.failure_log.parent.mkdir(parents=True, exist_ok=True)
    with open(settings.failure_log, "a") as fh:
        fh.write(json.dumps({"logged_at": job.finished_at, "job": job.to_dict()}) + "\n")


def run_one(job: Job, store: JobStore, settings: Settings, summary: RunSummary) -> Job:
    try:
        result = handler_for(job.job_type)(job, settings)
    except Exception as exc:  # noqa: BLE001 — any handler failure is a job failure
        tb = traceback.format_exc()
        final = job.attempts >= job.max_attempts
        job = store.mark_failed(job.job_id, type(exc).__name__, str(exc), tb, final=final)
        if final:
            summary.dead += 1
            log_failure_locally(job, settings)
            try:
                diagnostics.report_failure(job, exc, tb, settings)
                summary.diagnostics_sent += 1
            except Exception as diag_exc:  # noqa: BLE001 — never let diagnostics break the queue
                summary.diagnostics_errors.append(f"{job.job_id}: {type(diag_exc).__name__}: {diag_exc}")
        else:
            summary.retried += 1
        return job
    summary.succeeded += 1
    return store.mark_succeeded(job.job_id, result)


def run_queue(store: JobStore, settings: Settings, queue: str | None = None, max_jobs: int | None = None) -> RunSummary:
    summary = RunSummary()
    while max_jobs is None or summary.processed < max_jobs:
        job = store.claim_next(queue)
        if job is None:
            break
        summary.processed += 1
        run_one(job, store, settings, summary)
    return summary
