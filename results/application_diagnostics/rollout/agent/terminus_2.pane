import json

from taskforge.diagnostics import stack_summary, truncate
from taskforge.runner import run_queue


def test_run_queue_processes_everything(store, settings):
    summary = run_queue(store, settings)
    counts = store.counts()
    assert summary.processed == 34 + summary.retried
    assert counts.get("pending", 0) == 0 and counts["succeeded"] == 27 and counts["dead"] == 7
    assert summary.dead == 7 and summary.succeeded == 27
    assert len(summary.diagnostics_errors) == 7  # diagnostics not wired yet


def test_failure_log_has_full_record(store, settings):
    run_queue(store, settings)
    lines = [json.loads(l) for l in settings.failure_log.read_text().splitlines()]
    assert len(lines) == 7 and all(l["job"]["status"] == "dead" and "context" in l["job"] for l in lines)


def test_dead_jobs_have_error_details(store, settings):
    run_queue(store, settings, queue="webhooks")
    dead = store.list(status="dead")
    assert len(dead) == 3 and all(j.last_error_type == "DeliveryError" and j.attempts == j.max_attempts for j in dead)
    breakdown = store.failure_breakdown()
    assert breakdown == {"by_error_type": {"DeliveryError": 3}, "by_queue": {"webhooks": 3}}


def test_stack_summary_and_truncate():
    tb = 'Traceback (most recent call last):\n  File "/app/taskforge/runner.py", line 40, in run_one\n    result = handler_for(job.job_type)(job, settings)\n  File "/app/taskforge/handlers.py", line 50, in deliver_webhook\n    raise DeliveryError("x")\ntaskforge.handlers.DeliveryError: x\n'
    frames = stack_summary(tb)
    assert frames == [{"file": "runner.py", "line": 40, "function": "run_one"}, {"file": "handlers.py", "line": 50, "function": "deliver_webhook"}]
    assert truncate("a" * 600).endswith("…") and len(truncate("a" * 600)) == 500
import pytest

from taskforge.handlers import DeliveryError, ImportValidationError, RenderError, UnknownJobType, deliver_webhook, handler_for, import_contacts, render_report
from taskforge.models import Job, RequestContext

CTX = RequestContext("req_1", "2025-11-10T08:00:00Z", "POST", "/v2/x", "203.0.113.1", "acct_test", {}, {}, "")


def _job(job_type, payload):
    return Job("job_t", job_type, "q", "running", payload, CTX, attempts=1)


def test_webhook_delivery_writes_file(settings):
    res = deliver_webhook(_job("webhook.deliver", {"url": "https://hooks.example/x", "event": {"type": "a"}}), settings)
    assert res["delivered_to"] == "hooks.example" and (settings.output_dir / "webhooks" / "job_t.json").exists()


@pytest.mark.parametrize("payload", [{"url": "http://plain.example", "event": {"type": "a"}}, {"url": "https://x.invalid/y", "event": {"type": "a"}}, {"url": "https://ok.example", "event": {}}])
def test_webhook_delivery_errors(settings, payload):
    with pytest.raises(DeliveryError):
        deliver_webhook(_job("webhook.deliver", payload), settings)


def test_render_report(settings):
    res = render_report(_job("report.render", {"report": "monthly-usage", "period": "2025-10", "rows": [{"metric": "a", "value": 1}]}), settings)
    assert res["rows"] == 1 and "monthly-usage-acct_test-2025-10.csv" in res["path"]
    with pytest.raises(RenderError):
        render_report(_job("report.render", {"period": "2025/10"}), settings)


def test_import_contacts(settings):
    good = [{"name": "A", "email": "a@b.example"}]
    assert import_contacts(_job("contacts.import", {"rows": good}), settings)["imported"] == 1
    with pytest.raises(ImportValidationError):
        import_contacts(_job("contacts.import", {"rows": good + [{"email": "nope"}]}), settings)
    with pytest.raises(ImportValidationError):
        import_contacts(_job("contacts.import", {"rows": []}), settings)


def test_unknown_handler():
    with pytest.raises(UnknownJobType):
        handler_for("nope")
import pytest

from taskforge.models import RequestContext


def test_seed_loads(store):
    assert store.counts() == {"pending": 34}
    job = store.get("job_0001")
    assert job.status == "pending" and job.attempts == 0 and job.context.account_id.startswith("acct_")


def test_claim_order_and_attempts(store):
    first = store.claim_next()
    assert first is not None and first.status == "running" and first.attempts == 1
    assert store.claim_next("imports").queue == "imports"


def test_mark_failed_retry_vs_dead(store):
    job = store.claim_next()
    j = store.mark_failed(job.job_id, "DeliveryError", "boom", "Traceback...", final=False)
    assert j.status == "pending" and j.last_error_type == "DeliveryError"
    j = store.mark_failed(job.job_id, "DeliveryError", "boom", "Traceback...", final=True)
    assert j.status == "dead"


def test_enqueue_roundtrip(store):
    ctx = RequestContext("req_x", "2025-11-10T08:00:00Z", "POST", "/v2/x", "203.0.113.1", "acct_test", {"user-agent": "t"}, {}, "{}")
    job = store.enqueue("job_new", "report.render", "reports", {"period": "2025-10", "rows": []}, ctx)
    assert job.context == ctx and job.to_dict()["context"]["route"] == "/v2/x"
    with pytest.raises(KeyError):
        store.get("job_missing")


def test_requeue_dead_job(store):
    job = store.claim_next()
    store.mark_failed(job.job_id, "DeliveryError", "boom", "tb", final=True)
    again = store.requeue(job.job_id)
    assert again.status == "pending" and again.attempts == 0 and again.finished_at is None
    with pytest.raises(ValueError):
        store.requeue(store.claim_next().job_id)
