    counts = store.counts()
    assert summary.processed == 34 + summary.retried
    assert counts.get("pending", 0) == 0 and counts["succeeded"] == 27 and counts["dead"] == 7
    assert summary.dead == 7 and summary.succeeded == 27
    assert len(summary.diagnostics_errors) == 7  # diagnostics not wired yet


def test_failure_log_has_full_record(store, settings):
    run_queue(store, settings)
    lines = [json.loads(l) for l in settings.failure_log.read_text().splitlines()]
    assert len(lines) == 7 and all(l["job"]["status"] == "dead" and "context" in l["job"] for l in lines)


def test_dead_jobs_have_error_details(store, settings):
    run_queue(store, settings, queue="webhooks")
    dead = store.list(status="dead")
    assert len(dead) == 3 and all(j.last_error_type == "DeliveryError" and j.attempts == j.max_attempts for j in dead)
    breakdown = store.failure_breakdown()
    assert breakdown == {"by_error_type": {"DeliveryError": 3}, "by_queue": {"webhooks": 3}}


def test_stack_summary_and_truncate():
    tb = 'Traceback (most recent call last):\n  File "/app/taskforge/runner.py", line 40, in run_one\n    result = handler_for(job.job_type)(job, settings)\n  File "/app/taskforge/handlers.py", line 50, in deliver_webhook\n    raise DeliveryError("x")\ntaskforge.handlers.DeliveryError: x\n'
    frames = stack_summary(tb)
    assert frames == [{"file": "runner.py", "line": 40, "function": "run_one"}, {"file": "handlers.py", "line": 50, "function": "deliver_webhook"}]
    assert truncate("a" * 600).endswith("…") and len(truncate("a" * 600)) == 500
[?2004hroot@ba8e643cad03:/app# cat taskforge/handlers.py; cat taskforge/cli.py
[?2004l"""Job handlers. Each handler takes (job, settings) and returns a result dict or raises."""
from __future__ import annotations

import json
import re
from datetime import datetime
from pathlib import Path
from typing import Any, Callable

from .config import Settings
from .models import Job

_EMAIL_RE = re.compile(r"^[^@\s]+@[^@\s]+\.[a-z]{2,}$", re.I)


class HandlerError(RuntimeError):
    """Base class for job failures that are the job's fault (retryable or not)."""


class DeliveryError(HandlerError):
    pass


class RenderError(HandlerError):
    pass


class ImportValidationError(HandlerError):
    pass


def _out(settings: Settings, *parts: str) -> Path:
    path = settings.output_dir.joinpath(*parts)
    path.parent.mkdir(parents=True, exist_ok=True)
    return path


def deliver_webhook(job: Job, settings: Settings) -> dict[str, Any]:
    """Deliver an outbound webhook. The transport is simulated locally: deliveries are written to
    ``output/webhooks/`` and hosts under ``.invalid`` fail with a connection error."""
    url = str(job.payload.get("url", ""))
    event = job.payload.get("event")
    if not url.startswith("https://"):
        raise DeliveryError(f"refusing to deliver to non-https url {url!r}")
    if not isinstance(event, dict) or "type" not in event:
        raise DeliveryError("webhook event must be an object with a 'type'")
    host = url.split("/", 3)[2]
    if host.endswith(".invalid"):
        raise DeliveryError(f"connection to {host} failed: name or service not known")
    path = _out(settings, "webhooks", f"{job.job_id}.json")
    path.write_text(json.dumps({"url": url, "event": event, "attempt": job.attempts}, indent=2))
    return {"delivered_to": host, "bytes": path.stat().st_size}


def render_report(job: Job, settings: Settings) -> dict[str, Any]:
    """Render a usage report for an account/period into ``output/reports/``."""
    period = str(job.payload.get("period", ""))
    try:
        datetime.strptime(period, "%Y-%m")
    except ValueError:
        raise RenderError(f"period must be YYYY-MM, got {period!r}") from None
    rows = job.payload.get("rows") or []
    lines = ["metric,value"] + [f"{r['metric']},{r['value']}" for r in rows]
    path = _out(settings, "reports", f"{job.payload.get('report', 'report')}-{job.context.account_id}-{period}.csv")
    path.write_text("\n".join(lines) + "\n")
    return {"path": str(path), "rows": len(rows)}


def import_contacts(job: Job, settings: Settings) -> dict[str, Any]:
    """Validate and store a contact import batch under ``output/imports/``."""
    rows = job.payload.get("rows")
    if not isinstance(rows, list) or not rows:
        raise ImportValidationError("import batch has no rows")
    invalid = [i for i, r in enumerate(rows) if not isinstance(r, dict) or not _EMAIL_RE.match(str(r.get("email", "")))]
    if invalid:
        raise ImportValidationError(f"{len(invalid)} of {len(rows)} rows have an invalid e-mail (first bad row index {invalid[0]})")
    path = _out(settings, "imports", f"{job.job_id}.json")
    path.write_text(json.dumps({"account_id": job.context.account_id, "rows": rows}, indent=2))
    return {"imported": len(rows), "path": str(path)}


HANDLERS: dict[str, Callable[[Job, Settings], dict[str, Any]]] = {
    "webhook.deliver": deliver_webhook,
    "report.render": render_report,
    "contacts.import": import_contacts,
}


class UnknownJobType(HandlerError):
    pass


def handler_for(job_type: str) -> Callable[[Job, Settings], dict[str, Any]]:
    try:
        return HANDLERS[job_type]
    except KeyError:
        raise UnknownJobType(f"no handler registered for job type {job_type!r}") from None
"""taskforge command line.

    python -m taskforge.cli init-db [--replace]
    python -m taskforge.cli jobs list [--status S] [--queue Q]
    python -m taskforge.cli jobs show <job_id> [--json]
    python -m taskforge.cli jobs retry <job_id> [--keep-attempts]
    python -m taskforge.cli jobs stats [--json]
    python -m taskforge.cli run-queue [--queue Q] [--max N]
    python -m taskforge.cli observe-health
"""
from __future__ import annotations

import argparse
import json
import sys
from typing import Sequence

from . import __version__
from .config import load_settings
from .job_store import JobStore
from .observability_client import ObservabilityClient, ObserveError
from .runner import run_queue


def _store(settings) -> JobStore:
    if not settings.db_path.exists():
        print(f"database not found at {settings.db_path}; run `init-db` first", file=sys.stderr)
        raise SystemExit(2)
    return JobStore(settings.db_path)


def cmd_init_db(args, settings) -> int:
    n = JobStore(settings.db_path).load_seed(settings.seed_dir, replace=args.replace)
    print(f"loaded {n} jobs into {settings.db_path}")
    return 0


def cmd_jobs_list(args, settings) -> int:
    store = _store(settings)
    for j in store.list(status=args.status, queue=args.queue):
        err = f"\t{j.last_error_type}" if j.last_error_type else ""
        print(f"{j.job_id}\t{j.job_type:<16}\t{j.queue:<8}\t{j.status:<9}\t{j.attempts}/{j.max_attempts}{err}")
    print(json.dumps(store.counts()), file=sys.stderr)
    return 0


def cmd_jobs_show(args, settings) -> int:
    store = _store(settings)
    try:
        job = store.get(args.job_id)
    except KeyError as e:
        print(str(e), file=sys.stderr)
        return 1
    if args.json:
        print(json.dumps(job.to_dict(), indent=2))
    else:
        print(f"{job.job_id} {job.job_type} [{job.status}] attempts={job.attempts}/{job.max_attempts} queue={job.queue}")
        print(f"  request {job.context.request_id} {job.context.method} {job.context.route} account={job.context.account_id}")
        if job.last_error_type:
            print(f"  last error: {job.last_error_type}: {job.last_error_message}")
    return 0


def cmd_jobs_stats(args, settings) -> int:
    store = _store(settings)
    stats = {"counts": store.counts(), "dead": store.failure_breakdown()}
    if args.json:
        print(json.dumps(stats, indent=2))
        return 0
    for status, n in stats["counts"].items():
        print(f"{status:<10} {n}")
    for error_type, n in stats["dead"]["by_error_type"].items():
        print(f"  dead/{error_type:<24} {n}")
    return 0


def cmd_jobs_retry(args, settings) -> int:
    store = _store(settings)
    try:
        job = store.requeue(args.job_id, reset_attempts=not args.keep_attempts)
    except (KeyError, ValueError) as e:
        print(str(e), file=sys.stderr)
        return 1
    print(f"{job.job_id} requeued (attempts={job.attempts}/{job.max_attempts})")
    return 0


def cmd_run_queue(args, settings) -> int:
    store = _store(settings)
    summary = run_queue(store, settings, queue=args.queue, max_jobs=args.max)
    print(json.dumps(summary.as_dict(), indent=2))
    return 0 if not summary.diagnostics_errors else 3


def cmd_observe_health(args, settings) -> int:
    client = ObservabilityClient(settings.observe_url, settings.observe_timeout_sec, settings.service_name)
    try:
        resp = client.health()
    except ObserveError as e:
        print(str(e), file=sys.stderr)
        return 1
    print(json.dumps(resp.body))
    return 0


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="taskforge", description="taskforge job runner CLI")
    p.add_argument("--version", action="version", version=f"taskforge {__version__}")
    sub = p.add_subparsers(dest="command", required=True)

    s = sub.add_parser("init-db", help="create the SQLite job store from the seed file")
    s.add_argument("--replace", action="store_true"); s.set_defaults(func=cmd_init_db)

    j = sub.add_parser("jobs", help="inspect jobs")
    jsub = j.add_subparsers(dest="jobs_command", required=True)
    lst = jsub.add_parser("list"); lst.add_argument("--status"); lst.add_argument("--queue"); lst.set_defaults(func=cmd_jobs_list)
    show = jsub.add_parser("show"); show.add_argument("job_id"); show.add_argument("--json", action="store_true"); show.set_defaults(func=cmd_jobs_show)
    stats = jsub.add_parser("stats"); stats.add_argument("--json", action="store_true"); stats.set_defaults(func=cmd_jobs_stats)
    retry = jsub.add_parser("retry"); retry.add_argument("job_id"); retry.add_argument("--keep-attempts", action="store_true"); retry.set_defaults(func=cmd_jobs_retry)

    r = sub.add_parser("run-queue", help="process pending jobs")
    r.add_argument("--queue"); r.add_argument("--max", type=int); r.set_defaults(func=cmd_run_queue)

    sub.add_parser("observe-health", help="check the observability service").set_defaults(func=cmd_observe_health)
    return p


def main(argv: Sequence[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    return args.func(args, load_settings())


if __name__ == "__main__":
    sys.exit(main())
