[68.393351, "o", "\u001b[?2004l\r"]
[68.394295, "o", "\u001b[?2004h>         assert record == job.to_dict()\r\n\u001b[?2004l\r\u001b[?2004h>         assert job.status == 'dead' and job.attempts == job.max_attempts\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.394491, "o", "        assert job.last_error_type and job.last_traceback\r\n\u001b[?2004l\r"]
[68.394574, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[68.394647, "o", "\u001b[?2004h> "]
[68.394791, "o", "    if outcome == 'accepted':\r\n\u001b[?2004l\r"]
[68.394863, "o", "\u001b[?2004h"]
[68.394965, "o", "> "]
[68.395076, "o", "        assert result == 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.39562, "o", "        assert summary['diagnostics_sent'] == 7 and summary['diagnostics_errors'] == []\r\n\u001b[?2004l\r"]
[68.395699, "o", "\u001b[?2004h> "]
[68.395755, "o", "    else:\r\n\u001b[?2004l\r"]
[68.395802, "o", "\u001b[?2004h"]
[68.395839, "o", "> "]
[68.395988, "o", "        assert result == 3\r\n\u001b[?2004l\r"]
[68.396032, "o", "\u001b[?2004h"]
[68.396085, "o", "> "]
[68.396608, "o", "        assert summary['diagnostics_sent'] == 0 and len(summary['diagnostics_errors']) == 7\r\n\u001b[?2004l\r"]
[68.396742, "o", "\u001b[?2004h"]
[68.396867, "o", "> "]
[68.397149, "o", "        detail = 'rejected events (422)' if outcome == 'rejected' else 'unreachable'\r\n\u001b[?2004l\r"]
[68.397239, "o", "\u001b[?2004h> "]
[68.397669, "o", "        for error, record in zip(summary['diagnostics_errors'], logged):\r\n\u001b[?2004l\r"]
[68.397855, "o", "\u001b[?2004h> "]
[68.398234, "o", "            assert error.startswith(record['job_id'] + ': ObserveError:') and detail in error\r\n\u001b[?2004l\r"]
[68.398355, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[68.398448, "o", "\u001b[?2004h> "]
[68.398818, "o", "    # Only final failures generate events, never successful jobs or retry attempts.\r\n\u001b[?2004l\r"]
[68.398898, "o", "\u001b[?2004h> "]
[68.399434, "o", "    assert len(observe_server.requests) == (0 if outcome == 'unreachable' else 7)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.39973, "o", "    for path, headers, body in observe_server.requests:\r\n\u001b[?2004l\r"]
[68.39981, "o", "\u001b[?2004h> "]
[68.399994, "o", "        assert path == '/v1/events'\r\n\u001b[?2004l\r"]
[68.400163, "o", "\u001b[?2004h"]
[68.40019, "o", "> "]
[68.400431, "o", "        assert headers['Content-Type'] == 'application/x-ndjson'\r\n\u001b[?2004l\r"]
[68.400533, "o", "\u001b[?2004h> "]
[68.400852, "o", "        assert headers['X-Service'] == settings.service_name\r\n\u001b[?2004l\r"]
[68.400881, "o", "\u001b[?2004h"]
[68.401074, "o", "> "]
[68.401383, "o", "        assert body.endswith(b'\\\\n') and len(body.splitlines()) == 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.401519, "o", "> "]
[68.401661, "o", "        event = json.loads(body)\r\n\u001b[?2004l\r"]
[68.401764, "o", "\u001b[?2004h> "]
[68.401986, "o", "        job = store.get(event['job_id'])\r\n\u001b[?2004l\r"]
[68.402135, "o", "\u001b[?2004h> "]
[68.402403, "o", "        assert event['event_type'] == 'job.failed'\r\n\u001b[?2004l\r"]
[68.402537, "o", "\u001b[?2004h> "]
[68.403093, "o", "        assert event['failed_at'] == job.finished_at and event['attempt'] == job.attempts\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.403217, "o", "> "]
[68.403504, "o", "        assert event['error_type'] == job.last_error_type\r\n\u001b[?2004l\r"]
[68.403722, "o", "\u001b[?2004h> "]
[68.404065, "o", "        assert event['error_message'] == truncate(job.last_error_message)\r\n\u001b[?2004l\r"]
[68.404277, "o", "\u001b[?2004h> "]
[68.404531, "o", "        assert event['duration_ms'] == job.duration_ms\r\n\u001b[?2004l\r"]
[68.40468, "o", "\u001b[?2004h> "]
[68.405097, "o", "        assert event['stack_summary'] == stack_summary(job.last_traceback)\r\n\u001b[?2004l\r"]
[68.405208, "o", "\u001b[?2004h> "]
[68.405415, "o", "        assert event['request'] == {\r\n\u001b[?2004l\r"]
[68.40546, "o", "\u001b[?2004h"]
[68.405495, "o", "> "]
[68.405806, "o", "            'request_id': job.context.request_id,\r\n\u001b[?2004l\r"]
[68.405958, "o", "\u001b[?2004h> "]
[68.406198, "o", "            'account_id': job.context.account_id,\r\n\u001b[?2004l\r"]
[68.406357, "o", "\u001b[?2004h> "]
[68.406567, "o", "            'route': job.context.route,\r\n\u001b[?2004l\r"]
[68.406751, "o", "\u001b[?2004h>         }\r\n"]
[68.406868, "o", "\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.407, "o", "p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.407247, "o", "p = Path('docs/request_context.md')\r\n\u001b[?2004l\r"]
[68.407397, "o", "\u001b[?2004h> "]
[68.4088, "o", "p.write_text(p.read_text() + '\\nFailure diagnostics sent to ops-observe include only `request_id`, `account_id`, and `route`\\nfrom this context. Headers, query parameters, body previews, and the job payload stay local;\\nthey are not needed for alerting or locating the originating trace.\\n')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[68.524551, "o", "\u001b[?2004hroot@ba8e643cad03:/app# "]
