[93.303277, "o", "{\r\n  \"processed\": 46,\r\n  \"succeeded\": 27,\r\n  \"retried\": 12,\r\n  \"dead\": 7,\r\n  \"diagnostics_sent\": 7,\r\n  \"diagnostics_errors\": []\r\n}\r\n"]
[93.324111, "o", "run-queue exit status: 0\r\n\u001b[?2004hroot@ba8e643cad03:/app# "]
[93.788931, "i", "python -m taskforge.cli jobs stats --json; python - <<'PY'\nimport base64\nimport json\nfrom pathlib import Path\nfrom taskforge.config import load_settings\nfrom taskforge.job_store import JobStore\n\nsettings = load_settings()\nstore = JobStore(settings.db_path)\nevents = []\nfor path in sorted(Path('/var/lib/ops-observe/received').glob('*.json')):\n    record = json.loads(path.read_text())\n    assert record['path'] == '/v1/events'\n    assert record['headers']['content-type'] == 'application/x-ndjson'\n    for line in base64.b64decode(record['body_b64']).splitlines():\n        events.append(json.loads(line))\ndead = store.list(status='dead')\nassert len(events) == len(dead) == 7\nassert {event['job_id'] for event in events} == {job.job_id for job in dead}\nfor event in events:\n    assert event['event_type'] == 'job.failed'\n    assert set(event['request']) == {'request_id', 'account_id', 'route'}\n    assert len(event['error_message']) <= 500 and len(event['stack_summary']) <= 5\n    print(f\"Received {event['job_id']}: {event['job_type']} / {event['error_type']} (attempt {event['attempt']})\")\nlogged = [json.loads(line) for line in settings.failure_log.read_text().splitlines()]\nassert {entry['job']['job_id'] for entry in logged} >= {job.job_id for job in dead}\nprint('Verified: all 7 dead seed jobs received by ops-observe and retained in the local failure log.')\nstore.close()\nPY\n"]
[93.78932, "o", "python -m taskforge.cli jobs stats --json; python - <<'PY'\r\n\u001b[?2004l\r"]
