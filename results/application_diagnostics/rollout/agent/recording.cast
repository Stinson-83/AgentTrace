[12.489583, "o", "import sys\r\nfrom pathlib import Path\r\n\r\nimport pytest\r\n\r\nROOT = Path(__file__).resolve().parents[1]\r\nsys.path.insert(0, str(ROOT))\r\n\r\nfrom taskforge.config import Settings  # noqa: E402\r\nfrom taskforge.job_store import JobStore  # noqa: E402\r\n\r\n\r\n@pytest.fixture()\r\ndef settings(tmp_path):\r\n    return Settings(db_path=tmp_path / \"jobs.db\", seed_dir=ROOT / \"data\" / \"seed\", output_dir=tmp_path / \"out\",\r\n                    failure_log=tmp_path / \"failures.jsonl\", observe_url=\"http://127.0.0.1:1\", observe_timeout_sec=1,\r\n                    max_attempts=3, service_name=\"taskforge-test\", environment=\"test\")\r\n\r\n\r\n@pytest.fixture()\r\ndef store(settings):\r\n    s = JobStore(settings.db_path)\r\n    s.load_seed(settings.seed_dir)\r\n    yield s\r\n    s.close()\r\n"]
[12.48979, "o", "import json\r\n\r\nfrom taskforge.diagnostics import stack_summary, truncate\r\nfrom taskforge.runner import run_queue\r\n\r\n\r\ndef test_run_queue_processes_everything(store, settings):\r\n    summary = run_queue(store, settings)\r\n    counts = store.counts()\r\n    assert summary.processed == 34 + summary.retried\r\n    assert counts.get(\"pending\", 0) == 0 and counts[\"succeeded\"] == 27 and counts[\"dead\"] == 7\r\n    assert summary.dead == 7 and summary.succeeded == 27\r\n    assert len(summary.diagnostics_errors) == 7  # diagnostics not wired yet\r\n\r\n\r\ndef test_failure_log_has_full_record(store, settings):\r\n    run_queue(store, settings)\r\n    lines = [json.loads(l) for l in settings.failure_log.read_text().splitlines()]\r\n    assert len(lines) == 7 and all(l[\"job\"][\"status\"] == \"dead\" and \"context\" in l[\"job\"] for l in lines)\r\n\r\n\r\ndef test_dead_jobs_have_error_details(store, settings):\r\n    run_queue(store, settings, queue=\"webhooks\")\r\n    dead = store.list(status=\"dead\")\r\n    assert len(dead) == 3 and all(j.last_error_type == \"DeliveryError\" and j.attempts == j.max_attempts for j in dead)\r\n    breakdown = store.failure_breakdown()\r\n    assert breakdown == {\"by_error_type\": {\"DeliveryError\": 3}, \"by_queue\": {\"webhooks\": 3}}\r\n\r\n\r\ndef test_stack_summary_and_truncate():\r\n    tb = 'Traceback (most recent call last):\\n  File \"/app/taskforge/runner.py\", line 40, in run_one\\n    result = handler_for(job.job_type)(job, settings)\\n  File \"/app/taskforge/handlers.py\", line 50, in deliver_webhook\\n    raise DeliveryError(\"x\")\\ntaskforge.handlers.DeliveryError: x\\n'\r\n    frames = stack_summary(tb)\r\n    assert frames == [{\"file\": \"runner.py\", \"line\": 40, \"function\": \"run_one\"}, {\"file\": \"handlers.py\", \"line\": 50, \"function\": \"deliver_webhook\"}]\r\n    assert truncate(\"a\" * 600).endswith(\"…\") and len(truncate(\"a\" * 600)) == 500\r\nimport pytest\r\n\r\nfrom taskforge.handlers import DeliveryError, ImportValidationError, RenderError, UnknownJobType, deliver_webhook, handler_for, import_contacts, render_report\r\nfrom taskforge.models import Job, RequestContext\r\n\r\nCTX = RequestContext(\"req_1\", \"2025-11-10T08:00:00Z\", \"POST\", \"/v2/x\", \"203.0.113.1\", \"acct_test\", {}, {}, \"\")\r\n\r\n\r\ndef _job(job_type, payload):\r\n    return Job(\"job_t\", job_type, \"q\", \"running\", payload, CTX, attempts=1)\r\n\r\n\r\ndef test_webhook_delivery_writes_file(settings):\r\n    res = deliver_webhook(_job(\"webhook.deliver\", {\"url\": \"https://hooks.example/x\", \"event\": {\"type\": \"a\"}}), settings)\r\n    assert res[\"delivered_to\"] == \"hooks.example\" and (settings.output_dir / \"webhooks\" / \"job_t.json\").exists()\r\n\r\n\r\n@pytest.mark.parametrize(\"payload\", [{\"url\": \"http://plain.example\", \"event\": {\"type\": \"a\"}}, {\"url\": \"https://x.invalid/y\", \"event\": {\"type\": \"a\"}}, {\"url\": \"https://ok.example\", \"event\": {}}])\r\ndef test_webhook_delivery_errors(settings, payload):\r\n    with pytest.raises(DeliveryError):\r\n        deliver_webhook(_job(\"webhook.deliver\", payload), settings)\r\n\r\n\r\ndef test_render_report(settings):\r\n    res = render_report(_job(\"report.render\", {\"report\": \"monthly-usage\", \"period\": \"2025-10\", \"rows\": [{\"metric\": \"a\", \"value\": 1}]}), settings)\r\n    assert res[\"rows\"] == 1 and \"monthly-usage-acct_test-2025-10.csv\" in res[\"path\"]\r\n    with pytest.raises(RenderError):\r\n        render_report(_job(\"report.render\", {\"period\": \"2025/10\"}), settings)\r\n\r\n\r\ndef test_import_contacts(settings):\r\n    good = [{\"name\": \"A\", \"email\": \"a@b.example\"}]\r\n    assert import_contacts(_job(\"contacts.import\", {\"rows\": good}), settings)[\"imported\"] == 1\r\n    with pytest.raises(ImportValidationError):\r\n        import_contacts(_job(\"contacts.import\", {\"rows\": good + [{\"email\": \"nope\"}]}), settings)\r\n    with pytest.raises(ImportValidationError):\r\n        import_contacts(_job(\"contacts.import\", {\"rows\": []}), settings)\r\n\r\n\r\ndef test_unknown_handler():\r\n    with pytest.raises(UnknownJobType):\r\n        handler_for(\"nope\")\r\nimport pytest\r\n\r\nfrom taskforge.models import RequestContext\r\n\r\n\r\ndef test_seed_loads(store):\r\n    assert store.counts() == {\"pending\": 34}\r\n    job = store.get(\"job_0001\")\r\n    assert job.status == \"pending\" and job"]
[12.489859, "o", ".attempts == 0 and job.context.account_id.startswith(\"acct_\")\r\n\r\n\r\ndef test_claim_order_and_attempts(store):\r\n    first = store.claim_next()\r\n    assert first is not None and first.status == \"running\" and first.attempts == 1\r\n    assert store.claim_next(\"imports\").queue == \"imports\"\r\n\r\n\r\ndef test_mark_failed_retry_vs_dead(store):\r\n    job = store.claim_next()\r\n    j = store.mark_failed(job.job_id, \"DeliveryError\", \"boom\", \"Traceback...\", final=False)\r\n    assert j.status == \"pending\" and j.last_error_type == \"DeliveryError\"\r\n    j = store.mark_failed(job.job_id, \"DeliveryError\", \"boom\", \"Traceback...\", final=True)\r\n    assert j.status == \"dead\"\r\n\r\n\r\ndef test_enqueue_roundtrip(store):\r\n    ctx = RequestContext(\"req_x\", \"2025-11-10T08:00:00Z\", \"POST\", \"/v2/x\", \"203.0.113.1\", \"acct_test\", {\"user-agent\": \"t\"}, {}, \"{}\")\r\n    job = store.enqueue(\"job_new\", \"report.render\", \"reports\", {\"period\": \"2025-10\", \"rows\": []}, ctx)\r\n    assert job.context == ctx and job.to_dict()[\"context\"][\"route\"] == \"/v2/x\"\r\n    with pytest.raises(KeyError):\r\n        store.get(\"job_missing\")\r\n\r\n\r\ndef test_requeue_dead_job(store):\r\n    job = store.claim_next()\r\n    store.mark_failed(job.job_id, \"DeliveryError\", \"boom\", \"tb\", final=True)\r\n    again = store.requeue(job.job_id)\r\n    assert again.status == \"pending\" and again.attempts == 0 and again.finished_at is None\r\n    with pytest.raises(ValueError):\r\n        store.requeue(store.claim_next().job_id)\r\n\u001b[?2004hroot@ba8e643cad03:/app# "]
