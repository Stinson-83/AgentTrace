[68.352987, "i", "cat >> tests/conftest.py <<'PY'\n\n\n@pytest.fixture()\ndef observe_server():\n    \"\"\"Isolated ops-observe stand-in; never sends test events to the dev service.\"\"\"\n    import json\n    import threading\n    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\n    from types import SimpleNamespace\n\n    state = SimpleNamespace(status=202, requests=[])\n\n    class Handler(BaseHTTPRequestHandler):\n        def do_POST(self):\n            body = self.rfile.read(int(self.headers['Content-Length']))\n            state.requests.append((self.path, dict(self.headers), body))\n            response = {\"ingested\": 1} if state.status == 202 else {\"error\": \"rejected for test\"}\n            data = json.dumps(response).encode()\n            self.send_response(state.status)\n            self.send_header('Content-Type', 'application/json')\n            self.send_header('Content-Length', str(len(data)))\n            self.end_headers()\n            self.wfile.write(data)\n\n        def log_message(self, *args):\n            pass\n\n    server = ThreadingHTTPServer(('127.0.0.1', 0), Handler)\n    state.url = f'http://127.0.0.1:{server.server_port}'\n    thread = threading.Thread(target=server.serve_forever, daemon=True)\n    thread.start()\n    try:\n        yield state\n    finally:\n        server.shutdown()\n        server.server_close()\n        thread.join()\nPY\ncat > tests/test_diagnostics.py <<'PY'\nfrom unittest.mock import Mock\n\nimport pytest\n\nfrom taskforge import diagnostics\nfrom taskforge.models import Job, RequestContext\nfrom taskforge.observability_client import ObserveError\n\n\n@pytest.mark.parametrize('started_at, duration_ms', [('2025-11-10T08:00:00Z', 1250), (None, None)])\ndef test_report_failure_builds_and_sends_event(settings, monkeypatch, started_at, duration_ms):\n    context = RequestContext(\n        request_id='req_test', received_at='2025-11-10T07:59:00Z', method='POST',\n        route='/v2/imports', client_ip='203.0.113.10', account_id='acct_test',\n        headers={'authorization': 'Bearer secret', 'cookie': 'session=secret'},\n        query={'token': 'private-query'}, body_preview='private body',\n    )\n    job = Job(\n        'job_test', 'contacts.import', 'imports', 'dead', {'private': 'payload'}, context,\n        attempts=3, max_attempts=3, started_at=started_at, finished_at='2025-11-10T08:00:01.250Z',\n    )\n    tb = 'Traceback (most recent call last):\\n' + ''.join(\n        f'  File \"/private/path/frame{i}.py\", line {i + 1}, in function{i}\\n    private_source()\\n'\n        for i in range(7)\n    ) + 'ValueError: private exception tail\\n'\n    client_class = Mock()\n    monkeypatch.setattr(diagnostics, 'ObservabilityClient', client_class)\n\n    event = diagnostics.report_failure(job, ValueError('x' * 600), tb, settings)\n\n    assert event == {\n        'event_type': 'job.failed', 'service': settings.service_name, 'environment': settings.environment,\n        'job_id': 'job_test', 'job_type': 'contacts.import', 'queue': 'imports',\n        'failed_at': job.finished_at, 'attempt': 3, 'error_type': 'ValueError',\n        'error_message': 'x' * 499 + '…',\n        'stack_summary': [\n            {'file': f'frame{i}.py', 'line': i + 1, 'function': f'function{i}'} for i in range(2, 7)\n        ],\n        'request': {'request_id': 'req_test', 'account_id': 'acct_test', 'route': '/v2/imports'},\n        'duration_ms': duration_ms,\n    }\n    client_class.assert_called_once_with(\n        settings.observe_url, timeout_sec=settings.observe_timeout_sec, service_name=settings.service_name,\n    )\n    client_class.return_value.post_events.assert_called_once_with([event])\n    assert client_class.return_value.post_events.call_args.args[0][0] is event\n    # Exporting diagnostics must not strip the replay context from the local job.\n    assert job.context is context and job.payload == {'private': 'payload'}\n\n\ndef test_report_failure_propagates_send_errors(store, settings, monkeypatch):\n    client_class = Mock()\n    client_class.return_value.post_events.side_effect = ObserveError('unreachable')\n    monkeypatch.setattr(diagnostics, 'ObservabilityClient', client_class)\n   "]
[68.353141, "i", " job = store.claim_next()\n    with pytest.raises(ObserveError, match='unreachable'):\n        diagnostics.report_failure(job, RuntimeError('boom'), '', settings)\nPY\npython - <<'PY'\nfrom pathlib import Path\np = Path('tests/test_runner.py')\ns = p.read_text().replace('import json\\n', 'import json\\nfrom dataclasses import replace\\n\\nimport pytest\\n\\nfrom taskforge import cli\\n')\ns = s.replace('assert len(summary.diagnostics_errors) == 7  # diagnostics not wired yet', 'assert summary.diagnostics_sent == 0\\n    assert len(summary.diagnostics_errors) == 7  # fixture endpoint is unreachable\\n    assert all(\"ObserveError: ops-observe unreachable\" in e for e in summary.diagnostics_errors)')\ns += '''\n\n@pytest.mark.parametrize('outcome', ['accepted', 'rejected', 'unreachable'])\ndef test_cli_failure_diagnostics(store, settings, observe_server, monkeypatch, capsys, outcome):\n    observe_server.status = 422 if outcome == 'rejected' else 202\n    target = settings.observe_url if outcome == 'unreachable' else observe_server.url\n    settings = replace(settings, observe_url=target)\n    monkeypatch.setattr(cli, 'load_settings', lambda: settings)\n\n    result = cli.main(['run-queue'])\n    summary = json.loads(capsys.readouterr().out)\n\n    assert summary['dead'] == 7 and summary['succeeded'] == 27\n    assert store.counts() == {'dead': 7, 'succeeded': 27}\n    logged = [json.loads(line)['job'] for line in settings.failure_log.read_text().splitlines()]\n    assert len(logged) == 7\n    for record in logged:\n        job = store.get(record['job_id'])\n        assert record == job.to_dict()\n        assert job.status == 'dead' and job.attempts == job.max_attempts\n        assert job.last_error_type and job.last_traceback\n\n    if outcome == 'accepted':\n        assert result == 0\n        assert summary['diagnostics_sent'] == 7 and summary['diagnostics_errors'] == []\n    else:\n        assert result == 3\n        assert summary['diagnostics_sent'] == 0 and len(summary['diagnostics_errors']) == 7\n        detail = 'rejected events (422)' if outcome == 'rejected' else 'unreachable'\n        for error, record in zip(summary['diagnostics_errors'], logged):\n            assert error.startswith(record['job_id'] + ': ObserveError:') and detail in error\n\n    # Only final failures generate events, never successful jobs or retry attempts.\n    assert len(observe_server.requests) == (0 if outcome == 'unreachable' else 7)\n    for path, headers, body in observe_server.requests:\n        assert path == '/v1/events'\n        assert headers['Content-Type'] == 'application/x-ndjson'\n        assert headers['X-Service'] == settings.service_name\n        assert body.endswith(b'\\\\n') and len(body.splitlines()) == 1\n        event = json.loads(body)\n        job = store.get(event['job_id'])\n        assert event['event_type'] == 'job.failed'\n        assert event['failed_at'] == job.finished_at and event['attempt'] == job.attempts\n        assert event['error_type'] == job.last_error_type\n        assert event['error_message'] == truncate(job.last_error_message)\n        assert event['duration_ms'] == job.duration_ms\n        assert event['stack_summary'] == stack_summary(job.last_traceback)\n        assert event['request'] == {\n            'request_id': job.context.request_id,\n            'account_id': job.context.account_id,\n            'route': job.context.route,\n        }\n'''\np.write_text(s)\np = Path('docs/request_context.md')\np.write_text(p.read_text() + '\\nFailure diagnostics sent to ops-observe include only `request_id`, `account_id`, and `route`\\nfrom this context. Headers, query parameters, body previews, and the job payload stay local;\\nthey are not needed for alerting or locating the originating trace.\\n')\nPY\npython -m pytest -q tests\n"]
