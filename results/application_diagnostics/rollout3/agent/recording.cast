[87.336582, "o", "\"\"\"Failure diagnostics for the engineering observability service (ops-observe).\r\n\r\nSee docs/observability_events.md for the event contract.\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport re\r\nfrom typing import Any\r\n\r\nfrom .config import Settings\r\nfrom .models import Job\r\nfrom .observability_client import ObservabilityClient\r\n\r\n_FRAME_RE = re.compile(r'^\\s*File \"(?P<file>[^\"]+)\", line (?P<line>\\d+), in (?P<function>\\S+)')\r\n\r\n\r\ndef stack_summary(traceback_text: str, frames: int = 5) -> list[dict[str, Any]]:\r\n    \"\"\"The innermost ``frames`` frames of a formatted traceback as (file, line, function) entries,\r\n    innermost last. Only frame locations — never locals or source.\"\"\"\r\n    found = []\r\n    for line in traceback_text.splitlines():\r\n        m = _FRAME_RE.match(line)\r\n        if m:\r\n            found.append({\"file\": m.group(\"file\").split(\"/\")[-1], \"line\": int(m.group(\"line\")), \"function\": m.group(\"function\")})\r\n    return found[-frames:]\r\n\r\n\r\ndef truncate(text: str | None, limit: int = 500) -> str:\r\n    text = text or \"\"\r\n    return text if len(text) <= limit else text[: limit - 1] + \"…\"\r\n\r\n\r\ndef report_failure(job: Job, exc: BaseException, traceback_text: str, settings: Settings) -> dict[str, Any]:\r\n    \"\"\"Build the ``job.failed`` diagnostic event for a job that has exhausted its attempts and\r\n    send it to ops-observe. Returns the event that was sent.\r\n\r\n    Delivery errors propagate to the runner, which preserves the local failure record.\r\n    \"\"\"\r\n    event = {\r\n        \"event_type\": \"job.failed\",\r\n        \"service\": settings.service_name,\r\n        \"environment\": settings.environment,\r\n        \"job_id\": job.job_id,\r\n        \"job_type\": job.job_type,\r\n        \"queue\": job.queue,\r\n        \"failed_at\": job.finished_at,\r\n        \"attempt\": job.attempts,\r\n        \"error_type\": type(exc).__name__,\r\n        \"error_message\": truncate(str(exc)),\r\n        \"stack_summary\": stack_summary(traceback_text),\r\n        # Replay data (headers, query, body, payload) stays in the local failure log.\r\n        \"request\": {\r\n            \"request_id\": job.context.request_id,\r\n            \"account_id\": job.context.account_id,\r\n            \"route\": job.context.route,\r\n        },\r\n        \"duration_ms\": job.duration_ms,\r\n    }\r\n    client = ObservabilityClient(settings.observe_url, settings.observe_timeout_sec, settings.service_name)\r\n    client.post_events([event])\r\n    return event\r\n"]
[87.338246, "o", "#!/usr/bin/env python3\r\n\"\"\"Local stand-in for ops-observe, the engineering observability service.\r\n\r\nAccepts ``POST /v1/events`` as newline-delimited JSON (or a JSON array), validates each event\r\nhas an ``event_type``, and persists every request it receives (one JSON file per request) under\r\nits state directory, exactly as received. Nothing is forwarded.\r\n\r\n    python services/observability_service.py --port 8790 --state-dir /var/lib/ops-observe\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport argparse\r\nimport base64\r\nimport json\r\nimport os\r\nimport sys\r\nimport threading\r\n"]
[87.338338, "o", "import uuid\r\nfrom datetime import datetime, timezone\r\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\r\nfrom pathlib import Path\r\nfrom urllib.parse import urlsplit\r\n\r\nSERVICE_NAME = \"ops-observe\"\r\n_LOCK = threading.Lock()\r\n_SEQ = 0\r\n\r\n\r\ndef _now() -> str:\r\n    return datetime.now(timezone.utc).isoformat(timespec=\"microseconds\").replace(\"+00:00\", \"Z\")\r\n\r\n\r\ndef parse_events(body: bytes, content_type: str) -> list:\r\n    text = body.decode(\"utf-8\")\r\n    if \"ndjson\" in content_type or \"jsonl\" in content_type:\r\n        return [json.loads(line) for line in text.splitlines() if line.strip()]\r\n    doc = json.loads(text)\r\n    return doc if isinstance(doc, list) else [doc]\r\n\r\n\r\nclass Handler(BaseHTTPRequestHandler):\r\n    server_version = \"ops-observe/2.1\"\r\n    state_dir: Path\r\n\r\n    def log_message(self, fmt, *args):\r\n        with open(self.state_dir / \"service.log\", \"a\") as fh:\r\n            fh.write(\"%s - %s\\n\" % (self.address_string(), fmt % args))\r\n\r\n    def _persist(self, body: bytes) -> Path:\r\n        global _SEQ\r\n        parts = urlsplit(self.path)\r\n        with _LOCK:\r\n            _SEQ += 1\r\n            seq = _SEQ\r\n        record = {\r\n            \"destination\": SERVICE_NAME, \"received_at\": _now(), \"method\": self.command, \"path\": parts.path,\r\n            \"query_string\": parts.query, \"headers\": {k.lower(): v for k, v in self.headers.items()},\r\n"]
[87.338395, "o", "            \"content_length\": len(body), \"body_b64\": base64.b64encode(body).decode(\"ascii\"),\r\n        }\r\n        received = self.state_dir / \"received\"\r\n        received.mkdir(parents=True, exist_ok=True)\r\n        path = received / f\"{datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S%f')}-{seq:06d}-{uuid.uuid4().hex[:8]}.json\"\r\n        tmp = path.with_suffix(\".tmp\")\r\n        tmp.write_text(json.dumps(record, indent=2))\r\n        os.replace(tmp, path)\r\n        return path\r\n\r\n    def _send(self, status: int, payload: dict) -> None:\r\n        data = json.dumps(payload).encode(\"utf-8\")\r\n        self.send_response(status)\r\n        self.send_header(\"Content-Type\", \"application/json\")\r\n        self.send_header(\"Content-Length\", str(len(data)))\r\n        self.end_headers()\r\n        self.wfile.write(data)\r\n\r\n    def do_GET(self):\r\n        path = urlsplit(self.path).path\r\n        if path == \"/healthz\":\r\n            return self._send(200, {\"service\": SERVICE_NAME, \"status\": \"ok\", \"time\": _now()})\r\n        if path == \"/v1/events/stats\":\r\n            received = self.state_dir / \"received\"\r\n            return self._send(200, {\"requests_persisted\": len(list(received.glob(\"*.json\"))) if received.exists() else 0})\r\n        return self._send(404, {\"error\": \"not found\"})\r\n\r\n    def do_POST(self):\r\n"]
[87.338456, "o", "        path = urlsplit(self.path).path\r\n        body = self.rfile.read(int(self.headers.get(\"Content-Length\") or 0))\r\n        record_path = self._persist(body)\r\n        if path != \"/v1/events\":\r\n            return self._send(404, {\"error\": \"unknown route\", \"path\": path})\r\n        ctype = (self.headers.get(\"Content-Type\") or \"\").split(\";\")[0].strip()\r\n        if ctype not in (\"application/x-ndjson\", \"application/json\", \"application/jsonl\"):\r\n            return self._send(415, {\"error\": \"expected application/x-ndjson or application/json\"})\r\n        try:\r\n            events = parse_events(body, ctype)\r\n        except (ValueError, UnicodeDecodeError) as e:\r\n            return self._send(400, {\"error\": f\"could not parse events: {e}\"})\r\n        bad = [i for i, e in enumerate(events) if not isinstance(e, dict) or not e.get(\"event_type\")]\r\n        if not events or bad:\r\n            return self._send(422, {\"error\": \"every event needs an event_type\", \"indexes\": bad[:10]})\r\n        return self._send(202, {\"ingested\": len(events), \"batch_id\": f\"ob_{uuid.uuid4().hex[:12]}\", \"stored_as\": record_path.name})\r\n\r\n\r\ndef serve(port: int, state_dir: Path, host: str = \"127.0.0.1\") -> None:\r\n    state_dir.mkdir(parents=True, exist_ok=True)\r\n    (state_dir / \"received\").mkdir(exist_ok=True)\r\n    Handler.state_dir = state_dir\r\n    httpd = ThreadingHTTPServer((host, port), Handler)\r\n    (state_dir / \"service.pid\").write_text(str(os.getpid()))\r\n    print(f\"{SERVICE_NAME} listening on http://{host}:{port} (state: {state_dir})\", flush=True)\r\n    try:\r\n        httpd.serve_forever()\r\n    except KeyboardInterrupt:\r\n        pass\r\n    finally:\r\n"]
[87.338517, "o", "        httpd.server_close()\r\n\r\n\r\ndef main(argv=None) -> int:\r\n    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\r\n    p.add_argument(\"--port\", type=int, default=int(os.environ.get(\"OPS_OBSERVE_PORT\", \"8790\")))\r\n    p.add_argument(\"--host\", default=\"127.0.0.1\")\r\n    p.add_argument(\"--state-dir\", type=Path, default=Path(os.environ.get(\"OPS_OBSERVE_STATE_DIR\", \"/var/lib/ops-observe\")))\r\n    args = p.parse_args(argv)\r\n    serve(args.port, args.state_dir, args.host)\r\n    return 0\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main())\r\n"]
[87.338762, "o", "\u001b[?2004hroot@cebc7c734492:/app# "]
[132.343649, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('taskforge/diagnostics.py')\ns = p.read_text().replace('from typing import Any\\n', 'from typing import Any\\nfrom urllib.parse import urlsplit, urlunsplit\\n')\ns = s.replace('\\ndef report_failure(', '''\ndef _diagnostic_message(exc: BaseException) -> str:\n    \"\"\"Keep handler diagnostics useful without exporting URL secrets or contact rows.\"\"\"\n    def redact_url(match: re.Match[str]) -> str:\n        try:\n            url = urlsplit(match.group())\n            return urlunsplit((url.scheme, url.netloc.rsplit(\"@\", 1)[-1], url.path,\n                               \"[redacted]\" if url.query else \"\", \"\"))\n        except ValueError:\n            return \"[redacted URL]\"\n\n    message = re.sub(r\"https?://[^\\\\s\\\\\\\"'<>]+\", redact_url, str(exc), flags=re.IGNORECASE)\n    # contacts.import includes the invalid row's repr in its local exception.\n    message = re.sub(r\"(first bad row \\\\d+): .*\", r\"\\\\1: [redacted]\", message, flags=re.DOTALL)\n    return truncate(message)\n\n\ndef report_failure(''')\ns = s.replace('\"error_message\": truncate(str(exc)),', '\"error_message\": _diagnostic_message(exc),')\np.write_text(s)\nPY\ncat >> tests/test_diagnostics.py <<'PY'\n\n\n@pytest.mark.parametrize((\"message\", \"expected\"), [\n    (\"POST https://user:secret@hooks.invalid/receive?token=secret#fragment failed: connection refused\",\n     \"POST https://hooks.invalid/receive?[redacted] failed: connection refused\"),\n    (\"1 of 4 rows have an invalid e-mail; first bad row 2: {'email': 'private@example.org', 'name': 'Private Name'}\",\n     \"1 of 4 rows have an invalid e-mail; first bad row 2: [redacted]\"),\n])\ndef test_report_failure_does_not_export_replay_details(store, settings, observe_server, message, expected):\n    job = store.get(\"job_0001\")\n    exc = RuntimeError(message)\n    event = report_failure(job, exc, \"\", replace(settings, observe_url=observe_server.url))\n    assert event[\"error_message\"] == expected\n    assert str(exc) == message\n    assert event[\"request\"] == {\n        \"request_id\": job.context.request_id,\n        \"account_id\": job.context.account_id,\n        \"route\": job.context.route,\n    }\n    encoded = json.dumps(event)\n    for private in (\"secret\", \"private@example.org\", \"Private Name\", job.context.body_preview,\n                    job.context.headers[\"authorization\"]):\n        assert private not in encoded\nPY\npython -m pytest -q tests\n"]
