[164.577802, "i", "python - <<'PY'\nimport base64\nimport json\nfrom pathlib import Path\nfrom taskforge.config import load_settings\nfrom taskforge.job_store import JobStore\n\nbefore = set(json.loads(Path('/tmp/tf642-received-before.json').read_text()))\npaths = sorted(p for p in Path('/var/lib/ops-observe/received').glob('*.json') if p.name not in before)\nevents = []\nfor path in paths:\n    record = json.loads(path.read_text())\n    assert record['path'] == '/v1/events'\n    assert record['headers']['content-type'] == 'application/x-ndjson'\n    events.extend(json.loads(line) for line in base64.b64decode(record['body_b64']).splitlines())\nsettings = load_settings()\nstore = JobStore(settings.db_path)\ndead = store.list(status='dead')\nassert len(events) == len(dead) == 7\nassert {e['job_id'] for e in events} == {j.job_id for j in dead}\nlogged = [json.loads(line)['job'] for line in settings.failure_log.read_text().splitlines()]\nassert {j['job_id'] for j in logged} == {j.job_id for j in dead}\nfor event in events:\n    job = store.get(event['job_id'])\n    assert event['event_type'] == 'job.failed'\n    assert event['failed_at'] == job.finished_at\n    assert event['attempt'] == job.attempts == job.max_attempts\n    assert event['duration_ms'] == job.duration_ms\n    assert len(event['error_message']) <= 500\n    assert len(event['stack_summary']) <= 5\n    assert event['request'] == {'request_id': job.context.request_id, 'account_id': job.context.account_id, 'route': job.context.route}\n    serialized = json.dumps(event)\n    assert 'whk_live_' not in serialized and 'ak_live_' not in serialized\n    assert 'body_preview' not in serialized and 'authorization' not in serialized\n    assert next(j for j in logged if j['job_id'] == job.job_id) == job.to_dict()\n    print(f\"Verified {job.job_id}: {event['error_type']}\")\nstore.close()\nprint(f'Confirmed {len(events)} events in {len(paths)} new ops-observe request files; local records preserved.')\nPY\n"]
