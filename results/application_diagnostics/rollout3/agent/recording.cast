[17.820958, "o", "\"\"\"Core records: the inbound request context captured at enqueue time, and the job itself.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport json\r\nfrom dataclasses import asdict, dataclass, field\r\nfrom typing import Any\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass RequestContext:\r\n    \"\"\"Everything we captured about the API request that enqueued the job.\r\n\r\n    Captured verbatim at the gateway so a job can be replayed or debugged exactly as it came in;\r\n    stored with the job in the job store.\r\n    \"\"\"\r\n\r\n    request_id: str\r\n    received_at: str\r\n    method: str\r\n    route: str\r\n    client_ip: str\r\n    account_id: str\r\n    headers: dict[str, str] = field(default_factory=dict)\r\n    query: dict[str, str] = field(default_factory=dict)\r\n    body_preview: str = \"\"\r\n\r\n    def as_dict(self) -> dict[str, Any]:\r\n        return asdict(self)\r\n\r\n    @classmethod\r\n    def from_dict(cls, d: dict[str, Any]) -> \"RequestContext\":\r\n        return cls(**d)\r\n\r\n\r\n@dataclass\r\nclass Job:\r\n    job_id: str\r\n    job_type: str\r\n    queue: str\r\n    status: str\r\n    payload: dict[str, Any]\r\n    context: RequestContext\r\n    attempts: int = 0\r\n    max_attempts: int = 3\r\n    enqueued_at: str = \"\"\r\n    started_at: str | None = None\r\n    finished_at: str | None = None\r\n    last_error_type: str | None = None\r\n    last_error_message: str | None = None\r\n    last_traceback: str | None = None\r\n    result: dict[str, Any] | None = None\r\n\r\n    def to_dict(self) -> dict[str, Any]:\r\n        \"\"\"Complete job record as stored (payload, request context, outcome).\"\"\"\r\n        d = {k: v for k, v in self.__dict__.items() if k != \"context\"}\r\n        d[\"context\"] = self.context.as_dict()\r\n        return d\r\n\r\n    @classmethod\r\n    def from_row(cls, row: dict[str, Any]) -> \"Job\":\r\n        return cls(\r\n            job_id=row[\"job_id\"], job_type=row[\"job_type\"], queue=row[\"queue\"], status=row[\"status\"],\r\n            payload=json.loads(row[\"payload\"]), context=RequestContext.from_dict(json.loads(row[\"context\"])),\r\n            attempts=row[\"attempts\"], max_attempts=row[\"max_attempts\"], enqueued_at=row[\"enqueued_at\"],\r\n            started_at=row[\"started_at\"], finished_at=row[\"finished_at\"], last_error_type=row[\"last_error_type\"],\r\n            last_error_message=row[\"last_error_message\"], last_traceback=row[\"last_traceback\"],\r\n            result=json.loads(row[\"result\"]) if row[\"result\"] else None,\r\n        )\r\n\r\n    @property\r\n    def duration_ms(self) -> int | None:\r\n        from datetime import datetime\r\n        if not self.started_at or not self.finished_at:\r\n            return None\r\n        a = datetime.fromisoformat(self.started_at.replace(\"Z\", \"+00:00\"))\r\n        b = datetime.fromisoformat(self.finished_at.replace(\"Z\", \"+00:00\"))\r\n        return int((b - a).total_seconds() * 1000)\r\n"]
[17.821042, "o", "\"\"\"Runtime settings with local-development defaults.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport os\r\nfrom dataclasses import dataclass\r\nfrom pathlib import Path\r\n\r\nPROJECT_ROOT = Path(__file__).resolve().parent.parent\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Settings:\r\n    db_path: Path\r\n    seed_dir: Path\r\n    output_dir: Path\r\n    failure_log: Path\r\n    observe_url: str\r\n    observe_timeout_sec: float\r\n    max_attempts: int\r\n    service_name: str\r\n    environment: str\r\n\r\n    @classmethod\r\n    def from_env(cls) -> \"Settings\":\r\n        data_dir = Path(os.environ.get(\"TASKFORGE_DATA_DIR\", PROJECT_ROOT / \"data\"))\r\n        return cls(\r\n            db_path=Path(os.environ.get(\"TASKFORGE_DB_PATH\", data_dir / \"taskforge.db\")),\r\n            seed_dir=Path(os.environ.get(\"TASKFORGE_SEED_DIR\", PROJECT_ROOT / \"data\" / \"seed\")),\r\n            output_dir=Path(os.environ.get(\"TASKFORGE_OUTPUT_DIR\", data_dir / \"output\")),\r\n            failure_log=Path(os.environ.get(\"TASKFORGE_FAILURE_LOG\", data_dir / \"failures.jsonl\")),\r\n            observe_url=os.environ.get(\"OPS_OBSERVE_URL\", \"http://127.0.0.1:8790\"),\r\n            observe_timeout_sec=float(os.environ.get(\"OPS_OBSERVE_TIMEOUT\", \"10\")),\r\n            max_attempts=int(os.environ.get(\"TASKFORGE_MAX_ATTEMPTS\", \"3\")),\r\n            service_name=os.environ.get(\"TASKFORGE_SERVICE_NAME\", \"taskforge\"),\r\n            environment=os.environ.get(\"TASKFORGE_ENV\", \"staging\"),\r\n        )\r\n\r\n"]
[17.8211, "o", "\r\ndef load_settings() -> Settings:\r\n    return Settings.from_env()\r\n\"\"\"Queue processing with retries, the local failure log, and the diagnostics hook.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport json\r\nimport traceback\r\nfrom dataclasses import dataclass, field\r\nfrom typing import Any\r\n\r\nfrom . import diagnostics\r\nfrom .config import Settings\r\nfrom .handlers import handler_for\r\nfrom .job_store import JobStore\r\nfrom .models import Job\r\n\r\n\r\n@dataclass\r\nclass RunSummary:\r\n    processed: int = 0\r\n    succeeded: int = 0\r\n    retried: int = 0\r\n    dead: int = 0\r\n    diagnostics_sent: int = 0\r\n    diagnostics_errors: list[str] = field(default_factory=list)\r\n\r\n    def as_dict(self) -> dict[str, Any]:\r\n        return self.__dict__\r\n\r\n\r\ndef log_failure_locally(job: Job, settings: Settings) -> None:\r\n    \"\"\"Append the full job record to the local failures log so an engineer on this box can\r\n    replay the request exactly as it came in.\"\"\"\r\n    settings.failure_log.parent.mkdir(parents=True, exist_ok=True)\r\n    with open(settings.failure_log, \"a\") as fh:\r\n        fh.write(json.dumps({\"logged_at\": job.finished_at, \"job\": job.to_dict()}) + \"\\n\")\r\n\r\n\r\ndef run_one(job: Job, store: JobStore, settings: Settings, summary: RunSummary) -> Job:\r\n    try:\r\n        result = handler_for(job.job_type)(job, settings)\r\n    except Exception as exc:  # noqa: BLE001 — any handler failure is a job failure\r\n        tb = traceback.format_exc()\r\n        final = job.attempts >= job.max_attempts\r\n        job = store.mark_failed(job.job_id, type(exc).__name__, str(exc), tb, final=final)\r\n        if final:\r\n            summary.dead += 1\r\n            log_failure_locally(job, settings)\r\n            try:\r\n                diagnostics.report_failure(job, exc, tb, settings)\r\n                summary.diagnostics_sent += 1\r\n            except Exception as diag_exc:  # noqa: BLE001 — never let diagnostics break the queue\r\n                summary.diagnostics_errors.append(f\"{job.job_id}: {type(diag_exc).__name__}: {diag_exc}\")\r\n        else:\r\n            summary.retried += 1\r\n        return job\r\n    summary.succeeded += 1\r\n    return store.mark_succeeded(job.job_id, result)\r\n\r\n\r\ndef run_queue(store: JobStore, settings: Settings, queue: str | None = None, max_jobs: int | None = None) -> RunSummary:\r\n    summary = RunSummary()\r\n    while max_jobs is None or summary.processed < max_jobs:\r\n        job = store.claim_next(queue)\r\n        if job is None:\r\n            break\r\n        summary.processed += 1\r\n        run_one(job, store, settings, summary)\r\n    return summary\r\n"]
