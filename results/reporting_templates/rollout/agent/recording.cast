[22.545467, "o", "\"\"\"SQLite store for customers and orders.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport json\r\nimport sqlite3\r\nfrom dataclasses import dataclass\r\nfrom datetime import date\r\nfrom pathlib import Path\r\n\r\nSCHEMA = \"\"\"\r\nCREATE TABLE IF NOT EXISTS customers (\r\n    customer_id TEXT PRIMARY KEY, full_name TEXT NOT NULL, email TEXT NOT NULL, phone TEXT, date_of_birth TEXT,\r\n    residential_address TEXT NOT NULL, postcode TEXT NOT NULL, region TEXT NOT NULL, segment TEXT NOT NULL,\r\n    account_manager TEXT NOT NULL, joined_on TEXT NOT NULL\r\n);\r\nCREATE TABLE IF NOT EXISTS orders (\r\n    order_id TEXT PRIMARY KEY, customer_id TEXT NOT NULL REFERENCES customers(customer_id), placed_on TEXT NOT NULL,\r\n    status TEXT NOT NULL CHECK (status IN ('fulfilled','cancelled','refunded')), subtotal_cents INTEGER NOT NULL,\r\n    discount_cents INTEGER NOT NULL, total_cents INTEGER NOT NULL\r\n);\r\nCREATE INDEX IF NOT EXISTS idx_orders_customer_day ON orders(customer_id, placed_on);\r\n\"\"\"\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Customer:\r\n    customer_id: str\r\n    full_name: str\r\n    email: str\r\n    phone: str | None\r\n    date_of_birth: str | None\r\n    residential_address: str\r\n    postcode: str\r\n    region: str\r\n    segment: str\r\n    account_manager: str\r\n    joined_on: str\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Order:\r\n    order_id: str\r\n    customer_id: str\r\n    placed_on: str\r\n    status: str\r\n    subtotal_cents: int\r\n    discount_cents: int\r\n    total_cents: int\r\n\r\n\r\nclass StoreError(LookupError):\r\n    pass\r\n\r\n\r\nclass CustomerStore:\r\n    def __init__(self, db_path: Path):\r\n        db_path.parent.mkdir(parents=True, exist_ok=True)\r\n        self._conn = sqlite3.connect(str(db_path))\r\n        self._conn.row_factory = sqlite3.Row\r\n        self._conn.executescript(SCHEMA)\r\n\r\n    def close(self) -> None:\r\n        self._conn.close()\r\n\r\n    def load_seed(self, seed_dir: Path, replace: bool = False) -> tuple[int, int]:\r\n        customers = json.loads((seed_dir / \"customers.json\").read_text())\r\n        orders = json.loads((seed_dir / \"orders.json\").read_text())\r\n        with self._conn:\r\n            if replace:\r\n                self._conn.execute(\"DELETE FROM orders\")\r\n                self._conn.execute(\"DELETE FROM customers\")\r\n            self._conn.executemany(\r\n                \"INSERT OR REPLACE INTO customers VALUES (:customer_id,:full_name,:email,:phone,:date_of_birth,:residential_address,\"\r\n                \":postcode,:region,:segment,:account_manager,:joined_on)\", customers)\r\n            self._conn.executemany(\r\n                \"INSERT OR REPLACE INTO orders VALUES (:order_id,:customer_id,:placed_on,:status,:subtotal_cents,:discount_cents,:total_cents)\", orders)\r\n        return len(customers), len(orders)\r\n\r\n    def customer(self, customer_id: str) -> Customer:\r\n        row = self._conn.execute(\"SELECT * FROM customers WHERE customer_id = ?\", (customer_id,)).fetchone()\r\n        if row is None:\r\n            raise StoreError(f\"unknown customer {customer_id!r}\")\r\n        return Customer(**dict(row))\r\n\r\n    def customers(self, segment: str | None = None) -> list[Customer]:\r\n        sql, params = \"SELECT * FROM customers\", []\r\n        if segment:\r\n"]
[22.545635, "o", "            sql += \" WHERE segment = ?\"; params.append(segment)\r\n        return [Customer(**dict(r)) for r in self._conn.execute(sql + \" ORDER BY customer_id\", params)]\r\n\r\n    def orders_between(self, start: date, end_exclusive: date) -> list[Order]:\r\n        rows = self._conn.execute(\"SELECT * FROM orders WHERE placed_on >= ? AND placed_on < ? ORDER BY placed_on, order_id\",\r\n                                  (start.isoformat(), end_exclusive.isoformat()))\r\n        return [Order(**dict(r)) for r in rows]\r\n\r\n    def all_orders(self) -> list[Order]:\r\n        return [Order(**dict(r)) for r in self._conn.execute(\"SELECT * FROM orders ORDER BY placed_on, order_id\")]\r\n\r\n    def counts(self) -> dict[str, int]:\r\n        return {\"customers\": self._conn.execute(\"SELECT COUNT(*) FROM customers\").fetchone()[0],\r\n                \"orders\": self._conn.execute(\"SELECT COUNT(*) FROM orders\").fetchone()[0]}\r\n"]
[22.545731, "o", "\u001b[?2004hroot@0bde325b18a2:/app# "]
[28.284947, "i", "cat tests/test_engine.py tests/test_templates_and_columns.py\n"]
[28.28528, "o", "cat tests/test_engine.py tests/test_templates_and_columns.py\r\n\u001b[?2004l\r"]
[28.286451, "o", "import pytest\r\n\r\nfrom reportkit.export_writer import to_csv\r\nfrom reportkit.report_engine import PeriodError, period_bounds\r\nfrom reportkit.templates import get_template\r\n\r\n\r\ndef test_period_bounds():\r\n    assert period_bounds(\"2025-10\")[1].isoformat() == \"2025-11-01\"\r\n    with pytest.raises(PeriodError):\r\n        period_bounds(\"2025/10\")\r\n\r\n\r\ndef test_finance_close_rows(engine, store):\r\n    report = engine.rows_for(get_template(\"finance_close\"), \"2025-10\")\r\n    assert report.columns == [\"customer_id\", \"segment\", \"period\", \"orders\", \"revenue_cents\", \"refunds_cents\"]\r\n    row = next(r for r in report.rows if r[\"customer_id\"] == \"cus_2208\")\r\n    orders = [o for o in store.orders_between(*period_bounds(\"2025-10\")) if o.customer_id == \"cus_2208\"]\r\n    assert row[\"orders\"] == sum(1 for o in orders if o.status == \"fulfilled\")\r\n    assert row[\"revenue_cents\"] == sum(o.total_cents for o in orders if o.status == \"fulfilled\")\r\n    assert row[\"refunds_cents\"] == sum(o.total_cents for o in orders if o.status == \"refunded\")\r\n    assert engine.rows_for(get_template(\"finance_close\"), \"2024-01\").rows == []\r\n\r\n\r\ndef test_account_review_and_manifest(engine):\r\n    review = engine.rows_for(get_template(\"account_review\"), \"2025-10\")\r\n    assert len(review.rows) == 40 and \"residential_address\" in review.columns\r\n    manifest = engine.rows_for(get_template(\"delivery_manifest\"), \"2025-10\")\r\n    assert manifest.columns[0] == \"order_id\" and all(r[\"placed_on\"].startswith(\"2025-10\") for r in manifest.rows)\r\n\r\n\r\ndef test_unimplemented_columns_raise(engine):\r\n    from reportkit.column_selector import CATALOGUE, ColumnSpec\r\n    CATALOGUE[\"churn_risk\"] = ColumnSpec(\"churn_risk\", \"period-metric\", \"placeholder\", implemented=False)\r\n    try:\r\n        with pytest.raises(NotImplementedError):\r\n            engine.rows_for(get_template(\"finance_close\"), \"2025-10\", include=[\"churn_risk\"])\r\n    finally:\r\n        CATALOGUE.pop(\"churn_risk\")\r\n\r\n\r\ndef test_csv_rendering(engine):\r\n    report = engine.rows_for(get_template(\"finance_close\"), \"2025-10\")\r\n    csv_text = to_csv(report)\r\n    assert csv_text.splitlines()[0] == \",\".join(report.columns) and len(csv_text.splitlines()) == report.row_count + 1\r\n"]
[28.286572, "o", "import pytest\r\n\r\nfrom reportkit.column_selector import CATALOGUE, ColumnError, resolve_columns\r\nfrom reportkit.templates import TEMPLATES, TemplateError, derive, get_template\r\n\r\n\r\ndef test_catalogue_and_templates_consistent():\r\n    for t in TEMPLATES.values():\r\n        assert all(c in CATALOGUE for c in t.columns), t.name\r\n    assert get_template(None).name == \"account_review\"\r\n    with pytest.raises(TemplateError):\r\n        get_template(\"nope\")\r\n\r\n\r\ndef test_resolve_columns_include_exclude():\r\n    t = get_template(\"finance_close\")\r\n    cols = resolve_columns(t, include=[\"region\"], exclude=[\"refunds_cents\"])\r\n    assert \"region\" in cols and \"refunds_cents\" not in cols and cols[0] == \"customer_id\"\r\n    with pytest.raises(ColumnError):\r\n        resolve_columns(t, include=[\"made_up\"])\r\n    with pytest.raises(ColumnError):\r\n        resolve_columns(t, include=[\"order_id\"])\r\n\r\n\r\ndef test_derive_keeps_base_columns():\r\n    t = derive(\"finance_close\", \"finance_close_regional\", \"regional close\", \"finance\", add=[\"region\"])\r\n    assert t.columns[: len(TEMPLATES[\"finance_close\"].columns)] == TEMPLATES[\"finance_close\"].columns and t.columns[-1] == \"region\"\r\n    TEMPLATES.pop(\"finance_close_regional\")\r\n"]
[28.286747, "o", "\u001b[?2004hroot@0bde325b18a2:/app# "]
[28.394731, "i", "cat reportkit/cli.py\n"]
[28.395182, "o", "cat reportkit/cli.py\r\n\u001b[?2004l\r"]
[28.39647, "o", "\"\"\"reportkit command line.\r\n\r\n    python -m reportkit.cli init-db [--replace]\r\n    python -m reportkit.cli templates\r\n    python -m reportkit.cli columns\r\n    python -m reportkit.cli report run --period YYYY-MM [--template T] [--include C ...] [--exclude C ...] [--out FILE]\r\n    python -m reportkit.cli report publish --period YYYY-MM [--template T] [--workspace W]\r\n    python -m reportkit.cli workspace-health\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport argparse\r\nimport sys\r\nfrom typing import Sequence\r\n\r\nfrom . import __version__\r\nfrom .column_selector import CATALOGUE, ColumnError\r\nfrom .config import load_settings\r\nfrom .customer_store import CustomerStore\r\nfrom .export_writer import default_filename, to_csv, write_csv\r\nfrom .report_engine import PeriodError, ReportEngine\r\nfrom .templates import TEMPLATES, TemplateError, get_template\r\nfrom .workspace_client import WorkspaceClient, WorkspaceError\r\n\r\n\r\ndef _store(settings) -> CustomerStore:\r\n    if not settings.db_path.exists():\r\n        print(f\"database not found at {settings.db_path}; run `init-db` first\", file=sys.stderr)\r\n        raise SystemExit(2)\r\n    return CustomerStore(settings.db_path)\r\n\r\n\r\ndef cmd_init_db(args, settings) -> int:\r\n    c, o = CustomerStore(settings.db_path).load_seed(settings.seed_dir, replace=args.replace)\r\n    print(f\"loaded {c} customers and {o} orders into {settings.db_path}\")\r\n    return 0\r\n\r\n\r\ndef cmd_templates(args, settings) -> int:\r\n    for t in TEMPLATES.values():\r\n        print(f\"{t.name}\\n  purpose:   {t.purpose}\\n  audience:  {t.audience}\\n  workspace: {t.workspace}\\n  columns:   {', '.join(t.columns)}\")\r\n    return 0\r\n\r\n\r\ndef cmd_columns(args, settings) -> int:\r\n    for c in CATALOGUE.values():\r\n        flag = \"\" if c.implemented else \"  (not computed yet)\"\r\n        print(f\"{c.name:<24} {c.source:<16} {c.description}{flag}\")\r\n"]
[28.396638, "o", "    return 0\r\n\r\n\r\ndef _render(args, settings):\r\n    template = get_template(args.template)\r\n    engine = ReportEngine(_store(settings))\r\n    return template, engine.rows_for(template, args.period, include=args.include, exclude=args.exclude)\r\n\r\n\r\ndef cmd_report_run(args, settings) -> int:\r\n    try:\r\n        template, report = _render(args, settings)\r\n    except (TemplateError, PeriodError, ColumnError, NotImplementedError) as e:\r\n        print(str(e), file=sys.stderr)\r\n        return 1\r\n    path = args.out or (settings.reports_dir / default_filename(report))\r\n    write_csv(report, path)\r\n    print(f\"wrote {report.row_count} rows x {len(report.columns)} columns ({template.name}, {report.period}) to {path}\")\r\n    return 0\r\n\r\n\r\ndef cmd_report_publish(args, settings) -> int:\r\n    try:\r\n        template, report = _render(args, settings)\r\n    except (TemplateError, PeriodError, ColumnError, NotImplementedError) as e:\r\n        print(str(e), file=sys.stderr)\r\n        return 1\r\n    workspace = args.workspace or template.workspace\r\n    if not workspace:\r\n        print(f\"template {template.name} has no default workspace; pass --workspace\", file=sys.stderr)\r\n        return 1\r\n    client = WorkspaceClient(settings.workspace_url, settings.workspace_timeout_sec, settings.publisher)\r\n    try:\r\n        resp = client.publish(workspace, report, to_csv(report), default_filename(report))\r\n    except WorkspaceError as e:\r\n        print(str(e), file=sys.stderr)\r\n        return 1\r\n    print(f\"published {report.row_count} rows x {len(report.columns)} columns ({template.name}, {report.period}) to workspace {workspace}: report {resp.body.get('report_id')}\")\r\n    return 0\r\n\r\n\r\ndef cmd_workspace_health(args, settings) -> int:\r\n    try:\r\n        print(WorkspaceClient(settings.workspace_url, settings.workspace_timeout_sec).health().body)\r\n    except WorkspaceError as e:\r\n        print(str(e), file=sys.stderr)\r\n        return 1\r\n    return 0\r\n\r\n\r\ndef build_parser() -> argparse.ArgumentParser:\r\n    p = argparse.ArgumentParser(prog=\"reportkit\", description=\"Verdant Box reporting CLI\")\r\n    p.add_argument(\"--version\", action=\"version\", version=f\"reportkit {__version__}\")\r\n    sub = p.add_subparsers(dest=\"command\", required=True)\r\n    s = sub.add_parser(\"init-db\"); s.add_argument(\"--replace\", action=\"store_true\"); s.set_defaults(func=cmd_init_db)\r\n    sub.add_parser(\"templates\", help=\"list report templates\").set_defaults(func=cmd_templates)\r\n    sub.add_parser(\"columns\", help=\"list the column catalogue\").set_defaults(func=cmd_columns)\r\n    r = sub.add_parser(\"report\", help=\"run or publish a report\")\r\n    rsub = r.add_subparsers(dest=\"report_command\", required=True)\r\n    for name, func in ((\"run\", cmd_report_run), (\"publish\", cmd_report_publish)):\r\n        c = rsub.add_parser(name)\r\n        c.add_argument(\"--period\", required=True)\r\n        c.add_argument(\"--template\", help=f\"template name (default: account_review)\")\r\n        c.add_argument(\"--include\", nargs=\"*\", default=None); c.add_argument(\"--exclude\", nargs=\"*\", default=None)\r\n        if name == \"run\":\r\n            c.add_argument(\"--out\", type=lambda s: __import__(\"pathlib\").Path(s))\r\n        else:\r\n            c.add_argument(\"--workspace\", help=\"workspace slug (default: the template's workspace)\")\r\n        c.set_defaults(func=func)\r\n    sub.add_parser(\"workspace-health\", help=\"check the workspace service\").set_defaults(func=cmd_workspace_health)\r\n    return p\r\n\r\n\r\ndef main(argv: Sequence[str] | None = None) -> int:\r\n    args = build_parser().parse_args(argv)\r\n    return args.func(args, load_settings())\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main())\r\n"]
