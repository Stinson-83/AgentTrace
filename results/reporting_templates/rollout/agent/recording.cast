[71.213979, "o", "\u001b[?2004h> "]
[71.214248, "o", "        make_order(\"refund\", \"2025-10-02\", \"refunded\", 500),\r\n"]
[71.21426, "o", "\u001b[?2004l\r"]
[71.214395, "o", "\u001b[?2004h> "]
[71.215816, "o", "        make_order(\"cancel\", \"2025-10-03\", \"cancelled\", 900),\r\n\u001b[?2004l\r\u001b[?2004h>     ]\r\n\u001b[?2004l\r\u001b[?2004h>     assert engine.period_metrics(orders, \"2025-10\") == {\r\n\u001b[?2004l\r\u001b[?2004h>         \"period\": \"2025-10\", \"orders\": 3, \"active_days\": 2,\r\n\u001b[?2004l\r\u001b[?2004h>         \"revenue_cents\": 304, \"refunds_cents\": 500, \"avg_order_cents\": 101,\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"statuses\", [[], [\"refunded\"], [\"cancelled\"], [\"refunded\", \"cancelled\"]])\r\n\u001b[?2004l\r\u001b[?2004h> def test_period_metrics_without_fulfilled_orders(engine, statuses):\r\n\u001b[?2004l\r\u001b[?2004h>     orders = [make_order(str(i), \"2025-10-01\", status) for i, status in enumerate(statuses)]\r\n\u001b[?2004l\r\u001b[?2004h>     metrics = engine.period_metrics(orders, \"2025-10\")\r\n\u001b[?2004l\r\u001b[?2004h>     assert metrics[\"orders\"] == metrics[\"active_days\"] == metrics[\"avg_order_cents\"] == metrics[\"revenue_cents\"] == 0\r\n\u001b[?2004l\r\u001b[?2004h>     assert metrics[\"refunds_cents\"] == 100 * statuses.count(\"refunded\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.215825, "o", "\r\n\u001b[?2004l\r"]
[71.215834, "o", "\u001b[?2004h> "]
[71.215849, "o", "\r\n\u001b[?2004l\r \u001b[?2004h> "]
[71.215992, "o", "def test_monthly_customer_performance_rows(engine, store, tmp_path):\r\n\u001b[?2004l\r"]
[71.216, "o", "\u001b[?2004h> "]
[71.216101, "o", "    import json\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.216141, "o", "    from dataclasses import asdict\r\n"]
[71.216154, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[71.216221, "o", "    customers = store.customers()[:5]\r\n\u001b[?2004l\r"]
[71.216261, "o", "\u001b[?2004h> "]
[71.21632, "o", "    ids = [c.customer_id for c in customers]\r\n\u001b[?2004l\r"]
[71.216334, "o", "\u001b[?2004h> "]
[71.216388, "o", "    orders = [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.216505, "o", "        make_order(\"before\", \"2025-09-30\", total_cents=9999, customer_id=ids[0]),\r\n\u001b[?2004l\r"]
[71.216539, "o", "\u001b[?2004h> "]
[71.216625, "o", "        make_order(\"first\", \"2025-10-01\", total_cents=100, customer_id=ids[0]),\r\n\u001b[?2004l\r"]
[71.216655, "o", "\u001b[?2004h"]
[71.216679, "o", "> "]
[71.216751, "o", "        make_order(\"same-day\", \"2025-10-01\", total_cents=101, customer_id=ids[0]),\r\n\u001b[?2004l\r"]
[71.216784, "o", "\u001b[?2004h> "]
[71.216874, "o", "        make_order(\"last\", \"2025-10-31\", total_cents=103, customer_id=ids[0]),\r\n\u001b[?2004l\r"]
[71.216901, "o", "\u001b[?2004h"]
[71.216931, "o", "> "]
[71.216991, "o", "        make_order(\"after\", \"2025-11-01\", total_cents=9999, customer_id=ids[0]),\r\n\u001b[?2004l\r"]
[71.217018, "o", "\u001b[?2004h"]
[71.217047, "o", "> "]
[71.217093, "o", "        make_order(\"refund\", \"2025-10-15\", \"refunded\", 500, ids[1]),\r\n\u001b[?2004l\r"]
[71.217127, "o", "\u001b[?2004h> "]
[71.217192, "o", "        make_order(\"cancel\", \"2025-10-16\", \"cancelled\", 900, ids[2]),\r\n\u001b[?2004l\r"]
[71.217224, "o", "\u001b[?2004h"]
[71.217254, "o", "> "]
[71.217287, "o", "        make_order(\"outside\", \"2025-09-30\", customer_id=ids[3]),\r\n\u001b[?2004l\r"]
[71.217319, "o", "\u001b[?2004h> "]
[71.217351, "o", "    ]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.217376, "o", "    seed = tmp_path / \"seed\"\r\n\u001b[?2004l\r"]
[71.2174, "o", "\u001b[?2004h>     seed.mkdir()\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.217421, "o", "> "]
[71.21751, "o", "    (seed / \"customers.json\").write_text(json.dumps([asdict(c) for c in customers]))\r\n\u001b[?2004l\r"]
[71.217542, "o", "\u001b[?2004h> "]
[71.21762, "o", "    (seed / \"orders.json\").write_text(json.dumps([asdict(o) for o in orders]))\r\n\u001b[?2004l\r"]
[71.217647, "o", "\u001b[?2004h> "]
[71.217685, "o", "    store.load_seed(seed, replace=True)\r\n\u001b[?2004l\r"]
[71.217695, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[71.21772, "o", "\u001b[?2004h"]
[71.217758, "o", "> "]
[71.217796, "o", "    template = get_template(\"monthly_customer_performance\")\r\n\u001b[?2004l\r"]
[71.217829, "o", "\u001b[?2004h> "]
[71.217864, "o", "    report = engine.rows_for(template, \"2025-10\")\r\n\u001b[?2004l\r"]
[71.217891, "o", "\u001b[?2004h> "]
[71.217954, "o", "    assert [r[\"customer_id\"] for r in report.rows] == ids[:3]\r\n\u001b[?2004l\r"]
[71.217986, "o", "\u001b[?2004h"]
[71.218017, "o", "> "]
[71.218047, "o", "    row = report.rows[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.218155, "o", "    assert (row[\"orders\"], row[\"active_days\"], row[\"revenue_cents\"], row[\"avg_order_cents\"]) == (3, 2, 304, 101)\r\n\u001b[?2004l\r"]
[71.218187, "o", "\u001b[?2004h> "]
[71.218217, "o", "    assert row[\"refunds_cents\"] == 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.218242, "o", "> "]
[71.218287, "o", "    for row, customer in zip(report.rows, customers):\r\n\u001b[?2004l\r"]
[71.218317, "o", "\u001b[?2004h> "]
[71.218346, "o", "        assert row[\"period\"] == \"2025-10\"\r\n\u001b[?2004l\r"]
[71.218371, "o", "\u001b[?2004h"]
[71.218392, "o", "> "]
[71.218436, "o", "        for dimension in (\"segment\", \"region\", \"account_manager\"):\r\n\u001b[?2004l\r"]
[71.218446, "o", "\u001b[?2004h> "]
[71.218522, "o", "            assert row[dimension] == getattr(customer, dimension)\r\n\u001b[?2004l\r"]
[71.218551, "o", "\u001b[?2004h"]
[71.218572, "o", "> "]
[71.218593, "o", "    for row in report.rows[1:]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.218613, "o", "> "]
[71.218705, "o", "        assert row[\"orders\"] == row[\"active_days\"] == row[\"avg_order_cents\"] == row[\"revenue_cents\"] == 0\r\n\u001b[?2004l\r"]
[71.218735, "o", "\u001b[?2004h> "]
[71.218773, "o", "    assert report.rows[1][\"refunds_cents\"] == 500\r\n\u001b[?2004l\r"]
[71.218798, "o", "\u001b[?2004h"]
[71.218819, "o", "> "]
[71.218847, "o", "    assert report.rows[2][\"refunds_cents\"] == 0\r\n\u001b[?2004l\r"]
[71.21887, "o", "\u001b[?2004h> "]
[71.218924, "o", "    assert engine.rows_for(template, \"2024-01\").rows == []\r\n\u001b[?2004l\r"]
[71.218953, "o", "\u001b[?2004h> "]
[71.218974, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.219036, "o", "def test_new_metrics_can_be_included_in_existing_template(engine):\r\n\u001b[?2004l\r"]
[71.219066, "o", "\u001b[?2004h> "]
[71.21918, "o", "    report = engine.rows_for(get_template(\"finance_close\"), \"2025-10\", include=[\"active_days\", \"avg_order_cents\"])\r\n\u001b[?2004l\r"]
[71.21921, "o", "\u001b[?2004h> "]
[71.219239, "o", "    assert report.rows\r\n\u001b[?2004l\r"]
[71.219259, "o", "\u001b[?2004h> "]
[71.219365, "o", "    assert all(isinstance(row[\"active_days\"], int) and isinstance(row[\"avg_order_cents\"], int) for row in report.rows)\r\n\u001b[?2004l\r"]
[71.219396, "o", "\u001b[?2004h"]
[71.219417, "o", "> PY\r\n\u001b[?2004l\r"]
[71.221824, "o", "\u001b[?2004hroot@0bde325b18a2:/app# "]
[71.221848, "o", "cat >> tests/test_templates_and_columns.py <<'PY'\r\n\u001b[?2004l\r"]
[71.22191, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[71.221933, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[71.221959, "o", "def test_monthly_customer_performance_template():\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.221983, "o", "> "]
[71.222036, "o", "    template = get_template(\"monthly_customer_performance\")\r\n\u001b[?2004l\r"]
[71.222046, "o", "\u001b[?2004h> "]
[71.222098, "o", "    assert template.row_level == \"customer\"\r\n\u001b[?2004l\r"]
[71.22212, "o", "\u001b[?2004h"]
[71.222146, "o", "> "]
[71.222172, "o", "    assert template.workspace == \"revenue-ops\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.222233, "o", "    assert template.purpose and template.audience\r\n\u001b[?2004l\r"]
[71.222263, "o", "\u001b[?2004h> "]
[71.222294, "o", "    assert template.columns == [\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.222315, "o", "> "]
[71.22239, "o", "        \"customer_id\", \"segment\", \"region\", \"account_manager\", \"period\", \"orders\",\r\n\u001b[?2004l\r"]
[71.222401, "o", "\u001b[?2004h> "]
[71.222493, "o", "        \"active_days\", \"revenue_cents\", \"refunds_cents\", \"avg_order_cents\",\r\n\u001b[?2004l\r"]
[71.22254, "o", "\u001b[?2004h> "]
[71.222599, "o", "    ]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.222647, "o", "    assert all(CATALOGUE[c].implemented for c in template.columns)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[71.224412, "o", "\u001b[?2004hroot@0bde325b18a2:/app# "]
[71.224447, "o", "cat > tests/test_cli.py <<'PY'\r\n\u001b[?2004l\r"]
[71.224521, "o", "\u001b[?2004h> import csv\r\n\u001b[?2004l\r"]
[71.224562, "o", "\u001b[?2004h> import io\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> from reportkit import cli\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.224623, "o", "from reportkit.templates import get_template\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.224663, "o", "> "]
[71.224703, "o", "from reportkit.workspace_client import PublishResponse\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[71.224743, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.224843, "o", "def test_monthly_customer_performance_run_and_publish(store, tmp_path, monkeypatch, capsys):\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.224886, "o", "> "]
[71.224929, "o", "    monkeypatch.setattr(cli, \"_store\", lambda settings: store)\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.224969, "o", "> "]
[71.225013, "o", "    monkeypatch.setenv(\"REPORTKIT_REPORTS_DIR\", str(tmp_path))\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.225052, "o", "> "]
[71.225092, "o", "    template = \"monthly_customer_performance\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.225158, "o", "    args = [\"--template\", template, \"--period\", \"2025-10\"]\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.225198, "o", "> "]
[71.225239, "o", "    assert cli.main([\"report\", \"run\", *args]) == 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.225279, "o", ">     filename = f\"{template}-2025-10.csv\"\r\n\u001b[?2004l\r"]
[71.22532, "o", "\u001b[?2004h> "]
[71.225355, "o", "    csv_text = (tmp_path / filename).read_text()\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.225394, "o", "> "]
[71.225432, "o", "    reader = csv.DictReader(io.StringIO(csv_text))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.225508, "o", "    assert reader.fieldnames == get_template(template).columns\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.225548, "o", ">     rows = list(reader)\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.225586, "o", "> "]
[71.225636, "o", "    assert rows and all(row[\"period\"] == \"2025-10\" for row in rows)\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.225676, "o", ">     calls = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[71.225716, "o", "\u001b[?2004h> "]
[71.225769, "o", "    def publish(self, workspace, report, content, uploaded_filename):\r\n\u001b[?2004l\r"]
[71.225822, "o", "\u001b[?2004h>         calls.append(workspace)\r\n\u001b[?2004l\r"]
[71.225862, "o", "\u001b[?2004h> "]
[71.225921, "o", "        assert report.template == template and report.period == \"2025-10\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.225962, "o", "> "]
[71.226001, "o", "        assert report.row_count == len(rows)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.226037, "o", "        assert content == csv_text\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.226077, "o", "> "]
[71.226117, "o", "        assert uploaded_filename == filename\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.226187, "o", "        return PublishResponse(201, {\"report_id\": \"test-report\"})\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.226227, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.226286, "o", "    monkeypatch.setattr(cli.WorkspaceClient, \"publish\", publish)\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.226325, "o", "> "]
[71.226361, "o", "    assert cli.main([\"report\", \"publish\", *args]) == 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.2264, "o", "> "]
[71.226439, "o", "    assert calls == [\"revenue-ops\"]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.226524, "o", "    assert \"workspace revenue-ops: report test-report\" in capsys.readouterr().out\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.226562, "o", "> PY\r\n\u001b[?2004l\r"]
[71.227769, "o", "\u001b[?2004hroot@0bde325b18a2:/app# "]
[71.227806, "o", "python -m pytest -q tests\r\n\u001b[?2004l\r"]
[71.874993, "o", "\u001b[32m.\u001b[0m"]
[71.875887, "o", "\u001b[32m.\u001b[0m"]
[71.892408, "o", "\u001b[32m.\u001b[0m"]
[71.914018, "o", "\u001b[32m.\u001b[0m"]
[71.927071, "o", "\u001b[32m.\u001b[0m"]
[71.941252, "o", "\u001b[32m.\u001b[0m"]
[71.95357, "o", "\u001b[32m.\u001b[0m"]
[71.965151, "o", "\u001b[32m.\u001b[0m"]
[71.977499, "o", "\u001b[32m.\u001b[0m"]
[71.993242, "o", "\u001b[32m.\u001b[0m"]
[72.01465, "o", "\u001b[32m.\u001b[0m"]
[72.033579, "o", "\u001b[32m.\u001b[0m"]
[72.047636, "o", "\u001b[32m.\u001b[0m"]
[72.048306, "o", "\u001b[32m.\u001b[0m"]
[72.048643, "o", "\u001b[32m.\u001b[0m"]
[72.049011, "o", "\u001b[32m.\u001b[0m"]
[72.049369, "o", "\u001b[32m.\u001b[0m"]
[72.049579, "o", "\u001b[32m                                                                                                                                        [100%]\u001b[0m"]
[72.050438, "o", "\r\n\u001b[32m\u001b[32m\u001b[1m17 passed\u001b[0m\u001b[32m in 0.30s\u001b[0m\u001b[0m"]
[72.050462, "o", "\r\n"]
[72.096519, "o", "\u001b[?2004hroot@0bde325b18a2:/app# "]
[81.8027, "i", "python -m reportkit.cli report run --template monthly_customer_performance --period 2025-10\npython -m reportkit.cli workspace-health\n"]
[81.803074, "o", "python -m reportkit.cli report run --template monthly_customer_performance --period 2025-10\r\n\u001b[?2004l\r"]
[82.09338, "o", "wrote 39 rows x 10 columns (monthly_customer_performance, 2025-10) to /app/data/reports/monthly_customer_performance-2025-10.csv\r\n"]
[82.102128, "o", "\u001b[?2004hroot@0bde325b18a2:/app# "]
[82.102278, "o", "python -m reportkit.cli workspace-health\r\n\u001b[?2004l\r"]
[82.410946, "o", "{'service': 'report-workspace', 'status': 'ok', 'time': '2026-11-16T18:37:21.158352Z'}\r\n"]
[82.420666, "o", "\u001b[?2004hroot@0bde325b18a2:/app# "]
[82.79206, "i", "python - <<'PY'\nimport csv\nfrom collections import defaultdict\nfrom datetime import date\nfrom reportkit.config import load_settings\nfrom reportkit.customer_store import CustomerStore\nfrom reportkit.templates import get_template\nsettings = load_settings()\npath = settings.reports_dir / 'monthly_customer_performance-2025-10.csv'\nwith path.open() as f:\n    reader = csv.DictReader(f)\n    assert reader.fieldnames == get_template('monthly_customer_performance').columns\n    rows = list(reader)\nstore = CustomerStore(settings.db_path)\norders = defaultdict(list)\nfor order in store.orders_between(date(2025, 10, 1), date(2025, 11, 1)):\n    orders[order.customer_id].append(order)\nassert len(rows) == len(orders)\nassert {r['customer_id'] for r in rows} == set(orders)\nfor row in rows:\n    customer = store.customer(row['customer_id'])\n    assert row['period'] == '2025-10'\n    for dimension in ('segment', 'region', 'account_manager'):\n        assert row[dimension] == getattr(customer, dimension)\n    fulfilled = [o for o in orders[row['customer_id']] if o.status == 'fulfilled']\n    revenue = sum(o.total_cents for o in fulfilled)\n    assert int(row['orders']) == len(fulfilled)\n    assert int(row['active_days']) == len({o.placed_on for o in fulfilled})\n    assert int(row['revenue_cents']) == revenue\n    assert int(row['refunds_cents']) == sum(o.total_cents for o in orders[row['customer_id']] if o.status == 'refunded')\n    assert int(row['avg_order_cents']) == (revenue // len(fulfilled) if fulfilled else 0)\nstore.close()\nprint(f'Validated {len(rows)} customer rows and all requested dimensions and metrics: {path}')\nPY\n"]
[82.792419, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import csv\r\n\u001b[?2004l\r\u001b[?2004h> from collections import defaultdict\r\n"]
[82.792491, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[82.7925, "o", "from datetime import date\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.792554, "o", "from reportkit.config import load_settings\r\n\u001b[?2004l\r\u001b[?2004h"]
[82.792584, "o", "> "]
[82.792609, "o", "from reportkit.customer_store import CustomerStore\r\n\u001b[?2004l\r\u001b[?2004h"]
[82.792638, "o", "> "]
[82.792669, "o", "from reportkit.templates import get_template\r\n\u001b[?2004l\r"]
[82.792675, "o", "\u001b[?2004h"]
[82.792701, "o", "> "]
[82.792772, "o", "settings = load_settings()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.79283, "o", "path = settings.reports_dir / 'monthly_customer_performance-2025-10.csv'\r\n\u001b[?2004l\r"]
[82.792894, "o", "\u001b[?2004h> "]
[82.792948, "o", "with path.open() as f:\r\n\u001b[?2004l\r\u001b[?2004h>     reader = csv.DictReader(f)\r\n\u001b[?2004l\r"]
[82.792996, "o", "\u001b[?2004h> "]
[82.793094, "o", "    assert reader.fieldnames == get_template('monthly_customer_performance').columns\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.793166, "o", "    rows = list(reader)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.794092, "o", "store = CustomerStore(settings.db_path)\r\n\u001b[?2004l\r\u001b[?2004h> orders = defaultdict(list)\r\n\u001b[?2004l\r\u001b[?2004h> for order in store.orders_between(date(2025, 10, 1), date(2025, 11, 1)):\r\n\u001b[?2004l\r\u001b[?2004h>     orders[order.customer_id].append(order)\r\n\u001b[?2004l\r\u001b[?2004h> assert len(rows) == len(orders)\r\n\u001b[?2004l\r\u001b[?2004h> assert {r['customer_id'] for r in rows} == set(orders)\r\n\u001b[?2004l\r\u001b[?2004h> for row in rows:\r\n\u001b[?2004l\r\u001b[?2004h>     customer = store.customer(row['customer_id'])\r\n\u001b[?2004l\r\u001b[?2004h>     assert row['period'] == '2025-10'\r\n\u001b[?2004l\r\u001b[?2004h>     for dimension in ('segment', 'region', 'account_manager'):\r\n\u001b[?2004l\r\u001b[?2004h>         assert row[dimension] == getattr(customer, dimension)\r\n\u001b[?2004l\r\u001b[?2004h>     fulfilled = [o for o in orders[row['customer_id']] if o.status == 'fulfilled']\r\n\u001b[?2004l\r\u001b[?2004h>     revenue = sum(o.total_cents for o in fulfilled)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.794189, "o", "    assert int(row['orders']) == len(fulfilled)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.794321, "o", "    assert int(row['active_days']) == len({o.placed_on for o in fulfilled})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.794436, "o", "    assert int(row['revenue_cents']) == revenue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.79467, "o", "    assert int(row['refunds_cents']) == sum(o.total_cents for o in orders[row['customer_id']] if o.status == 'refunded')\r\n\u001b[?2004l\r\u001b[?2004h"]
[82.794737, "o", "> "]
[82.794906, "o", "    assert int(row['avg_order_cents']) == (revenue // len(fulfilled) if fulfilled else 0)\r\n\u001b[?2004l\r"]
[82.794969, "o", "\u001b[?2004h> store.close()\r\n\u001b[?2004l\r"]
[82.795029, "o", "\u001b[?2004h> "]
[82.795254, "o", "print(f'Validated {len(rows)} customer rows and all requested dimensions and metrics: {path}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[82.79559, "o", "> PY\r\n\u001b[?2004l\r"]
