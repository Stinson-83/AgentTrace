[45.694415, "o", "sed -n '45,125p' reportkit/cli.py\r\n\u001b[?2004l\r"]
[45.695495, "o", "def cmd_columns(args, settings) -> int:\r\n    for c in CATALOGUE.values():\r\n        flag = \"\" if c.implemented else \"  (not computed yet)\"\r\n        print(f\"{c.name:<24} {c.source:<16} {c.description}{flag}\")\r\n    return 0\r\n\r\n\r\ndef _render(args, settings):\r\n    template = get_template(args.template)\r\n    engine = ReportEngine(_store(settings))\r\n    return template, engine.rows_for(template, args.period, include=args.include, exclude=args.exclude)\r\n\r\n\r\ndef cmd_report_run(args, settings) -> int:\r\n    try:\r\n        template, report = _render(args, settings)\r\n    except (TemplateError, PeriodError, ColumnError, NotImplementedError) as e:\r\n        print(str(e), file=sys.stderr)\r\n        return 1\r\n    path = args.out or (settings.reports_dir / default_filename(report))\r\n    write_csv(report, path)\r\n    print(f\"wrote {report.row_count} rows x {len(report.columns)} columns ({template.name}, {report.period}) to {path}\")\r\n    return 0\r\n\r\n"]
[45.695632, "o", "\r\ndef cmd_report_publish(args, settings) -> int:\r\n    try:\r\n        template, report = _render(args, settings)\r\n    except (TemplateError, PeriodError, ColumnError, NotImplementedError) as e:\r\n        print(str(e), file=sys.stderr)\r\n        return 1\r\n    workspace = args.workspace or template.workspace\r\n    if not workspace:\r\n        print(f\"template {template.name} has no default workspace; pass --workspace\", file=sys.stderr)\r\n        return 1\r\n    client = WorkspaceClient(settings.workspace_url, settings.workspace_timeout_sec, settings.publisher)\r\n    try:\r\n        resp = client.publish(workspace, report, to_csv(report), default_filename(report))\r\n    except WorkspaceError as e:\r\n        print(str(e), file=sys.stderr)\r\n        return 1\r\n    print(f\"published {report.row_count} rows x {len(report.columns)} columns ({template.name}, {report.period}) to workspace {workspace}: report {resp.body.get('report_id')}\")\r\n    return 0\r\n\r\n\r\ndef cmd_workspace_health(args, settings) -> int:\r\n    try:\r\n        print(WorkspaceClient(settings.workspace_url, settings.workspace_timeout_sec).health().body)\r\n    except WorkspaceError as e:\r\n        print(str(e), file=sys.stderr)\r\n        return 1\r\n    return 0\r\n\r\n\r\ndef build_parser() -> argparse.ArgumentParser:\r\n    p = argparse.ArgumentParser(prog=\"reportkit\", description=\"Verdant Box reporting CLI\")\r\n    p.add_argument(\"--version\", action=\"version\", version=f\"reportkit {__version__}\")\r\n    sub = p.add_subparsers(dest=\"command\", required=True)\r\n    s = sub.add_parser(\"init-db\"); s.add_argument(\"--replace\", action=\"store_true\"); s.set_defaults(func=cmd_init_db)\r\n    sub.add_parser(\"templates\", help=\"list report templates\").set_defaults(func=cmd_templates)\r\n    sub.add_parser(\"columns\", help=\"list the column catalogue\").set_defaults(func=cmd_columns)\r\n    r = sub.add_parser(\"report\", help=\"run or publish a report\")\r\n    rsub = r.add_subparsers(dest=\"report_command\", required=True)\r\n    for name, func in ((\"run\", cmd_report_run), (\"publish\", cmd_report_publish)):\r\n        c = rsub.add_parser(name)\r\n        c.add_argument(\"--period\", required=True)\r\n        c.add_argument(\"--template\", help=f\"template name (default: account_review)\")\r\n        c.add_argument(\"--include\", nargs=\"*\", default=None); c.add_argument(\"--exclude\", nargs=\"*\", default=None)\r\n        if name == \"run\":\r\n            c.add_argument(\"--out\", type=lambda s: __import__(\"pathlib\").Path(s))\r\n        else:\r\n            c.add_argument(\"--workspace\", help=\"workspace slug (default: the template's workspace)\")\r\n        c.set_defaults(func=func)\r\n    sub.add_parser(\"workspace-health\", help=\"check the workspace service\").set_defaults(func=cmd_workspace_health)\r\n    return p\r\n\r\n\r\ndef main(argv: Sequence[str] | None = None) -> int:\r\n    args = build_parser().parse_args(argv)\r\n    return args.func(args, load_settings())\r\n\r\n"]
[45.695766, "o", "\u001b[?2004h"]
[45.695783, "o", "root@0bde325b18a2:/app# "]
[45.811052, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('reportkit/report_engine.py')\ns = p.read_text()\ns = s.replace('        refunded = [o for o in orders if o.status == \"refunded\"]\\n', '        refunded = [o for o in orders if o.status == \"refunded\"]\\n        revenue_cents = sum(o.total_cents for o in fulfilled)\\n')\ns = s.replace('            \"revenue_cents\": sum(o.total_cents for o in fulfilled),', '            \"revenue_cents\": revenue_cents,\\n            \"active_days\": len({o.placed_on for o in fulfilled}),\\n            \"avg_order_cents\": revenue_cents // len(fulfilled) if fulfilled else 0,')\np.write_text(s)\np = Path('reportkit/column_selector.py')\ns = p.read_text().replace(', implemented=False)', ')')\np.write_text(s)\np = Path('reportkit/templates.py')\ns = p.read_text()\nmarker = '    \"delivery_manifest\": ReportTemplate('\nnew = '''    \"monthly_customer_performance\": ReportTemplate(\n        name=\"monthly_customer_performance\",\n        purpose=\"Monthly customer performance: activity, revenue, refunds and average order value.\",\n        audience=\"revenue operations and the commercial organisation\",\n        columns=[\"customer_id\", \"segment\", \"region\", \"account_manager\", \"period\", \"orders\", \"active_days\",\n                 \"revenue_cents\", \"refunds_cents\", \"avg_order_cents\"],\n        workspace=\"revenue-ops\",\n        tags=[\"customer-level\", \"monthly\"],\n    ),\n'''\nassert marker in s\np.write_text(s.replace(marker, new + marker))\np = Path('docs/report_templates.md')\ns = p.read_text().replace('| `delivery_manifest`', '| `monthly_customer_performance` | Monthly customer activity, revenue, refunds and average order value. | revenue operations and the commercial organisation | `revenue-ops` |\\n| `delivery_manifest`', 1)\ns += '''\n## Monthly customer performance\n\n`monthly_customer_performance` contains `customer_id`, `segment`, `region`, `account_manager`,\n`period`, `orders`, `active_days`, `revenue_cents`, `refunds_cents` and `avg_order_cents`.\nIt includes one row per customer with orders in the month, following the same activity rule as\n`finance_close` (including customers with only refunded or cancelled orders).\n`orders` and `revenue_cents` count only fulfilled orders; `active_days` counts their distinct order\ndates. `refunds_cents` sums refunded order totals. `avg_order_cents` is fulfilled revenue divided\nby fulfilled orders using integer division, or zero with no fulfilled orders. Monetary values are\nin cents. Contact details and lifetime metrics are not included in this broadly shared report.\n\n```sh\npython -m reportkit.cli report run --template monthly_customer_performance --period 2025-10\npython -m reportkit.cli report publish --template monthly_customer_performance --period 2025-10\n```\n\nPublishing defaults to the `revenue-ops` workspace.\n'''\np.write_text(s)\nPY\n"]
