[114.980197, "i", "python - <<'PY'\nimport base64\nimport json\nfrom pathlib import Path\nfrom services.workspace_service import parse_multipart\np = max(Path('/var/lib/report-workspace/received/revenue-ops').glob('*.json'), key=lambda p: p.stat().st_mtime)\nr = json.loads(p.read_text())\nfields, files = parse_multipart(base64.b64decode(r['body_b64']), r['headers']['content-type'])\nassert r['workspace'] == 'revenue-ops'\nassert fields['template'] == 'monthly_customer_performance'\nassert fields['period'] == '2025-10'\nassert fields['rows'] == '39'\nfilename, content = files[0]\nassert filename == 'monthly_customer_performance-2025-10.csv'\nassert content == (Path('data/reports') / filename).read_bytes()\nprint('Verified persisted revenue-ops upload: October 2025, 39 customer rows, CSV matches rendered report.')\nPY\n"]
