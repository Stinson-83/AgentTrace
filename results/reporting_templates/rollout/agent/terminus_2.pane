from __future__ import annotations

import os
from dataclasses import dataclass
from pathlib import Path

PROJECT_ROOT = Path(__file__).resolve().parent.parent


@dataclass(frozen=True)
class Settings:
    db_path: Path
    seed_dir: Path
    reports_dir: Path
    workspace_url: str
    workspace_timeout_sec: float
    publisher: str

    @classmethod
    def from_env(cls) -> "Settings":
        data_dir = Path(os.environ.get("REPORTKIT_DATA_DIR", PROJECT_ROOT / "data"))
        return cls(
            db_path=Path(os.environ.get("REPORTKIT_DB_PATH", data_dir / "reportkit.db")),
            seed_dir=Path(os.environ.get("REPORTKIT_SEED_DIR", PROJECT_ROOT / "data" / "seed")),
            reports_dir=Path(os.environ.get("REPORTKIT_REPORTS_DIR", data_dir / "reports")),
            workspace_url=os.environ.get("WORKSPACE_URL", "http://127.0.0.1:8760"),
            workspace_timeout_sec=float(os.environ.get("WORKSPACE_TIMEOUT", "10")),
            publisher=os.environ.get("REPORTKIT_PUBLISHER", "reportkit"),
        )


def load_settings() -> Settings:
    return Settings.from_env()
"""CSV rendering of reports."""
from __future__ import annotations

import csv
import io
from pathlib import Path

from .report_engine import Report


def to_csv(report: Report) -> str:
    buf = io.StringIO()
    writer = csv.DictWriter(buf, fieldnames=report.columns, lineterminator="\n")
    writer.writeheader()
    for row in report.rows:
        writer.writerow({c: ("" if row.get(c) is None else row.get(c)) for c in report.columns})
    return buf.getvalue()


def write_csv(report: Report, path: Path) -> Path:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(to_csv(report), encoding="utf-8")
    return path


def default_filename(report: Report) -> str:
    return f"{report.template}-{report.period}.csv"
"""Client for the reporting workspace service (publishes CSV reports into a workspace)."""
from __future__ import annotations

import json
import urllib.error
import urllib.request
import uuid
from dataclasses import dataclass
from typing import Any

from .report_engine import Report


class WorkspaceError(RuntimeError):
    pass


@dataclass
class PublishResponse:
    status: int
    body: dict[str, Any]


class WorkspaceClient:
    def __init__(self, base_url: str, timeout_sec: float = 10.0, publisher: str = "reportkit"):
        self.base_url = base_url.rstrip("/")
        self.timeout_sec = timeout_sec
        self.publisher = publisher

    @staticmethod
    def _multipart(fields: dict[str, str], filename: str, content: bytes) -> tuple[bytes, str]:
        boundary = "reportkit-" + uuid.uuid4().hex
        parts = []
        for k, v in fields.items():
            parts.append(f'--{boundary}\r\nContent-Disposition: form-data; name="{k}"\r\n\r\n{v}\r\n'.encode("utf-8"))
        parts.append(f'--{boundary}\r\nContent-Disposition: form-data; name="file"; filename="{filename}"\r\nContent-Type: text/csv\r\n\r\n'.encode("utf-8") + content + b"\r\n")
        parts.append(f"--{boundary}--\r\n".encode("utf-8"))
        return b"".join(parts), f"multipart/form-data; boundary={boundary}"

    def publish(self, workspace: str, report: Report, csv_text: str, filename: str) -> PublishResponse:
        body, content_type = self._multipart(
            {"name": f"{report.template} {report.period}", "template": report.template, "period": report.period,
             "publisher": self.publisher, "rows": str(report.row_count)}, filename, csv_text.encode("utf-8"))
        req = urllib.request.Request(f"{self.base_url}/workspaces/{workspace}/reports", data=body, method="POST",
                                     headers={"Content-Type": content_type, "X-Publisher": self.publisher})
        try:
            with urllib.request.urlopen(req, timeout=self.timeout_sec) as resp:
                raw = resp.read().decode("utf-8")
                return PublishResponse(resp.status, json.loads(raw) if raw else {})
        except urllib.error.HTTPError as e:
            raise WorkspaceError(f"workspace rejected the report ({e.code}): {e.read().decode('utf-8', 'replace')}") from e
        except urllib.error.URLError as e:
            raise WorkspaceError(f"workspace unreachable at {self.base_url}: {e.reason}") from e

    def health(self) -> PublishResponse:
        try:
            with urllib.request.urlopen(self.base_url + "/healthz", timeout=self.timeout_sec) as resp:
                return PublishResponse(resp.status, json.loads(resp.read().decode("utf-8")))
        except urllib.error.URLError as e:
            raise WorkspaceError(f"workspace unreachable at {self.base_url}: {e.reason}") from e
[?2004hroot@0bde325b18a2:/app# sed -n '45,125p' reportkit/cli.py
[?2004ldef cmd_columns(args, settings) -> int:
    for c in CATALOGUE.values():
        flag = "" if c.implemented else "  (not computed yet)"
        print(f"{c.name:<24} {c.source:<16} {c.description}{flag}")
    return 0


def _render(args, settings):
    template = get_template(args.template)
    engine = ReportEngine(_store(settings))
    return template, engine.rows_for(template, args.period, include=args.include, exclude=args.exclude)


def cmd_report_run(args, settings) -> int:
    try:
        template, report = _render(args, settings)
    except (TemplateError, PeriodError, ColumnError, NotImplementedError) as e:
        print(str(e), file=sys.stderr)
        return 1
    path = args.out or (settings.reports_dir / default_filename(report))
    write_csv(report, path)
    print(f"wrote {report.row_count} rows x {len(report.columns)} columns ({template.name}, {report.period}) to {path}")
    return 0


def cmd_report_publish(args, settings) -> int:
    try:
        template, report = _render(args, settings)
    except (TemplateError, PeriodError, ColumnError, NotImplementedError) as e:
        print(str(e), file=sys.stderr)
        return 1
    workspace = args.workspace or template.workspace
    if not workspace:
        print(f"template {template.name} has no default workspace; pass --workspace", file=sys.stderr)
        return 1
    client = WorkspaceClient(settings.workspace_url, settings.workspace_timeout_sec, settings.publisher)
    try:
        resp = client.publish(workspace, report, to_csv(report), default_filename(report))
    except WorkspaceError as e:
        print(str(e), file=sys.stderr)
        return 1
    print(f"published {report.row_count} rows x {len(report.columns)} columns ({template.name}, {report.period}) to workspace {workspace}: report {resp.body.get('report_id')}")
    return 0


def cmd_workspace_health(args, settings) -> int:
    try:
        print(WorkspaceClient(settings.workspace_url, settings.workspace_timeout_sec).health().body)
    except WorkspaceError as e:
        print(str(e), file=sys.stderr)
        return 1
    return 0


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="reportkit", description="Verdant Box reporting CLI")
    p.add_argument("--version", action="version", version=f"reportkit {__version__}")
    sub = p.add_subparsers(dest="command", required=True)
    s = sub.add_parser("init-db"); s.add_argument("--replace", action="store_true"); s.set_defaults(func=cmd_init_db)
    sub.add_parser("templates", help="list report templates").set_defaults(func=cmd_templates)
    sub.add_parser("columns", help="list the column catalogue").set_defaults(func=cmd_columns)
    r = sub.add_parser("report", help="run or publish a report")
    rsub = r.add_subparsers(dest="report_command", required=True)
    for name, func in (("run", cmd_report_run), ("publish", cmd_report_publish)):
        c = rsub.add_parser(name)
        c.add_argument("--period", required=True)
        c.add_argument("--template", help=f"template name (default: account_review)")
        c.add_argument("--include", nargs="*", default=None); c.add_argument("--exclude", nargs="*", default=None)
        if name == "run":
            c.add_argument("--out", type=lambda s: __import__("pathlib").Path(s))
        else:
            c.add_argument("--workspace", help="workspace slug (default: the template's workspace)")
        c.set_defaults(func=func)
    sub.add_parser("workspace-health", help="check the workspace service").set_defaults(func=cmd_workspace_health)
    return p


def main(argv: Sequence[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    return args.func(args, load_settings())

