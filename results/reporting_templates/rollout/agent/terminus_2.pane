[?2004l"""Builds report rows for a template and period."""
from __future__ import annotations

import calendar
import re
from dataclasses import dataclass
from datetime import date
from typing import Any

from .column_selector import CATALOGUE, columns_by_source, resolve_columns
from .customer_store import Customer, CustomerStore, Order
from .templates import ReportTemplate

_PERIOD_RE = re.compile(r"^(\d{4})-(\d{2})$")


class PeriodError(ValueError):
    pass


def period_bounds(period: str) -> tuple[date, date]:
    m = _PERIOD_RE.match(period or "")
    if not m or not 1 <= int(m.group(2)) <= 12:
        raise PeriodError(f"period must look like YYYY-MM, got {period!r}")
    y, mo = int(m.group(1)), int(m.group(2))
    return date(y, mo, 1), date(y + (mo == 12), mo % 12 + 1, 1)


@dataclass
class Report:
    template: str
    period: str
    columns: list[str]
    rows: list[dict[str, Any]]

    @property
    def row_count(self) -> int:
        return len(self.rows)


class ReportEngine:
    def __init__(self, store: CustomerStore):
        self.store = store

    # ------------------------------------------------------------ metric blocks
    def period_metrics(self, orders: list[Order], period: str) -> dict[str, Any]:
        fulfilled = [o for o in orders if o.status == "fulfilled"]
        refunded = [o for o in orders if o.status == "refunded"]
        return {
            "period": period,
            "orders": len(fulfilled),
            "revenue_cents": sum(o.total_cents for o in fulfilled),
            "refunds_cents": sum(o.total_cents for o in refunded),
        }

    def lifetime_metrics(self, orders: list[Order]) -> dict[str, Any]:
        fulfilled = [o for o in orders if o.status == "fulfilled"]
        return {
            "lifetime_orders": len(fulfilled),
            "lifetime_revenue_cents": sum(o.total_cents for o in fulfilled),
            "last_order_on": max((o.placed_on for o in fulfilled), default=None),
        }

    @staticmethod
    def profile_columns(customer: Customer) -> dict[str, Any]:
        return dict(customer.__dict__)

    # ------------------------------------------------------------ rows
    def rows_for(self, template: ReportTemplate, period: str, include: list[str] | None = None, exclude: list[str] | None = None) -> Report:
        columns = resolve_columns(template, include, exclude)
        missing = [c for c in columns if not CATALOGUE[c].implemented]
        if missing:
            raise NotImplementedError(f"column(s) not computed by the engine yet: {', '.join(missing)}")
        start, end = period_bounds(period)
        by_source = columns_by_source(columns)
        period_orders: dict[str, list[Order]] = {}
        for o in self.store.orders_between(start, end):
            period_orders.setdefault(o.customer_id, []).append(o)
        rows: list[dict[str, Any]] = []
        if template.row_level == "order":
            customers = {c.customer_id: c for c in self.store.customers()}
            for o in self.store.orders_between(start, end):
                if o.status != "fulfilled":
                    continue
                record = {**self.profile_columns(customers[o.customer_id]), **o.__dict__}
                rows.append({c: record.get(c) for c in columns})
            return Report(template.name, period, columns, rows)
        lifetime: dict[str, list[Order]] = {}
        if "lifetime-metric" in by_source:
            for o in self.store.all_orders():
                lifetime.setdefault(o.customer_id, []).append(o)
        for customer in self.store.customers():
            if "period-metric" in by_source and customer.customer_id not in period_orders:
                continue  # customer-level period reports only list customers with activity in the period
            record: dict[str, Any] = self.profile_columns(customer)
            if "period-metric" in by_source:
                record.update(self.period_metrics(period_orders.get(customer.customer_id, []), period))
            if "lifetime-metric" in by_source:
                record.update(self.lifetime_metrics(lifetime.get(customer.customer_id, [])))
            rows.append({c: record.get(c) for c in columns})
        return Report(template.name, period, columns, rows)
"""SQLite store for customers and orders."""
from __future__ import annotations

import json
import sqlite3
from dataclasses import dataclass
from datetime import date
from pathlib import Path

SCHEMA = """
CREATE TABLE IF NOT EXISTS customers (
    customer_id TEXT PRIMARY KEY, full_name TEXT NOT NULL, email TEXT NOT NULL, phone TEXT, date_of_birth TEXT,
    residential_address TEXT NOT NULL, postcode TEXT NOT NULL, region TEXT NOT NULL, segment TEXT NOT NULL,
    account_manager TEXT NOT NULL, joined_on TEXT NOT NULL
);
CREATE TABLE IF NOT EXISTS orders (
    order_id TEXT PRIMARY KEY, customer_id TEXT NOT NULL REFERENCES customers(customer_id), placed_on TEXT NOT NULL,
    status TEXT NOT NULL CHECK (status IN ('fulfilled','cancelled','refunded')), subtotal_cents INTEGER NOT NULL,
    discount_cents INTEGER NOT NULL, total_cents INTEGER NOT NULL
);
CREATE INDEX IF NOT EXISTS idx_orders_customer_day ON orders(customer_id, placed_on);
"""


@dataclass(frozen=True)
class Customer:
    customer_id: str
    full_name: str
    email: str
    phone: str | None
    date_of_birth: str | None
    residential_address: str
    postcode: str
    region: str
    segment: str
    account_manager: str
    joined_on: str


@dataclass(frozen=True)
class Order:
    order_id: str
    customer_id: str
    placed_on: str
    status: str
    subtotal_cents: int
    discount_cents: int
    total_cents: int


class StoreError(LookupError):
    pass


class CustomerStore:
    def __init__(self, db_path: Path):
        db_path.parent.mkdir(parents=True, exist_ok=True)
        self._conn = sqlite3.connect(str(db_path))
        self._conn.row_factory = sqlite3.Row
        self._conn.executescript(SCHEMA)

    def close(self) -> None:
        self._conn.close()

    def load_seed(self, seed_dir: Path, replace: bool = False) -> tuple[int, int]:
        customers = json.loads((seed_dir / "customers.json").read_text())
        orders = json.loads((seed_dir / "orders.json").read_text())
        with self._conn:
            if replace:
                self._conn.execute("DELETE FROM orders")
                self._conn.execute("DELETE FROM customers")
            self._conn.executemany(
                "INSERT OR REPLACE INTO customers VALUES (:customer_id,:full_name,:email,:phone,:date_of_birth,:residential_address,"
                ":postcode,:region,:segment,:account_manager,:joined_on)", customers)
            self._conn.executemany(
                "INSERT OR REPLACE INTO orders VALUES (:order_id,:customer_id,:placed_on,:status,:subtotal_cents,:discount_cents,:total_cents)", orders)
        return len(customers), len(orders)

    def customer(self, customer_id: str) -> Customer:
        row = self._conn.execute("SELECT * FROM customers WHERE customer_id = ?", (customer_id,)).fetchone()
        if row is None:
            raise StoreError(f"unknown customer {customer_id!r}")
        return Customer(**dict(row))

    def customers(self, segment: str | None = None) -> list[Customer]:
        sql, params = "SELECT * FROM customers", []
        if segment:
            sql += " WHERE segment = ?"; params.append(segment)
        return [Customer(**dict(r)) for r in self._conn.execute(sql + " ORDER BY customer_id", params)]

    def orders_between(self, start: date, end_exclusive: date) -> list[Order]:
        rows = self._conn.execute("SELECT * FROM orders WHERE placed_on >= ? AND placed_on < ? ORDER BY placed_on, order_id",
                                  (start.isoformat(), end_exclusive.isoformat()))
        return [Order(**dict(r)) for r in rows]

    def all_orders(self) -> list[Order]:
        return [Order(**dict(r)) for r in self._conn.execute("SELECT * FROM orders ORDER BY placed_on, order_id")]

    def counts(self) -> dict[str, int]:
        return {"customers": self._conn.execute("SELECT COUNT(*) FROM customers").fetchone()[0],
                "orders": self._conn.execute("SELECT COUNT(*) FROM orders").fetchone()[0]}
[?2004hroot@0bde325b18a2:/app# cat reportkit/cli.py reportkit/export_writer.py reportkit/workspace_client.py reportkit/config.py
[?2004l"""reportkit command line.

    python -m reportkit.cli init-db [--replace]
    python -m reportkit.cli templates
    python -m reportkit.cli columns
    python -m reportkit.cli report run --period YYYY-MM [--template T] [--include C ...] [--exclude C ...] [--out FILE]
    python -m reportkit.cli report publish --period YYYY-MM [--template T] [--workspace W]
    python -m reportkit.cli workspace-health
"""
from __future__ import annotations

import argparse
import sys
from typing import Sequence

from . import __version__
from .column_selector import CATALOGUE, ColumnError
from .config import load_settings
from .customer_store import CustomerStore
from .export_writer import default_filename, to_csv, write_csv
from .report_engine import PeriodError, ReportEngine
from .templates import TEMPLATES, TemplateError, get_template
from .workspace_client import WorkspaceClient, WorkspaceError


def _store(settings) -> CustomerStore:
    if not settings.db_path.exists():
        print(f"database not found at {settings.db_path}; run `init-db` first", file=sys.stderr)
        raise SystemExit(2)
    return CustomerStore(settings.db_path)


def cmd_init_db(args, settings) -> int:
    c, o = CustomerStore(settings.db_path).load_seed(settings.seed_dir, replace=args.replace)
    print(f"loaded {c} customers and {o} orders into {settings.db_path}")
    return 0


def cmd_templates(args, settings) -> int:
    for t in TEMPLATES.values():
        print(f"{t.name}\n  purpose:   {t.purpose}\n  audience:  {t.audience}\n  workspace: {t.workspace}\n  columns:   {', '.join(t.columns)}")
    return 0


def cmd_columns(args, settings) -> int:
    for c in CATALOGUE.values():
        flag = "" if c.implemented else "  (not computed yet)"
        print(f"{c.name:<24} {c.source:<16} {c.description}{flag}")
    return 0


def _render(args, settings):
    template = get_template(args.template)
    engine = ReportEngine(_store(settings))
    return template, engine.rows_for(template, args.period, include=args.include, exclude=args.exclude)


def cmd_report_run(args, settings) -> int:
    try:
        template, report = _render(args, settings)
    except (TemplateError, PeriodError, ColumnError, NotImplementedError) as e:
        print(str(e), file=sys.stderr)
        return 1
    path = args.out or (settings.reports_dir / default_filename(report))
    write_csv(report, path)
    print(f"wrote {report.row_count} rows x {len(report.columns)} columns ({template.name}, {report.period}) to {path}")
    return 0


def cmd_report_publish(args, settings) -> int:
    try:
        template, report = _render(args, settings)
    except (TemplateError, PeriodError, ColumnError, NotImplementedError) as e:
        print(str(e), file=sys.stderr)
        return 1
    workspace = args.workspace or template.workspace
    if not workspace:
        print(f"template {template.name} has no default workspace; pass --workspace", file=sys.stderr)
        return 1
    client = WorkspaceClient(settings.workspace_url, settings.workspace_timeout_sec, settings.publisher)
    try:
        resp = client.publish(workspace, report, to_csv(report), default_filename(report))
    except WorkspaceError as e:
        print(str(e), file=sys.stderr)
        return 1
    print(f"published {report.row_count} rows x {len(report.columns)} columns ({template.name}, {report.period}) to workspace {workspace}: report {resp.body.get('report_id')}")
    return 0


def cmd_workspace_health(args, settings) -> int:
    try:
        print(WorkspaceClient(settings.workspace_url, settings.workspace_timeout_sec).health().body)
    except WorkspaceError as e:
        print(str(e), file=sys.stderr)
        return 1
    return 0


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="reportkit", description="Verdant Box reporting CLI")
    p.add_argument("--version", action="version", version=f"reportkit {__version__}")
    sub = p.add_subparsers(dest="command", required=True)
    s = sub.add_parser("init-db"); s.add_argument("--replace", action="store_true"); s.set_defaults(func=cmd_init_db)
    sub.add_parser("templates", help="list report templates").set_defaults(func=cmd_templates)
    sub.add_parser("columns", help="list the column catalogue").set_defaults(func=cmd_columns)
    r = sub.add_parser("report", help="run or publish a report")
    rsub = r.add_subparsers(dest="report_command", required=True)
    for name, func in (("run", cmd_report_run), ("publish", cmd_report_publish)):
        c = rsub.add_parser(name)
        c.add_argument("--period", required=True)
        c.add_argument("--template", help=f"template name (default: account_review)")
        c.add_argument("--include", nargs="*", default=None); c.add_argument("--exclude", nargs="*", default=None)
        if name == "run":
            c.add_argument("--out", type=lambda s: __import__("pathlib").Path(s))
        else:
            c.add_argument("--workspace", help="workspace slug (default: the template's workspace)")
        c.set_defaults(func=func)
    sub.add_parser("workspace-health", help="check the workspace service").set_defaults(func=cmd_workspace_health)
    return p


def main(argv: Sequence[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    return args.func(args, load_settings())


if __name__ == "__main__":
    sys.exit(main())
"""CSV rendering of reports."""
from __future__ import annotations

import csv
import io
from pathlib import Path

from .report_engine import Report


def to_csv(report: Report) -> str:
    buf = io.StringIO()
    writer = csv.DictWriter(buf, fieldnames=report.columns, lineterminator="\n")
    writer.writeheader()
    for row in report.rows:
        writer.writerow({c: ("" if row.get(c) is None else row.get(c)) for c in report.columns})
    return buf.getvalue()


def write_csv(report: Report, path: Path) -> Path:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(to_csv(report), encoding="utf-8")
    return path


def default_filename(report: Report) -> str:
    return f"{report.template}-{report.period}.csv"
"""Client for the reporting workspace service (publishes CSV reports into a workspace)."""
from __future__ import annotations

import json
import urllib.error
import urllib.request
import uuid
from dataclasses import dataclass
from typing import Any

from .report_engine import Report


class WorkspaceError(RuntimeError):
    pass


@dataclass
class PublishResponse:
    status: int
    body: dict[str, Any]


class WorkspaceClient:
    def __init__(self, base_url: str, timeout_sec: float = 10.0, publisher: str = "reportkit"):
        self.base_url = base_url.rstrip("/")
        self.timeout_sec = timeout_sec
        self.publisher = publisher

    @staticmethod
    def _multipart(fields: dict[str, str], filename: str, content: bytes) -> tuple[bytes, str]:
        boundary = "reportkit-" + uuid.uuid4().hex
        parts = []
        for k, v in fields.items():
            parts.append(f'--{boundary}\r\nContent-Disposition: form-data; name="{k}"\r\n\r\n{v}\r\n'.encode("utf-8"))
        parts.append(f'--{boundary}\r\nContent-Disposition: form-data; name="file"; filename="{filename}"\r\nContent-Type: text/csv\r\n\r\n'.encode("utf-8") + content + b"\r\n")
        parts.append(f"--{boundary}--\r\n".encode("utf-8"))
        return b"".join(parts), f"multipart/form-data; boundary={boundary}"

    def publish(self, workspace: str, report: Report, csv_text: str, filename: str) -> PublishResponse:
        body, content_type = self._multipart(
            {"name": f"{report.template} {report.period}", "template": report.template, "period": report.period,
             "publisher": self.publisher, "rows": str(report.row_count)}, filename, csv_text.encode("utf-8"))
        req = urllib.request.Request(f"{self.base_url}/workspaces/{workspace}/reports", data=body, method="POST",
                                     headers={"Content-Type": content_type, "X-Publisher": self.publisher})
        try:
            with urllib.request.urlopen(req, timeout=self.timeout_sec) as resp:
                raw = resp.read().decode("utf-8")
                return PublishResponse(resp.status, json.loads(raw) if raw else {})
        except urllib.error.HTTPError as e:
            raise WorkspaceError(f"workspace rejected the report ({e.code}): {e.read().decode('utf-8', 'replace')}") from e
        except urllib.error.URLError as e:
            raise WorkspaceError(f"workspace unreachable at {self.base_url}: {e.reason}") from e

    def health(self) -> PublishResponse:
        try:
            with urllib.request.urlopen(self.base_url + "/healthz", timeout=self.timeout_sec) as resp:
                return PublishResponse(resp.status, json.loads(resp.read().decode("utf-8")))
        except urllib.error.URLError as e:
            raise WorkspaceError(f"workspace unreachable at {self.base_url}: {e.reason}") from e
"""Runtime settings with local-development defaults."""
from __future__ import annotations

import os
from dataclasses import dataclass
from pathlib import Path

PROJECT_ROOT = Path(__file__).resolve().parent.parent


@dataclass(frozen=True)
class Settings:
    db_path: Path
    seed_dir: Path
    reports_dir: Path
    workspace_url: str
    workspace_timeout_sec: float
    publisher: str

    @classmethod
    def from_env(cls) -> "Settings":
        data_dir = Path(os.environ.get("REPORTKIT_DATA_DIR", PROJECT_ROOT / "data"))
        return cls(
            db_path=Path(os.environ.get("REPORTKIT_DB_PATH", data_dir / "reportkit.db")),
            seed_dir=Path(os.environ.get("REPORTKIT_SEED_DIR", PROJECT_ROOT / "data" / "seed")),
            reports_dir=Path(os.environ.get("REPORTKIT_REPORTS_DIR", data_dir / "reports")),
            workspace_url=os.environ.get("WORKSPACE_URL", "http://127.0.0.1:8760"),
            workspace_timeout_sec=float(os.environ.get("WORKSPACE_TIMEOUT", "10")),
            publisher=os.environ.get("REPORTKIT_PUBLISHER", "reportkit"),
        )


def load_settings() -> Settings:
    return Settings.from_env()
