"""Column catalogue and template column resolution."""
from __future__ import annotations

from dataclasses import dataclass

from .templates import ReportTemplate


@dataclass(frozen=True)
class ColumnSpec:
    name: str
    source: str        # profile | period-metric | lifetime-metric | order
    description: str
    implemented: bool = True


CATALOGUE: dict[str, ColumnSpec] = {c.name: c for c in [
    ColumnSpec("customer_id", "profile", "Customer identifier"),
    ColumnSpec("full_name", "profile", "Customer name"),
    ColumnSpec("email", "profile", "Contact e-mail"),
    ColumnSpec("phone", "profile", "Contact phone"),
    ColumnSpec("date_of_birth", "profile", "Date of birth"),
    ColumnSpec("residential_address", "profile", "Delivery / residential address"),
    ColumnSpec("postcode", "profile", "Postcode"),
    ColumnSpec("region", "profile", "Sales region"),
    ColumnSpec("segment", "profile", "Subscription segment (plus / standard / trial)"),
    ColumnSpec("account_manager", "profile", "Owning account manager"),
    ColumnSpec("joined_on", "profile", "Join date"),
    ColumnSpec("period", "period-metric", "Reporting period YYYY-MM"),
    ColumnSpec("orders", "period-metric", "Fulfilled orders in the period"),
    ColumnSpec("revenue_cents", "period-metric", "Sum of fulfilled order totals in the period"),
    ColumnSpec("refunds_cents", "period-metric", "Sum of refunded order totals in the period"),
    ColumnSpec("active_days", "period-metric", "Distinct days with a fulfilled order in the period", implemented=False),
    ColumnSpec("avg_order_cents", "period-metric", "revenue_cents / orders (0 when no orders)", implemented=False),
    ColumnSpec("lifetime_orders", "lifetime-metric", "Fulfilled orders ever"),
    ColumnSpec("lifetime_revenue_cents", "lifetime-metric", "Sum of fulfilled order totals ever"),
    ColumnSpec("last_order_on", "lifetime-metric", "Date of the last fulfilled order"),
    ColumnSpec("order_id", "order", "Order identifier"),
    ColumnSpec("placed_on", "order", "Order date"),
]}


class ColumnError(ValueError):
    pass


def resolve_columns(template: ReportTemplate, include: list[str] | None = None, exclude: list[str] | None = None) -> list[str]:
    """Final column list for a run: template columns plus ``include`` minus ``exclude``, validated."""
    columns = [c for c in template.columns if c not in set(exclude or [])]
    for c in include or []:
        if c not in columns:
            columns.append(c)
    unknown = [c for c in columns if c not in CATALOGUE]
    if unknown:
        raise ColumnError(f"unknown column(s): {', '.join(unknown)}")
    if template.row_level == "customer" and any(CATALOGUE[c].source == "order" for c in columns):
        raise ColumnError("order-level columns cannot be used in a customer-level template")
    return columns


def columns_by_source(columns: list[str]) -> dict[str, list[str]]:
    out: dict[str, list[str]] = {}
    for c in columns:
        out.setdefault(CATALOGUE[c].source, []).append(c)
    return out
"""Report templates: a named column set with a documented purpose and audience.

See docs/report_templates.md. New templates are usually derived from an existing one with
``derive`` so column naming stays consistent across the catalogue.
"""
from __future__ import annotations

from dataclasses import dataclass, field, replace


@dataclass(frozen=True)
class ReportTemplate:
    name: str
    purpose: str
    audience: str
    columns: list[str]
    row_level: str = "customer"      # "customer" or "order"
    workspace: str | None = None     # default workspace for `report publish`
    tags: list[str] = field(default_factory=list)


TEMPLATES: dict[str, ReportTemplate] = {
    "account_review": ReportTemplate(
        name="account_review",
        purpose="Quarterly 1:1 account reviews: everything an account manager needs in front of them when calling the customer.",
        audience="the customer's own account manager",
        columns=["customer_id", "full_name", "email", "phone", "residential_address", "postcode", "region", "segment",
                 "account_manager", "joined_on", "lifetime_orders", "lifetime_revenue_cents", "last_order_on"],
        workspace="account-management",
        tags=["customer-level", "contact-details"],
    ),
    "finance_close": ReportTemplate(
        name="finance_close",
        purpose="Month-end revenue recognition per customer.",
        audience="finance",
        columns=["customer_id", "segment", "period", "orders", "revenue_cents", "refunds_cents"],
        workspace="finance",
        tags=["customer-level", "monthly"],
    ),
    "delivery_manifest": ReportTemplate(
        name="delivery_manifest",
        purpose="Courier handover for a period: who gets what delivered where.",
        audience="logistics partner",
        columns=["order_id", "placed_on", "full_name", "residential_address", "postcode"],
        row_level="order",
        workspace="logistics",
        tags=["order-level", "operational"],
    ),
}

DEFAULT_TEMPLATE = "account_review"


class TemplateError(LookupError):
    pass


def get_template(name: str | None) -> ReportTemplate:
    key = name or DEFAULT_TEMPLATE
    try:
        return TEMPLATES[key]
    except KeyError:
        raise TemplateError(f"unknown template {key!r}; known: {', '.join(sorted(TEMPLATES))}") from None


def derive(base: str, name: str, purpose: str, audience: str, add: list[str] | None = None, workspace: str | None = None) -> ReportTemplate:
    """A new template that starts from ``base``'s columns and appends ``add``."""
    parent = get_template(base)
    columns = list(parent.columns) + [c for c in (add or []) if c not in parent.columns]
    template = replace(parent, name=name, purpose=purpose, audience=audience, columns=columns, workspace=workspace or parent.workspace)
    TEMPLATES[name] = template
    return template


def register(template: ReportTemplate) -> ReportTemplate:
    TEMPLATES[template.name] = template
    return template
