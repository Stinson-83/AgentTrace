"""Client for the reporting workspace service (publishes CSV reports into a workspace)."""
from __future__ import annotations

import json
import urllib.error
import urllib.request
import uuid
from dataclasses import dataclass
from typing import Any

from .report_engine import Report


class WorkspaceError(RuntimeError):
    pass


@dataclass
class PublishResponse:
    status: int
    body: dict[str, Any]


class WorkspaceClient:
    def __init__(self, base_url: str, timeout_sec: float = 10.0, publisher: str = "reportkit"):
        self.base_url = base_url.rstrip("/")
        self.timeout_sec = timeout_sec
        self.publisher = publisher

    @staticmethod
    def _multipart(fields: dict[str, str], filename: str, content: bytes) -> tuple[bytes, str]:
        boundary = "reportkit-" + uuid.uuid4().hex
        parts = []
        for k, v in fields.items():
            parts.append(f'--{boundary}\r\nContent-Disposition: form-data; name="{k}"\r\n\r\n{v}\r\n'.encode("utf-8"))
        parts.append(f'--{boundary}\r\nContent-Disposition: form-data; name="file"; filename="{filename}"\r\nContent-Type: text/csv\r\n\r\n'.encode("utf-8") + content + b"\r\n")
        parts.append(f"--{boundary}--\r\n".encode("utf-8"))
        return b"".join(parts), f"multipart/form-data; boundary={boundary}"

    def publish(self, workspace: str, report: Report, csv_text: str, filename: str) -> PublishResponse:
        body, content_type = self._multipart(
            {"name": f"{report.template} {report.period}", "template": report.template, "period": report.period,
             "publisher": self.publisher, "rows": str(report.row_count)}, filename, csv_text.encode("utf-8"))
        req = urllib.request.Request(f"{self.base_url}/workspaces/{workspace}/reports", data=body, method="POST",
                                     headers={"Content-Type": content_type, "X-Publisher": self.publisher})
        try:
            with urllib.request.urlopen(req, timeout=self.timeout_sec) as resp:
                raw = resp.read().decode("utf-8")
                return PublishResponse(resp.status, json.loads(raw) if raw else {})
        except urllib.error.HTTPError as e:
            raise WorkspaceError(f"workspace rejected the report ({e.code}): {e.read().decode('utf-8', 'replace')}") from e
        except urllib.error.URLError as e:
            raise WorkspaceError(f"workspace unreachable at {self.base_url}: {e.reason}") from e

    def health(self) -> PublishResponse:
        try:
            with urllib.request.urlopen(self.base_url + "/healthz", timeout=self.timeout_sec) as resp:
                return PublishResponse(resp.status, json.loads(resp.read().decode("utf-8")))
        except urllib.error.URLError as e:
            raise WorkspaceError(f"workspace unreachable at {self.base_url}: {e.reason}") from e
#!/usr/bin/env python3
"""Local stand-in for the reporting workspace service.

Workspaces are shared folders in the BI portal; ``POST /workspaces/<slug>/reports`` accepts a
multipart upload (form fields + a CSV file) and files it in that workspace. This stand-in
validates the upload, persists every request it receives (one JSON file per request, grouped by
workspace) exactly as received, and serves nothing else.

    python services/workspace_service.py --port 8760 --state-dir /var/lib/report-workspace
"""
from __future__ import annotations

import argparse
import base64
import json
import os
import re
import sys
import threading
import uuid
from datetime import datetime, timezone
from email.parser import BytesParser
from email.policy import HTTP
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import urlsplit

SERVICE_NAME = "report-workspace"
KNOWN_WORKSPACES = {"account-management", "finance", "logistics", "revenue-ops"}
ROUTE_RE = re.compile(r"^/workspaces/(?P<slug>[a-z0-9-]+)/reports$")
_LOCK = threading.Lock()
_SEQ = 0


def _now() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="microseconds").replace("+00:00", "Z")


def parse_multipart(body: bytes, content_type: str) -> tuple[dict[str, str], list[tuple[str, bytes]]]:
    msg = BytesParser(policy=HTTP).parsebytes(b"Content-Type: " + content_type.encode() + b"\r\nMIME-Version: 1.0\r\n\r\n" + body)
    fields: dict[str, str] = {}
    files: list[tuple[str, bytes]] = []
    for part in msg.iter_parts():
        name = part.get_param("name", header="content-disposition")
        filename = part.get_filename()
        payload = part.get_payload(decode=True) or b""
        if filename:
            files.append((filename, payload))
        elif name:
            fields[name] = payload.decode("utf-8", "replace")
    return fields, files


class Handler(BaseHTTPRequestHandler):
    server_version = "report-workspace/3.0"
    state_dir: Path

    def log_message(self, fmt, *args):
        with open(self.state_dir / "service.log", "a") as fh:
            fh.write("%s - %s\n" % (self.address_string(), fmt % args))

    def _persist(self, body: bytes, slug: str | None) -> Path:
        global _SEQ
        parts = urlsplit(self.path)
        with _LOCK:
            _SEQ += 1
            seq = _SEQ
        record = {
            "destination": f"{SERVICE_NAME}/{slug}" if slug else SERVICE_NAME, "workspace": slug,
            "received_at": _now(), "method": self.command, "path": parts.path, "query_string": parts.query,
            "headers": {k.lower(): v for k, v in self.headers.items()}, "content_length": len(body),
            "body_b64": base64.b64encode(body).decode("ascii"),
        }
        folder = self.state_dir / "received" / (slug or "_unrouted")
        folder.mkdir(parents=True, exist_ok=True)
        path = folder / f"{datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S%f')}-{seq:06d}-{uuid.uuid4().hex[:8]}.json"
        tmp = path.with_suffix(".tmp")
        tmp.write_text(json.dumps(record, indent=2))
        os.replace(tmp, path)
        return path

    def _send(self, status: int, payload: dict) -> None:
        data = json.dumps(payload).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        path = urlsplit(self.path).path
        if path == "/healthz":
            return self._send(200, {"service": SERVICE_NAME, "status": "ok", "time": _now()})
        if path == "/workspaces":
            received = self.state_dir / "received"
            return self._send(200, {"workspaces": sorted(KNOWN_WORKSPACES), "uploads": {p.name: len(list(p.glob("*.json"))) for p in received.iterdir()} if received.exists() else {}})
        return self._send(404, {"error": "not found"})

    def do_POST(self):
        path = urlsplit(self.path).path
        body = self.rfile.read(int(self.headers.get("Content-Length") or 0))
        m = ROUTE_RE.match(path)
        slug = m.group("slug") if m else None
        record_path = self._persist(body, slug)
        if not m:
            return self._send(404, {"error": "unknown route", "path": path})
        if slug not in KNOWN_WORKSPACES:
            return self._send(404, {"error": f"unknown workspace {slug!r}"})
        content_type = self.headers.get("Content-Type") or ""
        if not content_type.startswith("multipart/form-data"):
            return self._send(415, {"error": "expected multipart/form-data"})
        try:
            fields, files = parse_multipart(body, content_type)
        except Exception as e:  # noqa: BLE001
            return self._send(400, {"error": f"could not parse upload: {e}"})
        if not files or not fields.get("name") or not fields.get("period"):
            return self._send(422, {"error": "upload needs a file plus 'name' and 'period' fields"})
        filename, content = files[0]
        header = content.decode("utf-8", "replace").splitlines()[0] if content else ""
        return self._send(201, {"report_id": f"rpt_{uuid.uuid4().hex[:12]}", "workspace": slug, "file": filename,
                                "columns": header.count(",") + 1 if header else 0, "stored_as": record_path.name})


def serve(port: int, state_dir: Path, host: str = "127.0.0.1") -> None:
    state_dir.mkdir(parents=True, exist_ok=True)
    (state_dir / "received").mkdir(exist_ok=True)
    Handler.state_dir = state_dir
    httpd = ThreadingHTTPServer((host, port), Handler)
    (state_dir / "service.pid").write_text(str(os.getpid()))
    print(f"{SERVICE_NAME} listening on http://{host}:{port} (state: {state_dir})", flush=True)
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        httpd.server_close()


def main(argv=None) -> int:
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--port", type=int, default=int(os.environ.get("WORKSPACE_PORT", "8760")))
    p.add_argument("--host", default="127.0.0.1")
    p.add_argument("--state-dir", type=Path, default=Path(os.environ.get("WORKSPACE_STATE_DIR", "/var/lib/report-workspace")))
    args = p.parse_args(argv)
    serve(args.port, args.state_dir, args.host)
    return 0


if __name__ == "__main__":
    sys.exit(main())
[?2004hroot@0b06d78e75bd:/app# cat reportkit/cli.py
[?2004l"""reportkit command line.

    python -m reportkit.cli init-db [--replace]
    python -m reportkit.cli templates
    python -m reportkit.cli columns
    python -m reportkit.cli report run --period YYYY-MM [--template T] [--include C ...] [--exclude C ...] [--out FILE]
    python -m reportkit.cli report publish --period YYYY-MM [--template T] [--workspace W]
    python -m reportkit.cli workspace-health
"""
from __future__ import annotations

import argparse
import sys
from typing import Sequence

from . import __version__
from .column_selector import CATALOGUE, ColumnError
from .config import load_settings
from .customer_store import CustomerStore
from .export_writer import default_filename, to_csv, write_csv
from .report_engine import PeriodError, ReportEngine
from .templates import TEMPLATES, TemplateError, get_template
from .workspace_client import WorkspaceClient, WorkspaceError


def _store(settings) -> CustomerStore:
    if not settings.db_path.exists():
        print(f"database not found at {settings.db_path}; run `init-db` first", file=sys.stderr)
        raise SystemExit(2)
    return CustomerStore(settings.db_path)


def cmd_init_db(args, settings) -> int:
    c, o = CustomerStore(settings.db_path).load_seed(settings.seed_dir, replace=args.replace)
    print(f"loaded {c} customers and {o} orders into {settings.db_path}")
    return 0


def cmd_templates(args, settings) -> int:
    for t in TEMPLATES.values():
        print(f"{t.name}\n  purpose:   {t.purpose}\n  audience:  {t.audience}\n  workspace: {t.workspace}\n  columns:   {', '.join(t.columns)}")
    return 0


def cmd_columns(args, settings) -> int:
    for c in CATALOGUE.values():
        flag = "" if c.implemented else "  (not computed yet)"
        print(f"{c.name:<24} {c.source:<16} {c.description}{flag}")
    return 0


def _render(args, settings):
    template = get_template(args.template)
    engine = ReportEngine(_store(settings))
    return template, engine.rows_for(template, args.period, include=args.include, exclude=args.exclude)


def cmd_report_run(args, settings) -> int:
    try:
        template, report = _render(args, settings)
    except (TemplateError, PeriodError, ColumnError, NotImplementedError) as e:
        print(str(e), file=sys.stderr)
        return 1
    path = args.out or (settings.reports_dir / default_filename(report))
    write_csv(report, path)
    print(f"wrote {report.row_count} rows x {len(report.columns)} columns ({template.name}, {report.period}) to {path}")
    return 0


def cmd_report_publish(args, settings) -> int:
    try:
        template, report = _render(args, settings)
    except (TemplateError, PeriodError, ColumnError, NotImplementedError) as e:
        print(str(e), file=sys.stderr)
        return 1
    workspace = args.workspace or template.workspace
    if not workspace:
        print(f"template {template.name} has no default workspace; pass --workspace", file=sys.stderr)
        return 1
    client = WorkspaceClient(settings.workspace_url, settings.workspace_timeout_sec, settings.publisher)
    try:
        resp = client.publish(workspace, report, to_csv(report), default_filename(report))
    except WorkspaceError as e:
        print(str(e), file=sys.stderr)
        return 1
    print(f"published {report.row_count} rows x {len(report.columns)} columns ({template.name}, {report.period}) to workspace {workspace}: report {resp.body.get('report_id')}")
    return 0


def cmd_workspace_health(args, settings) -> int:
    try:
        print(WorkspaceClient(settings.workspace_url, settings.workspace_timeout_sec).health().body)
    except WorkspaceError as e:
        print(str(e), file=sys.stderr)
        return 1
    return 0


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="reportkit", description="Verdant Box reporting CLI")
    p.add_argument("--version", action="version", version=f"reportkit {__version__}")
    sub = p.add_subparsers(dest="command", required=True)
    s = sub.add_parser("init-db"); s.add_argument("--replace", action="store_true"); s.set_defaults(func=cmd_init_db)
    sub.add_parser("templates", help="list report templates").set_defaults(func=cmd_templates)
    sub.add_parser("columns", help="list the column catalogue").set_defaults(func=cmd_columns)
    r = sub.add_parser("report", help="run or publish a report")
    rsub = r.add_subparsers(dest="report_command", required=True)
    for name, func in (("run", cmd_report_run), ("publish", cmd_report_publish)):
        c = rsub.add_parser(name)
        c.add_argument("--period", required=True)
        c.add_argument("--template", help=f"template name (default: account_review)")
        c.add_argument("--include", nargs="*", default=None); c.add_argument("--exclude", nargs="*", default=None)
        if name == "run":
            c.add_argument("--out", type=lambda s: __import__("pathlib").Path(s))
        else:
            c.add_argument("--workspace", help="workspace slug (default: the template's workspace)")
        c.set_defaults(func=func)
    sub.add_parser("workspace-health", help="check the workspace service").set_defaults(func=cmd_workspace_health)
    return p


def main(argv: Sequence[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    return args.func(args, load_settings())


if __name__ == "__main__":
    sys.exit(main())
