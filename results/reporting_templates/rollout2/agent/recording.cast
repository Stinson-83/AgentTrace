[95.352316, "o", "\u001b[?2004hroot@0b06d78e75bd:/app# "]
[95.951425, "i", "python - <<'PY'\nimport base64\nimport csv\nimport io\nimport json\nfrom email import policy\nfrom email.parser import BytesParser\nfrom pathlib import Path\n\nfolder = Path('/var/lib/report-workspace/received/revenue-ops')\npath = max(folder.glob('*.json'), key=lambda p: p.stat().st_mtime_ns)\nrecord = json.loads(path.read_text())\nassert record['workspace'] == 'revenue-ops'\nassert record['path'] == '/workspaces/revenue-ops/reports'\nbody = base64.b64decode(record['body_b64'])\nmessage = BytesParser(policy=policy.default).parsebytes(\n    ('Content-Type: ' + record['headers']['content-type'] + '\\r\\nMIME-Version: 1.0\\r\\n\\r\\n').encode() + body\n)\nfields = {}\nfiles = []\nfor part in message.iter_parts():\n    payload = part.get_payload(decode=True)\n    if part.get_filename():\n        files.append((part.get_filename(), payload))\n    else:\n        fields[part.get_param('name', header='content-disposition')] = payload.decode()\nassert fields['template'] == 'monthly_customer_performance'\nassert fields['period'] == '2025-10'\nassert len(files) == 1\nfilename, content = files[0]\nassert filename == 'monthly_customer_performance-2025-10.csv'\nassert content == Path('data/reports', filename).read_bytes()\nreader = csv.DictReader(io.StringIO(content.decode()))\nrows = list(reader)\nassert len(rows) == 39\nassert len({row['customer_id'] for row in rows}) == len(rows)\nassert all(row['period'] == '2025-10' for row in rows)\nprint(f'Verified upload: revenue-ops/{filename}, {len(rows)} customer rows, {len(reader.fieldnames)} columns')\nprint(f'Upload receipt: {path}')\nPY\n"]
[95.951855, "o", "python - <<'PY'\r\n\u001b[?2004l\r"]
[95.951937, "o", "\u001b[?2004h> "]
