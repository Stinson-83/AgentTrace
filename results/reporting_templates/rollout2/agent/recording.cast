[52.904702, "o", "\u001b[?2004h"]
[52.904731, "o", "> "]
[52.904778, "o", "            (\"after\", ids[0], \"2025-11-01\", \"fulfilled\", 999, 0, 999),\r\n\u001b[?2004l\r\u001b[?2004h"]
