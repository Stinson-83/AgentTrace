[12.858631, "o", "\u001b[?2004l\r"]
[12.860178, "o", "\"\"\"Builds report rows for a template and period.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport calendar\r\nimport re\r\nfrom dataclasses import dataclass\r\nfrom datetime import date\r\nfrom typing import Any\r\n\r\nfrom .column_selector import CATALOGUE, columns_by_source, resolve_columns\r\nfrom .customer_store import Customer, CustomerStore, Order\r\nfrom .templates import ReportTemplate\r\n\r\n_PERIOD_RE = re.compile(r\"^(\\d{4})-(\\d{2})$\")\r\n\r\n\r\nclass PeriodError(ValueError):\r\n    pass\r\n\r\n\r\ndef period_bounds(period: str) -> tuple[date, date]:\r\n    m = _PERIOD_RE.match(period or \"\")\r\n    if not m or not 1 <= int(m.group(2)) <= 12:\r\n        raise PeriodError(f\"period must look like YYYY-MM, got {period!r}\")\r\n    y, mo = int(m.group(1)), int(m.group(2))\r\n    return date(y, mo, 1), date(y + (mo == 12), mo % 12 + 1, 1)\r\n\r\n\r\n@dataclass\r\nclass Report:\r\n    template: str\r\n    period: str\r\n    columns: list[str]\r\n    rows: list[dict[str, Any]]\r\n\r\n    @property\r\n    def row_count(self) -> int:\r\n        return len(self.rows)\r\n\r\n\r\nclass ReportEngine:\r\n    def __init__(self, store: CustomerStore):\r\n        self.store = store\r\n\r\n    # ------------------------------------------------------------ metric blocks\r\n    def period_metrics(self, orders: list[Order], period: str) -> dict[str, Any]:\r\n        fulfilled = [o for o in orders if o.status == \"fulfilled\"]\r\n        refunded = [o for o in orders if o.status == \"refunded\"]\r\n        return {\r\n            \"period\": period,\r\n            \"orders\": len(fulfilled),\r\n            \"revenue_cents\": sum(o.total_cents for o in fulfilled),\r\n            \"refunds_cents\": sum(o.total_cents for o in refunded),\r\n        }\r\n\r\n    def lifetime_metrics(self, orders: list[Order]) -> dict[str, Any]:\r\n        fulfilled = [o for o in orders if o.status == \"fulfilled\"]\r\n        return {\r\n            \"lifetime_orders\": len(fulfilled),\r\n            \"lifetime_revenue_cents\": sum(o.total_cents for o in fulfilled),\r\n            \"last_order_on\": max((o.placed_on for o in fulfilled), default=None),\r\n        }\r\n\r\n    @staticmethod\r\n    def profile_columns(customer: Customer) -> dict[str, Any]:\r\n        return dict(customer.__dict__)\r\n\r\n    # ------------------------------------------------------------ rows\r\n    def rows_for(self, template: ReportTemplate, period: str, include: list[str] | None = None, exclude: list[str] | None = None) -> Report:\r\n        columns = resolve_columns(template, include, exclude)\r\n        missing = [c for c in columns if not CATALOGUE[c].implemented]\r\n        if missing:\r\n            raise NotImplementedError(f\"column(s) not computed by the engine yet: {', '.join(missing)}\")\r\n        start, end = period_bounds(period)\r\n        by_source = columns_by_source(columns)\r\n        period_orders: dict[str, list[Order]] = {}\r\n        for o in self.store.orders_between(start, end):\r\n            period_orders.setdefault(o.customer_id, []).append(o)\r\n        rows: list[dict[str, Any]] = []\r\n        if template.row_level == \"order\":\r\n            customers = {c.customer_id: c for c in self.store.customers()}\r\n            for o in self.store.orders_between(start, end):\r\n                if o.status != \"fulfilled\":\r\n                    continue\r\n                record = {**self.profile_columns(customers[o.customer_id]), **o.__dict__}\r\n                rows.append({c: record.get(c) for c in columns})\r\n            return Report(template.name, period, columns, rows)\r\n        lifetime: dict[str, list[Order]] = {}\r\n        if \"lifetime-metric\" in by_source:\r\n            for o in self.store.all_orders():\r\n                lifetime.setdefault(o.customer_id, []).append(o)\r\n        for customer in self.store.customers():\r\n            if \"period-metric\" in by_source and customer.customer_id not in period_orders:\r\n                continue  # customer-level period reports only list customers with activity in the period\r\n            record: dict[str, Any] = self.profile_columns(customer)\r\n            if \"period-metric\" in by_source:\r\n                record.update(self.period_metrics(period_orders.get(customer.customer_id, []), period))\r\n            if \"lifetime-metric\" in by_source:\r\n                record.update(self.lifetime_metrics(lifetime.get(customer.customer_id, [])))\r\n            rows.append({c: record.get(c) for c in columns})\r\n        return Report(template.name, period, columns, rows)\r\n"]
[12.861739, "o", "\"\"\"SQLite store for customers and orders.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport json\r\nimport sqlite3\r\nfrom dataclasses import dataclass\r\nfrom datetime import date\r\nfrom pathlib import Path\r\n\r\nSCHEMA = \"\"\"\r\nCREATE TABLE IF NOT EXISTS customers (\r\n    customer_id TEXT PRIMARY KEY, full_name TEXT NOT NULL, email TEXT NOT NULL, phone TEXT, date_of_birth TEXT,\r\n    residential_address TEXT NOT NULL, postcode TEXT NOT NULL, region TEXT NOT NULL, segment TEXT NOT NULL,\r\n    account_manager TEXT NOT NULL, joined_on TEXT NOT NULL\r\n);\r\nCREATE TABLE IF NOT EXISTS orders (\r\n    order_id TEXT PRIMARY KEY, customer_id TEXT NOT NULL REFERENCES customers(customer_id), placed_on TEXT NOT NULL,\r\n    status TEXT NOT NULL CHECK (status IN ('fulfilled','cancelled','refunded')), subtotal_cents INTEGER NOT NULL,\r\n    discount_cents INTEGER NOT NULL, total_cents INTEGER NOT NULL\r\n);\r\nCREATE INDEX IF NOT EXISTS idx_orders_customer_day ON orders(customer_id, placed_on);\r\n\"\"\"\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Customer:\r\n    customer_id: str\r\n    full_name: str\r\n    email: str\r\n    phone: str | None\r\n    date_of_birth: str | None\r\n    residential_address: str\r\n    postcode: str\r\n    region: str\r\n    segment: str\r\n    account_manager: str\r\n    joined_on: str\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Order:\r\n    order_id: str\r\n    customer_id: str\r\n    placed_on: str\r\n    status: str\r\n    subtotal_cents: int\r\n    discount_cents: int\r\n    total_cents: int\r\n\r\n\r\nclass StoreError(LookupError):\r\n    pass\r\n\r\n\r\nclass CustomerStore:\r\n    def __init__(self, db_path: Path):\r\n        db_path.parent.mkdir(parents=True, exist_ok=True)\r\n        self._conn = sqlite3.connect(str(db_path))\r\n        self._conn.row_factory = sqlite3.Row\r\n        self._conn.executescript(SCHEMA)\r\n\r\n    def close(self) -> None:\r\n        self._conn.close()\r\n\r\n    def load_seed(self, seed_dir: Path, replace: bool = False) -> tuple[int, int]:\r\n        customers = json.loads((seed_dir / \"customers.json\").read_text())\r\n        orders = json.loads((seed_dir / \"orders.json\").read_text())\r\n        with self._conn:\r\n            if replace:\r\n                self._conn.execute(\"DELETE FROM orders\")\r\n                self._conn.execute(\"DELETE FROM customers\")\r\n            self._conn.executemany(\r\n                \"INSERT OR REPLACE INTO customers VALUES (:customer_id,:full_name,:email,:phone,:date_of_birth,:residential_address,\"\r\n                \":postcode,:region,:segment,:account_manager,:joined_on)\", customers)\r\n            self._conn.executemany(\r\n                \"INSERT OR REPLACE INTO orders VALUES (:order_id,:customer_id,:placed_on,:status,:subtotal_cents,:discount_cents,:total_cents)\", orders)\r\n        return len(customers), len(orders)\r\n\r\n    def customer(self, customer_id: str) -> Customer:\r\n        row = self._conn.execute(\"SELECT * FROM customers WHERE customer_id = ?\", (customer_id,)).fetchone()\r\n        if row is None:\r\n            raise StoreError(f\"unknown customer {customer_id!r}\")\r\n        return Customer(**dict(row))\r\n\r\n    def customers(self, segment: str | None = None) -> list[Customer]:\r\n        sql, params = \"SELECT * FROM customers\", []\r\n        if segment:\r\n            sql += \" WHERE segment = ?\"; params.append(segment)\r\n        return [Customer(**dict(r)) for r in self._conn.execute(sql + \" ORDER BY customer_id\", params)]\r\n\r\n    def orders_between(self, start: date, end_exclusive: date) -> list[Order]:\r\n        rows = self._conn.execute(\"SELECT * FROM orders WHERE placed_on >= ? AND placed_on < ? ORDER BY placed_on, order_id\",\r\n                                  (start.isoformat(), end_exclusive.isoformat()))\r\n        return [Order(**dict(r)) for r in rows]\r\n\r\n    def all_orders(self) -> list[Order]:\r\n        return [Order(**dict(r)) for r in self._conn.execute(\"SELECT * FROM orders ORDER BY placed_on, order_id\")]\r\n\r\n    def counts(self) -> dict[str, int]:\r\n        return {\"customers\": self._conn.execute(\"SELECT COUNT(*) FROM customers\").fetchone()[0],\r\n                \"orders\": self._conn.execute(\"SELECT COUNT(*) FROM orders\").fetchone()[0]}\r\n"]
[12.863082, "o", "\"\"\"Column catalogue and template column resolution.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nfrom dataclasses import dataclass\r\n\r\nfrom .templates import ReportTemplate\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass ColumnSpec:\r\n    name: str\r\n    source: str        # profile | period-metric | lifetime-metric | order\r\n    description: str\r\n    implemented: bool = True\r\n\r\n\r\nCATALOGUE: dict[str, ColumnSpec] = {c.name: c for c in [\r\n    ColumnSpec(\"customer_id\", \"profile\", \"Customer identifier\"),\r\n    ColumnSpec(\"full_name\", \"profile\", \"Customer name\"),\r\n    ColumnSpec(\"email\", \"profile\", \"Contact e-mail\"),\r\n    ColumnSpec(\"phone\", \"profile\", \"Contact phone\"),\r\n    ColumnSpec(\"date_of_birth\", \"profile\", \"Date of birth\"),\r\n    ColumnSpec(\"residential_address\", \"profile\", \"Delivery / residential address\"),\r\n    ColumnSpec(\"postcode\", \"profile\", \"Postcode\"),\r\n    ColumnSpec(\"region\", \"profile\", \"Sales region\"),\r\n    ColumnSpec(\"segment\", \"profile\", \"Subscription segment (plus / standard / trial)\"),\r\n    ColumnSpec(\"account_manager\", \"profile\", \"Owning account manager\"),\r\n    ColumnSpec(\"joined_on\", \"profile\", \"Join date\"),\r\n    ColumnSpec(\"period\", \"period-metric\", \"Reporting period YYYY-MM\"),\r\n    ColumnSpec(\"orders\", \"period-metric\", \"Fulfilled orders in the period\"),\r\n    ColumnSpec(\"revenue_cents\", \"period-metric\", \"Sum of fulfilled order totals in the period\"),\r\n    ColumnSpec(\"refunds_cents\", \"period-metric\", \"Sum of refunded order totals in the period\"),\r\n    ColumnSpec(\"active_days\", \"period-metric\", \"Distinct days with a fulfilled order in the period\", implemented=False),\r\n    ColumnSpec(\"avg_order_cents\", \"period-metric\", \"revenue_cents / orders (0 when no orders)\", implemented=False),\r\n    ColumnSpec(\"lifetime_orders\", \"lifetime-metric\", \"Fulfilled orders ever\"),\r\n    ColumnSpec(\"lifetime_revenue_cents\", \"lifetime-metric\", \"Sum of fulfilled order totals ever\"),\r\n    ColumnSpec(\"last_order_on\", \"lifetime-metric\", \"Date of the last fulfilled order\"),\r\n    ColumnSpec(\"order_id\", \"order\", \"Order identifier\"),\r\n    ColumnSpec(\"placed_on\", \"order\", \"Order date\"),\r\n]}\r\n\r\n\r\nclass ColumnError(ValueError):\r\n    pass\r\n\r\n\r\ndef resolve_columns(template: ReportTemplate, include: list[str] | None = None, exclude: list[str] | None = None) -> list[str]:\r\n    \"\"\"Final column list for a run: template columns plus ``include`` minus ``exclude``, validated.\"\"\"\r\n    columns = [c for c in template.columns if c not in set(exclude or [])]\r\n    for c in include or []:\r\n        if c not in columns:\r\n            columns.append(c)\r\n    unknown = [c for c in columns if c not in CATALOGUE]\r\n    if unknown:\r\n        raise ColumnError(f\"unknown column(s): {', '.join(unknown)}\")\r\n    if template.row_level == \"customer\" and any(CATALOGUE[c].source == \"order\" for c in columns):\r\n        raise ColumnError(\"order-level columns cannot be used in a customer-level template\")\r\n    return columns\r\n\r\n\r\ndef columns_by_source(columns: list[str]) -> dict[str, list[str]]:\r\n    out: dict[str, list[str]] = {}\r\n    for c in columns:\r\n        out.setdefault(CATALOGUE[c].source, []).append(c)\r\n    return out\r\n"]
