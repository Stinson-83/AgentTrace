[95.95694, "o", "\u001b[?2004h> "]
[95.957123, "o", "reader = csv.DictReader(io.StringIO(content.decode()))\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.957178, "o", "> "]
[95.95722, "o", "rows = list(reader)\r\n\u001b[?2004l\r"]
[95.957263, "o", "\u001b[?2004h> "]
[95.957334, "o", "assert len(rows) == 39\r\n\u001b[?2004l\r"]
[95.957371, "o", "\u001b[?2004h> "]
[95.957584, "o", "assert len({row['customer_id'] for row in rows}) == len(rows)\r\n\u001b[?2004l\r"]
[95.957621, "o", "\u001b[?2004h> "]
[95.95781, "o", "assert all(row['period'] == '2025-10' for row in rows)\r\n\u001b[?2004l\r"]
[95.957849, "o", "\u001b[?2004h> "]
