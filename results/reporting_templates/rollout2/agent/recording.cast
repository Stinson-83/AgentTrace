[95.955364, "o", "> "]
[95.955639, "o", "        fields[part.get_param('name', header='content-disposition')] = payload.decode()\r\n\u001b[?2004l\r"]
[95.955695, "o", "\u001b[?2004h"]
[95.955752, "o", "> "]
[95.955903, "o", "assert fields['template'] == 'monthly_customer_performance'\r\n\u001b[?2004l\r"]
[95.955955, "o", "\u001b[?2004h"]
[95.955997, "o", "> "]
[95.956073, "o", "assert fields['period'] == '2025-10'\r\n\u001b[?2004l\r"]
[95.956112, "o", "\u001b[?2004h> "]
[95.956202, "o", "assert len(files) == 1\r\n\u001b[?2004l\r"]
[95.956245, "o", "\u001b[?2004h> "]
[95.956344, "o", "filename, content = files[0]\r\n\u001b[?2004l\r"]
[95.956388, "o", "\u001b[?2004h> "]
[95.956602, "o", "assert filename == 'monthly_customer_performance-2025-10.csv'\r\n\u001b[?2004l\r"]
[95.956649, "o", "\u001b[?2004h> "]
