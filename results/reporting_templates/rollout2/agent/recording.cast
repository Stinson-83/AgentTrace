[52.904345, "o", "> "]
[52.904424, "o", "        store._conn.executemany(\"INSERT INTO orders VALUES (?, ?, ?, ?, ?, ?, ?)\", [\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.904458, "o", "> "]
[52.904497, "o", "            (\"before\", ids[0], \"2025-09-30\", \"fulfilled\", 999, 0, 999),\r\n\u001b[?2004l\r"]
[52.904527, "o", "\u001b[?2004h> "]
[52.904588, "o", "            (\"start\", ids[0], \"2025-10-01\", \"fulfilled\", 101, 0, 101),\r\n\u001b[?2004l\r"]
