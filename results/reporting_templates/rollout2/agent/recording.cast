[95.952275, "o", "from email import policy\r\n\u001b[?2004l\r"]
[95.954763, "o", "\u001b[?2004h> from email.parser import BytesParser\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> folder = Path('/var/lib/report-workspace/received/revenue-ops')\r\n\u001b[?2004l\r\u001b[?2004h> path = max(folder.glob('*.json'), key=lambda p: p.stat().st_mtime_ns)\r\n\u001b[?2004l\r\u001b[?2004h> record = json.loads(path.read_text())\r\n\u001b[?2004l\r\u001b[?2004h> assert record['workspace'] == 'revenue-ops'\r\n\u001b[?2004l\r\u001b[?2004h> assert record['path'] == '/workspaces/revenue-ops/reports'\r\n\u001b[?2004l\r\u001b[?2004h> body = base64.b64decode(record['body_b64'])\r\n\u001b[?2004l\r\u001b[?2004h> message = BytesParser(policy=policy.default).parsebytes(\r\n\u001b[?2004l\r\u001b[?2004h>     ('Content-Type: ' + record['headers']['content-type'] + '\\r\\nMIME-Version: 1.0\\r\\n\\r\\n').encode() + body\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> fields = {}\r\n\u001b[?2004l\r\u001b[?2004h> files = []\r\n\u001b[?2004l\r\u001b[?2004h> for part in message.iter_parts():\r\n\u001b[?2004l\r\u001b[?2004h> "]
