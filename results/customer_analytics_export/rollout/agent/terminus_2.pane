    boundary = [t for t in store.transactions_for("cus_1007") if t.occurred_at in ("2025-09-30T23:59:59Z", "2025-10-01T00:00:00Z", "2025-10-31T23:59:59Z", "2025-11-01T00:00:00Z")]
