[118.306348, "o", "> "]
[118.306479, "o", "    assert sizes == [min(limit, len(records) - i) for i in range(0, len(records), limit)]\r\n\u001b[?2004l\r"]
[118.306501, "o", "\u001b[?2004h"]
[118.30653, "o", "> "]
