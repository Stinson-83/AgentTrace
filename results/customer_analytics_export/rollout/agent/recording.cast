[118.30726, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\ro\u001b[?2004h> "]
[118.307341, "o", "def test_dry_run_counts_without_client(store, settings, ingest):\r\n\u001b[?2004l\r"]
[118.307364, "o", "\u001b[?2004h> "]
[118.307501, "o", "    preview = run_activity_export(store, replace(settings, ingest_batch_size=7), '2025-10', True)\r\n\u001b[?2004l\r"]
[118.307524, "o", "\u001b[?2004h> "]
