[13.252429, "o", "cat custops/cli.py && cat README.md\r\n\u001b[?2004l\r"]
[13.253611, "o", "\"\"\"custops command line interface.\r\n\r\n    python -m custops.cli init-db [--replace]\r\n    python -m custops.cli customer show <customer_id> [--period YYYY-MM]\r\n    python -m custops.cli customer list [--segment X]\r\n    python -m custops.cli export-subject <customer_id> [--out DIR]\r\n    python -m custops.cli transactions list <customer_id> [--period YYYY-MM] [--status settled]\r\n    python -m custops.cli ingest-health\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport argparse\r\nimport json\r\nimport sys\r\nfrom typing import Sequence\r\n\r\nfrom . import __version__\r\nfrom .analytics import PeriodError, channel_mix, monthly_totals, period_bounds\r\nfrom .config import load_settings\r\nfrom .customer_store import CustomerStore, StoreError\r\nfrom .export_service import AnalyticsIngestClient, IngestError, write_subject_export\r\nfrom .serializers import customer_record\r\n\r\n\r\ndef _open_store(settings) -> CustomerStore:\r\n    if not settings.db_path.exists():\r\n        print(f\"database not found at {settings.db_path}; run `init-db` first\", file=sys.stderr)\r\n        raise SystemExit(2)\r\n    return CustomerStore(settings.db_path)\r\n\r\n\r\ndef cmd_init_db(args, settings) -> int:\r\n    store = CustomerStore(settings.db_path)\r\n    customers, txns = store.load_seed(settings.seed_dir, replace=args.replace)\r\n    print(f\"loaded {customers} customers and {txns} transactions into {settings.db_path}\")\r\n    return 0\r\n\r\n\r\ndef cmd_customer_show(args, settings) -> int:\r\n    store = _open_store(settings)\r\n    try:\r\n        customer = store.get_customer(args.customer_id)\r\n    except StoreError as e:\r\n        print(str(e), file=sys.stderr)\r\n        return 1\r\n    out = {\"profile\": customer_record(customer)}\r\n    if args.period:\r\n        try:\r\n            totals = monthly_totals(store, customer.customer_id, args.period)\r\n        except PeriodError as e:\r\n            print(str(e), file=sys.stderr)\r\n            return 1\r\n        out[\"period\"] = totals.__dict__\r\n        out[\"channel_mix\"] = channel_mix(store.transactions_for(customer.customer_id))\r\n    print(json.dumps(out, indent=2))\r\n    return 0\r\n\r\n\r\ndef cmd_customer_list(args, settings) -> int:\r\n    store = _open_store(settings)\r\n    for c in store.list_customers(segment=args.segment):\r\n        print(f\"{c.customer_id}\\t{c.segment:<10}\\t{c.country}\\t{c.full_name}\")\r\n    return 0\r\n\r\n\r\ndef cmd_export_subject(args, settings) -> int:\r\n    store = _open_store(settings)\r\n    try:\r\n        path = write_subject_export(store, args.customer_id, args.out or settings.exports_dir)\r\n    except StoreError as e:\r\n        print(str(e), file=sys.stderr)\r\n        return 1\r\n    print(f\"wrote {path}\")\r\n    return 0\r\n\r\n\r\ndef cmd_transactions_list(args, settings) -> int:\r\n    store = _open_store(settings)\r\n    try:\r\n        store.get_customer(args.customer_id)\r\n        bounds = period_bounds(args.period) if args.period else None\r\n    except (StoreError, PeriodError) as e:\r\n        print(str(e), file=sys.stderr)\r\n        return 1\r\n    txns = store.transactions_for(args.customer_id)\r\n    if bounds:\r\n        txns = [t for t in txns if bounds[0] <= t.occurred_on < bounds[1]]\r\n    if args.status:\r\n        txns = [t for t in txns if t.status == args.status]\r\n    for t in txns:\r\n        print(f\"{t.txn_id}\\t{t.occurred_at}\\t{t.kind:<6}\\t{t.status:<8}\\t{t.amount_cents:>8} {t.currency}\\t{t.channel}\")\r\n    print(f\"{len(txns)} transactions\", file=sys.stderr)\r\n    return 0\r\n\r\n\r\ndef cmd_ingest_health(args, settings) -> int:\r\n    client = AnalyticsIngestClient(settings.analytics_ingest_url, settings.ingest_timeout_sec, settings.source_system, settings.ingest_retries)\r\n    try:\r\n        resp = client.health()\r\n    except IngestError as e:\r\n        print(str(e), file=sys.stderr)\r\n        return 1\r\n    print(json.dumps(resp.body))\r\n    return 0\r\n\r\n\r\ndef build_parser() -> argparse.ArgumentParser:\r\n    p = argparse.ArgumentParser(prog=\"custops\", description=\"Northgate customer operations CLI\")\r\n    p.add_argument(\"--version\", action=\"version\", version=f\"custops {__version__}\")\r\n    sub = p.add_subparsers(dest=\"command\", required=True)\r\n\r\n    s = sub.add_parser(\"init-db\", help=\"create the SQLite database from the seed files\")\r\n    s.add_argument(\"--replace\", action=\"store_true\", help=\"drop existing rows first\")\r\n    s.set_defaults(func=cmd_init_db)\r\n\r\n    c = sub.add_parser(\"customer\", help=\"customer records\")\r\n    csub = c.add_subparsers(dest=\"customer_command\", required=True)\r\n    show = csub.add_parser(\"show\")\r\n    show.add_argument(\"customer_id\")\r\n    show.add_argument(\"--period\", help=\"YYYY-MM; include monthly totals\")\r\n    show.set_defaults(func=cmd_customer_show)\r\n    lst = csub.add_parser(\"list\")\r\n    lst.add_argument(\"--segment\")\r\n    lst.set_defaults(func=cmd_customer_list)\r\n\r\n    e = sub.add_parser(\"export-subject\", help=\"write a data-subject export bundle\")\r\n    e.add_argument(\"customer_id\")\r\n    e.add_argument(\"--out\", type=lambda s: __import__(\"pathlib\").Path(s))\r\n    e.set_defaults(func=cmd_export_subject)\r\n\r\n    t = sub.add_parser(\"transactions\", help=\"transaction ledger\")\r\n    tsub = t.add_subparsers(dest=\"transactions_command\", required=True)\r\n    tl = tsub.add_parser(\"list\")\r\n    tl.add_argument(\"customer_id\"); tl.add_argument(\"--period\"); tl.add_argument(\"--status\", choices=[\"settled\", \"pending\", \"declined\"])\r\n    tl.set_defaults(func=cmd_transactions_list)\r\n\r\n    h = sub.add_parser(\"ingest-health\", help=\"check the analytics ingest service\")\r\n    h.set_defaults(func=cmd_ingest_health)\r\n    return p\r\n\r\n\r\ndef main(argv: Sequence[str] | None = None) -> int:\r\n    parser = build_parser()\r\n    args = parser.parse_args(argv)\r\n    settings = load_settings()\r\n    return args.func(args, settings)\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main())\r\n"]
[13.254964, "o", "# custops — Northgate Retail customer operations service\r\n\r\nInternal service that owns the customer master record and the transaction ledger for Northgate\r\nRetail, and produces the outbound exports other teams depend on.\r\n\r\n```\r\ncustops/\r\n  config.py            settings (env vars, local defaults)\r\n  customer_store.py    SQLite store: customers + transactions\r\n  serializers.py       record/bundle serialisation\r\n  analytics.py         period handling, monthly totals, channel mix\r\n  export_service.py    data-subject export (file) + analytics ingest HTTP client\r\n  cli.py               command line entry point\r\nservices/\r\n  analytics_ingest_service.py   local stand-in for the Growth analytics ingest API\r\ndata/seed/             seed customers and transactions (loaded by `init-db`)\r\ndocs/                  consumer contracts and export specs\r\ntests/                 unit tests (pytest)\r\n```\r\n\r\n## Local setup\r\n\r\n```\r\npython -m custops.cli init-db --replace\r\npython -m pytest -q tests\r\n```\r\n\r\n## Local services\r\n\r\nThe Growth analytics ingest API is stubbed locally by `services/analytics_ingest_service.py`. In the\r\ndev container it is already running on `http://127.0.0.1:8701` and keeps everything it accepts\r\nunder `/var/lib/analytics-ingest/received/` (one JSON file per request). To (re)start it by hand:\r\n\r\n```\r\npython services/analytics_ingest_service.py --port 8701 --state-dir /var/lib/analytics-ingest &\r\npython -m custops.cli ingest-health\r\n```\r\n\r\nOverride the target with `ANALYTICS_INGEST_URL`.\r\n\r\n## Commands\r\n\r\n| command | what it does |\r\n|---|---|\r\n| `init-db [--replace]` | create/refresh `data/custops.db` from `data/seed/` |\r\n| `customer show <id> [--period YYYY-MM]` | print a customer profile (+ monthly totals, channel mix) |\r\n| `customer list [--segment S]` | list customers |\r\n| `export-subject <id> [--out DIR]` | write the data-subject export bundle (docs/data_subject_export.md) |\r\n| `transactions list <id> [--period YYYY-MM] [--status S]` | list a customer's transactions |\r\n| `ingest-health` | ping the analytics ingest service |\r\n\r\nConfiguration: `CUSTOPS_DATA_DIR`, `CUSTOPS_DB_PATH`, `CUSTOPS_SEED_DIR`, `CUSTOPS_EXPORTS_DIR`,\r\n`ANALYTICS_INGEST_URL`, `ANALYTICS_INGEST_TIMEOUT`, `ANALYTICS_INGEST_BATCH_SIZE`, `ANALYTICS_INGEST_RETRIES`, `CUSTOPS_SOURCE_SYSTEM`.\r\n"]
[13.255242, "o", "\u001b[?2004h"]
[13.255361, "o", "root@3d6deae74284:/app# "]
[17.278454, "i", "cat custops/customer_store.py\n"]
[17.278726, "o", "cat custops/customer_store.py\r\n\u001b[?2004l\r"]
[17.279833, "o", "\"\"\"SQLite-backed storage for customers and transactions.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport json\r\nimport sqlite3\r\nfrom dataclasses import dataclass\r\nfrom datetime import date, datetime\r\nfrom pathlib import Path\r\nfrom typing import Iterable, Iterator\r\n\r\nSCHEMA = \"\"\"\r\nCREATE TABLE IF NOT EXISTS customers (\r\n    customer_id    TEXT PRIMARY KEY,\r\n    full_name      TEXT NOT NULL,\r\n    email          TEXT NOT NULL,\r\n    phone          TEXT,\r\n    date_of_birth  TEXT,\r\n    tax_reference  TEXT,\r\n    country        TEXT NOT NULL,\r\n    segment        TEXT NOT NULL,\r\n    currency       TEXT NOT NULL,\r\n    created_at     TEXT NOT NULL\r\n);\r\nCREATE TABLE IF NOT EXISTS transactions (\r\n    txn_id        TEXT PRIMARY KEY,\r\n    customer_id   TEXT NOT NULL REFERENCES customers(customer_id),\r\n    occurred_at   TEXT NOT NULL,\r\n    kind          TEXT NOT NULL CHECK (kind IN ('sale', 'refund')),\r\n    amount_cents  INTEGER NOT NULL CHECK (amount_cents >= 0),\r\n    currency      TEXT NOT NULL,\r\n    channel       TEXT NOT NULL,\r\n    status        TEXT NOT NULL CHECK (status IN ('settled', 'pending', 'declined'))\r\n);\r\nCREATE INDEX IF NOT EXISTS idx_txn_customer_time ON transactions(customer_id, occurred_at);\r\n\"\"\"\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Customer:\r\n    customer_id: str\r\n    full_name: str\r\n    email: str\r\n    phone: str | None\r\n    date_of_birth: str | None\r\n    tax_reference: str | None\r\n    country: str\r\n    segment: str\r\n    currency: str\r\n    created_at: str\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Transaction:\r\n    txn_id: str\r\n    customer_id: str\r\n    occurred_at: str\r\n    kind: str\r\n    amount_cents: int\r\n    currency: str\r\n    channel: str\r\n    status: str\r\n\r\n    @property\r\n    def occurred_on(self) -> date:\r\n        return datetime.fromisoformat(self.occurred_at.replace(\"Z\", \"+00:00\")).date()\r\n\r\n    @property\r\n    def signed_amount_cents(self) -> int:\r\n        return -self.amount_cents if self.kind == \"refund\" else self.amount_cents\r\n\r\n\r\nclass StoreError(RuntimeError):\r\n    pass\r\n\r\n\r\nclass CustomerStore:\r\n    def __init__(self, db_path: Path):\r\n        self.db_path = Path(db_path)\r\n     "]
[17.279946, "o", "   self.db_path.parent.mkdir(parents=True, exist_ok=True)\r\n        self._conn = sqlite3.connect(str(self.db_path))\r\n        self._conn.row_factory = sqlite3.Row\r\n        self._conn.executescript(SCHEMA)\r\n\r\n    def close(self) -> None:\r\n        self._conn.close()\r\n\r\n    # ------------------------------------------------------------------ seeding\r\n    def load_seed(self, seed_dir: Path, replace: bool = False) -> tuple[int, int]:\r\n        customers = json.loads((seed_dir / \"customers.json\").read_text())\r\n        transactions = json.loads((seed_dir / \"transactions.json\").read_text())\r\n        with self._conn:\r\n            if replace:\r\n                self._conn.execute(\"DELETE FROM transactions\")\r\n                self._conn.execute(\"DELETE FROM customers\")\r\n            self._conn.executemany(\r\n                \"INSERT OR REPLACE INTO customers VALUES (:customer_id,:full_name,:email,:phone,\"\r\n                \":date_of_birth,:tax_reference,:country,:segment,:currency,:created_at)\",\r\n                customers,\r\n            )\r\n            self._conn.executemany(\r\n                \"INSERT OR REPLACE INTO transactions VALUES (:txn_id,:customer_id,:occurred_at,:kind,\"\r\n                \":amount_cents,:currency,:channel,:status)\",\r\n                transactions,\r\n            )\r\n        return len(customers), len(transactions)\r\n\r\n    # ---------------------------------------------------------------- customers\r\n    def get_customer(self, customer_id: str) -> Customer:\r\n        row = self._conn.execute(\"SELECT * FROM customers WHERE customer_id = ?\", (customer_id,)).fetchone()\r\n        if row is None:\r\n            raise StoreError(f\"unknown customer {customer_id!r}\")\r\n        return Customer(**dict(row))\r\n\r\n    def list_customers(self, segment: str | None = None) -> list[Customer]:\r\n        sql, params = \"SELECT * FROM customers\", ()\r\n        if segment:\r\n            sql, params = sql + \" WHERE segment = ?\", (segment,)\r\n        rows = self._conn.execute(sql + \" ORDER BY customer_id\", params).fetchall()\r\n        return [Customer(**dict(r)) for r in rows]\r\n\r\n    def count_customers(self) -> int:\r\n        return int(self._conn.execute(\"SELECT COUNT(*) FROM customers\").fetchone()[0])\r\n\r\n    # ------------------------------------------------------------- transactions\r\n    def transactions_for(self, customer_id: str) -> list[Transaction]:\r\n        rows = self._conn.execute(\r\n            \"SELECT * FROM transactions WHERE customer_id = ? ORDER BY occurred_at, txn_id\", (customer_id,)\r\n        ).fetchall()\r\n        return [Transaction(**dict(r)) for r in rows]\r\n\r\n    def transactions_between(self, start: date, end_exclusive: date) -> Iterator[Transaction]:\r\n        \"\"\"All transactions with start <= occurred_at < end_exclusive (UTC dates).\"\"\"\r\n        rows = self._conn.execute(\r\n            \"SELECT * FROM transactions WHERE occurred_at >= ? AND occurred_at < ? ORDER BY occurred_at, txn_id\",\r\n            (f\"{start.isoformat()}T00:00:00Z\", f\"{end_exclusive.isoformat()}T00:00:00Z\"),\r\n        )\r\n        for r in rows:\r\n            yield Transaction(**dict(r))\r\n\r\n    def add_transactions(self, txns: Iterable[Transaction]) -> int:\r\n        rows = [t.__dict__ for t in txns]\r\n        with self._conn:\r\n            self._conn.executemany(\r\n                \"INSERT INTO transactions VALUES (:txn_id,:customer_id,:occurred_at,:kind,\"\r\n                \":amount_cents,:currency,:channel,:status)\",\r\n                rows,\r\n            )\r\n        return len(rows)\r\n"]
[17.280091, "o", "\u001b[?2004hroot@3d6deae74284:/app# "]
[25.080012, "i", "cat custops/analytics.py custops/config.py\n"]
[25.080285, "o", "cat custops/analytics.py custops/config.py\r\n\u001b[?2004l\r"]
[25.081526, "o", "\"\"\"Activity analytics over the transaction ledger.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport calendar\r\nimport re\r\nfrom dataclasses import dataclass\r\nfrom datetime import date\r\nfrom typing import Iterable\r\n\r\nfrom .customer_store import CustomerStore, Transaction\r\n\r\n_PERIOD_RE = re.compile(r\"^(\\d{4})-(\\d{2})$\")\r\n\r\n\r\nclass PeriodError(ValueError):\r\n    pass\r\n\r\n\r\ndef period_bounds(period: str) -> tuple[date, date]:\r\n    \"\"\"Return (first_day, first_day_of_next_month) for a YYYY-MM period string.\"\"\"\r\n    m = _PERIOD_RE.match(period or \"\")\r\n    if not m:\r\n        raise PeriodError(f\"period must look like YYYY-MM, got {period!r}\")\r\n    year, month = int(m.group(1)), int(m.group(2))\r\n    if not 1 <= month <= 12:\r\n        raise PeriodError(f\"invalid month in period {period!r}\")\r\n    start = date(year, month, 1)\r\n    days = calendar.monthrange(year, month)[1]\r\n"]
[25.081631, "o", "    end = date(year + (month == 12), (month % 12) + 1, 1)\r\n    assert (end - start).days == days\r\n    return start, end\r\n\r\n\r\ndef settled(transactions: Iterable[Transaction]) -> list[Transaction]:\r\n    return [t for t in transactions if t.status == \"settled\"]\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass MonthlyTotals:\r\n    period: str\r\n    sale_count: int\r\n    refund_count: int\r\n    net_cents: int\r\n    currency: str\r\n\r\n\r\ndef monthly_totals(store: CustomerStore, customer_id: str, period: str) -> MonthlyTotals:\r\n    \"\"\"Net settled position for a single customer over a month (used by ``customer show``).\"\"\"\r\n    start, end = period_bounds(period)\r\n    txns = [t for t in store.transactions_for(customer_id) if start <= t.occurred_on < end]\r\n    txns = settled(txns)\r\n    currency = txns[0].currency if txns else store.get_customer(customer_id).currency\r\n    return MonthlyTotals(\r\n        period=period,\r\n        sale_count=sum(1 for t in txns if t.kind == \"sale\"),\r\n        refund_count=sum(1 for t in txns if t.kind == \"refund\"),\r\n        net_cents=sum(t.signed_amount_cents for t in txns),\r\n        currency=currency,\r\n    )\r\n\r\n\r\ndef channel_mix(transactions: Iterable[Transaction]) -> dict[str, int]:\r\n    mix: dict[str, int] = {}\r\n    for t in settled(transactions):\r\n        mix[t.channel] = mix.get(t.channel, 0) + 1\r\n    return dict(sorted(mix.items()))\r\n\"\"\"Runtime configuration.\r\n\r\nValues come from environment variables with sensible local-development defaults so the\r\nservice can be run from a checkout without any extra setup.\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport os\r\nfrom dataclasses import dataclass\r\nfrom pathlib import Path\r\n\r\nPROJECT_ROOT = Path(__file__).resolve().parent.parent\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Settings:\r\n    data_dir: Path\r\n    db_path: Path\r\n    seed_dir: Path\r\n    exports_dir: Path\r\n    analytics_ingest_url: str\r\n    ingest_timeout_sec: float\r\n    ingest_batch_size: int\r\n    ingest_retries: int\r\n    source_system: str\r\n\r\n    @classmethod\r\n    def from_env(cls) -> \"Settings\":\r\n        data_dir = Path(os.environ.get(\"CUSTOPS_DATA_DIR\", PROJECT_ROOT / \"data\"))\r\n        return cls(\r\n            data_dir=data_dir,\r\n            db_path=Path(os.environ.get(\"CUSTOPS_DB_PATH\", data_dir / \"custops.db\")),\r\n            seed_dir=Path(os.environ.get(\"CUSTOPS_SEED_DIR\", PROJECT_ROOT / \"data\" / \"seed\")),\r\n            exports_dir=Path(os.environ.get(\"CUSTOPS_EXPORTS_DIR\", data_dir / \"exports\")),\r\n            analytics_ingest_url=os.environ.get(\"ANALYTICS_INGEST_URL\", \"http://127.0.0.1:8701\"),\r\n            ingest_timeout_sec=float(os.environ.get(\"ANALYTICS_INGEST_TIMEOUT\", \"10\")),\r\n            ingest_batch_size=int(os.environ.get(\"ANALYTICS_INGEST_BATCH_SIZE\", \"100\")),\r\n            ingest_retries=int(os.environ.get(\"ANALYTICS_INGEST_RETRIES\", \"2\")),\r\n            source_system=os.environ.get(\"CUSTOPS_SOURCE_SYSTEM\", \"custops\"),\r\n        )\r\n\r\n\r\n    def validate(self) -> None:\r\n        if self.ingest_batch_size < 1:\r\n            raise ValueError(\"ANALYTICS_INGEST_BATCH_SIZE must be >= 1\")\r\n        if self.ingest_timeout_sec <= 0:\r\n            raise ValueError(\"ANALYTICS_INGEST_TIMEOUT must be positive\")\r\n        if not self.analytics_ingest_url.startswith((\"http://\", \"https://\")):\r\n            raise ValueError(\"ANALYTICS_INGEST_URL must be an http(s) URL\")\r\n\r\n\r\ndef load_settings() -> Settings:\r\n    settings = Settings.from_env()\r\n    settings.validate()\r\n    return settings\r\n"]
