[75.925212, "o", "    action = \"would send\" if args.dry_run else \"sent\"\r\n"]
[75.92524, "o", "\u001b[?2004l\r"]
[75.925279, "o", "\u001b[?2004h> "]
[75.925522, "o", "    print(f\"{action} {result.records} records in {result.batches} batches \"\r\n"]
[75.925583, "o", "\u001b[?2004l\r"]
[75.925612, "o", "\u001b[?2004h> "]
[75.925801, "o", "          f\"for {result.period} ({result.accepted} accepted)\")\r\n\u001b[?2004l\r"]
[75.925829, "o", "\u001b[?2004h"]
