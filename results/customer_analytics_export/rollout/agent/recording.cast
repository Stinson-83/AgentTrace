[145.839097, "o", "\u001b[?2004hroot@3d6deae74284:/app# "]
[145.839212, "o", "python -m custops.cli export-activity --period 2025-10\r\n\u001b[?2004l\r"]
[146.123914, "o", "sent 145 records in 2 batches for 2025-10 (145 accepted)\r\n"]
[146.133899, "o", "\u001b[?2004hroot@3d6deae74284:/app# "]
[159.863742, "i", "python - <<'PY'\nimport base64\nimport json\nimport urllib.request\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom custops.config import load_settings\nfrom custops.customer_store import CustomerStore\n\nbefore = set(json.loads(Path('/tmp/ops-2291-before.json').read_text()))\npaths = [p for p in sorted(Path('/var/lib/analytics-ingest/received').glob('*.json')) if str(p) not in before]\nrecords = []\nsizes = []\nallowed = {'customer_id', 'activity_date', 'transaction_count', 'total_spend_cents', 'currency', 'segment', 'country'}\nfor path in paths:\n    request = json.loads(path.read_text())\n    envelope = json.loads(base64.b64decode(request['body_b64']))\n    assert request['path'] == '/v1/ingest/customer-activity'\n    assert envelope['source'] == 'custops' and envelope['period'] == '2025-10'\n    batch = envelope['records']\n    assert 1 <= len(batch) <= 100\n    assert all(set(r) == allowed for r in batch)\n    records.extend(batch)\n    sizes.append(len(batch))\n    print(f'{path.name}: {len(batch)} records')\nassert sizes == [100, 45], sizes\nactual = {(r['customer_id'], r['activity_date']): (r['transaction_count'], r['total_spend_cents'], r['currency'], r['segment'], r['country']) for r in records}\nassert len(actual) == len(records) == 145\nexpected = {}\nstore = CustomerStore(load_settings().db_path)\ntry:\n    for customer in store.list_customers():\n        for txn in store.transactions_for(customer.customer_id):\n            day = datetime.fromisoformat(txn.occurred_at.replace('Z', '+00:00')).astimezone(timezone.utc).date().isoformat()\n            if txn.status != 'settled' or not day.startswith('2025-10'):\n                continue\n            key = (customer.customer_id, day)\n            count, spend, *_ = expected.get(key, (0, 0))\n            expected[key] = (count + int(txn.kind == 'sale'), spend + txn.signed_amount_cents, txn.currency, customer.segment, customer.country)\nfinally:\n    store.close()\nassert actual == expected\nprint('Verified all 145 stored records against the ledger; only approved analytics fields present.')\nprint('Stats after:', json.load(urllib.request.urlopen('http://127.0.0.1:8701/v1/ingest/stats')))\nPY\n"]
