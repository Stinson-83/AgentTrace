[118.308584, "o", "def test_mixed_currencies_rejected_before_sending(ledger, settings, ingest):\r\n\u001b[?2004l\r"]
[118.308607, "o", "\u001b[?2004h> "]
[118.308648, "o", "    add(ledger, 'gbp', '2025-10-01T12:00:00Z')\r\n\u001b[?2004l\r"]
[118.308673, "o", "\u001b[?2004h> "]
[118.308731, "o", "    add(ledger, 'eur', '2025-10-01T13:00:00Z', currency='EUR')\r\n\u001b[?2004l\r"]
[118.308761, "o", "\u001b[?2004h> "]
[118.308815, "o", "    with pytest.raises(StoreError, match='mixed currencies'):\r\n\u001b[?2004l\r"]
[118.308844, "o", "\u001b[?2004h> "]
[118.30889, "o", "        run_activity_export(ledger, settings, '2025-10')\r\n\u001b[?2004l\r"]
[118.308914, "o", "\u001b[?2004h> "]
[118.308946, "o", "    ingest[0].assert_not_called()\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.308969, "o", "> \r\n\u001b[?2004l\r"]
[118.308999, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.309051, "o", "def test_rejection_stops_later_batches(store, settings, ingest):\r\n\u001b[?2004l\r"]
[118.309075, "o", "\u001b[?2004h> "]
[118.309109, "o", "    client = ingest[1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.309154, "o", "    client.post_activity_batch.side_effect = [\r\n\u001b[?2004l\r"]
[118.309177, "o", "\u001b[?2004h> "]
[118.309266, "o", "        IngestResponse(202, {'accepted': 1}), IngestError('ingest service returned 422')\r\n\u001b[?2004l\r"]
[118.309289, "o", "\u001b[?2004h> "]
[118.309317, "o", "    ]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.309354, "o", "    with pytest.raises(IngestError, match='422'):\r\n\u001b[?2004l\r"]
[118.309379, "o", "\u001b[?2004h> "]
[118.309461, "o", "        run_activity_export(store, replace(settings, ingest_batch_size=1), '2025-10')\r\n\u001b[?2004l\r"]
[118.309485, "o", "\u001b[?2004h> "]
[118.309534, "o", "    assert client.post_activity_batch.call_count == 2\r\n\u001b[?2004l\r"]
[118.309564, "o", "\u001b[?2004h> "]
[118.309585, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.309676, "o", "@pytest.mark.parametrize('response', [IngestResponse(200, {}), IngestResponse(202, {}),\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.309701, "o", "> "]
[118.30977, "o", "                                      IngestResponse(202, {'accepted': '1'})])\r\n\u001b[?2004l\r"]
[118.3098, "o", "\u001b[?2004h> "]
[118.30986, "o", "def test_invalid_ingest_response(store, settings, ingest, response):\r\n\u001b[?2004l\r"]
[118.309882, "o", "\u001b[?2004h> "]
[118.309931, "o", "    ingest[1].post_activity_batch.side_effect = None\r\n\u001b[?2004l\r"]
