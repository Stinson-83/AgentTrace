[118.310293, "o", "def test_cli_success_and_dry_run(store, settings, ingest, monkeypatch, capsys):\r\n\u001b[?2004l\r"]
[118.310319, "o", "\u001b[?2004h> "]
[118.310377, "o", "    monkeypatch.setattr(cli, 'load_settings', lambda: settings)\r\n\u001b[?2004l\r"]
[118.3104, "o", "\u001b[?2004h> "]
[118.310481, "o", "    assert cli.main(['export-activity', '--period', '2025-10', '--dry-run']) == 0\r\n\u001b[?2004l\r"]
[118.310511, "o", "\u001b[?2004h> "]
[118.310537, "o", "    preview = capsys.readouterr()\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.310558, "o", "> "]
[118.31062, "o", "    assert 'would send' in preview.out and 'batches' in preview.out\r\n\u001b[?2004l\r"]
[118.310641, "o", "\u001b[?2004h> "]
[118.31067, "o", "    assert preview.err == ''\r\n\u001b[?2004l\r"]
[118.3107, "o", "\u001b[?2004h> "]
[118.310726, "o", "    ingest[0].assert_not_called()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.310804, "o", "    assert cli.main(['export-activity', '--period', '2025-10']) == 0\r\n\u001b[?2004l\r"]
[118.310826, "o", "\u001b[?2004h"]
[118.310847, "o", "> "]
[118.310869, "o", "    output = capsys.readouterr()\r\n\u001b[?2004l\r"]
[118.31089, "o", "\u001b[?2004h> "]
[118.310946, "o", "    assert output.out.startswith('sent ') and 'accepted' in output.out\r\n\u001b[?2004l\r"]
[118.310968, "o", "\u001b[?2004h> "]
[118.310996, "o", "    assert output.err == ''\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.311017, "o", "> "]
[118.311082, "o", "    assert cli.main(['export-activity', '--period', '2024-01']) == 0\r\n\u001b[?2004l\r"]
[118.311105, "o", "\u001b[?2004h> "]
[118.31117, "o", "    assert 'sent 0 records in 0 batches' in capsys.readouterr().out\r\n\u001b[?2004l\r"]
[118.311192, "o", "\u001b[?2004h> "]
[118.31122, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
