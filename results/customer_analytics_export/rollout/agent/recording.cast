[75.92631, "o", "pos = s.index('    h = sub.add_parser(\"ingest-health\"')\r\n\u001b[?2004l\r"]
[75.92637, "o", "\u001b[?2004h> "]
[75.926777, "o", "s = s[:pos] + '''    activity = sub.add_parser(\"export-activity\", help=\"send daily customer activity to analytics ingest\")\r\n\u001b[?2004l\r"]
[75.92686, "o", "\u001b[?2004h> "]
[75.92715, "o", "    activity.add_argument(\"--period\", required=True, help=\"YYYY-MM; UTC activity month\")\r\n\u001b[?2004l\r"]
[75.927192, "o", "\u001b[?2004h> "]
