[118.307968, "o", "@pytest.mark.parametrize('period', ['202510', '2025-1', '2025-00', '2025-13', '',\r\n\u001b[?2004l\r"]
[118.307975, "o", "\u001b[?2004h> "]
[118.308129, "o", "                                    '0000-01', '9999-12', '2025-10\\n', '２０２５-１０'])\r\n\u001b[?2004l\r"]
