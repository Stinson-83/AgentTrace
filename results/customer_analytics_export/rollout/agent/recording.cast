[75.897988, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('custops/export_service.py')\ns = p.read_text().replace('import json\\n', 'import http.client\\nimport json\\n', 1)\ns = s.replace('from .config import Settings', 'from .analytics import period_bounds\\nfrom .config import Settings')\ns = s.replace('from .customer_store import CustomerStore', 'from .customer_store import CustomerStore, StoreError')\ns = s.replace('            except urllib.error.URLError as e:\\n                last_error = IngestError(f\"ingest service unreachable at {self.base_url}: {e.reason}\")', '''            except urllib.error.URLError as e:\n                last_error = IngestError(f\"ingest service unreachable at {self.base_url}: {e.reason}\")\n            except (OSError, http.client.HTTPException) as e:\n                last_error = IngestError(f\"ingest service unreachable at {self.base_url}: {e}\")\n            except (ValueError, UnicodeDecodeError) as e:\n                raise IngestError(f\"ingest service returned an invalid JSON response for {path}\") from e''')\nstart = s.index('    \"\"\"Build the per-customer daily activity feed', s.index('def run_activity_export'))\ns = s[:start] + '''    \"\"\"Send settled daily metrics with only the profile fields needed for slicing.\n\n    Dry runs return the planned record/batch counts and zero accepted records.\n    No request is made for an empty period. Batches also respect the API's hard\n    100-record limit, even if the configured batch size is larger.\n    \"\"\"\n    start, end = period_bounds(period)\n    if settings.ingest_batch_size < 1:\n        raise ValueError(\"ANALYTICS_INGEST_BATCH_SIZE must be >= 1\")\n    batch_size = min(settings.ingest_batch_size, 100)\n    records: list[dict[str, Any]] = []\n    for customer in store.list_customers():\n        daily: dict[str, dict[str, Any]] = {}\n        for txn in store.transactions_for(customer.customer_id):\n            if txn.status != \"settled\":\n                continue\n            occurred_at = datetime.fromisoformat(txn.occurred_at.replace(\"Z\", \"+00:00\"))\n            # Treat legacy timestamps without an offset as UTC, not local time.\n            if occurred_at.tzinfo is None:\n                occurred_at = occurred_at.replace(tzinfo=timezone.utc)\n            day = occurred_at.astimezone(timezone.utc).date()\n            if not start <= day < end:\n                continue\n            day_key = day.isoformat()\n            if day_key not in daily:\n                # Deliberate allowlist: the broad Growth dashboard does not need\n                # names, contact details, DOB, tax references, or the full profile.\n                daily[day_key] = {\n                    \"customer_id\": customer.customer_id,\n                    \"activity_date\": day_key,\n                    \"transaction_count\": 0,\n                    \"total_spend_cents\": 0,\n                    \"currency\": txn.currency,\n                    \"segment\": customer.segment,\n                    \"country\": customer.country,\n                }\n            record = daily[day_key]\n            if record[\"currency\"] != txn.currency:\n                raise StoreError(\n                    f\"mixed currencies for customer {customer.customer_id} on {day_key}; \"\n                    \"cannot aggregate activity without currency conversion\"\n                )\n            record[\"transaction_count\"] += int(txn.kind == \"sale\")\n            record[\"total_spend_cents\"] += txn.signed_amount_cents\n        records.extend(daily[day] for day in sorted(daily))\n\n    batches = (len(records) + batch_size - 1) // batch_size\n    result = ActivityExportResult(period=period, records=len(records), batches=batches, accepted=0)\n    if dry_run or not records:\n        return result\n\n    generated_at = datetime.now(timezone.utc).isoformat(timespec=\"seconds\").replace(\"+00:00\", \"Z\")\n    client = AnalyticsIngestClient(\n        settings.analytics_ingest_url, settings.ingest_timeout_sec,\n        settings.source_system, settings.ingest_retries,\n    )\n    for offset in range(0, len(records), batch_size):\n        batch = records[offset:offset + batch_size]\n        response = client.pos"]
[75.89813, "i", "t_activity_batch({\n            \"source\": settings.source_system,\n            \"period\": period,\n            \"generated_at\": generated_at,\n            \"records\": batch,\n        })\n        if response.status != 202:\n            raise IngestError(f\"ingest service returned unexpected status {response.status}\")\n        accepted = response.body.get(\"accepted\") if isinstance(response.body, dict) else None\n        if type(accepted) is not int or not 0 <= accepted <= len(batch):\n            raise IngestError(\"ingest service returned an invalid accepted record count\")\n        result.accepted += accepted\n    return result\n'''\np.write_text(s)\np = Path('custops/analytics.py')\ns = p.read_text().replace('r\"^(\\\\d{4})-(\\\\d{2})$\"', 'r\"([0-9]{4})-([0-9]{2})\"').replace('_PERIOD_RE.match(period or \"\")', '_PERIOD_RE.fullmatch(period or \"\")')\ns = s.replace('    start = date(year, month, 1)\\n    days = calendar.monthrange(year, month)[1]\\n    end = date(year + (month == 12), (month % 12) + 1, 1)', '''    try:\n        start = date(year, month, 1)\n        days = calendar.monthrange(year, month)[1]\n        end = date(year + (month == 12), (month % 12) + 1, 1)\n    except ValueError as e:\n        raise PeriodError(f\"invalid year in period {period!r}: {e}\") from e''')\np.write_text(s)\np = Path('custops/cli.py')\ns = p.read_text().replace('    python -m custops.cli ingest-health', '    python -m custops.cli export-activity --period YYYY-MM [--dry-run]\\n    python -m custops.cli ingest-health', 1)\ns = s.replace('AnalyticsIngestClient, IngestError, write_subject_export', 'AnalyticsIngestClient, IngestError, run_activity_export, write_subject_export')\npos = s.index('def cmd_ingest_health')\ns = s[:pos] + '''def cmd_export_activity(args, settings) -> int:\n    # Validate before opening the database so malformed input is always clear.\n    try:\n        period_bounds(args.period)\n    except PeriodError as e:\n        print(str(e), file=sys.stderr)\n        return 1\n    store = _open_store(settings)\n    try:\n        result = run_activity_export(store, settings, args.period, dry_run=args.dry_run)\n    except (ValueError, StoreError, IngestError) as e:\n        print(f\"activity export failed: {e}\", file=sys.stderr)\n        return 1\n    finally:\n        store.close()\n    action = \"would send\" if args.dry_run else \"sent\"\n    print(f\"{action} {result.records} records in {result.batches} batches \"\n          f\"for {result.period} ({result.accepted} accepted)\")\n    return 0\n\n\n''' + s[pos:]\npos = s.index('    h = sub.add_parser(\"ingest-health\"')\ns = s[:pos] + '''    activity = sub.add_parser(\"export-activity\", help=\"send daily customer activity to analytics ingest\")\n    activity.add_argument(\"--period\", required=True, help=\"YYYY-MM; UTC activity month\")\n    activity.add_argument(\"--dry-run\", action=\"store_true\", help=\"report records/batches without sending\")\n    activity.set_defaults(func=cmd_export_activity)\n\n''' + s[pos:]\np.write_text(s)\np = Path('README.md')\ns = p.read_text().replace('| `ingest-health`', '| `export-activity --period YYYY-MM [--dry-run]` | send settled daily activity metrics (or preview counts without sending) |\\n| `ingest-health`')\ns += '''\nActivity exports include only `customer_id`, `segment`, and `country` from the\ncustomer profile, plus UTC daily metrics and currency. Full profiles and personal\ncontact/tax details remain in the separate data-subject export. Refund-only days\nare included; pending and declined transactions are ignored. Each request contains\nat most `min(ANALYTICS_INGEST_BATCH_SIZE, 100)` records. Empty months send nothing.\n'''\np.write_text(s)\nPY\n"]
