[118.307148, "o", "\u001b[?2004h"]
[118.30717, "o", ">     )\r\n\u001b[?2004l\r_\u001b[?2004h> "]
[118.307208, "o", "    ingest[0].assert_not_called()\r\n\u001b[?2004l\r"]
