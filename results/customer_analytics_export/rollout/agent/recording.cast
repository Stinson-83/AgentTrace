[118.311297, "o", "def test_cli_invalid_period_before_opening_store(settings, monkeypatch, capsys):\r\n\u001b[?2004l\r"]
[118.311324, "o", "\u001b[?2004h> "]
[118.311439, "o", "    monkeypatch.setattr(cli, 'load_settings', lambda: replace(settings, db_path=settings.data_dir / 'missing.db'))\r\n\u001b[?2004l\r"]
[118.311445, "o", "\u001b[?2004h> "]
[118.311527, "o", "    assert cli.main(['export-activity', '--period', 'October']) != 0\r\n\u001b[?2004l\r"]
[118.311548, "o", "\u001b[?2004h"]
[118.311569, "o", "> "]
[118.311598, "o", "    output = capsys.readouterr()\r\n\u001b[?2004l\r"]
[118.31162, "o", "\u001b[?2004h> "]
[118.311654, "o", "    assert 'period must look like YYYY-MM' in output.err\r\n\u001b[?2004l\r"]
[118.311675, "o", "\u001b[?2004h> "]
[118.311709, "o", "    assert output.out == ''\r\n\u001b[?2004l\r"]
[118.311733, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[118.311757, "o", "\u001b[?2004h> "]
[118.311787, "o", "@pytest.mark.parametrize('failure, message', [\r\n\u001b[?2004l\r"]
[118.311811, "o", "\u001b[?2004h> "]
[118.311911, "o", "    (urllib.error.HTTPError('http://example', 422, 'Rejected', {}, io.BytesIO(b'bad batch')), '422'),\r\n\u001b[?2004l\r"]
[118.311932, "o", "\u001b[?2004h> "]
[118.311996, "o", "    (urllib.error.URLError('connection refused'), 'unreachable'),\r\n\u001b[?2004l\r"]
[118.312026, "o", "\u001b[?2004h> "]
[118.312066, "o", "    (TimeoutError('timed out'), 'unreachable'),\r\n\u001b[?2004l\r"]
[118.312089, "o", "\u001b[?2004h> "]
[118.312116, "o", "])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.312177, "o", "def test_cli_http_errors(settings, monkeypatch, capsys, failure, message):\r\n\u001b[?2004l\r"]
[118.312199, "o", "\u001b[?2004h> "]
[118.312261, "o", "    monkeypatch.setattr(cli, 'load_settings', lambda: settings)\r\n\u001b[?2004l\r"]
[118.312285, "o", "\u001b[?2004h> "]
[118.312317, "o", "    urlopen = Mock(side_effect=failure)\r\n\u001b[?2004l\r"]
[118.312347, "o", "\u001b[?2004h> "]
[118.312396, "o", "    monkeypatch.setattr('urllib.request.urlopen', urlopen)\r\n\u001b[?2004l\r"]
[118.312418, "o", "\u001b[?2004h> "]
[118.312485, "o", "    assert cli.main(['export-activity', '--period', '2025-10']) == 1\r\n\u001b[?2004l\r"]
[118.312514, "o", "\u001b[?2004h> "]
[118.31254, "o", "    output = capsys.readouterr()\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.31256, "o", "> "]
[118.312601, "o", "    assert 'activity export failed' in output.err\r\n\u001b[?2004l\r"]
[118.312632, "o", "\u001b[?2004h> "]
[118.312657, "o", "    assert message in output.err\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.312679, "o", "> "]
[118.31271, "o", "    assert output.out == ''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.312744, "o", "    assert urlopen.call_count == 1\r\n\u001b[?2004l\r"]
[118.31277, "o", "\u001b[?2004h> "]
[118.312793, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.312854, "o", "def test_client_sends_json_envelope(store, settings, monkeypatch):\r\n\u001b[?2004l\r"]
[118.312876, "o", "\u001b[?2004h> "]
[118.312902, "o", "    response = Mock()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.312932, "o", "    response.status = 202\r\n\u001b[?2004l\r"]
[118.312954, "o", "\u001b[?2004h"]
[118.312989, "o", "> "]
[118.313023, "o", "    response.read.return_value = b'{\"accepted\": 1}'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.313054, "o", "    context = Mock()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.313112, "o", "    context.__enter__ = Mock(return_value=response)\r\n\u001b[?2004l\r"]
[118.313133, "o", "\u001b[?2004h> "]
[118.313178, "o", "    context.__exit__ = Mock(return_value=False)\r\n\u001b[?2004l\r"]
[118.313207, "o", "\u001b[?2004h> "]
[118.313236, "o", "    urlopen = Mock(return_value=context)\r\n\u001b[?2004l\r"]
[118.313264, "o", "\u001b[?2004h> "]
[118.313313, "o", "    monkeypatch.setattr('urllib.request.urlopen', urlopen)\r\n\u001b[?2004l\r"]
[118.313342, "o", "\u001b[?2004h> "]
[118.313393, "o", "    result = run_activity_export(store, settings, '2025-10')\r\n\u001b[?2004l\r"]
[118.313415, "o", "\u001b[?2004h> "]
[118.313456, "o", "    assert result.accepted == result.batches\r\n\u001b[?2004l\r"]
[118.313485, "o", "\u001b[?2004h> "]
[118.313513, "o", "    request = urlopen.call_args.args[0]\r\n\u001b[?2004l\r"]
[118.313542, "o", "\u001b[?2004h> "]
[118.313629, "o", "    assert request.full_url == settings.analytics_ingest_url + '/v1/ingest/customer-activity'\r\n\u001b[?2004l\r"]
[118.313651, "o", "\u001b[?2004h> "]
[118.313682, "o", "    assert request.method == 'POST'\r\n\u001b[?2004l\r"]
[118.313704, "o", "\u001b[?2004h> "]
[118.31377, "o", "    assert request.get_header('Content-type') == 'application/json'\r\n\u001b[?2004l\r"]
[118.313799, "o", "\u001b[?2004h> "]
[118.313851, "o", "    assert request.get_header('X-source-system') == 'custops'\r\n\u001b[?2004l\r"]
[118.313873, "o", "\u001b[?2004h> "]
[118.31393, "o", "    assert json.loads(request.data)['period'] == '2025-10'\r\n\u001b[?2004l\r"]
[118.313959, "o", "\u001b[?2004h> "]
[118.314033, "o", "    assert urlopen.call_args.kwargs == {'timeout': settings.ingest_timeout_sec}\r\n\u001b[?2004l\r"]
[118.314059, "o", "\u001b[?2004h> "]
