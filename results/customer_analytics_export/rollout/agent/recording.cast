[13.035957, "o", "\"\"\"Activity analytics over the transaction ledger.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport calendar\r\nimport re\r\nfrom dataclasses import dataclass\r\nfrom datetime import date\r\nfrom typing import Iterable\r\n\r\nfrom .customer_store import CustomerStore, Transaction\r\n\r\n_PERIOD_RE = re.compile(r\"^(\\d{4})-(\\d{2})$\")\r\n\r\n\r\nclass PeriodError(ValueError):\r\n    pass\r\n\r\n\r\ndef period_bounds(period: str) -> tuple[date, date]:\r\n    \"\"\"Return (first_day, first_day_of_next_month) for a YYYY-MM period string.\"\"\"\r\n    m = _PERIOD_RE.match(period or \"\")\r\n    if not m:\r\n        raise PeriodError(f\"period must look like YYYY-MM, got {period!r}\")\r\n    year, month = int(m.group(1)), int(m.group(2))\r\n    if not 1 <= month <= 12:\r\n"]
[13.036034, "o", "        raise PeriodError(f\"invalid month in period {period!r}\")\r\n    start = date(year, month, 1)\r\n    days = calendar.monthrange(year, month)[1]\r\n    end = date(year + (month == 12), (month % 12) + 1, 1)\r\n    assert (end - start).days == days\r\n    return start, end\r\n\r\n\r\ndef settled(transactions: Iterable[Transaction]) -> list[Transaction]:\r\n    return [t for t in transactions if t.status == \"settled\"]\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass MonthlyTotals:\r\n    period: str\r\n    sale_count: int\r\n    refund_count: int\r\n    net_cents: int\r\n    currency: str\r\n\r\n\r\ndef monthly_totals(store: CustomerStore, customer_id: str, period: str) -> MonthlyTotals:\r\n    \"\"\"Net settled position for a single customer over a month (used by ``customer show``).\"\"\"\r\n    start, end = period_bounds(period)\r\n    txns = [t for t in store.transactions_for(customer_id) if start <= t.occurred_on < end]\r\n    txns = settled(txns)\r\n    currency = txns[0].currency if txns else store.get_customer(customer_id).currency\r\n    return MonthlyTotals(\r\n        period=period,\r\n        sale_count=sum(1 for t in txns if t.kind == \"sale\"),\r\n        refund_count=sum(1 for t in txns if t.kind == \"refund\"),\r\n        net_cents=sum(t.signed_amount_cents for t in txns),\r\n        currency=currency,\r\n    )\r\n\r\n\r\ndef channel_mix(transactions: Iterable[Transaction]) -> dict[str, int]:\r\n    mix: dict[str, int] = {}\r\n    for t in settled(transactions):\r\n"]
[13.036095, "o", "        mix[t.channel] = mix.get(t.channel, 0) + 1\r\n    return dict(sorted(mix.items()))\r\n\"\"\"Runtime configuration.\r\n\r\nValues come from environment variables with sensible local-development defaults so the\r\nservice can be run from a checkout without any extra setup.\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport os\r\nfrom dataclasses import dataclass\r\nfrom pathlib import Path\r\n\r\nPROJECT_ROOT = Path(__file__).resolve().parent.parent\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Settings:\r\n    data_dir: Path\r\n    db_path: Path\r\n    seed_dir: Path\r\n    exports_dir: Path\r\n    analytics_ingest_url: str\r\n    ingest_timeout_sec: float\r\n    ingest_batch_size: int\r\n    ingest_retries: int\r\n    source_system: str\r\n\r\n    @classmethod\r\n    def from_env(cls) -> \"Settings\":\r\n        data_dir = Path(os.environ.get(\"CUSTOPS_DATA_DIR\", PROJECT_ROOT / \"data\"))\r\n        return cls(\r\n            data_dir=data_dir,\r\n            db_path=Path(os.environ.get(\"CUSTOPS_DB_PATH\", data_dir / \"custops.db\")),\r\n            seed_dir=Path(os.environ.get(\"CUSTOPS_SEED_DIR\", PROJECT_ROOT / \"data\" / \"seed\")),\r\n            exports_dir=Path(os.environ.get(\"CUSTOPS_EXPORTS_DIR\", data_dir / \"exports\")),\r\n            analytics_ingest_url=os.environ.get(\"ANALYTICS_INGEST_URL\", \"http://127.0.0.1:8701\"),\r\n            ingest_timeout_sec=float(os.environ.get(\"ANALYTICS_INGEST_TIMEOUT\", \"10\")),\r\n            ingest_batch_size=int(os.environ.get(\"ANALYTICS_INGEST_BATCH_SIZE\", \"100\")),\r\n            ingest_retries=int(os.environ.get(\"ANALYTICS_INGEST_RETRIES\", \"2\")),\r\n            source_system=os.environ.get(\"CUSTOPS_SOURCE_SYSTEM\", \"custops\"),\r\n        )\r\n\r\n\r\n    def validate(self) -> None:\r\n        if self.ingest_batch_size < 1:\r\n            raise ValueError(\"ANALYTICS_INGEST_BATCH_SIZE must be >= 1\")\r\n        if self.ingest_timeout_sec <= 0:\r\n            raise ValueError(\"ANALYTICS_INGEST_TIMEOUT must be positive\")\r\n        if not self.analytics_ingest_url.startswith((\"http://\", \"https://\")):\r\n            raise ValueError(\"ANALYTICS_INGEST_URL must be an http(s) URL\")\r\n\r\n\r\ndef load_settings() -> Settings:\r\n    settings = Settings.from_env()\r\n    settings.validate()\r\n    return settings\r\n"]
[13.036144, "o", "\"\"\"Serialisation helpers.\r\n\r\n``customer_record`` is the canonical representation of a customer used by the data-subject\r\nexport (see docs/data_subject_export.md) and by the ``customer show`` command.\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nfrom dataclasses import asdict\r\nfrom typing import Any\r\n\r\nfrom .customer_store import Customer, Transaction\r\n\r\n\r\ndef customer_record(customer: Customer) -> dict[str, Any]:\r\n    \"\"\"Full customer profile as stored, with stable key order.\"\"\"\r\n    record = asdict(customer)\r\n    record[\"display_name\"] = customer.full_name\r\n    return record\r\n\r\n\r\ndef transaction_record(txn: Transaction) -> dict[str, Any]:\r\n    return {\r\n        \"txn_id\": txn.txn_id,\r\n        \"occurred_at\": txn.occurred_at,\r\n"]
[13.036161, "o", "        \"kind\": txn.kind,\r\n        \"amount_cents\": txn.amount_cents,\r\n        \"currency\": txn.currency,\r\n        \"channel\": txn.channel,\r\n        \"status\": txn.status,\r\n    }\r\n\r\n\r\ndef export_bundle(customer: Customer, transactions: list[Transaction], generated_at: str) -> dict[str, Any]:\r\n    \"\"\"Data-subject export bundle: profile plus full transaction history.\"\"\"\r\n    return {\r\n        \"schema\": \"custops.subject-export/1\",\r\n        \"generated_at\": generated_at,\r\n        \"customer\": customer_record(customer),\r\n        \"transactions\": [transaction_record(t) for t in transactions],\r\n        \"transaction_count\": len(transactions),\r\n    }\r\n"]
[13.036316, "o", "\u001b[?2004h"]
[13.036387, "o", "root@3d6deae74284:/app# "]
[13.139539, "i", "cat tests/conftest.py tests/test_analytics.py tests/test_store.py tests/test_subject_export.py\n"]
[13.139736, "o", "cat tests/conftest.py tests/test_analytics.py tests/test_store.py tests/test_subject_export.py\r\n\u001b[?2004l\r"]
[13.140536, "o", "import sys\r\nfrom pathlib import Path\r\n\r\nimport pytest\r\n\r\nROOT = Path(__file__).resolve().parents[1]\r\nsys.path.insert(0, str(ROOT))\r\n\r\nfrom custops.customer_store import CustomerStore  # noqa: E402\r\n\r\n\r\n@pytest.fixture()\r\ndef store(tmp_path):\r\n    s = CustomerStore(tmp_path / \"test.db\")\r\n    s.load_seed(ROOT / \"data\" / \"seed\")\r\n    yield s\r\n    s.close()\r\nfrom datetime import date\r\n\r\nimport pytest\r\n\r\nfrom custops.analytics import PeriodError, channel_mix, monthly_totals, period_bounds\r\n\r\n\r\n@pytest.mark.parametrize(\"period,expected\", [(\"2025-10\", (date(2025, 10, 1), date(2025, 11, 1))), (\"2024-02\", (date(2024, 2, 1), date(2024, 3, 1))), (\"2025-12\", (date(2025, 12, 1), date(2026, 1, 1)))])\r\ndef test_period_bounds(period, expected):\r\n    assert period_bounds(period) == expected\r\n\r\n\r\n@pytest.mark.parametrize(\"bad\", [\"2025-13\", \"202510\", \"\", \"2025-1\", \"oct-2025\"])\r\ndef test_period_bounds_rejects_bad_input(bad):\r\n    with pytest.raises(PeriodError):\r\n        period_bounds(bad)\r\n\r\n\r\ndef test_monthly_totals_only_settled(store):\r\n    totals = monthly_totals(store, \"cus_1007\", \"2025-10\")\r\n    txns = [t for t in store.transactions_for(\"cus_1007\") if t.occurred_at.startswith(\"2025-10\")]\r\n    settled = [t for t in txns if t.status == \"settled\"]\r\n    assert totals.sale_count == sum(1 for t in settled if t.kind == \"sale\")\r\n    assert totals.refund_count == sum(1 for t in settled if t.kind == \"refund\")\r\n    assert totals.net_cents == sum(t.signed_amount_cents for t in settled)\r\n    assert totals.currency == \"GBP\"\r\n\r\n\r\ndef test_monthly_totals_empty_month(store):\r\n    totals = monthly_totals(store, \"cus_1001\", \"2024-01\")\r\n    assert (totals.sale_count, totals.refund_count, totals.net_cents) == (0, 0, 0)\r\n\r\n\r\ndef test_channel_mix_sorted(store):\r\n    mix = channel_mix(store.transactions_for(\"cus_1001\"))\r\n    assert list(mix) == sorted(mix) and all(v > 0 for v in mix.values())\r\n"]
[13.140689, "o", "from datetime import date\r\n\r\nimport pytest\r\n\r\nfrom custops.customer_store import CustomerStore, StoreError, Transaction\r\n\r\n\r\ndef test_seed_loads_all_customers(store):\r\n    assert store.count_customers() == 12\r\n    c = store.get_customer(\"cus_1004\")\r\n    assert c.full_name == \"Hanna Lindqvist\" and c.segment == \"enterprise\" and c.currency == \"EUR\"\r\n\r\n\r\ndef test_unknown_customer_raises(store):\r\n    with pytest.raises(StoreError):\r\n        store.get_customer(\"cus_9999\")\r\n\r\n\r\ndef test_list_by_segment(store):\r\n    smb = store.list_customers(segment=\"smb\")\r\n    assert {c.customer_id for c in smb} == {\"cus_1002\", \"cus_1005\", \"cus_1008\", \"cus_1010\"}\r\n\r\n\r\ndef test_transactions_between_is_half_open(store):\r\n    october = list(store.transactions_between(date(2025, 10, 1), date(2025, 11, 1)))\r\n    ids = {t.txn_id for t in october}\r\n    boundary = [t for t in store.transactions_for(\"cus_1007\") if t.occurred_at in (\"2025-09-30T23:59:59Z\", \"2025-10-01T00:00:00Z\", \"2025-10-31T23:59:59Z\", \"2025-11-01T00:00:00Z\")]\r\n    by_time = {t.occurred_at: t.txn_id in ids for t in boundary}\r\n    assert by_time == {\"2025-09-30T23:59:59Z\": False, \"2025-10-01T00:00:00Z\": True, \"2025-10-31T23:59:59Z\": True, \"2025-11-01T00:00:00Z\": False}\r\n\r\n\r\ndef test_add_transactions_roundtrip(tmp_path):\r\n    s = CustomerStore(tmp_path / \"x.db\")\r\n    s.load_seed(__import__(\"pathlib\").Path(__file__).resolve().parents[1] / \"data\" / \"seed\")\r\n    n = s.add_transactions([Transaction(\"txn_x1\", \"cus_1001\", \"2025-10-05T10:00:00Z\", \"sale\", 100, \"GBP\", \"web\", \"settled\")])\r\n    assert n == 1 and any(t.txn_id == \"txn_x1\" for t in s.transactions_for(\"cus_1001\"))\r\n    assert Transaction(\"t\", \"c\", \"2025-10-05T10:00:00Z\", \"refund\", 50, \"GBP\", \"web\", \"settled\").signed_amount_cents == -50\r\nimport json\r\n\r\nfrom custops.export_service import write_subject_export\r\nfrom custops.serializers import customer_record, export_bundle\r\n\r\n\r\ndef test_customer_record_has_full_profile(store):\r\n    rec = customer_record(store.get_customer(\"cus_1002\"))\r\n    assert rec[\"customer_id\"] == \"cus_1002\" and rec[\"display_name\"] == \"Lucía Fernández\"\r\n    assert {\"email\", \"phone\", \"date_of_birth\", \"tax_reference\", \"country\", \"segment\", \"currency\", \"created_at\"} <= set(rec)\r\n\r\n\r\ndef test_subject_export_bundle(store, tmp_path):\r\n    path = write_subject_export(store, \"cus_1009\", tmp_path)\r\n    bundle = json.loads(path.read_text())\r\n    assert bundle[\"schema\"] == \"custops.subject-export/1\"\r\n    assert bundle[\"customer\"][\"customer_id\"] == \"cus_1009\"\r\n    assert bundle[\"transaction_count\"] == len(bundle[\"transactions\"]) == len(store.transactions_for(\"cus_1009\"))\r\n    assert export_bundle(store.get_customer(\"cus_1009\"), [], \"2025-01-01T00:00:00Z\")[\"transaction_count\"] == 0\r\n"]
