[75.923147, "o", "\u001b[?2004h"]
[75.923167, "o", "> "]
[75.923269, "o", "    except PeriodError as e:\r\n"]
[75.923289, "o", "\u001b[?2004l\r"]
[75.923314, "o", "\u001b[?2004h"]
[75.923333, "o", "> "]
[75.92345, "o", "        print(str(e), file=sys.stderr)\r\n"]
[75.923476, "o", "\u001b[?2004l\r"]
