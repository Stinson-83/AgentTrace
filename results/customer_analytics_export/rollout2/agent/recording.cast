[69.296536, "o", "\u001b[?2004h> "]
[69.296864, "o", "s = s.replace('def cmd_transactions_list(args, settings) -> int:', '''def cmd_export_activity(args, settings) -> int:\r\n\u001b[?2004l\r"]
[69.296887, "o", "\u001b[?2004h"]
[69.2969, "o", "> "]
[69.296927, "o", "    try:\r\n\u001b[?2004l\r"]
[69.296949, "o", "\u001b[?2004h"]
[69.296962, "o", "> "]
[69.29706, "o", "        period_bounds(args.period)\r\n"]
[69.297075, "o", "\u001b[?2004l\r"]
[69.297088, "o", "\u001b[?2004h> "]
[69.297197, "o", "        store = _open_store(settings)\r\n\u001b[?2004l\r"]
[69.29722, "o", "\u001b[?2004h"]
[69.297233, "o", "> "]
[69.297268, "o", "        try:\r\n\u001b[?2004l\r"]
[69.297289, "o", "\u001b[?2004h"]
[69.297306, "o", "> "]
[69.297557, "o", "            result = run_activity_export(store, settings, args.period, dry_run=args.dry_run)\r\n\u001b[?2004l\r"]
[69.297583, "o", "\u001b[?2004h"]
[69.297597, "o", "> "]
[69.297642, "o", "        finally:\r\n"]
[69.297657, "o", "\u001b[?2004l\r"]
[69.297671, "o", "\u001b[?2004h"]
[69.297688, "o", "> "]
[69.297752, "o", "            store.close()\r\n\u001b[?2004l\r"]
[69.297774, "o", "\u001b[?2004h"]
[69.297796, "o", "> "]
[69.297941, "o", "    except (ValueError, IngestError, StoreError) as e:\r\n\u001b[?2004l\r"]
[69.297962, "o", "\u001b[?2004h"]
[69.298011, "o", "> "]
[69.29815, "o", "        print(f\"activity export failed: {e}\", file=sys.stderr)\r\n\u001b[?2004l\r"]
[69.298191, "o", "\u001b[?2004h> "]
[69.298234, "o", "        return 1\r\n\u001b[?2004l\r"]
[69.298269, "o", "\u001b[?2004h"]
[69.298344, "o", "> "]
[69.298425, "o", "    if args.dry_run:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.298694, "o", "        print(f\"would send {result.records} records in {result.batches} batches for {result.period} (dry run)\")\r\n\u001b[?2004l\r"]
[69.298748, "o", "\u001b[?2004h> "]
[69.29882, "o", "    else:\r\n\u001b[?2004l\r"]
[69.298871, "o", "\u001b[?2004h> "]
[69.299141, "o", "        print(f\"sent {result.records} records in {result.batches} batches for {result.period}; {result.accepted} accepted\")\r\n\u001b[?2004l\r"]
[69.299195, "o", "\u001b[?2004h> "]
[69.299241, "o", "    return 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[69.299271, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[69.299305, "o", "\u001b[?2004h> "]
[69.299484, "o", "def cmd_transactions_list(args, settings) -> int:''')\r\n\u001b[?2004l\r"]
[69.299519, "o", "\u001b[?2004h> "]
[69.300066, "o", "s = s.replace('    t = sub.add_parser(\"transactions\", help=\"transaction ledger\")', '''    activity = sub.add_parser(\"export-activity\", help=\"send daily customer activity to analytics ingest\")\r\n\u001b[?2004l\r"]
[69.30012, "o", "\u001b[?2004h> "]
[69.300276, "o", "    activity.add_argument(\"--period\", required=True, help=\"YYYY-MM\")\r\n\u001b[?2004l\r"]
[69.300342, "o", "\u001b[?2004h> "]
[69.300683, "o", "    activity.add_argument(\"--dry-run\", action=\"store_true\", help=\"report planned records and batches without sending\")\r\n\u001b[?2004l\r"]
[69.300741, "o", "\u001b[?2004h> "]
[69.300847, "o", "    activity.set_defaults(func=cmd_export_activity)\r\n\u001b[?2004l\r"]
[69.300889, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[69.300931, "o", "\u001b[?2004h> "]
[69.301105, "o", "    t = sub.add_parser(\"transactions\", help=\"transaction ledger\")''')\r\n\u001b[?2004l\r"]
