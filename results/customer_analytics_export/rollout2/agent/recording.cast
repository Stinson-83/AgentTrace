[147.838991, "o", "python -m custops.cli ingest-health; python -m custops.cli export-activity --period 2025-10 --dry-run; python -m custops.cli export-activity --period 2025-13; printf 'malformed period exit: %s\\n' \"$?\"; ANALYTICS_INGEST_URL=http://127.0.0.1:1 ANALYTICS_INGEST_RETRIES=0 python -m custops.cli export-activity --period 2025-10; printf 'unreachable service exit: %s\\n' \"$?\"\r\n\u001b[?2004l\r"]
