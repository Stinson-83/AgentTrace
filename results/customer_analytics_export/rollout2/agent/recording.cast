[147.738583, "o", "sed -n '38,85p' custops/export_service.py; sed -n '125,240p' custops/export_service.py; sed -n '90,128p' custops/cli.py; cat custops/analytics.py | head -42\r\n\u001b[?2004l\r"]
[147.739545, "o", "    def __init__(self, base_url: str, timeout_sec: float = 10.0, source_system: str = \"custops\", retries: int = 2, backoff_sec: float = 0.5):\r\n        self.base_url = base_url.rstrip(\"/\")\r\n        self.timeout_sec = timeout_sec\r\n        self.source_system = source_system\r\n        self.retries = max(0, retries)\r\n        self.backoff_sec = backoff_sec\r\n\r\n    def _request(self, method: str, path: str, payload: dict[str, Any] | None = None) -> IngestResponse:\r\n        data = None\r\n        headers = {\"Accept\": \"application/json\", \"X-Source-System\": self.source_system}\r\n        if payload is not None:\r\n            data = json.dumps(payload, separators=(\",\", \":\")).encode(\"utf-8\")\r\n            headers[\"Content-Type\"] = \"application/json\"\r\n        last_error: IngestError | None = None\r\n        for attempt in range(self.retries + 1):\r\n            req = urllib.request.Request(self.base_url + path, data=data, method=method, headers=headers)\r\n            try:\r\n                with urllib.request.urlopen(req, timeout=self.timeout_sec) as resp:\r\n                    raw = resp.read().decode(\"utf-8\")\r\n                    return IngestResponse(resp.status, json.loads(raw) if raw else {})\r\n            except urllib.error.HTTPError as e:\r\n                detail = e.read().decode(\"utf-8\", \"replace\")\r\n                last_error = IngestError(f\"ingest service returned {e.code} for {path}: {detail}\")\r\n                if e.code not in self.RETRYABLE_STATUSES:\r\n                    raise last_error from e\r\n            except (urllib.error.URLError, TimeoutError, ConnectionError) as e:\r\n                detail = getattr(e, \"reason\", str(e))\r\n"]
[147.73969, "o", "                last_error = IngestError(f\"ingest service unreachable at {self.base_url}: {detail}\")\r\n            except (UnicodeDecodeError, json.JSONDecodeError) as e:\r\n                raise IngestError(f\"ingest service returned invalid JSON for {path}\") from e\r\n            if attempt < self.retries:\r\n                time.sleep(self.backoff_sec * (attempt + 1))\r\n        assert last_error is not None\r\n        raise last_error\r\n\r\n    def health(self) -> IngestResponse:\r\n        return self._request(\"GET\", \"/healthz\")\r\n\r\n    def post_activity_batch(self, batch: dict[str, Any]) -> IngestResponse:\r\n        \"\"\"POST one batch to /v1/ingest/customer-activity (see docs/analytics_ingest_contract.md).\"\"\"\r\n        return self._request(\"POST\", \"/v1/ingest/customer-activity\", batch)\r\n\r\n\r\n# ----------------------------------------------------------------------------- subject export\r\ndef write_subject_export(store: CustomerStore, customer_id: str, out_dir: Path) -> Path:\r\n    \"\"\"Write the data-subject export bundle for one customer and return the file path.\"\"\"\r\n    customer = store.get_customer(customer_id)\r\n    transactions = store.transactions_for(customer_id)\r\n"]
[147.740971, "o", "    \"\"\"\r\n    start, end = period_bounds(period)\r\n    if settings.ingest_batch_size < 1:\r\n        raise ValueError(\"ANALYTICS_INGEST_BATCH_SIZE must be >= 1\")\r\n    batch_size = min(settings.ingest_batch_size, 100)\r\n    records: list[dict[str, Any]] = []\r\n    for customer in store.list_customers():\r\n        daily: dict[str, dict[str, Any]] = {}\r\n        for txn in store.transactions_for(customer.customer_id):\r\n            if txn.status != \"settled\":\r\n                continue\r\n            timestamp = datetime.fromisoformat(txn.occurred_at.replace(\"Z\", \"+00:00\"))\r\n            # Timestamps without an offset, if present, are interpreted as UTC.\r\n            if timestamp.tzinfo is None:\r\n                timestamp = timestamp.replace(tzinfo=timezone.utc)\r\n            day = timestamp.astimezone(timezone.utc).date()\r\n            if not start <= day < end:\r\n                continue\r\n"]
[147.741152, "o", "            key = day.isoformat()\r\n            if key not in daily:\r\n                daily[key] = {\r\n                    **customer_record(customer),\r\n                    \"activity_date\": key,\r\n                    \"transaction_count\": 0,\r\n                    \"total_spend_cents\": 0,\r\n                    \"currency\": txn.currency,\r\n                }\r\n            record = daily[key]\r\n            if record[\"currency\"] != txn.currency:\r\n                raise StoreError(\r\n                    f\"cannot aggregate mixed currencies for {customer.customer_id} on {key}\"\r\n                )\r\n            record[\"transaction_count\"] += int(txn.kind == \"sale\")\r\n            record[\"total_spend_cents\"] += txn.signed_amount_cents\r\n        records.extend(daily[day] for day in sorted(daily))\r\n\r\n    batch_count = (len(records) + batch_size - 1) // batch_size\r\n    result = ActivityExportResult(period, len(records), batch_count, 0)\r\n    if dry_run or not records:\r\n        return result\r\n\r\n    client = AnalyticsIngestClient(\r\n        settings.analytics_ingest_url,\r\n        settings.ingest_timeout_sec,\r\n        settings.source_system,\r\n        settings.ingest_retries,\r\n    )\r\n    generated_at = datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace(\"+00:00\", \"Z\")\r\n    for offset in range(0, len(records), batch_size):\r\n        batch = records[offset:offset + batch_size]\r\n        response = client.post_activity_batch({\r\n            \"source\": settings.source_system,\r\n            \"period\": period,\r\n            \"generated_at\": generated_at,\r\n            \"records\": batch,\r\n        })\r\n        if response.status != 202:\r\n            raise IngestError(f\"ingest service rejected batch: HTTP {response.status}: {response.body}\")\r\n        accepted = response.body.get(\"accepted\")\r\n        if type(accepted) is not int or not 0 <= accepted <= len(batch):\r\n            raise IngestError(f\"ingest service returned an invalid accepted count: {accepted!r}\")\r\n        result.accepted += accepted\r\n    return result\r\n"]
[147.743436, "o", "        try:\r\n            result = run_activity_export(store, settings, args.period, dry_run=args.dry_run)\r\n        finally:\r\n            store.close()\r\n    except (ValueError, IngestError, StoreError) as e:\r\n        print(f\"activity export failed: {e}\", file=sys.stderr)\r\n        return 1\r\n"]
[147.743597, "o", "    if args.dry_run:\r\n        print(f\"would send {result.records} records in {result.batches} batches for {result.period} (dry run)\")\r\n    else:\r\n        print(f\"sent {result.records} records in {result.batches} batches for {result.period}; {result.accepted} accepted\")\r\n    return 0\r\n\r\n\r\ndef cmd_transactions_list(args, settings) -> int:\r\n    store = _open_store(settings)\r\n    try:\r\n        store.get_customer(args.customer_id)\r\n        bounds = period_bounds(args.period) if args.period else None\r\n    except (StoreError, PeriodError) as e:\r\n        print(str(e), file=sys.stderr)\r\n        return 1\r\n    txns = store.transactions_for(args.customer_id)\r\n    if bounds:\r\n        txns = [t for t in txns if bounds[0] <= t.occurred_on < bounds[1]]\r\n    if args.status:\r\n        txns = [t for t in txns if t.status == args.status]\r\n    for t in txns:\r\n        print(f\"{t.txn_id}\\t{t.occurred_at}\\t{t.kind:<6}\\t{t.status:<8}\\t{t.amount_cents:>8} {t.currency}\\t{t.channel}\")\r\n    print(f\"{len(txns)} transactions\", file=sys.stderr)\r\n    return 0\r\n\r\n\r\ndef cmd_ingest_health(args, settings) -> int:\r\n    client = AnalyticsIngestClient(settings.analytics_ingest_url, settings.ingest_timeout_sec, settings.source_system, settings.ingest_retries)\r\n    try:\r\n        resp = client.health()\r\n    except IngestError as e:\r\n        print(str(e), file=sys.stderr)\r\n"]
[147.745701, "o", "\"\"\"Activity analytics over the transaction ledger.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport calendar\r\nimport re\r\nfrom dataclasses import dataclass\r\nfrom datetime import date\r\nfrom typing import Iterable\r\n\r\nfrom .customer_store import CustomerStore, Transaction\r\n\r\n_PERIOD_RE = re.compile(r\"([0-9]{4})-([0-9]{2})\")\r\n\r\n\r\nclass PeriodError(ValueError):\r\n    pass\r\n\r\n\r\ndef period_bounds(period: str) -> tuple[date, date]:\r\n    \"\"\"Return (first_day, first_day_of_next_month) for a YYYY-MM period string.\"\"\"\r\n    m = _PERIOD_RE.fullmatch(period or \"\")\r\n    if not m:\r\n        raise PeriodError(f\"period must look like YYYY-MM, got {period!r}\")\r\n    year, month = int(m.group(1)), int(m.group(2))\r\n    if not 1 <= month <= 12:\r\n        raise PeriodError(f\"invalid month in period {period!r}\")\r\n    try:\r\n        start = date(year, month, 1)\r\n        days = calendar.monthrange(year, month)[1]\r\n        end = date(year + (month == 12), (month % 12) + 1, 1)\r\n    except ValueError as e:\r\n        raise PeriodError(f\"invalid calendar period {period!r}\") from e\r\n"]
[147.745819, "o", "    assert (end - start).days == days\r\n    return start, end\r\n\r\n\r\ndef settled(transactions: Iterable[Transaction]) -> list[Transaction]:\r\n    return [t for t in transactions if t.status == \"settled\"]\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass MonthlyTotals:\r\n"]
[147.746019, "o", "\u001b[?2004hroot@1f11da6c27fc:/app# "]
