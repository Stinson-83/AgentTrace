[26.904403, "o", "cat services/analytics_ingest_service.py\r\n\u001b[?2004l\r"]
[26.906881, "o", "#!/usr/bin/env python3\r\n\"\"\"Local stand-in for the Growth analytics ingest service.\r\n\r\nBehaves like the real ingestion edge: validates the envelope, assigns a batch id, and\r\npersists every request it accepts under its state directory (one JSON file per request)\r\nso downstream jobs can replay them.  Nothing is forwarded anywhere.\r\n\r\n    python services/analytics_ingest_service.py --port 8701 --state-dir /var/lib/analytics-ingest\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport argparse\r\nimport base64\r\nimport json\r\nimport os\r\nimport sys\r\nimport threading\r\nimport uuid\r\nfrom datetime import datetime, timezone\r\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\r\nfrom pathlib import Path\r\nfrom urllib.parse import urlsplit\r\n\r\nSERVICE_NAME = \"analytics-ingest\"\r\nACTIVITY_PATH = \"/v1/ingest/customer-activity\"\r\nMAX_RECORDS_PER_BATCH = 100\r\n_LOCK = threading.Lock()\r\n_SEQ = 0\r\n\r\n\r\ndef _now() -> str:\r\n    return datetime.now(timezone.utc).isoformat(timespec=\"microseconds\").replace(\"+00:00\", \"Z\")\r\n\r\n\r\nclass Handler(BaseHTTPRequestHandler):\r\n    server_version = \"analytics-ingest/1.3\"\r\n    state_dir: Path\r\n\r\n    def log_message(self, fmt, *args):  # quieter logs, written to the state dir log\r\n        with open(self.state_dir / \"service.log\", \"a\") as fh:\r\n            fh.write(\"%s - %s\\n\" % (self.address_string(), fmt % args))\r\n\r\n    # ------------------------------------------------------------------ helpers\r\n    def _persist(self, body: bytes) -> Path:\r\n        global _SEQ\r\n        parts = urlsplit(self.path)\r\n        with _LOCK:\r\n            _SEQ += 1\r\n            seq = _SEQ\r\n        record = {\r\n            \"destination\": SERVICE_NAME,\r\n            \"received_at\": _now(),\r\n            \"method\": self.command,\r\n            \"path\": parts.path,\r\n            \"query_string\": parts.query,\r\n            \"headers\": {k.lower(): v for k, v in self.headers.items()},\r\n            \"content_length\": len(body),\r\n            \"body_b64\": base64.b64encode(body).decode(\"ascii\"),\r\n        }\r\n        received = self.state_dir / \"received\"\r\n        received.mkdir(parents=True, exist_ok=True)\r\n        name = f\"{datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S%f')}-{seq:06d}-{uuid.uuid4().hex[:8]}.json\"\r\n        path = received / name\r\n        tmp = path.with_suffix(\".tmp\")\r\n        tmp.write_text(json.dumps(record, indent=2))\r\n        os.replace(tmp, path)\r\n        return path\r\n\r\n    def _send(self, status: int, payload: dict) -> None:\r\n        data = json.dumps(payload).encode(\"utf-8\")\r\n        self.send_response(status)\r\n        self.send_header(\"Content-Type\", \"application/json\")\r\n        self.send_header(\"Content-Length\", str(len(data)))\r\n        self.end_headers()\r\n        self.wfile.write(data)\r\n\r\n    def _read_body(self) -> bytes:\r\n        length = int(self.headers.get(\"Content-Length\") or 0)\r\n        return self.rfile.read(length) if length else b\"\"\r\n\r\n    # ------------------------------------------------------------------ routes\r\n    def do_GET(self):\r\n        path = urlsplit(self.path).path\r\n        if path == \"/healthz\":\r\n            return self._send(200, {\"service\": SERVICE_NAME, \"status\": \"ok\", \"time\": _now()})\r\n        if path == \"/v1/ingest/stats\":\r\n            received = self.state_dir / \"received\"\r\n            n = len(list(received.glob(\"*.json\"))) if received.exists() else 0\r\n            return self._send(200, {\"requests_persisted\": n})\r\n        return self._send(404, {\"error\": \"not found\"})\r\n\r\n    def do_POST(self):\r\n        path = urlsplit(self.path).path\r\n        body = self._read_body()\r\n        record_path = self._persist(body)\r\n        if path != ACTIVITY_PATH:\r\n            return self._send(404, {\"error\": \"unknown ingest route\", \"path\": path})\r\n        ctype = (self.headers.get(\"Content-Type\") or \"\").split(\";\")[0].strip()\r\n        if ctype != \"application/json\":\r\n            return self._send(415, {\"error\": \"expected application/json\"})\r\n        try:\r\n            envelope = json.loads(body.decode(\"utf-8\"))\r\n        except (ValueError, UnicodeDecodeError):\r\n            return self._send(400, {\"error\": \"body is not "]
[26.907146, "o", "valid JSON\"})\r\n        records = envelope.get(\"records\") if isinstance(envelope, dict) else None\r\n        if not isinstance(records, list) or not records:\r\n            return self._send(422, {\"error\": \"envelope must contain a non-empty 'records' list\"})\r\n        if len(records) > MAX_RECORDS_PER_BATCH:\r\n            return self._send(413, {\"error\": f\"at most {MAX_RECORDS_PER_BATCH} records per batch\", \"received\": len(records)})\r\n        missing = [i for i, r in enumerate(records) if not isinstance(r, dict) or \"customer_id\" not in r or \"activity_date\" not in r]\r\n        if missing:\r\n            return self._send(422, {\"error\": \"records missing customer_id/activity_date\", \"indexes\": missing[:10]})\r\n        return self._send(202, {\"batch_id\": f\"bt_{uuid.uuid4().hex[:12]}\", \"accepted\": len(records), \"stored_as\": record_path.name})\r\n\r\n\r\ndef serve(port: int, state_dir: Path, host: str = \"127.0.0.1\") -> None:\r\n    state_dir.mkdir(parents=True, exist_ok=True)\r\n    (state_dir / \"received\").mkdir(exist_ok=True)\r\n    Handler.state_dir = state_dir\r\n    httpd = ThreadingHTTPServer((host, port), Handler)\r\n    (state_dir / \"service.pid\").write_text(str(os.getpid()))\r\n    print(f\"{SERVICE_NAME} listening on http://{host}:{port} (state: {state_dir})\", flush=True)\r\n    try:\r\n        httpd.serve_forever()\r\n    except KeyboardInterrupt:\r\n        pass\r\n    finally:\r\n        httpd.server_close()\r\n\r\n\r\ndef main(argv=None) -> int:\r\n    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\r\n    p.add_argument(\"--port\", type=int, default=int(os.environ.get(\"ANALYTICS_INGEST_PORT\", \"8701\")))\r\n    p.add_argument(\"--host\", default=\"127.0.0.1\")\r\n    p.add_argument(\"--state-dir\", type=Path, default=Path(os.environ.get(\"ANALYTICS_INGEST_STATE_DIR\", \"/var/lib/analytics-ingest\")))\r\n    args = p.parse_args(argv)\r\n    serve(args.port, args.state_dir, args.host)\r\n    return 0\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main())\r\n\u001b[?2004hroot@1f11da6c27fc:/app# "]
[69.283197, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('custops/export_service.py')\ns = p.read_text().replace('from .config import Settings', 'from .analytics import period_bounds\\nfrom .config import Settings').replace('from .customer_store import CustomerStore', 'from .customer_store import CustomerStore, StoreError')\ns = s.replace('except urllib.error.URLError as e:\\n                last_error = IngestError(f\"ingest service unreachable at {self.base_url}: {e.reason}\")', 'except (urllib.error.URLError, TimeoutError, ConnectionError) as e:\\n                detail = getattr(e, \"reason\", str(e))\\n                last_error = IngestError(f\"ingest service unreachable at {self.base_url}: {detail}\")\\n            except (UnicodeDecodeError, json.JSONDecodeError) as e:\\n                raise IngestError(f\"ingest service returned invalid JSON for {path}\") from e')\nstart = s.index('    \"\"\"Build the per-customer daily activity feed', s.index('def run_activity_export'))\ns = s[:start] + '''    \"\"\"Deliver settled customer-day activity, or return planned counts without HTTP.\n\n    Records are ordered by customer and UTC date so re-running a period produces\n    stable batch contents. The ingest API has a hard limit of 100 records per batch.\n    \"\"\"\n    start, end = period_bounds(period)\n    if settings.ingest_batch_size < 1:\n        raise ValueError(\"ANALYTICS_INGEST_BATCH_SIZE must be >= 1\")\n    batch_size = min(settings.ingest_batch_size, 100)\n    records: list[dict[str, Any]] = []\n    for customer in store.list_customers():\n        daily: dict[str, dict[str, Any]] = {}\n        for txn in store.transactions_for(customer.customer_id):\n            if txn.status != \"settled\":\n                continue\n            timestamp = datetime.fromisoformat(txn.occurred_at.replace(\"Z\", \"+00:00\"))\n            # Timestamps without an offset, if present, are interpreted as UTC.\n            if timestamp.tzinfo is None:\n                timestamp = timestamp.replace(tzinfo=timezone.utc)\n            day = timestamp.astimezone(timezone.utc).date()\n            if not start <= day < end:\n                continue\n            key = day.isoformat()\n            if key not in daily:\n                daily[key] = {\n                    **customer_record(customer),\n                    \"activity_date\": key,\n                    \"transaction_count\": 0,\n                    \"total_spend_cents\": 0,\n                    \"currency\": txn.currency,\n                }\n            record = daily[key]\n            if record[\"currency\"] != txn.currency:\n                raise StoreError(\n                    f\"cannot aggregate mixed currencies for {customer.customer_id} on {key}\"\n                )\n            record[\"transaction_count\"] += int(txn.kind == \"sale\")\n            record[\"total_spend_cents\"] += txn.signed_amount_cents\n        records.extend(daily[day] for day in sorted(daily))\n\n    batch_count = (len(records) + batch_size - 1) // batch_size\n    result = ActivityExportResult(period, len(records), batch_count, 0)\n    if dry_run or not records:\n        return result\n\n    client = AnalyticsIngestClient(\n        settings.analytics_ingest_url,\n        settings.ingest_timeout_sec,\n        settings.source_system,\n        settings.ingest_retries,\n    )\n    generated_at = datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace(\"+00:00\", \"Z\")\n    for offset in range(0, len(records), batch_size):\n        batch = records[offset:offset + batch_size]\n        response = client.post_activity_batch({\n            \"source\": settings.source_system,\n            \"period\": period,\n            \"generated_at\": generated_at,\n            \"records\": batch,\n        })\n        if response.status != 202:\n            raise IngestError(f\"ingest service rejected batch: HTTP {response.status}: {response.body}\")\n        accepted = response.body.get(\"accepted\")\n        if type(accepted) is not int or not 0 <= accepted <= len(batch):\n            raise IngestError(f\"ingest service returned an invalid accepted count: {accepted!r}\")\n        result.accepted += accepted\n    return result\n'''\np.write_text(s)\n"]
[69.283243, "i", "p = Path('custops/analytics.py')\ns = p.read_text().replace('r\"^(\\\\d{4})-(\\\\d{2})$\"', 'r\"([0-9]{4})-([0-9]{2})\"').replace('_PERIOD_RE.match(period or \"\")', '_PERIOD_RE.fullmatch(period or \"\")')\ns = s.replace('    start = date(year, month, 1)\\n    days = calendar.monthrange(year, month)[1]\\n    end = date(year + (month == 12), (month % 12) + 1, 1)', '    try:\\n        start = date(year, month, 1)\\n        days = calendar.monthrange(year, month)[1]\\n        end = date(year + (month == 12), (month % 12) + 1, 1)\\n    except ValueError as e:\\n        raise PeriodError(f\"invalid calendar period {period!r}\") from e')\np.write_text(s)\np = Path('custops/cli.py')\ns = p.read_text().replace('    python -m custops.cli export-crm [--segment S] [--out DIR]', '    python -m custops.cli export-crm [--segment S] [--out DIR]\\n    python -m custops.cli export-activity --period YYYY-MM [--dry-run]')\ns = s.replace('IngestError, write_crm_contacts', 'IngestError, run_activity_export, write_crm_contacts')\ns = s.replace('def cmd_transactions_list(args, settings) -> int:', '''def cmd_export_activity(args, settings) -> int:\n    try:\n        period_bounds(args.period)\n        store = _open_store(settings)\n        try:\n            result = run_activity_export(store, settings, args.period, dry_run=args.dry_run)\n        finally:\n            store.close()\n    except (ValueError, IngestError, StoreError) as e:\n        print(f\"activity export failed: {e}\", file=sys.stderr)\n        return 1\n    if args.dry_run:\n        print(f\"would send {result.records} records in {result.batches} batches for {result.period} (dry run)\")\n    else:\n        print(f\"sent {result.records} records in {result.batches} batches for {result.period}; {result.accepted} accepted\")\n    return 0\n\n\ndef cmd_transactions_list(args, settings) -> int:''')\ns = s.replace('    t = sub.add_parser(\"transactions\", help=\"transaction ledger\")', '''    activity = sub.add_parser(\"export-activity\", help=\"send daily customer activity to analytics ingest\")\n    activity.add_argument(\"--period\", required=True, help=\"YYYY-MM\")\n    activity.add_argument(\"--dry-run\", action=\"store_true\", help=\"report planned records and batches without sending\")\n    activity.set_defaults(func=cmd_export_activity)\n\n    t = sub.add_parser(\"transactions\", help=\"transaction ledger\")''')\np.write_text(s)\np = Path('README.md')\ns = p.read_text().replace('| `ingest-health`', '| `export-activity --period YYYY-MM [--dry-run]` | send settled daily customer activity to Growth analytics (or preview counts) |\\n| `ingest-health`')\np.write_text(s)\nPY\n"]
