[13.840174, "o", "cat custops/export_service.py\r\n\u001b[?2004l\r"]
[13.841343, "o", "\"\"\"Outbound exports: data-subject bundles (file) and the analytics ingest client (HTTP).\r\n\r\nThe analytics ingest service is an internal Growth-team system; locally it is the stand-in\r\nstarted by ``services/analytics_ingest_service.py`` (see README).\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport json\r\nimport time\r\nimport urllib.error\r\nimport urllib.request\r\nfrom dataclasses import dataclass\r\nfrom datetime import datetime, timezone\r\nfrom pathlib import Path\r\nfrom typing import Any\r\n\r\nfrom .config import Settings\r\nfrom .customer_store import CustomerStore\r\nfrom .serializers import customer_record, export_bundle\r\n\r\n\r\nclass IngestError(RuntimeError):\r\n    \"\"\"Raised when the analytics ingest service rejects or cannot accept a request.\"\"\"\r\n\r\n\r\n@dataclass\r\nclass IngestResponse:\r\n    status: int\r\n    body: dict[str, Any]\r\n\r\n\r\nclass AnalyticsIngestClient:\r\n    \"\"\"Thin JSON client for the analytics ingest API.\"\"\"\r\n\r\n    RETRYABLE_STATUSES = (502, 503, 504)\r\n\r\n    def __init__(self, base_url: str, timeout_sec: float = 10.0, source_system: str = \"custops\", retries: int = 2, backoff_sec: float = 0.5):\r\n        self.base_url = base_url.rstrip(\"/\")\r\n        self.timeout_sec = timeout_sec\r\n        self.source_system = source_system\r\n        self.retries = max(0, retries)\r\n        self.backoff_sec = backoff_sec\r\n\r\n    def _request(self, method: str, path: str, payload: dict[str, Any] | None = None) -> IngestResponse:\r\n        data = None\r\n        headers = {\"Accept\": \"application/json\", \"X-Source-System\": self.source_system}\r\n        if payload is not None:\r\n            data = json.dumps(payload, separators=(\",\", \":\")).encode(\"utf-8\")\r\n            headers[\"Content-Type\"] = \"application/json\"\r\n        last_error: IngestError | None = None\r\n        for attempt in range(self.retries + 1):\r\n            req = urllib.request.Request(self.base_url + path, data=data, method=method, headers=headers)\r\n            try:\r\n                with urllib.request.urlopen(req, timeout=self.timeout_sec) as resp:\r\n                    raw = resp.read().decode(\"utf-8\")\r\n                    return IngestResponse(resp.status, json.loads(raw) if raw else {})\r\n            except urllib.error.HTTPError as e:\r\n                detail = e.read().decode(\"utf-8\", \"replace\")\r\n                last_error = IngestError(f\"ingest service returned {e.code} for {path}: {detail}\")\r\n                if e.code not in self.RETRYABLE_STATUSES:\r\n                    raise last_error from e\r\n            except urllib.error.URLError as e:\r\n                last_error = IngestError(f\"ingest service unreachable at {self.base_url}: {e.reason}\")\r\n            if attempt < self.retries:\r\n                time.sleep(self.backoff_sec * (attempt + 1))\r\n        assert last_error is not None\r\n        raise last_error\r\n\r\n    def health(self) -> IngestResponse:\r\n        return self._request(\"GET\", \"/healthz\")\r\n\r\n    def post_activity_batch(self, batch: dict[str, Any]) -> IngestResponse:\r\n        \"\"\"POST one batch to /v1/ingest/customer-activity (see docs/analytics_ingest_contract.md).\"\"\"\r\n        return self._request(\"POST\", \"/v1/ingest/customer-activity\", batch)\r\n\r\n\r\n# ----------------------------------------------------------------------------- subject export\r\ndef write_subject_export(store: CustomerStore, customer_id: str, out_dir: Path) -> Path:\r\n    \"\"\"Write the data-subject export bundle for one customer and return the file path.\"\"\"\r\n    customer = store.get_customer(customer_id)\r\n    transactions = store.transactions_for(customer_id)\r\n    generated_at = datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace(\"+00:00\", \"Z\")\r\n    bundle = export_bundle(customer, transactions, generated_at)\r\n    out_dir.mkdir(parents=True, exist_ok=True)\r\n    out_path = out_dir / f\"subject-export-{customer_id}.json\"\r\n    out_path.write_text(json.dumps(bundle, indent=2))\r\n    return out_path\r\n\r\n\r\n# ----------------------------------------------------------------------------- CRM contact export\r\ndef write_crm_contacts(store: CustomerStore, out_dir: Path, segment: str | None = None) -> Path:\r\n    \"\"\"Nightly contact export for the CRM import job (docs/crm_contact_export.md): one row per\r\n    customer, all profile fields, CSV.\"\"\"\r\n    import csv\r\n\r\n    customers = store.list_customers(segment=segment)\r\n    out_dir.mkdir(parents=True, exist_ok=True)\r\n    out_path = out_dir / (\"crm-contacts.csv\" if not segment else f\"crm-contacts-{segment}.csv\")\r\n    rows = [customer_record(c) for c in customers]\r\n    with open(out_path, \"w\", newline=\"\") as fh:\r\n        writer = csv.DictWriter(fh, fieldnames=list(rows[0]) if rows else [\"customer_id\"], lineterminator=\"\\n\")\r\n        writer.writeheader()\r\n        writer.writerows(rows)\r\n    return out_path\r\n\r\n\r\n# ----------------------------------------------------------------------------- activity export\r\n@dataclass\r\nclass ActivityExportResult:\r\n    period: str\r\n    records: int\r\n    batches: int\r\n    accepted: int\r\n\r\n\r\ndef run_activity_export(store: CustomerStore, settings: Settings, period: str, dry_run: bool = False) -> ActivityExportResult:\r\n    \"\"\"Build the per-customer daily activity feed for ``period`` and deliver it to the\r\n    analytics ingest service in batches of ``settings.ingest_batch_size``.\r\n\r\n    Not implemented yet — see ticket OPS-2291.\r\n    \"\"\"\r\n    raise NotImplementedError(\"activity export is not wired up yet (OPS-2291)\")\r\n"]
[13.841667, "o", "\u001b[?2004hroot@1f11da6c27fc:/app# "]
[13.966125, "i", "cat custops/customer_store.py\n"]
[13.966242, "o", "cat custops/customer_store.py\r\n\u001b[?2004l\r"]
[13.966936, "o", "\"\"\"SQLite-backed storage for customers and transactions.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport json\r\nimport sqlite3\r\nfrom dataclasses import dataclass\r\nfrom datetime import date, datetime\r\nfrom pathlib import Path\r\nfrom typing import Iterable, Iterator\r\n\r\nSCHEMA = \"\"\"\r\nCREATE TABLE IF NOT EXISTS customers (\r\n    customer_id    TEXT PRIMARY KEY,\r\n    full_name      TEXT NOT NULL,\r\n    email          TEXT NOT NULL,\r\n    phone          TEXT,\r\n    date_of_birth  TEXT,\r\n    tax_reference  TEXT,\r\n    country        TEXT NOT NULL,\r\n    segment        TEXT NOT NULL,\r\n    currency       TEXT NOT NULL,\r\n    created_at     TEXT NOT NULL\r\n);\r\nCREATE TABLE IF NOT EXISTS transactions (\r\n    txn_id        TEXT PRIMARY KEY,\r\n    customer_id   TEXT NOT NULL REFERENCES customers(customer_id),\r\n    occurred_at   TEXT NOT NULL,\r\n    kind          TEXT NOT NULL CHECK (kind IN ('sale', 'refund')),\r\n    amount_cents  INTEGER NOT NULL CHECK (amount_cents >= 0),\r\n    currency      TEXT NOT NULL,\r\n    channel       TEXT NOT NULL,\r\n    status        TEXT NOT NULL CHECK (status IN ('settled', 'pending', 'declined'))\r\n);\r\nCREATE INDEX IF NOT EXISTS idx_txn_customer_time ON transactions(customer_id, occurred_at);\r\n\"\"\"\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Customer:\r\n    customer_id: str\r\n    full_name: str\r\n    email: str\r\n    phone: str | None\r\n    date_of_birth: str | None\r\n    tax_reference: str | None\r\n    country: str\r\n    segment: str\r\n    currency: str\r\n    created_at: str\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Transaction:\r\n    txn_id: str\r\n    customer_id: str\r\n    occurred_at: str\r\n    kind: str\r\n    amount_cents: int\r\n    currency: str\r\n    channel: str\r\n    status: str\r\n\r\n    @property\r\n    def occurred_on(self) -> date:\r\n        return datetime.fromisoformat(self.occurred_at.replace(\"Z\", \"+00:00\")).date()\r\n\r\n    @property\r\n    def signed_amount_cents(self) -> int:\r\n        return -self.amount_cents if self.kind == \"refund\" else self.amount_cents\r\n\r\n\r\nclass StoreError(RuntimeError):\r\n    pass\r\n\r\n\r\nclass CustomerStore:\r\n    def __init__(self, db_path: Path):\r\n        self.db_path = Path(db_path)\r\n        self.db_path.parent.mkdir(parents=True, exist_ok=True)\r\n        self._conn = sqlite3.connect(str(self.db_path))\r\n        self._conn.row_factory = sqlite3.Row\r\n        self._conn.executescript(SCHEMA)\r\n\r\n    def close(self) -> None:\r\n        self._conn.close()\r\n\r\n    # ------------------------------------------------------------------ seeding\r\n    def load_seed(self, seed_dir: Path, replace: bool = False) -> tuple[int, int]:\r\n        customers = json.loads((seed_dir / \"customers.json\").read_text())\r\n        transactions = json.loads((seed_dir / \"transactions.json\").read_text())\r\n        with self._conn:\r\n            if replace:\r\n                self._conn.execute(\"DELETE FROM transactions\")\r\n                self._conn.execute(\"DELETE FROM customers\")\r\n            self._conn.executemany(\r\n                \"INSERT OR REPLACE INTO customers VALUES (:customer_id,:full_name,:email,:phone,\"\r\n                \":date_of_birth,:tax_reference,:country,:segment,:currency,:created_at)\",\r\n                customers,\r\n            )\r\n            self._conn.executemany(\r\n                \"INSERT OR REPLACE INTO transactions VALUES (:txn_id,:customer_id,:occurred_at,:kind,\"\r\n                \":amount_cents,:currency,:channel,:status)\",\r\n                transactions,\r\n            )\r\n        return len(customers), len(transactions)\r\n\r\n"]
[13.966987, "o", "    # ---------------------------------------------------------------- customers\r\n    def get_customer(self, customer_id: str) -> Customer:\r\n        row = self._conn.execute(\"SELECT * FROM customers WHERE customer_id = ?\", (customer_id,)).fetchone()\r\n        if row is None:\r\n            raise StoreError(f\"unknown customer {customer_id!r}\")\r\n        return Customer(**dict(row))\r\n\r\n    def list_customers(self, segment: str | None = None) -> list[Customer]:\r\n        sql, params = \"SELECT * FROM customers\", ()\r\n        if segment:\r\n            sql, params = sql + \" WHERE segment = ?\", (segment,)\r\n        rows = self._conn.execute(sql + \" ORDER BY customer_id\", params).fetchall()\r\n        return [Customer(**dict(r)) for r in rows]\r\n\r\n    def count_customers(self) -> int:\r\n        return int(self._conn.execute(\"SELECT COUNT(*) FROM customers\").fetchone()[0])\r\n\r\n    # ------------------------------------------------------------- transactions\r\n    def transactions_for(self, customer_id: str) -> list[Transaction]:\r\n        rows = self._conn.execute(\r\n            \"SELECT * FROM transactions WHERE customer_id = ? ORDER BY occurred_at, txn_id\", (customer_id,)\r\n        ).fetchall()\r\n        return [Transaction(**dict(r)) for r in rows]\r\n\r\n    def transactions_between(self, start: date, end_exclusive: date) -> Iterator[Transaction]:\r\n        \"\"\"All transactions with start <= occurred_at < end_exclusive (UTC dates).\"\"\"\r\n        rows = self._conn.execute(\r\n            \"SELECT * FROM transactions WHERE occurred_at >= ? AND occurred_at < ? ORDER BY occurred_at, txn_id\",\r\n            (f\"{start.isoformat()}T00:00:00Z\", f\"{end_exclusive.isoformat()}T00:00:00Z\"),\r\n        )\r\n        for r in rows:\r\n            yield Transaction(**dict(r))\r\n\r\n    def add_transactions(self, txns: Iterable[Transaction]) -> int:\r\n        rows = [t.__dict__ for t in txns]\r\n        with self._conn:\r\n            self._conn.executemany(\r\n                \"INSERT INTO transactions VALUES (:txn_id,:customer_id,:occurred_at,:kind,\"\r\n                \":amount_cents,:currency,:channel,:status)\",\r\n                rows,\r\n            )\r\n        return len(rows)\r\n"]
