[69.289741, "o", "                continue\r\n\u001b[?2004l\r"]
[69.289757, "o", "\u001b[?2004h> "]
[69.28981, "o", "            key = day.isoformat()\r\n\u001b[?2004l\r"]
[69.289827, "o", "\u001b[?2004h> "]
[69.289875, "o", "            if key not in daily:\r\n\u001b[?2004l\r"]
[69.289892, "o", "\u001b[?2004h> "]
[69.289938, "o", "                daily[key] = {\r\n\u001b[?2004l\r"]
[69.289955, "o", "\u001b[?2004h> "]
[69.290031, "o", "                    **customer_record(customer),\r\n\u001b[?2004l\r"]
[69.290048, "o", "\u001b[?2004h> "]
[69.290119, "o", "                    \"activity_date\": key,\r\n\u001b[?2004l\r"]
[69.290138, "o", "\u001b[?2004h> "]
[69.290221, "o", "                    \"transaction_count\": 0,\r\n\u001b[?2004l\r"]
[69.29024, "o", "\u001b[?2004h> "]
[69.290359, "o", "                    \"total_spend_cents\": 0,\r\n\u001b[?2004l\r"]
[69.29038, "o", "\u001b[?2004h> "]
[69.290451, "o", "                    \"currency\": txn.currency,\r\n\u001b[?2004l\r"]
[69.290471, "o", "\u001b[?2004h> "]
[69.290507, "o", "                }\r\n\u001b[?2004l\r"]
[69.290526, "o", "\u001b[?2004h> "]
[69.290591, "o", "            record = daily[key]\r\n\u001b[?2004l\r"]
[69.290607, "o", "\u001b[?2004h> "]
[69.290714, "o", "            if record[\"currency\"] != txn.currency:\r\n\u001b[?2004l\r"]
[69.290731, "o", "\u001b[?2004h> "]
[69.290804, "o", "                raise StoreError(\r\n\u001b[?2004l\r"]
[69.290823, "o", "\u001b[?2004h> "]
[69.29094, "o", "                    f\"cannot aggregate mixed currencies for {customer.customer_id} on {key}\"\r\n\u001b[?2004l\r"]
[69.290961, "o", "\u001b[?2004h> "]
[69.290976, "o", "                )\r\n\u001b[?2004l\r"]
[69.290994, "o", "\u001b[?2004h> "]
[69.291074, "o", "            record[\"transaction_count\"] += int(txn.kind == \"sale\")\r\n\u001b[?2004l\r"]
[69.291092, "o", "\u001b[?2004h> "]
[69.291179, "o", "            record[\"total_spend_cents\"] += txn.signed_amount_cents\r\n\u001b[?2004l\r"]
[69.2912, "o", "\u001b[?2004h> "]
[69.291266, "o", "        records.extend(daily[day] for day in sorted(daily))\r\n\u001b[?2004l\r"]
[69.291284, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[69.291307, "o", "\u001b[?2004h> "]
[69.291395, "o", "    batch_count = (len(records) + batch_size - 1) // batch_size\r\n\u001b[?2004l\r"]
[69.291442, "o", "\u001b[?2004h> "]
[69.291517, "o", "    result = ActivityExportResult(period, len(records), batch_count, 0)\r\n\u001b[?2004l\r"]
[69.291543, "o", "\u001b[?2004h> "]
[69.291577, "o", "    if dry_run or not records:\r\n\u001b[?2004l\r"]
[69.291599, "o", "\u001b[?2004h> "]
[69.291628, "o", "        return result\r\n\u001b[?2004l\r"]
[69.291649, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[69.29167, "o", "\u001b[?2004h> "]
[69.291713, "o", "    client = AnalyticsIngestClient(\r\n\u001b[?2004l\r"]
[69.291733, "o", "\u001b[?2004h> "]
[69.291784, "o", "        settings.analytics_ingest_url,\r\n\u001b[?2004l\r"]
[69.291806, "o", "\u001b[?2004h> "]
[69.291853, "o", "        settings.ingest_timeout_sec,\r\n\u001b[?2004l\r"]
[69.291876, "o", "\u001b[?2004h> "]
[69.291914, "o", "        settings.source_system,\r\n\u001b[?2004l\r"]
[69.291936, "o", "\u001b[?2004h> "]
[69.291977, "o", "        settings.ingest_retries,\r\n\u001b[?2004l\r"]
[69.292, "o", "\u001b[?2004h>     )\r\n\u001b[?2004l\r"]
[69.292021, "o", "\u001b[?2004h> "]
[69.29215, "o", "    generated_at = datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace(\"+00:00\", \"Z\")\r\n\u001b[?2004l\r"]
[69.292172, "o", "\u001b[?2004h> "]
[69.292238, "o", "    for offset in range(0, len(records), batch_size):\r\n\u001b[?2004l\r"]
[69.292259, "o", "\u001b[?2004h> "]
[69.292328, "o", "        batch = records[offset:offset + batch_size]\r\n\u001b[?2004l\r"]
[69.292348, "o", "\u001b[?2004h> "]
[69.29241, "o", "        response = client.post_activity_batch({\r\n\u001b[?2004l\r"]
[69.292432, "o", "\u001b[?2004h> "]
[69.29249, "o", "            \"source\": settings.source_system,\r\n\u001b[?2004l\r"]
[69.292514, "o", "\u001b[?2004h> "]
[69.292547, "o", "            \"period\": period,\r\n\u001b[?2004l\r"]
[69.292569, "o", "\u001b[?2004h> "]
[69.292623, "o", "            \"generated_at\": generated_at,\r\n\u001b[?2004l\r"]
[69.292649, "o", "\u001b[?2004h> "]
[69.29268, "o", "            \"records\": batch,\r\n\u001b[?2004l\r"]
[69.2927, "o", "\u001b[?2004h> "]
[69.292718, "o", "        })\r\n\u001b[?2004l\r"]
[69.292737, "o", "\u001b[?2004h> "]
[69.292782, "o", "        if response.status != 202:\r\n\u001b[?2004l\r"]
[69.292801, "o", "\u001b[?2004h> "]
[69.292929, "o", "            raise IngestError(f\"ingest service rejected batch: HTTP {response.status}: {response.body}\")\r\n\u001b[?2004l\r"]
[69.292949, "o", "\u001b[?2004h> "]
[69.29301, "o", "        accepted = response.body.get(\"accepted\")\r\n\u001b[?2004l\r"]
[69.293029, "o", "\u001b[?2004h> "]
[69.293116, "o", "        if type(accepted) is not int or not 0 <= accepted <= len(batch):\r\n\u001b[?2004l\r"]
[69.293135, "o", "\u001b[?2004h> "]
[69.293251, "o", "            raise IngestError(f\"ingest service returned an invalid accepted count: {accepted!r}\")\r\n\u001b[?2004l\r"]
[69.29327, "o", "\u001b[?2004h> "]
[69.293319, "o", "        result.accepted += accepted\r\n\u001b[?2004l\r"]
[69.293341, "o", "\u001b[?2004h> "]
[69.293361, "o", "    return result\r\n\u001b[?2004l\r"]
[69.293383, "o", "\u001b[?2004h> '''\r\n\u001b[?2004l\r"]
[69.293405, "o", "\u001b[?2004h> "]
[69.293426, "o", "p.write_text(s)\r\n\u001b[?2004l\r"]
[69.293449, "o", "\u001b[?2004h> "]
[69.293536, "o", "p = Path('custops/analytics.py')\r\n"]
[69.293552, "o", "\u001b[?2004l\r"]
[69.293576, "o", "\u001b[?2004h"]
[69.293596, "o", "> "]
[69.294047, "o", "s = p.read_text().replace('r\"^(\\\\d{4})-(\\\\d{2})$\"', 'r\"([0-9]{4})-([0-9]{2})\"').replace('_PERIOD_RE.match(period or \"\")', '_PERIOD_RE.fullmatch(period or \"\")')\r\n\u001b[?2004l\r"]
[69.294076, "o", "\u001b[?2004h> "]
[69.295315, "o", "s = s.replace('    start = date(year, month, 1)\\n    days = calendar.monthrange(year, month)[1]\\n    end = date(year + (month == 12), (month % 12) + 1, 1)', '    try:\\n        start = date(year, month, 1)\\n        days = calendar.monthrange(year, month)[1]\\n        end = date(year + (month == 12), (month % 12) + 1, 1)\\n    except ValueError as e:\\n        raise PeriodError(f\"invalid calendar period {period!r}\") from e')\r\n\u001b[?2004l\r"]
[69.295359, "o", "\u001b[?2004h"]
[69.295385, "o", "> p.write_text(s)\r\n"]
[69.295403, "o", "\u001b[?2004l\r"]
