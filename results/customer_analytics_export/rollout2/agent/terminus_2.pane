import base64
import json
from pathlib import Path
before = set(json.loads(Path('/tmp/custops-activity-before.json').read_text()))
paths = sorted(p for p in Path('/var/lib/analytics-ingest/received').glob('*.json') if p.name not in before)
records = []
for path in paths:
    saved = json.loads(path.read_text())
    envelope = json.loads(base64.b64decode(saved['body_b64']))
    assert saved['path'] == '/v1/ingest/customer-activity'
    assert envelope['period'] == '2025-10'
    assert 0 < len(envelope['records']) <= 100
    records.extend(envelope['records'])
    print(f'{path.name}: {len(envelope["records"])} records, period={envelope["period"]}')
assert len(paths) == 2 and len(records) == 145
assert len({(r['customer_id'], r['activity_date']) for r in records}) == 145
print(f'Verified {len(records)} unique customer-days in {len(paths)} persisted batches.')
